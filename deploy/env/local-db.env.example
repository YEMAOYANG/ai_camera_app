# Settings for deploy/compose.local-db.yml. Copy to deploy/env/local-db.env
# (git-ignored) and replace every CHANGE_ME. Use letters and digits only:
# the passwords are embedded in connection URLs.
MIRA_LOCAL_PG_PORT=5433
# Login used by the backend, the classroom runtime and database browsers.
MIRA_DB_PASSWORD=CHANGE_ME
# Built-in administrator, reached through `docker exec`; not used by programs.
MIRA_LOCAL_PG_SUPERUSER_PASSWORD=CHANGE_ME
