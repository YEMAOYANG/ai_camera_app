# Copy with `server.py init`. Never commit the filled file.
MIRA_DEPLOY_MODE=production
MIRA_PROJECT_NAME=mira-server
MIRA_RELEASE_TAG=20260916-1
MIRA_PARENT_ORIGIN=https://parent.example.com
MIRA_STUDENT_ORIGIN=https://learn.example.com
MIRA_CLASSROOM_ORIGIN=https://classroom.example.com
MIRA_API_ORIGIN=https://api.example.com
MIRA_REALTIME_ORIGIN=https://realtime.example.com
# All five origins must use the same parent domain for classroom cookies.
MIRA_BASE_DOMAIN=example.com
MIRA_DATA_ROOT=/srv/mira/data
MIRA_PARENT_WEB_DIST=/srv/mira/parent-web
MIRA_BACKEND_ENV_FILE=/etc/mira/backend.env
MIRA_RUNTIME_ENV_FILE=/etc/mira/openmaic.env
# Match the source PostgreSQL major version before restoring a bundle.
MIRA_POSTGRES_IMAGE=postgres:16-alpine
# Production may be public; preview must replace this with tester egress CIDRs.
# Direct DNS only: do not put a CDN/proxy in front of this IP-restricted preview.
MIRA_ACCESS_CIDRS='0.0.0.0/0 ::/0'
# Database URL passwords must be URL-safe; `init` generates hexadecimal values.
# MIRA_DB_PASSWORD is the application login `mira`; the superuser password is
# used only inside the database container.
MIRA_DB_PASSWORD=CHANGE_ME
MIRA_POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
MIRA_INTERNAL_API_TOKEN=CHANGE_ME
MIRA_PERSISTENCE_TOKEN=CHANGE_ME
# Restore the ORIGINAL pepper when migrating paired devices/PINs.
MIRA_STUDENT_AUTH_PEPPER=CHANGE_ME
