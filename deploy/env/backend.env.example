# No local/LAN addresses. compose supplies database, origins and shared secrets.
APP_ENABLE_DEV_ADAPTERS=0
# Tencent SMS production configuration. Use a dedicated CAM identity limited to
# sms:SendSms. Never commit the filled file or reuse a main-account credential.
APP_SMS_PROVIDER=tencent
APP_SMS_TENCENT_SECRET_ID=
APP_SMS_TENCENT_SECRET_KEY=
APP_SMS_TENCENT_SDK_APP_ID=
APP_SMS_TENCENT_SIGN_NAME=
APP_SMS_TEMPLATE_ID=
APP_SMS_TENCENT_REGION=ap-guangzhou
APP_SMS_TENCENT_TIMEOUT_SECONDS=10
APP_SMS_CODE_TTL_SECONDS=300
APP_SMS_RESEND_COOLDOWN_SECONDS=60
# Hard application-wide paid-send ceiling per fixed UTC hour. Tune deliberately.
APP_SMS_HOURLY_SEND_LIMIT=300
APP_SMS_SOURCE_WINDOW_SECONDS=600
APP_SMS_SOURCE_SEND_LIMIT=10
APP_SMS_MAX_ATTEMPTS=5
# Generate a unique value with at least 32 random characters; never commit it.
APP_SMS_CODE_PEPPER=
CAMERA_RUNTIME_PROVIDER=disabled
APP_HARDWARE_ADAPTER=disabled
APP_PROMPT_ROOT=prompts
# If the source used APP_DEVICE_SECRET_KEY, transfer that exact value securely.
# Otherwise restore backend-data/.device-secret.key from the migration bundle.
APP_DEVICE_SECRET_KEY=
ONVIF_BOOTSTRAP_CREDENTIALS_ENABLED=0
CAMERA_MONITOR_ENABLED=0
CAMERA_SPEAKER_ENABLED=0
MEDIA_GATEWAY_ENABLED=0
OPENMAIC_FULL_RUNTIME_ENABLED=1
OPENMAIC_FULL_RUNTIME_VIDEO_EXPORT_ENABLED=0
# Existing published courses remain available. New paid generation is OFF.
LEARNING_COURSE_LIBRARY_ENABLED=1
LEARNING_STATIC_CATALOG_ENABLED=0
LEARNING_DAILY_PREPARATION_ENABLED=0
LEARNING_DYNAMIC_GENERATION_ENABLED=0
LEARNING_CLASSROOM_GENERATION_ENABLED=0
LEARNING_MEDIA_WORKER_ENABLED=0
LEARNING_CURRICULUM_PREPARATION_RUNNER_ENABLED=0
LEARNING_CURRICULUM_PREPARATION_CONTENT_GENERATION_ENABLED=0
OPENMAIC_FULL_RUNTIME_GENERATION_ENABLED=0
OPENMAIC_FULL_RUNTIME_AUTORUN_ENABLED=0
# Candidate generation requires the generation switches above and remains off.
# Audio validation and student release stay enabled for published courses.
LEARNING_FORMAL_RUNTIME_CANDIDATE_ENABLED=0
LEARNING_FORMAL_AUDIO_VALIDATION_ENABLED=1
LEARNING_FORMAL_AUTO_PUBLICATION_ENABLED=0
LEARNING_CLASSROOM_STUDENT_RELEASE_ENABLED=1
