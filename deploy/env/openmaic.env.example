# Server-only Provider settings. Keep each key with its original Base URL/region.
# Values are injected at runtime, never as Docker build args.
DEFAULT_MODEL=deepseek:deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
MODEL_ROUTES='{"maic-agent-driver":{"model":"deepseek:deepseek-v4-pro","api":"openai-completions","thinking":{"mode":"enabled","enabled":true}},"generate-classroom":{"model":"deepseek:deepseek-v4-pro","thinking":{"mode":"disabled","enabled":false}},"mira-courseware-creator":{"model":"deepseek:deepseek-v4-pro","thinking":{"mode":"disabled","enabled":false}},"mira-courseware-verifier":{"model":"deepseek:deepseek-v4-flash","thinking":{"mode":"disabled","enabled":false}},"web-search-query-rewrite":{"model":"deepseek:deepseek-v4-pro","thinking":{"mode":"disabled","enabled":false}}}'
MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY=deepseek-v4-pro-flash-v1
MIRA_OPENMAIC_ENABLE_WEB_SEARCH=1
MIRA_OPENMAIC_WEB_SEARCH_PROVIDER=baidu
BAIDU_ENABLED=true
BAIDU_BASE_URL=https://qianfan.baidubce.com
BAIDU_API_KEY=
TTS_QWEN_API_KEY=
TTS_QWEN_BASE_URL=
TTS_QWEN_MODELS=qwen3-tts-flash
MIRA_OPENMAIC_REQUIRE_QWEN_TTS=1
MIRA_OPENMAIC_QWEN_TTS_MODEL=qwen3-tts-flash
MIRA_OPENMAIC_QWEN_TTS_VOICE=Serena
ASR_QWEN_API_KEY=
ASR_QWEN_BASE_URL=
ASR_QWEN_MODELS=qwen3-asr-flash
MIRA_OPENMAIC_REQUIRE_QWEN_ASR=1
MIRA_OPENMAIC_QWEN_ASR_MODEL=qwen3-asr-flash
# Copy actual image/video provider settings only if the frozen runtime policy
# requires them. Enabling generation needs its own budget and readiness checks.
ALLOW_LOCAL_NETWORKS=false
LOG_LEVEL=info
