# Copy to .env. Never commit provider or internal API secrets.
OPENMAIC_SOURCE_DIR=./.runtime/OpenMAIC
OPENMAIC_ADMIN_PORT=3100
MIRA_RUNTIME_PORT=3101
MIRA_BACKEND_INTERNAL_URL=http://host.docker.internal:8000
MIRA_RUNTIME_PUBLIC_ORIGIN=http://127.0.0.1:3101
MIRA_STUDENT_WEB_ORIGIN=http://127.0.0.1:3000
MIRA_INTERNAL_API_TOKEN=

# Native development: this OpenMAIC-owned dotenv is the only owner of the
# courseware model Provider, model allowlist, and Provider credential. The
# backend and both clients must not contain or receive those values. Docker
# Compose also maps the Qwen3-TTS flag to the runtime's strict speech-audio
# policy.
MIRA_OPENMAIC_ENABLE_MODEL_PROVIDER=1
MIRA_OPENMAIC_MODEL_PROVIDER=deepseek
MIRA_OPENMAIC_MODEL=deepseek-v4-pro
MIRA_OPENMAIC_VERIFIER_MODEL=deepseek-v4-flash
MIRA_OPENMAIC_ENABLE_QWEN_TTS=0
MIRA_OPENMAIC_ENABLE_QWEN_ASR=0
MIRA_OPENMAIC_ENABLE_WEB_SEARCH=1
MIRA_OPENMAIC_WEB_SEARCH_PROVIDER=brave
BRAVE_BASE_URL=https://search.brave.com
# Independent paid image-generation opt-in. When enabled, native-runtime.sh
# pins qwen-image-max at the DashScope root origin; it never reuses the
# TTS/ASR switches as authorization to generate images.
MIRA_OPENMAIC_ENABLE_QWEN_IMAGE=0
# Independent video-generation opt-in. Native startup pins HappyHorse 1.0
# at the Beijing DashScope origin and may reuse the server-owned DashScope key.
MIRA_OPENMAIC_ENABLE_HAPPYHORSE_VIDEO=0
VIDEO_HAPPYHORSE_API_KEY=
# Exceptional append-only replacement for the reviewed failed third job only.
# Keep disabled except for the single approved recovery claim.
OPENMAIC_DETERMINISTIC_RECOVERY_ENABLED=0
OPENMAIC_DETERMINISTIC_RECOVERY_SOURCE_JOB_ID=
MIRA_BACKEND_ENV_FILE=../backend/.env
# Non-model capabilities such as Qwen audio and the Agent database may still
# use the backend-owned provider file. DeepSeek credentials never use this path.
MIRA_OPENMAIC_PROVIDER_ENV_FILE=

# DeepSeek V4 Pro is the professional Agent/courseware creator. DeepSeek V4
# Flash performs only independent verification and verification after repair.
# Strict JSON creation/verification/search-rewrite stages disable thinking; the
# Pro Agent keeps its professional reasoning policy. Keep this private runtime
# off the public network and leave the key empty until generation is approved.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
# Keep the official key/base above for switching back. Selecting Bailian maps
# Pro/Flash to 0813/0731 only on the wire, preserving the formal stage policy.
DEEPSEEK_SERVICE=official
BAILIAN_DEEPSEEK_API_KEY=
BAILIAN_DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set only after enabling free-quota-only for BOTH dated models in the console.
BAILIAN_DEEPSEEK_FREE_TIER_ONLY_CONFIRMED=0
# Qwen3-TTS and Qwen3-ASR are independent native opt-ins. A shared
# DASHSCOPE_API_KEY/QWEN_API_KEY may be used by the native helper, or provide the
# capability-specific variables below. The legacy sample pins Serena here;
# formal subject audio derives Serena/Ethan/Jennifer server-side from subject.
TTS_QWEN_API_KEY=
TTS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_QWEN_MODELS=qwen3-tts-flash
MIRA_OPENMAIC_QWEN_TTS_MODEL=qwen3-tts-flash
# Hosted-like fixed Mandarin teacher voice used by both lecture and discussion.
# The Mira classroom contract accepts only Serena.
MIRA_OPENMAIC_QWEN_TTS_VOICE=Serena
ASR_QWEN_API_KEY=
ASR_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_QWEN_MODELS=qwen3-asr-flash
MIRA_OPENMAIC_QWEN_ASR_MODEL=qwen3-asr-flash
# Server-only Qwen Image credential. If empty, the native helper may reuse a
# server-owned DASHSCOPE_API_KEY or QWEN_API_KEY from the same provider file.
IMAGE_QWEN_IMAGE_API_KEY=
# Keep empty until a private VoxCPM2 service is actually running. The Mira
# backend already uses host port 8000; when both run on one development Mac,
# serve VoxCPM2 on 8002 and use http://host.docker.internal:8002/v1 here.
TTS_VOXCPM_BASE_URL=
MIRA_VOXCPM_VOICE_PROMPT=warm patient primary school teacher, clear standard pronunciation, medium pace
ALLOW_LOCAL_NETWORKS=false
LOG_LEVEL=info

# Full runtime feature switches compiled into the upstream Next.js app.
NEXT_PUBLIC_MAIC_PLAYBACK_RENDERER_ENABLED=true
NEXT_PUBLIC_PI_CHAT_ENABLED=true
NEXT_PUBLIC_ENABLE_VIDEO_EXPORT=true
NEXT_PUBLIC_PRO_WORKBENCH_ENABLED=true
NEXT_PUBLIC_MIRA_WORKBENCH_DOCUMENTS_ENABLED=true
NEXT_PUBLIC_MAIC_EDITOR_ENABLED=true
NEXT_PUBLIC_MAIC_EDITOR_RENDERER_ENABLED=true
NEXT_PUBLIC_ENABLE_PPTX_IMPORT=true

# Private authoring stores only documents on the server. Do not set the global
# NEXT_PUBLIC_PERSISTENCE switch: student playback keeps its existing storage.
# Docker needs an independent random server-only token for upstream's existing
# persistence setup gate. Native startup creates a fresh private token itself.
# Never set NEXT_PUBLIC_PERSISTENCE_TOKEN or put the internal API token here.
MIRA_OPENMAIC_PERSISTENCE_DEV_TOKEN=

# MP4 rendering is opt-in because Chromium + FFmpeg needs substantial memory.
RENDER_RESOURCE_PROFILE=standard
RENDER_SERVICE_MEMORY_LIMIT=10g
