+  });
+  it('reuses only a complete matching audit without a second paid call', async () => {
+    const i=input(),p=provider(i);const first=await repairFormalLearnerDiscussions(i,rejection(i),context,{provider:p,cacheRoot});
+    expect(await repairFormalLearnerDiscussions(i,rejection(i),context,{provider:p,cacheRoot})).toEqual(first);expect(p).toHaveBeenCalledTimes(1);
