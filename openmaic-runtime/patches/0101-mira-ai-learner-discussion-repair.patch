+import { mkdir, open, readFile } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import type { Action, DiscussionAction } from '@/lib/types/action';
+import type { Scene } from '@/lib/types/stage';
+import { LEARNER_DISCUSSION_REPAIR_PROMPT_VERSION, LEARNER_DISCUSSION_REPAIR_SYSTEM } from '@/lib/prompts/mira-formal-learner-discussion-repair.v1';
+import { executeMiraCoursewareProvider, MIRA_COURSEWARE_PROVIDER_SCHEMA, type MiraCoursewareProviderResult } from './mira-courseware-provider';
+import { paidBudgetContext } from './mira-paid-budget';
+import { qualitySha, qualitySnapshot } from './mira-formal-quality-contract';
+import type { FormalQualityInput, FormalQualityResult } from './mira-formal-teaching-quality';
+
+const SCHEMA = 'mira.openmaic.learner-discussion-repair.v1' as const;
+const SHA = /^[a-f0-9]{64}$/;
+const TARGETS = ['scene-p1', 'scene-p8'] as const;
+const object = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);
+const exact = (v: unknown, keys: string[]): v is Record<string, unknown> => object(v) && Object.keys(v).sort().join(',') === [...keys].sort().join(',');
+const fail = (reason: string): never => { throw new Error(`FORMAL_LEARNER_DISCUSSION_REPAIR_${reason}`); };
+export interface LearnerDiscussionInsertion {
+  sceneId: string;
+  afterActionCount: number;
+  action: DiscussionAction;
+}
+export interface LearnerDiscussionRepairReceipt {
+  schemaVersion: typeof SCHEMA;
+  promptVersion: typeof LEARNER_DISCUSSION_REPAIR_PROMPT_VERSION;
+  sessionId: string;
+  stageId: string;
+  sourceSnapshotSha256: string;
+  inputSnapshotSha256: string;
+  outputSnapshotSha256: string;
+  frozenContextSha256: string;
+  rejectedReviewSha256: string;
+  requestSha256: string;
+  providerResponseSha256: string;
+  providerRequestIdHash: string;
+  providerId: 'deepseek';
+  modelId: 'deepseek-v4-flash';
+  authorizationId: string;
+  namespace: string;
+  repairReference: string;
+  insertions: LearnerDiscussionInsertion[];
+  receiptSha256: string;
+}
+interface RepairContext { sourceSnapshotSha256: string; authorizationId: string; repairReference: string }
+interface RepairDeps { provider?: typeof executeMiraCoursewareProvider; cacheRoot?: string }
+
+async function saveExclusive(path: string, value: unknown) {
+  const file = await open(path, 'wx', 0o600);
+  try { await file.writeFile(JSON.stringify(value)); await file.sync(); } finally { await file.close(); }
+}
+async function json(path: string): Promise<unknown | undefined> {
+  try { return JSON.parse(await readFile(path, 'utf8')); }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined; throw error; }
+}
+function teacherId(input: FormalQualityInput): string {
+  const teachers = input.stage.generatedAgentConfigs?.filter(a => a.role === 'teacher') ?? [];
+  if (teachers.length !== 1 || !teachers[0].id) return fail('TEACHER_REQUIRED');
+  return teachers[0].id;
+}
+function validateInput(input: FormalQualityInput, rejected: FormalQualityResult, context: RepairContext) {
+  const snapshot = qualitySnapshot(input.stage, input.scenes);
+  if (!SHA.test(context.sourceSnapshotSha256) || !SHA.test(context.authorizationId) || !SHA.test(context.repairReference)
+      || input.selectionPlan.primaryMethod !== 'feynman-learning' || rejected.status !== 'needs_revision'
+      || rejected.snapshotSha256 !== qualitySha(snapshot) || rejected.receipt || !rejected.issues.length
+      || rejected.issues.some(issue => issue.sceneId !== 'scene-p3'
+        || !/feynman/i.test(issue.problem) || !/learner/i.test(issue.problem) || !/explain|explanation/i.test(issue.problem)))
+    return fail('REJECTION_SCOPE_INVALID');
+  if (snapshot.scenes.length !== 8 || snapshot.scenes[0].id !== TARGETS[0] || snapshot.scenes[7].id !== TARGETS[1])
+    return fail('SCENE_ORDER_INVALID');
+  for (const id of TARGETS) {
+    const s = input.scenes.find(scene => scene.id === id);
+    if (!s || s.type !== 'slide' || !s.actions?.length || s.actions.some(a => a.type === 'discussion'))
+      return fail('TARGET_INVALID');
+  }
+  return { snapshot, teacher: teacherId(input) };
+}
+
+function validateInsertions(raw: unknown, input: FormalQualityInput, teacher: string): LearnerDiscussionInsertion[] {
+  if (!exact(raw, ['insertions']) || !Array.isArray(raw.insertions) || raw.insertions.length !== 2)
+    return fail('RESPONSE_INVALID');
+  const usedIds = new Set(input.scenes.flatMap(s => s.actions ?? []).map(a => a.id));
+  for (const [i, insertion] of raw.insertions.entries()) {
+    const source = input.scenes.find(s => s.id === TARGETS[i])!;
+    if (!exact(insertion, ['sceneId', 'afterActionCount', 'action']) || insertion.sceneId !== TARGETS[i]
+        || insertion.afterActionCount !== source.actions!.length) return fail('INSERTION_INVALID');
+    const a = insertion.action;
+    if (!exact(a, ['id', 'type', 'topic', 'prompt', 'agentId']) || a.type !== 'discussion' || a.agentId !== teacher
+        || typeof a.id !== 'string' || !/^[A-Za-z][A-Za-z0-9_-]{2,100}$/.test(a.id) || usedIds.has(a.id)
+        || typeof a.topic !== 'string' || a.topic.trim().length < 4 || a.topic.length > 120
+        || typeof a.prompt !== 'string' || a.prompt.trim().length < 30 || a.prompt.length > 1200
+        || /[<>]/.test(a.topic + a.prompt) || !/真实|屏幕前/.test(a.prompt)
+        || !/等|等待/.test(a.prompt) || !/自己|自己的/.test(a.prompt)
+        || !/回答|解释|说出|复述/.test(a.prompt)) return fail('ACTION_INVALID');
+    usedIds.add(a.id);
+  }
+  return raw.insertions as unknown as LearnerDiscussionInsertion[];
+}
+
+function derive(input: FormalQualityInput, insertions: LearnerDiscussionInsertion[]): Scene[] {
+  return input.scenes.map(scene => {
+    const insertion = insertions.find(i => i.sceneId === scene.id);
+    return insertion ? { ...structuredClone(scene), actions: [...structuredClone(scene.actions ?? []), structuredClone(insertion.action)] as Action[] }
+      : structuredClone(scene);
+  });
+}
+
+/** No content rewriting or quality waiver: the caller must independently review
+ * the returned derived snapshot before speech materialization/publication. */
+export async function repairFormalLearnerDiscussions(
+  input: FormalQualityInput,
+  rejectedReview: FormalQualityResult,
+  context: RepairContext,
+  deps: RepairDeps = {},
+  signal?: AbortSignal,
+): Promise<{ scenes: Scene[]; receipt: LearnerDiscussionRepairReceipt }> {
+  const { snapshot, teacher } = validateInput(input, rejectedReview, context);
+  const namespace = `${input.sessionId}:completion`;
+  const paid = paidBudgetContext.getStore();
+  if (paid?.namespace !== namespace || paid.binding.authorizationId !== context.authorizationId || paid.binding.required !== true)
+    return fail('PAID_CONTEXT_REQUIRED');
+  const inputSnapshotSha256 = qualitySha(snapshot);
+  // Ledger-derived remaining counts are not part of the rejected course. A
+  // later read must not create a second identity for the same failed snapshot.
+  const normalizedRejection = { status: rejectedReview.status, snapshotSha256: rejectedReview.snapshotSha256, issues: rejectedReview.issues };
+  const frozenContext = { gradeBoundary: input.gradeBoundary, selectionPlan: input.selectionPlan, teachingBrief: input.teachingBrief };
+  const identity = { sessionId: input.sessionId, stageId: input.stage.id, sourceSnapshotSha256: context.sourceSnapshotSha256,
+    inputSnapshotSha256, frozenContextSha256: qualitySha(frozenContext), rejectedReviewSha256: qualitySha(normalizedRejection) };
+  const targets = TARGETS.map(sceneId => ({ sceneId, afterActionCount: input.scenes.find(s => s.id === sceneId)!.actions!.length }));
+  const responseJsonSchema = { type: 'object', additionalProperties: false, required: ['insertions'], properties: {
+    insertions: { type: 'array', minItems: 2, maxItems: 2, items: {
+      type: 'object', additionalProperties: false, required: ['sceneId', 'afterActionCount', 'action'], properties: {
+        sceneId: { type: 'string', enum: TARGETS }, afterActionCount: { type: 'integer', minimum: 1 },
+        action: { type: 'object', additionalProperties: false, required: ['id', 'type', 'topic', 'prompt', 'agentId'], properties: {
+          id: { type: 'string' }, type: { type: 'string', const: 'discussion' }, topic: { type: 'string', maxLength: 120 },
+          prompt: { type: 'string', maxLength: 1200 }, agentId: { type: 'string', const: teacher },
+        } },
+      },
+    } },
+  } };
+  const request = { schemaVersion: MIRA_COURSEWARE_PROVIDER_SCHEMA, requestId: `learner-repair-${qualitySha(identity)}`,
+    phase: 'learner_discussion_repair', systemPrompt: LEARNER_DISCUSSION_REPAIR_SYSTEM,
+    userPrompt: JSON.stringify({ promptVersion: LEARNER_DISCUSSION_REPAIR_PROMPT_VERSION, ...frozenContext,
+      rejectedReview: normalizedRejection, snapshot, teacherId: teacher, appendTargets: targets }), responseJsonSchema };
+  const folder = resolve(deps.cacheRoot ?? 'data/formal-learner-discussion-repairs', qualitySha(identity));
+  await mkdir(folder, { recursive: true, mode: 0o700 });
+  const completed = await json(join(folder, 'completion.json'));
+  if (completed !== undefined) {
+    if (!object(completed) || !object(completed.receipt) || !Array.isArray(completed.scenes)) return fail('CACHED_AUDIT_INVALID');
+    const { receiptSha256, ...unsigned } = completed.receipt;
+    const raw = await json(join(folder, 'provider-response.json'));
+    const claim = await json(join(folder, 'dispatch.claim'));
+    const archivedRequest = await json(join(folder, 'request.json'));
+    const archivedInput = await json(join(folder, 'input.json'));
+    const archivedRejection = await json(join(folder, 'rejected-review.json'));
+    if (receiptSha256 !== qualitySha(unsigned) || !object(raw) || typeof raw.content !== 'string'
+        || !object(claim) || claim.requestSha256 !== qualitySha(request)
+        || claim.authorizationId !== context.authorizationId || claim.namespace !== namespace
+        || claim.repairReference !== context.repairReference
+        || Object.entries(identity).some(([k, v]) => claim[k] !== v)
+        || qualitySha(archivedRequest) !== qualitySha(request)
+        || qualitySha(archivedInput) !== qualitySha({ ...identity, frozenContext, snapshot, sourceScenes: input.scenes })
+        || qualitySha(archivedRejection) !== identity.rejectedReviewSha256
+        || raw.schemaVersion !== MIRA_COURSEWARE_PROVIDER_SCHEMA || raw.phase !== request.phase || raw.requestId !== request.requestId
+        || qualitySha(raw) !== unsigned.providerResponseSha256 || qualitySha(request) !== unsigned.requestSha256
+        || Object.entries(identity).some(([k, v]) => unsigned[k] !== v)
+        || unsigned.schemaVersion !== SCHEMA || unsigned.promptVersion !== LEARNER_DISCUSSION_REPAIR_PROMPT_VERSION
+        || unsigned.authorizationId !== context.authorizationId || unsigned.namespace !== namespace
+        || unsigned.repairReference !== context.repairReference
+        || unsigned.providerId !== 'deepseek' || unsigned.modelId !== 'deepseek-v4-flash'
+        || unsigned.providerRequestIdHash !== raw.providerRequestIdHash) return fail('CACHED_AUDIT_INVALID');
+    const insertions = validateInsertions(JSON.parse(raw.content), input, teacher);
+    const scenes = derive(input, insertions);
+    if (qualitySha(insertions) !== qualitySha(unsigned.insertions) || qualitySha(scenes) !== qualitySha(completed.scenes)
+        || qualitySha(qualitySnapshot(input.stage, scenes)) !== unsigned.outputSnapshotSha256)
+      return fail('CACHED_OUTPUT_CHANGED');
+    return { scenes, receipt: completed.receipt as unknown as LearnerDiscussionRepairReceipt };
+  }
+  // Acquiring this append-only claim precedes every potential Provider call.
+  // An interrupted or failed attempt cannot be reminted by another process.
+  try { await saveExclusive(join(folder, 'dispatch.claim'), { ...identity, authorizationId: context.authorizationId,
+    namespace, repairReference: context.repairReference, requestSha256: qualitySha(request), startedAt: Date.now() }); }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'EEXIST') return fail('PRIOR_DISPATCH_REQUIRES_AUDIT'); throw error; }
+  try {
+    await saveExclusive(join(folder, 'input.json'), { ...identity, frozenContext, snapshot, sourceScenes: input.scenes });
+    await saveExclusive(join(folder, 'rejected-review.json'), normalizedRejection);
+    await saveExclusive(join(folder, 'request.json'), request);
+    signal?.throwIfAborted();
+    const response: MiraCoursewareProviderResult = await (deps.provider ?? executeMiraCoursewareProvider)(request, signal);
+    await saveExclusive(join(folder, 'provider-response.json'), response);
+    if (response.schemaVersion !== MIRA_COURSEWARE_PROVIDER_SCHEMA || response.phase !== request.phase
+        || response.requestId !== request.requestId || !SHA.test(response.providerRequestIdHash)) return fail('PROVIDER_IDENTITY_INVALID');
+    signal?.throwIfAborted();
+    const insertions = validateInsertions(JSON.parse(response.content), input, teacher);
+    const scenes = derive(input, insertions);
+    const unsigned = { schemaVersion: SCHEMA, promptVersion: LEARNER_DISCUSSION_REPAIR_PROMPT_VERSION, ...identity,
+      outputSnapshotSha256: qualitySha(qualitySnapshot(input.stage, scenes)), requestSha256: qualitySha(request),
+      providerResponseSha256: qualitySha(response), providerRequestIdHash: response.providerRequestIdHash,
+      providerId: 'deepseek' as const, modelId: 'deepseek-v4-flash' as const,
+      authorizationId: context.authorizationId, namespace, repairReference: context.repairReference, insertions } as const;
+    const receipt: LearnerDiscussionRepairReceipt = { ...unsigned, receiptSha256: qualitySha(unsigned) };
+    await saveExclusive(join(folder, 'completion.json'), { scenes, receipt });
+    return { scenes, receipt };
+  } catch (error) {
+    await saveExclusive(join(folder, 'failure.json'), { ...identity, requestSha256: qualitySha(request),
+      failedAt: Date.now(), error: error instanceof Error ? error.message : String(error), retryAllowed: false });
+    throw error;
+  }
+}
