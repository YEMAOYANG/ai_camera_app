--- /dev/null
+++ b/scripts/formal-learner-discussion-completion-claim.ts
@@ -0,0 +1,38 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { qualitySha } from '../lib/server/mira-formal-quality-contract';
+
+export interface LearnerRepairCompletionIdentity {
+  sourceJobSha256: string;
+  sourceSnapshotSha256: string;
+  repairSnapshotSha256: string;
+  sessionId: string;
+  stageId: string;
+}
+
+/** A distinct one-time action after the exact original completion failed.
+ * The original claim and every paid outcome remain untouched. */
+export async function claimLearnerDiscussionCompletion(
+  folder: string, identity: LearnerRepairCompletionIdentity, completionTailGrantSha256: string,
+) {
+  if (!/^[a-f0-9]{64}$/.test(completionTailGrantSha256)
+      || !/^[a-f0-9]{64}$/.test(identity.repairSnapshotSha256))
+    throw new Error('SAVED_STAGE_LEARNER_REPAIR_CLAIM_IDENTITY_INVALID');
+  try {
+    await fs.access(path.join(folder, 'completion.json'));
+    throw new Error('SAVED_STAGE_LEARNER_REPAIR_ALREADY_COMPLETED');
+  } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
+  const prior = JSON.parse(await fs.readFile(path.join(folder, `complete-${identity.repairSnapshotSha256}.claim`), 'utf8'));
+  if (!prior || Object.entries(identity).some(([key, value]) => prior[key] !== value)
+      || prior.completionTailGrantSha256 !== completionTailGrantSha256
+      || prior.reviewGrantSha256 !== undefined)
+    throw new Error('SAVED_STAGE_LEARNER_REPAIR_PRIOR_CLAIM_MISMATCH');
+  const priorCompletionClaimSha256 = qualitySha(prior);
+  const claim = await fs.open(path.join(folder, `complete-${identity.repairSnapshotSha256}-learner-discussion-repair.claim`), 'wx', 0o600);
+  try {
+    await claim.writeFile(JSON.stringify({ ...identity, completionTailGrantSha256,
+      priorCompletionClaimSha256, pid: process.pid, createdAt: new Date().toISOString() }));
+    await claim.sync();
+  } finally { await claim.close(); }
+  return priorCompletionClaimSha256;
+}
