+  });
+  it.each(['snapshot','method','teacher','order','existing-discussion','unrelated-rejection','paid-namespace','paid-authorization'])('rejects %s before dispatch',async scenario=>{
+    const i=input(), r=rejection(i),p=provider(i);
+    if(scenario==='snapshot')r.snapshotSha256='f'.repeat(64);
+    if(scenario==='method')i.selectionPlan.primaryMethod='workshop-style';
+    if(scenario==='teacher')i.stage.generatedAgentConfigs=[];
+    if(scenario==='order')i.scenes[0].order=10;
+    if(scenario==='existing-discussion')i.scenes[0].actions!.push({id:'existing',type:'discussion',topic:'already here'});
+    if(scenario==='unrelated-rejection')r.issues[0].problem='Missing fraction math';
+    if(scenario==='paid-namespace')mocks.paid.mockReturnValue({namespace:'other',binding:{authorizationId:context.authorizationId,required:true}});
