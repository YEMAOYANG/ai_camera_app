+import { afterEach, describe, expect, it } from 'vitest';
+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+import { claimLearnerDiscussionCompletion } from '../../scripts/formal-learner-discussion-completion-claim';
+
+const folders: string[] = [];
+afterEach(async () => { await Promise.all(folders.splice(0).map(folder => fs.rm(folder, { recursive: true, force: true }))); });
+async function fixture() {
+  const folder = await fs.mkdtemp(path.join(os.tmpdir(), 'learner-repair-claim-')); folders.push(folder);
+  const identity = { sourceJobSha256: 'a'.repeat(64), sourceSnapshotSha256: 'b'.repeat(64),
+    repairSnapshotSha256: 'c'.repeat(64), sessionId: 'original', stageId: 'stage-original' };
+  const grant = 'd'.repeat(64);
+  const prior = { ...identity, completionTailGrantSha256: grant, pid: 123, createdAt: '2026-09-14T01:30:00Z' };
+  const priorPath = path.join(folder, `complete-${identity.repairSnapshotSha256}.claim`);
+  await fs.writeFile(priorPath, JSON.stringify(prior));
+  return { folder, identity, grant, prior, priorPath };
+}
+describe('explicit AI learner-discussion completion claim', () => {
+  it('allows one concurrent claim and preserves the original paid attempt bytes', async () => {
+    const { folder, identity, grant, prior, priorPath } = await fixture();
+    const before = await fs.readFile(priorPath);
+    const results = await Promise.allSettled([1, 2].map(() => claimLearnerDiscussionCompletion(folder, identity, grant)));
+    expect(results.filter(r => r.status === 'fulfilled')).toHaveLength(1);
+    expect(results.find(r => r.status === 'fulfilled')).toEqual({ status: 'fulfilled', value: qualitySha(prior) });
+    expect(await fs.readFile(priorPath)).toEqual(before);
+    await expect(claimLearnerDiscussionCompletion(folder, identity, grant)).rejects.toMatchObject({ code: 'EEXIST' });
+  });
+  it.each(['missing', 'different source', 'different grant', 'review grant', 'completed'])('rejects %s without a new claim', async kind => {
+    const { folder, identity, grant, prior, priorPath } = await fixture();
+    if (kind === 'missing') await fs.unlink(priorPath);
+    if (kind === 'different source') await fs.writeFile(priorPath, JSON.stringify({ ...prior, sourceSnapshotSha256: 'e'.repeat(64) }));
+    if (kind === 'different grant') await fs.writeFile(priorPath, JSON.stringify({ ...prior, completionTailGrantSha256: 'f'.repeat(64) }));
+    if (kind === 'review grant') await fs.writeFile(priorPath, JSON.stringify({ ...prior, reviewGrantSha256: 'f'.repeat(64) }));
+    if (kind === 'completed') await fs.writeFile(path.join(folder, 'completion.json'), '{}');
+    await expect(claimLearnerDiscussionCompletion(folder, identity, grant)).rejects.toThrow();
+    expect((await fs.readdir(folder)).some(file => file.endsWith('-learner-discussion-repair.claim'))).toBe(false);
+  });
+});
