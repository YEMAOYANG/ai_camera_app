+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { FormalQualityInput, FormalQualityResult } from '@/lib/server/mira-formal-teaching-quality';
+import { qualitySha, qualitySnapshot } from '@/lib/server/mira-formal-quality-contract';
+import { repairFormalLearnerDiscussions } from '@/lib/server/mira-formal-learner-discussion-repair';
+const mocks = vi.hoisted(() => ({ paid: vi.fn() }));
+vi.mock('@/lib/server/mira-paid-budget', () => ({ paidBudgetContext: { getStore: mocks.paid } }));
+vi.mock('@/lib/server/mira-courseware-provider', () => ({ MIRA_COURSEWARE_PROVIDER_SCHEMA: 'mira.openmaic.courseware-provider-call.v1', executeMiraCoursewareProvider: vi.fn() }));
+const context = { sourceSnapshotSha256: 'a'.repeat(64), authorizationId: 'b'.repeat(64), repairReference: 'c'.repeat(64) };
+function input(): FormalQualityInput {
+  return { stage: { id: 'stage-test', name: '分数课堂', generatedAgentConfigs: [{ id: 'teacher', role: 'teacher' }] },
+    sessionId: 'test-session', ownerId: 'test-owner', gradeBoundary: { gradeCode: 'primary_6' },
+    selectionPlan: { planSha256: 'd'.repeat(64), primaryMethod: 'feynman-learning' }, teachingBrief: { objective: '理解分数' },
+    scenes: ['p1','p2','p4','p3','p5','p6','p7','p8'].map((id,i) => ({
+      id: `scene-${id}`, title: id, order: i, type: ['p3','p5'].includes(id) ? 'interactive' : ['p6','p7'].includes(id) ? 'quiz' : 'slide',
+      content: { type: 'slide', html: `<p>${id} immutable</p>`, questions: ['p6','p7'].includes(id) ? [{ id: `${id}-q1` },{ id: `${id}-q2` }] : [] },
+      actions: Array.from({length: i < 4 ? 5 : 4}, (_,j) => ({ id: `${id}-speech-${j}`,type: 'speech',text: `${id} original narration ${j}` })),
