@@ -1687,3 +1687,32 @@
     padding-bottom: var(--mira-presentation-content-inset, 276px);
   }
 }
+
+/* Short landscape reserves two stable rows: narration/discussion above the
+ * navigation row. Showing chrome never moves a pressed activity control. */
+@media (min-width: 641px) and (max-height: 500px) {
+  [data-mira-classroom-root]:fullscreen [data-mira-canvas-area] {
+    box-sizing: border-box;
+    padding-bottom: var(--mira-presentation-content-inset, 176px);
+  }
+  [data-mira-presentation-chrome] [data-mira-left-speech] {
+    position: fixed;
+    left: 8px;
+    bottom: calc(var(--mira-presentation-toolbar-height, 76px) + 12px);
+  }
+  [data-mira-presentation-chrome] [data-mira-presentation-dock] {
+    bottom: calc(var(--mira-presentation-toolbar-height, 76px) + 12px);
+    right: 8px !important;
+  }
+  [data-mira-presentation-chrome] [data-mira-presentation-toolbar] {
+    right: 0 !important;
+    padding-inline: 4px;
+  }
+  [data-mira-presentation-chrome] [data-mira-presentation-toolbar] > div { max-width: 100%; padding: 4px; }
+  [data-mira-presentation-chrome] [data-mira-chrome="playback-controls"] { height: auto; padding: 0; gap: 0; }
+  [data-mira-presentation-chrome] [data-mira-chrome="playback-controls"] button,
+  [data-mira-presentation-chrome] [data-mira-discussion-rail="dock"] > button {
+    box-sizing: border-box; min-width: 48px; min-height: 48px; height: 48px; flex-shrink: 0;
+  }
+  [data-mira-presentation-chrome] [data-mira-chrome="playback-controls"] [data-mira-indicator="toolbar-divider"] { display: none; }
+}
