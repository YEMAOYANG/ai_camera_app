+describe('explicit ZCS v2 natural Chinese revision recipe', () => {
+  const versionV2 = 'mira.textbook.pinyin-zcs-ssml.v2';
+
+  it('matches the Python policy and exact physical-body vector', () => {
+    expect(policyV2Sha).toBe('aa4ccf02d781fcbec0212f469abdfc035f610de1c5ef56ce8688c7fa8683017c');
+    const source = path.resolve(process.cwd(), '../../../backend/content/textbook_pinyin_pronunciation_zcs.v2.json');
+    if (existsSync(source)) expect(policyV2).toEqual(JSON.parse(readFileSync(source, 'utf8')));
+    const text = '中间这个字读句。我们把一句完整的话叫作句子，请看清这个字。';
+    const result = prepare(text, versionV2);
+    expect(result.ssml).toBe(`<speak>${text}</speak>`);
+    expect(result.providerPronunciation.providerBodySha256)
+      .toBe('66fef3519cc22e5d39e8e3405242a667df09a0b7750ce215c9edaddb1489fa6f');
+    expect(prepare(text, version).providerPronunciation.providerBodySha256)
+      .toBe('85bcc656ad2b2a51f9eafa308c1b06cb662196f2e727afcfa6312707cd2eb040');
+  });
+
+  it('preserves all Latin recipes and provider settings while removing the Chinese word override', () => {
+    expect(policyV2.policyVersion).toBe(versionV2);
+    expect(policyV2.words).toEqual({});
+    expect(policy.words).toEqual({ '句子': { ph: 'ju4 zi5', carrier: '句子' } });
+    for (const field of ['symbols', 'subject', 'providerId', 'modelId', 'voiceId', 'endpointPath',
+      'inputParameters', 'textHandling', 'listeningRequired'] as const) {
+      expect(policyV2[field]).toEqual(policy[field]);
+    }
+    expect(Object.keys(policyV2.symbols)).toHaveLength(28);
+    for (const [token] of cases) {
+      const source = `请听：${token}。`;
+      const original = prepare(source, version);
+      const revised = prepare(source, versionV2);
+      expect(revised.ssml).toBe(original.ssml);
+      expect(revised.providerBody).toBe(original.providerBody);
+      expect(revised.profile.policyVersion).not.toBe(original.profile.policyVersion);
+      expect(revised.profile.policySha256).not.toBe(original.profile.policySha256);
+    }
+  });
+
+  it('keeps the complete Chinese text natural without decomposing whole recognition tokens', () => {
+    const source = '句子和孩子；字、词、句、子。请听：zi、ci、si、zǐ、cì、sī。';
+    expect(prepare(source, versionV2).ssml).toBe('<speak>句子和孩子；字、词、句、子。请听：' +
+      '<phoneme alphabet="py" ph="zi1">资</phoneme>、' +
+      '<phoneme alphabet="py" ph="ci1">疵</phoneme>、' +
+      '<phoneme alphabet="py" ph="si1">丝</phoneme>、' +
+      '<phoneme alphabet="py" ph="zi3">子</phoneme>、' +
+      '<phoneme alphabet="py" ph="ci4">次</phoneme>、' +
+      '<phoneme alphabet="py" ph="si1">丝</phoneme>。</speak>');
+    expect(prepare('句子和孩子。', version).ssml)
+      .toBe('<speak><phoneme alphabet="py" ph="ju4 zi5">句子</phoneme>和孩子。</speak>');
+    expect(policyV2.approvalBoundary.humanListeningVerified).toBe(false);
+    expect(policyV2.approvalBoundary.perceptualToneVerified).toBe(false);
+    expect(policyV2.approvalBoundary.formalUseAllowed).toBe(false);
+  });
+
+  it('requires the exact v1 or v2 identity rather than interchanging their receipts', () => {
+    const text = '句子和孩子。请听：zuó。';
+    const original = prepare(text, version);
+    const revised = prepare(text, versionV2);
+    expect(isMiraTextbookPinyinProviderPronunciation(original.providerPronunciation, sha(text))).toBe(true);
+    expect(isMiraTextbookPinyinProviderPronunciation(revised.providerPronunciation, sha(text))).toBe(true);
+    for (const [record, other] of [[original.providerPronunciation, revised.providerPronunciation],
