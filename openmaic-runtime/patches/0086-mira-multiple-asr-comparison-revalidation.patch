+/** One receipt per original ASR. A set cannot mix classroom or source-job authority. */
+export function normalizeAsrComparisonReferences(value: AsrComparisonReferences | undefined): AsrComparisonReference[] {
+  if (value === undefined) return [];
+  const references = Array.isArray(value) ? [...value] : [value];
+  if (!references.length || references.length > 240) fail();
+  const identities = new Set<string>();
+  const first = references[0];
+  for (const reference of references) {
+    if (!reference || typeof reference !== 'object' || Array.isArray(reference) ||
+      Object.keys(reference).sort().join(',') !== 'asrRequestId,receiptSha256,sessionId,snapshotSha256,sourceJobSha256,stageId' ||
+      typeof reference.asrRequestId !== 'string' || !/^formal_asr_[A-Za-z0-9_-]+$/.test(reference.asrRequestId) ||
+      !/^miraformal_[a-f0-9]{64}$/.test(reference.sessionId) || !/^[A-Za-z0-9_-]+$/.test(reference.stageId) ||
+      ![reference.snapshotSha256, reference.sourceJobSha256, reference.receiptSha256].every(value => HASH.test(value)) ||
+      ['sessionId', 'stageId', 'snapshotSha256', 'sourceJobSha256'].some(key =>
+        reference[key as keyof AsrComparisonReference] !== first[key as keyof AsrComparisonReference]) ||
+      identities.has(reference.asrRequestId)) fail();
+    identities.add(reference.asrRequestId);
+  }
+  return references.sort((left, right) => left.asrRequestId < right.asrRequestId ? -1 : 1);
+}
+
+export function asrComparisonClaimSha256(references: AsrComparisonReferences): string {
+  const normalized = normalizeAsrComparisonReferences(references);
+  // Preserve the existing single-receipt claim, including an array of one.
+  return normalized.length === 1 ? normalized[0].receiptSha256 : qualitySha(normalized);
+}
 
