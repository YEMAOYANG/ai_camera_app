--- /dev/null
+++ b/tests/server/mira-formal-slide-layout.browser.test.ts
@@ -0,0 +1,100 @@
+/** Actual SlideCanvas geometry in a memory-only Chrome page: no server or model. */
+import { createRequire } from 'node:module';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { chromium, type Browser, type Page } from 'playwright-core';
+import type { Slide } from '@openmaic/dsl';
+import {
+  createDefaultShapeElement, createDefaultSlide, createDefaultTextElement,
+} from '@/lib/edit/slide-edit-elements';
+import type { observeFormalSceneDom } from '@/lib/server/mira-formal-scene-dom';
+
+type FixtureWindow = Window & {
+  renderSlide: (slide: Slide) => void;
+  observeSlide: typeof observeFormalSceneDom;
+};
+const panel = (id: string, top: number, height: number, fill = '#dbeafe') => ({
+  ...createDefaultShapeElement(id), left: 60, top, width: 880, height, fill,
+});
+const text = (id: string, top: number, content: string) => ({
+  ...createDefaultTextElement(id), left: 146, top, width: 710, height: 49,
+  content: `<p style="font-size:18px">${content}</p>`,
+});
+
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== '1')('slide panel paint and containment', () => {
+  let browser: Browser;
+  let page: Page;
+  beforeAll(async () => {
+    const require = createRequire(import.meta.url);
+    const { build } = createRequire(require.resolve('tsx'))('esbuild');
+    const result = await build({
+      stdin: {
+        resolveDir: process.cwd(), loader: 'tsx',
+        contents: `import React from 'react';import {createRoot} from 'react-dom/client';
+          import {SlideCanvas} from '@openmaic/renderer';
+          import {observeFormalSceneDom} from './lib/server/mira-formal-scene-dom';
+          const root=createRoot(document.getElementById('formal-scene-root'));
+          window.renderSlide=slide=>root.render(React.createElement(SlideCanvas,{slide,chrome:false}));
+          window.observeSlide=observeFormalSceneDom;`,
+      },
+      bundle: true, write: false, format: 'iife', platform: 'browser',
+      define: { 'process.env.NODE_ENV': '"production"' },
+      loader: { '.css': 'empty' }, logLevel: 'silent',
+    });
+    browser = await chromium.launch({
+      executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH ??
+        '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
+      headless: true,
+    });
+    page = await browser.newPage({ viewport: { width: 1280, height: 720 } });
+    await page.route('**/*', route => route.abort());
+    await page.setContent('<style>html,body{margin:0}#formal-scene-root{width:100vw;height:100vh}</style><main id="formal-scene-root"></main>');
+    await page.addScriptTag({ content: result.outputFiles[0].text });
+  }, 30_000);
+  afterAll(async () => { await browser?.close(); });
+  async function inspect(elements: Slide['elements']) {
+    await page.evaluate(slide => (window as unknown as FixtureWindow).renderSlide(slide), {
+      ...createDefaultSlide('layout-fixture'), elements,
+    });
+    await page.evaluate(async () => {
+      await document.fonts.ready;
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+    });
+    return page.evaluate(() => (window as unknown as FixtureWindow).observeSlide());
+  }
+  it('rejects text escaping its panel and hidden by a later opaque panel at both viewports', async () => {
+    for (const viewport of [{ width: 1280, height: 720 }, { width: 1024, height: 768 }]) {
+      await page.setViewportSize(viewport);
+      const result = await inspect([
+        panel('method', 160, 166), text('anchor', 180, '方法要点'),
+        text('spill', 311, '分数转成百分数：先化小数'),
+        { id: 'formula', type: 'latex', left: 200, top: 315, width: 120, height: 40,
+          rotate: 0, latex: '3/5', color: '#333333', fixedRatio: true,
+          path: 'M0 0 L120 40 M120 0 L0 40', viewBox: [120, 40] },
+        text('covered', 360, '求部分量＝整体乘分数'), panel('reflection', 350, 148),
+        text('question', 410, '现在怎么想？'),
+      ]);
+      expect(result.metrics.slideLayoutIssues).toEqual(expect.arrayContaining([
+        'text_outside_panel:slide-element-spill:slide-element-method',
+        'text_outside_panel:slide-element-formula:slide-element-method',
+        'text_occluded_by_panel:slide-element-covered:slide-element-reflection',
+      ]));
+      // The former scroll/whole-canvas checks do not detect these failures.
+      expect(result.metrics.outsideCanvas).toEqual([]);
+      expect(result.metrics.textOverflow).toEqual([]);
+    }
+  });
+  it('allows contained teaching text, separate captions, thin rules and translucent decoration', async () => {
+    const result = await inspect([
+      panel('card', 160, 180), text('heading', 180, '练一练'),
+      text('body', 245, '请写出你的理由'),
+      panel('highlight', 240, 70, 'rgba(255, 230, 0, 0.15)'),
+      panel('divider', 305, 2), text('caption', 360, '图外的说明可以独立排版'),
+    ]);
+    expect(result.metrics.slideLayoutIssues).toEqual([]);
+  });
+  it('does not impose slide panel relationships on quiz or interactive controls', async () => {
+    await page.setContent('<main id="formal-scene-root"><section style="background:#eee;width:200px;height:40px"><label>答题区</label></section><label style="margin-top:30px">独立题目说明</label><input aria-label="答案"></main>');
+    // Reuse the exact browser function after replacing the React fixture.
+    expect(await page.evaluate(() => (window as unknown as FixtureWindow).observeSlide().metrics.slideLayoutIssues)).toEqual([]);
+  });
+});
