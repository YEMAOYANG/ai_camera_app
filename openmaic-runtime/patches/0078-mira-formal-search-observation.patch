diff --git a/tests/server/mira-formal-research-observation.test.ts b/tests/server/mira-formal-research-observation.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-research-observation.test.ts
@@ -0,0 +1,70 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { PersistedAgentSessionEvent } from '@openmaic/storage';
+
+const mocks = vi.hoisted(() => ({ observation: vi.fn(), materials: vi.fn(), text: vi.fn() }));
+vi.mock('@/lib/server/mira-paid-budget', async (actual) => ({
+  ...(await actual<typeof import('@/lib/server/mira-paid-budget')>()),
+  isPaidBudgetObservationMode: mocks.observation,
+}));
+vi.mock('@/lib/server/agent-runtime/session-materials', async (actual) => ({
+  ...(await actual<typeof import('@/lib/server/agent-runtime/session-materials')>()),
+  listSessionMaterials: mocks.materials,
+  resolveSessionMaterialText: mocks.text,
+}));
+import { loadResearchEvidence } from '@/lib/server/mira-formal-professional-classroom';
+
+const events = Array.from({ length: 5 }, (_, index) => ({
+  type: 'mira_formal_research_search',
+  data: {
+    kind: 'mira_formal_research_search',
+    schemaVersion: 'mira.openmaic.research-search-trace.v1',
+    query: `query-${index}`,
+    providerId: 'baidu',
+    searchedAt: '2026-09-10T00:00:00.000Z',
+    resultCount: 1,
+    sources: [{ title: 'Source', url: 'https://example.org', score: 0.9 }],
+  },
+})) as PersistedAgentSessionEvent[];
+
+beforeEach(() => {
+  mocks.observation.mockReset().mockResolvedValue(true);
+  mocks.materials
+    .mockReset()
+    .mockResolvedValue([
+      {
+        kind: 'web',
+        sourceUrl: 'https://example.org',
+        title: 'Source',
+        textAssetId: 'fetched-text',
+      },
+    ]);
+  mocks.text.mockReset().mockResolvedValue('Actual fetched source text');
+});
+
+describe('formal research completion in observation mode', () => {
+  it('keeps every valid search, while retaining the default maximum and minimum evidence requirements', async () => {
+    const original = JSON.stringify(events);
+    const evidence = await loadResearchEvidence(events, 'test-session');
+    expect(evidence.traces).toHaveLength(5);
+    expect(evidence.fetched).toEqual([
+      {
+        title: 'Source',
+        url: 'https://example.org/',
+        textSha256: expect.stringMatching(/^[a-f0-9]{64}$/),
+      },
+    ]);
+    expect(JSON.stringify(events)).toBe(original);
+    mocks.observation.mockResolvedValue(false);
+    await expect(loadResearchEvidence(events, 'test-session')).rejects.toThrow(
+      'RESEARCH_SEARCH_COUNT_INVALID',
+    );
+    mocks.observation.mockResolvedValue(true);
+    await expect(loadResearchEvidence([], 'test-session')).rejects.toThrow(
+      'RESEARCH_SEARCH_COUNT_INVALID',
+    );
+    mocks.text.mockResolvedValue('');
+    await expect(loadResearchEvidence(events, 'test-session')).rejects.toThrow(
+      'RESEARCH_FETCH_MISSING',
+    );
+  });
+});
