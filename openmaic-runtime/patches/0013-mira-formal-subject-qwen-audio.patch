+const ASR_KEYS = [
+  'actionId',
+  'audioSha256',
+  'classroomContentSha256',
+  'classroomId',
+  'narrationSegmentId',
+  'requestId',
+  'sceneId',
+  'sceneOrder',
+  'subject',
+  'teacherGender',
+  'teacherProfileId',
+  'teacherProfileSha256',
+  'teacherProfileVersion',
