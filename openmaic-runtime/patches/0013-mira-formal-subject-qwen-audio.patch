+  | 'not_found'
+  | 'unauthorized'
+  | 'provider_unavailable'
+  | 'asset_unavailable';
+
+export class MiraFormalAudioError extends Error {
+  constructor(
+    public readonly code: MiraFormalAudioErrorCode,
+    message: string,
+  ) {
+    super(message);
+    this.name = 'MiraFormalAudioError';
+  }
