+import type { NextRequest } from 'next/server';
+import { apiError, apiSuccess } from '@/lib/server/api-response';
+import {
+  authorizeMiraFormalAudioRequest,
+  executeMiraFormalTts,
+  MiraFormalAudioError,
+  readMiraFormalTtsAsset,
+  readMiraFormalTtsJob,
+  type MiraFormalTtsJob,
+} from '@/lib/server/mira-formal-audio';
+
+export const dynamic = 'force-dynamic';
+export const maxDuration = 360;
+
+function safeRecord(record: MiraFormalTtsJob, requestPath: string) {
+  const { assetFileName: _privateAssetFileName, ...safe } = record;
+  return {
+    ...safe,
+    ...(record.state === 'succeeded'
+      ? {
+          downloadUrl: `${requestPath}?requestId=${encodeURIComponent(record.requestId)}&download=1`,
+        }
+      : {}),
+    done: record.state !== 'running',
+  };
+}
+
+function errorResponse(error: unknown) {
+  if (error instanceof MiraFormalAudioError) {
+    if (error.code === 'unauthorized') {
+      return apiError('INVALID_CREDENTIALS', 403, 'Invalid formal audio credentials');
+    }
+    if (error.code === 'request_conflict') {
+      return apiError('INVALID_REQUEST', 409, 'Formal TTS request conflict');
+    }
+    if (error.code === 'not_found' || error.code === 'asset_unavailable') {
+      return apiError('INVALID_REQUEST', 404, 'Formal TTS job not found');
+    }
+    if (error.code === 'provider_unavailable') {
+      return apiError('PROVIDER_DISABLED', 503, 'Formal TTS provider is unavailable');
+    }
+    return apiError('INVALID_REQUEST', 400, 'Invalid formal TTS request');
+  }
+  return apiError('INTERNAL_ERROR', 500, 'Formal TTS request failed');
+}
+
+export async function POST(req: NextRequest) {
+  try {
+    authorizeMiraFormalAudioRequest(req);
+    const result = await executeMiraFormalTts(await req.json());
+    return apiSuccess(
+      safeRecord(result.record, req.nextUrl.pathname),
+      result.record.state === 'running' ? 202 : 200,
+    );
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function GET(req: NextRequest) {
+  try {
+    authorizeMiraFormalAudioRequest(req);
+    const keys = [...req.nextUrl.searchParams.keys()].sort();
+    const download = req.nextUrl.searchParams.get('download');
+    const expectedKeys = download === null ? ['requestId'] : ['download', 'requestId'];
+    if (keys.join(',') !== expectedKeys.join(',') || (download !== null && download !== '1')) {
+      return apiError('INVALID_REQUEST', 400, 'Invalid formal TTS query');
+    }
+    const requestId = req.nextUrl.searchParams.get('requestId') || '';
+    if (download === '1') {
+      const { record, bytes } = await readMiraFormalTtsAsset(requestId);
+      return new Response(Buffer.from(bytes), {
+        status: 200,
+        headers: {
+          'content-type': 'audio/wav',
+          'content-length': String(bytes.byteLength),
+          'cache-control': 'private, no-store',
+          'x-content-type-options': 'nosniff',
+          'x-mira-audio-sha256': record.audioSha256 || '',
+        },
+      });
+    }
+    const record = await readMiraFormalTtsJob(requestId);
+    if (!record) return apiError('INVALID_REQUEST', 404, 'Formal TTS job not found');
+    return apiSuccess(
+      safeRecord(record, req.nextUrl.pathname),
+      record.state === 'running' ? 202 : 200,
+    );
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
