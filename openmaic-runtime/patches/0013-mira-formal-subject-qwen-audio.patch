+  ) {
+    super(safeCode);
+  }
+}
+
+const IDENTIFIER = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
+const SHA256 = /^[a-f0-9]{64}$/;
+const TTS_KEYS = [
+  'actionId',
+  'classroomContentSha256',
+  'classroomId',
+  'narrationSegmentId',
+  'requestId',
+  'sceneId',
+  'sceneOrder',
+  'subject',
+  'teacherGender',
+  'teacherProfileId',
+  'teacherProfileSha256',
+  'teacherProfileVersion',
+  'text',
+  'textSha256',
