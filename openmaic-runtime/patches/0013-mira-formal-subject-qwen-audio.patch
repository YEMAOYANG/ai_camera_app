+    text.length > 8_000 ||
+    text !== text.trim() ||
+    /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/u.test(text) ||
+    !SHA256.test(String(input.textSha256 || '')) ||
+    sha256(text) !== input.textSha256
