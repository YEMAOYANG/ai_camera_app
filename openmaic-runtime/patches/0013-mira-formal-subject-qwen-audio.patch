+import type { NextRequest } from 'next/server';
+import { apiError, apiSuccess } from '@/lib/server/api-response';
+import {
+  authorizeMiraFormalAudioRequest,
+  executeMiraFormalAsr,
+  MiraFormalAudioError,
+  readMiraFormalAsrJob,
+  type MiraFormalAsrJob,
+} from '@/lib/server/mira-formal-audio';
+
+export const dynamic = 'force-dynamic';
+export const maxDuration = 180;
+
+function safeRecord(record: MiraFormalAsrJob) {
+  return { ...record, done: record.state !== 'running' };
+}
+
+function errorResponse(error: unknown) {
+  if (error instanceof MiraFormalAudioError) {
+    if (error.code === 'unauthorized') {
+      return apiError('INVALID_CREDENTIALS', 403, 'Invalid formal audio credentials');
+    }
+    if (error.code === 'request_conflict') {
+      return apiError('INVALID_REQUEST', 409, 'Formal ASR request conflict');
+    }
+    if (error.code === 'not_found' || error.code === 'asset_unavailable') {
+      return apiError('INVALID_REQUEST', 404, 'Matching formal TTS WAV is unavailable');
+    }
+    if (error.code === 'provider_unavailable') {
+      return apiError('PROVIDER_DISABLED', 503, 'Formal ASR provider is unavailable');
+    }
+    return apiError('INVALID_REQUEST', 400, 'Invalid formal ASR request');
+  }
+  return apiError('INTERNAL_ERROR', 500, 'Formal ASR request failed');
+}
+
+export async function POST(req: NextRequest) {
+  try {
+    authorizeMiraFormalAudioRequest(req);
+    const result = await executeMiraFormalAsr(await req.json());
+    return apiSuccess(
+      {
+        ...safeRecord(result.record),
+        ...(result.transcript !== undefined ? { transcript: result.transcript } : {}),
+      },
+      result.record.state === 'running' ? 202 : 200,
+    );
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function GET(req: NextRequest) {
+  try {
+    authorizeMiraFormalAudioRequest(req);
+    if ([...req.nextUrl.searchParams.keys()].join(',') !== 'requestId') {
+      return apiError('INVALID_REQUEST', 400, 'Invalid formal ASR query');
+    }
+    const requestId = req.nextUrl.searchParams.get('requestId') || '';
+    const record = await readMiraFormalAsrJob(requestId);
+    if (!record) return apiError('INVALID_REQUEST', 404, 'Formal ASR job not found');
+    return apiSuccess(safeRecord(record), record.state === 'running' ? 202 : 200);
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
