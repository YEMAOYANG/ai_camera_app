+}
+
+function jobPath(kind: 'tts' | 'asr', requestId: string): string {
+  return path.join(jobsDir(kind), `${sha256(requestId)}.json`);
+}
+
+function assetsDir(): string {
+  return path.join(dataRoot(), 'assets');
+}
+
+async function writeExclusiveAtomic(filePath: string, value: unknown): Promise<boolean> {
+  await fs.mkdir(path.dirname(filePath), { recursive: true });
+  const tempPath = `${filePath}.${process.pid}.${Date.now()}.${Math.random()
+    .toString(16)
+    .slice(2)}.tmp`;
+  const handle = await fs.open(tempPath, 'wx', 0o600);
+  try {
+    await handle.writeFile(JSON.stringify(value, null, 2), 'utf8');
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  try {
+    await fs.link(tempPath, filePath);
+    return true;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'EEXIST') return false;
+    throw error;
+  } finally {
+    await fs.unlink(tempPath).catch(() => undefined);
+  }
+}
+
+async function writeAtomic(filePath: string, value: unknown): Promise<void> {
+  await fs.mkdir(path.dirname(filePath), { recursive: true });
+  const tempPath = `${filePath}.${process.pid}.${Date.now()}.${Math.random()
+    .toString(16)
+    .slice(2)}.tmp`;
+  const handle = await fs.open(tempPath, 'wx', 0o600);
+  try {
+    await handle.writeFile(JSON.stringify(value, null, 2), 'utf8');
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  await fs.rename(tempPath, filePath);
+}
+
+async function readJob<T>(kind: 'tts' | 'asr', requestId: string): Promise<T | null> {
+  if (!IDENTIFIER.test(requestId)) {
+    throw new MiraFormalAudioError('invalid_request', 'Invalid formal audio request id');
+  }
+  try {
+    return JSON.parse(await fs.readFile(jobPath(kind, requestId), 'utf8')) as T;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+}
+
+function isStale(record: BaseJobRecord, now: Date): boolean {
+  return (
+    record.state === 'running' &&
+    now.getTime() - new Date(record.providerAttemptedAt).getTime() > STALE_RUNNING_MS
+  );
+}
+
+async function observeJob<T extends BaseJobRecord>(
+  kind: 'tts' | 'asr',
+  record: T,
+  now: Date,
+): Promise<T> {
+  if (!isStale(record, now)) return record;
+  const observed = {
+    ...record,
+    state: 'ambiguous' as const,
+    safeErrorCode: 'stale_provider_outcome_unknown',
+    updatedAt: now.toISOString(),
+    completedAt: now.toISOString(),
+  };
+  await writeAtomic(jobPath(kind, record.requestId), observed);
+  return observed;
+}
+
+export async function readMiraFormalTtsJob(
+  requestId: string,
+  now = new Date(),
+): Promise<MiraFormalTtsJob | null> {
+  const record = await readJob<MiraFormalTtsJob>('tts', requestId);
+  return record ? observeJob('tts', record, now) : null;
+}
+
+export async function readMiraFormalAsrJob(
+  requestId: string,
+  now = new Date(),
+): Promise<MiraFormalAsrJob | null> {
+  const record = await readJob<MiraFormalAsrJob>('asr', requestId);
+  return record ? observeJob('asr', record, now) : null;
+}
+
+function identityOf(input: FormalAudioIdentity): FormalAudioIdentity {
+  return {
+    classroomId: input.classroomId,
+    classroomContentSha256: input.classroomContentSha256,
+    subject: input.subject,
+    teacherProfileId: input.teacherProfileId,
+    teacherProfileVersion: input.teacherProfileVersion,
+    teacherProfileSha256: input.teacherProfileSha256,
+    teacherGender: input.teacherGender,
+    sceneId: input.sceneId,
+    sceneOrder: input.sceneOrder,
+    actionId: input.actionId,
+    narrationSegmentId: input.narrationSegmentId,
+  };
+}
+
+async function claimTts(
+  input: MiraFormalTtsRequest,
+  now: Date,
+): Promise<{ record: MiraFormalTtsJob; created: boolean }> {
+  const digest = requestDigest(input);
+  const existing = await readMiraFormalTtsJob(input.requestId, now);
+  if (existing) {
+    if (existing.requestSha256 !== digest) {
+      throw new MiraFormalAudioError('request_conflict', 'Formal TTS request conflict');
+    }
+    return { record: existing, created: false };
+  }
+  const policy = SUBJECT_POLICIES[input.subject];
+  const timestamp = now.toISOString();
+  const record: MiraFormalTtsJob = {
+    schemaVersion: MIRA_FORMAL_AUDIO_JOB_VERSION,
+    kind: 'tts',
+    requestId: input.requestId,
+    requestSha256: digest,
+    ...identityOf(input),
+    textSha256: input.textSha256,
+    state: 'running',
+    providerId: 'qwen-tts',
+    modelId: 'qwen3-tts-flash',
+    voiceId: policy.voiceId,
+    voiceGender: policy.voiceGender,
+    languageCode: policy.languageCode,
+    fallbackUsed: false,
+    providerAttemptedAt: timestamp,
+    createdAt: timestamp,
+    updatedAt: timestamp,
+  };
+  if (await writeExclusiveAtomic(jobPath('tts', input.requestId), record)) {
+    return { record, created: true };
+  }
+  const winner = await readMiraFormalTtsJob(input.requestId, now);
+  if (!winner || winner.requestSha256 !== digest) {
+    throw new MiraFormalAudioError('request_conflict', 'Formal TTS request conflict');
+  }
+  return { record: winner, created: false };
+}
+
+function sameIdentity(left: FormalAudioIdentity, right: FormalAudioIdentity): boolean {
+  return requestDigest(identityOf(left)) === requestDigest(identityOf(right));
+}
+
+async function claimAsr(
+  input: MiraFormalAsrRequest,
+  tts: MiraFormalTtsJob,
+  now: Date,
+): Promise<{ record: MiraFormalAsrJob; created: boolean }> {
+  if (
+    tts.state !== 'succeeded' ||
+    tts.requestId !== input.ttsRequestId ||
+    tts.audioSha256 !== input.audioSha256 ||
+    !sameIdentity(tts, input)
+  ) {
+    throw new MiraFormalAudioError('asset_unavailable', 'Matching formal TTS WAV is unavailable');
+  }
+  const digest = requestDigest(input);
+  const existing = await readMiraFormalAsrJob(input.requestId, now);
+  if (existing) {
+    if (existing.requestSha256 !== digest) {
+      throw new MiraFormalAudioError('request_conflict', 'Formal ASR request conflict');
+    }
+    return { record: existing, created: false };
+  }
+  const policy = SUBJECT_POLICIES[input.subject];
+  const timestamp = now.toISOString();
+  const record: MiraFormalAsrJob = {
+    schemaVersion: MIRA_FORMAL_AUDIO_JOB_VERSION,
+    kind: 'asr',
+    requestId: input.requestId,
+    requestSha256: digest,
+    ...identityOf(input),
+    ttsRequestId: input.ttsRequestId,
+    audioSha256: input.audioSha256,
+    languageCode: policy.languageCode,
+    state: 'running',
+    providerId: 'qwen-asr',
+    modelId: 'qwen3-asr-flash',
+    fallbackUsed: false,
+    providerAttemptedAt: timestamp,
+    createdAt: timestamp,
+    updatedAt: timestamp,
+  };
+  if (await writeExclusiveAtomic(jobPath('asr', input.requestId), record)) {
+    return { record, created: true };
+  }
+  const winner = await readMiraFormalAsrJob(input.requestId, now);
+  if (!winner || winner.requestSha256 !== digest) {
+    throw new MiraFormalAudioError('request_conflict', 'Formal ASR request conflict');
+  }
+  return { record: winner, created: false };
+}
+
+function providerEndpoint(baseUrl: string | undefined): string {
+  const effectiveBaseUrl = baseUrl || 'https://dashscope.aliyuncs.com/api/v1';
+  let parsed: URL;
+  try {
+    parsed = new URL(effectiveBaseUrl);
+  } catch {
+    throw new MiraFormalAudioError('provider_unavailable', 'Formal audio provider is unavailable');
+  }
+  if (
+    parsed.protocol !== 'https:' ||
+    parsed.username ||
+    parsed.password ||
+    parsed.search ||
+    parsed.hash ||
+    (parsed.port && parsed.port !== '443')
+  ) {
+    throw new MiraFormalAudioError('provider_unavailable', 'Formal audio provider is unavailable');
+  }
+  return `${parsed.toString().replace(/\/$/u, '')}/services/aigc/multimodal-generation/generation`;
+}
+
+function timeoutSignal(): AbortSignal {
+  return AbortSignal.timeout(MIRA_FORMAL_AUDIO_PROVIDER_TIMEOUT_MS);
+}
+
+async function fetchProvider(
+  fetchImpl: typeof fetch,
+  url: string,
+  init: RequestInit,
+): Promise<Response> {
+  try {
+    return await fetchImpl(url, { ...init, signal: timeoutSignal() });
+  } catch {
+    throw new OperationalFailure('ambiguous', 'provider_outcome_unknown');
+  }
+}
+
+async function readBoundedBytes(response: Response, maximum: number): Promise<Uint8Array> {
+  const declared = response.headers.get('content-length');
+  if (declared !== null) {
+    const length = Number(declared);
+    if (!Number.isSafeInteger(length) || length < 0 || length > maximum) {
+      throw new OperationalFailure('failed', 'response_size_invalid');
+    }
+  }
+  if (!response.body) {
+    const bytes = new Uint8Array(await response.arrayBuffer());
+    if (bytes.byteLength > maximum) throw new OperationalFailure('failed', 'response_too_large');
+    return bytes;
+  }
+  const reader = response.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  while (true) {
+    let next: ReadableStreamReadResult<Uint8Array>;
+    try {
+      next = await reader.read();
+    } catch {
+      throw new OperationalFailure('ambiguous', 'response_stream_outcome_unknown');
+    }
+    if (next.done) break;
+    total += next.value.byteLength;
+    if (total > maximum) {
+      await reader.cancel().catch(() => undefined);
+      throw new OperationalFailure('failed', 'response_too_large');
+    }
+    chunks.push(next.value);
+  }
+  const combined = new Uint8Array(total);
+  let offset = 0;
+  for (const chunk of chunks) {
+    combined.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return combined;
+}
+
+async function readProviderJson(response: Response): Promise<Record<string, unknown>> {
+  const mimeType = response.headers.get('content-type')?.split(';', 1)[0].trim().toLowerCase();
+  if (mimeType !== 'application/json') {
+    throw new OperationalFailure('failed', 'provider_content_type_invalid');
+  }
+  const bytes = await readBoundedBytes(response, MAX_PROVIDER_JSON_BYTES);
+  try {
+    const value = JSON.parse(Buffer.from(bytes).toString('utf8'));
+    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('invalid');
+    return value as Record<string, unknown>;
+  } catch {
+    throw new OperationalFailure('failed', 'provider_response_invalid');
+  }
+}
+
+function isAllowedMediaHostname(hostname: string): boolean {
+  const normalized = hostname.toLowerCase().replace(/\.$/u, '');
+  return (
+    normalized === 'dashscope.aliyuncs.com' ||
+    /^[a-z0-9-]+\.oss(?:-[a-z0-9-]+)?\.aliyuncs\.com$/u.test(normalized)
+  );
+}
+
+function isPrivateAddress(address: string): boolean {
+  if (isIP(address) === 4) {
+    const parts = address.split('.').map(Number);
+    return (
+      parts[0] === 0 ||
+      parts[0] === 10 ||
+      parts[0] === 127 ||
+      (parts[0] === 169 && parts[1] === 254) ||
+      (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) ||
+      (parts[0] === 192 && parts[1] === 168) ||
+      parts[0] >= 224
+    );
+  }
+  if (isIP(address) === 6) {
+    const normalized = address.toLowerCase();
+    return (
+      normalized === '::' ||
+      normalized === '::1' ||
+      normalized.startsWith('fc') ||
+      normalized.startsWith('fd') ||
+      /^fe[89ab]/u.test(normalized) ||
+      normalized.startsWith('ff') ||
+      normalized.startsWith('::ffff:')
+    );
+  }
+  return true;
+}
+
+async function defaultResolveAddresses(hostname: string): Promise<string[]> {
+  return (await lookup(hostname, { all: true, verbatim: true })).map((item) => item.address);
+}
+
+async function validateMediaUrl(
+  rawUrl: string,
+  resolveAddresses: (hostname: string) => Promise<string[]>,
+): Promise<URL> {
+  let url: URL;
+  try {
+    url = new URL(rawUrl);
+  } catch {
+    throw new OperationalFailure('failed', 'media_url_invalid');
+  }
+  if (
+    url.protocol !== 'https:' ||
+    url.username ||
+    url.password ||
+    url.hash ||
+    (url.port && url.port !== '443') ||
+    !isAllowedMediaHostname(url.hostname)
+  ) {
+    throw new OperationalFailure('failed', 'media_url_rejected');
+  }
+  let addresses: string[];
+  try {
+    addresses = await resolveAddresses(url.hostname);
+  } catch {
+    throw new OperationalFailure('failed', 'media_host_unresolved');
+  }
+  if (!addresses.length || addresses.some(isPrivateAddress)) {
+    throw new OperationalFailure('failed', 'media_host_rejected');
+  }
+  return url;
+}
+
+async function downloadWav(
+  initialUrl: string,
+  fetchImpl: typeof fetch,
+  resolveAddresses: (hostname: string) => Promise<string[]>,
+): Promise<Uint8Array> {
+  const signal = timeoutSignal();
+  let current = await validateMediaUrl(initialUrl, resolveAddresses);
+  for (let redirectCount = 0; redirectCount <= 2; redirectCount += 1) {
+    let response: Response;
+    try {
+      response = await fetchImpl(current, { method: 'GET', redirect: 'manual', signal });
+    } catch {
+      throw new OperationalFailure('ambiguous', 'media_download_outcome_unknown');
+    }
+    if (REDIRECT_STATUSES.has(response.status)) {
+      const location = response.headers.get('location');
+      if (!location || redirectCount === 2) {
+        throw new OperationalFailure('failed', 'media_redirect_rejected');
+      }
+      current = await validateMediaUrl(new URL(location, current).toString(), resolveAddresses);
+      continue;
+    }
+    if (!response.ok) throw new OperationalFailure('failed', 'media_download_failed');
+    if (response.headers.get('content-type')?.trim().toLowerCase() !== 'audio/wav') {
+      throw new OperationalFailure('failed', 'media_mime_invalid');
+    }
+    const bytes = await readBoundedBytes(response, MIRA_FORMAL_AUDIO_MAX_BYTES);
+    if (
+      bytes.byteLength < 44 ||
+      Buffer.from(bytes.subarray(0, 4)).toString('ascii') !== 'RIFF' ||
+      Buffer.from(bytes.subarray(8, 12)).toString('ascii') !== 'WAVE'
+    ) {
+      throw new OperationalFailure('failed', 'media_wav_invalid');
+    }
+    return bytes;
+  }
+  throw new OperationalFailure('failed', 'media_redirect_rejected');
+}
+
+async function writeAssetExclusive(assetId: string, bytes: Uint8Array): Promise<string> {
+  const fileName = `${assetId}.wav`;
+  const filePath = path.join(assetsDir(), fileName);
+  await fs.mkdir(path.dirname(filePath), { recursive: true });
+  const tempPath = `${filePath}.${process.pid}.${Date.now()}.tmp`;
+  const handle = await fs.open(tempPath, 'wx', 0o600);
+  try {
+    await handle.writeFile(bytes);
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  try {
+    await fs.link(tempPath, filePath);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'EEXIST') {
+      throw new OperationalFailure('ambiguous', 'local_asset_already_exists');
+    }
+    throw new OperationalFailure('failed', 'local_asset_write_failed');
+  } finally {
+    await fs.unlink(tempPath).catch(() => undefined);
+  }
+  return fileName;
+}
+
+async function updateTts(record: MiraFormalTtsJob): Promise<void> {
+  await writeAtomic(jobPath('tts', record.requestId), record);
+}
+
+async function updateAsr(record: MiraFormalAsrJob): Promise<void> {
+  await writeAtomic(jobPath('asr', record.requestId), record);
+}
+
+async function terminalizeTts(
+  record: MiraFormalTtsJob,
+  failure: OperationalFailure | MiraFormalAudioError,
+  now: Date,
+): Promise<MiraFormalTtsJob> {
+  const terminal: MiraFormalTtsJob = {
+    ...record,
+    state: failure instanceof OperationalFailure ? failure.outcome : 'failed',
+    safeErrorCode: failure instanceof OperationalFailure ? failure.safeCode : failure.code,
+    updatedAt: now.toISOString(),
+    completedAt: now.toISOString(),
+  };
+  await updateTts(terminal);
+  return terminal;
+}
