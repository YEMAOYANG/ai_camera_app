+async function terminalizeAsr(
+  record: MiraFormalAsrJob,
+  failure: OperationalFailure | MiraFormalAudioError,
+  now: Date,
+): Promise<MiraFormalAsrJob> {
+  const terminal: MiraFormalAsrJob = {
+    ...record,
+    state: failure instanceof OperationalFailure ? failure.outcome : 'failed',
+    safeErrorCode: failure instanceof OperationalFailure ? failure.safeCode : failure.code,
+    updatedAt: now.toISOString(),
+    completedAt: now.toISOString(),
+  };
+  await updateAsr(terminal);
+  return terminal;
+}
+
+export async function executeMiraFormalTts(
+  value: unknown,
+  dependencies: RuntimeDependencies = {},
+): Promise<{ record: MiraFormalTtsJob; created: boolean }> {
+  const input = assertMiraFormalTtsRequest(value);
+  const now = dependencies.now?.() || new Date();
+  const claim = await claimTts(input, now);
+  if (!claim.created) return claim;
+  let record = claim.record;
+  const fetchImpl = dependencies.fetchImpl || fetch;
+  const resolveAddresses = dependencies.resolveAddresses || defaultResolveAddresses;
+  try {
+    const apiKey = resolveTTSApiKey('qwen-tts');
+    if (!apiKey)
+      throw new MiraFormalAudioError('provider_unavailable', 'Formal TTS is unavailable');
+    const endpoint = providerEndpoint(resolveTTSBaseUrl('qwen-tts'));
+    const policy = SUBJECT_POLICIES[input.subject];
+    const response = await fetchProvider(fetchImpl, endpoint, {
+      method: 'POST',
+      headers: {
+        Authorization: `Bearer ${apiKey}`,
+        'Content-Type': 'application/json; charset=utf-8',
+      },
+      body: JSON.stringify({
+        model: 'qwen3-tts-flash',
+        input: {
+          text: input.text,
+          voice: policy.voiceId,
+          language_type: policy.qwenLanguageType,
+        },
+        parameters: { rate: 0 },
+      }),
+    });
+    if (!response.ok) throw new OperationalFailure('failed', 'provider_rejected');
+    const providerBody = await readProviderJson(response);
+    const output = providerBody.output as Record<string, unknown> | undefined;
+    const audio = output?.audio as Record<string, unknown> | undefined;
+    if (!audio || typeof audio.url !== 'string') {
+      throw new OperationalFailure('failed', 'provider_response_invalid');
+    }
+    const providerCompletedAt = (dependencies.now?.() || new Date()).toISOString();
+    record = {
+      ...record,
+      providerCompletedAt,
+      downloadAttemptedAt: providerCompletedAt,
+      updatedAt: providerCompletedAt,
+    };
+    await updateTts(record);
+    const bytes = await downloadWav(audio.url, fetchImpl, resolveAddresses);
+    const audioSha256 = sha256(bytes);
+    const assetId = `mirawav_${sha256(input.requestId).slice(0, 24)}`;
+    const assetFileName = await writeAssetExclusive(assetId, bytes);
+    const readback = new Uint8Array(await fs.readFile(path.join(assetsDir(), assetFileName)));
+    if (readback.byteLength !== bytes.byteLength || sha256(readback) !== audioSha256) {
+      throw new OperationalFailure('failed', 'local_asset_readback_mismatch');
+    }
+    const completedAt = (dependencies.now?.() || new Date()).toISOString();
+    record = {
+      ...record,
+      state: 'succeeded',
+      assetId,
+      assetFileName,
+      mimeType: 'audio/wav',
+      sizeBytes: bytes.byteLength,
+      audioSha256,
+      updatedAt: completedAt,
+      completedAt,
+    };
+    await updateTts(record);
+    return { record, created: true };
+  } catch (error) {
+    const failure =
+      error instanceof OperationalFailure || error instanceof MiraFormalAudioError
+        ? error
+        : new OperationalFailure('failed', 'formal_tts_internal_failure');
+    return {
+      record: await terminalizeTts(record, failure, dependencies.now?.() || new Date()),
+      created: true,
+    };
+  }
+}
+
+export async function readMiraFormalTtsAsset(
+  requestId: string,
+): Promise<{ record: MiraFormalTtsJob; bytes: Uint8Array }> {
+  const record = await readMiraFormalTtsJob(requestId);
+  if (
+    !record ||
+    record.state !== 'succeeded' ||
+    !record.assetFileName ||
+    !record.audioSha256 ||
+    !record.sizeBytes
+  ) {
+    throw new MiraFormalAudioError('asset_unavailable', 'Formal TTS WAV is unavailable');
+  }
+  let bytes: Uint8Array;
+  try {
+    bytes = new Uint8Array(await fs.readFile(path.join(assetsDir(), record.assetFileName)));
+  } catch {
+    throw new MiraFormalAudioError('asset_unavailable', 'Formal TTS WAV is unavailable');
+  }
+  if (
+    bytes.byteLength !== record.sizeBytes ||
+    bytes.byteLength > MIRA_FORMAL_AUDIO_MAX_BYTES ||
+    sha256(bytes) !== record.audioSha256
+  ) {
+    throw new MiraFormalAudioError('asset_unavailable', 'Formal TTS WAV is unavailable');
+  }
+  return { record, bytes };
+}
+
+export async function executeMiraFormalAsr(
+  value: unknown,
+  dependencies: RuntimeDependencies = {},
+): Promise<{ record: MiraFormalAsrJob; created: boolean; transcript?: string }> {
+  const input = assertMiraFormalAsrRequest(value);
+  const tts = await readMiraFormalTtsJob(input.ttsRequestId);
+  if (!tts)
+    throw new MiraFormalAudioError('asset_unavailable', 'Matching formal TTS WAV is unavailable');
+  const now = dependencies.now?.() || new Date();
+  const claim = await claimAsr(input, tts, now);
+  if (!claim.created) return claim;
+  let record = claim.record;
+  const fetchImpl = dependencies.fetchImpl || fetch;
+  try {
+    const { bytes } = await readMiraFormalTtsAsset(input.ttsRequestId);
+    const apiKey = resolveASRApiKey('qwen-asr');
+    if (!apiKey)
+      throw new MiraFormalAudioError('provider_unavailable', 'Formal ASR is unavailable');
+    const endpoint = providerEndpoint(resolveASRBaseUrl('qwen-asr'));
+    const policy = SUBJECT_POLICIES[input.subject];
+    const response = await fetchProvider(fetchImpl, endpoint, {
+      method: 'POST',
+      headers: {
+        Authorization: `Bearer ${apiKey}`,
+        'Content-Type': 'application/json; charset=utf-8',
+        'X-DashScope-Audio-Format': 'wav',
+      },
+      body: JSON.stringify({
+        model: 'qwen3-asr-flash',
+        input: {
+          messages: [
+            {
+              role: 'user',
+              content: [
+                { audio: `data:audio/wav;base64,${Buffer.from(bytes).toString('base64')}` },
+              ],
+            },
+          ],
+        },
+        parameters: {
+          asr_options: { language: policy.languageCode === 'en-US' ? 'en' : 'zh' },
+        },
+      }),
+    });
+    if (!response.ok) throw new OperationalFailure('failed', 'provider_rejected');
+    const providerBody = await readProviderJson(response);
+    const output = providerBody.output as Record<string, unknown> | undefined;
+    const choices = output?.choices;
+    const first = Array.isArray(choices) ? choices[0] : undefined;
+    const message =
+      first && typeof first === 'object' ? (first as Record<string, unknown>).message : undefined;
+    const content =
+      message && typeof message === 'object'
+        ? (message as Record<string, unknown>).content
+        : undefined;
+    const item = Array.isArray(content) ? content[0] : undefined;
+    const transcript =
+      item && typeof item === 'object' ? (item as Record<string, unknown>).text : undefined;
+    if (typeof transcript !== 'string' || transcript.length > 64_000) {
+      throw new OperationalFailure('failed', 'provider_response_invalid');
+    }
+    const completedAt = (dependencies.now?.() || new Date()).toISOString();
+    record = {
+      ...record,
+      state: 'succeeded',
+      providerCompletedAt: completedAt,
+      transcriptSha256: sha256(transcript),
+      updatedAt: completedAt,
+      completedAt,
+    };
+    await updateAsr(record);
+    return { record, created: true, transcript };
+  } catch (error) {
+    const failure =
+      error instanceof OperationalFailure || error instanceof MiraFormalAudioError
+        ? error
+        : new OperationalFailure('failed', 'formal_asr_internal_failure');
+    return {
+      record: await terminalizeAsr(record, failure, dependencies.now?.() || new Date()),
+      created: true,
+    };
+  }
+}
+
+export function getMiraFormalAudioRuntimePolicy() {
+  return MIRA_FORMAL_AUDIO_POLICY;
+}
+
+export function assertMiraFormalAudioProviderReady(): void {
+  const tts = getServerTTSProviders()['qwen-tts'];
+  const asr = getServerASRProviders()['qwen-asr'];
+  if (tts?.disabled !== false && tts?.disabled !== undefined) {
+    throw new Error('Formal Qwen TTS provider is not ready.');
+  }
+  if (!tts || !asr || !resolveTTSApiKey('qwen-tts') || !resolveASRApiKey('qwen-asr')) {
+    throw new Error('Formal Qwen audio providers are not ready.');
+  }
+  providerEndpoint(resolveTTSBaseUrl('qwen-tts'));
+  providerEndpoint(resolveASRBaseUrl('qwen-asr'));
+}
+
+function secureEqual(left: string, right: string): boolean {
+  const leftDigest = createHash('sha256').update(left).digest();
+  const rightDigest = createHash('sha256').update(right).digest();
+  return timingSafeEqual(leftDigest, rightDigest);
+}
+
+const LOOPBACK_HOSTNAMES = new Set(['localhost', '127.0.0.1', '::1']);
+
+function normalizedLoopbackHostname(value: string): string | null {
+  const hostname = value.replace(/^\[|\]$/gu, '').toLowerCase();
+  return LOOPBACK_HOSTNAMES.has(hostname) ? 'loopback' : null;
+}
+
+function singleHeader(req: NextRequest, name: string): string | null {
+  const value = req.headers.get(name);
+  if (
+    value === null ||
+    value.length === 0 ||
+    value !== value.trim() ||
+    value.includes(',') ||
+    /[%\s]/u.test(value)
+  ) {
+    return null;
+  }
+  return value;
+}
+
+function isExactLoopbackAuthority(value: string | null, expectedPort: string): boolean {
+  if (!value) return false;
+  try {
+    const parsed = new URL(`http://${value}`);
+    return Boolean(
+      !parsed.username &&
+      !parsed.password &&
+      parsed.pathname === '/' &&
+      !parsed.search &&
+      !parsed.hash &&
+      parsed.port === expectedPort &&
+      normalizedLoopbackHostname(parsed.hostname),
+    );
+  } catch {
+    return false;
+  }
+}
+
+export function authorizeMiraFormalAudioRequest(req: NextRequest): void {
+  const expectedPort = process.env.MIRA_OPENMAIC_PRIVATE_PORT || '3100';
+  if (
+    req.headers.has('forwarded') ||
+    req.headers.has('x-real-ip') ||
+    req.headers.has('via') ||
+    req.nextUrl.protocol !== 'http:' ||
+    req.nextUrl.port !== expectedPort ||
+    !normalizedLoopbackHostname(req.nextUrl.hostname) ||
+    !isExactLoopbackAuthority(singleHeader(req, 'host'), expectedPort) ||
+    !isExactLoopbackAuthority(singleHeader(req, 'x-forwarded-host'), expectedPort) ||
+    !normalizedLoopbackHostname(singleHeader(req, 'x-forwarded-for') || '') ||
+    singleHeader(req, 'x-forwarded-proto') !== 'http' ||
+    singleHeader(req, 'x-forwarded-port') !== expectedPort
+  ) {
+    throw new MiraFormalAudioError('unauthorized', 'Formal audio requires direct loopback access');
+  }
+  const expectedToken = process.env.MIRA_INTERNAL_API_TOKEN || '';
+  const suppliedToken = req.headers.get('x-mira-internal-token') || '';
+  if (!expectedToken || !suppliedToken || !secureEqual(expectedToken, suppliedToken)) {
+    throw new MiraFormalAudioError('unauthorized', 'Invalid formal audio credentials');
+  }
+}
