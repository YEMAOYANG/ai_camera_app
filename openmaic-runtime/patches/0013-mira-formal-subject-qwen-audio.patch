+const STALE_RUNNING_MS = 5 * 60 * 1000;
+const MAX_PROVIDER_JSON_BYTES = 1024 * 1024;
+const REDIRECT_STATUSES = new Set([301, 302, 303, 307, 308]);
+
+function sha256(value: string | Uint8Array): string {
+  return createHash('sha256').update(value).digest('hex');
+}
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(
+      Object.entries(value as Record<string, unknown>)
+        .sort(([left], [right]) => left.localeCompare(right))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  }
+  return value;
+}
+
+function requestDigest(value: object): string {
+  return sha256(JSON.stringify(canonical(value)));
+}
+
+function assertExactObject(value: unknown, keys: readonly string[]): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new MiraFormalAudioError('invalid_request', 'Invalid formal audio request');
+  }
+  if (Object.keys(value).sort().join(',') !== [...keys].sort().join(',')) {
+    throw new MiraFormalAudioError('invalid_request', 'Invalid formal audio request');
+  }
+  return value as Record<string, unknown>;
+}
+
+function assertIdentity(
+  input: Record<string, unknown>,
+): asserts input is Record<keyof FormalAudioIdentity, unknown> {
+  if (
+    !IDENTIFIER.test(String(input.classroomId || '')) ||
+    !SHA256.test(String(input.classroomContentSha256 || '')) ||
+    !IDENTIFIER.test(String(input.sceneId || '')) ||
+    !Number.isInteger(input.sceneOrder) ||
+    Number(input.sceneOrder) < 0 ||
+    Number(input.sceneOrder) > 9 ||
+    !IDENTIFIER.test(String(input.actionId || '')) ||
+    !IDENTIFIER.test(String(input.narrationSegmentId || ''))
+  ) {
+    throw new MiraFormalAudioError('invalid_request', 'Invalid formal audio identity');
+  }
+  const subject = input.subject as Subject;
+  const policy = SUBJECT_POLICIES[subject];
+  if (
+    !policy ||
+    input.teacherProfileId !== policy.teacherProfileId ||
+    input.teacherProfileVersion !== policy.teacherProfileVersion ||
+    input.teacherProfileSha256 !== policy.teacherProfileSha256 ||
+    input.teacherGender !== policy.teacherGender
+  ) {
