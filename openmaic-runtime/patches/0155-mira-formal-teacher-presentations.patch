diff --git a/tests/chat/chat-teacher-presentation.test.ts b/tests/chat/chat-teacher-presentation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..361e94cd3690f2354c10273ac5b496ee08a269db
--- /dev/null
+++ b/tests/chat/chat-teacher-presentation.test.ts
@@ -0,0 +1,111 @@
+// @vitest-environment jsdom
+import { act, createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { expect, it, vi } from 'vitest';
+import { ChatSessionComponent } from '@/components/chat/chat-session';
+import type { ChatSession } from '@/lib/types/chat';
+import type { Stage } from '@/lib/types/stage';
+import { useStageStore } from '@/lib/store/stage';
+import { applyGeneratedAgentsToRegistry } from '@/lib/orchestration/registry/store';
+import presentations from '@/lib/mira/teacher-presentations.v1.json';
+
+vi.mock('@/lib/audio/agent-voice', () => ({ warmUpAgentVoices: vi.fn() }));
+vi.mock('@/lib/hooks/use-i18n', () => ({ useI18n: () => ({ t: (key: string) => key }) }));
+vi.mock('motion/react', () => ({
+  AnimatePresence: ({ children }: { children: unknown }) => children,
+  motion: {
+    div: (props: Record<string, unknown>) =>
+      createElement(
+        'div',
+        Object.fromEntries(
+          Object.entries(props).filter(
+            ([key]) => !['initial', 'animate', 'exit', 'transition'].includes(key),
+          ),
+        ),
+      ),
+  },
+}));
+
+it('renders the exact current teacher for saved chat and preserves saved messages across a classroom switch', async () => {
+  (
+    globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean }
+  ).IS_REACT_ACT_ENVIRONMENT = true;
+  const previous = useStageStore.getState().stage;
+  const science = presentations.items[3];
+  const agent = {
+    id: 'science-teacher',
+    role: 'teacher',
+    name: '小科老师',
+    persona: 'Observe',
+    color: '#42685d',
+    priority: 10,
+    avatar: '/avatars/teacher-2.png',
+    teacherProfile: science.teacherProfile,
+  };
+  const session: ChatSession = {
+    id: 'science-chat',
+    type: 'qa',
+    title: 'Science',
+    status: 'completed',
+    messages: [
+      {
+        id: 'saved-science-message',
+        role: 'assistant',
+        parts: [{ type: 'text', text: '看看叶子。' }],
+        metadata: {
+          originalRole: 'teacher',
+          agentId: agent.id,
+          senderName: '小科老师',
+          senderAvatar: '/avatars/teacher-2.png',
+        },
+      },
+    ],
+    config: { agentIds: [agent.id] },
+    toolCalls: [],
+    pendingToolCalls: [],
+    createdAt: 1,
+    updatedAt: 1,
+  };
+  const original = JSON.stringify(session);
+  const host = document.createElement('div');
+  document.body.append(host);
+  const root = createRoot(host);
+  const savedScroll = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'scrollIntoView');
+  Object.defineProperty(HTMLElement.prototype, 'scrollIntoView', {
+    value: vi.fn(),
+    configurable: true,
+  });
+  vi.stubGlobal(
+    'requestAnimationFrame',
+    vi.fn(() => 1),
+  );
+  vi.stubGlobal('cancelAnimationFrame', vi.fn());
+  try {
+    await act(async () => {
+      useStageStore.setState({ stage: { id: 'science-stage' } as Stage });
+      applyGeneratedAgentsToRegistry('science-stage', [agent]);
+      root.render(createElement(ChatSessionComponent, { session, isActive: false }));
+    });
+    expect(host.querySelector('[data-mira-chat-avatar] img')?.getAttribute('src')).toBe(
+      science.avatarPath,
+    );
+    expect(JSON.stringify(session)).toBe(original);
+    await act(async () => {
+      useStageStore.setState({ stage: { id: 'different-stage' } as Stage });
+    });
+    expect(host.querySelector('[data-mira-chat-avatar] img')?.getAttribute('src')).toBe(
+      '/avatars/teacher-2.png',
+    );
+    expect(JSON.stringify(session)).toBe(original);
+  } finally {
+    act(() => {
+      root.unmount();
+      applyGeneratedAgentsToRegistry('reset', []);
+      useStageStore.setState({ stage: previous });
+    });
+    host.remove();
+    if (savedScroll) Object.defineProperty(HTMLElement.prototype, 'scrollIntoView', savedScroll);
+    else delete (HTMLElement.prototype as { scrollIntoView?: unknown }).scrollIntoView;
+    vi.unstubAllGlobals();
+  }
+});
