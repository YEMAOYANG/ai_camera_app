diff --git a/lib/mira/teacher-presentation.ts b/lib/mira/teacher-presentation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..028df71c355276b587a2897215f86c5f5f04cbbd
--- /dev/null
+++ b/lib/mira/teacher-presentation.ts
@@ -0,0 +1,42 @@
+import registry from './teacher-presentations.v1.json';
+
+type AvatarIdentity = { role: string; avatar: string; teacherProfile?: unknown };
+type LoadedAgent = AvatarIdentity & { id: string; isGenerated?: boolean; boundStageId?: string };
+
+function presentationAvatar(agent: AvatarIdentity): string | undefined {
+  const profile = agent.teacherProfile;
+  if (
+    agent.role !== 'teacher' ||
+    !profile ||
+    typeof profile !== 'object' ||
+    Array.isArray(profile)
+  ) {
+    return undefined;
+  }
+  const key = profile as Record<string, unknown>;
+  return registry.items.find(
+    ({ teacherProfile }) =>
+      key.id === teacherProfile.id &&
+      key.version === teacherProfile.version &&
+      key.contentHash === teacherProfile.contentHash,
+  )?.avatarPath;
+}
+
+/** Resolve a copied in-memory roster only. Never rewrite the paid stage document. */
+export function normalizeMiraTeacherPresentation<T extends AvatarIdentity>(agent: T): T {
+  const avatar = presentationAvatar(agent);
+  return avatar && avatar !== agent.avatar ? { ...agent, avatar } : agent;
+}
+
+/** Old messages keep their stored bytes; exact loaded profile identity supplies its portrait. */
+export function miraTeacherMessageAvatar(
+  fallback: string,
+  agentId: string | undefined,
+  stageId: string | undefined,
+  agents: Readonly<Record<string, LoadedAgent>>,
+): string {
+  if (!agentId || !stageId) return fallback;
+  const agent = agents[agentId];
+  if (!agent?.isGenerated || agent.boundStageId !== stageId) return fallback;
+  return presentationAvatar(agent) || fallback;
+}
