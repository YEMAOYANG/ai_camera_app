+import { createHash } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import registry from '@/lib/mira/teacher-presentations.v1.json';
+import {
+  miraTeacherMessageAvatar,
+  normalizeMiraTeacherPresentation,
+} from '@/lib/mira/teacher-presentation';
+
+describe('immutable formal teacher presentation', () => {
+  it('ships four pinned, distinct portrait files without changing teacher or voice identity', () => {
+    expect(registry.items).toHaveLength(4);
+    expect(new Set(registry.items.map((p) => p.avatarPath)).size).toBe(4);
+    for (const item of registry.items) {
+      const bytes = readFileSync(resolve('public', item.avatarPath.slice(1)));
+      expect(createHash('sha256').update(bytes).digest('hex')).toBe(item.assetSha256);
+      const input = Object.freeze({
+        id: 'task-bound-teacher',
+        role: 'teacher',
+        name: 'Name is irrelevant',
+        avatar: '/avatars/teacher-2.png',
+        teacherProfile: Object.freeze({ ...item.teacherProfile }),
+        voiceConfig: Object.freeze({
+          providerId: 'qwen-tts',
+          modelId: 'qwen3-tts-flash',
+          voiceId: 'unchanged',
+        }),
+      });
+      const before = JSON.stringify(input);
+      const display = normalizeMiraTeacherPresentation(input);
+      expect(display.avatar).toBe(item.avatarPath);
+      expect(display.teacherProfile).toBe(input.teacherProfile);
+      expect(display.voiceConfig).toBe(input.voiceConfig);
+      expect(JSON.stringify(input)).toBe(before);
+    }
+  });
+
+  it('does not infer from a display name, agent ID, wrong role, changed hash, or old version', () => {
+    const key = registry.items[3].teacherProfile;
+    const base = {
+      id: 'mira_science_inquiry',
+      name: '小科老师',
+      role: 'teacher',
+      avatar: '/original.png',
+    };
+    for (const input of [
+      base,
+      { ...base, teacherProfile: null },
+      { ...base, teacherProfile: [] },
+      { ...base, role: 'assistant', teacherProfile: key },
+      { ...base, teacherProfile: { ...key, contentHash: '0'.repeat(64) } },
+      { ...base, teacherProfile: { ...key, version: 2 } },
+      { ...base, teacherProfile: { ...key, id: 'unknown' } },
+    ]) {
+      expect(normalizeMiraTeacherPresentation(input)).toBe(input);
+    }
+  });
+
+  it('displays old chat portraits only through the current exact loaded agent, without rewriting messages', () => {
+    const item = registry.items[3];
+    const agent = {
+      id: 'teacher',
+      role: 'teacher',
+      avatar: '/avatars/teacher-2.png',
+      teacherProfile: item.teacherProfile,
+      isGenerated: true,
+      boundStageId: 'stage',
+    };
+    const message = Object.freeze({ senderAvatar: '/saved.png', agentId: 'teacher' });
+    expect(
+      miraTeacherMessageAvatar(message.senderAvatar, message.agentId, 'stage', { teacher: agent }),
+    ).toBe(item.avatarPath);
+    expect(message.senderAvatar).toBe('/saved.png');
+    for (const [id, stage, entries] of [
+      ['other', 'stage', { teacher: agent }],
+      ['teacher', 'other-stage', { teacher: agent }],
+      ['teacher', 'stage', { teacher: { ...agent, isGenerated: false } }],
+      [
+        'teacher',
+        'stage',
+        { teacher: { ...agent, teacherProfile: { ...item.teacherProfile, contentHash: 'wrong' } } },
+      ],
+    ] as const) {
+      expect(miraTeacherMessageAvatar('/saved.png', id, stage, entries)).toBe('/saved.png');
+    }
+  });
+});
