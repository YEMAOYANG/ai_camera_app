new file mode 100644
index 0000000..75f39d1
--- /dev/null
+++ b/lib/server/classroom-media-object-store.ts
@@ -0,0 +1,275 @@
+import { promises as fs } from 'node:fs';
+import { createHash } from 'node:crypto';
+import path from 'node:path';
+import { GetObjectCommand, HeadObjectCommand, S3Client } from '@aws-sdk/client-s3';
+import type { ClassroomMediaRange } from './classroom-media-range';
+
+const NATIVE_MEDIA_ROOT = 'openmaic-runtime/.runtime/OpenMAIC/data/classrooms/';
+const MAX_MANIFEST_BYTES = 64 * 1024 * 1024;
+const REQUEST_TIMEOUT_MS = 30_000;
+
+interface StorageConfig {
+  mode: 'manifest' | 'remote';
+  endpoint: string;
+  bucket: string;
+  prefix: string;
+  region: string;
+  accessKeyId: string;
+  secretAccessKey: string;
+  manifestPath: string;
+}
+
+interface ManifestFile {
+  path: string;
+  objectKey: string;
+  sha256: string;
+  byteSize: number;
+  mimeType: string;
+}
+
+/** Only non-sensitive public failure classes cross the media HTTP boundary. */
+export class ClassroomMediaStorageError extends Error {
+  constructor(public readonly status: 404 | 502) {
+    super(status === 404 ? 'Not found' : 'Media storage unavailable');
+    this.name = 'ClassroomMediaStorageError';
+  }
+}
+
+function unavailable(): never {
+  throw new ClassroomMediaStorageError(502);
+}
+
+function storageConfig(): StorageConfig | undefined {
+  const mode = process.env.COURSE_STORAGE_MODE?.trim() || 'local';
+  if (mode === 'local') return undefined;
+  if (mode !== 'manifest' && mode !== 'remote') return unavailable();
+  const required = (key: string): string => process.env[key]?.trim() || unavailable();
+  const endpoint = required('COURSE_STORAGE_ENDPOINT');
+  try {
+    const url = new URL(endpoint);
+    if (
+      !['http:', 'https:'].includes(url.protocol) ||
+      url.username ||
+      url.password ||
+      url.pathname !== '/' ||
+      url.search ||
+      url.hash
+    )
+      return unavailable();
+  } catch {
+    return unavailable();
+  }
+  const bucket = required('COURSE_STORAGE_BUCKET');
+  const prefix = required('COURSE_STORAGE_PREFIX');
+  const region = required('COURSE_STORAGE_REGION');
+  const manifestPath = required('COURSE_STORAGE_MANIFEST_PATH');
+  if (
+    !/^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$/.test(bucket) ||
+    bucket.includes('..') ||
+    !/^[A-Za-z0-9_-]+(?:\/[A-Za-z0-9_-]+)*$/.test(prefix) ||
+    !/^[A-Za-z0-9_-]+$/.test(region) ||
+    !path.isAbsolute(manifestPath)
+  )
+    return unavailable();
+  return {
+    mode,
+    endpoint,
+    bucket,
+    prefix,
+    region,
+    manifestPath,
+    accessKeyId: required('COURSE_STORAGE_ACCESS_KEY'),
+    secretAccessKey: required('COURSE_STORAGE_SECRET_KEY'),
+  };
+}
+
+let manifestCache: { identity: string; files: Map<string, ManifestFile> } | undefined;
+
+async function manifestFiles(config: StorageConfig): Promise<Map<string, ManifestFile>> {
+  const stat = await fs.stat(config.manifestPath);
+  if (!stat.isFile() || stat.size > MAX_MANIFEST_BYTES) return unavailable();
+  // Atomic manifest replacement is visible without a restart; no failed read is cached.
+  const identity = [
+    config.manifestPath,
+    config.prefix,
+    stat.dev,
+    stat.ino,
+    stat.size,
+    stat.mtimeMs,
+    stat.ctimeMs,
+  ].join(':');
+  if (manifestCache?.identity === identity) return manifestCache.files;
+  const manifest = JSON.parse(await fs.readFile(config.manifestPath, 'utf8'));
+  if (
+    manifest?.schemaVersion !== 'mira.course-storage.manifest.v1' ||
+    typeof manifest.snapshotId !== 'string' ||
+    !manifest.snapshotId.trim() ||
+    !Array.isArray(manifest.files)
+  )
+    return unavailable();
+  const files = new Map<string, ManifestFile>();
+  for (const item of manifest.files) {
+    if (
+      !item ||
+      typeof item.path !== 'string' ||
+      !item.path ||
+      item.path.includes('\\') ||
+      /[\u0000-\u001f]/.test(item.path) ||
+      item.path
+        .split('/')
+        .some((segment: string) => !segment || segment === '.' || segment === '..') ||
+      typeof item.sha256 !== 'string' ||
+      !/^[a-f0-9]{64}$/.test(item.sha256) ||
+      item.objectKey !== `${config.prefix}/blobs/sha256/${item.sha256}` ||
+      !Number.isSafeInteger(item.byteSize) ||
+      item.byteSize < 0 ||
+      typeof item.mimeType !== 'string' ||
+      !/^[a-z0-9.+-]+\/[a-z0-9.+-]+$/.test(item.mimeType) ||
+      files.has(item.path)
+    )
+      return unavailable();
+    files.set(item.path, item);
+  }
+  manifestCache = { identity, files };
+  return files;
+}
+
+let clientCache: { identity: string; client: S3Client } | undefined;
+
+function storageClient(config: StorageConfig): S3Client {
+  const identity = JSON.stringify([
+    config.endpoint,
+    config.region,
+    config.accessKeyId,
+    config.secretAccessKey,
+  ]);
+  if (clientCache?.identity !== identity) {
+    clientCache?.client.destroy();
+    clientCache = {
+      identity,
+      client: new S3Client({
+        endpoint: config.endpoint,
+        region: config.region,
+        forcePathStyle: true,
+        credentials: { accessKeyId: config.accessKeyId, secretAccessKey: config.secretAccessKey },
+        maxAttempts: 2,
+        requestChecksumCalculation: 'WHEN_REQUIRED',
+        responseChecksumValidation: 'WHEN_REQUIRED',
+      }),
+    };
+  }
+  return clientCache.client;
+}
+
+function mappedError(error: unknown): ClassroomMediaStorageError {
+  if (error instanceof ClassroomMediaStorageError) return error;
+  const remote = error as { name?: string; $metadata?: { httpStatusCode?: number } };
+  return new ClassroomMediaStorageError(
+    remote?.name === 'NoSuchKey' ||
+      remote?.name === 'NotFound' ||
+      remote?.$metadata?.httpStatusCode === 404
+      ? 404
+      : 502,
+  );
+}
+
+export interface RemoteClassroomMedia {
+  byteSize: number;
+  mimeType: string;
+  open: (
+    range: Exclude<ClassroomMediaRange, { kind: 'unsatisfiable' }>,
+  ) => Promise<ReadableStream<Uint8Array>>;
+}
+
+/**
+ * An exact private-manifest match opts this URL into remote delivery. A remote
+ * failure NEVER falls back to disk. Strict remote mode also rejects unlisted
+ * files, allowing acceptance after the local copy has been removed.
+ * The browser still receives only its original authenticated relative URL.
+ */
+export async function remoteClassroomMedia(
+  classroomId: string,
+  segments: string[],
+): Promise<RemoteClassroomMedia | undefined> {
+  try {
+    const config = storageConfig();
+    if (!config) return undefined;
+    // Recovered private classrooms remain exclusively under artifact/.
+    const relative = classroomId.startsWith('omclass_') ? ['artifact', ...segments] : segments;
+    const entry = (await manifestFiles(config)).get(
+      `${NATIVE_MEDIA_ROOT}${classroomId}/${relative.join('/')}`,
+    );
+    if (!entry) {
+      if (config.mode === 'remote') throw new ClassroomMediaStorageError(404);
+      return undefined;
+    }
+    const client = storageClient(config);
+    const input = { Bucket: config.bucket, Key: entry.objectKey };
+    const head = await client.send(new HeadObjectCommand(input), {
+      abortSignal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+    });
+    if (
+      head.ContentLength !== entry.byteSize ||
+      !['application/octet-stream', entry.mimeType].includes(head.ContentType ?? '') ||
+      (head.Metadata?.sha256 && head.Metadata.sha256 !== entry.sha256)
+    )
+      return unavailable();
+    return {
+      byteSize: entry.byteSize,
+      mimeType: entry.mimeType,
+      open: async (range) => {
+        try {
+          const partial = range.kind === 'partial';
+          const expectedLength = partial ? range.end - range.start + 1 : entry.byteSize;
+          const result = await client.send(
+            new GetObjectCommand({
+              ...input,
+              IfMatch: head.ETag,
+              ...(partial ? { Range: `bytes=${range.start}-${range.end}` } : {}),
+            }),
+            { abortSignal: AbortSignal.timeout(REQUEST_TIMEOUT_MS) },
+          );
+          if (
+            !result.Body ||
+            result.ContentLength !== expectedLength ||
+            !['application/octet-stream', entry.mimeType].includes(result.ContentType ?? '') ||
+            (partial &&
+              result.ContentRange !== `bytes ${range.start}-${range.end}/${entry.byteSize}`)
+          ) {
+            if (result.Body) await result.Body.transformToWebStream().cancel();
+            return unavailable();
+          }
+          const reader = result.Body.transformToWebStream().getReader();
+          const hash = partial ? undefined : createHash('sha256');
+          let count = 0;
+          return new ReadableStream<Uint8Array>({
+            async pull(controller) {
+              try {
+                const { done, value } = await reader.read();
+                if (done) {
+                  if (count !== expectedLength || (hash && hash.digest('hex') !== entry.sha256)) {
+                    throw new ClassroomMediaStorageError(502);
+                  }
+                  controller.close();
+                  return;
+                }
+                count += value.byteLength;
+                if (count > expectedLength) throw new ClassroomMediaStorageError(502);
+                hash?.update(value);
+                controller.enqueue(value);
+              } catch {
+                await reader.cancel().catch(() => {});
+                controller.error(new ClassroomMediaStorageError(502));
+              }
+            },
+            cancel: (reason) => reader.cancel(reason),
+          });
+        } catch (error) {
+          throw mappedError(error);
+        }
+      },
+    };
+  } catch (error) {
+    throw mappedError(error);
+  }
+}
