+  const response = await read(String(range));
+  expect(response.status).toBe(206);
+  expect(response.headers.get('content-range')).toBe(`bytes ${start}-${end}/20`);
+  expect(response.headers.get('content-length')).toBe(String(Number(end) - Number(start) + 1));
+  expect(response.headers.get('accept-ranges')).toBe('bytes');
+  expect(Buffer.from(await response.arrayBuffer())).toEqual(
+    bytes.subarray(Number(start), Number(end) + 1),
+  );
+});
