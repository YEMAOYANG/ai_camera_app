+/** Code-point cursor, shared fixed Latin ranges, and longest whole Chinese words.
+ * Unknown runs cannot fall back to individually supported consonants/vowels. */
+function bpmfParts(text: string, policy: typeof MIRA_TEXTBOOK_PINYIN_BPMF_PRONUNCIATION_POLICY): string[] {
+  const characters = Array.from(text);
+  const latin = (character: string) => policy.textHandling.latinRunRanges.some(
+    ([start, end]) => character.codePointAt(0)! >= start && character.codePointAt(0)! <= end,
+  );
+  const symbols: Record<string, { ph: string; carrier: string }> = policy.symbols;
+  const words: Record<string, { ph: string; carrier: string }> = policy.words;
+  const wordKeys = Object.keys(words).sort((a, b) => Array.from(b).length - Array.from(a).length || (a < b ? -1 : a > b ? 1 : 0));
+  const parts: string[] = [];
+  for (let index = 0; index < characters.length;) {
+    const character = characters[index];
+    if (/\p{Mark}/u.test(character) || (/\p{Cc}/u.test(character) && !/[\n\r\t]/u.test(character)))
+      throw new Error('Invalid textbook pinyin mark or control character');
+    let token: string | undefined;
+    let entry: { ph: string; carrier: string };
+    if (latin(character)) {
+      let end = index + 1;
+      while (end < characters.length && latin(characters[end])) end += 1;
+      token = characters.slice(index, end).join('');
+      if (!Object.hasOwn(symbols, token)) throw new Error('Unsupported complete textbook pinyin token');
+      entry = symbols[token];
+    } else {
+      token = wordKeys.find(word => characters.slice(index, index + Array.from(word).length).join('') === word);
+      if (token === undefined) {
+        parts.push(XML_ENTITIES[character] ?? character);
+        index += 1;
+        continue;
+      }
+      entry = words[token];
+    }
+    parts.push(`<phoneme alphabet="py" ph="${entry.ph}">${entry.carrier}</phoneme>`);
+    index += Array.from(token).length;
+  }
+  return parts;
