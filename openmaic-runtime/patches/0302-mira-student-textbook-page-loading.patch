+import type { Scene } from '@/lib/types/stage';
+
+vi.mock('@/lib/classroom/pbl-fallback-hydration', () => ({
+  hydrateClassroomFallbackScenes: async (_id: string, scenes: Scene[]) => scenes,
+}));
+
+const classroomId = 'tbpub_' + 'a'.repeat(24);
+const summary = (id: string, order: number): Scene => ({
+  id, stageId: classroomId, order, title: id, type: 'interactive',
+  content: { type: 'interactive', html: '' }, miraPageSummary: true,
+});
+const first = summary('first', 1);
+const second = summary('second', 2);
+const fullPage = (scene: Scene) => ({ ...scene, miraPageSummary: undefined,
+  content: { type: 'interactive', html: '<button>开始</button>' } });
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe('fixed textbook page requests', () => {
+  it('starts with the resumed page and reuses an in-flight prefetch when the student turns the page', async () => {
+    const fetcher = vi.fn(async (url: string) => {
+      const scene = url.endsWith('scene=first') ? first : second;
+      return Response.json({ success: true, scene: fullPage(scene) });
+    });
