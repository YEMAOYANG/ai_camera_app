diff --git a/lib/mira/student-classroom-pages.ts b/lib/mira/student-classroom-pages.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e07b7a9c53c563d766f487b33c3469ee06a56ae9
--- /dev/null
+++ b/lib/mira/student-classroom-pages.ts
@@ -0,0 +1,59 @@
+'use client';
+
+import { createContext, useContext } from 'react';
+import { hydrateClassroomFallbackScenes } from '@/lib/classroom/pbl-fallback-hydration';
+import type { ClassroomPayload } from '@/lib/classroom/load-classroom';
+import type { Scene } from '@/lib/types/stage';
+
+export async function fetchStudentClassroomIndex(classroomId: string) {
+  const response = await fetch(`/api/classroom?id=${encodeURIComponent(classroomId)}&view=pages`);
+  if (!response.ok) return null;
+  const data: { success?: boolean; classroom?: ClassroomPayload } = await response.json();
+  return data.success && data.classroom?.stage.id === classroomId ? data.classroom : null;
+}
+
+export function createStudentClassroomPages(classroomId: string, directory: readonly Scene[]) {
+  const summaries = new Map(directory.map((scene) => [scene.id, scene]));
+  const requested = new Map<string, Promise<Scene>>();
+  const controller = new AbortController();
+
+  return {
+    get active() { return !controller.signal.aborted; },
+    dispose() {
+      controller.abort();
+      requested.clear();
+    },
+    read(sceneId: string, priority: 'high' | 'low' = 'high'): Promise<Scene> {
+      const summary = summaries.get(sceneId);
+      if (!summary || controller.signal.aborted) {
+        return Promise.reject(new Error('课件页面已不可用，请重新进入课堂。'));
+      }
+      const existing = requested.get(sceneId);
+      if (existing) return existing;
+      const query = new URLSearchParams({ id: classroomId, scene: sceneId });
+      const page = (async () => {
+        const response = await fetch(`/api/classroom?${query}`, { signal: controller.signal, priority });
+        if (!response.ok) throw new Error('课件页面暂时打不开，请再试一次。');
+        const data: { success?: boolean; scene?: Scene } = await response.json();
+        const scene = data.scene;
+        if (!data.success || !scene || scene.id !== sceneId || scene.stageId !== classroomId
+            || scene.order !== summary.order || scene.type !== summary.type
+            || scene.content?.type !== summary.type || scene.miraPageSummary) {
+          throw new Error('课件页面与当前课堂不一致，请重新进入课堂。');
+        }
+        const [hydrated] = await hydrateClassroomFallbackScenes(classroomId, [scene]);
+        controller.signal.throwIfAborted();
+        return hydrated;
+      })().catch((error: unknown) => {
+        requested.delete(sceneId);
+        throw error;
+      });
+      requested.set(sceneId, page);
+      return page;
+    },
+  };
+}
+
+export type StudentClassroomPages = ReturnType<typeof createStudentClassroomPages>;
+export const StudentClassroomPagesContext = createContext<StudentClassroomPages | null>(null);
+export const useStudentClassroomPages = () => useContext(StudentClassroomPagesContext);
