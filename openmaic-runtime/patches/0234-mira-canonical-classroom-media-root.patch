diff --git a/tests/server/classroom-media-root.test.ts b/tests/server/classroom-media-root.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/classroom-media-root.test.ts
@@ -0,0 +1,34 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import { NextRequest } from 'next/server';
+import { afterEach, expect, it, vi } from 'vitest';
+const storage = vi.hoisted(() => ({ root: '' }));
+vi.mock('@/lib/server/classroom-storage', () => ({
+  get CLASSROOMS_DIR() { return storage.root; },
+  isValidClassroomId: (value: string) => /^[A-Za-z0-9_-]+$/.test(value),
+}));
+import { GET } from '@/app/api/classroom-media/[classroomId]/[...path]/route';
+let folder = '';
+afterEach(async () => { if (folder) await fs.rm(folder, { recursive: true, force: true }); folder = ''; });
+it('serves the exact bytes under a trusted symlinked root while rejecting file and classroom escapes', async () => {
+  folder = await fs.mkdtemp(path.join(process.env.MIRA_TASK_TMPDIR ?? os.tmpdir(), 'media-root-'));
+  const actual = path.join(folder, 'actual'); await fs.mkdir(path.join(actual, 'lesson', 'media'), { recursive: true });
+  const bytes = Buffer.from('exact original media bytes');
+  await fs.writeFile(path.join(actual, 'lesson', 'media', 'image.png'), bytes);
+  await fs.writeFile(path.join(folder, 'outside.png'), 'private');
+  await fs.symlink(path.join(folder, 'outside.png'), path.join(actual, 'lesson', 'media', 'escape.png'));
+  await fs.mkdir(path.join(folder, 'outside', 'media'), { recursive: true });
+  await fs.writeFile(path.join(folder, 'outside', 'media', 'image.png'), 'private');
+  await fs.symlink(path.join(folder, 'outside'), path.join(actual, 'escaped-lesson'));
+  storage.root = path.join(folder, 'configured-root'); await fs.symlink(actual, storage.root);
+  const request = new NextRequest('http://127.0.0.1/api/classroom-media/lesson/media/image.png');
+  const read = (classroomId: string, file: string) => GET(request, { params: Promise.resolve({ classroomId, path: ['media', file] }) });
+  const response = await read('lesson', 'image.png');
+  expect(response.status).toBe(200);
+  expect(response.headers.get('content-type')).toBe('image/png');
+  expect(Buffer.from(await response.arrayBuffer())).toEqual(bytes);
+  expect((await read('lesson', 'escape.png')).status).toBe(404);
+  expect((await read('escaped-lesson', 'image.png')).status).toBe(404);
+  expect((await read('lesson', '../outside.png')).status).toBe(400);
+});
