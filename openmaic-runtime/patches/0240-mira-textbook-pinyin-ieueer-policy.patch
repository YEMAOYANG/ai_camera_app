+import { readFileSync } from 'fs';
+import { fileURLToPath } from 'url';
+import { describe, expect, it } from 'vitest';
+import * as registry from '@/lib/server/mira-textbook-pinyin-pronunciation';
+
+const version = 'mira.textbook.pinyin-ieueer-ssml.v1';
+const policy = JSON.parse(readFileSync(fileURLToPath(new URL(
+  '../../../../../backend/content/textbook_pinyin_pronunciation_ieueer.v1.json',
+  import.meta.url,
+)), 'utf8'));
+const sha = '27b702593fc628848ecad8dff8b21859d2bae2cc4de33f373e65c62a8f24da46';
+const prepare = registry.prepareMiraTextbookPinyinPronunciation;
+const phonemes = (text: string) => [...prepare(text, version).ssml.matchAll(/<phoneme alphabet="py" ph="([^"]+)">/g)]
+  .map(match => match[1]);
+
+describe('IE UE ER exact textbook pronunciation registration', () => {
+  it('is byte-independent canonical parity with the backend recipe and immutable provider identity', () => {
+    expect(registry.MIRA_TEXTBOOK_PINYIN_IEUEER_PRONUNCIATION_POLICY).toEqual(policy);
+    expect(registry.MIRA_TEXTBOOK_PINYIN_IEUEER_PRONUNCIATION_POLICY_SHA256).toBe(sha);
+    expect(Object.keys(policy.symbols)).toHaveLength(37);
+    const result = prepare('请听，xiě zuò yè。', version);
+    expect(result.profile).toMatchObject({ policyVersion: version, policySha256: sha });
+    expect(result.providerPronunciation).toMatchObject({
+      policyVersion: version, policySha256: sha,
+      providerId: 'aliyun-cosyvoice', modelId: 'cosyvoice-v3-flash', voiceId: 'longanwen_v3',
+    });
+    expect(result.providerRequest).toMatchObject({ model: 'cosyvoice-v3-flash', input: {
+      voice: 'longanwen_v3', format: 'wav', sample_rate: 24000, enable_ssml: true,
+      rate: 1, pitch: 1, seed: 0, language_hints: ['zh'],
+    } });
+    expect(registry.isMiraTextbookPinyinProviderPronunciation(
+      result.providerPronunciation, result.providerPronunciation.sourceTextSha256,
+    )).toBe(true);
+    expect(registry.isMiraTextbookPinyinProviderPronunciation(
+      { ...result.providerPronunciation, policySha256: '0'.repeat(64) },
+      result.providerPronunciation.sourceTextSha256,
+    )).toBe(false);
+  });
+
+  it('keeps the five base forms whole and distinguishes the printed er tone', () => {
+    expect(phonemes('ie，üe，er，ye，yue。')).toEqual(['ye1', 'yue1', 'er1', 'ye1', 'yue1']);
+    expect(phonemes('yuè，ér。')).toEqual(['yue4', 'er2']);
+    expect(prepare('er', version).ssml).toBe('<speak><phoneme alphabet="py" ph="er1">儿</phoneme></speak>');
+    expect(prepare('ér', version).ssml).toBe('<speak><phoneme alphabet="py" ph="er2">儿</phoneme></speak>');
+  });
+
+  it('covers exactly the printed eleven syllables without normalizing umlauts or assembling letters', () => {
+    expect(phonemes('piě dié bié xié qiē jiě')).toEqual(['pie3', 'die2', 'bie2', 'xie2', 'qie1', 'jie3']);
+    expect(phonemes('lüè nüè jué quē xué')).toEqual(['lve4', 'nve4', 'jue2', 'que1', 'xue2']);
+    expect(phonemes('xiě zuò yè')).toEqual(['xie3', 'zuo4', 'ye4']);
+    expect(phonemes('méi huā kāi，xuě huā piāo，yè sè měi。')).toEqual([
+      'mei2', 'hua1', 'kai1', 'xue3', 'hua1', 'piao1', 'ye4', 'se4', 'mei3',
+    ]);
+    expect(phonemes('p b d l n x q j y')).toEqual(['po1', 'bo1', 'de1', 'le1', 'ne1', 'xi1', 'qi1', 'ji1', 'yi1']);
+  });
+
+  it('rejects unapproved isolated components, tone rows, concatenations and alternate encodings', () => {
+    for (const token of ['ue', 'ué', 'uē', 'üè', 'iě', 'ié', 'iē', 'iè', 'üē', 'üé', 'üě',
+      'ē r', 'ěr', 'èr', 'ie1', 'yue4', 'lvè', 'nvè', 'lüe', 'nue', 'xue', 'jüé', 'qǖe',
+      'xiězuòyè', 'ieüe', 'IE', 'ｉｅ', 'i\u030ce', 'u\u0308e', 'an', 'yuan']) {
+      expect(() => prepare(`请听：${token}。`, version), token).toThrow();
+    }
+    expect(() => prepare('请听。', 'mira.textbook.pinyin-ieueer-ssml.v2')).toThrow();
+    const result = prepare('请听，xué。', version);
+    expect(() => registry.assertMiraTextbookPinyinProfile(
+      { ...result.profile, ssmlSha256: '0'.repeat(64) }, result.profile,
+    )).toThrow();
+  });
+
+  it('leaves ordinary Chinese natural and escapes markup rather than accepting caller SSML', () => {
+    expect(prepare('梅花开，雪花飘，夜色美。', version).ssml).toBe('<speak>梅花开，雪花飘，夜色美。</speak>');
+    expect(prepare('老师<&>说：ie。', version).ssml).toBe(
+      '<speak>老师&lt;&amp;&gt;说：<phoneme alphabet="py" ph="ye1">椰</phoneme>。</speak>',
+    );
+    expect(policy.words).toEqual({});
+    expect(policy.exactTextSsml).toBeUndefined();
+  });
+
+  it('preserves previous lessons and does not turn a recipe into new listening or publication evidence', () => {
+    expect(prepare('请听。', 'mira.textbook.pinyin-aouiu-ssml.v1').profile.policySha256)
+      .toBe('e23f67fe90ab412d17e1260bf2d1ee4a510c0407bfbfacac9ebce16016583a0d');
+    expect(prepare('请听。', 'mira.textbook.pinyin-aieiui-ssml.v4').profile.policySha256)
+      .toBe('d26d1744a110f0ed327d08cdfeb950fe8f15b198fb322f98aa5611f866c6b8b8');
+    expect(prepare('luó bo', 'mira.textbook.pinyin-aieiui-ssml.v4').ssml)
+      .toBe('<speak><sub alias="萝卜">luó bo</sub>。</speak>');
+    for (const key of ['humanListeningVerified', 'perceptualToneVerified', 'pronunciationApproved', 'formalUseAllowed'])
+      expect(policy.approvalBoundary[key]).toBe(false);
+  });
+});
