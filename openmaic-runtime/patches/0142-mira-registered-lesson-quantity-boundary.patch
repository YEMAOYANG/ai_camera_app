+/** Cross-check the structured boundary against the existing frozen lesson authority.
+ * The Backend separately recomputes both values from its actual curriculum registry.
+ * Human-readable allowedContent is never parsed as authority here. */
+export function assertMiraFormalProgressiveConstraints(
+  boundary: Record<string, unknown>, brief: Record<string, unknown>,
+): Record<string, unknown> {
+  const fail = (): never => { throw new Error('FORMAL_SKILL_REGISTERED_CONSTRAINTS_INVALID'); };
+  const constraints = record(boundary.constraints);
+  const binding = record(brief.progressiveLesson);
+  const difficulty = record(brief.difficultyPolicy);
+  const scope = record(difficulty.lessonScope);
+  const { policySha256, ...unsignedDifficulty } = difficulty;
+  const fields = [
+    'allowedGrammarCodes', 'allowedLetters', 'allowedOperations', 'allowedPinyin',
+    'assessmentEvidenceKinds', 'assessmentEvidenceScope', 'audioInstructionsAllowed',
+    'challengeMayOnlyCombineDeclaredKnowledge', 'excludedGrammarCodes', 'introducedGrammarCodes',
+    'introducedOperations', 'introducedTokens', 'maxCoreNewTargets', 'maximumNumber', 'minimumNumber',
+    'neutralDistractorTokens', 'newVocabularyMustBeIntroducedBeforeUse',
+    'noUnintroducedKnowledgeInInstructions', 'teachBeforeAssessment', 'tokenKind',
+    'writtenNumberRecognitionRequired',
+  ].sort();
+  const listFields = ['allowedGrammarCodes', 'allowedLetters', 'allowedOperations', 'allowedPinyin',
+    'assessmentEvidenceKinds', 'excludedGrammarCodes', 'introducedGrammarCodes', 'introducedOperations',
+    'introducedTokens', 'neutralDistractorTokens'];
+  const trueFields = ['audioInstructionsAllowed', 'challengeMayOnlyCombineDeclaredKnowledge',
+    'newVocabularyMustBeIntroducedBeforeUse', 'noUnintroducedKnowledgeInInstructions', 'teachBeforeAssessment'];
+  const minimum = constraints.minimumNumber, maximum = constraints.maximumNumber;
+  const numericScope = minimum === null && maximum === null
+    || typeof minimum === 'number' && Number.isFinite(minimum)
+      && typeof maximum === 'number' && Number.isFinite(maximum) && minimum <= maximum;
+  if (brief.schemaVersion !== 'mira.learning.formal-runtime-teaching-brief.progressive.v1'
+    || boundary.curriculumVersion !== 'mira.primary.progressive.v1'
+    || JSON.stringify(Object.keys(constraints).sort()) !== JSON.stringify(fields)
+    || !listFields.every(key => textList(constraints[key]))
+    || !trueFields.every(key => constraints[key] === true)
+    || typeof constraints.writtenNumberRecognitionRequired !== 'boolean'
+    || !text(constraints.tokenKind) || !text(constraints.assessmentEvidenceScope)
+    || !Number.isInteger(constraints.maxCoreNewTargets) || Number(constraints.maxCoreNewTargets) < 1
+    || !numericScope
+    || binding.schemaVersion !== 'mira.learning.progressive-binding.v1'
+    || binding.curriculumVersion !== boundary.curriculumVersion || binding.lessonId !== boundary.skillId
+    || !/^[a-f0-9]{64}$/.test(String(binding.lessonSha256))
+    || !/^[a-f0-9]{64}$/.test(String(binding.identitySha256))
+    || boundary.boundaryVersion !== `${String(boundary.curriculumVersion)}:${String(binding.lessonSha256).slice(0, 24)}`
+    || difficulty.schemaVersion !== 'mira.learning.difficulty-policy.v1'
+    || difficulty.policyVersion !== 'mira.learning.progressive-difficulty-policy.v1'
+    || !['gradeCode', 'subject', 'skillId', 'curriculumVersion'].every(key => difficulty[key] === boundary[key])
+    || difficulty.lessonSha256 !== binding.lessonSha256
+    || difficulty.curriculumIdentitySha256 !== binding.identitySha256
+    || difficulty.difficultyCode !== binding.difficultyCode
+    || formalCanonicalSha256(unsignedDifficulty) !== policySha256
+    || formalCanonicalSha256(scope.constraints) !== formalCanonicalSha256(constraints)) fail();
+  return structuredClone(constraints);
+}
