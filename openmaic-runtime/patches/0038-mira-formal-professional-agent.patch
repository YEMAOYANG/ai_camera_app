+    throw new Error('FORMAL_PROFESSIONAL_ASSESSMENT_INVALID');
+  }
+  const expectedWidgets = ['simulation', 'game', 'visualization3d'];
+  for (const [index, scene] of scenes.slice(7).entries()) {
+    if (scene.content.type !== 'interactive') {
+      throw new Error('FORMAL_PROFESSIONAL_WIDGET_INVALID');
+    }
+    const config = plainObject(scene.content.widgetConfig);
+    const html = typeof scene.content.html === 'string' ? scene.content.html : '';
+    if (
+      scene.content.widgetType !== expectedWidgets[index] ||
+      config?.type !== expectedWidgets[index] ||
+      html.length < 200 ||
+      !/<script[\s>]/iu.test(html) ||
+      !/<(?:button|input|select|canvas)[\s>]/iu.test(html)
+    ) {
+      throw new Error('FORMAL_PROFESSIONAL_WIDGET_INVALID');
+    }
+  }
+}
+
+function isResearchTrace(value: unknown): value is MiraFormalResearchSearchTrace {
+  const trace = plainObject(value);
+  return Boolean(
+    trace &&
+      trace.kind === MIRA_FORMAL_RESEARCH_SEARCH_EVENT_TYPE &&
+      trace.schemaVersion === MIRA_FORMAL_RESEARCH_SEARCH_TRACE_SCHEMA_VERSION &&
+      typeof trace.query === 'string' &&
+      trace.query.trim() &&
+      typeof trace.providerId === 'string' &&
+      trace.providerId.trim() &&
+      typeof trace.searchedAt === 'string' &&
+      Number.isFinite(trace.resultCount) &&
+      Number(trace.resultCount) > 0 &&
+      Array.isArray(trace.sources) &&
+      trace.sources.length === Number(trace.resultCount),
+  );
+}
+
+function normalizedUrl(value: string): string | null {
+  try {
+    const url = new URL(value);
+    return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : null;
+  } catch {
+    return null;
+  }
+}
+
+async function buildResearchReceipt(
+  events: PersistedAgentSessionEvent[],
+  scenes: Scene[],
+  spec: FormalCoursewareSpec,
+  sessionId: string,
+): Promise<MiraFormalResearchReceipt> {
+  const traces = events
+    .filter((event) => event.type === MIRA_FORMAL_RESEARCH_SEARCH_EVENT_TYPE)
+    .map((event) => event.data)
+    .filter(isResearchTrace);
+  if (traces.length < 1 || traces.length > MIRA_PROFESSIONAL_CREATION_POLICY.webSearch.maxCalls) {
+    throw new Error('FORMAL_PROFESSIONAL_RESEARCH_SEARCH_COUNT_INVALID');
+  }
+  const providers = new Set(traces.map((trace) => trace.providerId));
+  if (providers.size !== 1) throw new Error('FORMAL_PROFESSIONAL_RESEARCH_PROVIDER_INVALID');
+  const observedUrls = new Set(
+    traces.flatMap((trace) =>
+      trace.sources.map((source) => normalizedUrl(source.url)).filter((url): url is string => !!url),
+    ),
+  );
+  const materials = (await listSessionMaterials(sessionId, { limit: 200 })).filter(
+    (material) => material.kind === 'web' && material.sourceUrl && material.textAssetId,
+  );
+  const fetched: FetchedResearchSource[] = [];
+  for (const material of materials) {
+    const url = normalizedUrl(material.sourceUrl!);
+    if (!url || !observedUrls.has(url)) continue;
+    const text = await resolveSessionMaterialText(sessionId, material.textAssetId!);
+    if (!text || text.length === 0) continue;
+    fetched.push({
+      title: material.title?.trim() || new URL(url).hostname,
+      url,
+      textSha256: sha256(text),
+    });
+  }
+  if (fetched.length < MIRA_PROFESSIONAL_CREATION_POLICY.webSearch.minimumFetchedSources) {
+    throw new Error('FORMAL_PROFESSIONAL_RESEARCH_FETCH_MISSING');
+  }
+  const citations = fetched.flatMap((source) => {
+    const hostname = new URL(source.url).hostname.toLowerCase();
+    const title = source.title.toLowerCase();
+    const sceneIds = scenes
+      .filter((scene) => {
+        const content = canonicalJson(scene).toLowerCase();
+        return content.includes(source.url.toLowerCase()) || content.includes(hostname) ||
+          (title.length >= 4 && content.includes(title));
+      })
+      .map((scene) => scene.id);
+    return sceneIds.length ? [{ url: source.url, sceneIds }] : [];
+  });
+  if (citations.length < 1) throw new Error('FORMAL_PROFESSIONAL_RESEARCH_CITATION_MISSING');
+  const withoutHash = {
+    schemaVersion: RESEARCH_RECEIPT_VERSION,
+    status: 'succeeded' as const,
+    runtimeRequestId: spec.runtimeRequestId,
+    buildItemId: spec.buildItemId,
+    classroomId: scenes[0]!.stageId,
+    sessionId,
+    providerId: [...providers][0]!,
+    searchCount: traces.length,
+    resultCount: traces.reduce((total, trace) => total + trace.resultCount, 0),
+    fetchedSourceCount: fetched.length,
+    citationCount: citations.length,
+    searches: traces.map((trace) => ({
+      query: trace.query,
+      searchedAt: trace.searchedAt,
+      resultCount: trace.resultCount,
+    })),
+    sources: fetched,
+    citations,
+  };
+  return { ...withoutHash, receiptSha256: canonicalSha256(withoutHash) };
+}
+
+function buildProfessionalCreationReceipt(
+  input: GenerateClassroomInput,
+  spec: FormalCoursewareSpec,
+  classroomId: string,
+  sessionId: string,
+): MiraFormalProfessionalCreationReceipt {
+  const contract = formalContractPayload(input);
+  const teachingBrief = contract.teachingBrief;
+  const teachingBriefSha256 = String(contract.teachingBriefSha256 || '');
+  if (!/^[0-9a-f]{64}$/u.test(teachingBriefSha256) || canonicalSha256(teachingBrief) !== teachingBriefSha256) {
+    throw new Error('FORMAL_PROFESSIONAL_TEACHING_BRIEF_HASH_INVALID');
+  }
+  const withoutHash = {
+    schemaVersion: PROFESSIONAL_CREATION_RECEIPT_VERSION,
+    status: 'succeeded' as const,
+    runtimeRequestId: spec.runtimeRequestId,
+    buildItemId: spec.buildItemId,
+    classroomId,
+    teachingBriefSha256,
+    sessionId,
+    workflowVersion: MIRA_PROFESSIONAL_CREATION_POLICY.workflowVersion,
+    skillId: MIRA_PROFESSIONAL_CREATION_POLICY.skillId,
+    supportingSkillIds: [...MIRA_PROFESSIONAL_CREATION_POLICY.supportingSkillIds],
+    userPromptRequired: false as const,
+    studentToolsEnabled: false as const,
+    webSearchEnabled: true as const,
+  };
+  return { ...withoutHash, receiptSha256: canonicalSha256(withoutHash) };
+}
+
+export async function generateMiraFormalProfessionalClassroom(
+  input: GenerateClassroomInput,
+  options: {
+    baseUrl: string;
+    onProgress?: (progress: ClassroomGenerationProgress) => Promise<void> | void;
+  },
+): Promise<GenerateClassroomResult> {
+  const spec = parseFormalCoursewareSpec(input);
+  await options.onProgress?.({
+    step: 'researching',
+    progress: 10,
+    message: 'Starting the unattended OpenMAIC Pro courseware workflow with required web research',
+    scenesGenerated: 0,
+    totalScenes: 10,
+  });
+  const { identity } = await createOrReuseProfessionalSession(input, spec);
+  await waitForProfessionalSession(identity.sessionId, options.onProgress);
+  const events = await readAllSessionEvents(identity.sessionId);
+  const stageId = stageIdFromEvents(events);
+  const ownerStore = await getOwnerScopedDocumentStore(identity.ownerId);
+  const document = await ownerStore.loadDocument(stageId);
+  if (!document) throw new Error('FORMAL_PROFESSIONAL_DOCUMENT_MISSING');
+  const promoted = promoteProfessionalDocument(
+    document.stage as Stage,
+    document.scenes as Scene[],
+    spec,
+  );
+  const stage = promoted.stage;
+  const scenes = promoted.scenes;
+  assertProfessionalClassroom(stage, scenes, spec, identity.sessionId, document.outline);
+  const research = await buildResearchReceipt(events, scenes, spec, identity.sessionId);
+  const professionalCreation = buildProfessionalCreationReceipt(
+    input,
+    spec,
+    stage.id,
+    identity.sessionId,
+  );
+  await options.onProgress?.({
+    step: 'generating_tts',
+    progress: 50,
+    message: 'Professional classroom passed research and structure gates; validating formal audio',
+    scenesGenerated: scenes.length,
+    totalScenes: 10,
+  });
+  const formalAudio: MiraFormalAudioLifecycleReceipt = await completeMiraFormalAudioLifecycle(
+    { buildItemId: spec.buildItemId, subject: spec.course.subject, stage, scenes },
+    undefined,
+    {
+      onProgress: async ({ phase, completed, total }) => {
+        const completedWork = (completed - 1) * 2 + (phase === 'tts' ? 1 : 2);
+        await options.onProgress?.({
+          step: 'generating_tts',
+          progress: 50 + Math.floor((completedWork / (total * 2)) * 44),
+          message:
+            phase === 'tts'
+              ? `Generated and verified formal audio ${completed}/${total}`
+              : `Validated formal ASR round trip ${completed}/${total}`,
+          scenesGenerated: scenes.length,
+          totalScenes: 10,
+        });
+      },
+    },
+  );
+  await options.onProgress?.({
+    step: 'persisting',
+    progress: 98,
+    message: 'Publishing the validated Pro classroom to the student runtime',
+    scenesGenerated: scenes.length,
+    totalScenes: 10,
+  });
+  const persisted = await persistClassroom({ id: stage.id, stage, scenes }, options.baseUrl);
+  await options.onProgress?.({
+    step: 'completed',
+    progress: 100,
+    message: 'OpenMAIC Pro courseware workflow completed with web research and citations',
+    scenesGenerated: scenes.length,
+    totalScenes: 10,
+  });
+  return {
+    id: persisted.id,
+    url: persisted.url,
+    stage,
+    scenes,
+    scenesCount: scenes.length,
+    createdAt: persisted.createdAt,
+    formalAudio,
+    professionalCreation,
+    research,
+  };
+}
