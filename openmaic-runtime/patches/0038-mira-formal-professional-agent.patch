+async function countMiraFormalResearchSearchEvents(
+  store: Pick<Awaited<ReturnType<typeof getAgentSessionStore>>, 'readEventsAfter'>,
+  sessionId: string,
+): Promise<number> {
+  let cursor = 0;
+  let count = 0;
+  for (;;) {
+    const events = await store.readEventsAfter(sessionId, cursor, 500);
+    count += events.filter((event) => event.type === MIRA_FORMAL_RESEARCH_SEARCH_EVENT_TYPE).length;
+    if (events.length < 500) return count;
+    cursor = events[events.length - 1]!.id;
+  }
