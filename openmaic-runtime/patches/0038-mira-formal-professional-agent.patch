+import { getOwnerScopedDocumentStore } from '@/lib/server/agent-runtime/owner-scoped-documents';
+import { getAgentSessionStore } from '@/lib/server/agent-runtime/store';
+import { resolveWebSearchCapability } from '@/lib/server/agent-runtime/web-search';
+import type { QuizQuestion, Scene, Stage } from '@/lib/types/stage';
+
+const FORMAL_SESSION_TIMEOUT_MS = 60 * 60 * 1_000;
+const FORMAL_SESSION_POLL_MS = 2_000;
+const MAX_AGENT_EVENTS = 20_000;
+const PROFESSIONAL_CREATION_RECEIPT_VERSION =
+  'mira.openmaic.professional-creation-receipt.v1' as const;
+const RESEARCH_RECEIPT_VERSION =
+  'mira.openmaic.professional-research-receipt.v1' as const;
+const PROFESSIONAL_SESSION_ORIGIN = 'mira-formal-professional';
+
+interface FormalIdentity {
+  digest: string;
+  sessionId: string;
+  ownerId: string;
+}
+
+interface FetchedResearchSource {
+  title: string;
+  url: string;
+  textSha256: string;
+}
+
+export interface MiraFormalProfessionalCreationReceipt {
+  schemaVersion: typeof PROFESSIONAL_CREATION_RECEIPT_VERSION;
+  status: 'succeeded';
+  runtimeRequestId: string;
+  buildItemId: string;
+  classroomId: string;
+  teachingBriefSha256: string;
+  sessionId: string;
+  workflowVersion: typeof MIRA_PROFESSIONAL_CREATION_POLICY.workflowVersion;
+  skillId: typeof MIRA_PROFESSIONAL_CREATION_POLICY.skillId;
+  supportingSkillIds: string[];
+  userPromptRequired: false;
+  studentToolsEnabled: false;
+  webSearchEnabled: true;
+  receiptSha256: string;
+}
+
+export interface MiraFormalResearchReceipt {
+  schemaVersion: typeof RESEARCH_RECEIPT_VERSION;
+  status: 'succeeded';
+  runtimeRequestId: string;
+  buildItemId: string;
+  classroomId: string;
+  sessionId: string;
+  providerId: string;
+  searchCount: number;
+  resultCount: number;
+  fetchedSourceCount: number;
+  citationCount: number;
+  searches: Array<{ query: string; searchedAt: string; resultCount: number }>;
+  sources: FetchedResearchSource[];
+  citations: Array<{ url: string; sceneIds: string[] }>;
+  receiptSha256: string;
+}
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(
+      Object.entries(value as Record<string, unknown>)
+        .filter(([, item]) => item !== undefined)
+        .sort(([left], [right]) => left.localeCompare(right))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  }
+  return value;
+}
+
+function canonicalJson(value: unknown): string {
+  return JSON.stringify(canonical(value));
+}
+
+function sha256(value: string | Uint8Array): string {
+  return createHash('sha256').update(value).digest('hex');
+}
+
+function canonicalSha256(value: unknown): string {
+  return sha256(canonicalJson(value));
+}
+
+function plainObject(value: unknown): Record<string, unknown> | null {
+  return value && typeof value === 'object' && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+function professionalIdentity(input: GenerateClassroomInput): FormalIdentity {
+  const digest = sha256(`${input.runtimeRequestId}\n${canonicalJson(input)}`);
+  return {
+    digest,
+    sessionId: `${MIRA_FORMAL_PROFESSIONAL_SESSION_ID_PREFIX}${digest}`,
+    ownerId: `${MIRA_FORMAL_PROFESSIONAL_OWNER_ID_PREFIX}${digest}`,
+  };
+}
+
+function formalContractPayload(input: GenerateClassroomInput): Record<string, unknown> {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(input.requirement);
+  } catch {
+    throw new Error('FORMAL_PROFESSIONAL_BRIEF_INVALID');
+  }
+  const contract = plainObject(parsed);
+  if (!contract) throw new Error('FORMAL_PROFESSIONAL_BRIEF_INVALID');
+  return contract;
+}
+
+function professionalPrompt(input: GenerateClassroomInput, spec: FormalCoursewareSpec): string {
+  const contract = formalContractPayload(input);
+  const lockedAssessment = [...spec.guided, ...spec.independent].map((question) => ({
+    id: question.id,
+    type:
+      question.type === 'single_choice'
+        ? 'single'
+        : question.type === 'sequence'
+          ? 'multiple'
+          : 'short_answer',
+    question: question.prompt,
+    ...(question.choices
+      ? {
+          options: question.choices.map((choice) => ({
+            value: choice.id,
+            label: choice.label,
+          })),
+        }
+      : {}),
+    hasAnswer: false,
+    answer: [],
+    points: 1,
+  }));
+  return [
+    'MIRA SERVER-AUTHORED FORMAL PROFESSIONAL COURSEWARE JOB',
+    '',
+    'This is an unattended, server-approved job triggered after a parent saved the child grade.',
+    'Do not ask the user any question. Approval of the plan is already granted. Complete the',
+    'course in this run and create exactly one stage. Do not create a folder or a second stage.',
+    '',
+    `Use the forced /${MIRA_FORMAL_PROFESSIONAL_PRIMARY_SKILL_ID} Skill together with`,
+    `/${MIRA_PROFESSIONAL_CREATION_POLICY.supportingSkillIds[0]} and`,
+    `/${MIRA_PROFESSIONAL_CREATION_POLICY.supportingSkillIds[1]}.`,
+    '',
+    'Research gate (mandatory before page generation):',
+    '- Call web_search between 1 and 4 times with precise queries appropriate to this grade and subject.',
+    '- Prefer official curriculum, government, museum, university, or other primary educational sources.',
+    '- Use fetch_url on at least one URL returned by web_search and read that fetched material.',
+    '- Use facts only when supported by the fetched source. Add a small visible source footer containing',
+    '  the source title or domain on every page that uses a researched fact.',
+    '- If search, fetch, or citation cannot be completed, fail the job; never silently continue offline.',
+    '',
+    'Locked classroom contract:',
+    '- Exactly 10 scenes in this exact order: slide, slide, slide, slide, slide, quiz, quiz, interactive, interactive, interactive.',
+    '- The five slides are distinct teaching moves: warm-up, concept discovery, worked example, guided-practice preparation, independent-check preparation.',
+    '- Quiz scene 6 contains the first two locked assessment questions below, in order.',
+    '- Quiz scene 7 contains the last two locked assessment questions below, in order.',
+    '- Copy every locked question id, question, type, and option exactly. Keep hasAnswer=false and answer=[]; never add an answer or scoring rule.',
+    '- When calling generate_scene for pages 8-10, pass widgetType simulation, game, visualization3d respectively.',
+    '- Each interactive page must contain self-contained runnable HTML/JS, real learner controls, observable state change, and a matching non-empty widgetConfig.',
+    '- Every scene has exactly one non-empty speech action.',
+    '- At least one slide has a spotlight action targeting a real visible element.',
+    '- At least one interactive page has a widget_highlight action targeting a real control.',
+    '- At least two discussion actions use two different peer agent ids.',
+    '- Create exactly five roster agents: the locked teacher plus four student/assistant peers.',
+    '- Use age-appropriate Simplified Chinese, one learning action per page, strong visual hierarchy, generous spacing, and purposeful focus/highlight actions.',
+    '- Do not expose provider keys, answer contracts, private student data, or open-ended internet tools to the student runtime.',
+    '',
+    'Locked teacher (copy id, name and avatar exactly; omit voice/voiceConfig):',
+    'The server binds the approved Qwen teacher voice after the Pro Agent has finished,',
+    'so do not call list_voices, register_voice or generate_tts for this formal job.',
+    canonicalJson({
+      id: 'mira-formal-teacher',
+      name: spec.teacher.name,
+      role: 'teacher',
+      avatar: spec.teacher.avatar,
+    }),
+    '',
+    'Locked assessment questions:',
+    canonicalJson(lockedAssessment),
+    '',
+    'Answer-blind teaching brief (authoritative):',
+    canonicalJson(contract.teachingBrief),
+    '',
+    'Before finishing, read the created stage back and repair it until every locked requirement is true.',
+  ].join('\n');
+}
+
+async function createOrReuseProfessionalSession(
+  input: GenerateClassroomInput,
+  spec: FormalCoursewareSpec,
+): Promise<{ identity: FormalIdentity; prompt: string }> {
+  if (!isAgentRuntimeConfigured()) {
+    throw new Error('FORMAL_PROFESSIONAL_AGENT_RUNTIME_NOT_CONFIGURED');
+  }
+  if (!resolveWebSearchCapability()) {
+    throw new Error('FORMAL_PROFESSIONAL_WEB_SEARCH_NOT_CONFIGURED');
+  }
+  const identity = professionalIdentity(input);
+  const prompt = professionalPrompt(input, spec);
+  const store = await getAgentSessionStore();
+  let session = await store.getSession(identity.sessionId);
+  if (!session) {
+    try {
+      session = await store.createSession({
+        id: identity.sessionId,
+        ownerId: identity.ownerId,
+        prompt,
+        skillId: MIRA_FORMAL_PROFESSIONAL_PRIMARY_SKILL_ID,
+        origin: PROFESSIONAL_SESSION_ORIGIN,
+        existingCourse: false,
+        status: 'queued',
+      });
+    } catch (error) {
+      session = await store.getSession(identity.sessionId);
+      if (!session) throw error;
+    }
+  }
+  if (
+    !isMiraFormalProfessionalSessionIdentity({
+      ownerId: session.ownerId,
+      sessionId: session.id,
+      skillId: session.skillId,
+    }) ||
+    session.ownerId !== identity.ownerId ||
+    session.prompt !== prompt ||
+    session.origin !== PROFESSIONAL_SESSION_ORIGIN ||
+    session.existingCourse
+  ) {
+    throw new Error('FORMAL_PROFESSIONAL_SESSION_CONFLICT');
+  }
+  return { identity, prompt };
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+async function waitForProfessionalSession(
+  sessionId: string,
+  onProgress?: (progress: ClassroomGenerationProgress) => Promise<void> | void,
+): Promise<void> {
+  const store = await getAgentSessionStore();
+  const deadline = Date.now() + FORMAL_SESSION_TIMEOUT_MS;
+  let lastReportedAt = 0;
+  for (;;) {
+    const session = await store.getSession(sessionId);
+    if (!session) throw new Error('FORMAL_PROFESSIONAL_SESSION_MISSING');
+    if (session.status === 'succeeded') return;
+    if (session.status === 'failed' || session.status === 'cancelled') {
+      throw new Error(
+        `FORMAL_PROFESSIONAL_SESSION_${session.status.toUpperCase()}:${session.error || 'no error detail'}`,
+      );
+    }
+    if (Date.now() >= deadline) throw new Error('FORMAL_PROFESSIONAL_SESSION_TIMEOUT');
+    if (Date.now() - lastReportedAt >= 10_000) {
+      lastReportedAt = Date.now();
+      await onProgress?.({
+        step: 'generating_scenes',
+        progress: session.status === 'running' ? 35 : 18,
+        message:
+          session.status === 'running'
+            ? 'OpenMAIC Pro Agent is researching and creating the classroom'
+            : 'OpenMAIC Pro Agent session is queued',
+        scenesGenerated: 0,
+        totalScenes: 10,
+      });
+    }
+    await delay(FORMAL_SESSION_POLL_MS);
+  }
+}
+
+async function readAllSessionEvents(sessionId: string): Promise<PersistedAgentSessionEvent[]> {
+  const store = await getAgentSessionStore();
+  const events: PersistedAgentSessionEvent[] = [];
+  let cursor = 0;
+  for (;;) {
+    const page = await store.readEventsAfter(sessionId, cursor, 500);
+    events.push(...page);
+    if (events.length > MAX_AGENT_EVENTS) throw new Error('FORMAL_PROFESSIONAL_EVENT_LIMIT');
+    if (page.length < 500) return events;
+    cursor = page.at(-1)!.id;
+  }
+}
+
+function stageIdFromEvents(events: PersistedAgentSessionEvent[]): string {
+  const ids = new Set<string>();
+  for (const event of events) {
+    if (event.type !== HOST_AGENT_LIFECYCLE.stageLink && event.type !== 'course_link') continue;
+    const data = plainObject(event.data);
+    const stageId = typeof data?.stageId === 'string' ? data.stageId.trim() : '';
+    if (stageId) ids.add(stageId);
+  }
+  if (ids.size !== 1) throw new Error('FORMAL_PROFESSIONAL_STAGE_LINK_INVALID');
+  return [...ids][0]!;
+}
+
+function expectedRuntimeQuestion(question: FormalQuestion): Record<string, unknown> {
+  return {
+    id: question.id,
+    type:
+      question.type === 'single_choice'
+        ? 'single'
+        : question.type === 'sequence'
+          ? 'multiple'
+          : 'short_answer',
+    question: question.prompt,
+    ...(question.choices
+      ? {
+          options: question.choices.map((choice) => ({
+            value: choice.id,
+            label: choice.label,
+          })),
+        }
+      : {}),
+  };
+}
+
+function lockedRuntimeQuestion(question: FormalQuestion): QuizQuestion {
+  return {
+    ...(expectedRuntimeQuestion(question) as Omit<QuizQuestion, 'answer' | 'hasAnswer' | 'points'>),
+    answer: [],
+    hasAnswer: false,
+    points: 1,
+  } as QuizQuestion;
+}
+
+/**
+ * Pro authoring uses the workbench's 1-based page order and bindable voice
+ * catalog. The published Mira classroom intentionally uses a 0-based formal
+ * contract and a server-owned Qwen voice that is not exposed to Agent tools.
+ * Promote the durable Pro document across that boundary without trusting the
+ * model with either answer authority or provider identity.
+ */
+function promoteProfessionalDocument(
+  stage: Stage,
+  scenes: Scene[],
+  spec: FormalCoursewareSpec,
+): { stage: Stage; scenes: Scene[] } {
+  const ordered = [...scenes].sort((left, right) => left.order - right.order);
+  if (
+    ordered.length !== 10 ||
+    ordered.some((scene, index) => scene.order !== index + 1)
+  ) {
+    throw new Error('FORMAL_PROFESSIONAL_SOURCE_SCENE_ORDER_INVALID');
+  }
+
+  const roster = Array.isArray(stage.generatedAgentConfigs)
+    ? stage.generatedAgentConfigs
+    : [];
+  const promotedStage: Stage = {
+    ...stage,
+    generatedAgentConfigs: roster.map((agent) =>
+      agent.role === 'teacher'
+        ? { ...agent, voiceConfig: spec.teacher.voiceConfig }
+        : agent,
+    ),
+  };
+  const lockedQuestions = [...spec.guided, ...spec.independent].map(lockedRuntimeQuestion);
+  const promotedScenes = ordered.map((scene, index) => {
+    const content =
+      scene.content.type === 'quiz' && (index === 5 || index === 6)
+        ? {
+            ...scene.content,
+            questions: index === 5 ? lockedQuestions.slice(0, 2) : lockedQuestions.slice(2, 4),
+          }
+        : scene.content;
+    return { ...scene, order: index, content } as Scene;
+  });
+  return { stage: promotedStage, scenes: promotedScenes };
+}
+
+function assertProfessionalClassroom(
+  stage: Stage,
+  scenes: Scene[],
+  spec: FormalCoursewareSpec,
+  sessionId: string,
+  outline: unknown,
+): void {
