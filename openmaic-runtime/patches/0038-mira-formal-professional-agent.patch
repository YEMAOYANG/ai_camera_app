+  }
+  const peerIds = new Set(peers.map((agent) => agent.id));
+  const discussionPeers = new Set<string>();
+  let spotlight = false;
+  let widgetHighlight = false;
+  for (const scene of scenes) {
+    const actions = Array.isArray(scene.actions) ? scene.actions : [];
+    const speech = actions.filter(
+      (action) => action.type === 'speech' && typeof action.text === 'string' && action.text.trim(),
+    );
+    if (speech.length !== 1) throw new Error('FORMAL_PROFESSIONAL_SPEECH_INVALID');
+    for (const action of actions) {
+      if (
+        action.type === 'discussion' &&
+        typeof action.agentId === 'string' &&
+        peerIds.has(action.agentId)
+      ) {
+        discussionPeers.add(action.agentId);
+      }
+      if (
+        action.type === 'spotlight' &&
+        scene.type === 'slide' &&
+        typeof action.elementId === 'string' &&
+        action.elementId.trim()
+      ) {
+        spotlight = true;
+      }
+      if (action.type === 'widget_highlight' && scene.type === 'interactive') {
+        widgetHighlight = true;
+      }
+    }
+  }
+  if (discussionPeers.size < 2 || !spotlight || !widgetHighlight) {
+    throw new Error('FORMAL_PROFESSIONAL_TEACHING_ACTIONS_INVALID');
+  }
+  const expectedQuestions = [...spec.guided, ...spec.independent].map(expectedRuntimeQuestion);
+  const actualQuestions = scenes.slice(5, 7).flatMap((scene) => {
+    if (scene.content.type !== 'quiz') return [];
+    return Array.isArray(scene.content.questions) ? scene.content.questions : [];
+  });
+  if (
+    actualQuestions.length !== 4 ||
+    actualQuestions.some((question, index) => {
+      const actual = plainObject(question);
+      if (!actual || actual.hasAnswer !== false || canonicalJson(actual.answer) !== '[]') return true;
+      const comparable = {
+        id: actual.id,
+        type: actual.type,
+        question: actual.question,
+        ...(actual.options !== undefined ? { options: actual.options } : {}),
+      };
+      return canonicalJson(comparable) !== canonicalJson(expectedQuestions[index]);
+    })
