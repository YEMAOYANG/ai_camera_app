+function packetOf(snapshot: Snapshot): Snapshot['bindings'] {
+  const outer = snapshot.bindings as unknown as { checkpointArchive?: unknown };
+  return outer.checkpointArchive ? decodeArchive(outer.checkpointArchive) : snapshot.bindings;
+}
+
+function firstDifference(actual: unknown, expected: unknown, path = 'bindings'): string {
+  if (JSON.stringify(actual) === JSON.stringify(expected)) return '';
+  if (actual && expected && typeof actual === 'object' && typeof expected === 'object') {
+    for (const key of new Set([...Object.keys(actual), ...Object.keys(expected)])) {
+      const diff = firstDifference((actual as Record<string, unknown>)[key], (expected as Record<string, unknown>)[key], path + '.' + key);
+      if (diff) return diff;
+    }
+  }
+  return path + ': ' + JSON.stringify(actual)?.slice(0,180) + ' != ' + JSON.stringify(expected)?.slice(0,180);
+}
