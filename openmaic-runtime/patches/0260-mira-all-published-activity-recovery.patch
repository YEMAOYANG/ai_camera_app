+
+type Snapshot = { schemaVersion: string; bindings: { domain: Record<string, unknown>; references: unknown[]; images: unknown[] }; view: unknown[] };
+type CheckpointWindow = Window & { miraActivityCheckpoint: { capture(): Snapshot; restore(value: unknown): boolean; begin(): boolean }; checkpointNarrations: string[] };
