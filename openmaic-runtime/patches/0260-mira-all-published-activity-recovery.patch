+export function patchEarlyChineseActivityCheckpointAdapters(html: string): string {
+  if (html.includes('window.miraActivityCheckpoint')) return html;
+  const scripts = [...html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)]
+    .filter(match => !/\bsrc\s*=/.test(match[1]) && !/application\/json/.test(match[1]));
+  for (const script of scripts) {
+    const program = signature(script[2]), profile = EARLY_PROFILES[REVIEWED_EARLY_PROGRAMS[program]];
+    if (!profile || !script[2].endsWith(profile.tail)) continue;
+    const assets: Record<string, string> = {};
+    for (const value of html.matchAll(/\/api\/classroom-media\/[A-Za-z0-9_./-]+/g)) assets[signature(value[0])] = value[0];
+    let authored = script[2], validEdits = true;
+    for (const [before, after, count] of profile.edits ?? []) {
+      if (authored.split(before).length !== count + 1) { validEdits = false; break; }
+      authored = authored.split(before).join(after);
+    }
+    if (!validEdits) continue;
+    const insertion = authored.length - profile.tail.length;
+    let opening = 0;
+    if (profile.openingAnchor) {
+      let index = -1;
+      for (let count = 0; count <= profile.openingOccurrence; count++) index = authored.indexOf(profile.openingAnchor, index + 1);
+      if (index < 0) continue;
+      opening = index + profile.openingAnchor.length;
+    }
+    // Registry recipes identify the exact original lexical block. No source,
+    // callbacks, HTML or constructor is read from a learner snapshot.
+    const content = authored.slice(0, opening) + prefix(assets, profile) + authored.slice(opening, insertion)
+      + contract(profile, program) + authored.slice(insertion);
+    let result = html.slice(0, script.index) + script[0].replace(script[2], () => content)
+      + html.slice(script.index! + script[0].length);
+    const gates = scripts.filter(match => /\bid=["']mira-page-narration-gate["']/.test(match[1]));
+    for (const gate of gates) {
+      const patched = patchEarlyPageGate(gate[2]);
+      if (patched === null) return html;
+      result = result.replace(gate[0], () => gate[0].replace(gate[2], () => patched));
+    }
+    return result;
+  }
+  return html;
+}
