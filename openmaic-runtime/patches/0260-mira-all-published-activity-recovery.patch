+export function patchFormalActivityCheckpointAdapters(html: string): string {
+  if (html.includes('window.miraActivityCheckpoint')) return html;
+  const matches = [...html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)]
+    .filter(match => !/\bsrc\s*=/i.test(match[1]) && Object.hasOwn(REVIEWED_FORMAL_PROGRAMS, programSignature(match[2])));
+  if (matches.length !== 1) return html;
+  const script = matches[0], signature = programSignature(script[2]);
+  const profile = FORMAL_PROFILES[REVIEWED_FORMAL_PROGRAMS[signature]];
+  let source = script[2];
+  const contract = formalContract(profile, signature);
+  if(profile.rewrite){
+    if(source.split(profile.rewrite.before).length!==2)return html;
+    source=source.replace(profile.rewrite.before,profile.rewrite.after);
+  }
+  if (profile.place === 'dom-ready') {
+    // This program owns a delayed transition after an accepted answer. Keep
+    // its timer handles local and cancellable; they are never durable state.
+    source = source.replace(/\bsetTimeout\(/g, 'checkpointSchedule(');
+    const end = source.lastIndexOf('});');
+    if (end < 0) return html;
+    source = source.slice(0, end) + contract + source.slice(end);
+  } else if (profile.place === 'scene-ready') {
+    const anchor = '                animate();';
+    if (source.split(anchor).length !== 2) return html;
+    source = source.replace(anchor, () => contract + anchor);
+  } else if (profile.place === 'global') {
+    source += contract;
+  } else {
+    const closing = /\}\)\(\);\s*$/.exec(source);
+    if (!closing) return html;
+    source = source.slice(0, closing.index) + contract + source.slice(closing.index);
+  }
+  return html.slice(0, script.index) + script[0].replace(script[2], () => source)
+    + html.slice(script.index! + script[0].length);
+}
