+      ${profile.quiet ? `quiet:value=>{${profile.quiet}},` : ''}
+    });
+  })();\n`;
+  const source = script[2].slice(0, position) + contract + script[2].slice(position);
+  return html.slice(0, script.index) + script[0].replace(script[2], () => source) + html.slice(script.index! + script[0].length);
+}
