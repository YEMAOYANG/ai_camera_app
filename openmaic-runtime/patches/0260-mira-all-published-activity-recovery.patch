+      const saved = await capture(frame);
+      for (let repeat = 0; repeat < 2; repeat++) {
+        frame = await mount(page, html);
+        expect(await frame.evaluate(value => (window as unknown as ActivityWindow).miraActivityCheckpoint.restore(value), saved)).toBe(true);
+        expect(await capture(frame)).toEqual(saved);
+        expect(await frame.evaluate(() => (window as unknown as ActivityWindow).checkpointNarrations)).toEqual([]);
