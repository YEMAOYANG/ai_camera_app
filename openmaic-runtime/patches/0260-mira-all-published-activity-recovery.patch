+  it('sends large drawing archives without keepalive quota failure and replays their exact durable mutation', async () => {
+    const storage = memoryStorage(), posted: Mutation[] = [];
+    const large = { parts: Array(16).fill('汉'.repeat(4000)) };
+    const fetcher = vi.fn(async (_url: RequestInfo | URL, init?: RequestInit) => {
+      if (init?.method !== 'POST') return response(authority());
+      const size = new TextEncoder().encode(String(init.body)).length;
+      if (init.keepalive && size > 65536) throw new TypeError('keepalive quota exceeded');
+      expect(init.keepalive).toBe(size <= 60 * 1024);
+      const mutation = bodyOf(init); posted.push(mutation);
+      if (posted.length === 1) throw new TypeError('connection closed before receipt');
+      return response(authority({ revision: posted.length - 1,
+        mutationId: mutation.mutationId, value: mutation.state }));
+    });
+    const original = createActivityCheckpointClient(identity, { storage, fetcher });
+    await original.load();
+    expect(original.save(large)).toBe(true);
+    const durable = storage.getItem(keyFor())!;
+    expect(JSON.parse(durable).desired).toEqual(large);
+    await expect(original.flush()).rejects.toThrow('connection closed');
+    expect(storage.getItem(keyFor())).toBe(durable);
+    original.close();
+    const returning = createActivityCheckpointClient(identity, { storage, fetcher });
+    await expect(returning.load()).resolves.toEqual(large);
+    expect(posted[1]).toEqual(posted[0]);
+    expect(storage.getItem(keyFor())).toBeNull();
+    returning.save(state(2)); await returning.flush();
+    expect(posted[2].expectedRevision).toBe(1);
+    returning.close();
+  });
