+        dispatchEvent(new CustomEvent('mira-narration-state',{detail:{cueId,status:'playing'}}));
+        dispatchEvent(new CustomEvent('mira-narration-state',{detail:{cueId,status:'ready'}}));
+      });return true;};
+    </script>`;
+    const revised = patchCustomActivityCheckpointAdapters(html);
+    expect(revised).not.toBe(html);
+    const isolated = revised.replace(/<script\b[^>]*\bid=["']mira-pre-recorded-audio["'][^>]*>[\s\S]*?<\/script\s*>/i, media);
+    await page.setContent('<iframe id="game" sandbox="allow-scripts" style="width:1100px;height:800px;border:0"></iframe>');
+    await page.locator('#game').evaluate((node, content) => { (node as HTMLIFrameElement).srcdoc = content; }, isolated);
+    const frame = (await (await page.locator('#game').elementHandle())!.contentFrame())!;
+    await frame.waitForFunction(() => !!(window as unknown as ActivityWindow).miraActivityCheckpoint);
+    return frame;
+  }
+  const capture = (frame: Frame) => frame.evaluate(() => (window as unknown as ActivityWindow).miraActivityCheckpoint.capture());
+
+  it.each(discovery)('$course / $sceneTitle restores an actual action into fresh documents', async activity => {
+    const page = await browser.newPage({ viewport: { width: 1200, height: 900 } });
+    page.setDefaultTimeout(5000);
+    await page.route('**/*', route => route.abort());
+    try {
+      const html = readFileSync(activity.htmlPath, 'utf8');
+      let frame = await mount(page, html);
+      await frame.getByRole('button', { name: '听老师说', exact: true }).click();
+      await expect.poll(async () => (await capture(frame)).domain.admitted).toBe(true);
+      const initial = await capture(frame);
+      // A genuine child action through the frozen engine. Each mechanism has a
+      // different domain transition; no state mutation or input replay is used.
+      const name = activity.sceneTitle;
+      if (name.includes('找到要数')) await frame.locator('[data-object="pot"]').click();
+      else if (name.includes('数过的')) {
+        await frame.locator('[data-item="pot-0"]').click();
+        await frame.getByRole('button', { name: '放到数过的地方', exact: true }).first().click();
+      } else if (name.includes('窗户')) await frame.getByRole('button', { name: '向右移动', exact: true }).click();
+      else if (name.includes('指一层')) await frame.getByRole('button', { name: '上一层', exact: true }).click();
+      else if (name.includes('再数数')) await frame.locator('[data-item="cone-0"]').click();
+      else if (name.includes('放大镜')) await frame.getByRole('button', { name: '看看这个部位', exact: true }).first().click();
+      else if (name.includes('寻植')) {
+        await frame.getByRole('button', { name: '听下一个线索', exact: true }).click();
+        await frame.locator('[data-object="willow"]').click();
+      } else if (name.includes('画个圈')) {
+        await frame.locator('[data-object="grass"]').click();
+        await frame.getByRole('button', { name: '圈住选中的图片', exact: true }).click();
+      } else if (name.includes('翻翻看')) await frame.locator('[data-card="0"]').click();
