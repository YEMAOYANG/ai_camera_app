+type Activity = { sceneId: string; sceneTitle: string; htmlPath: string; nativeJourney?: boolean };
+type Inventory = { courses: { title: string; activities: Activity[] }[] };
+type Checkpoint = { schemaVersion: string; domain: Record<string, unknown>; replayCue: number | null };
