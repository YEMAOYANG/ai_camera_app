+function formalContract(profile: FormalProfile, signature: string): string {
+  return `\n/* mira-activity-checkpoint-adapter:formal:v1 */\n${profile.init}\n(function(){
+    ${CHECKPOINT_VALUE_CODEC}
+    const checkpointSchema=${JSON.stringify('mira.activity-checkpoint.formal.' + signature + '.v1')};
+    const checkpointInteger=(value,min,max)=>Number.isSafeInteger(value)&&value>=min&&value<=max;
+    const checkpointPermutation=(value,allowed)=>Array.isArray(value)&&value.length===allowed.length
+      &&new Set(value).size===value.length&&value.every(item=>allowed.includes(item));
+    const readDomain=()=>${profile.read};
+    const writeDomain=values=>{${profile.write}};
+    const renderDomain=values=>{${profile.render}};
+    const prepareRestore=()=>{${profile.prepare}};
+    const initialDomain=checkpointDecode(checkpointEncode(readDomain()));
+    const initialKeys=Object.keys(initialDomain);
+    const knownIds=new Set(Array.from(document.querySelectorAll('[id]'),node=>node.id));
+    const skipped=new Set(${JSON.stringify(profile.skip)});
+    const textIds=new Set(${JSON.stringify(profile.text)});
+    const styleNames=['display','opacity','visibility','transform','color','background-color','border-color','pointer-events'];
+    function selectorFor(node){
+      const parts=[];let current=node;
+      while(current&&!current.id&&current!==document.body){
+        const parent=current.parentElement;if(!parent)return null;
+        parts.unshift(Array.from(parent.children).indexOf(current)+1);current=parent;
+      }
+      if(!current||!current.id||!knownIds.has(current.id)||skipped.has(current.id))return null;
+      return [current.id,parts];
+    }
+    function findNode(id,path){
+      let node=document.getElementById(id);
+      for(const index of path){if(!node)return null;node=node.children[index-1];}
+      return node;
+    }
+    function captureView(){
+      const result=[],seen=new Set();
+      for(const node of document.querySelectorAll('[id],button,input,select,textarea')){
+        if(['SCRIPT','STYLE','META','LINK','IMG','AUDIO','VIDEO','SOURCE','CANVAS','SVG'].includes(node.tagName)
+          ||!document.body.contains(node)||skipped.has(node.id))continue;
+        const selector=selectorFor(node);if(!selector)continue;
+        const key=JSON.stringify(selector);if(seen.has(key))continue;seen.add(key);
+        const text=(node.childElementCount===0||textIds.has(node.id)&&!node.querySelector('[id],button,input,select,textarea,svg,canvas'))?(node.textContent||'').slice(0,1500):null;
+        const styles=styleNames.flatMap(name=>{const value=node.style?.getPropertyValue(name);return value?[[name,value]]:[];});
+        result.push([selector[0],selector[1],node.getAttribute('class')||'',!!node.hidden,
+          typeof node.disabled==='boolean'?node.disabled:null,node.getAttribute('aria-pressed'),
+          ['INPUT','SELECT','TEXTAREA'].includes(node.tagName)?node.value:null,text,styles]);
+      }
+      return result;
+    }
+    function validView(view){
+      if(!Array.isArray(view)||view.length>256)return false;
+      const seen=new Set();
+      return view.every(row=>{
+        if(!Array.isArray(row)||row.length!==9||!knownIds.has(row[0])||skipped.has(row[0])
+          ||!Array.isArray(row[1])||row[1].length>12||!row[1].every(x=>checkpointInteger(x,1,256))
+          ||typeof row[2]!=='string'||row[2].length>300||typeof row[3]!=='boolean'
+          ||!(row[4]===null||typeof row[4]==='boolean')||![null,'true','false','mixed'].includes(row[5])
+          ||!(row[6]===null||typeof row[6]==='string'&&row[6].length<128)
+          ||!(row[7]===null||typeof row[7]==='string'&&row[7].length<=1500)
+          ||!Array.isArray(row[8])||row[8].length>styleNames.length
+          ||!row[8].every(pair=>Array.isArray(pair)&&pair.length===2&&styleNames.includes(pair[0])
+            &&typeof pair[1]==='string'&&pair[1].length<180&&!/url|expression|[<>]/i.test(pair[1])))return false;
+        const key=JSON.stringify([row[0],row[1]]);if(seen.has(key))return false;seen.add(key);
+        const node=findNode(row[0],row[1]);
+        return !!node&&document.body.contains(node)&&!['SCRIPT','STYLE','IMG','AUDIO','VIDEO','SOURCE','CANVAS','SVG'].includes(node.tagName);
+      });
+    }
+    function applyView(view){
+      for(const [id,path,classes,hidden,disabled,pressed,value,text,styles]of view){
