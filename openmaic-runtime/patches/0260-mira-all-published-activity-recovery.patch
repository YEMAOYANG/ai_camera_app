+export function patchReviewedCustomProfiles(html: string): string {
+  if (html.includes('window.miraActivityCheckpoint')) return html;
+  for (const script of html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)) {
+    if (/\bsrc\s*=/.test(script[1])) continue;
+    const profile = REVIEWED_PROFILES.find(item => item.signature === programSignature(script[2]));
+    if (!profile) continue;
+    const index = script[2].lastIndexOf(profile.anchor);
+    if (index < 0) continue;
+    const contract = `\n/* mira-activity-checkpoint-adapter:reviewed-profile:v1 */\n(function(){
+      ${PROFILE_CHECKPOINT_RUNTIME}
+      ${profile.setup ?? ''}
+      installCheckpointProfile({schema:${JSON.stringify('mira.activity-checkpoint.profile.' + profile.signature + '.v1')},
+        archive:${profile.archive===true},
+        ids:${JSON.stringify(profile.ids)},read:()=>${profile.read},write:values=>{${profile.write}},
+        cancel:()=>{${profile.cancel}},render:()=>{${profile.render}},validate:values=>{${profile.validate}},
+        ${profile.begin ? `begin:()=>{${profile.begin}},` : ''}
+        ${profile.after ? `after:values=>{${profile.after}},` : ''}
+        ${profile.stable ? `stable:narrationIdle=>(${profile.stable}),` : ''}
+        ${profile.quiet ? `quiet:value=>{${profile.quiet}},` : ''}
+      });
+    })();\n`;
+    const source = script[2].slice(0, index) + contract + script[2].slice(index);
+    return html.slice(0, script.index) + script[0].replace(script[2], () => source)
+      + html.slice(script.index! + script[0].length);
+  }
+  return html;
+}
