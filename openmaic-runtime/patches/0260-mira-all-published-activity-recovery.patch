+/** One reviewed engine powers ten released mathematics/science activities.
+ * Its state includes accepted objects, matching pairs, the current route,
+ * observation card and geometric placement. Audio tickets/pointer captures are
+ * deliberately cancelled rather than represented as completed playback. */
+export const DISCOVERY_CHECKPOINT_CONTRACT = String.raw`
+/* mira-activity-checkpoint-adapter:discovery:v1 */
+(function () {
+  ${CHECKPOINT_VALUE_CODEC}
+  const schemaVersion='mira.activity-checkpoint.discovery.v1';
+  const fields=['admitted','done','heard','accepted','selected','round','phase','flipped','matched',
+    'floor','route','layout','plant','detail','stamped','position','answer'];
+  // This author's route is a visual trail, never undo or assessment evidence.
+  // Keep recent positions and the exact total while children continue walking.
+  const checkpointRouteLimit=256;
+  let checkpointRouteReference=state.route,checkpointWritingRoute=false;
+  if(!Object.hasOwn(state,'routeOmittedSteps'))state.routeOmittedSteps=0;
+  function checkpointBoundRoute(){
+    if(state.route!==checkpointRouteReference&&!checkpointWritingRoute)state.routeOmittedSteps=0;
+    checkpointRouteReference=state.route;
+    if(state.route.length>checkpointRouteLimit){
+      const removed=state.route.length-checkpointRouteLimit;
+      state.route.splice(0,removed);state.routeOmittedSteps+=removed;
+    }
+  }
+  const checkpointOriginalRender=render;
+  render=function(...args){
+    checkpointBoundRoute();const result=checkpointOriginalRender(...args);
+    const trail=document.querySelector('.step-dots');
+    if(trail){
+      const steps=state.routeOmittedSteps+state.route.length-1;
+      const text='已移动'+steps+'步，显示最近'+state.route.length+'个楼层位置';
+      trail.setAttribute('aria-label',text);trail.dataset.totalSteps=String(steps);
+      const summary=document.createElement('span');summary.className='route-summary';
+      summary.textContent='已移动'+steps+'步';trail.before(summary);
+    }
+    return result;
+  };
+  let replayCue=null;
+  const originalSpeak=speak;
+  speak=function(index,commit){replayCue=index;return originalSpeak(index,commit);};
+  const originalGate=renderGate;
+  renderGate=function(value){
+    originalGate(value);
+    const replay=document.querySelector('#replay');
+    if(replay&&replayCue!==null&&!value.busy){
+      replay.disabled=false;
+      replay.onclick=()=>narrationGate.request(PAGE.cues[replayCue].id,{end:()=>render()});
+    }
+  };
+  const unique=(value,allowed)=>Array.isArray(value)&&value.length<=128
+    &&new Set(value).size===value.length&&value.every(x=>allowed.includes(x));
+  const integer=(v,min,max)=>Number.isInteger(v)&&v>=min&&v<=max;
+  function valid(value){
+    if(!checkpointExact(value,['schemaVersion','domain','replayCue'])||value.schemaVersion!==schemaVersion
+      ||!(value.replayCue===null||integer(value.replayCue,0,PAGE.cues.length-1)))return false;
+    const s=value.domain;
+    if(!checkpointPlain(s)||!fields.every(key=>Object.hasOwn(s,key))
+      ||Object.keys(s).some(key=>!fields.includes(key)&&!['lens','routeOmittedSteps'].includes(key)))return false;
+    const assets=Object.keys(PAGE.assets),objects=[...assets,'flower','leaf',...Array.from({length:5},(_,i)=>'cone-'+i),
+      ...Array.from({length:4},(_,i)=>'pot-'+i)];
+    if(!['admitted','done','stamped'].every(key=>typeof s[key]==='boolean')
+      ||!unique(s.heard,PAGE.cues.map(c=>c.id))||!unique(s.accepted,objects)
+      ||!(s.selected===null||objects.includes(s.selected))
