+export function patchCustomActivityCheckpointAdapters(html: string): string {
+  if (html.includes('window.miraActivityCheckpoint')) return html;
+  const profiled = patchReviewedCustomProfiles(html);
+  if (profiled !== html) return profiled;
+  const scripts = [...html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)]
+    .filter(match => !/\b(?:src|type)\s*=/.test(match[1]));
+  for (const script of scripts) {
+    if (signature(script[2]) !== '28606:f2f1f8d6:6d00a5ca') continue;
+    const content = script[2] + DISCOVERY_CHECKPOINT_CONTRACT;
+    return html.slice(0, script.index) + script[0].replace(script[2], () => content)
+      + html.slice(script.index! + script[0].length);
+  }
+  return html;
