+  let settled=readSnapshot();
+  function rememberSettled(){if(typeof profile.stable!=='function'||profile.stable(pendingNarration===null))settled=readSnapshot();}
+  window.addEventListener('mira-narration-state',event=>{
+    const d=event.detail||{};
+    if(d.status==='hidden'||d.cueId===pendingNarration&&['ready','error','missing','cancelled'].includes(d.status))pendingNarration=null;
+    queueMicrotask(()=>queueMicrotask(rememberSettled));
+  });
+  const capture=()=>{rememberSettled();return JSON.parse(JSON.stringify(settled));};
+  const restore=snapshot=>{
+    try{
+      if(!checkpointExact(snapshot,['schemaVersion','bindings','view'])||snapshot.schemaVersion!==profile.schema||!validView(snapshot.view))return false;
+      const values=decodeDomain(snapshot.bindings);if(!validDomain(values))return false;
+      const previous=copyDomain(profile.read()),previousView=view();
+      const originalNarrate=window.miraNarrate;
+      try{
+        if(typeof window.miraCancelNarration==='function')window.miraCancelNarration();
+        profile.cancel();
+        pendingNarration=null;
+        window.miraNarrate=()=>false;
+        profile.write(values);profile.render();profile.write(values);applyView(snapshot.view);
+        profile.after?.(values);
+        restored=true;quietAfterRestore=true;profile.quiet?.(true);settled=JSON.parse(JSON.stringify(snapshot));
+        return true;
+      }catch(_){
+        try{profile.write(previous);profile.render();profile.write(previous);applyView(previousView);profile.after?.(previous);}catch(_){}
+        return false;
+      }finally{window.miraNarrate=originalNarrate;}
+    }catch(_){return false;}
+  };
+  window.miraActivityCheckpoint=Object.freeze({version:1,capture,restore,
+    begin(){if(restored||begun||typeof profile.begin!=='function')return false;begun=true;quietAfterRestore=false;profile.quiet?.(false);profile.begin();return true;}
+  });
+}
+`;
