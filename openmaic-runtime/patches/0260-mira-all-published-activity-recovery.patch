+      const html=documents.get(key);
+      const content=html?'<html><body style="margin:0"><iframe sandbox="allow-scripts allow-forms" style="width:1200px;height:900px;border:0" srcdoc="'
+        +html.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;')+'"></iframe></body></html>':'<p>Course directory</p>';
+      response.writeHead(200,{'content-type':'text/html; charset=utf-8','cache-control':'no-store'});response.end(content);
+    });
