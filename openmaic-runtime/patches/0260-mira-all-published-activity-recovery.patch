+      expect(JSON.stringify(saved).length).toBeLessThan(60*1024);
+      await page.reload();frame=await frameFor(page);
+      await restore(frame,saved);expect(await capture(frame)).toEqual(saved);
+      await page.goto(origin+'/directory');await page.goto(url);frame=await frameFor(page);
+      await restore(frame,saved);expect(await capture(frame)).toEqual(saved);
+      if(item.title==='3D分块塔：拼出目标分数')expect((saved.bindings as {selectedCube:number}).selectedCube).toBe(1);
