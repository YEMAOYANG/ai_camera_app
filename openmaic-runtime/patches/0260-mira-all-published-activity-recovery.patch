+export function patchCommonActivityCheckpointAdapters(html: string): string {
+  if (html.includes('window.miraActivityCheckpoint')) return html;
+  // This frozen historical page labels its first, actual bird picture as grass
+  // three times. Its config still correctly requests bird/grass/boat, so the
+  // original initial render dereferences a missing option-bird. Preserve all
+  // image, question, narration and answer bytes; repair only that exact element.
+  const mislabeledBird = '<button type="button" id="option-grass" data-mira-picture-choice="grass" aria-label="鸟的翅膀和长尾" data-option="grass">';
+  if (programSignature(html) === '23410:75c367e5:e1d6f0d9'
+      && html.split(mislabeledBird).length === 2) {
+    html = html.replace(mislabeledBird, '<button type="button" id="option-bird" data-mira-picture-choice="bird" aria-label="鸟的翅膀和长尾" data-option="bird">');
+  }
+  const scripts = [...html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)]
+    .filter(match => !/\bsrc\s*=/.test(match[1]) && (!/\btype\s*=/.test(match[1]) || /\btype\s*=\s*["']module["']/.test(match[1])) && match[2].includes("const root=document.getElementById('activity-root'), note=document.getElementById('student-note')"));
+  if (scripts.length !== 1) return html;
+  const script = scripts[0], signature = programSignature(script[2]);
+  const profile = COMMON_PROFILES[REVIEWED_COMMON_PROGRAMS[signature]];
+  if (!profile) return html;
+  const content = script[2] + commonContract(profile, signature);
+  return html.slice(0, script.index) + script[0].replace(script[2], () => content) + html.slice(script.index! + script[0].length);
+}
+
+function commonContract(profile: CommonProfile, signature: string): string {
+  const read = `({${profile.fields.join(',')}})`;
+  const write = profile.fields.map(name => profile.constants.includes(name)
+    ? `if (${name} instanceof Set) {${name}.clear(); for (const item of values.${name}) ${name}.add(item);}
+       else if (${name} instanceof Map) {${name}.clear(); for (const pair of values.${name}) ${name}.set(pair[0],pair[1]);}
+       else {for(const key of Object.keys(${name})) delete ${name}[key]; Object.assign(${name},values.${name});}`
+    : `${name}=values.${name};`).join('\n');
+  return `\n/* mira-activity-checkpoint-adapter:common:v1 */\n(function(){
+    ${CHECKPOINT_VALUE_CODEC}
+    const checkpointSchema=${JSON.stringify('mira.activity-checkpoint.common.' + signature + '.v1')};
+    const readDomain=()=>${read};
+    const writeDomain=values=>{${write}};
+    const renderDomain=()=>{${profile.render}};
+    const initialDomain=checkpointDecode(checkpointEncode(readDomain()));
+    const initialKinds=Object.fromEntries(Object.entries(initialDomain).map(([key,value])=>[key,
+      value instanceof Set?'set':value instanceof Map?'map':Array.isArray(value)?'array':value===null?'nullable':typeof value]));
+    const flags=['selected','armed','paired','wrong-pair','wrong-picture','done','teacher-hint'];
+    const knownIds=new Set(Array.from(document.querySelectorAll('[id]'),node=>node.id));
+    const initialView=new Map(Array.from(document.querySelectorAll('[id]'),node=>[node.id,
+      [!!node.hidden,...flags.map(flag=>node.classList.contains(flag))]]));
+    let lastChoice=null, choiceRound=null, pendingVideoTime=null;
+    if(typeof choose==='function') {
+      const originalChoose=choose;
+      choose=function(key,...args){const before=operation,result=originalChoose(key,...args);
+        if(operation!==before){lastChoice=key;choiceRound=typeof round==='number'?round:null;}return result;};
+    }
+    function captureView(){
+      const view=[];
+      for(const [id,baseline] of initialView){const node=document.getElementById(id);if(!node)continue;
+        const state=[!!node.hidden,...flags.map(flag=>node.classList.contains(flag))];
+        if(state.some((value,index)=>value!==baseline[index]))view.push([id,...state]);}
+      const notes=['teacher-note','student-note','observation-help'].flatMap(id=>{
+        const node=document.getElementById(id);return node?[[id,(node.textContent||'').slice(0,500)]]:[];});
+      return {flags:view,notes,lastChoice:choiceRound===(typeof round==='number'?round:null)?lastChoice:null,
+        videoTime:typeof video!=='undefined'&&video instanceof HTMLVideoElement?pendingVideoTime??video.currentTime:null};
+    }
+    function validView(view){
+      if(!checkpointExact(view,['flags','notes','lastChoice','videoTime'])||!Array.isArray(view.flags)||view.flags.length>512
+        ||!Array.isArray(view.notes)||view.notes.length>3
+        ||!(view.lastChoice===null||typeof view.lastChoice==='string'||typeof view.lastChoice==='number')
+        ||!(view.videoTime===null||Number.isFinite(view.videoTime)&&view.videoTime>=0&&view.videoTime<=86400))return false;
+      if(new Set(view.flags.map(row=>row[0])).size!==view.flags.length||new Set(view.notes.map(row=>row[0])).size!==view.notes.length)return false;
+      return view.flags.every(row=>Array.isArray(row)&&row.length===flags.length+2&&knownIds.has(row[0])&&row.slice(1).every(value=>typeof value==='boolean'))
+        &&view.notes.every(row=>Array.isArray(row)&&row.length===2&&['teacher-note','student-note','observation-help'].includes(row[0])&&typeof row[1]==='string'&&row[1].length<=500);
+    }
+    function applyView(view){
+      for(const [id,baseline] of initialView){const node=document.getElementById(id);if(!node)continue;
+        const row=view.flags.find(item=>item[0]===id);const values=row?row.slice(1):baseline;
+        node.hidden=values[0];flags.forEach((flag,index)=>node.classList.toggle(flag,values[index+1]));}
+      for(const [id,text]of view.notes){const node=document.getElementById(id);if(node)node.textContent=text;}
+      lastChoice=view.lastChoice;choiceRound=typeof round==='number'?round:null;
+      if(typeof video!=='undefined'&&video instanceof HTMLVideoElement&&view.videoTime!==null){
+        pendingVideoTime=view.videoTime;video.pause();const seek=()=>{try{video.currentTime=pendingVideoTime??view.videoTime;pendingVideoTime=null;}catch{}};
+        if(video.readyState>=1)seek();else video.addEventListener('loadedmetadata',seek,{once:true});}
+    }
+    function restoreMatching(view){
+      if(typeof matched==='boolean'&&matched&&typeof showPictureFeedback==='function'){
+        for(const row of view.flags){if(row[2]===true){const button=document.getElementById(row[0]);
+          if(button&&button.hasAttribute('data-dictionary-choice')&&!button.querySelector('.feedback-mark'))showPictureFeedback(button);}}
+      }
+      if(typeof round!=='number'||typeof config==='undefined'||!Array.isArray(config.rounds))return;
+      const current=config.rounds[round];
+      const key=typeof matched==='boolean'&&matched?current.targetAssetId:view.lastChoice;
+      if(key!==null&&!current.optionAssetIds.includes(key))throw new Error('checkpoint_choice');
+      if(typeof source!=='undefined'&&typeof pair!=='undefined'&&config.crops&&key!==null){
+        pair.innerHTML=config.crops[current.targetAssetId]+config.assets[key];
+        pair.className=matched?'pair paired':'pair wrong-pair';
+      }
+      if(typeof source!=='undefined'&&typeof detail!=='undefined'){
+        const row=view.flags.find(item=>item[0]===detail.id);
+        if(row&&row[1]===false)detail.innerHTML=source.innerHTML;
+      }
+      if(typeof matched==='boolean'&&matched){
+        const button=document.querySelector('[data-answer="'+CSS.escape(current.targetAssetId)+'"]')
+          ||document.querySelector('[data-option="'+CSS.escape(current.targetAssetId)+'"]');
+        const target=typeof pair!=='undefined'?pair:button;
+        if(target&&!target.querySelector('.feedback-mark'))target.insertAdjacentHTML('beforeend',
+          '<svg class="feedback-mark" viewBox="0 0 64 64" aria-label="图片已经配好"><circle cx="32" cy="32" r="28" fill="#588b79"/><path d="m16 32 11 11 22-24" fill="none" stroke="#fffdf5" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>');
+      }
+    }
+    function validDomain(values){
+      if(!checkpointExact(values,${JSON.stringify(profile.fields)}))return false;
+      for(const [key,kind]of Object.entries(initialKinds)){
+        const value=values[key];if(kind==='set'&&!(value instanceof Set)||kind==='map'&&!(value instanceof Map)
+          ||kind==='array'&&!Array.isArray(value)||!['set','map','array','nullable'].includes(kind)&&typeof value!==kind)return false;
+      }
+      if(values.lastCue!==null){const cues=JSON.parse(document.getElementById('mira-narration-cues').textContent).cues;
+        if(typeof values.lastCue!=='string'||!cues.some(cue=>cue.id===values.lastCue))return false;}
+      ${profile.validate}
+      return true;
+    }
+    const readSnapshot=()=>({schemaVersion:checkpointSchema,bindings:checkpointEncode(readDomain()),view:captureView()});
+    let settled=readSnapshot();
+    const rememberSettled=()=>{if(!interactionBusy)settled=readSnapshot();};
+    const originalSetBusy=setInteractionBusy;
+    setInteractionBusy=function(...args){const result=originalSetBusy(...args);queueMicrotask(rememberSettled);return result;};
+    window.addEventListener('mira-narration-state',()=>queueMicrotask(()=>queueMicrotask(rememberSettled)));
+    window.miraActivityCheckpoint=Object.freeze({version:1,
+      capture(){rememberSettled();return JSON.parse(JSON.stringify(settled));},
+      restore(snapshot){
+        try{
+          if(!checkpointExact(snapshot,['schemaVersion','bindings','view'])||snapshot.schemaVersion!==checkpointSchema||!validView(snapshot.view))return false;
+          const values=checkpointDecode(snapshot.bindings);if(!validDomain(values))return false;
+          if(typeof round==='number'&&typeof config!=='undefined'&&Array.isArray(config.rounds)
+            &&snapshot.view.lastChoice!==null&&!config.rounds[values.round].optionAssetIds.includes(snapshot.view.lastChoice))return false;
+          const previous=checkpointDecode(checkpointEncode(readDomain())), previousView=captureView();
+          cancelOperation();if(typeof clearGhost==='function')clearGhost();if(typeof clearDragGhost==='function')clearDragGhost();
+          if(typeof clearDrag==='function')clearDrag();
+          try{writeDomain(values);renderDomain();writeDomain(values);restoreMatching(snapshot.view);applyView(snapshot.view);
+            if(typeof refreshControls==='function')refreshControls();settled=JSON.parse(JSON.stringify(snapshot));return true;}
+          catch(error){writeDomain(previous);renderDomain();writeDomain(previous);restoreMatching(previousView);applyView(previousView);refreshControls();return false;}
+        }catch(error){return false;}
+      }
+    });
+  })();\n`;
+}
