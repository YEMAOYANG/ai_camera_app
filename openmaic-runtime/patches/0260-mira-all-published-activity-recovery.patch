+  const position = profile.tail ? script[2].lastIndexOf(profile.tail) : script[2].length;
+  if (position < 0) return html;
+  const contract = `\n/* mira-activity-checkpoint-adapter:classroom-game:v1 */\n(function(){
+    ${PROFILE_CHECKPOINT_RUNTIME}
+    const integer=(value,min,max)=>Number.isSafeInteger(value)&&value>=min&&value<=max;
