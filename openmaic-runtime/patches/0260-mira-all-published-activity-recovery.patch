@@ -0,0 +1,173 @@
+import { describe, expect, it } from 'vitest';
+import { activityState } from '@/lib/mira/activity-checkpoint-client';
+import { DISCOVERY_CHECKPOINT_CONTRACT } from '@/lib/mira/activity-checkpoint-custom-adapters';
+import { CHECKPOINT_GREETING_BOUNDS } from '@/lib/mira/activity-checkpoint-custom-profiles';
+import { CHECKPOINT_VALUE_CODEC } from '@/lib/mira/activity-checkpoint-common-adapters';
+
+type Snapshot = {schemaVersion:string;domain:Record<string,unknown>;replayCue:number|null};
+type Trail = {aria:string;dataset:{totalSteps?:string};summary:string};
+type World = {
+  api:{capture():Snapshot;restore(value:unknown):boolean};
+  step(n:number):void;reset():void;render():void;trail():Trail;
+  state:Record<string,unknown>;cancelCount():number;
+};
+
+/** The DOM below represents only the author's decorative trail. Movement is
+ * the original finite-state transition after a completed narration callback;
+ * this suite never synthesizes listening evidence or a learning API event. */
+function world():World {
+  return new Function(`
+    const state={admitted:true,done:false,heard:[],accepted:[],selected:null,round:0,
+      phase:0,flipped:[],matched:[],floor:1,route:[1],layout:0,plant:null,detail:null,
+      stamped:false,position:{x:150,y:205,angle:0,shape:'rectangle'},answer:null};
+    const PAGE={cues:Array.from({length:4},(_,i)=>({id:'cue-'+i})),assets:{},options:[]};
+    const window={};let trail=null,cancels=0;
+    const document={
+      querySelector(selector){return selector==='.step-dots'?trail:null;},
+      createElement(){return {className:'',textContent:''};}
+    };
+    function render(){trail={aria:'',dataset:{},summary:'',
+      setAttribute(key,value){if(key==='aria-label')this.aria=value;},
+      before(node){this.summary=node.textContent;}};}
+    function renderGate(){}
+    function speak(index,commit){if(commit)commit();render();}
+    const narrationGate={cancel(){cancels++;},snapshot(){return {busy:false};},request(){throw Error('restore must stay quiet');}};
+    ${DISCOVERY_CHECKPOINT_CONTRACT}
+    return {api:window.miraActivityCheckpoint,state,render:()=>render(),trail:()=>trail,
+      cancelCount:()=>cancels,
+      step(n){const next=state.floor+n;if(next<1||next>3)return;
+        speak(3,()=>{state.floor=next;state.route.push(next);state.done=false;});},
+      reset(){speak(3,()=>{state.floor=1;state.route=[1];state.done=false;});}
+    };
+  `)() as World;
+}
+
+describe('decorative route capacity and exact progress',()=>{
+  it('keeps long legal walking loops under the client and backend JSON budgets',()=>{
+    const current=world();
+    for(let i=0;i<20_000;i++)current.step(i%2===0?1:-1);
+    const saved=current.api.capture();
+    expect(saved.domain.floor).toBe(1);
+    expect(saved.domain.route).toHaveLength(256);
+    expect(saved.domain.routeOmittedSteps).toBe(19_745);
+    expect(current.trail().dataset.totalSteps).toBe('20000');
+    expect(current.trail().aria).toContain('20000');
+    expect(current.trail().summary).toBe('已移动20000步');
+    expect(activityState(saved)).toEqual(saved);
+    expect(new TextEncoder().encode(JSON.stringify(saved)).length).toBeLessThan(4096);
+    let nodes=0;
+    const count=(v:unknown):void=>{nodes++;if(Array.isArray(v))v.forEach(count);
+      else if(v&&typeof v==='object')Object.values(v).forEach(count);};
+    count(saved);expect(nodes).toBeLessThan(512);
+  });
+
+  it('restores repeatedly without accumulating movements and resets only on a real new route',()=>{
+    const current=world();
+    for(let i=0;i<2100;i++)current.step(i%2===0?1:-1);
+    current.state.done=true;current.state.accepted=[];
+    const saved=current.api.capture();
+    const next=world();
+    for(let i=0;i<100;i++){
+      expect(next.api.restore(saved)).toBe(true);
+      expect(next.api.capture()).toEqual(saved);
+      expect(next.trail().dataset.totalSteps).toBe('2100');
+    }
+    expect(next.state.done).toBe(true);
+    expect(next.cancelCount()).toBe(100);
+    next.step(1);
+    expect(next.state.floor).toBe(2);
+    expect(next.trail().dataset.totalSteps).toBe('2101');
+    next.reset();
+    expect(next.api.capture().domain.routeOmittedSteps).toBe(0);
+    expect(next.api.capture().domain.route).toEqual([1]);
+    expect(next.trail().dataset.totalSteps).toBe('0');
+  });
+
+  it('reads a pre-compaction snapshot once and rejects invalid counters without changing work',()=>{
+    const current=world(),legacy=current.api.capture();
+    delete legacy.domain.routeOmittedSteps;
+    legacy.domain.route=Array.from({length:1001},(_,i)=>i%2===0?1:2);
+    expect(current.api.restore(legacy)).toBe(true);
+    const saved=current.api.capture();
+    expect(saved.domain.routeOmittedSteps).toBe(745);
+    expect(current.trail().dataset.totalSteps).toBe('1000');
+    expect(current.api.restore(saved)).toBe(true);
+    expect(current.api.capture()).toEqual(saved);
+    for(const count of [-1,1.5,Number.MAX_SAFE_INTEGER]){
+      const invalid=structuredClone(saved);invalid.domain.routeOmittedSteps=count;
+      expect(current.api.restore(invalid)).toBe(false);
+      expect(current.api.capture()).toEqual(saved);
+    }
+  });
+});
+
+describe('monotonic greeting callbacks and bounded undo',()=>{
+  it('retains old-ticket idempotence while long edit and replay loops remain portable',()=>{
+    const run=new Function(`
+      const committed=new Set(),appliedOperations=new Set(),history=[];
+      let model={x:.38,heading:1,lastMove:0},attemptSerial=0,operation=0,results=0;
+      function render(){}
+      ${CHECKPOINT_GREETING_BOUNDS}
+      ${CHECKPOINT_VALUE_CODEC}
+      function commit(id){if(committed.has(id))return;committed.add(id);results++;}
+      for(let i=0;i<10_000;i++){
+        history.push({...model});model={x:i%2?.12:.64,heading:i%2?1:-1,lastMove:i%2?-1:1};render();
+        commit(++attemptSerial);const op=++operation;if(!appliedOperations.has(op))appliedOperations.add(op);
+      }
