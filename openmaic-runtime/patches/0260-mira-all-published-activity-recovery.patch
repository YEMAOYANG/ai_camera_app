+        const before = await capture(frame);
+        expect(await frame.evaluate(value => (window as unknown as ActivityWindow).miraActivityCheckpoint.restore(value),
+          { ...saved, domain: { ...saved.domain, floor: 8 } })).toBe(false);
+        expect(await capture(frame)).toEqual(before);
+      }
+      // A restored replay remains a real playback request, with no synthetic
+      // completion or repeated accepted-object/answer mutation.
+      const beforeReplay = await capture(frame);
+      await frame.getByRole('button', { name: '重听', exact: true }).click();
+      await expect.poll(() => frame.evaluate(() => (window as unknown as ActivityWindow).checkpointNarrations.length)).toBe(1);
+      expect((await capture(frame)).domain).toEqual(beforeReplay.domain);
+    } finally { await page.close(); }
+  }, 20_000);
+});
