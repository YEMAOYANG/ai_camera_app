+function signature(source: string): string {
+  const text = source.replace(/(['"])(?:\/api\/classroom-media\/|data:(?:image|audio)\/|blob:)[^'"\r\n]*\1/g, '"MIRA_MEDIA"')
+    .replace(/\r\n/g, '\n').trim();
+  let a = 2166136261, b = 2246822507;
+  for (let i = 0; i < text.length; i++) {
+    a = Math.imul(a ^ text.charCodeAt(i), 16777619) >>> 0;
+    b = Math.imul(b ^ text.charCodeAt(i), 3266489917) >>> 0;
+  }
+  return `${text.length}:${a.toString(16)}:${b.toString(16)}`;
+}
