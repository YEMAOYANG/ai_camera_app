+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { chromium, type Browser, type Frame, type Page } from 'playwright-core';
+import { patchPinyinActivityCheckpointAdapters } from '@/lib/mira/activity-checkpoint-pinyin-adapters';
+
+type Json = Record<string, unknown>;
+type CheckpointWindow = Window & {
+  miraActivityCheckpoint: { version: number; begin(): boolean; capture(): Json; restore(value: unknown): boolean };
+  checkpointNarrations: string[];
+};
+type Inventory = { courses: { title: string; activities: { sceneTitle: string; htmlPath: string }[] }[] };
+
+describe('phonics compatibility boundary', () => {
+  it('keeps unsupported documents and foreign checkpoint contracts intact', () => {
+    for (const html of ['', '<button>开始</button>', '<script>let round=0;function render(){}</script>',
+      '<script>window.miraActivityCheckpoint={version:2}</script>']) {
+      expect(patchPinyinActivityCheckpointAdapters(html)).toBe(html);
+    }
+  });
+});
+
+/** Reuse immutable, already archived originals; never make a media/provider call.
+ * The optional live inventory is produced by the existing release audit. */
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== '1' || !process.env.MIRA_ACTIVE_GAME_INVENTORY_PATH)(
+  'reviewed phonics progress in real sandboxed documents', () => {
+    let browser: Browser;
+    let originals: { course: string; title: string; html: string }[];
+    beforeAll(async () => {
+      const inventory = JSON.parse(readFileSync(process.env.MIRA_ACTIVE_GAME_INVENTORY_PATH!, 'utf8')) as Inventory;
+      const unique = new Map<string, { course: string; title: string; html: string }>();
+      for (const course of inventory.courses) for (const activity of course.activities) {
+        const html = readFileSync(activity.htmlPath, 'utf8');
+        const revised = patchPinyinActivityCheckpointAdapters(html);
+        if (revised === html) continue;
+        const signature = revised.match(/mira\.activity-checkpoint\.pinyin\.([^"']+)\.v1/)?.[1];
+        if (!signature) throw new Error('Missing reviewed program signature');
+        // One program may read different page-data modes (picture, letter,
+        // expression, book). Exercise every immutable document, not one mode.
+        unique.set(activity.htmlPath, { course: course.title, title: activity.sceneTitle, html });
+      }
+      originals = [...unique.values()];
+      expect(originals.length).toBeGreaterThan(100);
+      if (process.env.MIRA_CHECKPOINT_CASE_PATTERN) {
+        const pattern = new RegExp(process.env.MIRA_CHECKPOINT_CASE_PATTERN);
+        originals = originals.filter(original => pattern.test(original.title));
+      }
+      if (process.env.MIRA_CHECKPOINT_CASE_LIMIT) originals = originals.slice(0, Number(process.env.MIRA_CHECKPOINT_CASE_LIMIT));
+      browser = await chromium.launch({ executablePath: process.env.MIRA_FORMAL_QA_BROWSER_PATH ||
+        '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', headless: true,
+        args: ['--disk-cache-size=1048576', '--media-cache-size=1048576'] });
+    }, 45000);
+    afterAll(async () => { await browser?.close(); }, 30000);
+
+    async function documentFrame(page: Page, html: string): Promise<Frame> {
+      const scaffold = `<script>
+        window.checkpointNarrations=[];Math.random=()=>0.05;
+        window.miraCancelNarration=()=>{};
+        window.miraNarrate=cueId=>{checkpointNarrations.push(cueId);setTimeout(()=>{
+          dispatchEvent(new CustomEvent('mira-narration-state',{detail:{cueId,status:'playing'}}));
+          setTimeout(()=>dispatchEvent(new CustomEvent('mira-narration-state',{detail:{cueId,status:'ready'}})),2);
+        },0);return true;};
+      </script>`;
+      const patched = patchPinyinActivityCheckpointAdapters(html).replace(
+        /<script\b[^>]*\bid=["']mira-pre-recorded-audio["'][^>]*>[\s\S]*?<\/script\s*>/i, scaffold);
+      await page.setContent('<style>body{margin:0}iframe{width:1100px;height:820px;border:0}</style>');
+      await page.evaluate(content => {
+        const frame = document.createElement('iframe'); frame.sandbox.add('allow-scripts');
+        frame.srcdoc = content; document.body.appendChild(frame);
+      }, patched);
+      const frame = (await (await page.locator('iframe').elementHandle())!.contentFrame())!;
+      await frame.waitForFunction(() => !!(window as unknown as CheckpointWindow).miraActivityCheckpoint);
+      await page.evaluate(() => {
+        const frame = document.querySelector('iframe')!;
+        frame.contentWindow!.postMessage({ type: 'MIRA_NARRATION_VISIBILITY', visible: true }, '*');
+      });
+      return frame;
+    }
+
+    it('round trips every reviewed program through fresh and reentered documents without audio or new evidence', async () => {
+      const page = await browser.newPage({ viewport: { width: 1200, height: 900 } });
+      page.setDefaultTimeout(5000);
+      await page.route('**/*', route => route.abort());
