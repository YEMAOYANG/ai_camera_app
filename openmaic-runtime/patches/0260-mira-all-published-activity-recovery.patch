+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { patchActivityCheckpointAdapters } from '@/lib/mira/activity-checkpoint-adapters';
+
+const inventoryPath = process.env.MIRA_ACTIVITY_CHECKPOINT_INVENTORY;
+type Activity = { sceneId:string; sceneTitle:string; htmlPath:string; htmlSha256:string; nativeJourney?:boolean };
+type Inventory = {courses:{title:string;scope:string;activities:Activity[]}[]};
+
+/** Operator-supplied inventory contains immutable published HTML read from the
+ * current authority. No private course fixture or media copy enters the repo. */
+describe.skipIf(!inventoryPath)('all currently reachable published activity programs',()=>{
+  it('accounts for every HTML scene and preserves the immutable source digest',()=>{
+    const inventory:Inventory=JSON.parse(readFileSync(inventoryPath!,'utf8'));
+    const missing:string[]=[];
+    let native=0,adapted=0;
+    for(const course of inventory.courses)for(const activity of course.activities){
+      const html=readFileSync(activity.htmlPath,'utf8');
+      expect(createHash('sha256').update(html).digest('hex')).toBe(activity.htmlSha256);
+      if(activity.nativeJourney){native++;continue;}
+      const patched=patchActivityCheckpointAdapters(html);
+      if(patched===html)missing.push(`${course.scope} / ${course.title} / ${activity.sceneTitle} / ${activity.htmlSha256}`);
+      else {adapted++;expect(patchActivityCheckpointAdapters(patched)).toBe(patched);}
+    }
+    console.info({versions:inventory.courses.length,adapted,native,missing:missing.length});
+    expect(missing).toEqual([]);
+  },120_000);
+});
