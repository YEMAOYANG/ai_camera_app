+      };
+      async function begin(frame: Frame) {
+        for (const selector of ['#start', '#begin', '#route-start', '#start-btn']) {
+          const control = frame.locator(selector);
+          if (await control.count() && await control.isVisible() && await control.isEnabled()) { await control.click();
+            await expect.poll(() => control.isEnabled(), { timeout: 8000 }).toBe(true); await settle(frame); break; }
+        }
+      }
+      async function act(frame: Frame, before: Snapshot) {
+        const controls = frame.locator('button,[role="button"],input[type="range"]');
+        for (let index = 0; index < await controls.count(); index++) {
+          const control = controls.nth(index);
+          const label = await control.evaluate(node => [node.id, node.getAttribute('aria-label') || '', node.textContent || ''].join(' '));
+          if (/start|begin|replay|reset|retry|hint|help|重听|再听|重来|清空|重新|重置|提示|示范|撤销|开始|播放老师/i.test(label)
+            || !await control.isVisible() || !await control.isEnabled()) continue;
+          if (await control.getAttribute('type') === 'range') await control.press('ArrowRight'); else await control.click();
+          await settle(frame);
+          const saved = await capture(frame);
+          if (JSON.stringify(saved.bindings) !== JSON.stringify(before.bindings)) return saved;
+        }
+        // Model manipulation uses the authored pointer handlers, never a field write.
+        for (const canvas of await frame.locator('canvas').all()) {
+          const box = await canvas.boundingBox(); if (!box || box.width < 20 || box.height < 20) continue;
+          await page.mouse.move(box.x + box.width * .5, box.y + box.height * .55); await page.mouse.down();
+          await page.mouse.move(box.x + box.width * .65, box.y + box.height * .6, { steps: 8 }); await page.mouse.up(); await settle(frame);
+          const saved = await capture(frame); if (JSON.stringify(saved.bindings) !== JSON.stringify(before.bindings)) return saved;
+        }
+        throw new Error('no non-start authored domain transition: ' + JSON.stringify(before.bindings));
+      }
+      try {
+        for (const [profile, entry] of representatives) {
+          try {
+            let frame = await createFrame(page, entry.html); await begin(frame);
+            const saved = await act(frame, await capture(frame));
+            for (let reload = 0; reload < 2; reload++) {
+              frame = await createFrame(page, entry.html);
+              expect(await restore(frame, saved)).toBe(true); expect(await capture(frame)).toEqual(saved);
+              expect(await frame.evaluate(() => (window as unknown as CheckpointWindow).checkpointNarrations)).toEqual([]);
+            }
+            const next = await act(frame, saved);
+            expect(next.bindings).not.toEqual(saved.bindings);
+          } catch (error) { failures.push(`profile ${profile} ${entry.activity.sceneTitle}: ${String(error)}`); }
+        }
+      } finally { await page.close(); }
+      expect(failures).toEqual([]);
+    }, 180_000);
+
+    it('keeps a real matched round and feedback across fresh documents without replay or duplicate credit', async () => {
+      const entry = activities.find(({ html }) => html.includes('let round=0,started=false,matched=false,feedbackReady=false')
+        && html.includes('[data-answer]'))!;
+      const page = await newPage();
+      try {
+        let frame = await createFrame(page, entry.html);
+        await frame.locator('#start').click();
+        await expect.poll(async () => (await capture(frame)).bindings.started).toBe(true);
+        await expect.poll(() => frame.locator('[data-answer]').first().isEnabled()).toBe(true);
+        // Each actual option is clicked until the authored model confirms a match.
+        for (const answer of await frame.locator('[data-answer]').all()) {
+          if ((await capture(frame)).bindings.matched === true) break;
+          if (await answer.isVisible()) { await answer.click(); await expect.poll(() => answer.isEnabled()).toBe(true).catch(() => undefined); }
+        }
+        await expect.poll(async () => (await capture(frame)).bindings.feedbackReady).toBe(true);
+        const saved = await capture(frame);
+        frame = await createFrame(page, entry.html);
+        expect(await restore(frame, saved)).toBe(true);
+        expect(await capture(frame)).toEqual(saved);
+        expect(await frame.locator('#next').isEnabled()).toBe(true);
+        expect(await frame.evaluate(() => (window as unknown as CheckpointWindow).checkpointNarrations)).toEqual([]);
+        await frame.locator('#next').click();
+        await expect.poll(async () => (await capture(frame)).bindings.round).toBe(1);
+      } finally { await page.close(); }
+    }, 20_000);
+
+    it('repairs only the exact frozen bird element that previously crashed initial rendering, then restores actual play', async () => {
+      const entry = activities.find(({ activity }) => activity.sceneId === '0b3ba8b05c_game')!;
+      expect(entry).toBeDefined();
+      const corrected = patchCommonActivityCheckpointAdapters(entry.html);
+      expect(entry.html.match(/id="option-grass"/g)).toHaveLength(2);
+      expect(corrected.match(/id="option-grass"/g)).toHaveLength(1);
+      expect(corrected).toContain('id="option-bird" data-mira-picture-choice="bird" aria-label="鸟的翅膀和长尾" data-option="bird"');
+      const page = await newPage();
