+import { describe,expect,it } from 'vitest';
+import { runInNewContext } from 'node:vm';
+import { PROFILE_CHECKPOINT_RUNTIME } from '@/lib/mira/activity-checkpoint-profile';
+import { activityState } from '@/lib/mira/activity-checkpoint-client';
+
+type Runtime={capture():unknown;restore(value:unknown):boolean;read():unknown;edit():void};
+function fixture(customShape=false):Runtime{
+  const code=`const listeners=new Map();
+    const window={addEventListener:(type,fn)=>listeners.set(type,fn),miraNarrate:()=>true};
+    const document={addEventListener:()=>{},getElementById:()=>null};
+    ${PROFILE_CHECKPOINT_RUNTIME}
+    let cards=[{kind:'picture',asset:'tree'},{kind:'token',value:'木'}];
+    installCheckpointProfile({schema:'typed-cards.v1',read:()=>({cards}),write:v=>{cards=v.cards},ids:[],
+      cancel:()=>{},render:()=>{},validate:()=>true,
+      ${customShape?`shape:values=>Array.isArray(values.cards)&&values.cards.length<=6&&values.cards.every(card=>
+        card.kind==='picture'?checkpointExact(card,['kind','asset'])&&['tree','river'].includes(card.asset)
+        :card.kind==='token'&&checkpointExact(card,['kind','value'])&&['木','水'].includes(card.value)),`:''}
+    });
+    ({capture:()=>window.miraActivityCheckpoint.capture(),restore:value=>window.miraActivityCheckpoint.restore(JSON.parse(value)),
+      read:()=>JSON.parse(JSON.stringify(cards)),edit:()=>{cards=[{kind:'token',value:'水'},{kind:'picture',asset:'river'}]}});`;
+  const runtime=runInNewContext(code,{queueMicrotask}) as Omit<Runtime,'restore'>&{restore(value:string):boolean};
+  return {...runtime,capture:()=>JSON.parse(JSON.stringify(runtime.capture())),
+    read:()=>JSON.parse(JSON.stringify(runtime.read())),restore:value=>runtime.restore(JSON.stringify(value))};
+}
+
+describe('explicit lexical checkpoint profiles',()=>{
+  it('uses the optional strict union schema for heterogeneous authored cards',()=>{
+    const original=fixture(true);original.edit();const saved=original.capture();
+    expect(()=>activityState(saved)).not.toThrow();
+    const fresh=fixture(true);expect(fresh.restore(saved)).toBe(true);
+    expect(fresh.read()).toEqual(original.read());
+    expect(fresh.capture()).toEqual(saved);
+    const invalid=JSON.parse(JSON.stringify(saved));invalid.bindings.cards[0].asset='unknown';
+    expect(fresh.restore(invalid)).toBe(false);
+    expect(fresh.capture()).toEqual(saved);
+  });
+  it('retains default structural rejection when no reviewed union schema exists',()=>{
+    const original=fixture();original.edit();const saved=original.capture();
+    const fresh=fixture();const before=fresh.capture();
+    expect(fresh.restore(saved)).toBe(false);
+    expect(fresh.capture()).toEqual(before);
+  });
+  it('rejects changed top-level binding identities even with an explicit schema',()=>{
+    const original=fixture(true);const saved=JSON.parse(JSON.stringify(original.capture()));
+    saved.bindings.other=[];
+    expect(original.restore(saved)).toBe(false);
+    expect(original.read()).toEqual([{kind:'picture',asset:'tree'},{kind:'token',value:'木'}]);
+  });
+});
