+    expect(formal).toHaveLength(CASES.length);
+    for(const item of CASES){
+      const activity=formal.find((a:{htmlSha256:string})=>a.htmlSha256===item.htmlSha256);
+      if(!activity)throw new Error('Reviewed formal source missing: '+item.title);
+      const html=readFileSync(activity.htmlPath,'utf8');
+      const patched=patchFormalActivityCheckpointAdapters(html);
+      expect(patched,item.title).not.toBe(html);
+      expect(patchFormalActivityCheckpointAdapters(patched)).toBe(patched);
+      expect(patchFormalActivityCheckpointAdapters(html+html)).toBe(html+html);
+      const source=inventory.scripts.find((s:{sha256:string})=>s.sha256===item.sourceSha256);
+      const script=readFileSync(source.path,'utf8');
+      expect(patchFormalActivityCheckpointAdapters(html.replace(script,script+'/* unreviewed source */'))).toBe(
+        html.replace(script,script+'/* unreviewed source */'));
+      const scaffold='<script>Math.random=()=>0.05;window.checkpointCalls=[];window.miraNarrate=(...args)=>{checkpointCalls.push(args);return true;};</script>';
+      documents.set(item.htmlSha256,patched.replace(/<head\b[^>]*>/i,match=>match+scaffold));
+    }
+    server=createServer((request,response)=>{
