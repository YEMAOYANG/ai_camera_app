+        await page.setContent('<iframe sandbox="allow-scripts" style="width:1100px;height:800px"></iframe>');
+        await page.locator('iframe').evaluate((node, content) => { (node as HTMLIFrameElement).srcdoc = content; }, entry.html);
+        await expect.poll(() => failures.some(message => message.includes('appendChild'))).toBe(true);
+        failures.length = 0;
+        let frame = await createFrame(page, entry.html);
+        await frame.locator('#start').click();
+        await expect.poll(() => frame.locator('#source').isEnabled()).toBe(true);
+        await frame.locator('#source').click(); await frame.locator('#option-bird').click();
+        await expect.poll(async () => (await capture(frame)).bindings.feedbackReady).toBe(true);
+        const saved = await capture(frame);
