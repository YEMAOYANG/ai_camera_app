+  for (let index = 0; index < value.length; index++) {
+    first = Math.imul(first ^ value.charCodeAt(index), 16777619) >>> 0;
+    second = Math.imul(second ^ value.charCodeAt(index), 3266489917) >>> 0;
+  }
+  return `${value.length}:${first.toString(16)}:${second.toString(16)}`;
