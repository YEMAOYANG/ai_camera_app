+  }
+  async function act(frame:Frame,actions:Action[]){
+    for(const action of actions){
+      if(typeof action==='string')await frame.locator(action).click();
+      else if(action.wait)await frame.waitForTimeout(action.wait);
+      else{const locator=action.text?frame.locator(action.selector!).filter({hasText:new RegExp('^'+action.text+'$')}):frame.locator(action.selector!);
+        if(action.press)await locator.press(action.press);else await locator.click();}
+    }
