+  capture(): Checkpoint; restore(value: unknown): boolean;
+}; checkpointNarrations: string[] };
+const inventoryPath = process.env.MIRA_ACTIVITY_CHECKPOINT_INVENTORY;
+const inventory: Inventory = inventoryPath ? JSON.parse(readFileSync(inventoryPath, 'utf8')) : { courses: [] };
+const discovery = inventory.courses.flatMap(course => course.activities.map(activity => ({ ...activity, course: course.title })))
+  .filter(activity => readFileSync(activity.htmlPath, 'utf8').includes('/* Actual course activity engine.'));
+
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== '1' || !inventoryPath)('reviewed discovery checkpoints', () => {
+  let browser: Browser;
+  beforeAll(async () => {
+    expect(discovery.length).toBeGreaterThan(0);
+    browser = await chromium.launch({ executablePath: process.env.MIRA_FORMAL_QA_BROWSER_PATH ||
+      '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', headless: true });
+  });
+  afterAll(async () => { await browser?.close(); });
+
+  async function mount(page: Page, html: string): Promise<Frame> {
+    const media = `<script id="mira-pre-recorded-audio">
+      window.checkpointNarrations=[];
+      window.miraCancelNarration=()=>true;
