+      try {
+        for (const original of originals) {
+          if (process.env.MIRA_CHECKPOINT_DIAGNOSTICS === '1') console.log('Checking', original.course, original.title);
+          try {
+            let frame = await documentFrame(page, original.html);
+            await frame.waitForTimeout(80);
+            const capture = () => frame.evaluate(() => (window as unknown as CheckpointWindow).miraActivityCheckpoint.capture());
+            await capture();
+            const start = frame.locator('#startBtn,#start,#start-btn,#btn-start,#btnStart,#beginBtn,#begin,#startButton').first();
+            if (await start.count() && await start.isVisible() && await start.isEnabled()) await start.click();
+            await frame.waitForTimeout(100);
+            const saved = await capture();
+            for (let entry = 0; entry < 2; entry++) {
+              frame = await documentFrame(page, original.html);
+              const result = await frame.evaluate(snapshot => {
+                const view = window as unknown as CheckpointWindow;
+                view.checkpointNarrations.length = 0;
+                return view.miraActivityCheckpoint.restore(snapshot);
+              }, saved);
+              expect(result, original.title).toBe(true);
+              await frame.waitForTimeout(12);
+              expect((await capture()).domain, original.title).toEqual(saved.domain);
+              expect(await frame.evaluate(() => (window as unknown as CheckpointWindow).checkpointNarrations), original.title).toEqual([]);
+              const before = await capture();
+              expect(await frame.evaluate(() => (window as unknown as CheckpointWindow).miraActivityCheckpoint.restore({ schemaVersion: 'foreign' }))).toBe(false);
+              expect((await capture()).domain).toEqual(before.domain);
+            }
+          } catch (error) {
+            const failure = `${original.course} / ${original.title}: ${error instanceof Error ? error.message : String(error)}`;
+            failures.push(failure);
+            if (process.env.MIRA_CHECKPOINT_DIAGNOSTICS === '1') console.error(failure);
+            if (failures.length >= 20) break;
+          }
+        }
+      } finally { await page.close(); }
+      expect(failures).toEqual([]);
+    }, 300000);
+  },
+);
