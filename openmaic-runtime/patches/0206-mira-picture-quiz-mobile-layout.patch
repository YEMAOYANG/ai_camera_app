diff --git a/components/scene-renderers/picture-quiz-layout.module.css b/components/scene-renderers/picture-quiz-layout.module.css
new file mode 100644
--- /dev/null
+++ b/components/scene-renderers/picture-quiz-layout.module.css
@@ -0,0 +1,65 @@
+/* The real QuizView keeps its narration, attempt persistence and grading.
+   Only two/three-image single-choice tasks opt into this measured viewport. */
+.root { container: picture-quiz / size; }
+
+@container picture-quiz (max-width: 560px) or (max-height: 400px) {
+  .root[data-quiz-phase="answering"] [data-quiz-answer-header] {
+    min-height: 56px;
+    padding: 4px 12px;
+  }
+  .root[data-quiz-phase="answering"] [data-quiz-question-scroll] {
+    padding: 6px;
+    min-height: 0;
+  }
+  .root [data-quiz-picture-card] { padding: 8px; }
+  .root [data-quiz-question-heading] { margin-bottom: 4px; }
+  .root [data-quiz-question-heading] p { display: none; }
+  .root [data-quiz-picture-card] > div:has(> button) { margin-bottom: 4px; }
+  .root [data-quiz-picture-card] > div > button[aria-label] { min-height: 48px; }
+  .root [data-quiz-scene-picture] {
+    height: clamp(56px, 17cqh, 120px);
+    margin-bottom: 6px;
+  }
+  .root [data-quiz-scene-picture] [data-quiz-visual],
+  .root [data-quiz-scene-picture] img {
+    height: 100%; width: 100%; max-height: 100%; object-fit: contain;
+  }
+  .root [data-quiz-option-group] > div {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 6px;
+  }
+  .root [data-quiz-option-group="2"] > div { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .root [data-quiz-option-group] button {
+    display: flex; flex-direction: column; justify-content: center;
+    width: 100%; min-width: 48px; min-height: 80px;
+    height: clamp(80px, 25cqh, 160px);
+    padding: 4px; gap: 0;
+  }
+  .root [data-quiz-option-group] button > [data-quiz-visual] {
+    flex: 1 1 0%; width: 100%; height: 100%; min-height: 0;
+  }
+  .root [data-quiz-option-group] img {
+    width: 100%; height: 100%; max-height: 100%; object-fit: contain;
+  }
+  /* Labels remain accessible but pictures carry the choice. */
+  .root [data-quiz-option-group] button > span:not([data-quiz-visual]) {
+    position: absolute; width: 1px; height: 1px; padding: 0;
+    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap;
+  }
+}
+
+@container picture-quiz (min-width: 561px) and (max-height: 400px) {
+  .root[data-quiz-phase="answering"] [data-quiz-picture-card] {
+    display: grid;
+    grid-template-columns: minmax(0, .85fr) minmax(0, 1.5fr);
+    column-gap: 12px;
+  }
+  .root [data-quiz-question-heading] { grid-column: 2; grid-row: 1; }
+  .root [data-quiz-picture-card] > div:has(> button) { grid-column: 2; grid-row: 2; }
+  .root [data-quiz-scene-picture] {
+    grid-column: 1; grid-row: 1 / 4;
+    align-self: center; height: clamp(80px, 55cqh, 200px);
+  }
+  .root [data-quiz-option-group] { grid-column: 2; grid-row: 3; }
+}
