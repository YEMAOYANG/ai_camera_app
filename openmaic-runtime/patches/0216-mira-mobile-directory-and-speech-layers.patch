+  }
+  html [data-mira-classroom-root] [data-mira-roundtable-layout='standard'] [data-mira-participant-avatar] {
+    width: 48px; min-width: 48px; height: 48px; scale: 1 !important; transform: none !important; scroll-snap-align: start;
