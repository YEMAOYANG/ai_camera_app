+@media (max-width: 640px), (max-width: 1024px) and (max-height: 500px) {
+  [data-mira-classroom-root] [data-mira-chrome='scene-sidebar'] {
+    position: absolute; inset-block: 0; left: 0; z-index: 70;
+  }
+  [data-mira-classroom-root] [data-mira-chrome='scene-sidebar'][data-mira-sidebar-collapsed='false'] {
+    width: min(280px, calc(100% - 16px)) !important;
+    box-shadow: 8px 0 24px rgb(0 0 0 / 18%);
+  }
+  [data-mira-classroom-root] [data-mira-chrome='scene-sidebar'][data-mira-sidebar-collapsed='true'] { visibility: hidden; pointer-events: none; }
