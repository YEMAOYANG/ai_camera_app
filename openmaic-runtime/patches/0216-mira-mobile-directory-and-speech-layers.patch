+   * and make focus scroll its overflow-hidden parent above the header. */
+  html [data-mira-classroom-root] [data-mira-roundtable-layout='standard'] [data-mira-discussion-rail='teacher'] > div { padding: 0; }
+  /* Native horizontal scrolling needs no arrows layered over classmates.
