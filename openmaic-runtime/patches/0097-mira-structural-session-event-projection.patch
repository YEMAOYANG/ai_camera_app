diff --git a/lib/server/mira-formal-session-events.ts b/lib/server/mira-formal-session-events.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-session-events.ts
@@ -0,0 +1,37 @@
+import type { PersistedAgentSessionEvent } from '@openmaic/storage';
+
+type EvidenceReader = {
+  lastEventSeq(sessionId: string): Promise<number>;
+  readEventsAfter(sessionId: string, afterSeq: number, limit?: number,
+    projection?: { excludeTypes: readonly string[]; throughSeq: number }): Promise<PersistedAgentSessionEvent[]>;
+};
+const PAGE_SIZE = 500;
+const MAX_STRUCTURAL_EVENTS = 20_000;
+
+/** Keep every structural/unknown event; only the known streaming delta is omitted.
+ * PostgreSQL retains the original log. The fixed high-water mark makes a review
+ * independent of new tokens arriving while its evidence pages are being read. */
+export async function readMiraFormalSessionEvents(store: EvidenceReader, sessionId: string) {
+  const throughSeq = await store.lastEventSeq(sessionId);
+  if (!Number.isSafeInteger(throughSeq) || throughSeq < 0)
+    throw new Error('FORMAL_PROFESSIONAL_EVENT_CURSOR_INVALID');
+  const events: PersistedAgentSessionEvent[] = [];
+  let cursor = 0;
+  while (cursor < throughSeq) {
+    const page = await store.readEventsAfter(sessionId, cursor, PAGE_SIZE,
+      { excludeTypes: ['message_update'], throughSeq });
+    if (page.length > PAGE_SIZE) throw new Error('FORMAL_PROFESSIONAL_EVENT_PAGE_INVALID');
+    for (const event of page) {
+      if (!Number.isSafeInteger(event.id) || event.id <= cursor || event.id > throughSeq)
+        throw new Error('FORMAL_PROFESSIONAL_EVENT_CURSOR_INVALID');
+      cursor = event.id;
+      // Also preserve bounded memory with an older store that does not yet
+      // implement SQL projection. Unknown types are intentionally not dropped.
+      if (event.type !== 'message_update') events.push(event);
+      if (events.length > MAX_STRUCTURAL_EVENTS)
+        throw new Error('FORMAL_PROFESSIONAL_EVENT_LIMIT');
+    }
+    if (page.length < PAGE_SIZE) break;
+  }
+  return events;
+}
