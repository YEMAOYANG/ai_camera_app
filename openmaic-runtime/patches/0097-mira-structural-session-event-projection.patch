diff --git a/tests/server/mira-formal-session-events.test.ts b/tests/server/mira-formal-session-events.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-session-events.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, it, vi } from 'vitest';
+import type { PersistedAgentSessionEvent } from '@openmaic/storage';
+import { PgAgentSessionStore } from '../../packages/@openmaic/storage/src/agent-session/pg';
+import { readMiraFormalSessionEvents } from '@/lib/server/mira-formal-session-events';
+
+const event = (id: number, type: string): PersistedAgentSessionEvent =>
+  ({ id, type, ts: id, attempt: 1, data: { stageId: 'same-stage', receipt: id } });
+function reader(events: PersistedAgentSessionEvent[], projected = true) {
+  const highWater = events.at(-1)?.id ?? 0;
+  return {
+    lastEventSeq: vi.fn(async () => highWater),
+    readEventsAfter: vi.fn(async (_session: string, after: number, limit = 500,
+      projection?: { excludeTypes: readonly string[]; throughSeq: number }) =>
+      events.filter(e => e.id > after && e.id <= (projection?.throughSeq ?? highWater)
+        && (!projected || !projection?.excludeTypes.includes(e.type))).slice(0, limit)),
+  };
+}
+
+describe('formal structural event projection', () => {
+  it('retains every receipt and unknown type after more than 20k streaming deltas', async () => {
+    const raw = Array.from({ length: 25_001 }, (_, i) => event(i + 1, 'message_update'));
+    const types = ['stage_link', 'course_link', 'mira_formal_research_search',
+      'mira_formal_skill_scene_context', 'mira_formal_image_generated', 'mira_formal_video_generated',
+      'tool_execution_end', 'session_end', 'future_structural_receipt'];
+    const receipts = types.map((type, i) => event(25_002 + i, type));
+    raw.push(...receipts);
+    for (const projected of [true, false]) {
+      const store = reader(raw, projected);
+      expect(await readMiraFormalSessionEvents(store, 'session')).toEqual(receipts);
+      expect(store.lastEventSeq).toHaveBeenCalledTimes(1);
+      expect(store.readEventsAfter.mock.calls.every(call => call[2] === 500
+        && call[3]?.throughSeq === 25_010 && call[3]?.excludeTypes.join() === 'message_update')).toBe(true);
+    }
+    expect(raw).toHaveLength(25_010);
+  });
+
+  it('reads exact page boundaries and excludes events appended beyond the starting watermark', async () => {
+    const raw = Array.from({ length: 1_000 }, (_, i) => event((i + 1) * 3, 'future_receipt'));
+    const store = reader(raw);
+    raw.push(event(3001, 'stage_link'));
+    const result = await readMiraFormalSessionEvents(store, 'session');
+    expect(result).toHaveLength(1000);
+    expect(result.at(-1)?.id).toBe(3000);
+    expect(store.readEventsAfter.mock.calls.map(call => call[1])).toEqual([0, 1500]);
+  });
+
+  it('keeps the 20k structural limit including unknown future events', async () => {
+    const store = reader(Array.from({ length: 20_001 }, (_, i) => event(i + 1, 'future_receipt')));
+    await expect(readMiraFormalSessionEvents(store, 'session')).rejects.toThrow('FORMAL_PROFESSIONAL_EVENT_LIMIT');
+  });
+
+  it('fails closed on repeated, reversed or out-of-watermark cursors', async () => {
+    for (const page of [[event(0, 'stage_link')], [event(2, 'stage_link'), event(1, 'course_link')],
+      [event(11, 'stage_link')]]) {
+      await expect(readMiraFormalSessionEvents({ lastEventSeq: async () => 10,
+        readEventsAfter: async () => page }, 'session')).rejects.toThrow('FORMAL_PROFESSIONAL_EVENT_CURSOR_INVALID');
+    }
+  });
+
+  it('filters in SQL before selecting payloads and preserves the legacy read API', async () => {
+    const query = vi.fn(async (_sql: string, _values?: unknown[]) => ({ rows: [{ seq: 9001, ts: 1, attempt: 1,
+      type: 'future_receipt', data: { unchanged: true } }] }));
+    const store = new PgAgentSessionStore({ query } as never, { withTransaction: vi.fn() });
+    await store.readEventsAfter('session', 500, 500, { excludeTypes: ['message_update'], throughSeq: 9500 });
+    expect(query.mock.calls[0]?.[0]).toContain('AND NOT (e.type = ANY($4::text[])) AND e.seq <= $5');
+    expect(query.mock.calls[0]?.[1]).toEqual(['session', 500, 500, ['message_update'], 9500]);
+    query.mockClear();
+    await store.readEventsAfter('session', 500, 500);
+    expect(query.mock.calls[0]?.[0]).not.toContain('ANY($4');
+    expect(query.mock.calls[0]?.[1]).toEqual(['session', 500, 500]);
+  });
+});
