+import { createHash } from 'crypto';
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+import { MIRA_FORMAL_AUDIO_POLICY, assertMiraFormalAsrRequest, executeMiraFormalAsr,
+  executeMiraFormalTts, readMiraFormalTtsAsset, readMiraFormalTtsJob, readMiraFormalAsrJob,
+  type MiraFormalTtsRequest } from '@/lib/server/mira-formal-audio';
+import { MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY, MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY_SHA256,
+  textbookAudioLanguageProfile } from '@/lib/server/mira-textbook-audio-language';
+
+const budgeted = vi.hoisted(() => vi.fn());
+vi.mock('@/lib/server/mira-paid-budget', () => ({ budgetedOperation: budgeted,
+  paidBudgetContext: { getStore: () => undefined } }));
+vi.mock('@/lib/server/provider-config', () => ({
+  getServerTTSProviders: () => ({ 'qwen-tts': { disabled: false } }), getServerASRProviders: () => ({ 'qwen-asr': {} }),
+  resolveTTSApiKey: () => 'mock-only', resolveASRApiKey: () => 'mock-only',
+  resolveTTSBaseUrl: () => 'https://dashscope.aliyuncs.com/api/v1',
+  resolveASRBaseUrl: () => 'https://dashscope.aliyuncs.com/api/v1',
+}));
+const sha = (value: string | Uint8Array) => createHash('sha256').update(value).digest('hex');
+const policy = { policyVersion: MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY.policyVersion,
+  policySha256: MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY_SHA256 };
+
+function input(text: string, id = 'tbbtts2_' + 'a'.repeat(64)): MiraFormalTtsRequest {
+  return { requestId: id, classroomId: 'private-batch-room', classroomContentSha256: '1'.repeat(64),
+    subject: 'english', teacherProfileId: 'mira_english_standard', teacherProfileVersion: 2,
+    teacherProfileSha256: MIRA_FORMAL_AUDIO_POLICY.subjects.english.teacherProfileSha256,
+    teacherGender: 'female', sceneId: 'scene-one', sceneOrder: 0, actionId: 'cue-one',
+    narrationSegmentId: 'cue-one', text, textSha256: sha(text) };
+}
+function wav() {
+  const b = Buffer.alloc(48); b.write('RIFF'); b.writeUInt32LE(40, 4); b.write('WAVE', 8);
+  b.write('fmt ', 12); b.writeUInt32LE(16, 16); b.writeUInt16LE(1, 20); b.writeUInt16LE(1, 22);
+  b.writeUInt32LE(16000, 24); b.writeUInt32LE(32000, 28); b.writeUInt16LE(2, 32);
+  b.writeUInt16LE(16, 34); b.write('data', 36); b.writeUInt32LE(4, 40); return b;
+}
+function mockTts(audio = wav()) {
+  return vi.fn(async (url: string | URL | Request, _init?: RequestInit) => String(url).includes('multimodal-generation')
+    ? new Response(JSON.stringify({ output: { audio: { url: 'https://mira-test.oss-cn-beijing.aliyuncs.com/mock.wav' } } }),
+      { headers: { 'content-type': 'application/json' } })
+    : new Response(audio.buffer.slice(audio.byteOffset, audio.byteOffset + audio.byteLength) as ArrayBuffer,
+      { headers: { 'content-type': 'audio/wav', 'content-length': String(audio.length) } }));
+}
+const deps = (fetchImpl: ReturnType<typeof mockTts>) => ({ fetchImpl: fetchImpl as typeof fetch,
+  resolveAddresses: async () => ['8.8.8.8'] });
+function asrInput(tts: MiraFormalTtsRequest, audioSha256: string, id = 'tbbasr2_' + 'b'.repeat(64)) {
+  const { text: _text, textSha256: _textHash, ...identity } = tts;
+  return { ...identity, requestId: id, ttsRequestId: tts.requestId, audioSha256 };
+}
+
+describe('explicit textbook English Auto language namespace', () => {
+  let folder: string; let prior: string | undefined;
+  beforeEach(async () => { folder = await fs.mkdtemp(path.join(os.tmpdir(), 'mira-textbook-audio-'));
+    prior = process.env.MIRA_FORMAL_AUDIO_DATA_DIR; process.env.MIRA_FORMAL_AUDIO_DATA_DIR = folder;
+    budgeted.mockClear(); budgeted.mockImplementation(async (...args: unknown[]) =>
+      (args[4] as () => Promise<unknown>)()); });
+  afterEach(async () => { if (prior === undefined) delete process.env.MIRA_FORMAL_AUDIO_DATA_DIR;
+    else process.env.MIRA_FORMAL_AUDIO_DATA_DIR = prior; await fs.rm(folder, { recursive: true, force: true }); });
+
+  it('pins the same canonical provider-language policy as the backend registry', () => {
+    expect(policy.policySha256).toBe('ce157e5f65649259b7e908887dd83f3a1f47685d2a9ac759e244e3f2d4b10beb');
+    expect(policy.policySha256).toBe(qualitySha(MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY));
+  });
+
+  it.each(['Do you like bananas? 看清香蕉的样子，可以指一指。', '请看香蕉。', 'Do you like bananas?'])(
+    'uses Auto for each English narration type and persists physical identity before dispatch: %s', async text => {
+      const req = input(text), fetchMock = mockTts();
+      const original = fetchMock.getMockImplementation()!;
+      fetchMock.mockImplementation(async url => {
+        if (String(url).includes('multimodal-generation')) {
+          const stored = await readMiraFormalTtsJob(req.requestId);
+          expect(stored?.providerLanguagePolicy?.policySha256).toBe(policy.policySha256);
+        }
+        return original(url);
+      });
+      const result = await executeMiraFormalTts(req, deps(fetchMock));
+      expect(result.record.state).toBe('succeeded');
+      const paidInput = budgeted.mock.calls[0][2];
+      expect(paidInput.providerRequest.input).toEqual({ text, voice: 'Jennifer', language_type: 'Auto' });
+      expect(paidInput.batchLanguageProfile).toEqual(policy);
+      expect(result.record.requestSha256).toBe(qualitySha({ logicalRequest: req, batchLanguageProfile: policy }));
+      expect(result.record.providerLanguagePolicy).toEqual({ ...policy, providerBodySha256: qualitySha(paidInput.providerRequest) });
+      expect(result.record.languageCode).toBe('en-US');
+      const replayFetch = mockTts();
+      expect((await executeMiraFormalTts(req, deps(replayFetch))).record).toEqual(result.record);
+      expect(replayFetch).not.toHaveBeenCalled();
+    });
+
+  it('omits ASR language, keeps exact WAV/teacher identity and has one idempotent request slot', async () => {
+    const req = input('Do you like bananas? 看清香蕉。');
+    const tts = await executeMiraFormalTts(req, deps(mockTts()));
+    const asr = asrInput(req, tts.record.audioSha256!);
+    const fetchMock = vi.fn(async (_url: string | URL | Request, init?: RequestInit) => {
+      const body = JSON.parse(String(init?.body));
+      expect(body.parameters.asr_options).toEqual({});
+      expect(body.input.messages[0].content[0].audio).toBe('data:audio/wav;base64,' + wav().toString('base64'));
+      expect((await readMiraFormalAsrJob(asr.requestId))?.providerLanguagePolicy?.policySha256).toBe(policy.policySha256);
+      return new Response(JSON.stringify({ output: { choices: [{ message: { content: [{ text: req.text }] } }] } }),
+        { headers: { 'content-type': 'application/json' } });
+    });
+    const first = await executeMiraFormalAsr(asr, { fetchImpl: fetchMock as typeof fetch });
+    expect(first.record.state).toBe('succeeded'); expect(first.transcript).toBe(req.text);
+    expect(first.record.providerLanguagePolicy).toEqual({ ...policy,
+      providerBodySha256: qualitySha(budgeted.mock.calls[1][2].providerRequest) });
+    expect((await executeMiraFormalAsr(asr, { fetchImpl: fetchMock as typeof fetch })).created).toBe(false);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps ordinary four-subject physical language, legacy request digest and health policies', async () => {
+    const frozen = JSON.stringify(MIRA_FORMAL_AUDIO_POLICY);
+    for (const [subject, teacher] of Object.entries(MIRA_FORMAL_AUDIO_POLICY.subjects)) {
+      const req = { ...input('请看图片。', 'legacy-' + subject), subject,
+        teacherProfileId: teacher.teacherProfileId, teacherProfileVersion: teacher.teacherProfileVersion,
+        teacherProfileSha256: teacher.teacherProfileSha256, teacherGender: teacher.teacherGender } as MiraFormalTtsRequest;
+      const fetchMock = mockTts();
+      const result = await executeMiraFormalTts(req, deps(fetchMock));
+      expect(result.record.requestSha256).toBe(qualitySha(req));
+      expect(result.record.providerLanguagePolicy).toBeUndefined();
+      const paidInput = budgeted.mock.calls.at(-1)?.[2];
+      expect(paidInput.logicalRequest || paidInput).toEqual(req);
+      expect(JSON.parse(String(fetchMock.mock.calls[0][1]?.body)).input).toEqual({
+        text: req.text, voice: teacher.voiceId, language_type: 'Chinese' });
+    }
+    expect(JSON.stringify(MIRA_FORMAL_AUDIO_POLICY)).toBe(frozen);
+    expect(MIRA_FORMAL_AUDIO_POLICY.subjects.english.qwenLanguageType).toBe('Chinese');
+    expect(MIRA_FORMAL_AUDIO_POLICY.subjects.english.qwenAsrLanguage).toBe('zh');
+  });
+
+  it('rejects missing or drifted successful TTS policy before creating or replaying an ASR job', async () => {
+    const req = input('Hello. 请看图片。');
+    const tts = await executeMiraFormalTts(req, deps(mockTts()));
+    const asr = asrInput(req, tts.record.audioSha256!);
+    const job = path.join(folder, 'jobs/tts', sha(req.requestId) + '.json');
+    const saved = JSON.parse(await fs.readFile(job, 'utf8'));
+    const fetchMock = vi.fn(async () => new Response(JSON.stringify({ output: {
+      choices: [{ message: { content: [{ text: req.text }] } }],
+    } }), { headers: { 'content-type': 'application/json' } }));
+    const invalidPolicies = [undefined,
+      { ...saved.providerLanguagePolicy, policyVersion: 'unrecognized-policy' },
+      { ...saved.providerLanguagePolicy, policySha256: 'f'.repeat(64) },
+      { ...saved.providerLanguagePolicy, providerBodySha256: 'not-a-sha256' }];
+    for (const providerLanguagePolicy of invalidPolicies) {
