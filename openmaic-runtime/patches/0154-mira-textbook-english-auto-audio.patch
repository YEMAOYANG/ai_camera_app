+    expect((await executeMiraFormalAsr(asr, { fetchImpl: fetchMock as typeof fetch })).record.state).toBe('succeeded');
+    await fs.writeFile(job, JSON.stringify({ ...saved, providerLanguagePolicy: undefined }));
+    await expect(executeMiraFormalAsr(asr, { fetchImpl: fetchMock as typeof fetch }))
+      .rejects.toMatchObject({ code: 'asset_unavailable' });
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    expect(budgeted).toHaveBeenCalledTimes(2);
+  });
+
+  it('rejects non-English, malformed or mixed namespaces and provider overrides before fetch', async () => {
+    const fetchMock = mockTts();
+    for (const id of ['tbbtts2_bad', 'tbbasr2_' + 'a'.repeat(64)])
