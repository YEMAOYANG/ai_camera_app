+      expect(() => assertMiraFormalAsrRequest({ ...asrInput(req, 'c'.repeat(64)), ...mutation })).toThrow();
+    await expect(executeMiraFormalTts({ ...req, languageType: 'English' }, deps(fetchMock))).rejects.toMatchObject({ code: 'invalid_request' });
