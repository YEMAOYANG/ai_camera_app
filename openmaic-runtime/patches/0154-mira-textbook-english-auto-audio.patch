new file mode 100644
--- /dev/null
+++ b/lib/server/mira-textbook-audio-language.ts
@@ -0,0 +1,39 @@
+/** Explicit batch v2 namespace; legacy formal audio keeps its original policy. */
+import { createHash } from 'crypto';
+
+export const MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY = {
+  policyVersion: 'mira.textbook.english-auto-language.v1',
+  subject: 'english',
+  tts: { providerId: 'qwen-tts', modelId: 'qwen3-tts-flash', languageType: 'Auto' },
+  asr: { providerId: 'qwen-asr', modelId: 'qwen3-asr-flash', automaticLanguage: true },
+} as const;
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') return Object.fromEntries(
+    Object.entries(value).sort(([a], [b]) => a.localeCompare(b)).map(([k, v]) => [k, canonical(v)]));
+  return value;
+}
+
+export const MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY_SHA256 = createHash('sha256')
+  .update(JSON.stringify(canonical(MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY))).digest('hex');
+
+export interface MiraTextbookAudioLanguageProfile {
+  policyVersion: typeof MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY.policyVersion;
+  policySha256: string;
+}
+
+export function textbookAudioLanguageProfile(
+  input: { subject: string; requestId: string; ttsRequestId?: string },
+  operation: 'tts' | 'asr',
+): MiraTextbookAudioLanguageProfile | undefined {
+  const reserved = /^(?:tbbtts2|tbbasr2|tbbreasr2)/;
+  if (!reserved.test(input.requestId) && !(operation === 'asr' && reserved.test(input.ttsRequestId || '')))
+    return undefined;
+  const requestPattern = operation === 'tts' ? /^tbbtts2_[a-f0-9]{64}$/ : /^(?:tbbasr2|tbbreasr2)_[a-f0-9]{64}$/;
+  if (input.subject !== 'english' || !requestPattern.test(input.requestId) ||
+      (operation === 'asr' && !/^tbbtts2_[a-f0-9]{64}$/.test(input.ttsRequestId || '')))
+    throw new Error('Invalid textbook audio language namespace');
+  return { policyVersion: MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY.policyVersion,
+    policySha256: MIRA_TEXTBOOK_ENGLISH_AUTO_LANGUAGE_POLICY_SHA256 };
+}
