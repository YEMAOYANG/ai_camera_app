+  });
+
+  it('does not overwrite a legacy audio asset and rejects changed text or policy under the same new identity', async () => {
+    const legacy = input('Hello. 看图片。', 'tbbtts_' + 'a'.repeat(64));
+    const old = await executeMiraFormalTts(legacy, deps(mockTts()));
+    const before = await readMiraFormalTtsAsset(legacy.requestId);
+    const req = input(legacy.text);
+    const fresh = await executeMiraFormalTts(req, deps(mockTts()));
+    expect(fresh.record.assetId).not.toBe(old.record.assetId);
+    expect(Buffer.from((await readMiraFormalTtsAsset(legacy.requestId)).bytes)).toEqual(Buffer.from(before.bytes));
+    const fetchMock = mockTts();
+    await expect(executeMiraFormalTts({ ...req, text: 'Changed.', textSha256: sha('Changed.') }, deps(fetchMock)))
+      .rejects.toMatchObject({ code: 'request_conflict' });
+    const job = path.join(folder, 'jobs/tts', sha(req.requestId) + '.json');
+    const saved = JSON.parse(await fs.readFile(job, 'utf8'));
