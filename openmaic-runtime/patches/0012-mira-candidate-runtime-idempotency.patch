new file mode 100644
index 0000000..01ce71b
--- /dev/null
+++ b/tests/server/mira-formal-generation-idempotency-worker.ts
@@ -0,0 +1,36 @@
+import process from 'process';
+
+async function main() {
+  const [, , tempRoot, action, encoded] = process.argv;
+  if (!tempRoot || !action || !encoded) process.exit(2);
+  process.chdir(tempRoot);
+
+  const payload = JSON.parse(Buffer.from(encoded, 'base64url').toString('utf8')) as Record<
+    string,
+    unknown
+  >;
+  const store = await import('../../lib/server/classroom-job-store');
+
+  if (action === 'create') {
+    const startAt = Number(payload.startAt || 0);
+    if (startAt > Date.now()) {
+      await new Promise((resolve) => setTimeout(resolve, startAt - Date.now()));
+    }
+    const result = await store.createOrGetFormalClassroomGenerationJob(
+      payload.input as never,
+    );
+    process.stdout.write(JSON.stringify({ jobId: result.job.id, created: result.created }));
+  } else if (action === 'claim') {
+    const claimed = await store.claimFormalClassroomGenerationDispatch(
+      String(payload.jobId || ''),
+    );
+    process.stdout.write(JSON.stringify({ claimed }));
+  } else {
+    process.exit(2);
+  }
+}
+
+main().catch((error) => {
+  process.stderr.write(String(error instanceof Error ? error.stack : error));
+  process.exit(1);
+});
