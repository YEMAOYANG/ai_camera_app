+const REQUEST_ID = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(
+      Object.entries(value as Record<string, unknown>)
+        .sort(([left], [right]) => left.localeCompare(right))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  }
+  return value;
+}
+
+export function isExactMiraFormalRuntimeContract(value: unknown): boolean {
+  return (
+    JSON.stringify(canonical(value)) ===
+    JSON.stringify(canonical(MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT))
+  );
+}
+
+export function assertMiraFormalGenerationInput(
+  input: GenerateClassroomInput,
+): asserts input is GenerateClassroomInput & {
+  runtimeRequestId: string;
+  formalRuntimeContract: typeof MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT;
+} {
+  if (!REQUEST_ID.test(input.runtimeRequestId || '')) {
+    throw new Error('FORMAL_RUNTIME_REQUEST_ID_INVALID');
+  }
+  if (!isExactMiraFormalRuntimeContract(input.formalRuntimeContract)) {
+    throw new Error('FORMAL_RUNTIME_CONTRACT_INVALID');
+  }
+  if (
+    !input.requirement.trim() ||
+    input.pdfContent !== undefined ||
+    input.enableWebSearch !== false ||
+    input.enableImageGeneration !== false ||
+    input.enableVideoGeneration !== false ||
+    input.enableTTS !== false ||
+    input.agentMode !== 'generate' ||
+    input.webSearchProviderId !== undefined ||
+    input.webSearchApiKey !== undefined ||
+    input.webSearchModelId !== undefined ||
+    input.baiduSubSources !== undefined
+  ) {
+    throw new Error('FORMAL_RUNTIME_INPUT_POLICY_INVALID');
+  }
+}
+
+export function getMiraFormalGenerationRuntimePolicy() {
+  return MIRA_FORMAL_GENERATION_POLICY;
+}
