@@ -0,0 +1,233 @@
+import { promises as fs } from 'fs';
+import { spawn } from 'child_process';
+import os from 'os';
+import path from 'path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const afterSpy = vi.fn();
+const runSpy = vi.fn();
+
+vi.mock('next/server', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('next/server')>();
+  return {
+    ...actual,
+    after: (callback: () => unknown) => afterSpy(callback),
+  };
+});
+
+vi.mock('@/lib/server/classroom-job-runner', () => ({
+  runClassroomGenerationJob: (...args: unknown[]) => runSpy(...args),
+}));
+
+describe('Mira formal generation request idempotency', () => {
+  let originalCwd: string;
+  let tempRoot: string;
+
+  function runWorker(action: 'create' | 'claim', payload: object): Promise<Record<string, unknown>> {
+    const worker = path.join(
+      originalCwd,
+      'tests/server/mira-formal-generation-idempotency-worker.ts',
+    );
+    const tsx = path.join(originalCwd, 'node_modules/.bin/tsx');
+    const encoded = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+    return new Promise((resolve, reject) => {
+      const child = spawn(tsx, [worker, tempRoot, action, encoded], {
+        cwd: originalCwd,
+        env: { ...process.env },
+        stdio: ['ignore', 'pipe', 'pipe'],
+      });
+      let stdout = '';
+      let stderr = '';
+      child.stdout.on('data', (chunk) => { stdout += String(chunk); });
+      child.stderr.on('data', (chunk) => { stderr += String(chunk); });
+      child.on('error', reject);
+      child.on('close', (code) => {
+        if (code !== 0) {
+          reject(new Error(`worker failed (${code}): ${stderr || stdout}`));
+          return;
+        }
+        resolve(JSON.parse(stdout) as Record<string, unknown>);
+      });
+    });
+  }
+
+  beforeEach(async () => {
+    originalCwd = process.cwd();
+    tempRoot = await fs.mkdtemp(path.join(os.tmpdir(), 'mira-formal-runtime-'));
+    process.chdir(tempRoot);
+    afterSpy.mockReset();
+    runSpy.mockReset();
+    vi.resetModules();
+  });
+
+  afterEach(async () => {
+    process.chdir(originalCwd);
+    await fs.rm(tempRoot, { recursive: true, force: true });
+  });
+
+  it('converges concurrent creates and rejects a changed replay', async () => {
+    const policy = await import('@/lib/server/mira-formal-generation-policy');
+    const store = await import('@/lib/server/classroom-job-store');
+    const input = {
+      requirement: 'formal requirement',
+      runtimeRequestId: 'mira-formal-request-1',
+      formalRuntimeContract: policy.MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT,
+      enableWebSearch: false,
+      enableImageGeneration: false,
+      enableVideoGeneration: false,
+      enableTTS: false,
+      agentMode: 'generate' as const,
+    };
+
+    const results = await Promise.all(
+      Array.from({ length: 8 }, () =>
+        store.createOrGetFormalClassroomGenerationJob(input),
+      ),
+    );
+
+    expect(new Set(results.map((result) => result.job.id)).size).toBe(1);
+    expect(results.filter((result) => result.created)).toHaveLength(1);
+    expect(
+      await store.readClassroomGenerationJobByRuntimeRequestId(
+        input.runtimeRequestId,
+      ),
+    ).toMatchObject({
+      id: results[0].job.id,
+      runtimeRequestId: input.runtimeRequestId,
+      formalContractVersion: 'mira.openmaic.formal-runtime.v1',
+    });
+
+    await expect(
+      store.createOrGetFormalClassroomGenerationJob({
+        ...input,
+        requirement: 'changed replay',
+      }),
+    ).rejects.toThrow('FORMAL_RUNTIME_REQUEST_CONFLICT');
+    await expect(
+      store.createOrGetFormalClassroomGenerationJob({
+        ...input,
+        enableTTS: true,
+      }),
+    ).rejects.toThrow('FORMAL_RUNTIME_INPUT_POLICY_INVALID');
+  });
+
+  it('atomically creates and claims one formal dispatch across Node processes', async () => {
+    const policy = await import('@/lib/server/mira-formal-generation-policy');
+    const input = {
+      requirement: 'formal cross-process requirement',
+      runtimeRequestId: 'mira-formal-cross-process-request-1',
+      formalRuntimeContract: policy.MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT,
+      enableWebSearch: false,
+      enableImageGeneration: false,
+      enableVideoGeneration: false,
+      enableTTS: false,
+      agentMode: 'generate' as const,
+    };
+    const startAt = Date.now() + 1_000;
+    const creates = await Promise.all(
+      Array.from({ length: 8 }, () => runWorker('create', { input, startAt })),
+    );
+    expect(new Set(creates.map((value) => value.jobId)).size).toBe(1);
+    expect(creates.filter((value) => value.created === true)).toHaveLength(1);
+
+    const claims = await Promise.all(
+      Array.from({ length: 8 }, () =>
+        runWorker('claim', { jobId: creates[0].jobId }),
+      ),
+    );
+    expect(claims.filter((value) => value.claimed === true)).toHaveLength(1);
+  }, 30_000);
+
+  it('POST replay and GET reconcile a queued crash window without losing identity', async () => {
+    const policy = await import('@/lib/server/mira-formal-generation-policy');
+    const { NextRequest } = await import('next/server');
+    const route = await import('@/app/api/generate-classroom/route');
+    const payload = {
+      requirement: 'formal requirement',
+      runtimeRequestId: 'mira-formal-route-request-1',
+      formalRuntimeContract: policy.MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT,
+      enableWebSearch: false,
+      enableImageGeneration: false,
+      enableVideoGeneration: false,
+      enableTTS: false,
+      agentMode: 'generate',
+    };
+    const request = () =>
+      new NextRequest('http://runtime.test/api/generate-classroom', {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify(payload),
+      });
+
+    const first = await route.POST(request());
+    const replay = await route.POST(request());
+    const firstBody = await first.json();
+    const replayBody = await replay.json();
+
+    expect(first.status).toBe(202);
+    expect(replay.status).toBe(200);
+    expect(replayBody.jobId).toBe(firstBody.jobId);
+    expect(afterSpy).toHaveBeenCalledTimes(2);
+
+    const queried = await route.GET(
+      new NextRequest(
+        'http://runtime.test/api/generate-classroom?runtimeRequestId=mira-formal-route-request-1',
+      ),
+    );
+    expect(queried.status).toBe(200);
+    const queriedBody = await queried.json();
+    expect(queriedBody).toMatchObject({
+      jobId: firstBody.jobId,
+      status: 'queued',
+      done: false,
+      runtimeRequestId: payload.runtimeRequestId,
+      formalContractVersion: 'mira.openmaic.formal-runtime.v1',
+    });
+    expect(queriedBody.formalInputSha256).toMatch(/^[a-f0-9]{64}$/);
+    expect(afterSpy).toHaveBeenCalledTimes(3);
+  });
+
+  it('never converts a stale formal running job into an explicit failed result', async () => {
+    const policy = await import('@/lib/server/mira-formal-generation-policy');
+    const store = await import('@/lib/server/classroom-job-store');
+    const input = {
+      requirement: 'formal stale requirement',
+      runtimeRequestId: 'mira-formal-stale-request-1',
+      formalRuntimeContract: policy.MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT,
+      enableWebSearch: false,
+      enableImageGeneration: false,
+      enableVideoGeneration: false,
+      enableTTS: false,
+      agentMode: 'generate' as const,
+    };
+    const { job } = await store.createOrGetFormalClassroomGenerationJob(input);
+    await store.updateClassroomGenerationJob(job.id, { status: 'running' });
+    const jobPath = path.join(tempRoot, 'data', 'classroom-jobs', `${job.id}.json`);
+    const persisted = JSON.parse(await fs.readFile(jobPath, 'utf8')) as Record<
+      string,
+      unknown
+    >;
+    persisted.updatedAt = new Date(Date.now() - 31 * 60 * 1000).toISOString();
+    await fs.writeFile(jobPath, JSON.stringify(persisted), 'utf8');
+
+    const stale = await store.readClassroomGenerationJob(job.id);
+    expect(stale?.status).toBe('running');
+    expect(stale?.dispatchAmbiguous).toBe(true);
+  });
+
+  it('does not expose raw internal errors in a formal POST 500 response', async () => {
+    const { NextRequest } = await import('next/server');
+    const route = await import('@/app/api/generate-classroom/route');
+    const response = await route.POST(
+      new NextRequest('http://runtime.test/api/generate-classroom', {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: '{broken-json',
+      }),
+    );
+    const body = await response.json();
+    expect(response.status).toBe(500);
+    expect(JSON.stringify(body)).not.toContain('JSON');
+    expect(body.details).toBeUndefined();
+  });
+});
