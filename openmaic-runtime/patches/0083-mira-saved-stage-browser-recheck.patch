--- /dev/null
+++ b/lib/server/mira-formal-browser-recheck.ts
@@ -0,0 +1,115 @@
+/** Operator-only proof that a saved snapshot stopped before any paid dispatch. */
+import { createHash } from 'node:crypto';
+import { readFile, readdir, open } from 'node:fs/promises';
+import { join } from 'node:path';
+import { qualitySha } from './mira-formal-quality-contract';
+
+const SHA = /^[a-f0-9]{64}$/;
+const SCHEMA = 'mira.formal.browser-only-recheck.v1';
+export const INSPECTOR_SOURCES = [
+  'lib/server/mira-formal-exploration.ts',
+  'lib/server/mira-formal-scene-dom.ts',
+  'lib/server/mira-formal-scene-inspector.ts',
+] as const;
+const bytesSha = (value: Buffer) => createHash('sha256').update(value).digest('hex');
+const object = (value: unknown): value is Record<string, any> => !!value && typeof value === 'object' && !Array.isArray(value);
+function fail(): never { throw new Error('SAVED_STAGE_BROWSER_RECHECK_NOT_PROVEN'); }
+async function exists(path: string) {
+  try { await readFile(path); return true; }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false; throw error; }
+}
+async function files(path: string) {
+  try { return await readdir(path); }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return []; throw error; }
+}
+export async function inspectorSourceBundle(root: string) {
+  const bundle: Record<string, string> = {};
+  for (const path of INSPECTOR_SOURCES) bundle[path] = bytesSha(await readFile(join(root, path)));
+  return { bundle, sha256: qualitySha(bundle) };
+}
+
+export async function readBrowserRecheckBudget(authorizationId: string) {
+  const base = process.env.MIRA_BACKEND_INTERNAL_URL;
+  const token = process.env.MIRA_INTERNAL_API_TOKEN;
+  if (!base || !token || !SHA.test(authorizationId)) fail();
+  const response = await fetch(new URL('/internal/learning/budget/context', base), {
+    method: 'POST', redirect: 'error', signal: AbortSignal.timeout(15000),
+    headers: { 'Content-Type': 'application/json', 'X-Mira-Internal-Token': token,
+      'X-Mira-Internal-Source': 'openmaic-runtime-gateway' },
+    body: JSON.stringify({ authorizationId }),
+  });
+  const body = await response.json().catch(() => null);
+  if (!response.ok || !body?.ok || !object(body.budget)) fail();
+  // Never return price data or credentials to the recovery audit.
+  return { authorizationId: body.budget.authorizationId, purpose: body.budget.purpose,
+    unsettledReservationCount: body.budget.unsettledReservationCount,
+    latestProviderDispatchAt: body.budget.latestProviderDispatchAt };
+}
+
+export async function proveUnsentBrowserRecheck(input: {
+  root: string; recoveryFolder: string;
+  identity: { sourceJobSha256: string; sourceSnapshotSha256: string; repairSnapshotSha256: string; sessionId: string; stageId: string };
+  ownerId: string; authorizationId: string; manifest: unknown;
+}, deps: { readBudget?: typeof readBrowserRecheckBudget } = {}) {
+  const { identity, root, recoveryFolder } = input;
+  const spec = input.manifest;
+  if (!object(spec) || Object.keys(spec).sort().join(',') !==
+      'inspectorSourceSha256,priorClaimSha256,priorResultSha256,qualityIdentitySha256,schemaVersion'
+      || spec.schemaVersion !== SCHEMA || !SHA.test(input.authorizationId)
+      || ['qualityIdentitySha256','priorClaimSha256','priorResultSha256','inspectorSourceSha256']
+        .some(key => typeof spec[key] !== 'string' || !SHA.test(spec[key]))) fail();
+  const snapshot = identity.repairSnapshotSha256;
+  const priorClaimBytes = await readFile(join(recoveryFolder, `complete-${snapshot}.claim`));
+  const priorClaim = JSON.parse(priorClaimBytes.toString('utf8'));
+  const claimAt = Date.parse(priorClaim.createdAt);
+  if (bytesSha(priorClaimBytes) !== spec.priorClaimSha256 || !Number.isSafeInteger(claimAt)
+      || Object.entries(identity).some(([key, value]) => priorClaim[key] !== value)
+      || priorClaim.reviewGrantSha256 || await exists(join(recoveryFolder, 'completion.json'))) fail();
+  const folder = join(root, 'data/formal-quality-reviews', spec.qualityIdentitySha256);
+  const resultBytes = await readFile(join(folder, `${snapshot}.json`));
+  const result = JSON.parse(resultBytes.toString('utf8'));
+  const browser = JSON.parse(await readFile(join(folder, `${snapshot}-browser.json`), 'utf8'));
+  const ledger = JSON.parse(await readFile(join(folder, 'attempts.json'), 'utf8'));
+  const originalInput = JSON.parse(await readFile(join(folder, `${snapshot}-input.json`), 'utf8'));
+  const attempts = Array.isArray(ledger) ? ledger.filter(item => object(item) && item.snapshotSha256 === snapshot) : [];
+  const qualityIdentity = Object.fromEntries(['ownerId','sessionId','stageId','gradeBoundarySha256',
+    'teachingBriefSha256','selectionPlanSha256','interactionDesignContextSha256','difficultyPolicySha256']
+    .filter(key => originalInput[key] !== undefined).map(key => [key, originalInput[key]]));
+  if (bytesSha(resultBytes) !== spec.priorResultSha256 || result.status !== 'needs_revision'
+      || result.snapshotSha256 !== snapshot || result.receipt || !Array.isArray(result.issues) || !result.issues.length
+      || result.issues.some((issue: unknown) => !object(issue) || typeof issue.problem !== 'string' || !issue.problem.startsWith('Browser check '))
+      || !Array.isArray(browser) || !browser.some(check => object(check) && check.passed === false)
+      || attempts.length !== 1 || attempts[0].status !== 'needs_revision' || attempts[0].grantId || attempts[0].artifactPrefix
+      || qualitySha(qualityIdentity) !== spec.qualityIdentitySha256
+      || originalInput.ownerId !== input.ownerId || originalInput.sessionId !== identity.sessionId
+      || originalInput.stageId !== identity.stageId || qualitySha(originalInput.snapshot) !== snapshot
+      || (await files(folder)).some(name => name.startsWith(snapshot) && /(?:provider|dispatch|visual)/.test(name))
+      || (await files(join(root, 'data/formal-visual-provider-responses', snapshot))).length > 0) fail();
+  const inspector = await inspectorSourceBundle(root);
+  if (inspector.sha256 !== spec.inspectorSourceSha256) fail();
+  const budget = await (deps.readBudget ?? readBrowserRecheckBudget)(input.authorizationId);
+  if (budget.authorizationId !== input.authorizationId || budget.purpose !== 'production'
+      || budget.unsettledReservationCount !== 0
+      || !(budget.latestProviderDispatchAt === null
+        || Number.isSafeInteger(budget.latestProviderDispatchAt) && budget.latestProviderDispatchAt < claimAt)) fail();
+  const evidence = { schemaVersion: SCHEMA, ...identity, authorizationId: input.authorizationId,
+    qualityIdentitySha256: spec.qualityIdentitySha256, priorClaimSha256: spec.priorClaimSha256,
+    priorResultSha256: spec.priorResultSha256, inspectorSourceSha256: inspector.sha256,
+    inspectorSources: inspector.bundle, budgetProof: budget, originalClaimCreatedAt: claimAt,
+    priorClaim, priorResult: result, priorBrowser: browser, priorAttempt: attempts[0],
+    priorQualityInputSha256: bytesSha(Buffer.from(await readFile(join(folder, `${snapshot}-input.json`)))) };
+  return { evidence, evidenceSha256: qualitySha(evidence) };
+}
+
+/** Called while the saved-stage active.lock is held. A repeated proof cannot re-claim. */
+export async function claimUnsentBrowserRecheck(input: Parameters<typeof proveUnsentBrowserRecheck>[0]) {
+  const proof = await proveUnsentBrowserRecheck(input);
+  const filename = `complete-${input.identity.repairSnapshotSha256}-browser-${proof.evidenceSha256}.claim`;
+  const claim = await open(join(input.recoveryFolder, filename), 'wx', 0o600);
+  try {
+    await claim.writeFile(JSON.stringify({ ...proof.evidence, evidenceSha256: proof.evidenceSha256,
+      pid: process.pid, createdAt: new Date().toISOString() }));
+    await claim.sync();
+  } finally { await claim.close(); }
+  return proof.evidenceSha256;
+}
