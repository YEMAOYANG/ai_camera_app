diff --git a/tests/server/mira-formal-browser-recheck.test.ts b/tests/server/mira-formal-browser-recheck.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-browser-recheck.test.ts
@@ -0,0 +1,57 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import { mkdtemp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createHash } from 'node:crypto';
+import { qualitySha } from '../../lib/server/mira-formal-quality-contract';
+import { INSPECTOR_SOURCES, inspectorSourceBundle, proveUnsentBrowserRecheck } from '../../lib/server/mira-formal-browser-recheck';
+
+const folders: string[] = [];
+afterEach(async () => { await Promise.all(folders.splice(0).map(path => rm(path, {recursive:true,force:true}))); });
+const sha = (text: string) => createHash('sha256').update(text).digest('hex');
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), 'mira-browser-recheck-')); folders.push(root);
+  const snapshot = {stage:{id:'stage-test'},scenes:[{id:'scene-test'}]};
+  const hash = qualitySha(snapshot);
+  const identity = {sourceJobSha256:'a'.repeat(64),sourceSnapshotSha256:'b'.repeat(64),
+    repairSnapshotSha256:hash,sessionId:'session-test',stageId:'stage-test'};
+  const quality = {ownerId:'owner-test',sessionId:identity.sessionId,stageId:identity.stageId,
+    gradeBoundarySha256:'c'.repeat(64),teachingBriefSha256:'d'.repeat(64),selectionPlanSha256:'e'.repeat(64)};
+  const recoveryFolder=join(root,'recovery'); const folder=join(root,'data/formal-quality-reviews',qualitySha(quality));
+  await mkdir(recoveryFolder,{recursive:true}); await mkdir(folder,{recursive:true});
+  for (const path of INSPECTOR_SOURCES) { await mkdir(join(root,'lib/server'),{recursive:true}); await writeFile(join(root,path),path); }
+  const claim=JSON.stringify({...identity,createdAt:'2026-09-10T08:31:07.349Z',pid:123});
+  const result=JSON.stringify({status:'needs_revision',snapshotSha256:hash,issues:[{problem:'Browser check 1024x768: reset state'}]});
+  await writeFile(join(recoveryFolder,`complete-${hash}.claim`),claim);
+  await writeFile(join(folder,`${hash}.json`),result);
+  await writeFile(join(folder,`${hash}-browser.json`),JSON.stringify([{passed:false}]));
+  await writeFile(join(folder,`${hash}-input.json`),JSON.stringify({...quality,snapshot}));
+  await writeFile(join(folder,'attempts.json'),JSON.stringify([{snapshotSha256:hash,status:'needs_revision'}]));
+  const authorizationId='f'.repeat(64);
+  const budget={authorizationId,purpose:'production',unsettledReservationCount:0,latestProviderDispatchAt:Date.parse('2026-09-10T08:00:00Z')};
+  return {root,folder,claim,budget,input:{root,recoveryFolder,identity,ownerId:quality.ownerId,authorizationId,
+    manifest:{schemaVersion:'mira.formal.browser-only-recheck.v1',qualityIdentitySha256:qualitySha(quality),
+      priorClaimSha256:sha(claim),priorResultSha256:sha(result),inspectorSourceSha256:(await inspectorSourceBundle(root)).sha256}}};
+}
+describe('saved snapshot browser-only recheck', () => {
+  it('accepts the original browser-only failure with exact source/claim and authoritative zero-dispatch proof', async () => {
+    const f=await fixture();
+    const proof=await proveUnsentBrowserRecheck(f.input,{readBudget:async()=>f.budget});
+    expect(proof.evidenceSha256).toBe(qualitySha(proof.evidence));
+    expect(proof.evidence.priorAttempt.status).toBe('needs_revision');
+    expect(await readFile(join(f.input.recoveryFolder,`complete-${f.input.identity.repairSnapshotSha256}.claim`),'utf8')).toBe(f.claim);
+  });
+  it('rejects paid dispatch evidence, visual replies, and unresolved authoritative ledger calls', async () => {
+    const f=await fixture(); const snapshot=f.input.identity.repairSnapshotSha256;
+    for (const field of ['latestProviderDispatchAt','unsettledReservationCount'] as const) {
+      const budget={...f.budget,[field]:field==='latestProviderDispatchAt'?Date.parse('2026-09-10T08:32:00Z'):1};
+      await expect(proveUnsentBrowserRecheck(f.input,{readBudget:async()=>budget})).rejects.toThrow('NOT_PROVEN');
+    }
+    const marker=join(f.folder,`${snapshot}-provider-dispatch.json`); await writeFile(marker,'{}');
+    await expect(proveUnsentBrowserRecheck(f.input,{readBudget:async()=>f.budget})).rejects.toThrow('NOT_PROVEN');
+    await rm(marker);
+    const visual=join(f.root,'data/formal-visual-provider-responses',snapshot); await mkdir(visual,{recursive:true});
+    await writeFile(join(visual,'original-paid-reply.json'),'{}');
+    await expect(proveUnsentBrowserRecheck(f.input,{readBudget:async()=>f.budget})).rejects.toThrow('NOT_PROVEN');
+  });
+});
