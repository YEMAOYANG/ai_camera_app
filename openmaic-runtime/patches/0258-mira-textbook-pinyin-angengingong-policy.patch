+import { createHash } from 'crypto';
+import { readFileSync } from 'fs';
+import { fileURLToPath } from 'url';
+import { describe, expect, it } from 'vitest';
+import * as registry from '@/lib/server/mira-textbook-pinyin-pronunciation';
+import { assertMiraFormalTtsRequest, MiraFormalAudioError } from '@/lib/server/mira-formal-audio';
+
+const version = 'mira.textbook.pinyin-angengingong-ssml.v1';
+const checksum = '77c1218ebc89639fbcb6360dfa0db0fdb5faccdeb09b3559c4c124a9acc63514';
+const policy = JSON.parse(readFileSync(fileURLToPath(new URL(
+  '../../../../../backend/content/textbook_pinyin_pronunciation_angengingong.v1.json', import.meta.url,
+)), 'utf8'));
+const prepare = registry.prepareMiraTextbookPinyinPronunciation;
+const sha = (text: string) => createHash('sha256').update(text).digest('hex');
+const recipes = [
+  ['ɑng', 'ang1', '肮'], ['eng', 'eng1', '鞥'], ['ing', 'ying1', '英'], ['ong', 'ong1', '嗡'], ['ying', 'ying1', '英'],
+  ['bāng', 'bang1', '帮'], ['huáng', 'huang2', '黄'], ['qiáng', 'qiang2', '墙'], ['chuāng', 'chuang1', '窗'],
+  ['rēng', 'reng1', '扔'], ['héng', 'heng2', '横'], ['fēng', 'feng1', '风'], ['dēng', 'deng1', '灯'],
+  ['jǐng', 'jing3', '井'], ['bǐng', 'bing3', '饼'], ['tīng', 'ting1', '听'], ['qīng', 'qing1', '青'],
+  ['hǒng', 'hong3', '哄'], ['zhōng', 'zhong1', '中'], ['sòng', 'song4', '送'], ['qióng', 'qiong2', '穷'],
+  ['míng', 'ming2', '明'], ['liàng', 'liang4', '亮'], ['bīng', 'bing1', '冰'],
+  ['zì', 'zi4', '字'], ['xíng', 'xing2', '行'], ['chē', 'che1', '车'],
+] as const;
+
+describe('Exact back-nasal lesson pronunciation registration', () => {
+  it('matches the shared frozen backend policy without changing approval or provider settings', () => {
+    expect(registry.MIRA_TEXTBOOK_PINYIN_ANGENGINGONG_PRONUNCIATION_POLICY).toEqual(policy);
+    expect(registry.MIRA_TEXTBOOK_PINYIN_ANGENGINGONG_PRONUNCIATION_POLICY_SHA256).toBe(checksum);
+    expect(Object.keys(policy.symbols).sort()).toEqual(recipes.map(([token]) => token).sort());
+    expect(policy.words).toEqual({});
+    expect(policy.exactTextSsml).toBeUndefined();
+    expect(policy.listeningRequired).toBe(true);
+    for (const key of ['humanListeningVerified', 'perceptualToneVerified', 'pronunciationApproved', 'formalUseAllowed'])
+      expect(policy.approvalBoundary[key]).toBe(false);
+    const result = prepare('请听。', version);
+    expect(result.profile).toMatchObject({ policyVersion: version, policySha256: checksum });
+    expect(result.providerRequest).toMatchObject({ model: 'cosyvoice-v3-flash', input: {
+      voice: 'longanwen_v3', format: 'wav', sample_rate: 24000, enable_ssml: true,
+      rate: 1, pitch: 1, seed: 0, language_hints: ['zh'],
+    } });
+  });
+
+  it.each(recipes)('keeps the exact whole token %s and does not split its final', (token, phoneme, carrier) => {
+    expect(prepare(`请听：${token}。`, version).ssml)
+      .toBe(`<speak>请听：<phoneme alphabet="py" ph="${phoneme}">${carrier}</phoneme>。</speak>`);
+  });
+
+  it.each([
+    ['请听：ɑng、eng、ing、ong。ying。',
+      '0e4358a4a74410dbb51a46152cd1e69b2c709d98d1e18a6d9892001550cb9e4b',
+      '1cac4b2a3b017acb914414356a60d74690a43ef4e948727fc98f3b08af6de0f1'],
+    ['请听：bāng、huáng、qiáng、chuāng；rēng、héng、fēng、dēng；jǐng、bǐng、tīng、qīng；hǒng、zhōng、sòng、qióng。',
+      'b3f85e039be2eca411f179c20c5a891bd16537d74c69deba5293aed65de10667',
+      '3efc8a55e927e624d0d89a269a6985613f037ba9cc6b9e425fab133b43a8c43d'],
+    ['请听：míng liàng。bīng、zì、xíng、chē。',
+      'ea14ab51220c9e91efb39711bed9ad973d23efc0a0ef0d4680c0bd9f7aa1858b',
+      'b42c4ac3387ff444dd09317bfcea8f0c82299e85d8654fda5b7f72023ae816f5'],
+  ])('preserves the existing frozen probe SSML and physical body: %s', (text, ssmlSha, bodySha) => {
+    const prepared = prepare(text, version);
+    expect(prepared.profile.ssmlSha256).toBe(ssmlSha);
+    expect(prepared.providerPronunciation.providerBodySha256).toBe(bodySha);
+    expect(sha(prepared.providerBody)).toBe(bodySha);
+    expect(registry.isMiraTextbookPinyinProviderPronunciation(prepared.providerPronunciation, sha(text))).toBe(true);
+  });
+
+  it('admits the formal pure request validator and rejects a changed profile before any claim', () => {
+    const text = '小朋友，听老师读：ɑng、eng、ing、ong。';
+    const request = { requestId: `tbptts1_${'a'.repeat(64)}`, classroomId: 'classroom-pinyin',
+      classroomContentSha256: 'b'.repeat(64), subject: 'chinese', sceneId: 'scene-one', sceneOrder: 0,
+      actionId: 'speech-one', narrationSegmentId: 'speech-one', text, textSha256: sha(text),
+      teacherProfileId: 'mira_chinese_gentle', teacherProfileVersion: 2, teacherGender: 'female',
+      teacherProfileSha256: 'a5fd163af249705bda4bb0be5448f65d275eb423285557727f9c50ea442f01f8',
+      pronunciationProfile: prepare(text, version).profile };
+    expect(assertMiraFormalTtsRequest(request)).toEqual(request);
+    for (const profile of [{ ...request.pronunciationProfile, policyVersion: version + '-unknown' },
+      { ...request.pronunciationProfile, policySha256: '0'.repeat(64) },
+      { ...request.pronunciationProfile, ssmlSha256: '0'.repeat(64) }]) {
+      expect(() => assertMiraFormalTtsRequest({ ...request, pronunciationProfile: profile }))
+        .toThrow(MiraFormalAudioError);
+    }
+  });
+
+  it.each(['ang', 'ang1', 'ɑng1', 'éng', 'eng1', 'ong1', 'weng', 'weng1', 'hōng', 'qiong2',
+    'ying1', 'yīng', 'ɑngeng', 'a', 'g', 'un', 'ü', 'AN', 'ａｎｇ', 'a\u0304ng', 'constructor']) (
+    'rejects unapproved aliases and future tokens without normalization: %s', token => {
+      expect(() => prepare(`请听：${token}。`, version)).toThrow();
+    });
+
+  it('retains prior policy hashes and natural Chinese speech', () => {
+    expect(prepare('请听。', 'mira.textbook.pinyin-aneninunun-ssml.v1').profile.policySha256)
+      .toBe('f91fb1741934f79d0a2664aa68b69dccfec0042eb04f0000510669ef631d2865');
+    expect(prepare('请听。', 'mira.textbook.pinyin-ieueer-ssml.v1').profile.policySha256)
+      .toBe('27b702593fc628848ecad8dff8b21859d2bae2cc4de33f373e65c62a8f24da46');
+    expect(prepare('luó bo', 'mira.textbook.pinyin-aieiui-ssml.v4').ssml)
+      .toBe('<speak><sub alias="萝卜">luó bo</sub>。</speak>');
+    const text = '晴朗的天空里，窗户旁的灯很明亮。';
+    expect(prepare(text, version).ssml).toBe(`<speak>${text}</speak>`);
+    expect(prepare('看<&>：ong。', version).ssml)
+      .toBe('<speak>看&lt;&amp;&gt;：<phoneme alphabet="py" ph="ong1">嗡</phoneme>。</speak>');
+    expect(() => prepare('请听。', 'mira.textbook.pinyin-angengingong-ssml.v2')).toThrow();
+  });
+});
