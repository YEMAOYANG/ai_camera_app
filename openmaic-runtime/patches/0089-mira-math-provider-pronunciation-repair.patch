--- /dev/null
+++ b/lib/server/mira-formal-math-pronunciation.ts
@@ -0,0 +1,68 @@
+/** Physical TTS pronunciation only. Never changes the logical narration or its
+ * request hash, course snapshot, displayed notation, or ASR acceptance rules. */
+export const MIRA_FORMAL_MATH_TTS_PRONUNCIATION_POLICY = 'mira.math.tts-pronunciation.v1' as const;
+
+const DIGITS = '零一二三四五六七八九';
+const NUMERALS = `${DIGITS}两十百千万亿`;
+
+function smallInteger(value: number, omitLeadingOne: boolean): string {
+  let remaining = value;
+  if (remaining < 10) return DIGITS[remaining];
+  const parts: string[] = [];
+  let pendingZero = false;
+  for (const [unit, label] of [[1000, '千'], [100, '百'], [10, '十']] as const) {
+    const digit = Math.floor(remaining / unit);
+    remaining %= unit;
+    if (digit) {
+      if (pendingZero) { parts.push('零'); pendingZero = false; }
+      if (!(omitLeadingOne && unit === 10 && digit === 1 && parts.length === 0)) parts.push(DIGITS[digit]);
+      parts.push(label);
+    } else if (parts.length && remaining) pendingZero = true;
+  }
+  if (remaining) {
+    if (pendingZero) parts.push('零');
+    parts.push(DIGITS[remaining]);
+  }
+  return parts.join('');
+}
+
+function integer(value: string): string {
+  if (value.length > 1 && value.startsWith('0'))
+    return [...value].map(digit => DIGITS[Number(digit)]).join('');
+  // Primary-school large numbers use four-digit groups, not digit-by-digit
+  // reading. Beyond the supported exact range retain the supplied notation.
+  if (value.length > 12) return value;
+  let remaining = Number(value);
+  if (remaining < 10000) return smallInteger(remaining, true);
+  const parts: string[] = [];
+  let omittedGroup = false;
+  for (const [unit, label] of [[100000000, '亿'], [10000, '万'], [1, '']] as const) {
+    const group = Math.floor(remaining / unit);
+    remaining %= unit;
+    if (group) {
+      if (parts.length && (omittedGroup || group < 1000)) parts.push('零');
+      parts.push(smallInteger(group, parts.length === 0), label);
+      omittedGroup = false;
+    } else if (parts.length && remaining) omittedGroup = true;
+  }
+  return parts.join('');
+}
+
+export function prepareMiraMathTtsPronunciation(value: string): string {
+  // NFKC recognizes full-width math notation; retain punctuation and clause
+  // boundaries. Naming the % symbol once is different from a numeric percent.
+  let text = value.normalize('NFKC').replace(/百分号\s*%/gu, '百分号');
+  text = text.replace(/(?<![\d.])(\d+)\s*\/\s*(\d+)(?![\d.])/gu,
+    (_match, numerator: string, denominator: string) => `${denominator}分之${numerator}`);
+  text = text.replace(/(\d+(?:\.\d+)?)\s*%/gu, '百分之$1');
+  text = text.replace(/(\d+)\.(\d+)/gu, (_match, whole: string, fraction: string) =>
+    `${whole}点${[...fraction].map(digit => DIGITS[Number(digit)]).join('')}`);
+  text = text.replace(/\d+/gu, integer);
+  text = text.replaceAll('=', '等于').replaceAll('≈', '约等于').replaceAll('≠', '不等于')
+    .replaceAll('≤', '小于等于').replaceAll('≥', '大于等于')
+    .replaceAll('<', '小于').replaceAll('>', '大于')
+    .replaceAll('+', '加').replaceAll('×', '乘').replaceAll('*', '乘').replaceAll('÷', '除以');
+  text = text.replace(new RegExp(`(?<=[${NUMERALS}])\\s*[-−]\\s*(?=[${NUMERALS}])`, 'gu'), '减');
+  text = text.replace(new RegExp(`(?<![${NUMERALS}])[-−](?=[${NUMERALS}])`, 'gu'), '负');
+  return text.replaceAll('%', '百分号');
+}
