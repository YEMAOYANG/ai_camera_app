diff --git a/tests/server/mira-formal-math-pronunciation.test.ts b/tests/server/mira-formal-math-pronunciation.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-math-pronunciation.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from 'vitest';
+import { prepareMiraMathTtsPronunciation } from '@/lib/server/mira-formal-math-pronunciation';
+
+describe('physical math TTS pronunciation', () => {
+  it('reads the actual fifteenth narration with both fraction occurrences intact', () => {
+    const source = '同学们，刚才我们认识了百分数。先看初始的1/4：把整体平均分成4份，取其中1份；1除以4得到0.25，也就是25%，所以1/4 = 0.25 = 25%。橙色部分占整条的四分之一。接下来先不动手，猜一猜：2/5 会变成百分之几？';
+    const spoken = prepareMiraMathTtsPronunciation(source);
+    expect(spoken).toContain('初始的四分之一:把整体平均分成四份');
+    expect(spoken).toContain('一除以四得到零点二五,也就是百分之二十五');
+    expect(spoken).toContain('所以四分之一 等于 零点二五 等于 百分之二十五。');
+    expect(spoken).toContain('猜一猜:五分之二 会变成百分之几?');
+    expect(spoken).not.toMatch(/[\d/%=]/u);
+    expect(source).toContain('1/4 = 0.25 = 25%');
+  });
+
+  it('preserves exact values, operation direction and natural punctuation', () => {
+    expect(prepareMiraMathTtsPronunciation('3/5 = 0.6 = 60%；80 × 3/5 = 48。'))
+      .toBe('五分之三 等于 零点六 等于 百分之六十;八十 乘 五分之三 等于 四十八。');
+    expect(prepareMiraMathTtsPronunciation('5/3，0.250，37.5%，100 ÷ 4，7-2，-3。'))
+      .toBe('三分之五,零点二五零,百分之三十七点五,一百 除以 四,七减二,负三。');
+    expect(prepareMiraMathTtsPronunciation("百分号%表示'每一百'，60%就是每一百份中占60份。"))
+      .toBe("百分号表示'每一百',百分之六十就是每一百份中占六十份。");
+  });
+
+  it('reads primary-school large integers by ten-thousand and hundred-million groups', () => {
+    expect(prepareMiraMathTtsPronunciation('10000、10001、10010、100000000。'))
+      .toBe('一万、一万零一、一万零一十、一亿。');
+    expect(prepareMiraMathTtsPronunciation('123456789，100010001，9999999999999999'))
+      .toBe('一亿二千三百四十五万六千七百八十九,一亿零一万零一,9999999999999999');
+  });
+});
