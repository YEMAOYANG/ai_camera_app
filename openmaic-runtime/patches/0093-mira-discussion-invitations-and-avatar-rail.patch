+import type { Participant } from '@/lib/types/roundtable';
+
+/** Resolve a visible invitation anchor without changing the discussion's agent ID. */
+export function resolveDiscussionInvitePresenter(
+  participants: readonly Participant[],
+  agentId: string | undefined,
+): { role: 'student' | 'teacher'; participant: Participant | null } {
+  const student = participants.find((person) => person.id === agentId && person.role === 'student');
+  if (student) return { role: 'student', participant: student };
+
+  // Restored classrooms may omit the original initiator from their avatar roster.
+  // The teacher rail exists even without a teacher record, using its default art.
+  return {
+    role: 'teacher',
+    participant: participants.find((person) => person.role === 'teacher') || null,
+  };
+}
