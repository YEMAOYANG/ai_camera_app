+// @vitest-environment jsdom
+
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { DiscussionAction } from '@/lib/types/action';
+import { DISCUSSION_AUTO_SKIP_MS } from '@/lib/choreography';
+
+vi.mock('motion/react', () => ({
+  motion: {
+    div: (props: Record<string, unknown>) =>
+      createElement(
+        'div',
+        Object.fromEntries(
+          Object.entries(props).filter(([key]) => !['initial', 'animate', 'exit'].includes(key)),
+        ),
+      ),
+  },
+}));
+
+vi.mock('@/lib/hooks/use-i18n', () => ({
+  useI18n: () => ({ t: (key: string) => key }),
+}));
+
+import { ProactiveCard } from '@/components/chat/proactive-card';
+
+const roots: Root[] = [];
+const requestFrame = vi.fn<(callback: FrameRequestCallback) => number>();
+(
+  globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean }
+).IS_REACT_ACT_ENVIRONMENT = true;
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  // Keep the anchor stationary: render one positioning frame without running
+  // an unrelated animation loop while advancing the invitation countdown.
+  requestFrame.mockReset().mockReturnValue(1);
+  vi.stubGlobal('requestAnimationFrame', requestFrame);
+  vi.stubGlobal('cancelAnimationFrame', vi.fn());
+});
+
+afterEach(() => {
+  for (const root of roots.splice(0)) act(() => root.unmount());
+  document.body.replaceChildren();
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+function mount(required: boolean, mode: 'playback' | 'paused' = 'playback') {
+  const host = document.createElement('div');
+  const anchor = document.createElement('button');
+  document.body.append(host, anchor);
+  const root = createRoot(host);
+  roots.push(root);
+  const onSkip = vi.fn();
+  const onListen = vi.fn();
+
+  act(() =>
+    root.render(
+      createElement(ProactiveCard, {
+        action: {
+          id: 'discussion-invitation',
+          type: 'discussion',
+          topic: '用自己的话说：60% 表示什么？',
+          prompt: '请一起讨论百分数的含义。',
+        } as DiscussionAction,
+        required,
+        mode,
+        anchorRef: { current: anchor },
+        agentName: '小林同学',
+        onSkip,
+        onListen,
+        onTogglePause: vi.fn(),
+      }),
+    ),
+  );
+  act(() => requestFrame.mock.calls[0][0](0));
+
+  const card = document.querySelector<HTMLElement>('[data-mira-chrome="discussion-prompt"]')!;
+  expect(card).not.toBeNull();
+  return { card, onSkip, onListen };
+}
+
+async function passAutoSkipWindow() {
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(DISCUSSION_AUTO_SKIP_MS * 2);
+  });
+  // The progress update commits first; the separate effect then calls onSkip.
+  await act(async () => {});
+}
+
+describe('discussion invitation', () => {
+  it('keeps a required invitation visible until the student explicitly joins', async () => {
+    const { card, onSkip, onListen } = mount(true);
+    expect(card.querySelector('[title="proactiveCard.skip"]')).toBeNull();
+    expect(card.querySelector('[data-mira-indicator="discussion-progress-track"]')).toBeNull();
+    expect(card.textContent).not.toMatch(/\b\d+s\b/);
+    expect(card.querySelectorAll('button')).toHaveLength(1);
+
+    await passAutoSkipWindow();
+
+    expect(card.isConnected).toBe(true);
+    expect(card.textContent).toContain('用自己的话说：60% 表示什么？');
+    expect(onSkip).not.toHaveBeenCalled();
+    expect(onListen).not.toHaveBeenCalled();
+
+    act(() => card.querySelector('button')!.click());
+    expect(onListen).toHaveBeenCalledTimes(1);
+    expect(onSkip).not.toHaveBeenCalled();
+  });
+
+  it('retains the countdown and automatic skip for optional invitations', async () => {
+    const { card, onSkip, onListen } = mount(false);
+    expect(card.querySelector('[title="proactiveCard.skip"]')).not.toBeNull();
+    expect(card.querySelector('[data-mira-indicator="discussion-progress-track"]')).not.toBeNull();
+    expect(onSkip).not.toHaveBeenCalled();
+
+    await passAutoSkipWindow();
+
+    expect(onSkip).toHaveBeenCalledTimes(1);
+    expect(onListen).not.toHaveBeenCalled();
+  });
+
+  it('does not count down or auto-skip an optional invitation while paused', async () => {
+    const { card, onSkip, onListen } = mount(false, 'paused');
+    const progress = card.querySelector<HTMLElement>(
+      '[data-mira-indicator="discussion-progress"]',
+    )!;
+    expect(progress.style.width).toBe('100%');
+
+    await passAutoSkipWindow();
+
+    expect(progress.style.width).toBe('100%');
+    expect(onSkip).not.toHaveBeenCalled();
+    expect(onListen).not.toHaveBeenCalled();
+  });
+});
