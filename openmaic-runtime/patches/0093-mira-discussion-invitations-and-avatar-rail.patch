+import { describe, expect, it } from 'vitest';
+import { resolveDiscussionInvitePresenter } from '@/components/roundtable/discussion-invite-presenter';
+import type { Participant } from '@/lib/types/roundtable';
+
+const teacher: Participant = {
+  id: 'teacher',
+  name: '老师',
+  avatar: '/teacher.png',
+  role: 'teacher',
+  isOnline: true,
+};
+const student: Participant = {
+  id: 'classmate',
+  name: '同学',
+  avatar: '/student.png',
+  role: 'student',
+  isOnline: true,
+};
+
+describe('discussion invitation display anchors', () => {
+  it('anchors an available initiator to that student', () => {
+    expect(resolveDiscussionInvitePresenter([teacher, student], student.id)).toEqual({
+      role: 'student',
+      participant: student,
+    });
+  });
+
+  it('uses the visible teacher when a restored initiator is missing or unspecified', () => {
+    for (const agentId of ['previous-classmate', undefined, teacher.id]) {
+      expect(resolveDiscussionInvitePresenter([teacher, student], agentId)).toEqual({
+        role: 'teacher',
+        participant: teacher,
+      });
+    }
+  });
+
+  it('keeps the default teacher anchor available without any teacher record', () => {
+    expect(resolveDiscussionInvitePresenter([student], 'previous-classmate')).toEqual({
+      role: 'teacher',
+      participant: null,
+    });
+  });
+});
