+// @vitest-environment jsdom
+import { act, createElement, Fragment } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { InteractiveIframeHost } from '@/components/scene-renderers/InteractiveIframeHost';
+import { InteractiveRenderer } from '@/components/scene-renderers/interactive-renderer';
+import {
+  injectStudentActivityControls,
+  planStudentActivityControls,
+  SHORT_LANDSCAPE_QUERY,
+  STUDENT_ACTIVITY_CONTROLS_MESSAGE,
+  studentActivityControlsKey,
+} from '@/lib/interactive/student-activity-controls';
+import { useInteractiveIframePool } from '@/lib/store/interactive-iframe-pool';
+import { useStageStore } from '@/lib/store/stage';
+import type { InteractiveContent, Scene, Stage } from '@/lib/types/stage';
+import { CLASSROOM_TOUCH_CONTROL_SIZE, classroomControlCss } from '@/lib/ui/classroom-controls';
+import { patchHtmlForIframe } from '@/lib/utils/iframe';
+
+vi.mock('@/lib/contexts/mira-student-runtime-context', () => ({
+  useMiraStudentRuntime: () => true,
+  useMiraStudentRuntimeEvents: () => null,
+}));
+vi.mock('@/lib/mira/student-interaction-bridge', () => ({
+  studentInteractionObjectives: () => [],
+  connectStudentInteractionFrame: vi.fn(),
+  STUDENT_INTERACTION_OBSERVER: '',
+}));
+vi.mock('@/lib/hooks/use-i18n', () => ({ useI18n: () => ({ t: (key: string) => key }) }));
+
+const stage = { id: 'tbpub_' + 'c'.repeat(24), fixedTextbook: true } as Stage & { fixedTextbook: boolean };
+const source = '<!doctype html><html><head></head><body><div id="cv"></div></body></html>';
+const binding = {
+  schemaVersion: 'mira.textbook.student-activity-controls.v1',
+  releaseSha256: 'a'.repeat(64),
+  contentSha256: 'b'.repeat(64),
+  template: 'sortingDepot',
+  version: 1,
+} as const;
+const game = {
+  id: 'interactive', stageId: stage.id, type: 'interactive', order: 0,
+  content: { type: 'interactive', html: source },
+  miraStudentActivityControls: binding,
+} as Scene;
+const key = studentActivityControlsKey(true, stage, game)!;
+const slot = { left: 8, top: 56, width: 623, height: 143 };
+const compactPlan = planStudentActivityControls(slot, slot)!;
+const rails = '[data-mira-student-activity-rails]';
+const targets = '[data-mira-student-activity-rail-button]';
+
+describe('Gateway binding and visible geometry', () => {
+  it('accepts the two exact approved template contracts', () => {
+    for (const template of ['sortingDepot', 'bubbleMaze'] as const) {
+      expect(studentActivityControlsKey(true, stage,
+        { ...game, miraStudentActivityControls: { ...binding, template } })).toMatch(new RegExp(template + ':1$'));
+    }
+    expect(SHORT_LANDSCAPE_QUERY).toBe('(max-width: 640px) and (max-height: 380px) and (orientation: landscape)');
+  });
+
+  it('requires the student fixed textbook and a complete scene with a valid binding', () => {
+    expect(studentActivityControlsKey(false, stage, game)).toBeUndefined();
+    expect(studentActivityControlsKey(true, { ...stage, fixedTextbook: false } as Stage, game)).toBeUndefined();
+    expect(studentActivityControlsKey(true, stage, { ...game, stageId: 'another-classroom' })).toBeUndefined();
+    expect(studentActivityControlsKey(true, { ...stage, id: 'direct-preview' },
+      { ...game, stageId: 'direct-preview' })).toBeUndefined();
+    expect(studentActivityControlsKey(true, stage, { ...game, miraActivity: { id: 'other', section: 'games' } })).toBeUndefined();
+    expect(studentActivityControlsKey(true, stage, { ...game, miraPageSummary: true })).toBeUndefined();
+    expect(studentActivityControlsKey(true, stage, { ...game, miraStudentActivityControls: undefined })).toBeUndefined();
+    const malformed = [
+      { releaseSha256: '0' }, { contentSha256: 7 }, { template: 'shutterScout' },
+      { schemaVersion: 'wrong' }, { version: 2 }, { unexpected: true },
+    ];
+    for (const value of malformed) {
+      expect(studentActivityControlsKey(true, stage, {
+        ...game, miraStudentActivityControls: { ...binding, ...value },
+      } as Scene)).toBeUndefined();
+    }
+    expect(injectStudentActivityControls(source, '</script>')).toBe(source);
+  });
+
+  it('keeps seven 48px targets outside the original canvas and inside the real clip', () => {
+    expect(compactPlan.buttons).toHaveLength(7);
+    expect(compactPlan.canvas).toEqual({ left: expect.any(Number), top: 0, width: expect.any(Number), height: 143 });
+    const size = CLASSROOM_TOUCH_CONTROL_SIZE;
+    expect(size).toBe(48);
+    const intersects = (a: { left: number; top: number }, b: { left: number; top: number }) =>
+      Math.abs(a.left - b.left) < size && Math.abs(a.top - b.top) < size;
+    for (const [index, rect] of compactPlan.buttons.entries()) {
+      expect(rect.top).toBeGreaterThanOrEqual(6);
+      expect(rect.top + size).toBeLessThanOrEqual(slot.height - 6);
+      expect(rect.left).toBeGreaterThanOrEqual(6);
+      expect(rect.left + size).toBeLessThanOrEqual(slot.width - 6);
+      expect(rect.left + size <= compactPlan.canvas.left
+        || rect.left >= compactPlan.canvas.left + compactPlan.canvas.width).toBe(true);
+      expect(compactPlan.buttons.slice(index + 1).some(other => intersects(rect, other))).toBe(false);
+    }
+    expect(planStudentActivityControls(slot, { ...slot, width: 570 })).toBeNull();
+    expect(planStudentActivityControls(slot, { ...slot, top: slot.top + 1 })).toBeNull();
+    expect(planStudentActivityControls({ ...slot, height: 260 }, { ...slot, height: 260 })).toBeNull();
+    expect(planStudentActivityControls({ ...slot, width: Infinity }, slot)).toBeNull();
+    expect(classroomControlCss('iframe')).toContain('--mira-classroom-secondary-size: 48px');
+  });
+});
+
+const shim = '[data-mira-student-activity-controls]';
+type Delivery = 'inline' | 'gateway-wrapper';
+const deliveries: Delivery[] = ['inline', 'gateway-wrapper'];
+
+function deliveredHtml(mode: Delivery, html = source) {
+  if (mode === 'inline') return html;
+  const page = JSON.stringify(html).replace(/</g, '\\u003c');
+  return '<!doctype html><html><head><meta charset="utf-8"></head><body><script>'
+    + '(function(){const assets=[];let page=' + page + ';'
+    + 'for(const asset of assets){const binary=atob(asset.base64);const bytes=new Uint8Array(binary.length);'
+    + 'for(let i=0;i<binary.length;i++)bytes[i]=binary.charCodeAt(i);'
+    + 'const url=URL.createObjectURL(new Blob([bytes],{type:asset.mimeType}));page=page.split(asset.path).join(url);}'
+    + 'document.open();document.write(page);document.close();})();</script></body></html>';
+}
+
+function activityDocument(mode: Delivery, html: string): Document {
+  const parse = (input: string) => new DOMParser().parseFromString(input, 'text/html');
+  const outer = parse(html);
+  if (mode === 'inline') return outer;
+  expect(outer.querySelector(shim)).toBeNull();
+  let content = '';
+  const write = vi.fn((value: string) => { content = value; });
+  const transport = { open: vi.fn(), write, close: vi.fn() };
+  const script = outer.body.querySelector('script')!;
+  new Function('document', script.textContent!)(transport);
+  expect(transport.open).toHaveBeenCalledOnce();
+  expect(write).toHaveBeenCalledOnce();
+  expect(transport.close).toHaveBeenCalledOnce();
+  return parse(content);
+}
+
+function childFixture(mode: Delivery = 'inline') {
+  const doc = document.implementation.createHTMLDocument();
+  const buttons = ['left', 'right', 'up', 'down', 'action']
+    .map(name => '<button class="arc-key" data-arc-input="' + name + '"></button>').join('');
+  doc.body.innerHTML = '<div id="cv" class="classic-arcade"><canvas></canvas><div class="arc-controls" hidden>'
+    + '<button class="arc-key arc-music" aria-pressed="true" style="color:red"></button>'
+    + '<button class="arc-key arc-voice" hidden disabled></button><div class="arc-pad">' + buttons + '</div>'
+    + '</div><div id="unchanged"></div></div>';
+  const delivered = deliveredHtml(mode);
+  const actual = activityDocument(mode, patchHtmlForIframe(injectStudentActivityControls(delivered, key)));
+  expect(actual.querySelectorAll('style' + shim)).toHaveLength(1);
+  expect(actual.querySelectorAll('script' + shim)).toHaveLength(1);
+  doc.head.innerHTML = actual.head.innerHTML;
+  const script = doc.head.querySelector('script[data-mira-student-activity-controls]')!;
+  const canvas = doc.querySelector<HTMLDivElement>('#cv')!;
+  const bar = doc.querySelector<HTMLDivElement>('.arc-controls')!;
+  const originals = [...bar.querySelectorAll<HTMLButtonElement>('button')];
+  const other = doc.querySelector('#unchanged')!;
+  let bounds = compactPlan.canvas;
+  canvas.getBoundingClientRect = () => DOMRect.fromRect({
+    x: bounds.left, y: bounds.top, width: bounds.width, height: bounds.height,
+  });
+  let frame: (() => void) | undefined;
+  const parent = {};
+  const callbacks = new Map<string, (event: unknown) => void>();
+  const child = {
+    parent,
+    requestAnimationFrame(callback: () => void) { frame = callback; return 1; },
+    cancelAnimationFrame() { frame = undefined; },
+    addEventListener(name: string, listener: (event: unknown) => void) { callbacks.set(name, listener); },
+  };
+  new Function('window', 'document', script.textContent!)(child, doc);
+  return { doc, canvas, bar, originals, other,
+    send(plan: typeof compactPlan | null, options = {}) {
+      callbacks.get('message')!({
+        source: parent, isTrusted: true, data: { type: STUDENT_ACTIVITY_CONTROLS_MESSAGE, key, plan }, ...options,
+      });
+      const pending = frame;
+      frame = undefined;
+      pending?.();
+    },
+    setBounds(next: typeof compactPlan.canvas) { bounds = next; },
+  };
+}
+
+describe('isolated document reuses the real controls', () => {
+  it.each(deliveries)('keeps native handlers and restores the same DOM for %s delivery', mode => {
+    const { doc, bar, canvas, originals, other, send } = childFixture(mode);
+    const click = vi.fn();
+    originals[0].addEventListener('click', click);
+    const attributes = (button: HTMLButtonElement) => [...button.attributes]
+      .filter(attr => attr.name !== 'style').map(attr => [attr.name, attr.value]);
+    const originalAttrs = originals.map(attributes);
+    send(compactPlan);
+    expect(bar.parentElement).toBe(doc.body);
+    expect([...bar.querySelectorAll(targets)]).toEqual(originals);
+    expect(bar.hidden).toBe(true);
+    expect(originals[1].hidden && originals[1].disabled).toBe(true);
+    expect(originals[0].getAttribute('aria-pressed')).toBe('true');
+    expect(originals[0].getAttribute('data-mira-activity-control')).toBe('secondary');
+    bar.hidden = false;
+    originals[0].click();
+    expect(click).toHaveBeenCalledOnce();
+    send(compactPlan);
+    expect(doc.querySelectorAll(rails)).toHaveLength(1);
+    send(null);
+    expect(bar.parentElement).toBe(canvas);
+    expect(bar.nextElementSibling).toBe(other);
+    expect(bar.hidden).toBe(false);
+    expect(originals.map(attributes)).toEqual(originalAttrs);
+    expect(originals[0].style.color).toBe('red');
+    expect(originals.every(button => !button.style.getPropertyValue('--mira-student-activity-button-left'))).toBe(true);
+    expect(originals.slice(1).every(button => !button.hasAttribute('style'))).toBe(true);
+    originals[0].click();
+    expect(click).toHaveBeenCalledTimes(2);
+  });
+
+  it('rejects stale or synthetic plans, an unexpected key set, and mismatched child bounds', () => {
+    const { canvas, bar, originals, send, setBounds } = childFixture();
+    send(compactPlan, { source: {} });
+    send(compactPlan, { isTrusted: false });
+    send(compactPlan, { data: { type: STUDENT_ACTIVITY_CONTROLS_MESSAGE, key: 'old', plan: compactPlan } });
+    expect(bar.parentElement).toBe(canvas);
+    setBounds({ ...compactPlan.canvas, top: 3 });
+    send(compactPlan);
+    expect(bar.parentElement).toBe(canvas);
+    setBounds(compactPlan.canvas);
+    originals[6].setAttribute('data-arc-input', 'shutter');
+    send(compactPlan);
+    expect(bar.parentElement).toBe(canvas);
+    expect(bar.querySelectorAll(targets)).toHaveLength(0);
+  });
+});
+
+describe('real renderer and host use the same delivered scene', () => {
+  let root: ReturnType<typeof createRoot> | undefined;
+  afterEach(async () => {
+    await act(async () => root?.unmount());
+    root = undefined;
+    document.body.replaceChildren();
+    useInteractiveIframePool.getState().reset();
+    useStageStore.setState({ stage: null, scenes: [], currentSceneId: null });
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+  });
+
+  async function setup(scene: Scene) {
+    vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true);
+    vi.stubGlobal('innerWidth', 640);
+    vi.stubGlobal('innerHeight', 360);
+    let compact = true;
+    const listeners = new Set<() => void>();
+    vi.stubGlobal('matchMedia', () => ({
+      get matches() { return compact; },
+      addEventListener: (_event: string, listener: () => void) => listeners.add(listener),
+      removeEventListener: (_event: string, listener: () => void) => listeners.delete(listener),
+    }));
+    const send = vi.fn();
+    vi.spyOn(HTMLIFrameElement.prototype, 'contentWindow', 'get').mockReturnValue({ postMessage: send } as unknown as Window);
+    useStageStore.setState({ stage, scenes: [scene], currentSceneId: scene.id });
+    const element = document.createElement('div');
+    document.body.appendChild(element);
+    root = createRoot(element);
+    await act(async () => root!.render(createElement(Fragment, null,
+      createElement(InteractiveRenderer, { sceneId: scene.id, content: scene.content as InteractiveContent }),
+      createElement<{ container: HTMLElement }>(InteractiveIframeHost, { container: element }),
+    )));
+    await act(async () => useInteractiveIframePool.getState().setRect(scene.id, slot));
+    return { send, frame: element.querySelector('iframe')!,
+      async wide() {
+        compact = false;
+        await act(async () => listeners.forEach(listener => listener()));
+      },
+    };
+  }
+
+  it('uses an unscaled iframe on a regular 640 viewport and keeps the same iframe on exit', async () => {
+    const { send, frame, wide } = await setup(game);
+    const originalSrc = frame.getAttribute('srcdoc');
+    expect(originalSrc).toContain('data-mira-student-activity-controls');
+    expect(frame.style.width).toBe('623px');
+    expect(frame.style.transform).toBe('none');
+    expect(frame.getAttribute('data-mira-student-activity-layout')).toBe('side-rails');
+    expect(send).toHaveBeenCalledWith({ type: STUDENT_ACTIVITY_CONTROLS_MESSAGE, key, plan: compactPlan }, '*');
+    await wide();
+    expect(document.querySelector('iframe')).toBe(frame);
+    expect(frame.getAttribute('srcdoc')).toBe(originalSrc);
+    expect(frame.style.width).toBe('1280px');
+    expect(frame.style.transform).toMatch(/^scale\(/);
+    expect(frame.getAttribute('data-mira-student-activity-layout')).toBeNull();
+    const layouts = send.mock.calls.filter(([data]) => data.type === STUDENT_ACTIVITY_CONTROLS_MESSAGE);
+    expect(layouts.at(-1)).toEqual([{ type: STUDENT_ACTIVITY_CONTROLS_MESSAGE, key, plan: null }, '*']);
+  });
+
+  it('deactivates the outgoing scene without replacing its source document', async () => {
+    const { send, frame } = await setup(game);
+    const originalSrc = frame.getAttribute('srcdoc');
+    await act(async () => useStageStore.setState({ currentSceneId: 'another-scene' }));
+    expect(document.querySelector('iframe')).toBe(frame);
+    expect(frame.getAttribute('srcdoc')).toBe(originalSrc);
+    expect(frame.getAttribute('data-mira-student-activity-layout')).toBeNull();
+    expect(send).toHaveBeenCalledWith({ type: STUDENT_ACTIVITY_CONTROLS_MESSAGE, key, plan: null }, '*');
+  });
+
+  it('passes the original Gateway wrapper to the adapter before generic iframe patches', async () => {
+    const scene = { ...game, content: { type: 'interactive', html: deliveredHtml('gateway-wrapper') } } as Scene;
+    const { frame } = await setup(scene);
+    const inner = activityDocument('gateway-wrapper', frame.getAttribute('srcdoc')!);
+    expect(inner.querySelectorAll('style' + shim)).toHaveLength(1);
+    expect(inner.querySelectorAll('script' + shim)).toHaveLength(1);
+  });
+
+  it.each(deliveries)('leaves an unbound %s document on its original viewport', async mode => {
+    const scene = { ...game, content: { type: 'interactive', html: deliveredHtml(mode) },
+      miraStudentActivityControls: undefined } as Scene;
+    const { send, frame } = await setup(scene);
+    expect(activityDocument(mode, frame.getAttribute('srcdoc')!).querySelector(shim)).toBeNull();
+    expect(frame.style.width).toBe('1280px');
+    expect(send.mock.calls.some(([data]) => data.type === STUDENT_ACTIVITY_CONTROLS_MESSAGE)).toBe(false);
+  });
+});
