diff --git a/lib/interactive/student-activity-controls.ts b/lib/interactive/student-activity-controls.ts
new file mode 100644
index 0000000..53ac4b4
--- /dev/null
+++ b/lib/interactive/student-activity-controls.ts
@@ -0,0 +1,217 @@
+import { intersectClientBoxes, type ClientBox } from '@/lib/edit/visible-client-rect';
+import { mapEmbeddedActivityDocument } from '@/lib/mira/activity-checkpoint-adapters';
+import type { Scene } from '@/lib/types/stage';
+import { CLASSROOM_TOUCH_CONTROL_SIZE } from '@/lib/ui/classroom-controls';
+import { injectIntoDocumentHead } from '@/lib/utils/html-document';
+import { fitGenUiViewport } from './logical-viewport';
+
+export const SHORT_LANDSCAPE_QUERY = '(max-width: 640px) and (max-height: 380px) and (orientation: landscape)';
+export const STUDENT_ACTIVITY_CONTROLS_MESSAGE = 'mira:student-activity-controls';
+const SHA256 = /^[a-f0-9]{64}$/;
+const GAP = 8;
+const EDGE = 6;
+const TARGET = CLASSROOM_TOUCH_CONTROL_SIZE;
+const PITCH = TARGET + GAP;
+const ROWS = 2;
+const railWidth = (columns: number) => columns * PITCH - GAP;
+
+// Both certified v1 templates have these seven native buttons. The selectors
+// constrain the move; they do not opt an authored document in.
+const BUTTONS = [
+  { selector: ':scope > button.arc-key.arc-music', side: 'left', column: 0, row: 1 },
+  { selector: ':scope > button.arc-key.arc-voice', side: 'left', column: 1, row: 1 },
+  { selector: ':scope > .arc-pad > button.arc-key[data-arc-input="left"]', side: 'right', column: 0, row: 1 },
+  { selector: ':scope > .arc-pad > button.arc-key[data-arc-input="right"]', side: 'right', column: 2, row: 1 },
+  { selector: ':scope > .arc-pad > button.arc-key[data-arc-input="up"]', side: 'right', column: 1, row: 0 },
+  { selector: ':scope > .arc-pad > button.arc-key[data-arc-input="down"]', side: 'right', column: 1, row: 1 },
+  { selector: ':scope > .arc-pad > button.arc-key[data-arc-input="action"]', side: 'right', column: 2, row: 0 },
+] as const;
+
+export function studentActivityControlsKey(
+  studentMode: boolean,
+  stage: { readonly id: string } | null | undefined,
+  scene: Scene | null | undefined,
+): string | undefined {
+  const fixedTextbook = (stage as { fixedTextbook?: unknown } | null | undefined)?.fixedTextbook;
+  const binding = scene?.miraStudentActivityControls;
+  if (!studentMode || fixedTextbook !== true || !stage || !scene || scene.miraPageSummary
+      || !/^tbpub_[a-f0-9]{24}$/.test(stage.id) || scene.stageId !== stage.id || scene.miraActivity
+      || scene.type !== 'interactive' || scene.content.type !== 'interactive'
+      || typeof scene.content.html !== 'string' || !scene.content.html.trim()
+      || !binding || Object.keys(binding).length !== 5
+      || binding.schemaVersion !== 'mira.textbook.student-activity-controls.v1' || binding.version !== 1
+      || typeof binding.releaseSha256 !== 'string' || !SHA256.test(binding.releaseSha256)
+      || typeof binding.contentSha256 !== 'string' || !SHA256.test(binding.contentSha256)
+      || (binding.template !== 'sortingDepot' && binding.template !== 'bubbleMaze')) return;
+  // The gateway binds the source HTML before media embedding. The delivered
+  // HTML differs, so the runtime pairs that certified identity with its srcDoc.
+  return [binding.releaseSha256, binding.contentSha256, binding.template, binding.version].join(':');
+}
+
+export interface StudentActivityControlsPlan {
+  readonly canvas: ClientBox;
+  readonly buttons: readonly { readonly left: number; readonly top: number }[];
+}
+
+export function planStudentActivityControls(
+  slot: ClientBox, clip: ClientBox,
+): StudentActivityControlsPlan | null {
+  if (![slot, clip].every(box => [box.left, box.top, box.width, box.height].every(Number.isFinite)
+      && box.width > 0 && box.height > 0)) return null;
+  const visible = intersectClientBoxes(slot, clip);
+  const { box: canvas } = fitGenUiViewport(slot, 'fixed');
+  const left = canvas.left - GAP - railWidth(2);
+  const right = canvas.left + canvas.width + GAP;
+  const top = visible.top + (visible.height - railWidth(ROWS)) / 2;
+  if (left < visible.left + EDGE || right + railWidth(3) > visible.left + visible.width - EDGE
+      || top < visible.top + EDGE || canvas.top < visible.top
+      || canvas.top + canvas.height > visible.top + visible.height) return null;
+  return {
+    canvas: { ...canvas, left: canvas.left - slot.left, top: canvas.top - slot.top },
+    buttons: BUTTONS.map(({ side, column, row }) => ({
+      left: (side === 'left' ? left : right) + column * PITCH - slot.left,
+      top: top + row * PITCH - slot.top,
+    })),
+  };
+}
+
+export function compactActivityViewport(): boolean {
+  return typeof window !== 'undefined' && typeof window.matchMedia === 'function'
+    && window.matchMedia(SHORT_LANDSCAPE_QUERY).matches;
+}
+
+export function subscribeCompactActivityViewport(update: () => void): () => void {
+  const media = window.matchMedia?.(SHORT_LANDSCAPE_QUERY);
+  media?.addEventListener('change', update);
+  return () => media?.removeEventListener('change', update);
+}
+
+const RAILS_ATTRIBUTE = 'data-mira-student-activity-rails';
+const BUTTON_ATTRIBUTE = 'data-mira-student-activity-rail-button';
+const shimStyle = `<style data-mira-student-activity-controls>
+  .arc-controls[${RAILS_ATTRIBUTE}] {
+    position: absolute; inset: 0; pointer-events: none;
+    --mira-classroom-secondary-size: ${TARGET}px;
+  }
+  .arc-controls[${RAILS_ATTRIBUTE}] button[${BUTTON_ATTRIBUTE}] {
+    position: absolute;
+    left: var(--mira-student-activity-button-left);
+    top: var(--mira-student-activity-button-top);
+    touch-action: none !important;
+  }
+</style>`;
+
+/** Install a dormant adapter in this exact document. Resizing and visibility
+ * only change the plan message, never srcDoc or the authored game state. */
+export function injectStudentActivityControls(html: string, key: string): string {
+  if (!/^[a-f0-9]{64}:[a-f0-9]{64}:(sortingDepot|bubbleMaze):1$/.test(key)) return html;
+  const shim = shimStyle + `<script data-mira-student-activity-controls>
+(function () {
+  const key = ${JSON.stringify(key)};
+  const selectors = ${JSON.stringify(BUTTONS.map(button => button.selector))};
+  const railsAttribute = ${JSON.stringify(RAILS_ATTRIBUTE)};
+  const buttonAttribute = ${JSON.stringify(BUTTON_ATTRIBUTE)};
+  const roles = [buttonAttribute, 'data-mira-activity-control', 'data-mira-control-icon'];
+  const styles = ['--mira-student-activity-button-left', '--mira-student-activity-button-top'];
+  let plan = null, mounted = null, frame = 0;
+
+  function move(bar, parent, before) {
+    const focus = bar.contains(document.activeElement) ? document.activeElement : null;
+    if (typeof parent.moveBefore === 'function' && bar.isConnected && parent.isConnected) {
+      parent.moveBefore(bar, before);
+    } else parent.insertBefore(bar, before);
+    if (focus && document.activeElement !== focus) focus.focus({ preventScroll: true });
+  }
+
+  function restore() {
+    if (!mounted) return;
+    const { canvas, bar, following, buttons, original } = mounted;
+    move(bar, canvas, following?.parentNode === canvas ? following : null);
+    bar.removeAttribute(railsAttribute);
+    buttons.forEach((button, index) => {
+      const state = original[index];
+      roles.forEach((name, i) => {
+        if (state.attrs[i] === null) button.removeAttribute(name);
+        else button.setAttribute(name, state.attrs[i]);
+      });
+      styles.forEach((name, i) => {
+        const [value, priority] = state.styles[i];
+        if (value) button.style.setProperty(name, value, priority);
+        else button.style.removeProperty(name);
+      });
+      if (!state.hadStyle && !button.getAttribute('style')) button.removeAttribute('style');
+    });
+    mounted = null;
+  }
+
+  function apply() {
+    frame = 0;
+    const canvases = document.querySelectorAll('body > #cv.classic-arcade');
+    const canvas = canvases.length === 1 ? canvases[0] : null;
+    if (!plan || !canvas) { restore(); return; }
+    const bounds = canvas.getBoundingClientRect();
+    // A similarly shaped document or a slot whose layout is still changing
+    // cannot put controls into the illustration or over an adjacent panel.
+    if (!['left', 'top', 'width', 'height'].every(name => Math.abs(bounds[name] - plan.canvas[name]) <= 1)) {
+      restore();
+      return;
+    }
+    if (!mounted) {
+      const bars = canvas.querySelectorAll(':scope > .arc-controls');
+      const bar = bars.length === 1 ? bars[0] : null;
+      if (!bar || bar.hasAttribute(railsAttribute) || bar.querySelectorAll('button').length !== selectors.length) return;
+      const groups = selectors.map(selector => [...bar.querySelectorAll(selector)]);
+      if (groups.some(group => group.length !== 1
+          || group[0].matches('[data-mira-picture-choice], [draggable="true"], [' + buttonAttribute + ']'))) return;
+      const buttons = groups.map(group => group[0]);
+      if (new Set(buttons).size !== selectors.length) return;
+      const original = buttons.map(button => ({
+        attrs: roles.map(name => button.getAttribute(name)),
+        hadStyle: button.hasAttribute('style'),
+        styles: styles.map(name => [button.style.getPropertyValue(name), button.style.getPropertyPriority(name)]),
+      }));
+      mounted = { canvas, bar, following: bar.nextSibling, buttons, original };
+      bar.setAttribute(railsAttribute, '');
+      for (const button of buttons) {
+        button.setAttribute(buttonAttribute, '');
+        button.setAttribute('data-mira-activity-control', 'secondary');
+        button.setAttribute('data-mira-control-icon', '');
+      }
+      move(bar, document.body, canvas.nextSibling);
+    }
+    mounted.buttons.forEach((button, index) => {
+      const { left, top } = plan.buttons[index];
+      button.style.setProperty(styles[0], left + 'px');
+      button.style.setProperty(styles[1], top + 'px');
+    });
+  }
+
+  function schedule() {
+    if (plan && !frame) frame = window.requestAnimationFrame(apply);
+  }
+
+  window.addEventListener('message', event => {
+    const data = event.data;
+    if (event.source !== window.parent || !event.isTrusted
+        || data?.type !== ${JSON.stringify(STUDENT_ACTIVITY_CONTROLS_MESSAGE)} || data.key !== key) return;
+    const next = data.plan;
+    if (next !== null && (!next?.canvas || !Array.isArray(next.buttons) || next.buttons.length !== selectors.length
+        || next.buttons.some(button => !Number.isFinite(button?.left) || !Number.isFinite(button?.top)))) return;
+    plan = next;
+    if (!plan) {
+      if (frame) window.cancelAnimationFrame(frame);
+      frame = 0;
+      restore();
+      return;
+    }
+    schedule();
+  });
+  window.addEventListener('resize', schedule);
+  document.addEventListener('DOMContentLoaded', schedule, { once: true });
+})();
+</script>`;
+  const inject = (document: string) => injectIntoDocumentHead(document, shim);
+  // Large Gateway deliveries replace the outer document with the activity.
+  // Install the adapter inside the replacement so it survives document.open().
+  return mapEmbeddedActivityDocument(html, inject) ?? inject(html);
+}
