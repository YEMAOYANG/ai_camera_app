+import { mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { createHash, randomUUID } from 'node:crypto';
+import sharp from 'sharp';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { reviewFormalVisualSnapshot } from '@/lib/server/mira-formal-visual-review';
+import { assertVisualReview, formalVisualModel, selectedFormalVisualModel, VISUAL_RUBRIC_VERSION,
+  type VisualInput, type VisualReviewReceipt } from '@/lib/server/mira-formal-visual-contract';
+import { measureModelInput, DEEPSEEK_IMAGE_TOKEN_CEILING, DEEPSEEK_CURRENT_FLASH_IMAGE_TOKEN_CEILING,
+  FORMAL_VISION_MODEL } from '@/lib/server/mira-vision-meter';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+
+const mocks = vi.hoisted(() => ({ resolve: vi.fn(), call: vi.fn(), paid: vi.fn() }));
+vi.mock('@/lib/server/resolve-model', () => ({ resolveModel: mocks.resolve }));
+vi.mock('@/lib/ai/llm', () => ({ callLLM: mocks.call }));
+vi.mock('@/lib/server/mira-paid-budget', () => ({ paidBudgetContext: { getStore: mocks.paid } }));
+vi.mock('ai', () => ({ wrapLanguageModel: ({ model }: { model: unknown }) => model,
+  defaultSettingsMiddleware: (value: unknown) => value }));
+const id = 'deepseek-v4.1-flash-candidate-v1';
+let folder: string, input: VisualInput, png: Buffer;
+function returnedReview() {
+  return { sceneReviews: [{ observationIndex: 0, legibility: 'passed', layout: 'passed',
+    teachingGraphic: 'passed', interactionAffordance: 'passed', notes: '两组苹果清晰，点按入口和结果区域可见。' }] };
+}
+function resolved(modelId = 'deepseek-flash', baseUrl = 'https://api.deepseek.com/v1') {
+  return { providerId: 'deepseek', modelId, model: { modelId }, apiKey: 'test-only-key', baseUrl };
+}
+function frozenReceipt(modelId: string, modelPolicyId?: typeof id): VisualReviewReceipt {
+  const unsigned = { schemaVersion: 'mira.openmaic.visual-review.v1' as const, reviewerKind: 'vision_model' as const,
+    status: 'passed' as const, rubricVersion: VISUAL_RUBRIC_VERSION, snapshotSha256: input.snapshotSha256,
+    teachingQualityContextSha256: input.teachingQualityContextSha256,
+    ...(modelPolicyId ? { modelPolicyId } : {}), sceneReviews: input.observations.map(o => ({
+      sceneId: o.sceneId, sceneSha256: o.sceneSha256, viewport: o.viewport, screenshotSha256: o.screenshotSha256,
+      legibility: 'passed' as const, layout: 'passed' as const, teachingGraphic: 'passed' as const,
+      interactionAffordance: 'passed' as const, notes: '实际图片清晰可见。' })),
+    providerId: 'deepseek', modelId, providerRequestIdHash: 'a'.repeat(64) };
+  return { ...unsigned, receiptSha256: qualitySha(unsigned) };
+}
+beforeEach(async () => {
+  vi.stubEnv('MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY', id);
+  vi.stubEnv('DEEPSEEK_MODELS', 'deepseek-flash');
+  folder = await mkdtemp(join(resolve('data'), 'flash-visual-test-'));
+  png = await sharp({ create: { width: 1280, height: 720, channels: 4, background: '#fff6e0' } }).png().toBuffer();
+  const path = join(folder, 'scene.png'); await writeFile(path, png);
+  input = { modelPolicyId: id, snapshotSha256: qualitySha(randomUUID()), teachingQualityContextSha256: 'b'.repeat(64),
+    gradeBoundary: { gradeCode: 'primary_1' }, scenes: [], rubricVersion: VISUAL_RUBRIC_VERSION,
+    observations: [{ sceneId: 'scene-1', sceneSha256: 'c'.repeat(64), viewport: { width: 1280, height: 720 },
+      screenshotSha256: createHash('sha256').update(png).digest('hex'), screenshotPath: path, domSha256: 'd'.repeat(64) }] };
+  mocks.paid.mockReset().mockReturnValue({ binding: { authorizationId: 'test-visual-authorization' } });
+  mocks.resolve.mockReset().mockResolvedValue(resolved());
+  mocks.call.mockReset().mockResolvedValue({ text: JSON.stringify(returnedReview()),
+    response: { id: 'test-provider-request', modelId: 'deepseek-flash' }, usage: { inputTokens: 2048, outputTokens: 100 } });
+});
+afterEach(async () => {
+  await rm(folder, { recursive: true, force: true });
+  await rm(join(resolve('data/formal-visual-provider-responses'), input.snapshotSha256), { recursive: true, force: true });
+  vi.unstubAllEnvs();
+});
+
+describe('current Flash visual review and metering without a paid call', () => {
+  it('requests current Flash with actual PNG bytes and archives and signs its frozen policy identity', async () => {
+    const result = await reviewFormalVisualSnapshot(input);
+    expect(mocks.resolve).toHaveBeenCalledWith({ modelString: 'deepseek:deepseek-flash' });
+    expect(mocks.call).toHaveBeenCalledOnce();
+    const [request, source, , thinking] = mocks.call.mock.calls[0];
+    expect(source).toBe('mira-formal-visual-review');
+    expect(thinking).toEqual({ mode: 'disabled', enabled: false });
+    expect(request.maxRetries).toBe(0);
+    expect(request.messages[1].content.at(-1).image).toEqual(png);
+    expect(result).toMatchObject({ modelPolicyId: id, modelId: 'deepseek-flash', providerResponseModelId: 'deepseek-flash' });
+    expect(() => assertVisualReview(result, input)).not.toThrow();
+    const archiveFolder = join(resolve('data/formal-visual-provider-responses'), input.snapshotSha256);
+    const archive = JSON.parse(await readFile(join(archiveFolder, (await readdir(archiveFolder))[0]), 'utf8'));
+    expect(archive).toMatchObject({ modelPolicyId: id, requestedModelId: 'deepseek-flash', responseModelId: 'deepseek-flash' });
+  });
+  it.each(['missing-server', 'legacy-server', 'missing-input'])('rejects %s before resolving or calling a model', async scenario => {
+    if (scenario === 'missing-server') delete process.env.MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY;
+    if (scenario === 'legacy-server') process.env.MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY = 'deepseek-v4-pro-flash-v1';
+    if (scenario === 'missing-input') delete input.modelPolicyId;
+    await expect(reviewFormalVisualSnapshot(input)).rejects.toThrow('FORMAL_VISUAL_MODEL_POLICY_MISMATCH');
+    expect(mocks.resolve).not.toHaveBeenCalled(); expect(mocks.call).not.toHaveBeenCalled();
+  });
+  it.each(['model', 'endpoint', 'catalog'])('refuses a mismatching candidate %s before dispatch', async scenario => {
+    if (scenario === 'model') mocks.resolve.mockResolvedValue(resolved(FORMAL_VISION_MODEL));
+    if (scenario === 'endpoint') mocks.resolve.mockResolvedValue(resolved('deepseek-flash', 'https://api.deepseek.com:8443/v1'));
+    if (scenario === 'catalog') process.env.DEEPSEEK_MODELS = FORMAL_VISION_MODEL;
+    await expect(reviewFormalVisualSnapshot(input)).rejects.toThrow(/FORMAL_VISUAL_(PROVIDER_UNAVAILABLE|MODEL_NOT_CONFIGURED)/);
+    expect(mocks.call).not.toHaveBeenCalled();
+  });
+  it('requires the current model and explicit policy in candidate receipts without reinterpretation from the current environment', () => {
+    const candidate = frozenReceipt('deepseek-flash', id), legacy = frozenReceipt(FORMAL_VISION_MODEL);
+    expect(() => assertVisualReview(candidate, input)).not.toThrow();
+    for (const value of [frozenReceipt('deepseek-flash'), frozenReceipt(FORMAL_VISION_MODEL, id), legacy])
+      expect(() => assertVisualReview(value, input)).toThrow('FORMAL_VISUAL_RECEIPT_INVALID');
+    const oldInput = { ...input }; delete oldInput.modelPolicyId;
+    expect(formalVisualModel(oldInput)).toBe(FORMAL_VISION_MODEL);
+    expect(() => assertVisualReview(legacy, oldInput)).not.toThrow();
+    expect(() => assertVisualReview(candidate, oldInput)).toThrow('FORMAL_VISUAL_RECEIPT_INVALID');
+    expect(() => selectedFormalVisualModel(oldInput)).toThrow('FORMAL_VISUAL_MODEL_POLICY_MISMATCH');
+  });
+  it('meters candidate PNG input with the verified 1024-token image ceiling and binds the actual model', () => {
+    const prompt = [{ role: 'user', content: [{ type: 'file', mediaType: 'image/png', data: png }] }];
+    const candidate = measureModelInput('deepseek', 'deepseek-flash', prompt, undefined);
+    expect(candidate.inputTokens).toBe(Buffer.byteLength(JSON.stringify(candidate.request)) + 4096 + DEEPSEEK_CURRENT_FLASH_IMAGE_TOKEN_CEILING);
+    expect(JSON.stringify(candidate.request)).not.toContain(png.toString('base64'));
+    expect(() => measureModelInput('deepseek', FORMAL_VISION_MODEL, prompt, undefined)).toThrow('VISION_METER_UNAVAILABLE');
+    delete process.env.MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY;
+    const legacy = measureModelInput('deepseek', FORMAL_VISION_MODEL, prompt, undefined);
+    expect(legacy.inputTokens).toBe(Buffer.byteLength(JSON.stringify(legacy.request)) + 4096 + DEEPSEEK_IMAGE_TOKEN_CEILING);
+    expect(DEEPSEEK_IMAGE_TOKEN_CEILING).toBe(384);
+    expect(() => measureModelInput('deepseek', 'deepseek-flash', prompt, undefined)).toThrow('VISION_METER_UNAVAILABLE');
+  });
+});
