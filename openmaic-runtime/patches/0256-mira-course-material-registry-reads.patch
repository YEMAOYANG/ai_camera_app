+const MAX_REGISTERED_MATERIAL_BYTES = 64 * 1024 * 1024;
+
+/**
+ * Archived course materials are immutable originals, read through the same
+ * registry as their classroom. New authoring inputs remain local until their
+ * course archive is verified and registered; no registered read falls back.
+ */
+export class CourseMaterialByteStore implements MaterialByteStore {
+  private readonly root: string;
+  private readonly local: LocalMaterialByteStore;
+
+  constructor(root: string = resolve(process.cwd(), 'data')) {
+    this.root = resolve(root);
+    this.local = new LocalMaterialByteStore(this.root);
+  }
+
+  async put(key: string, body: MaterialByteInput, mime?: string): Promise<void> {
+    const filePath = safeLocalPath(this.root, key);
+    const asset = await registeredCourseStorageFile(filePath);
+    if (!asset) return this.local.put(key, body, mime);
+    if (asset.byteSize > MAX_REGISTERED_MATERIAL_BYTES) {
+      throw new Error('registered material exceeds its byte limit');
+    }
+    const checksum = createHash('sha256');
+    let size = 0;
+    for await (const chunk of nodeReadable(body)) {
+      const bytes = Buffer.from(chunk);
+      size += bytes.byteLength;
+      if (size > MAX_REGISTERED_MATERIAL_BYTES || size > asset.byteSize) {
+        throw new Error('registered material is immutable');
+      }
+      checksum.update(bytes);
+    }
+    if (size !== asset.byteSize || checksum.digest('hex') !== asset.sha256) {
+      throw new Error('registered material is immutable');
+    }
+  }
+
+  async get(key: string): Promise<Buffer> {
+    return readCourseStorageFile(safeLocalPath(this.root, key));
+  }
+
+  async delete(key: string): Promise<void> {
+    const filePath = safeLocalPath(this.root, key);
+    // Compensation for an authoring-row failure must never remove archived
+    // course originals or their local recovery copies.
+    if (await registeredCourseStorageFile(filePath)) return;
+    return this.local.delete(key);
+  }
+}
+
 let sharedStore: MaterialByteStore | null = null;
 
 export function getMaterialByteStore(): MaterialByteStore {
-  sharedStore ??= new LocalMaterialByteStore();
+  sharedStore ??= new CourseMaterialByteStore();
   return sharedStore;
 }
 
diff --git a/tests/persistence/course-material-bytes.test.ts b/tests/persistence/course-material-bytes.test.ts
