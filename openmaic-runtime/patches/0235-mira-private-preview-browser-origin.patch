new file mode 100644
--- /dev/null
+++ b/tests/server/textbook-preview-origin.test.ts
@@ -0,0 +1,19 @@
+import { NextRequest } from 'next/server';
+import { describe, expect, it } from 'vitest';
+import { isLocalPreviewRequest } from '@/lib/server/mira-textbook-preview-quiz';
+describe('private preview browser origin', () => {
+  const request = (host: string, origin?: string) => new NextRequest('http://localhost:3102/api/textbook-preview-quiz/tbprev_test',
+    { headers: { host, ...(origin ? { origin } : {}) } });
+  it('accepts the exact loopback browser authority even when Next uses an internal hostname', () => {
+    expect(isLocalPreviewRequest(request('127.0.0.1:3102', 'http://127.0.0.1:3102'), true)).toBe(true);
+    expect(isLocalPreviewRequest(request('localhost:3102', 'http://localhost:3102'), true)).toBe(true);
+    expect(isLocalPreviewRequest(request('[::1]:3102', 'http://[::1]:3102'), true)).toBe(true);
+    expect(isLocalPreviewRequest(request('127.0.0.1:3102'), false)).toBe(true);
+  });
+  it('rejects absent origins, other ports, external hosts and authority tricks', () => {
+    for (const [host, origin] of [['127.0.0.1:3102', undefined], ['127.0.0.1:3102', 'http://127.0.0.1:3000'],
+      ['127.0.0.1:3102', 'https://external.example'], ['external.example', 'http://external.example'],
+      ['127.0.0.1:3102@external.example', 'http://external.example'], ['127.0.0.1:3102/path', 'http://127.0.0.1:3102']])
+      expect(isLocalPreviewRequest(request(host!, origin), true)).toBe(false);
+  });
+});
