+export function isLocalPreviewRequest(request: NextRequest, write: boolean): boolean {
+  const host = request.headers.get('host');
+  if (!host || !['http:', 'https:'].includes(request.nextUrl.protocol)) return false;
+  try {
+    // Next can rebuild nextUrl with its internal localhost hostname. Host is
+    // the browser-facing authority; accept only its exact loopback origin.
+    const external = new URL(`${request.nextUrl.protocol}//${host}`);
+    return ['localhost', '127.0.0.1', '[::1]'].includes(external.hostname)
+      && external.host === host && external.pathname === '/' && !external.username && !external.password
+      && (!write || request.headers.get('origin') === external.origin);
+  } catch { return false; }
+}
