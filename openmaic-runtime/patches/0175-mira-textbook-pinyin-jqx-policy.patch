diff --git a/tests/server/mira-textbook-pinyin-jqx.test.ts b/tests/server/mira-textbook-pinyin-jqx.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-textbook-pinyin-jqx.test.ts
@@ -0,0 +1,70 @@
+import { createHash } from 'crypto';
+import { existsSync, readFileSync } from 'fs';
+import path from 'path';
+import { describe, expect, it } from 'vitest';
+import {
+  MIRA_TEXTBOOK_PINYIN_JQX_PRONUNCIATION_POLICY as policy,
+  MIRA_TEXTBOOK_PINYIN_JQX_PRONUNCIATION_POLICY_SHA256 as policySha,
+  MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY,
+  isMiraTextbookPinyinProviderPronunciation,
+  prepareMiraTextbookPinyinPronunciation as prepare,
+} from '@/lib/server/mira-textbook-pinyin-pronunciation';
+
+const version = 'mira.textbook.pinyin-jqx-ssml.v1';
+const sha = (text: string) => createHash('sha256').update(text).digest('hex');
+const cases = [
+  ['j', 'ji1', '鸡'], ['q', 'qi1', '七'], ['x', 'xi1', '西'],
+  ['jī', 'ji1', '鸡'], ['qì', 'qi4', '气'], ['xī', 'xi1', '西'],
+  ['jiā', 'jia1', '家'], ['qiā', 'qia1', '掐'], ['xiá', 'xia2', '霞'],
+  ['jū', 'ju1', '居'], ['qū', 'qu1', '区'], ['xū', 'xu1', '虚'],
+  ['i', 'yi1', '衣'], ['ī', 'yi1', '衣'], ['ā', 'a1', '啊'],
+  ['ü', 'yu1', '迂'], ['ǖ', 'yu1', '迂'], ['u', 'wu1', '乌'],
+];
+
+describe('JQX whole-token pronunciation identity', () => {
+  it('mirrors the frozen backend policy and physical-body vector', () => {
+    expect(policySha).toBe('0f1957af0ce218d3f0323c79886f199a80210d2e1c49a7b68f6dc70071d6366b');
+    const source = path.resolve(process.cwd(), '../../../backend/content/textbook_pinyin_pronunciation_jqx.v1.json');
+    if (existsSync(source)) expect(policy).toEqual(JSON.parse(readFileSync(source, 'utf8')));
+    expect(policy.inputParameters).toEqual(MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY.inputParameters);
+    expect(policy.listeningRequired).toBe(true);
+    expect(policy.approvalBoundary.formalUseAllowed).toBe(false);
+    const text = '请听：' + cases.map(([token]) => token).sort().join('，') + '。打鼓、下棋、搭积木。';
+    const result = prepare(text, version);
+    expect(result.profile.ssmlSha256).toBe('d95756d43afda86292fe6f83bfed97c56ee84c0766090e6e1ff765c2012507f4');
+    expect(result.providerPronunciation.providerBodySha256)
+      .toBe('c5f46c420744cac583b079e0fec44d1190b1fd42d304b2ca2f94e2f6655ccd44');
+    expect(Object.keys(result.profile).sort()).toEqual(['policySha256', 'policyVersion', 'ssmlSha256']);
+    expect(isMiraTextbookPinyinProviderPronunciation(result.providerPronunciation, sha(text))).toBe(true);
+    for (const prior of ['aoe', 'iuu', 'bpmf', 'dtnl', 'garden2', 'gkh']) {
+      expect(isMiraTextbookPinyinProviderPronunciation({ ...result.providerPronunciation,
+        policyVersion: `mira.textbook.pinyin-${prior}-ssml.v1` }, sha(text))).toBe(false);
+    }
+    expect(isMiraTextbookPinyinProviderPronunciation({ ...result.providerPronunciation, voiceId: 'Serena' }, sha(text))).toBe(false);
+  });
+
+  it('keeps all 18 tokens exact, whole umlaut syllables intact, and Chinese words natural', () => {
+    expect(Object.keys(policy.symbols).sort()).toEqual(cases.map(([token]) => token).sort());
+    expect(policy.words).toEqual({});
+    for (const [token, ph, carrier] of cases) expect(prepare(`请听：${token}。`, version).ssml)
+      .toBe(`<speak>请听：<phoneme alphabet="py" ph="${ph}">${carrier}</phoneme>。</speak>`);
+    const combined = prepare('请听：j、ü、jū、qū、xū。', version).ssml;
+    expect([...combined.matchAll(/ph="([a-z]+[1-5])"/g)].map(match => match[1]))
+      .toEqual(['ji1', 'yu1', 'ju1', 'qu1', 'xu1']);
+    const text = '打鼓、下棋、搭积木；棋、鸡、木、鼓。';
+    expect(prepare(text, version).ssml).toBe(`<speak>${text}</speak>`);
+    expect(prepare('😀<&>"\'jū。', version).ssml)
+      .toBe('<speak>😀&lt;&amp;&gt;&quot;&apos;<phoneme alphabet="py" ph="ju1">居</phoneme>。</speak>');
+  });
+
+  it.each(['ju', 'ju1', 'jü', 'jv', 'jūqū', 'qu', 'xu', 'qī', 'xì', 'nǚ',
+    'u\u0308', 'ju\u0304', 'J', 'ｊ', '𝒋', 'constructor', 'j\x00'])(
+    'rejects unknown complete token %s without character fallback', token => {
+      expect(() => prepare(`请听：${token}。`, version)).toThrow();
+    });
+
+  it.each([null, '', 'unknown', '__proto__'])(
+    'rejects unknown or missing explicit policy %s', unknown => {
+      expect(() => prepare('请听：jū。', unknown)).toThrow();
+    });
+});
