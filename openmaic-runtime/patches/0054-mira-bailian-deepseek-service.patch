+/** Wire adaptation only; contains no credentials or server-only imports. */
+export function isBailianDeepSeekEndpoint(baseUrl: string): boolean {
+  try {
+    const url = new URL(baseUrl);
+    return (
+      url.protocol === 'https:' &&
+      !url.username &&
+      !url.password &&
+      (url.hostname === 'dashscope.aliyuncs.com' ||
+        /^[a-z0-9-]+\.cn-beijing\.maas\.aliyuncs\.com$/.test(url.hostname)) &&
+      /^\/compatible-mode\/v1(?:\/chat\/completions)?\/?$/.test(url.pathname)
+    );
+  } catch {
+    return false;
+  }
+}
+
+export const BAILIAN_DEEPSEEK_MODELS: Record<string, string> = {
+  'deepseek-v4-pro': 'deepseek-v4-pro-0813',
+  'deepseek-v4-flash': 'deepseek-v4-flash-0731',
+};
+
+export function adaptDeepSeekRequest(
+  endpoint: string,
+  body: Record<string, unknown>,
+): Record<string, unknown> {
+  if (!isBailianDeepSeekEndpoint(endpoint)) return body;
+  const adapted = { ...body };
+  const model = String(body.model || '');
+  adapted.model = BAILIAN_DEEPSEEK_MODELS[model] || model;
+  const thinking = body.thinking as { type?: string } | undefined;
+  if (thinking?.type === 'enabled' || thinking?.type === 'disabled') {
+    adapted.enable_thinking = thinking.type === 'enabled';
+    delete adapted.thinking;
+  }
+  if (adapted.enable_thinking === false) delete adapted.reasoning_effort;
+  if (adapted.stream !== true) delete adapted.stream_options;
+  return adapted;
+}
+
+export function describeDeepSeekService(endpoint: string) {
+  const bailian = isBailianDeepSeekEndpoint(endpoint);
+  return {
+    service: bailian ? 'bailian' : 'official-or-custom',
+    wireModels: bailian
+      ? BAILIAN_DEEPSEEK_MODELS
+      : {
+          'deepseek-v4-pro': 'deepseek-v4-pro',
+          'deepseek-v4-flash': 'deepseek-v4-flash',
+        },
+    automaticFallback: false,
+  };
+}
