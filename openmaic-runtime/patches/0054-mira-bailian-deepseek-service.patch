+import { describe, expect, it } from 'vitest';
+import { adaptDeepSeekRequest, isBailianDeepSeekEndpoint } from '@/lib/ai/deepseek-service';
+
+describe('DeepSeek service wire adaptation', () => {
+  const body = {
+    model: 'deepseek-v4-pro',
+    thinking: { type: 'disabled' },
+    reasoning_effort: 'high',
+    stream_options: { include_usage: true },
+  };
+  it('leaves the official request and credentials path unchanged', () => {
+    expect(adaptDeepSeekRequest('https://api.deepseek.com/v1/chat/completions', body)).toBe(body);
+  });
+  it('adapts readiness and non-streaming requests without mutating the original', () => {
+    const result = adaptDeepSeekRequest(
+      'https://ws-example.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions',
+      body,
+    );
+    expect(result).toEqual({ model: 'deepseek-v4-pro-0813', enable_thinking: false });
+    expect(body.thinking.type).toBe('disabled');
+  });
+  it.each([
+    'https://dashscope.aliyuncs.com.attacker.test/compatible-mode/v1',
+    'https://attacker.test/compatible-mode/v1',
+    'http://dashscope.aliyuncs.com/compatible-mode/v1',
+    'https://user:pass@dashscope.aliyuncs.com/compatible-mode/v1',
+    'https://dashscope.aliyuncs.com/api/v1',
+  ])('does not apply this profile to %s', (url) => {
+    expect(isBailianDeepSeekEndpoint(url)).toBe(false);
+    expect(adaptDeepSeekRequest(url, body)).toBe(body);
+  });
+});
