+++ b/lib/server/mira-formal-visual-predispatch.ts
@@ -0,0 +1,90 @@
+/** One audited recovery of English1's snapshot identity collision, never a paid retry. */
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { createHash } from 'node:crypto';
+import { readFile, readdir, open, lstat } from 'node:fs/promises';
+import { join } from 'node:path';
+import { qualitySha } from './mira-formal-quality-contract';
+import { readBrowserRecheckBudget } from './mira-formal-browser-recheck';
+
+const TARGET = '278de60ab4580431b84b6b8fe656a82cc25b4b8409871857a8217f172ece6983';
+const SOURCE = 'ce327bcb84a0836065def3bc20fcfe62ede100a099be5194df5b4c8014c2d8a9';
+const JOB = 'omformal_35329ccda267db6155963636';
+const AUTH = 'd8eca649c6be4ccb5d19b8422b1333253d76bef3ef0b555b7027efb6471f74fc';
+const REVIEW = '550b7f32a490d9374d2291c2de3077712d1e491819c1e771e03b0ec2aa9b382b';
+const bytesSha = (bytes: Buffer) => createHash('sha256').update(bytes).digest('hex');
+const context = new AsyncLocalStorage<Proof>();
+const validated = new WeakSet<object>();
+const proofInputs = new WeakMap<object, Parameters<typeof proveVisualPredispatchRecovery>[0]>();
+type Identity = {sourceJobSha256:string; sourceSnapshotSha256:string; repairSnapshotSha256:string; sessionId:string; stageId:string};
+type Proof = { evidence: any; evidenceSha256: string; identity: Identity; reviewIdentitySha256:string; priorAttemptsSha256:string };
+function require(value: unknown): asserts value { if (!value) throw new Error('SAVED_STAGE_VISUAL_PREDISPATCH_NOT_PROVEN'); }
+async function json(path:string) { return JSON.parse(await readFile(path,'utf8')); }
+async function files(path:string) { try { return await readdir(path); } catch(e) { if((e as NodeJS.ErrnoException).code==='ENOENT') return []; throw e; } }
+
+export async function proveVisualPredispatchRecovery(args:{root:string;recoveryFolder:string;identity:Identity;authorizationId:string;evidencePath:string}) {
+  const {root,recoveryFolder,identity}=args;
+  const stat=await lstat(args.evidencePath);
+  require(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<2_000_000);
+  const evidence=await json(args.evidencePath);
+  require(evidence.schemaVersion==='mira.english1.visual-predispatch-recovery.v1'
+    &&evidence.jobId===JOB&&args.authorizationId===AUTH&&evidence.authorizationId===AUTH
+    &&identity.repairSnapshotSha256===TARGET&&qualitySha(evidence.identity)===qualitySha(identity)
+    &&identity.sourceJobSha256==='9229b9a216abfaa5e7b30a87140e758a7b2d67186843f5fef1c06d8b7f0e1ab1'
+    &&identity.sessionId==='miraformal_232f8120d6c3b73196ccc60b06740e695fe52d97db911af5ca282f05fb4f645e'
+    &&identity.stageId==='stage-McsF1obUqo'&&evidence.error==='MIRA_PAID_BUDGET_DISPATCH_ALREADY_CLAIMED'
+    &&typeof evidence.failureLog==='string'&&evidence.failureLog.trim().endsWith(evidence.error)
+    &&bytesSha(Buffer.from(evidence.failureLog))===evidence.failureLogSha256);
+  const claimRaw=await readFile(join(recoveryFolder,`complete-${TARGET}.claim`));
+  const claim=JSON.parse(claimRaw.toString('utf8'));const claimAt=Date.parse(claim.createdAt);
+  require(bytesSha(claimRaw)===evidence.priorClaimSha256&&Number.isSafeInteger(claimAt)
+    &&Object.entries(identity).every(([k,v])=>claim[k]===v)&&!claim.reviewGrantSha256
+    &&!(await files(recoveryFolder)).includes('completion.json'));
+  const folder=join(root,'data/formal-quality-reviews',REVIEW);
+  const attempts=await json(join(folder,'attempts.json'));
+  const selected=attempts.filter((a:any)=>a.snapshotSha256===TARGET);
+  require(qualitySha(attempts)===evidence.priorAttemptsSha256&&selected.length===1&&selected[0].status==='failed'
+    &&selected[0].startedAt>=claimAt&&!selected[0].artifactPrefix&&!selected[0].grantId);
+  const inputRaw=await readFile(join(folder,`${TARGET}-input.json`));const input=JSON.parse(inputRaw.toString());
+  require(bytesSha(inputRaw)===evidence.priorInputSha256&&qualitySha(input.snapshot)===TARGET
+    &&input.sessionId===identity.sessionId&&input.stageId===identity.stageId);
+  const current=await json(join(folder,`${TARGET}-browser.json`));
+  const previous=await json(join(folder,`${SOURCE}-browser.json`));
+  require(qualitySha(current)===evidence.browserSha256&&current.length===16&&previous.length===16
+    &&current.every((a:any,i:number)=>a.passed===true&&previous[i].passed===true
+      &&a.sceneId===previous[i].sceneId&&qualitySha(a.viewport)===qualitySha(previous[i].viewport)
+      &&a.screenshotSha256===previous[i].screenshotSha256));
+  const visual=await json(join(folder,`${SOURCE}-visual.json`));
+  const {receiptSha256,...unsigned}=visual;
+  require(qualitySha(unsigned)===receiptSha256&&receiptSha256===evidence.sourceVisualReceiptSha256
+    &&visual.status==='passed'&&visual.snapshotSha256===SOURCE);
+  const targetFiles=await files(folder);
+  require(!targetFiles.includes(`${TARGET}.json`)
+    &&!targetFiles.some(name=>name.startsWith(TARGET)&&/(?:provider|dispatch|visual|predispatch)/.test(name))
+    &&(await files(join(root,'data/formal-visual-provider-responses',TARGET))).length===0);
+  const r=evidence.collisionReservation;
+  require(r.id==='b674d1c68c002534b5006bba33d76274a578a9ed68f1409f65324a483f414731'
+    &&r.authorization_id===AUTH&&r.state==='settled'
+    &&r.request_sha256==='36b6eb4caf8a1e3d9777f43954999c69c72be9c30ccd99844ef4adbb3b56d335'
+    &&r.dispatch_id==='runtime:033c582d30915a354ea5417b30d5ddc9f6b50c06f5dd6b08265f4a781185f303'
+    &&r.dispatched_at<r.settled_at&&r.settled_at<claimAt);
+  const budget=await readBrowserRecheckBudget(AUTH);
+  require(budget.authorizationId===AUTH&&budget.purpose==='production'&&budget.unsettledReservationCount===0
+    &&Number.isSafeInteger(budget.latestProviderDispatchAt)&&budget.latestProviderDispatchAt<claimAt);
+  const proof={evidence,evidenceSha256:qualitySha(evidence),identity,reviewIdentitySha256:REVIEW,priorAttemptsSha256:evidence.priorAttemptsSha256};
+  validated.add(proof);proofInputs.set(proof,args);return proof;
+}
+export async function claimVisualPredispatchRecovery(proof:Proof,folder:string) {
+  require(validated.has(proof));
+  const args=proofInputs.get(proof);require(args&&args.recoveryFolder===folder);
+  const fresh=await proveVisualPredispatchRecovery(args);
+  require(fresh.evidenceSha256===proof.evidenceSha256&&qualitySha(fresh.identity)===qualitySha(proof.identity));
+  const f=await open(join(folder,`complete-${TARGET}-visual-predispatch.claim`),'wx',0o600);
+  try {await f.writeFile(JSON.stringify({...proof.evidence,evidenceSha256:proof.evidenceSha256,createdAt:new Date().toISOString(),pid:process.pid}));await f.sync();}finally{await f.close();}
+}
+export function withVisualPredispatchRecovery<T>(proof:Proof|undefined,work:()=>T):T {
+  if(!proof)return work();require(validated.has(proof));return context.run(proof,work);
+}
+export function visualPredispatchRecovery(identitySha:string,snapshotSha:string) {
+  const proof=context.getStore();if(!proof)return undefined;
+  require(validated.has(proof)&&identitySha===proof.reviewIdentitySha256&&snapshotSha===TARGET);return proof;
+}
