+/** Separate saved-scene contract. No rejected archive is synthesized or consumed. */
+export interface SavedSceneRepairInput {
+  jobDir: string;
+  stageId: string;
+  sceneId: string;
+  originalScenePath: string;
+  originalSceneFileSha256: string;
+  originalSceneSha256: string;
+  revisedHtmlPath: string;
+  revisedHtmlSha256: string;
