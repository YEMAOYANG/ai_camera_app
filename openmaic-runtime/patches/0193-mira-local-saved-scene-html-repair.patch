+}
+type SavedState = Awaited<ReturnType<typeof savedInputs>>;
+async function savedLedger(state: SavedState): Promise<Json> {
+  const value = JSON.parse((await privateRead(state.ledgerPath)).toString());
+  unseal(value);
+  return value;
+}
+async function savedAuthority(q: Queryable, state: SavedState, lock: boolean) {
+  const session = (await q.query('SELECT owner_id, prompt, status, deleted_at, lease_worker_id FROM agent_sessions WHERE id=$1' + (lock ? ' FOR UPDATE' : ''), [state.sessionId])).rows[0];
+  check(session && session.owner_id === state.ownerId && session.deleted_at === null && ['succeeded', 'failed', 'cancelled'].includes(String(session.status)) && session.lease_worker_id === null, 'SESSION_NOT_TERMINAL_OWNED');
+  const meta = (await q.query('SELECT owner_id, deleted_at FROM stage_meta WHERE stage_id=$1' + (lock ? ' FOR UPDATE' : ''), [state.stageId])).rows[0];
+  check(meta && meta.owner_id === state.ownerId && meta.deleted_at === null, 'STAGE_NOT_OWNED');
+  const frozen = textbookContractFromPrompt(String(session.prompt));
+  check(frozen && textbookDigest(frozen) === textbookDigest(state.frozenFile.sceneContract), 'SESSION_FROZEN_MISMATCH');
+  const document = await new PgDocumentStore(q, { withTransaction: async body => body(q) }).loadDocument(state.stageId) as CourseDocument | null;
+  check(document && (document.outline as Json)?.producerRef === state.sessionId, 'DOCUMENT_SESSION_MISMATCH');
+  return { frozen: frozen!, document: document! };
+}
+function savedDescribe(input: SavedSceneRepairInput, state: SavedState, document: CourseDocument, ledger: Json, frozen: NonNullable<ReturnType<typeof textbookContractFromPrompt>>) {
+  const matches = document.scenes.filter(s => s.id === state.scene.id || s.order === state.scene.order);
+  check(matches.length === 1 && matches[0].id === state.scene.id && textbookDigest(matches[0]) === input.originalSceneSha256, 'SAVED_SCENE_CHANGED_OR_MISSING');
+  check(ledger.sessionId === state.sessionId && ledger.stageId === state.stageId && textbookDigest(ledger.frozenContract) === textbookDigest(frozen), 'LEDGER_BINDING');
+  check(Array.isArray(ledger.scenes) && ledger.scenes.length === document.scenes.length && document.scenes.every(s => ledger.scenes.some((e: Json) => e.sceneId === s.id && e.order === s.order && e.sha256 === textbookDigest(s) && e.canonicalJson === textbookCanonical(s) && e.contractSha256 === frozen.sha256)), 'LEDGER_DOCUMENT');
+  const after = { ...document, scenes: document.scenes.map(s => s.id === state.scene.id ? state.revised : s).sort((a, b) => a.order - b.order) };
+  const afterLedger = { ...unseal(ledger), scenes: after.scenes.map(s => ({ sceneId: s.id, order: s.order, sha256: textbookDigest(s), canonicalJson: textbookCanonical(s), contractSha256: frozen.sha256 })) };
+  return seal({ schemaVersion: 'mira.textbook.saved-scene-html-repair-plan.v1', verification: 'static_only_not_play_audio_or_publication', input, sessionId: state.sessionId, stageId: state.stageId, sceneId: state.scene.id, order: state.scene.order, ownerFingerprint: state.ownerFingerprint, contractSha256: frozen.sha256, originalSceneSha256: textbookDigest(state.scene), revisedSceneSha256: textbookDigest(state.revised), beforeDocumentSha256: textbookDigest(document), afterDocumentSha256: textbookDigest(after), beforeCandidateSha256: ledger.sha256, afterCandidateSha256: textbookDigest(afterLedger) });
+}
+async function savedDryGuard(state: SavedState, frozen: NonNullable<ReturnType<typeof textbookContractFromPrompt>>, document: CourseDocument) {
+  const validated = new Error('SAVED_REPAIR_DRY_RUN_VALIDATED');
+  const guard = createTextbookAuthoringGuard(frozen, state.sessionId, { classroomsDir: path.join(state.dataDir, 'classrooms'), ownsStage: async () => false });
+  const target = { loadDocument: async () => document, putScene: async () => { throw validated; } } as unknown as CourseStore;
+  try { await guard.wrapStore(target).putScene(state.stageId, state.revised); }
+  catch (error) { if (error === validated) return; throw error; }
+  fail('DRY_RUN_UNEXPECTED');
+}
+/** Read-only plan for one existing scene. Its original is evidence, not a rejected generation. */
+export async function prepareSavedSceneRepair(input: SavedSceneRepairInput, env: RepairEnvironment): Promise<Json> {
+  const state = await savedInputs(input, env);
+  return transaction(env, true, async q => {
+    const { frozen, document } = await savedAuthority(q, state, false);
+    const ledger = await savedLedger(state);
+    const plan = savedDescribe(input, state, document, ledger, frozen);
+    await savedDryGuard(state, frozen, document);
+    check((await savedLedger(state)).sha256 === ledger.sha256, 'ATOMIC_LEDGER_FENCE');
+    return plan;
+  });
+}
+/** Explicit replacement; only the saved HTML leaf may change. No paid call or automatic retry. */
+export async function runSavedSceneRepair(plan: Json, approvedPlanSha256: string, env: RepairEnvironment): Promise<Json> {
+  unseal(plan);
+  check(plan.schemaVersion === 'mira.textbook.saved-scene-html-repair-plan.v1' && plan.sha256 === approvedPlanSha256, 'PLAN_APPROVAL_SHA');
+  const state = await savedInputs(plan.input, env);
+  const directory = path.join(state.dataDir, 'textbook-saved-scene-repairs', digestBytes(state.sessionId), state.stageId, plan.sha256);
+  const intentPath = path.join(directory, 'intent.json');
+  const originalPath = path.join(directory, 'original-scene.json');
+  const receiptPath = path.join(directory, 'receipt.json');
+  let priorIntent: Json | undefined;
+  try { priorIntent = JSON.parse((await privateRead(intentPath)).toString()); } catch (error: any) { if (error.code !== 'ENOENT') throw error; }
+  if (priorIntent) {
+    check(textbookCanonical(priorIntent) === textbookCanonical(plan), 'INTENT_COLLISION');
+    check((await privateRead(originalPath)).toString() === textbookCanonical(state.scene) + '\n', 'SAVED_SNAPSHOT_COLLISION');
+  }
+  const result = await transaction(env, false, async (q, pool) => {
+    const { frozen, document } = await savedAuthority(q, state, true);
+    // Read the full sealed ledger only after acquiring session and stage locks.
+    const ledger = await savedLedger(state);
+    let before = document;
+    let beforeLedger = ledger;
+    const actualSha = textbookDigest(document);
+    if (priorIntent && actualSha === plan.afterDocumentSha256) {
+      check(document.scenes.filter(s => s.id === state.scene.id).length === 1 && document.scenes.some(s => s.id === state.scene.id && textbookDigest(s) === plan.revisedSceneSha256), 'RECOVERY_SCENE');
+      // Unlike rejected-scene insertion recovery, restore the original saved page.
+      before = { ...document, scenes: document.scenes.map(s => s.id === state.scene.id ? state.scene : s) };
+    }
+    if (priorIntent && ledger.sha256 === plan.afterCandidateSha256) {
+      const body = unseal(ledger);
+      check(body.scenes.filter((s: Json) => s.sceneId === state.scene.id).length === 1, 'RECOVERY_LEDGER');
+      beforeLedger = seal({ ...body, scenes: body.scenes.map((s: Json) => s.sceneId === state.scene.id ? { sceneId: state.scene.id, order: state.scene.order, sha256: textbookDigest(state.scene), canonicalJson: textbookCanonical(state.scene), contractSha256: frozen.sha256 } : s) });
+    }
+    check(textbookCanonical(savedDescribe(plan.input, state, before, beforeLedger, frozen)) === textbookCanonical(plan), 'PLAN_STALE');
+    check(actualSha === plan.beforeDocumentSha256 || (priorIntent && actualSha === plan.afterDocumentSha256), 'DOCUMENT_CHANGED');
+    await savedDryGuard(state, frozen, before);
+    check((await savedLedger(state)).sha256 === ledger.sha256, 'ATOMIC_LEDGER_FENCE');
+    await immutable(originalPath, state.scene);
+    await immutable(intentPath, plan);
+    let fenceCalls = 0;
+    const ownerStore = createOwnerBoundDocumentStore({ pool, ownerId: state.ownerId, validateScene, validateStage: validateAppStage,
+      mutationFence: async tx => {
+        const current = await savedAuthority(tx, state, true);
+        check(textbookDigest(current.document) === (fenceCalls++ === 0 ? plan.beforeDocumentSha256 : plan.afterDocumentSha256), 'ATOMIC_DOCUMENT_FENCE');
+        check((await savedLedger(state)).sha256 === ledger.sha256, 'ATOMIC_LEDGER_FENCE');
+      },
+    });
+    const store = ownerStore as unknown as CourseStore;
+    const target = actualSha === plan.afterDocumentSha256
+      ? new Proxy(store, { get(t, key) { if (key === 'putScene') return async () => {}; const value = Reflect.get(t, key); return typeof value === 'function' ? value.bind(t) : value; } })
+      : store;
+    await createTextbookAuthoringGuard(frozen, state.sessionId, { classroomsDir: path.join(state.dataDir, 'classrooms'), ownsStage: async () => false }).wrapStore(target).putScene(state.stageId, state.revised);
