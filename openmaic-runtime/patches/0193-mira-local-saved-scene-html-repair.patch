+  const scene = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(originalBytes));
+  check(textbookDigest(scene) === input.originalSceneSha256 && scene.id === input.sceneId && scene.stageId === input.stageId, 'SAVED_SOURCE_SCENE_SHA');
+  check(scene.type === 'interactive' && scene.content?.type === 'interactive' && typeof scene.content.html === 'string', 'HTML_ONLY');
+  check(scene.content.widgetConfig?.html === undefined && (scene.content.url === undefined || scene.content.url === ''), 'DUPLICATE_HTML_UNSUPPORTED');
