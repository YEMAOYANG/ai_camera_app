+
+/* Live discussion uses the same stable phone rows as recorded lessons. The
+ * complete action names remain accessible while compact controls use icons. */
+@media (max-width: 640px), (min-width: 641px) and (max-height: 500px) {
+  [data-mira-classroom-root] [data-mira-chrome='playback-controls'] [data-mira-live-controls] { gap: 0; }
+  [data-mira-classroom-root] [data-mira-chrome='playback-controls'] [data-mira-live-control] {
+    width: 48px; height: 48px; min-width: 48px; min-height: 48px; padding: 0; gap: 0; justify-content: center;
+  }
+  [data-mira-classroom-root] [data-mira-live-control-label] { display: none; }
+  [data-mira-classroom-root] [data-mira-live-control-icon] { display: block; }
+}
+@media (max-width: 640px) {
+  [data-mira-classroom-root] [data-mira-chrome='playback-controls'] [data-mira-live-control='continue'] {
+    position: absolute; top: 0; right: 144px;
+  }
+}
