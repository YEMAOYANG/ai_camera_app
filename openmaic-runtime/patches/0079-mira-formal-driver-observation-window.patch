+/** The legacy 16K allowance is a local quota, not the driver's model capacity. */
+export async function miraFormalAgentOutputOptions(
+  formalProfessionalSession: boolean,
+  wireMaxOutputTokens: number | undefined,
+) {
+  const limitOutput = formalProfessionalSession && !(await isPaidBudgetObservationMode());
+  return {
+    maxOutputTokens: limitOutput
+      ? Math.min(wireMaxOutputTokens ?? Infinity, MIRA_FORMAL_AGENT_BUDGET.maxOutputTokensPerDispatch)
+      : wireMaxOutputTokens,
+    omitMaxOutputTokens: !limitOutput && wireMaxOutputTokens === undefined,
+  };
+}
 
