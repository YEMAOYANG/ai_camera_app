+import { createHash } from 'crypto';
+import { readFileSync } from 'fs';
+import { fileURLToPath } from 'url';
+import { describe, expect, it } from 'vitest';
+import * as registry from '@/lib/server/mira-textbook-pinyin-pronunciation';
+const corpus = JSON.parse(readFileSync(process.env.MIRA_GARDEN3_CORPUS || fileURLToPath(new URL('../../../../../backend/tests/fixtures/textbook_pinyin_garden3/corpus.v1.json', import.meta.url)), 'utf8'));
+const version = 'mira.textbook.pinyin-garden3-ssml.v1';
+const prepare = registry.prepareMiraTextbookPinyinPronunciation;
+const sha = (text: string) => createHash('sha256').update(text).digest('hex');
+describe('Garden 3 registered recipe, pending actual audio', () => {
+  it('preserves all prior policy hashes and transport, with no approval claim', () => {
+    const p = registry.MIRA_TEXTBOOK_PINYIN_GARDEN3_PRONUNCIATION_POLICY;
+    expect(registry.MIRA_TEXTBOOK_PINYIN_GARDEN3_PRONUNCIATION_POLICY_SHA256).toBe(corpus.policySha256);
+    expect(p.inputParameters).toEqual(registry.MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY.inputParameters);
+    expect(p.words).toEqual({});
+    for (const [v,h] of Object.entries(corpus.priorHashes)) expect(prepare('请听。',v).profile.policySha256).toBe(h);
+    expect(p.approvalBoundary).toMatchObject({formalUseAllowed:false,pronunciationApproved:false,
+      humanListeningVerified:false,perceptualToneVerified:false,shortConsonantAccepted:false});
+  });
+  it.each(corpus.tokens as [string,string,string][])('keeps complete %s as one phoneme', (token,ph,carrier) => {
+    expect(prepare('请听：'+token+'。',version).ssml).toBe(`<speak>请听：<phoneme alphabet="py" ph="${ph}">${carrier}</phoneme>。</speak>`);
+  });
+  it('matches all 150 Python physical request and SSML identities', () => {
+    expect(corpus.speech).toHaveLength(150);
+    for (const row of corpus.speech) {
+      const result = prepare(row.text,version);
+      expect(result.providerPronunciation).toEqual(row.providerPronunciation);
+      expect(Object.keys(result.profile).sort()).toEqual(['policySha256','policyVersion','ssmlSha256']);
+      expect(registry.isMiraTextbookPinyinProviderPronunciation(result.providerPronunciation,sha(row.text))).toBe(true);
+    }
+    const t='玻璃、萝卜、一模一样、星期、数学、孩子。';
+    expect(prepare(t,version).ssml).toBe(`<speak>${t}</speak>`);
+    expect([...prepare('z、zh、c、ch、s、sh、li、bo。',version).ssml.matchAll(/ph="([a-z]+[1-5])"/g)].map(x=>x[1])).toEqual(['zi1','zhi1','ci1','chi1','si1','shi1','li5','bo5']);
+  });
+  it.each(['zi4','li5','bo5','mú','zìmu','zìmǔ','zhì','zhīzhū','SH','hello','constructor','ｚ','𝒛','z\u0304','z\x00'])('rejects %s', token => {
+    expect(()=>prepare('请听：'+token+'。',version)).toThrow();
+  });
+  it('keeps the seven exact full phrase request bodies and source identities', () => {
+    expect(corpus.probeRequests).toHaveLength(7);
+    for (const row of corpus.probeRequests) {
+      const result = prepare(row.sourceText, version);
+      expect(result.providerPronunciation.providerBodySha256).toBe(row.requestSha256);
+      expect(result.providerPronunciation.ssmlSha256).toBe(row.ssmlSha256);
+      expect(result.ssml).toBe(row.body.input.text);
+    }
+  });
+  it('rejects unknown profiles and cross-policy receipts', () => {
+    expect(()=>prepare('请听。',version+'-unknown')).toThrow();
+    const r=prepare('请听：bo。',version);
+    for (const v of Object.keys(corpus.priorHashes))
+      expect(registry.isMiraTextbookPinyinProviderPronunciation({...r.providerPronunciation,policyVersion:v},sha('请听：bo。'))).toBe(false);
+    expect(()=>registry.assertMiraTextbookPinyinProfile({...r.profile,policySha256:'0'.repeat(64)},r.profile)).toThrow();
+  });
+});
