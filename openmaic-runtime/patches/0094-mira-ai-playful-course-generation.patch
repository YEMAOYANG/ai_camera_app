+import { describe, expect, it } from 'vitest';
+import fixtures from '../fixtures/mira-formal-skill-selection-v2.json';
+import type { GenerateClassroomInput } from '@/lib/server/classroom-generation';
+import type { FormalCoursewareSpec, FormalQuestion } from '@/lib/server/mira-formal-compiled-classroom';
+import type { Scene } from '@/lib/types/stage';
+import {
+  MIRA_FORMAL_PLAYFUL_POLICY,
+  assertMiraFormalPlayfulScenes,
+  formalPlayfulContext,
+  formalPlayfulContextFromPrompt,
+  withMiraFormalPlayfulInstructions,
+} from '@/lib/server/mira-formal-playful-policy';
+import { professionalPrompt } from '@/lib/server/mira-formal-professional-classroom';
+import {
+  MIRA_LEGACY_PROFESSIONAL_CREATION_POLICY,
+  MIRA_IMAGE_PROFESSIONAL_CREATION_POLICY,
+  MIRA_INTEGRATED_PROFESSIONAL_CREATION_POLICY,
+  MIRA_PROFESSIONAL_CREATION_POLICY,
+  MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY,
+  MIRA_INTERACTION_PROFESSIONAL_CREATION_POLICY,
+  MIRA_MULTISTATE_PROFESSIONAL_CREATION_POLICY,
+  MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY,
+  isExactMiraProfessionalCreationPolicy,
+} from '@/lib/server/mira-formal-generation-policy';
+
+const selection = fixtures[0].input;
+const question = (id: string): FormalQuestion => ({
+  id, type: 'single_choice', prompt: `已锁定的问题 ${id}`, skill: 'number_sense_20',
+  hint: '看清数量', explanation: '对应已锁定的数量关系',
+  choices: [{ id: 'a', label: '甲' }, { id: 'b', label: '乙' }],
+});
+const spec: FormalCoursewareSpec = {
+  buildItemId: 'playful-test-build', runtimeRequestId: 'playful-test-request',
+  course: { ...selection.teachingBrief.course, subject: 'math' }, intro: '摆一摆', estimatedMinutes: 10,
+  teach: selection.teachingBrief.lesson.teachingFlow.teach, recap: '说说你的发现',
+  demo: question('demo'), guided: [question('guided-1'), question('guided-2')],
+  independent: [question('independent-1'), question('independent-2')],
+  teacher: { name: '老师', avatar: '/teacher.png', voiceConfig: { providerId: 'test', modelId: 'test', voiceId: 'test' } },
+};
+function input(professionalCreationPolicy: unknown): GenerateClassroomInput {
+  return { requirement: JSON.stringify(selection), professionalCreationPolicy } as GenerateClassroomInput;
+}
+const context = formalPlayfulContext(MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY, spec)!;
+
+function quiz(id: string, order: number, ids: string[]): Scene {
+  return { id, order, type: 'quiz', content: { type: 'quiz', questions: ids.map(id => ({ id })) } } as Scene;
+}
+function game(order = 1): Scene {
+  return {
+    id: 'agent-created-game', order, type: 'interactive',
+    content: { type: 'interactive', widgetType: 'game', html: '<p>Agent output fixture</p>',
+      widgetConfig: { type: 'game', gameType: 'puzzle', description: '由模型生成的教学任务', scoring: { correctPoints: 0 } } },
+  } as Scene;
+}
+function scenes(): Scene[] {
+  return [game(), quiz('guided', 2, context.guidedQuestionIds), quiz('independent', 3, context.independentQuestionIds)];
+}
+
+describe('new formal playful generation authority', () => {
+  it('injects through the actual professional prompt without rewriting any locked question or old context', () => {
+    const beforeSpec = JSON.stringify(spec);
+    const oldPrompt = professionalPrompt(input(MIRA_MULTISTATE_PROFESSIONAL_CREATION_POLICY), spec);
+    const newPrompt = professionalPrompt(input(MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY), spec);
+    expect(isExactMiraProfessionalCreationPolicy(MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY)).toBe(true);
+    expect(formalPlayfulContextFromPrompt(newPrompt)).toEqual(context);
+    const oldRule = oldPrompt.split('\n').find(line => line.startsWith('- Use between one and four quiz'))!;
+    const updatedPrefix = newPrompt.split('\nMIRA_FORMAL_PLAYFUL_CONTEXT:\n')[0];
+    const newRule = updatedPrefix.split('\n').find(line => line.startsWith('- Use exactly two quiz'))!;
+    expect(updatedPrefix.replace(newRule, oldRule)).toBe(oldPrompt);
+    const assessment = (prompt: string) => JSON.parse(prompt.split('\nLocked assessment questions:\n')[1]
+      .split('\n\nAnswer-blind teaching brief (authoritative):\n')[0]);
+    expect(assessment(newPrompt)).toEqual(assessment(oldPrompt));
+    expect(assessment(newPrompt).map((q: { id: string }) => q.id)).toEqual([
+      'guided-1', 'guided-2', 'independent-1', 'independent-2',
+    ]);
+    expect(JSON.stringify(spec)).toBe(beforeSpec);
+    expect(newPrompt).not.toContain('Use between one and four quiz scenes');
+    expect(newPrompt).toContain('No fixed lesson template');
+    expect(newPrompt).toContain('independently verified numeric diagram');
+    expect(newPrompt).toContain('Do not introduce volume formulas');
+  });
+
+  it.each([
+    MIRA_LEGACY_PROFESSIONAL_CREATION_POLICY, MIRA_IMAGE_PROFESSIONAL_CREATION_POLICY,
+    MIRA_INTEGRATED_PROFESSIONAL_CREATION_POLICY, MIRA_PROFESSIONAL_CREATION_POLICY,
+    MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY, MIRA_INTERACTION_PROFESSIONAL_CREATION_POLICY,
+    MIRA_MULTISTATE_PROFESSIONAL_CREATION_POLICY,
+  ])('keeps each historical policy prompt outside the new policy and acceptance checks', policy => {
+    const frozen = professionalPrompt(input(policy), spec);
+    expect(formalPlayfulContext(policy, spec)).toBeUndefined();
+    expect(formalPlayfulContextFromPrompt(frozen)).toBeUndefined();
+    expect(withMiraFormalPlayfulInstructions(frozen, undefined)).toBe(frozen);
+    expect(frozen).toContain('Use between one and four quiz scenes');
+    // An old four-page course is not retroactively subjected to the new structure.
+    expect(() => assertMiraFormalPlayfulScenes([
+      quiz('g1', 1, ['guided-1']), quiz('g2', 2, ['guided-2']),
+      quiz('i1', 3, ['independent-1']), quiz('i2', 4, ['independent-2']),
+    ], formalPlayfulContextFromPrompt(frozen))).not.toThrow();
+  });
+
+  it('rejects conflicting opt-ins, duplicate prompt injection and overlapping assessment identity', () => {
+    for (const policy of [
+      { ...MIRA_FORMAL_PLAYFUL_POLICY, maxQuizScenes: 4 },
+      { ...MIRA_FORMAL_PLAYFUL_POLICY, lockedAssessmentPreserved: false },
+      { ...MIRA_FORMAL_PLAYFUL_POLICY, extra: true },
+    ]) {
+      expect(() => formalPlayfulContext({ playfulLearningPolicy: policy }, spec)).toThrow('FORMAL_PLAYFUL_POLICY_INVALID');
+      expect(isExactMiraProfessionalCreationPolicy({ ...MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY, playfulLearningPolicy: policy })).toBe(false);
+    }
+    const frozen = professionalPrompt(input(MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY), spec);
+    expect(() => withMiraFormalPlayfulInstructions(frozen, context)).toThrow('FORMAL_PLAYFUL_PROMPT_CONFLICT');
+    expect(() => formalPlayfulContextFromPrompt(frozen + frozen)).toThrow('FORMAL_PLAYFUL_CONTEXT_INVALID');
+    expect(() => formalPlayfulContext(MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY,
+      { ...spec, independent: [spec.guided[0], spec.independent[1]] })).toThrow('FORMAL_PLAYFUL_LOCKED_QUESTION_GROUPS_INVALID');
+  });
+
+  it('requires exploration before a grouped guided check and the distinct independent check', () => {
+    const original = scenes();
+    const saved = JSON.stringify(original);
+    expect(() => assertMiraFormalPlayfulScenes(original, context)).not.toThrow();
+    expect(JSON.stringify(original)).toBe(saved);
+    expect(() => assertMiraFormalPlayfulScenes([game(), ...context.guidedQuestionIds.concat(context.independentQuestionIds)
+      .map((id, index) => quiz(id, index + 2, [id]))], context)).toThrow('FORMAL_PLAYFUL_QUIZ_SCENE_COUNT');
+    expect(() => assertMiraFormalPlayfulScenes([game(), quiz('all', 2,
