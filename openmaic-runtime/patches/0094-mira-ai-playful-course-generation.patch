diff --git a/lib/server/mira-formal-playful-policy.ts b/lib/server/mira-formal-playful-policy.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-playful-policy.ts
@@ -0,0 +1,180 @@
+import type { Scene } from '@/lib/types/stage';
+import type { FormalCoursewareSpec } from './mira-formal-compiled-classroom';
+
+/** Opt-in authority for NEW requests. Never add this field to a persisted policy. */
+export const MIRA_FORMAL_PLAYFUL_POLICY = {
+  schemaVersion: 'mira.openmaic.playful-learning.v1',
+  policyId: 'mira-primary-playful-exploration.v1',
+  aiDesigned: true,
+  maxQuizScenes: 2,
+  lockedAssessmentPreserved: true,
+  minimumReplayableGames: 1,
+  threeDUsage: 'teaching_need',
+} as const;
+
+export interface MiraFormalPlayfulContext {
+  policy: typeof MIRA_FORMAL_PLAYFUL_POLICY;
+  subject: FormalCoursewareSpec['course']['subject'];
+  guidedQuestionIds: string[];
+  independentQuestionIds: string[];
+}
+
+const START = '\nMIRA_FORMAL_PLAYFUL_CONTEXT:\n';
+const END = '\nEND_MIRA_FORMAL_PLAYFUL_CONTEXT\n';
+const HISTORICAL_QUIZ_RULE = '- Use between one and four quiz scenes. Distribute the four locked assessment questions across them in original order so every locked question appears exactly once.';
+const PLAYFUL_QUIZ_RULE = '- Use exactly two quiz scenes: the first contains the two locked guided questions together, and the second contains the two locked independent questions together after exploration. Preserve their original order and include each exactly once.';
+const object = (value: unknown): value is Record<string, unknown> =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+const canonical = (value: unknown): string => JSON.stringify(value, (_, item) =>
+  object(item) ? Object.fromEntries(Object.entries(item).sort(([a], [b]) => a.localeCompare(b))) : item);
+function fail(reason: string): never { throw new Error(`FORMAL_PLAYFUL_${reason}`); }
+
+/** Missing means historical; a malformed opt-in must never silently downgrade. */
+export function isMiraFormalPlayfulPolicy(value: unknown): boolean {
+  return canonical(value) === canonical(MIRA_FORMAL_PLAYFUL_POLICY);
+}
+
+export function formalPlayfulContext(
+  creationPolicy: unknown,
+  spec: Pick<FormalCoursewareSpec, 'course' | 'guided' | 'independent'>,
+): MiraFormalPlayfulContext | undefined {
+  if (!object(creationPolicy) || !Object.hasOwn(creationPolicy, 'playfulLearningPolicy'))
+    return undefined;
+  if (!isMiraFormalPlayfulPolicy(creationPolicy.playfulLearningPolicy)) fail('POLICY_INVALID');
+  const context = {
+    policy: MIRA_FORMAL_PLAYFUL_POLICY,
+    subject: spec.course.subject,
+    guidedQuestionIds: spec.guided.map(question => question.id),
+    independentQuestionIds: spec.independent.map(question => question.id),
+  };
+  assertContext(context);
+  return context;
+}
+
+function assertContext(value: unknown): asserts value is MiraFormalPlayfulContext {
+  if (!object(value) || Object.keys(value).sort().join(',') !== 'guidedQuestionIds,independentQuestionIds,policy,subject'
+    || !isMiraFormalPlayfulPolicy(value.policy) || !['math', 'chinese', 'english'].includes(String(value.subject)))
+    fail('CONTEXT_INVALID');
+  const groups = [value.guidedQuestionIds, value.independentQuestionIds];
+  if (groups.some(group => !Array.isArray(group) || group.length !== 2
+    || group.some(id => typeof id !== 'string' || !id.trim() || id.length > 128))
+    || new Set(groups.flat()).size !== 4) fail('LOCKED_QUESTION_GROUPS_INVALID');
+}
+
+/** Exact old bytes are returned unless the new request explicitly opted in. */
+export function withMiraFormalPlayfulInstructions(
+  originalPrompt: string,
+  context: MiraFormalPlayfulContext | undefined,
+): string {
+  if (!context) return originalPrompt;
+  assertContext(context);
+  if (originalPrompt.includes(START) || originalPrompt.split(HISTORICAL_QUIZ_RULE).length !== 2)
+    fail('PROMPT_CONFLICT');
+  return originalPrompt.replace(HISTORICAL_QUIZ_RULE, PLAYFUL_QUIZ_RULE)
+    + START + JSON.stringify(context) + END + `
+AI-DESIGNED PLAYFUL LEARNING v1 — this job's experience requirements:
+Design this course's own exploration game from its exact gradeBoundary, learning objectives,
+allowed content and difficulty. You, the Pro Agent, choose the setting, rules, manipulable objects,
+meaningful states and feedback. No fixed lesson template, predefined level array, copied game,
+mandatory space theme, widget rotation or extra course strand is supplied or required.
+
+Make learning primarily a short demonstration -> learner attempt -> visible consequence ->
+brief explanation -> retry loop. Exploration and hands-on play lead the lesson; a long slide
+lecture followed by an exam does not meet this brief. Plan the smallest complete sequence,
+respect the existing scene/time limits, and never use a percentage quota or add filler pages.
+Show one short instruction at a time, a large teaching model and compact controls. Let the
+teacher narrate the explanation; avoid paragraphs of duplicated on-screen narration.
+
+Create at least one interactive scene with widgetType="game" and matching widgetConfig.type.
+Choose puzzle, strategy or card for gameType; never quiz. Its self-contained HTML/JS must have
+a visible child-readable goal, concise rules, meaningful learner operations, a result computed
+from the manipulated teaching model, explanatory feedback, and a working restart/replay control.
+The goal must require the target knowledge: unrelated clicking, a timer, a counter, a reward
+animation, a choice that reveals a canned answer, or decorative 3D is not a learning game.
+Allow mistakes, explain the observed consequence gently, and let the learner try again.
+Use the existing multistate interaction plan and real pointer/touch probes to prove distinct
+model states and reset. Include a path toward the goal and a recoverable unsuccessful attempt
+in the generated verification states. Goal/rules are learner-visible, not just metadata.
+Pass these concrete game requirements in generate_scene briefs for BOTH content and actions,
+then read back and repair the actual HTML, controls and narration before quality review.
+
+Preserve all FOUR locked assessment questions, wording, IDs, types and options exactly.
+Group guidedQuestionIds in one guided quiz scene after the learner has tried the model;
+group independentQuestionIds in one later independent quiz scene to close the learning check.
+Do not spread them over four quiz pages, merge the two groups, duplicate them inside the game,
+remove guided questions, or describe this as fewer scored questions. Game exploration adds no
+new assessment items: omit game.questions and never disguise extra quizzes as a game.
+Game feedback is local practice feedback only; it must not award official points, mastery,
+rewards, completion or runtime events. If game widgetConfig requires scoring, use
+scoring:{correctPoints:0}, omit bonuses/achievements, and show task feedback rather than points.
+The existing four-question backend contract remains the sole scoring/progress authority.
+
+For a mathematics brief whose actual allowed content and learning objectives teach quantities,
+grouping, fractions, ratios or percentages, create at least one real manipulable 3D teaching
+model inside the game or a supporting visualization3d scene. Even a scalar ratio can be made
+observable through selectable/grouped objects: provide meaningful rotate, select and
+split/regroup operations tied to that objective. The Agent chooses the representation and
+rules from the brief, not from a fixed course title or a prewritten game/level list.
+Use real geometry, camera/projection and state-linked quantities with learner controls.
+Do not introduce volume formulas, advanced solids or other unlisted prerequisites just
+because the representation has depth. The taught concept stays within the exact boundary.
+For other mathematics, use 3D when depth, construction or decomposition improves the specific
+objective; do not force it onto every mathematical topic.
+A CSS tilted card, static rendered planet, spinning decoration or camera-only orbit is not
+meaningful 3D. Use available supported rendering dependencies and a readable recovery state;
+do not invent CDN URLs or require network assets that the course cannot load.
+For language and concepts better served by 2D arrangements, use a clear 2D game; no compulsory
+3D for Chinese/English. State the teaching reason for the representation in the private brief.
+Keep the existing independently verified numeric diagram when that mechanism requires it:
+3D supplements it and never replaces its exact geometry, quantities or assessment evidence.
+
+AUTHORITY: this policy narrows quiz page count and requires a genuine game; the remaining
+widget choices stay adaptive. Generic Skill defaults must not turn it back into a quiz game,
+force a widget roster or add questions. Grade, difficulty, locked question groups, research,
+roster, audio, interaction/visual quality and all existing publication gates remain unchanged.
+The game label alone proves nothing: the actual model, goal, controls, feedback, replay and
+teaching chain must pass the existing independent semantic and rendered interaction reviews.
+`;
+}
+
+/** Only the frozen new prompt activates new checks in the read-only review path. */
+export function formalPlayfulContextFromPrompt(prompt: string): MiraFormalPlayfulContext | undefined {
+  const parts = prompt.split(START);
+  if (parts.length === 1) return undefined;
+  if (parts.length !== 2 || parts[1].split(END).length !== 2) return fail('CONTEXT_INVALID');
+  let value: unknown;
+  try { value = JSON.parse(parts[1].split(END)[0]); } catch { return fail('CONTEXT_INVALID'); }
+  assertContext(value);
+  return value;
+}
+
+/** A structural guard, not a semantic or browser pass. Existing quality gates still run. */
+export function assertMiraFormalPlayfulScenes(
+  scenes: readonly Scene[],
+  context: MiraFormalPlayfulContext | undefined,
+): void {
+  if (!context) return;
+  assertContext(context);
+  const ordered = [...scenes].sort((a, b) => a.order - b.order);
+  const quizzes = ordered.filter(scene => scene.type === 'quiz');
+  if (quizzes.length !== 2) fail('QUIZ_SCENE_COUNT');
+  for (const [index, ids] of [context.guidedQuestionIds, context.independentQuestionIds].entries()) {
+    const content = quizzes[index].content;
+    if (content.type !== 'quiz' || canonical(content.questions.map(question => question.id)) !== canonical(ids))
+      fail('LOCKED_QUESTION_PLACEMENT');
+  }
+  const games = ordered.filter(scene => scene.content.type === 'interactive' && scene.content.widgetType === 'game');
+  if (!games.length) fail('GAME_MISSING');
+  if (!games.some(scene => scene.order < quizzes[0].order)) fail('EXPLORE_BEFORE_GUIDED');
+  for (const scene of games) {
+    if (scene.content.type !== 'interactive') continue;
+    const config = scene.content.widgetConfig;
+    if (!object(config) || config.type !== 'game' || !['puzzle', 'strategy', 'card'].includes(String(config.gameType))
+      || (config.questions !== undefined && (!Array.isArray(config.questions) || config.questions.length > 0)))
+      fail('QUIZ_DISGUISED_AS_GAME');
+    const scoring = config.scoring;
+    if (!object(scoring) || scoring.correctPoints !== 0 || scoring.speedBonus || scoring.comboMultiplier
+      || scoring.penalty || (config.achievements !== undefined
+        && (!Array.isArray(config.achievements) || config.achievements.length > 0))) fail('GAME_SCORE_AUTHORITY');
+  }
+}
