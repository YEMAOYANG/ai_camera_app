+export const MIRA_STRUCTURED_SCENE_POLICY_ENV = 'MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY';
+export const MIRA_STRUCTURED_SCENE_POLICY_ID = 'kimi-k2.6-thinking-disabled-v1';
