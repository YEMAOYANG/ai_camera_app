+}
+
+function getMiraStructuredSceneRoute(stage: string): StageRoute | undefined {
+  const policy = process.env[MIRA_STRUCTURED_SCENE_POLICY_ENV]?.trim();
+  if (!policy) return undefined;
+  if (policy !== MIRA_STRUCTURED_SCENE_POLICY_ID) {
+    throw new Error(
+      `Unsupported ${MIRA_STRUCTURED_SCENE_POLICY_ENV}; expected ${MIRA_STRUCTURED_SCENE_POLICY_ID}.`,
+    );
+  }
+  if (!MIRA_STRUCTURED_SCENE_STAGE_SET.has(stage)) return undefined;
+
+  return {
+    model: MIRA_STRUCTURED_SCENE_MODEL,
+    thinking: { mode: 'disabled', enabled: false },
+    enforced: true,
+  };
+}
+
+type StageRouteResolver = (stage: string) => StageRoute | undefined;
+
+/**
+ * Validate every protected stage through the same route resolver used by
+ * generation. This keeps health readiness tied to the effective server-owned
+ * policy instead of a separately hard-coded success response.
