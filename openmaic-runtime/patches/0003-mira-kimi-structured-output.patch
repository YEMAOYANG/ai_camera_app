+      route.enforced !== true ||
+      route.model !== MIRA_STRUCTURED_SCENE_MODEL ||
+      route.thinking.mode !== 'disabled' ||
+      route.thinking.enabled !== false ||
+      routeKeys.join(',') !== 'enforced,model,thinking' ||
+      thinkingKeys.join(',') !== 'enabled,mode'
+    ) {
+      throw new Error(`Structured scene route mismatch for ${stage}.`);
+    }
+
+    const separator = route.model.indexOf(':');
+    const providerId = separator > 0 ? route.model.slice(0, separator) : '';
+    const modelId = separator > 0 ? route.model.slice(separator + 1) : '';
+    if (
+      providerId !== MIRA_STRUCTURED_SCENE_PROVIDER_ID ||
+      modelId !== MIRA_STRUCTURED_SCENE_MODEL_ID
