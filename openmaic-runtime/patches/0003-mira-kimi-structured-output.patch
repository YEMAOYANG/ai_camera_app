+import { describe, expect, it, vi } from 'vitest';
+import { withGenerationRetry } from '@openmaic/generation';
+import {
+  captureStructuredOutputAttempt,
+  isStructuredOutputExhaustedAfterParseFailure,
+  STRUCTURED_OUTPUT_EXHAUSTED_CODE,
+  StructuredOutputExhaustedError,
+} from '@/lib/server/structured-output-guard';
+
+describe('structured output exhaustion guard', () => {
+  it('captures only safe metadata for the observed Kimi reasoning starvation shape', () => {
+    const metadata = captureStructuredOutputAttempt(
+      {
+        text: 'PRIVATE_RESPONSE',
+        finishReason: 'length',
+        rawFinishReason: 'length',
+        totalUsage: {
+          outputTokens: 8192,
+          outputTokenDetails: { reasoningTokens: 8191 },
+        },
+      },
+      {
+        attempt: 1,
+        stage: 'scene-content:slide',
+        modelString: 'kimi:kimi-k2.6',
+        outputWindow: 8192,
+      },
+    );
+
+    expect(metadata).toEqual({
+      attempt: 1,
+      stage: 'scene-content:slide',
+      modelString: 'kimi:kimi-k2.6',
+      outputWindow: 8192,
+      finishReason: 'length',
+      rawFinishReason: 'length',
+      outputTokens: 8192,
+      reasoningTokens: 8191,
+      textTokens: 1,
+      textLength: 16,
+      reachedOutputWindow: true,
+      nearEmpty: true,
+    });
+    expect(JSON.stringify(metadata)).not.toContain('PRIVATE_RESPONSE');
+  });
+
+  it('classifies a long truncated parse at the hard window as non-retryable exhaustion', () => {
+    const metadata = captureStructuredOutputAttempt(
+      {
+        text: 'x'.repeat(2000),
+        finishReason: 'unknown',
+        totalUsage: {
+          outputTokens: 8192,
+          outputTokenDetails: { textTokens: 190, reasoningTokens: 8002 },
+        },
+      },
+      {
+        attempt: 2,
+        stage: 'scene-content:slide',
+        modelString: 'kimi:kimi-k2.6',
+        outputWindow: 8192,
+      },
+    );
+
+    expect(metadata.nearEmpty).toBe(false);
+    expect(isStructuredOutputExhaustedAfterParseFailure(metadata)).toBe(true);
+
+    const error = new StructuredOutputExhaustedError(metadata);
+    expect(error).toMatchObject({
+      name: 'StructuredOutputExhaustedError',
+      message: STRUCTURED_OUTPUT_EXHAUSTED_CODE,
+      code: STRUCTURED_OUTPUT_EXHAUSTED_CODE,
+      isRetryable: false,
+    });
+    expect(error.diagnostic.failureKind).toBe('parse_failed');
+    expect(JSON.stringify(error.diagnostic)).not.toContain('x'.repeat(32));
+  });
+
+  it('uses provider length as a deterministic signal when token usage is unavailable', () => {
+    const metadata = captureStructuredOutputAttempt(
+      { text: '{"elements":', finishReason: 'length' },
+      {
+        attempt: 1,
+        stage: 'scene-content:quiz',
+        modelString: 'kimi:kimi-k2.6',
+      },
+    );
+
+    expect(metadata.reachedOutputWindow).toBe(false);
+    expect(isStructuredOutputExhaustedAfterParseFailure(metadata)).toBe(true);
+  });
+
+  it('does not classify an under-window stop result as output exhaustion', () => {
+    const metadata = captureStructuredOutputAttempt(
+      {
+        text: 'not-json',
+        finishReason: 'stop',
+        totalUsage: {
+          outputTokens: 40,
+          outputTokenDetails: { textTokens: 40, reasoningTokens: 0 },
+        },
+      },
+      {
+        attempt: 1,
+        stage: 'scene-content:interactive',
+        modelString: 'kimi:kimi-k2.6',
+        outputWindow: 8192,
+      },
+    );
+
+    expect(isStructuredOutputExhaustedAfterParseFailure(metadata)).toBe(false);
+  });
+
+  it('stops the generic retry loop immediately for the stable exhaustion error', async () => {
+    const metadata = captureStructuredOutputAttempt(
+      {
+        text: '{',
+        finishReason: 'length',
+        usage: {
+          outputTokens: 8192,
+          outputTokenDetails: { textTokens: 1, reasoningTokens: 8191 },
+        },
+      },
+      {
+        attempt: 1,
+        stage: 'scene-content:slide',
+        modelString: 'kimi:kimi-k2.6',
+        outputWindow: 8192,
+      },
+    );
+    const error = new StructuredOutputExhaustedError(metadata);
+    const operation = vi.fn(async () => {
+      throw error;
+    });
+    const onRetry = vi.fn();
+
+    await expect(
+      withGenerationRetry(operation, {
+        label: 'structured scene',
+        onRetry,
+        sleep: async () => undefined,
+      }),
+    ).rejects.toMatchObject({
+      code: STRUCTURED_OUTPUT_EXHAUSTED_CODE,
+      isRetryable: false,
+    });
+    expect(operation).toHaveBeenCalledTimes(1);
+    expect(onRetry).not.toHaveBeenCalled();
+  });
+
+  it('keeps retrying a transient provider failure', async () => {
+    const operation = vi
+      .fn<() => Promise<string>>()
+      .mockRejectedValueOnce(Object.assign(new Error('rate limited'), { statusCode: 429 }))
+      .mockResolvedValueOnce('ok');
+    const onRetry = vi.fn();
+
+    await expect(
+      withGenerationRetry(operation, {
+        label: 'structured scene',
+        maxRetries: 1,
+        onRetry,
+        sleep: async () => undefined,
+      }),
+    ).resolves.toBe('ok');
+    expect(operation).toHaveBeenCalledTimes(2);
+    expect(onRetry).toHaveBeenCalledTimes(1);
+  });
+});
