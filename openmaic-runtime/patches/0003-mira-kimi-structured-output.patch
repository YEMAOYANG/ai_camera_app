diff --git a/lib/server/structured-output-guard.ts b/lib/server/structured-output-guard.ts
new file mode 100644
index 0000000..e749990
--- /dev/null
+++ b/lib/server/structured-output-guard.ts
@@ -0,0 +1,143 @@
+export const STRUCTURED_OUTPUT_EXHAUSTED_CODE = 'structured_output_exhausted' as const;
+
+const NEAR_EMPTY_TEXT_TOKEN_LIMIT = 8;
+const NEAR_EMPTY_TEXT_CHARACTER_LIMIT = 32;
+
+interface UsageLike {
+  outputTokens?: number;
+  outputTokenDetails?: {
+    textTokens?: number;
+    reasoningTokens?: number;
+  };
+}
+
+export interface StructuredOutputResultLike {
+  text: string;
+  finishReason?: string;
+  rawFinishReason?: string;
+  usage?: UsageLike;
+  totalUsage?: UsageLike;
+}
+
+export interface StructuredOutputAttemptMetadata {
+  attempt: number;
+  stage: string;
+  modelString: string;
+  outputWindow?: number;
+  finishReason?: string;
+  rawFinishReason?: string;
+  outputTokens?: number;
+  reasoningTokens?: number;
+  textTokens?: number;
+  textLength: number;
+  reachedOutputWindow: boolean;
+  nearEmpty: boolean;
+}
+
+export interface StructuredOutputExhaustedDiagnostic extends StructuredOutputAttemptMetadata {
+  code: typeof STRUCTURED_OUTPUT_EXHAUSTED_CODE;
+  failureKind: 'parse_failed';
+}
+
+function finiteNonNegative(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : undefined;
+}
+
+function normalizeFinishReason(value: unknown): string | undefined {
+  if (typeof value !== 'string') return undefined;
+  switch (value.trim().toLowerCase()) {
+    case 'length':
+    case 'max_tokens':
+    case 'max_output_tokens':
+      return 'length';
+    case 'stop':
+    case 'content-filter':
+    case 'tool-calls':
+    case 'error':
+    case 'other':
+    case 'unknown':
+      return value.trim().toLowerCase();
+    default:
+      return 'other';
+  }
+}
+
+/**
+ * Reduce an LLM result to metadata that is safe to retain or log. The generated
+ * text, prompts, reasoning content, response body, headers and credentials are
+ * intentionally excluded.
+ */
+export function captureStructuredOutputAttempt(
+  result: StructuredOutputResultLike,
+  context: { attempt: number; stage: string; modelString: string; outputWindow?: number },
+): StructuredOutputAttemptMetadata {
+  // finishReason describes the last model step, so prefer the last-step usage
+  // as well. Scene generation is single-step today; totalUsage is a safe
+  // fallback for adapters that omit the per-step field.
+  const usage = result.usage ?? result.totalUsage;
+  const outputTokens = finiteNonNegative(usage?.outputTokens);
+  const reasoningTokens = finiteNonNegative(usage?.outputTokenDetails?.reasoningTokens);
+  const reportedTextTokens = finiteNonNegative(usage?.outputTokenDetails?.textTokens);
+  const textTokens =
+    reportedTextTokens ??
+    (outputTokens !== undefined && reasoningTokens !== undefined
+      ? Math.max(0, outputTokens - reasoningTokens)
+      : undefined);
+  const outputWindow = finiteNonNegative(context.outputWindow);
+  const textLength = result.text.length;
+
+  return Object.freeze({
+    attempt: Math.max(1, Math.floor(context.attempt)),
+    stage: context.stage,
+    modelString: context.modelString,
+    outputWindow,
+    finishReason: normalizeFinishReason(result.finishReason),
+    rawFinishReason: normalizeFinishReason(result.rawFinishReason),
+    outputTokens,
+    reasoningTokens,
+    textTokens,
+    textLength,
+    reachedOutputWindow:
+      outputWindow !== undefined && outputTokens !== undefined && outputTokens >= outputWindow,
+    nearEmpty:
+      (textTokens !== undefined && textTokens <= NEAR_EMPTY_TEXT_TOKEN_LIMIT) ||
+      textLength <= NEAR_EMPTY_TEXT_CHARACTER_LIMIT,
+  });
+}
+
+/**
+ * Classify a failed structured parse as deterministic exhaustion only when the
+ * provider says it ended for length, or its measured output reached the model
+ * window. Near-empty output is also retained as an explicit signal, but a
+ * successfully parsed result is never rejected merely for reaching the limit.
+ */
+export function isStructuredOutputExhaustedAfterParseFailure(
+  metadata: StructuredOutputAttemptMetadata | undefined,
+): metadata is StructuredOutputAttemptMetadata {
+  if (!metadata) return false;
+
+  const providerReportedLength =
+    metadata.finishReason === 'length' || metadata.rawFinishReason === 'length';
+
+  // The caller invokes this only after the structured parser returned null.
+  // `nearEmpty` remains an explicit diagnostic for the observed Kimi starvation
+  // signature, but a longer truncated JSON result is equally deterministic
+  // when the provider reports length or reaches the configured hard window.
+  return metadata.reachedOutputWindow || providerReportedLength;
+}
+
+export class StructuredOutputExhaustedError extends Error {
+  readonly code = STRUCTURED_OUTPUT_EXHAUSTED_CODE;
+  readonly isRetryable = false;
+  readonly diagnostic: StructuredOutputExhaustedDiagnostic;
+
+  constructor(metadata: StructuredOutputAttemptMetadata) {
+    super(STRUCTURED_OUTPUT_EXHAUSTED_CODE);
+    this.name = 'StructuredOutputExhaustedError';
+    this.diagnostic = Object.freeze({
+      code: STRUCTURED_OUTPUT_EXHAUSTED_CODE,
+      failureKind: 'parse_failed',
+      ...metadata,
+    });
+  }
+}
