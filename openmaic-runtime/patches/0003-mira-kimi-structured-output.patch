+  policyId: typeof MIRA_STRUCTURED_SCENE_POLICY_ID;
+  providerId: typeof MIRA_STRUCTURED_SCENE_PROVIDER_ID;
+  modelId: typeof MIRA_STRUCTURED_SCENE_MODEL_ID;
+  stages: readonly (typeof MIRA_STRUCTURED_SCENE_STAGES)[number][];
+  thinking: {
+    mode: 'disabled';
+    enabled: false;
