+    policyId: MIRA_STRUCTURED_SCENE_POLICY_ID,
+    providerId: resolvedProviderId as typeof MIRA_STRUCTURED_SCENE_PROVIDER_ID,
+    modelId: resolvedModelId as typeof MIRA_STRUCTURED_SCENE_MODEL_ID,
+    stages: [...MIRA_STRUCTURED_SCENE_STAGES],
+    thinking: { mode: 'disabled', enabled: false },
+  };
+}
