diff --git a/lib/ai/model-transport-identity.ts b/lib/ai/model-transport-identity.ts
new file mode 100644
--- /dev/null
+++ b/lib/ai/model-transport-identity.ts
@@ -0,0 +1,17 @@
+/** Non-secret connection provenance carried through model wrappers into usage rows. */
+export interface ModelTransportIdentity {
+  providerService: string;
+  providerHost: string;
+  wireModelId: string;
+}
+const identities = new WeakMap<object, ModelTransportIdentity>();
+export function setModelTransportIdentity(model: unknown, identity: ModelTransportIdentity): void {
+  if (model && typeof model === 'object') identities.set(model, { ...identity });
+}
+export function getModelTransportIdentity(model: unknown): ModelTransportIdentity | undefined {
+  return model && typeof model === 'object' ? identities.get(model) : undefined;
+}
+export function copyModelTransportIdentity(source: unknown, target: unknown): void {
+  const identity = getModelTransportIdentity(source);
+  if (identity) setModelTransportIdentity(target, identity);
+}
