diff --git a/lib/server/mira-authoring-provider.ts b/lib/server/mira-authoring-provider.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-authoring-provider.ts
@@ -0,0 +1,25 @@
+/** Server-owned courseware connection override; never selected by request headers. */
+import { isAutoRouterDeepSeekEndpoint, AUTOROUTER_DEEPSEEK_MODELS } from '@/lib/ai/deepseek-service';
+
+export function resolveMiraAuthoringConnection(providerId: string, modelId: string) {
+  if (providerId !== 'deepseek') return undefined;
+  const service = process.env.MIRA_OPENMAIC_AUTHORING_DEEPSEEK_SERVICE?.trim();
+  if (!service || service === 'inherit') return undefined;
+  if (service !== 'autorouter') throw new Error('MIRA_AUTHORING_SERVICE_INVALID');
+  const apiKey = process.env.AUTOROUTER_DEEPSEEK_API_KEY?.trim();
+  const baseUrl = process.env.AUTOROUTER_DEEPSEEK_BASE_URL?.trim();
+  if (!apiKey || !baseUrl || !isAutoRouterDeepSeekEndpoint(baseUrl)
+    || !/^\/v1\/?$/.test(new URL(baseUrl).pathname))
+    throw new Error('MIRA_AUTHORING_SERVICE_UNAVAILABLE');
+  if (!Object.prototype.hasOwnProperty.call(AUTOROUTER_DEEPSEEK_MODELS, modelId))
+    throw new Error('MIRA_AUTHORING_MODEL_UNSUPPORTED');
+  return { apiKey, baseUrl };
+}
+
+export function getMiraAuthoringModelService() {
+  const connection = resolveMiraAuthoringConnection('deepseek', 'deepseek-v4-pro');
+  return connection
+    ? { scope: 'courseware-authoring', service: 'autorouter', host: 'api.autorouter.top',
+        wireModels: AUTOROUTER_DEEPSEEK_MODELS, automaticFallback: false }
+    : { scope: 'courseware-authoring', service: 'inherit', automaticFallback: false };
+}
