+    legibility:'passed'|'needs_revision';layout:'passed'|'needs_revision';teachingGraphic:'passed'|'needs_revision';interactionAffordance:'passed'|'needs_revision';notes:string}>;
+  providerId:string;modelId:string;providerResponseModelId?:string;providerRequestIdHash:string;receiptSha256:string;
+};
+export function assertVisualReview(value: unknown, input: Pick<VisualInput,'snapshotSha256'|'teachingQualityContextSha256'|'observations'>): asserts value is VisualReviewReceipt {
+  const r=value as VisualReviewReceipt;
+  const sha=(v:unknown)=>typeof v==='string'&&/^[a-f0-9]{64}$/.test(v);
