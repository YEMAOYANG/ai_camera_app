+import { describe, expect, it } from 'vitest';
+import { chromium } from 'playwright-core';
+import { assertExplorationObservation, inspectExploration, validateExploration, type Exploration } from '@/lib/server/mira-formal-exploration';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+
+const ratios = [[1,4],[2,5],[3,4]];
+function model(): Exploration {
+  return { schemaVersion:'mira.openmaic.multistate-exploration.v1',
+    mechanism:{kind:'fraction-ratio-percentage.v1',numeratorSelector:'#n',denominatorSelector:'#d',decimalSelector:'#decimal',percentSelector:'#percent',wholeSelector:'#whole',partSelector:'#part'},
+    diagramSelector:'#model',feedbackSelector:'#result',
+    states:ratios.map(([numerator,denominator],i)=>({id:`s${i}`,operations:[{selector:`#s${i}`,action:'click'}],numerator,denominator,
+      resultText:`${numerator}/${denominator} = ${numerator/denominator*100}%`,explanationText:`把整体平均分成${denominator}份，取其中${numerator}份。`})),
+    reset:{selector:'#reset',stateId:'s0'}};
+}
+function observation() {
+  return {mechanism:'fraction-ratio-percentage.v1',verification:'independent_numeric_svg',inputMode:'pointer',resetPassed:true,
+    states:ratios.map(([n,d],i)=>({stateId:`s${i}`,diagramSha256:qualitySha(`diagram${i}`),feedbackSha256:qualitySha(`feedback${i}`),
+      numeric:{numerator:n,denominator:d,decimal:n/d,percent:n/d*100,diagramRatio:n/d}}))};
+}
+describe('multistate independent mechanism authority',()=>{
+  it('requires distinct meaningful ratios and forbids semantic downgrade of the quantitative skill',()=>{
+    validateExploration(model(),'fraction_ratio_percentage');
+    const same=model(); same.states[2]={...same.states[2],numerator:2,denominator:8};
+    expect(()=>validateExploration(same)).toThrow();
+    const generic={...model(),mechanism:{kind:'semantic-state-model.v1'},states:model().states.map(({numerator,denominator,...s})=>s)};
+    validateExploration(generic,'language_organization');
+    expect(()=>validateExploration(generic,'fraction_ratio_percentage')).toThrow();
+  });
+  it('rechecks numeric, reset and device evidence when resuming cached passes',()=>{
+    assertExplorationObservation(observation(),model(),'pointer');
+    for(const mutate of [
+      (o:any)=>o.states[1].numeric.diagramRatio=0.5,
+      (o:any)=>o.states[1].numeric.percent=25,
+      (o:any)=>o.states[1].diagramSha256=o.states[0].diagramSha256,
+      (o:any)=>o.resetPassed=false,
+      (o:any)=>o.inputMode='touch',
+    ]) {const o=observation();mutate(o);expect(()=>assertExplorationObservation(o,model(),'pointer')).toThrow();}
+  });
+});
+
+const browserDescribe=process.env.FORMAL_INSPECTION_BROWSER==='1'?describe:describe.skip;
+browserDescribe('actual fraction controls and SVG results, no providers',()=>{
+  it('operates three states and reset on pointer/touch and rejects decorative incorrect geometry',async()=>{
+    const browser=await chromium.launch({executablePath:process.env.MIRA_FORMAL_QA_BROWSER_PATH||'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',headless:true});
+    try {
+      for(const mode of ['pointer','touch'] as const){
+        const context=await browser.newContext({hasTouch:mode==='touch',viewport:{width:1280,height:720}});
+        const page=await context.newPage();
+        await page.setContent(`<style>button{width:90px;height:48px} #model{width:400px;height:140px}</style>
+          ${ratios.map((_,i)=>`<button id="s${i}" onclick="set(${i})">状态${i}</button>`).join('')}<button id="reset" onclick="set(0)">重置</button>
+          <input id="n"><input id="d"><span id="decimal"></span><span id="percent"></span>
+          <svg id="model" viewBox="0 0 400 140"><rect id="whole" x="20" y="30" width="320" height="60" fill="#ddd"/><rect id="part" x="20" y="30" height="60" fill="#3678dc"/></svg><p id="result"></p>
+          <script>const data=${JSON.stringify(ratios)};function set(i){const[a,b]=data[i];n.value=a;d.value=b;decimal.textContent=a/b;percent.textContent=a/b*100+'%';part.setAttribute('width',320*a/b);result.textContent=a+'/'+b+' = '+(a/b*100)+'% 把整体平均分成'+b+'份，取其中'+a+'份。'}set(0)</script>`);
+        const activate=async(selector:string)=>{if(mode==='touch')await page.locator(selector).tap();else await page.locator(selector).click();};
+        const seen=await inspectExploration(page,model(),mode,activate);
+        assertExplorationObservation(seen,model(),mode);
+        await page.evaluate(()=>{const original=(window as any).set;(window as any).set=(i:number)=>{original(i);document.querySelector('#part')!.setAttribute('width','160');};});
+        await expect(inspectExploration(page,model(),mode,activate)).rejects.toThrow('fraction mechanism');
+        await context.close();
+      }
+    } finally {await browser.close();}
+  },20000);
+});
