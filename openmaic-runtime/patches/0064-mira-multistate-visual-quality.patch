+import type { Frame, Page } from 'playwright-core';
+import { createHash } from 'node:crypto';
+import { VISUAL_RUBRIC } from './mira-formal-visual-contract';
+
+export const EXPLORATION_SCHEMA = 'mira.openmaic.multistate-exploration.v1' as const;
+export const EXPLORATION_POLICY = {
+  schemaVersion: EXPLORATION_SCHEMA, minimumStates: 3, maximumStates: 5, resetRequired: true,
+  inputModes: ['pointer', 'touch'],
+  mechanismRegistry: ['fraction-ratio-percentage.v1', 'semantic-state-model.v1'],
+} as const;
+type Operation = { selector: string; action: 'click' | 'fill' | 'select'; value?: string };
+export type ExplorationState = { id: string; operations: Operation[]; resultText: string; explanationText: string;
+  numerator?: number; denominator?: number };
+export type Exploration = {
+  schemaVersion: typeof EXPLORATION_SCHEMA;
+  mechanism: { kind: 'fraction-ratio-percentage.v1'; numeratorSelector: string; denominatorSelector: string;
+    decimalSelector: string; percentSelector: string; wholeSelector: string; partSelector: string }
+    | { kind: 'semantic-state-model.v1' };
+  diagramSelector: string; feedbackSelector: string; states: ExplorationState[];
+  reset: { selector: string; stateId: string };
+};
+export type ExplorationObservation = {
+  mechanism: Exploration['mechanism']['kind']; verification: 'independent_numeric_svg' | 'structural_then_semantic_visual_review';
+  inputMode: 'pointer' | 'touch'; resetPassed: true;
+  states: Array<{ stateId: string; diagramSha256: string; feedbackSha256: string;
+    numeric?: { numerator: number; denominator: number; decimal: number; percent: number; diagramRatio: number } }>;
+};
+const obj = (v: unknown): v is Record<string, any> => !!v && typeof v === 'object' && !Array.isArray(v);
+const exact = (v: unknown, fields: string[]) => obj(v) && Object.keys(v).sort().join(',') === fields.sort().join(',');
+const sel = (v: unknown): v is string => typeof v === 'string' && /^#[A-Za-z][A-Za-z0-9_-]{0,98}$/.test(v);
+const text = (v: unknown) => typeof v === 'string' && v.trim().length >= 3 && v.length <= 500;
+const fail = (): never => { throw new Error('FORMAL_EXPLORATION_CONTRACT_INVALID'); };
+
+/** Registered mechanisms never execute generated JS to decide the expected answer. */
+export function validateExploration(raw: unknown, skillId?: unknown): asserts raw is Exploration {
+  if (!obj(raw)) return fail();
+  const value = raw;
+  if (!exact(value, ['schemaVersion','mechanism','diagramSelector','feedbackSelector','states','reset']) || !obj(value)
+    || value.schemaVersion !== EXPLORATION_SCHEMA || !sel(value.diagramSelector) || !sel(value.feedbackSelector)
+    || value.diagramSelector === value.feedbackSelector || !Array.isArray(value.states) || value.states.length < 3 || value.states.length > 5
+    || !exact(value.reset, ['selector','stateId']) || !sel(value.reset.selector) || !obj(value.mechanism)) fail();
+  const numeric = value.mechanism.kind === 'fraction-ratio-percentage.v1';
+  if (numeric) {
+    if (!exact(value.mechanism, ['kind','numeratorSelector','denominatorSelector','decimalSelector','percentSelector','wholeSelector','partSelector'])
+      || Object.entries(value.mechanism).some(([k,v]) => k !== 'kind' && !sel(v))) fail();
+  } else if (!exact(value.mechanism,['kind']) || value.mechanism.kind !== 'semantic-state-model.v1') fail();
+  // This known quantitative skill cannot silently downgrade to a semantic check.
+  if (skillId === 'fraction_ratio_percentage' && !numeric) fail();
+  const ids = new Set<string>(), outputs = new Set<string>(), ratios = new Set<number>();
+  for (const s of value.states) {
+    if (!exact(s,['id','operations','resultText','explanationText',...(numeric ? ['numerator','denominator'] : [])])
+      || !/^[A-Za-z0-9_-]{1,40}$/.test(s.id) || ids.has(s.id) || !text(s.resultText) || !text(s.explanationText)
+      || !Array.isArray(s.operations) || !s.operations.length || s.operations.length > 3) fail();
+    ids.add(s.id); outputs.add(s.resultText);
+    for (const op of s.operations) if (!exact(op,['selector','action',...(op.action !== 'click' ? ['value'] : [])])
+      || !sel(op.selector) || !['click','fill','select'].includes(op.action)
+      || (op.action !== 'click' && (typeof op.value !== 'string' || !op.value || op.value.length > 100))) fail();
+    if (numeric) {
+      if (!Number.isInteger(s.numerator) || !Number.isInteger(s.denominator) || s.numerator <= 0
+        || s.numerator > s.denominator || s.denominator > 1000) fail();
+      ratios.add(s.numerator / s.denominator);
+    }
+  }
+  if (!ids.has(value.reset.stateId) || outputs.size !== value.states.length || (numeric && ratios.size !== value.states.length)) fail();
+}
+
+export const EXPLORATION_PROMPT = `
+MULTISTATE EXPLORATION v2: For each core goal extend its interaction-plan objective with exploration.
+Use plan schema mira.openmaic.interaction-design-plan.v2. exploration schema is ${EXPLORATION_SCHEMA}.
+Shape: {schemaVersion,mechanism,diagramSelector:'#model',feedbackSelector:'#result',states:[
+{id:'state-a',operations:[{selector:'#control',action:'fill',value:'1'}],resultText:'observable result',explanationText:'why it happens'}],
+reset:{selector:'#reset',stateId:'state-a'}}. Exactly 3-5 distinct meaningful states; 1-3 local click/fill/select operations per state;
+click omits value. Every state MUST change the actual diagram AND explain the corresponding result. Reset restores the stated baseline.
+Use semantic-state-model.v1 for language/classification/other models: mechanism:{kind:'semantic-state-model.v1'}.
+For fraction_ratio_percentage, use the independently checked mechanism {kind:'fraction-ratio-percentage.v1',
+numeratorSelector:'#numerator',denominatorSelector:'#denominator',decimalSelector:'#decimal',percentSelector:'#percent',
+wholeSelector:'#whole-bar',partSelector:'#part-bar'}. Every state adds numerator and denominator (positive integers <=1000,
+numerator<=denominator). The inputs expose those actual numbers. Decimal and percent elements contain ONLY their numeric value
+(percent may end with %). Show an SVG fraction bar: separate whole and part rects share x/y/height, and part.width/whole.width=numerator/denominator.
+Compute decimal=numerator/denominator and percent=100*decimal. Test three DIFFERENT ratios, not equivalent fractions or altered button colors.
+For example 1/4, 2/5, 3/4 create distinct quantity/diagram/explanation states; use values aligned with the locked grade/difficulty.
+Never fake data attributes, static answer labels or decorative bars. This numeric skill cannot use the semantic fallback.
+Provide visible reset and labelled controls with >=44px touch targets, body type >=14px, clear heading hierarchy, unclipped content,
+and a central teaching graphic at least 120x80px. Desktop pointer and touch paths must both operate the same model without hover-only actions.
+Visual inspection will review ACTUAL screenshots; a text-only reviewer never counts as image review.
+Use the teaching model as the main visual region, adjacent parameter controls, clear numeric units, synchronized explanation,
+meaningful presets and reset. Match older primary learners: restrained, precise visual language, short copy but intact reasoning,
+not decorative card piles or childish illustrations. Complete the teaching chain within at most 16 well-planned scenes (32 actual screenshots).
+The independent visual rubric is: ${JSON.stringify(VISUAL_RUBRIC)}
+`;
+
+/** Recheck persisted observations rather than accepting a signed-looking cached pass. */
+export function assertExplorationObservation(raw: unknown, model: Exploration, mode: 'pointer' | 'touch'): asserts raw is ExplorationObservation {
+  validateExploration(model);
+  if (!obj(raw)) return fail();
+  const numeric = model.mechanism.kind === 'fraction-ratio-percentage.v1';
+  if (!exact(raw, ['mechanism','verification','inputMode','resetPassed','states'])
+    || raw.mechanism !== model.mechanism.kind || raw.resetPassed !== true || raw.inputMode !== mode
+    || raw.verification !== (numeric ? 'independent_numeric_svg' : 'structural_then_semantic_visual_review')
+    || !Array.isArray(raw.states) || raw.states.length !== model.states.length) fail();
+  for (const [index, actual] of raw.states.entries()) {
+    const state = model.states[index];
+    if (!exact(actual, ['stateId','diagramSha256','feedbackSha256',...(numeric ? ['numeric'] : [])])
+      || actual.stateId !== state.id || !/^[a-f0-9]{64}$/.test(actual.diagramSha256)
+      || !/^[a-f0-9]{64}$/.test(actual.feedbackSha256)) fail();
+    if (numeric) {
+      const n = actual.numeric, ratio = state.numerator! / state.denominator!;
+      if (!exact(n, ['numerator','denominator','decimal','percent','diagramRatio'])
+        || Object.values(n).some(v => typeof v !== 'number' || !Number.isFinite(v))
+        || n.numerator !== state.numerator || n.denominator !== state.denominator
+        || Math.abs(n.decimal-ratio)>0.0001 || Math.abs(n.percent-ratio*100)>0.01
+        || Math.abs(n.diagramRatio-ratio)>0.015) fail();
+    }
+  }
+  if (new Set(raw.states.map((s: any) => s.diagramSha256)).size !== model.states.length
+    || new Set(raw.states.map((s: any) => s.feedbackSha256)).size !== model.states.length) fail();
+}
+
+/** A bounded browser verifier. Generated code supplies observations, never executable oracle code. */
+export async function inspectExploration(target: Page | Frame, model: Exploration, inputMode: 'pointer' | 'touch',
+  activate: (selector: string, inputMode: 'pointer' | 'touch') => Promise<void>): Promise<ExplorationObservation> {
+  validateExploration(model);
+  const sha = (v: string | Buffer) => createHash('sha256').update(v).digest('hex');
+  const observe = async (s: ExplorationState) => {
+    await target.waitForFunction(({model,s}) => {
+      const f = document.querySelector<HTMLElement>(model.feedbackSelector);
+      return !!f && f.checkVisibility({checkOpacity:true,checkVisibilityCSS:true})
+        && f.innerText.includes(s.resultText) && f.innerText.includes(s.explanationText);
+    }, {model,s}, {timeout:2500});
+    const actual = await target.evaluate(({model,s}) => {
+      const visible = (selector: string) => {
+        const e = document.querySelector(selector);
+        if (!e || !e.checkVisibility({checkOpacity:true,checkVisibilityCSS:true})) throw new Error('model element is not visible');
+        return e;
+      };
+      const diagram = visible(model.diagramSelector), feedback = visible(model.feedbackSelector) as HTMLElement;
+      if (diagram.contains(feedback) || feedback.contains(diagram)) throw new Error('diagram must be separate from explanation');
+      const r = diagram.getBoundingClientRect();
+      if (r.width < 120 || r.height < 80) throw new Error('teaching graphic too small');
+      let numeric;
+      if (model.mechanism.kind === 'fraction-ratio-percentage.v1') {
+        const m = model.mechanism;
+        const read = (selector: string, input=false) => {
+          const e = visible(selector) as HTMLInputElement;
+          const raw = (input ? e.value : e.innerText).trim().replace(/%$/, '');
+          if (!/^-?\d+(?:\.\d+)?$/.test(raw)) throw new Error('numeric output must be a visible number');
+          return Number(raw);
+        };
+        const numerator=read(m.numeratorSelector,true), denominator=read(m.denominatorSelector,true);
+        const decimal=read(m.decimalSelector), percent=read(m.percentSelector);
+        const whole=visible(m.wholeSelector), part=visible(m.partSelector);
+        if (whole.tagName.toLowerCase() !== 'rect' || part.tagName.toLowerCase() !== 'rect'
+          || !diagram.contains(whole) || !diagram.contains(part)) throw new Error('independent fraction verifier requires SVG rects');
+        const w=whole.getBoundingClientRect(), p=part.getBoundingClientRect(), ratio=numerator/denominator;
+        if (numerator !== s.numerator || denominator !== s.denominator || denominator <= 0
+          || Math.abs(decimal-ratio)>0.0001 || Math.abs(percent-100*ratio)>0.01 || w.width<100 || w.height<12
+          || Math.abs(p.x-w.x)>2 || Math.abs(p.y-w.y)>2 || Math.abs(p.height-w.height)>2
+          || Math.abs(p.width/w.width-ratio)>0.015) throw new Error('fraction mechanism output or SVG geometry is incorrect');
+        numeric={numerator,denominator,decimal,percent,diagramRatio:p.width/w.width};
+      }
+      return {feedback:feedback.innerText,numeric};
+    }, {model,s});
+    const png=await target.locator(model.diagramSelector).screenshot({animations:'disabled',timeout:2500});
+    return {stateId:s.id,diagramSha256:sha(png),feedbackSha256:sha(actual.feedback),...(actual.numeric?{numeric:actual.numeric}:{})};
+  };
+  const states: ExplorationObservation['states']=[];
+  for (const s of model.states) {
+    for (const op of s.operations) {
+      await activate(op.selector,inputMode);
+      const control=target.locator(op.selector);
+      if (op.action === 'fill') await control.fill(op.value!,{timeout:2000});
+      else if (op.action === 'select') await control.selectOption(op.value!,{timeout:2000});
+    }
+    states.push(await observe(s));
+  }
+  if (new Set(states.map(s=>s.diagramSha256)).size !== states.length
+    || new Set(states.map(s=>s.feedbackSha256)).size !== states.length) throw new Error('exploration states do not change model and explanation');
+  await activate(model.reset.selector,inputMode);
+  const reset=await observe(model.states.find(s=>s.id===model.reset.stateId)!);
+  const baseline=states.find(s=>s.stateId===model.reset.stateId)!;
+  if (reset.diagramSha256!==baseline.diagramSha256 || reset.feedbackSha256!==baseline.feedbackSha256)
+    throw new Error('reset does not restore the original model and feedback');
+  return {mechanism:model.mechanism.kind,verification:model.mechanism.kind==='fraction-ratio-percentage.v1'
+    ?'independent_numeric_svg':'structural_then_semantic_visual_review',inputMode,resetPassed:true,states};
+}
