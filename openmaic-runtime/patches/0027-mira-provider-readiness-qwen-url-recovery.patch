+function callIdentityMatches(call: MiraFormalProviderCallReceipt, spec: CallSpec): boolean {
+  return (
+    call.callOrdinal === spec.callOrdinal &&
+    call.kind === spec.kind &&
+    call.subject === ('subject' in spec ? spec.subject : undefined) &&
+    call.providerId === spec.providerId &&
+    call.modelId === spec.modelId &&
+    call.voiceId === ('voiceId' in spec ? spec.voiceId : undefined) &&
+    call.languageCode === ('languageCode' in spec ? spec.languageCode : undefined) &&
+    call.fallbackUsed === false &&
+    call.providerCall === true &&
+    SHA256.test(call.requestSha256) &&
+    SHA256.test(String(call.responseSha256 || ''))
+  );
+}
+
+function requestFromJob(record: MiraFormalProviderReadinessJob): MiraFormalProviderReadinessRequest {
+  return assertMiraFormalProviderReadinessRequest({
+    schemaVersion: MIRA_FORMAL_PROVIDER_READINESS_VERSION,
+    requestId: record.requestId,
+    buildItemId: record.buildItemId,
+    releaseId: record.releaseId,
+    gradeCode: record.gradeCode,
+    targetFingerprint: record.targetFingerprint,
+    runtimeClassroomId: record.runtimeClassroomId,
+    runtimeRequestId: record.runtimeRequestId,
+    upstreamClassroomId: record.upstreamClassroomId,
+    classroomContentSha256: record.classroomContentSha256,
+    audioJobTerminalReceiptSha256: record.audioJobTerminalReceiptSha256,
+    validation: { ...record.validation },
+    routeSession: { ...record.routeSessionProof },
+  });
+}
+
+export async function recoverMiraFormalProviderReadinessQwenUrl(
+  requestId: string,
+  sourceProviderReceiptSha256: string,
+  dependencies: RuntimeDependencies = {},
+): Promise<{ record: MiraFormalProviderReadinessJob; recovered: true }> {
+  if (!IDENTIFIER.test(requestId) || !SHA256.test(sourceProviderReceiptSha256)) {
+    throw new MiraFormalProviderReadinessError('invalid_request', 'Invalid recovery request');
+  }
+  assertMiraFormalProviderReadinessProviderReady();
+  const now = dependencies.now?.() || new Date();
+  const source = await readMiraFormalProviderReadinessJob(requestId, now);
+  if (!source) {
+    throw new MiraFormalProviderReadinessError('not_found', 'Readiness request not found');
+  }
+  const specs = callSpecs(source.validation.subject);
+  const sourceProof = source.providerProof;
+  if (
+    source.state !== 'failed' ||
+    source.safeErrorCode !== 'provider_response_invalid' ||
+    source.providerAttemptedCount !== 3 ||
+    source.providerPassedCount !== 2 ||
+    source.calls.length !== 3 ||
+    !sourceProof ||
+    sourceProof.receiptSha256 !== sourceProviderReceiptSha256 ||
+    proofFor(source).receiptSha256 !== sourceProviderReceiptSha256 ||
+    !callIdentityMatches(source.calls[0], specs[0]) ||
+    source.calls[0].state !== 'passed' ||
+    !callIdentityMatches(source.calls[1], specs[1]) ||
+    source.calls[1].state !== 'passed' ||
+    !callIdentityMatches(source.calls[2], specs[2]) ||
+    source.calls[2].state !== 'failed' ||
+    source.calls[2].safeErrorCode !== 'provider_response_invalid'
+  ) {
+    throw new MiraFormalProviderReadinessError(
+      'request_conflict',
+      'Readiness recovery source is not exact',
+    );
+  }
+
+  const input = requestFromJob(source);
+  if (digest(input) !== source.requestSha256) {
+    throw new MiraFormalProviderReadinessError(
+      'request_conflict',
+      'Readiness recovery identity drifted',
+    );
+  }
+  const asset = await readMiraFormalTtsAsset(input.validation.ttsRequestId);
+  if (
+    asset.record.state !== 'succeeded' ||
+    asset.record.classroomId !== input.upstreamClassroomId ||
+    asset.record.classroomContentSha256 !== input.classroomContentSha256 ||
+    asset.record.subject !== input.validation.subject ||
+    asset.record.sceneOrder !== input.validation.sceneOrder ||
+    asset.record.audioSha256 !== input.validation.audioSha256 ||
+    sha256(asset.bytes) !== input.validation.audioSha256
+  ) {
+    throw new MiraFormalProviderReadinessError(
+      'asset_unavailable',
+      'Formal validation WAV binding is invalid',
+    );
+  }
+
+  const timestamp = now.toISOString();
+  const recoveryAudit = {
+    schemaVersion: MIRA_FORMAL_PROVIDER_QWEN_URL_RECOVERY_VERSION,
+    requestId,
+    state: 'claimed',
+    sourceProviderReceiptSha256,
+    resumedFromCallOrdinal: 3,
+    sourceRecord: source,
+    createdAt: timestamp,
+    updatedAt: timestamp,
+  };
+  if (!(await writeExclusiveAtomic(recoveryAuditPath(requestId), recoveryAudit))) {
+    throw new MiraFormalProviderReadinessError(
+      'request_conflict',
+      'Readiness recovery was already claimed',
+    );
+  }
+
+  let record: MiraFormalProviderReadinessJob = {
+    ...source,
+    state: 'running',
+    providerAttemptedCount: 2,
+    providerPassedCount: 2,
+    calls: source.calls.slice(0, 2),
+    providerProof: undefined,
+    safeErrorCode: undefined,
+    completedAt: undefined,
+    updatedAt: timestamp,
+  };
+  await writeAtomic(jobPath(requestId), record);
+  const fetchImpl = dependencies.fetchImpl || fetch;
+  for (const spec of specs.slice(2)) {
+    const providerRequest = requestForCall(spec, input, asset.bytes);
+    record = await recordAttempt(
+      record,
+      spec,
+      digest(providerRequest.body),
+      dependencies.now?.() || new Date(),
+    );
+    let responseSha256: string;
+    try {
+      const response = await fetchJson(
+        fetchImpl,
+        providerRequest.endpoint,
+        providerRequest.apiKey,
+        providerRequest.body,
+      );
+      responseSha256 = providerResultSha256(spec, response);
+    } catch (error) {
+      const failure =
+        error instanceof OperationalFailure
+          ? error
+          : new OperationalFailure('failed', 'provider_readiness_internal_failure');
+      const terminal = await terminalizeFailure(
+        record,
+        failure,
+        dependencies.now?.() || new Date(),
+      );
+      await writeAtomic(recoveryAuditPath(requestId), {
+        ...recoveryAudit,
+        state: terminal.state,
+        resultProviderReceiptSha256: terminal.providerProof?.receiptSha256,
+        updatedAt: terminal.updatedAt,
+        completedAt: terminal.completedAt,
+      });
+      return { record: terminal, recovered: true };
+    }
+    record = await completeCall(
+      record,
+      'passed',
+      responseSha256,
+      dependencies.now?.() || new Date(),
+    );
+  }
+  const completedAt = (dependencies.now?.() || new Date()).toISOString();
+  const completed: MiraFormalProviderReadinessJob = {
+    ...record,
+    state: 'auto_validated',
+    providerProof: proofFor(record),
+    updatedAt: completedAt,
+    completedAt,
+  };
+  await writeAtomic(jobPath(requestId), completed);
+  await writeAtomic(recoveryAuditPath(requestId), {
+    ...recoveryAudit,
+    state: 'auto_validated',
+    resultProviderReceiptSha256: completed.providerProof.receiptSha256,
+    updatedAt: completedAt,
+    completedAt,
+  });
+  return { record: completed, recovered: true };
+}
+
 export function getMiraFormalProviderReadinessPolicy() {
   return MIRA_FORMAL_PROVIDER_READINESS_POLICY;
