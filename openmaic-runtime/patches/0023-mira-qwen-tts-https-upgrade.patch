diff --git a/lib/server/mira-formal-audio.ts b/lib/server/mira-formal-audio.ts
index 35c11b1..64db840 100644
--- a/lib/server/mira-formal-audio.ts
+++ b/lib/server/mira-formal-audio.ts
@@ -691,13 +691,27 @@ async function validateMediaUrl(
   } catch {
     throw new OperationalFailure('failed', 'media_url_invalid');
   }
+  const allowedHostname = isAllowedMediaHostname(url.hostname);
+  // DashScope currently returns a time-limited OSS URL with an http scheme.
+  // Never follow it in plaintext: upgrade only the already allowlisted OSS
+  // host to https before DNS validation and the actual download request.
+  if (
+    url.protocol === 'http:' &&
+    allowedHostname &&
+    !url.username &&
+    !url.password &&
+    !url.hash &&
+    !url.port
+  ) {
+    url.protocol = 'https:';
+  }
   if (
     url.protocol !== 'https:' ||
     url.username ||
     url.password ||
     url.hash ||
     (url.port && url.port !== '443') ||
-    !isAllowedMediaHostname(url.hostname)
+    !allowedHostname
   ) {
     throw new OperationalFailure('failed', 'media_url_rejected');
   }
@@ -736,10 +750,11 @@ async function downloadWav(
       continue;
     }
     if (!response.ok) throw new OperationalFailure('failed', 'media_download_failed');
-    if (response.headers.get('content-type')?.trim().toLowerCase() !== 'audio/wav') {
+    const mimeType = response.headers.get('content-type')?.trim().toLowerCase();
+    if (mimeType !== 'audio/wav' && mimeType !== 'audio/x-wav') {
       throw new OperationalFailure('failed', 'media_mime_invalid');
     }
-    const bytes = await readBoundedBytes(response, MIRA_FORMAL_AUDIO_MAX_BYTES);
+    let bytes = await readBoundedBytes(response, MIRA_FORMAL_AUDIO_MAX_BYTES);
     if (
       bytes.byteLength < 44 ||
       Buffer.from(bytes.subarray(0, 4)).toString('ascii') !== 'RIFF' ||
@@ -747,6 +762,31 @@ async function downloadWav(
     ) {
       throw new OperationalFailure('failed', 'media_wav_invalid');
     }
+    const header = Buffer.from(bytes);
+    const actualRiffSize = bytes.byteLength - 8;
+    const fixedPcmHeader =
+      header.subarray(12, 16).toString('ascii') === 'fmt ' &&
+      header.readUInt32LE(16) === 16 &&
+      header.subarray(36, 40).toString('ascii') === 'data';
+    const actualDataSize = fixedPcmHeader ? bytes.byteLength - 44 : -1;
+    const declaredRiffSize = header.readUInt32LE(4);
+    const declaredDataSize = fixedPcmHeader ? header.readUInt32LE(40) : -1;
+    if (
+      fixedPcmHeader &&
+      declaredRiffSize >= 0x7fff0000 &&
+      declaredDataSize >= 0x7fff0000 &&
+      declaredRiffSize - declaredDataSize === 36
+    ) {
+      const normalized = Buffer.from(bytes);
+      normalized.writeUInt32LE(actualRiffSize, 4);
+      normalized.writeUInt32LE(actualDataSize, 40);
+      bytes = new Uint8Array(normalized);
+    } else if (
+      declaredRiffSize !== actualRiffSize ||
+      (fixedPcmHeader && declaredDataSize !== actualDataSize)
+    ) {
+      throw new OperationalFailure('failed', 'media_wav_size_invalid');
+    }
     return bytes;
   }
   throw new OperationalFailure('failed', 'media_redirect_rejected');
