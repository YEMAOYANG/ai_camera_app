+
+    expect(result.record.state).toBe('succeeded');
+    expect(result.record.audioSha256).toBe(
+      require('crypto').createHash('sha256').update(wavBytes()).digest('hex'),
+    );
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+  });
+
