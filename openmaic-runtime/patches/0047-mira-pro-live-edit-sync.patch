+import { isEqual } from 'lodash';
+import type { EditorHistory } from '@openmaic/editor/core';
+import type { SlideContent } from '@/lib/types/stage';
+
+/** Apply only changed properties. Element identity is handled separately below. */
+function changedFields(before: unknown, after: unknown, onto: unknown): unknown {
+  if (isEqual(before, after)) return onto;
+  if (
+    !before ||
+    !after ||
+    !onto ||
+    typeof before !== 'object' ||
+    typeof after !== 'object' ||
+    typeof onto !== 'object' ||
+    Array.isArray(before) ||
+    Array.isArray(after) ||
+    Array.isArray(onto)
+  )
+    return after;
+  const previous = before as Record<string, unknown>;
+  const next = after as Record<string, unknown>;
+  const result = { ...(onto as Record<string, unknown>) };
+  for (const key of new Set([...Object.keys(previous), ...Object.keys(next)])) {
+    if (isEqual(previous[key], next[key]) && key in previous === key in next) continue;
+    if (!(key in next)) delete result[key];
+    else result[key] = changedFields(previous[key], next[key], result[key]);
+  }
+  return result;
+}
+
+/**
+ * Three-way snapshot update, keyed by element id. Only the incoming side's
+ * changed fields win; unrelated text, geometry, media and animations survive.
+ * A local draft may restore an element deleted remotely. An external update
+ * must not resurrect an element absent from a user's earlier undo snapshot.
+ */
+export function applySlideSnapshotDelta(
+  before: SlideContent,
+  after: SlideContent,
+  onto: SlideContent,
+  restoreMissing = false,
+): SlideContent {
+  if (isEqual(before, after)) return onto;
+  const previous = new Map(before.canvas.elements.map((element) => [element.id, element]));
+  const next = new Map(after.canvas.elements.map((element) => [element.id, element]));
+  const elements = new Map(onto.canvas.elements.map((element) => [element.id, element]));
+  for (const id of previous.keys()) if (!next.has(id)) elements.delete(id);
+  for (const [id, element] of next) {
+    const baseline = previous.get(id);
+    if (!baseline || baseline.type !== element.type) elements.set(id, element);
+    else if (!isEqual(baseline, element) && (elements.has(id) || restoreMissing)) {
+      const target = elements.get(id);
+      elements.set(
+        id,
+        target && target.type !== element.type && restoreMissing
+          ? element
+          : (changedFields(baseline, element, target) as typeof element),
+      );
+    }
+  }
+  const ids = (content: SlideContent) => content.canvas.elements.map((element) => element.id);
+  const order = isEqual(ids(before), ids(after)) ? ids(onto) : ids(after);
+  const orderedIds = [...new Set([...order, ...elements.keys()])];
+  const withoutElements = (content: SlideContent) => ({
+    ...content,
+    canvas: { ...content.canvas, elements: [] },
+  });
+  const result = changedFields(
+    withoutElements(before),
+    withoutElements(after),
+    withoutElements(onto),
+  ) as SlideContent;
+  return {
+    ...result,
+    canvas: {
+      ...result.canvas,
+      elements: orderedIds.flatMap((id) => (elements.has(id) ? [elements.get(id)!] : [])),
+    },
+  };
+}
+
+/**
+ * Preserve the local undo steps created while an external update was deferred.
+ * Snapshots already present when it arrived receive the remote delta. New local
+ * snapshots receive only their own delta on top of the remote baseline, so
+ * two drafts H1/H2 still undo H2 -> H1 -> remote rather than H2 -> remote.
+ */
+export function adoptExternalSlideHistory(
+  history: EditorHistory,
+  baseline: EditorHistory,
+  remote: SlideContent,
+): EditorHistory {
+  const existing = new Set([...baseline.past, baseline.present, ...baseline.future]);
+  const rebase = (snapshot: SlideContent) =>
+    existing.has(snapshot)
+      ? applySlideSnapshotDelta(baseline.present, remote, snapshot)
+      : applySlideSnapshotDelta(baseline.present, snapshot, remote, true);
+  return {
+    past: history.past.map(rebase),
+    present: rebase(history.present),
+    future: history.future.map(rebase),
+  };
+}
