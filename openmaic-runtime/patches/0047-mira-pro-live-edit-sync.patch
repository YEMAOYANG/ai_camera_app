+// @vitest-environment jsdom
+import { act, createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { createDefaultSlide, createDefaultTextElement } from '@/lib/edit/slide-edit-elements';
+import type { PPTTextElement } from '@openmaic/dsl';
+import type { Scene, SlideContent } from '@/lib/types/stage';
+
+const writes = vi.hoisted(() => vi.fn());
+vi.mock('@/lib/store/stage', async () => {
+  const { create } = await import('zustand');
+  const useStageStore = create<{
+    scenes: Scene[];
+    currentSceneId: string | null;
+    updateScene: (id: string, patch: Partial<Scene>) => void;
+  }>((set) => ({
+    scenes: [],
+    currentSceneId: null,
+    updateScene: (id, patch) => {
+      writes(id, patch);
+      set((state) => ({
+        scenes: state.scenes.map((scene) =>
+          scene.id === id ? ({ ...scene, ...patch } as Scene) : scene,
+        ),
+      }));
+    },
+  }));
+  return { useStageStore };
+});
+
+import { useStageStore } from '@/lib/store/stage';
+import { useCanvasStore } from '@/lib/store/canvas';
+import { useSlideEditSession } from '@/components/edit/surfaces/slide/slide-edit-session';
+import {
+  useResolvedSlideContent,
+  useSlideCanvasController,
+} from '@/components/edit/surfaces/slide/use-slide-surface';
+
+let root: ReturnType<typeof createRoot> | undefined;
+afterEach(async () => {
+  await act(async () => root?.unmount());
+  root = undefined;
+  document.body.replaceChildren();
+  useCanvasStore.setState({ editingElementId: '' });
+  vi.unstubAllGlobals();
+});
+
+function CanvasProbe() {
+  const { gestureProps } = useSlideCanvasController();
+  const content = useResolvedSlideContent();
+  return createElement(
+    'div',
+    gestureProps,
+    createElement(
+      'div',
+      { 'data-main-canvas': true },
+      (content.canvas.elements[0] as PPTTextElement | undefined)?.content,
+    ),
+    createElement('input', { 'data-draft-editor': true }),
+  );
+}
+
+describe('mounted slide canvas external subscription', () => {
+  it('updates the same page, protects a focused draft, and does not create a save echo', async () => {
+    vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true);
+    useSlideEditSession.getState().end();
+    writes.mockClear();
+    const slide = createDefaultSlide('slide-1');
+    slide.elements = [{ ...createDefaultTextElement('text-1'), content: 'Original title' }];
+    const scene = {
+      id: 'scene-1',
+      stageId: 'stage-1',
+      title: 'Lesson',
+      order: 0,
+      type: 'slide',
+      content: { type: 'slide', canvas: slide },
+      actions: [],
+    } as Scene;
+    useStageStore.setState({ scenes: [scene], currentSceneId: scene.id });
+    const container = document.createElement('div');
+    document.body.append(container);
+    root = createRoot(container);
+    await act(async () => root!.render(createElement(CanvasProbe)));
+    expect(container.textContent).toBe('Original title');
+    const replaceRemote = async (title: string) => {
+      const content = structuredClone(useStageStore.getState().scenes[0].content) as SlideContent;
+      (content.canvas.elements[0] as PPTTextElement).content = title;
+      await act(async () => useStageStore.setState({ scenes: [{ ...scene, content }] }));
+    };
+    await replaceRemote('AI title');
+    expect(container.textContent).toBe('AI title');
+    expect(writes).not.toHaveBeenCalled();
+    await act(async () => {
+      useCanvasStore.getState().setEditingElementId('text-1');
+      container.querySelector('input')!.focus();
+    });
+    await replaceRemote('Later AI title');
+    expect(container.textContent).toBe('AI title');
+    await act(async () =>
+      useSlideEditSession.getState().applyTransaction({
+        origin: 'canvas',
+        history: 'record',
+        operations: [{ type: 'text.updateContent', elementId: 'text-1', content: 'Human draft' }],
+      }),
+    );
+    await act(async () => container.querySelector('input')!.blur());
+    expect(useCanvasStore.getState().editingElementId).toBe('text-1');
+    expect(container.textContent).toBe('Human draft');
+    expect(writes).toHaveBeenCalledTimes(1);
+    await act(async () => useSlideEditSession.getState().undo());
+    expect(container.textContent).toBe('Later AI title');
+    expect(writes).toHaveBeenCalledTimes(2);
+    await replaceRemote('AI after blur, selection retained');
+    expect(container.textContent).toBe('AI after blur, selection retained');
+    expect(writes).toHaveBeenCalledTimes(2);
+  });
+
+  it('saves a deferred conflict once when AI responds again after a manual auto-save', async () => {
+    vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true);
+    useSlideEditSession.getState().end();
+    writes.mockClear();
+    const slide = createDefaultSlide('slide-1');
+    slide.elements = [{ ...createDefaultTextElement('text-1'), content: 'Original title' }];
+    const scene = {
+      id: 'scene-1',
+      stageId: 'stage-1',
+      title: 'Lesson',
+      order: 0,
+      type: 'slide',
+      content: { type: 'slide', canvas: slide },
+      actions: [],
+    } as Scene;
+    useStageStore.setState({ scenes: [scene], currentSceneId: scene.id });
+    const container = document.createElement('div');
+    document.body.append(container);
+    root = createRoot(container);
+    await act(async () => root!.render(createElement(CanvasProbe)));
+    const replaceRemote = async (title: string) => {
+      const content = structuredClone(useStageStore.getState().scenes[0].content) as SlideContent;
+      (content.canvas.elements[0] as PPTTextElement).content = title;
+      await act(async () => useStageStore.setState({ scenes: [{ ...scene, content }] }));
+    };
+    await act(async () => container.querySelector('input')!.focus());
+    await replaceRemote('First AI title');
+    await act(async () =>
+      useSlideEditSession.getState().applyTransaction({
+        origin: 'canvas',
+        history: 'record',
+        operations: [{ type: 'text.updateContent', elementId: 'text-1', content: 'Human draft' }],
+      }),
+    );
+    expect(writes).toHaveBeenCalledTimes(1);
+    await replaceRemote('Second AI title');
+    expect(container.textContent).toBe('Human draft');
+    await act(async () => container.querySelector('input')!.blur());
+    expect(container.textContent).toBe('Human draft');
+    expect(useStageStore.getState().scenes[0].content).toEqual(
+      useSlideEditSession.getState().history!.present,
+    );
+    expect(writes).toHaveBeenCalledTimes(2);
+    const history = useSlideEditSession.getState().history;
+    await replaceRemote('Human draft');
+    expect(useSlideEditSession.getState().history).toBe(history);
+    expect(writes).toHaveBeenCalledTimes(2);
+    await act(async () => useSlideEditSession.getState().undo());
+    expect(container.textContent).toBe('Second AI title');
+    expect(useStageStore.getState().scenes[0].content).toEqual(
+      useSlideEditSession.getState().history!.present,
+    );
+    expect(writes).toHaveBeenCalledTimes(3);
+  });
+});
