+}
+
+html[data-mira-student-theme='orbit']
+  :is([data-mira-chrome='discussion'], [data-mira-chrome='playback-controls'])
+  [data-mira-indicator='toolbar-divider'] {
+  background: var(--mira-orbit-line);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='playback-controls']
