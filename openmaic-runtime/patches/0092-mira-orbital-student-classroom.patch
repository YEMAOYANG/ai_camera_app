+  background: var(--mira-orbit-cyan);
+}
+
+html[data-mira-student-theme='orbit']
+  :is([data-mira-chrome='discussion'], [data-mira-chrome='chat'])
+  :is([data-mira-indicator='activity-dot'], [data-mira-indicator='voice-wave']),
+html[data-mira-student-theme='orbit']
