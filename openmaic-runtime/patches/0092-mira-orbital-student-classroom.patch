+/*
+ * Orbit is a presentation skin for the authenticated Mira student document.
+ * The runtime intentionally retains its light rendering preference: slide
+ * colors, authored interactive iframes and whiteboard ink are content, not
+ * chrome. Only the player's marked overlay is styled within the viewport;
+ * authored content and thumbnails retain their colors. Operator routes never
+ * receive the document marker.
+ */
+html[data-mira-student-theme='orbit'] {
+  --mira-orbit-space: #050a13;
+  --mira-orbit-panel: #0c1727;
+  --mira-orbit-raised: #142337;
+  --mira-orbit-line: #273c51;
+  --mira-orbit-text: #eef6ff;
+  --mira-orbit-muted: #a0b5ca;
+  --mira-orbit-cyan: #63dcff;
+  --mira-orbit-lime: #d3ff48;
+  background: var(--mira-orbit-space);
+  scrollbar-gutter: auto;
+  overflow: hidden;
+}
+
+html[data-mira-student-theme='orbit'] body,
+html[data-mira-student-theme='orbit'] [data-mira-classroom-surface='orbit'],
+html[data-mira-student-theme='orbit'] [data-mira-playback-shell='orbit'],
+html[data-mira-student-theme='orbit'] [data-mira-canvas-area],
+html[data-mira-student-theme='orbit'] [data-mira-canvas-surround] {
+  background: var(--mira-orbit-space);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-classroom-surface='orbit']
+  > :not([data-mira-playback-shell]):has(> .text-center),
+html[data-mira-student-theme='orbit']
+  [data-mira-classroom-surface='orbit']
+  > :has(> .text-muted-foreground) {
+  background: var(--mira-orbit-space);
+  color: var(--mira-orbit-text);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome] {
+  --background: var(--mira-orbit-panel);
+  --foreground: var(--mira-orbit-text);
+  --card: var(--mira-orbit-panel);
+  --card-foreground: var(--mira-orbit-text);
+  --popover: var(--mira-orbit-raised);
+  --popover-foreground: var(--mira-orbit-text);
+  --primary: var(--mira-orbit-lime);
+  --primary-foreground: var(--mira-orbit-space);
+  --secondary: var(--mira-orbit-raised);
+  --secondary-foreground: var(--mira-orbit-text);
+  --muted: var(--mira-orbit-raised);
+  --muted-foreground: var(--mira-orbit-muted);
+  --accent: var(--mira-orbit-raised);
+  --accent-foreground: var(--mira-orbit-cyan);
+  --border: var(--mira-orbit-line);
+  --input: var(--mira-orbit-line);
+  --ring: var(--mira-orbit-cyan);
+  color: var(--mira-orbit-text);
+  font-family: 'Inter Variable', 'PingFang SC', 'Microsoft YaHei', sans-serif;
+  color-scheme: dark;
+}
+
+/* Navigation stays distinct from the white teaching canvas. */
+html[data-mira-student-theme='orbit'] [data-mira-chrome='scene-sidebar'],
+html[data-mira-student-theme='orbit'] [data-mira-chrome='chat'] {
+  background: var(--mira-orbit-panel);
+  border-color: var(--mira-orbit-line);
+  box-shadow: none;
+  backdrop-filter: none;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  > div
+  > div:first-child
+  > span {
+  color: var(--mira-orbit-cyan);
+  font-size: 15px;
+  letter-spacing: 0.08em;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  [data-testid='scene-item'] {
+  padding: 10px;
+  border: 1px solid transparent;
+  border-radius: 14px;
+  background: transparent;
+  box-shadow: none;
+  transition:
+    border-color 160ms ease,
+    background-color 160ms ease;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  [data-testid='scene-item']:hover {
+  background: var(--mira-orbit-raised);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  [data-mira-scene-active='true'] {
+  border-color: var(--mira-orbit-lime);
+  background: #18242a;
+  box-shadow: 0 0 14px #d3ff4814;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  [data-testid='scene-title'] {
+  color: var(--mira-orbit-muted);
+  font-size: 13px;
+  line-height: 1.6;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  [data-mira-scene-active='true']
+  [data-testid='scene-title'] {
+  color: var(--mira-orbit-lime);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  [data-testid='scene-item']
+  > div:first-child
+  > div
+  > span:first-child {
+  width: 22px;
+  height: 22px;
+  color: var(--mira-orbit-cyan);
+  background: var(--mira-orbit-raised);
+  box-shadow: none;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  [data-mira-scene-active='true']
+  > div:first-child
+  > div
+  > span:first-child {
+  color: var(--mira-orbit-space);
+  background: var(--mira-orbit-lime);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-course-thumbnail] {
+  color: #142033;
+  color-scheme: light;
+  background: white;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='header'] {
+  border-bottom: 1px solid var(--mira-orbit-line);
+  background: var(--mira-orbit-space);
+  padding-inline: 24px;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='header'] h1 {
+  color: var(--mira-orbit-text);
+  font-size: clamp(17px, 1.7vw, 23px);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='header'] span {
+  color: var(--mira-orbit-cyan);
+  font-size: 11px;
+}
+
+/* Only chrome containers are remapped. The lesson/whiteboard viewport is not
+ * inside any of these selectors, including when the lesson opens an iframe. */
+html[data-mira-student-theme='orbit']
+  :is(
+    [data-mira-chrome='discussion'],
+    [data-mira-chrome='discussion-prompt'],
+    [data-mira-chrome='chat'],
+    [data-mira-chrome='playback-controls'],
+    [data-mira-chrome='complete']
+  )
+  :is(
+    [class*='bg-white'],
+    [class*='bg-gray-'],
+    [class*='bg-slate-'],
+    [class*='from-white'],
+    [class*='from-gray-']
+  ) {
+  background-color: var(--mira-orbit-panel);
+  background-image: none;
+  border-color: var(--mira-orbit-line);
+  box-shadow: none;
+}
+
+html[data-mira-student-theme='orbit']
+  :is(
+    [data-mira-chrome='discussion'],
+    [data-mira-chrome='discussion-prompt'],
+    [data-mira-chrome='chat'],
+    [data-mira-chrome='playback-controls'],
+    [data-mira-chrome='complete']
+  )
+  :is([class*='text-gray-'], [class*='text-slate-']) {
+  color: var(--mira-orbit-text);
+}
+
+html[data-mira-student-theme='orbit']
+  :is(
+    [data-mira-chrome='discussion'],
+    [data-mira-chrome='discussion-prompt'],
+    [data-mira-chrome='chat'],
+    [data-mira-chrome='playback-controls']
+  )
+  :is([class*='text-purple-'], [class*='text-violet-'], [class*='text-blue-']) {
+  color: var(--mira-orbit-cyan);
+}
+
+html[data-mira-student-theme='orbit']
+  :is(
+    [data-mira-chrome='discussion'],
+    [data-mira-chrome='discussion-prompt'],
+    [data-mira-chrome='chat'],
+    [data-mira-chrome='playback-controls']
+  )
+  :is([class*='bg-purple-'], [class*='bg-violet-'], [class*='from-purple-']) {
+  background: #194358;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] > div,
+html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] {
+  background: var(--mira-orbit-panel);
+  border-color: var(--mira-orbit-line);
+  backdrop-filter: none;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [role='alert'] {
+  color: #ffe3a3;
+  background: #30251a;
+  border-color: #785a2d;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [role='alert'] button {
+  min-height: 44px;
+  color: var(--mira-orbit-space);
+  background: var(--mira-orbit-lime);
+}
+
+html[data-mira-student-theme='orbit'] [data-testid='roundtable-non-presentation-card'] {
+  border: 1px solid var(--mira-orbit-line);
+  border-radius: 18px;
+  background: var(--mira-orbit-raised);
+  box-shadow: none;
+  backdrop-filter: none;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] textarea,
+html[data-mira-student-theme='orbit'] [data-mira-chrome='chat'] textarea {
+  color: var(--mira-orbit-text);
+  caret-color: var(--mira-orbit-lime);
+  font-size: 17px;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome] textarea::placeholder {
+  color: var(--mira-orbit-muted);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] {
+  min-height: 48px;
+  gap: 8px;
+  flex-wrap: wrap;
+  overflow: visible;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] button,
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='scene-sidebar']
+  > div
+  > div:first-child
+  > button,
+html[data-mira-student-theme='orbit'] [data-mira-chrome='chat'] [role='tab'] {
+  min-width: 44px;
+  min-height: 44px;
+  border-radius: 10px;
+  color: var(--mira-orbit-muted);
+  background: transparent;
+  box-shadow: none;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='playback-controls']
+  button:not(:disabled):hover,
+html[data-mira-student-theme='orbit'] [data-mira-chrome='chat'] [role='tab'][data-state='active'] {
+  color: var(--mira-orbit-lime);
+  background: var(--mira-orbit-raised);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] button:disabled {
+  opacity: 0.4;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='playback-controls']
+  button[aria-label='Play'],
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='playback-controls']
+  button[aria-label='Pause'] {
+  color: var(--mira-orbit-space);
+  background: var(--mira-orbit-lime);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='playback-controls']
+  button[aria-pressed='true'] {
+  color: var(--mira-orbit-lime);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] > div > div {
+  height: auto;
+  min-height: 44px;
+}
+
+/* Tiny state marks must remain distinct from the surrounding chrome surface. */
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='chat']
+  [data-mira-indicator='note-position'],
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-indicator='student-status'] {
+  background: var(--mira-orbit-muted);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='chat']
+  [data-mira-indicator='note-position'][data-active='true'],
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-indicator='student-status'][data-active='true'] {
+  background: var(--mira-orbit-lime);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion-prompt']
+  [data-mira-indicator='discussion-progress-track'] {
+  background: var(--mira-orbit-line);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion-prompt']
+  [data-mira-indicator='discussion-progress'][data-paused='true'] {
+  background: var(--mira-orbit-muted);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='chat'] [data-mira-resize-handle] {
+  background: transparent;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='chat'] [data-mira-resize-handle]:hover,
+html[data-mira-student-theme='orbit'] [data-mira-chrome='chat'] [data-mira-resize-handle]:active {
+  background: var(--mira-orbit-raised);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='chat']
+  [data-mira-indicator='resize-grip'] {
+  background: var(--mira-orbit-muted);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='chat']
+  [data-mira-resize-handle]:hover
