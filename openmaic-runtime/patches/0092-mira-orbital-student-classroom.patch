+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [data-mira-recording-glow] {
+  background: var(--mira-orbit-lime);
+}
+
+/* Every speaker uses a dark, readable bubble, independent of upstream role colors. */
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [data-mira-speech-card] {
+  color: var(--mira-orbit-text);
+  background: var(--mira-orbit-panel);
+  border-color: var(--mira-orbit-line);
+  box-shadow: none;
+  backdrop-filter: none;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-speech-card='agent'] {
+  background: var(--mira-orbit-raised);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-speech-card='user'] {
+  background: #194358;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [data-mira-bubble-avatar] {
+  border-color: var(--mira-orbit-cyan);
+  box-shadow: none;
+}
+
+/* One calm focus boundary around the composer; keep the lesson readable while typing. */
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [data-mira-composer] {
+  min-width: 0;
+  width: min(440px, 100%);
+  max-width: 100%;
+  padding: 10px 12px;
+  gap: 12px;
+  align-items: center;
+  border: 1px solid var(--mira-orbit-line);
+  border-radius: 16px;
+  background: var(--mira-orbit-raised);
+  box-shadow: none;
+  backdrop-filter: none;
+  transition: border-color 160ms ease;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-composer]:focus-within {
+  border-color: var(--mira-orbit-cyan);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [data-mira-composer] > div {
+  padding: 0;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-composer]
+  textarea {
+  display: block;
+  min-height: 24px;
+  max-height: 64px;
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  font-size: 15px;
+  line-height: 24px;
+  background: transparent;
+  box-shadow: none;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-composer]
+  textarea:focus-visible {
+  outline: none;
+  box-shadow: none;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [data-mira-send] {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 40px;
+  height: 40px;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  border-radius: 12px;
+  color: var(--mira-orbit-space);
+  background: var(--mira-orbit-lime);
+  box-shadow: none;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [data-mira-send] svg {
+  color: inherit;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-send]:not(:disabled):hover {
+  background: #e2ff86;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='discussion'] [data-mira-send]:disabled {
+  color: var(--mira-orbit-muted);
+  background: var(--mira-orbit-line);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='discussion']
+  [data-mira-input-obscured='true'] {
+  opacity: 1 !important;
+  filter: none !important;
+}
+
+/* The central play hint is player chrome, separate from authored slide colors. */
+html[data-mira-student-theme='orbit'] [data-mira-chrome='play-hint'] > div {
+  color: var(--mira-orbit-space);
+  background: var(--mira-orbit-lime);
+  box-shadow:
+    0 4px 30px #d3ff4833,
+    inset 0 0 0 1px #e2ff86;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='play-hint'] svg {
+  color: var(--mira-orbit-space);
+  fill: currentColor;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='play-hint']:hover > div {
+  background: #e2ff86;
+  box-shadow:
+    0 4px 32px #d3ff484d,
+    inset 0 0 0 1px #efffc2;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] {
+  background: #050a13d9;
+  backdrop-filter: blur(8px);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] [role='dialog'] {
+  max-width: 380px;
+  padding: 28px;
+  border: 1px solid var(--mira-orbit-line);
+  border-radius: 16px;
+  background: var(--mira-orbit-panel);
+  box-shadow: none;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] h2 {
+  color: var(--mira-orbit-text);
+  font-size: 22px;
+  font-weight: 600;
+  line-height: 30px;
+  letter-spacing: 0;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] p {
+  margin-top: 10px;
+  color: var(--mira-orbit-muted);
+  font-size: 13px;
+  line-height: 22px;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] p:first-child {
+  margin-top: 0;
+  margin-bottom: 6px;
+  color: var(--mira-orbit-cyan);
+  font-size: 12px;
+  font-weight: 500;
+  line-height: 18px;
+  letter-spacing: 0.02em;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] button {
+  min-height: 44px;
+  height: 44px;
+  margin-top: 20px;
+  padding: 0 20px;
+  border-radius: 12px;
+  color: var(--mira-orbit-space);
+  background: var(--mira-orbit-lime);
+  box-shadow: 0 2px 8px #d3ff4814;
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 20px;
+  letter-spacing: 0.02em;
+  transition:
+    box-shadow 180ms ease,
+    background-color 180ms ease;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] button:hover {
+  background: #e2ff86;
+  box-shadow: 0 2px 8px #d3ff4826;
+}
+
+@media (pointer: coarse) {
+  html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] button {
+    min-height: 48px;
+    height: 48px;
+  }
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='loading'],
+html[data-mira-student-theme='orbit'] [data-mira-chrome='complete'] {
+  color: var(--mira-orbit-text);
+  background: var(--mira-orbit-space);
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome='complete'] > div.absolute {
+  background: var(--mira-orbit-space) !important;
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome='complete']
+  :is(h1, h2, [class*='text-amber-'], [class*='text-orange-']) {
+  color: var(--mira-orbit-lime);
+}
+
+html[data-mira-student-theme='orbit']
+  [data-mira-chrome]
+  :is(button, a, textarea, input, [role='tab']):focus-visible {
+  outline: 2px solid var(--mira-orbit-cyan);
+  outline-offset: 3px;
+}
+
+html[data-mira-student-theme='orbit'] [data-mira-chrome] {
+  scrollbar-color: var(--mira-orbit-line) transparent;
+}
+
+@media (max-width: 760px) {
+  html[data-mira-student-theme='orbit'] [data-mira-chrome='header'] {
+    padding-inline: 16px;
+  }
+  html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] [role='dialog'] {
+    padding: 24px;
+  }
+  html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] {
+    gap: 2px;
+    padding-inline: 4px;
+  }
+  html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] > .flex-1 {
+    order: 1;
+    flex-basis: 100%;
+  }
+  html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] > .flex-1 > div {
+    flex-wrap: wrap;
+    justify-content: center;
+  }
+  html[data-mira-student-theme='orbit'] [data-mira-chrome='playback-controls'] > div:last-child {
+    margin-left: auto;
+  }
+}
+
+/* Low-cost classroom motion: no continuous environmental effects behind the
+ * lesson. Existing semantic feedback remains, with reduced-motion respected. */
+@media (prefers-reduced-motion: reduce) {
+  html[data-mira-student-theme='orbit'] [data-mira-chrome],
+  html[data-mira-student-theme='orbit'] [data-mira-chrome] *,
+  html[data-mira-student-theme='orbit'] [data-mira-chrome] *::before,
+  html[data-mira-student-theme='orbit'] [data-mira-chrome] *::after {
+    animation-duration: 0.001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.001ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+@media (prefers-reduced-transparency: reduce) {
+  html[data-mira-student-theme='orbit'] [data-mira-chrome] *,
+  html[data-mira-student-theme='orbit'] [data-mira-chrome='start-gate'] {
+    backdrop-filter: none !important;
+  }
+}
