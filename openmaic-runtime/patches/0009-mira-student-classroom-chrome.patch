+import { describe, expect, it } from 'vitest';
+import {
+  getMiraStudentChromeRuntimePolicy,
+  isMiraStudentRuntimeParam,
+  isMiraStudentRuntimeSearch,
+  MIRA_STUDENT_CLASSROOM_METADATA,
+} from '@/lib/mira/student-runtime';
+
+describe('Mira student runtime marker', () => {
+  it('enables student chrome only for the exact mira=1 value', () => {
+    expect(isMiraStudentRuntimeSearch('?mira=1')).toBe(true);
+    expect(isMiraStudentRuntimeSearch('?course=math&mira=1')).toBe(true);
+    expect(isMiraStudentRuntimeSearch('mira=1')).toBe(true);
+
+    for (const search of ['', '?mira=0', '?mira=true', '?MIRA=1', '?mira=1%20', '?mira=1&mira=0']) {
+      expect(isMiraStudentRuntimeSearch(search)).toBe(false);
+    }
+    expect(isMiraStudentRuntimeParam('1')).toBe(true);
+    expect(isMiraStudentRuntimeParam(undefined)).toBe(false);
+    expect(isMiraStudentRuntimeParam(['1'])).toBe(false);
+    expect(isMiraStudentRuntimeParam('0')).toBe(false);
+  });
+
+  it('publishes the exact student chrome health attestation', () => {
+    expect(getMiraStudentChromeRuntimePolicy()).toEqual({
+      enforced: true,
+      policyVersion: 'mira-student-chrome.v1',
+      marker: 'mira=1',
+      locale: 'zh-CN',
+      theme: 'light',
+      operatorChromePreserved: true,
+      headerControlsHidden: true,
+      exportsHidden: true,
+    });
+  });
+
+  it('uses neutral classroom metadata and icons in student mode', () => {
+    expect(MIRA_STUDENT_CLASSROOM_METADATA).toEqual({
+      title: 'Mira 学习课堂',
+      description: 'Mira 学生互动学习课堂',
+      robots: { index: false, follow: false },
+      icons: {
+        icon: '/mira-classroom-icon.svg',
+        shortcut: '/mira-classroom-icon.svg',
+        apple: '/mira-classroom-icon.svg',
+      },
+    });
+    expect(JSON.stringify(MIRA_STUDENT_CLASSROOM_METADATA).toLowerCase()).not.toContain('openmaic');
+  });
+});
