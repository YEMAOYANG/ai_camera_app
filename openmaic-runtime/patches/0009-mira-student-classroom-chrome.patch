@@ -0,0 +1,107 @@
+'use client';
+
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useLayoutEffect,
+  useState,
+  type ReactNode,
+} from 'react';
+import { useI18n } from '@/lib/hooks/use-i18n';
+import { useTheme } from '@/lib/hooks/use-theme';
+import { supportedLocales, type Locale } from '@/lib/i18n';
+
+const MiraStudentRuntimeContext = createContext(false);
+
+type StoredTheme = 'light' | 'dark' | 'system';
+
+function applyStudentDocumentPreferences() {
+  const root = document.documentElement;
+  root.lang = 'zh-CN';
+  root.classList.remove('dark');
+  root.style.colorScheme = 'light';
+}
+
+function MiraStudentPreferences({ onReady }: { readonly onReady: () => void }) {
+  const { locale, setRuntimeLocale } = useI18n();
+  const { theme, setRuntimeTheme } = useTheme();
+
+  // Snapshot the operator preferences before applying the classroom-only
+  // override. Runtime setters leave storage untouched; cleanup restores the
+  // provider state so client-side operator navigation cannot inherit student
+  // presentation settings either.
+  useLayoutEffect(() => {
+    let rawTheme: string | null = null;
+    let rawLocale: string | null = null;
+    try {
+      rawTheme = localStorage.getItem('theme');
+      rawLocale = localStorage.getItem('locale');
+    } catch {
+      // Storage may be unavailable; the in-memory provider values still give
+      // us a safe operator fallback for cleanup.
+    }
+    const previousTheme: StoredTheme =
+      rawTheme === 'light' || rawTheme === 'dark' || rawTheme === 'system' ? rawTheme : theme;
+    const previousLocale: Locale = supportedLocales.some((item) => item.code === rawLocale)
+      ? (rawLocale as Locale)
+      : locale;
+    const root = document.documentElement;
+    const previousDocument = {
+      lang: root.lang,
+      dark: root.classList.contains('dark'),
+      colorScheme: root.style.colorScheme,
+    };
+
+    applyStudentDocumentPreferences();
+    onReady();
+
+    return () => {
+      setRuntimeLocale(previousLocale);
+      setRuntimeTheme(previousTheme);
+      root.lang = previousDocument.lang;
+      root.classList.toggle('dark', previousDocument.dark);
+      root.style.colorScheme = previousDocument.colorScheme;
+    };
+    // This is deliberately mount-only: rerunning it after the override changes
+    // theme/locale would replace the operator snapshot with student values.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  useLayoutEffect(() => {
+    if (locale !== 'zh-CN') setRuntimeLocale('zh-CN');
+    if (theme !== 'light') setRuntimeTheme('light');
+
+    applyStudentDocumentPreferences();
+  }, [locale, setRuntimeLocale, setRuntimeTheme, theme]);
+
+  return null;
+}
+
+export function MiraStudentRuntimeProvider({
+  studentMode,
+  children,
+}: {
+  readonly studentMode: boolean;
+  readonly children: ReactNode;
+}) {
+  const [preferencesReady, setPreferencesReady] = useState(!studentMode);
+  const markPreferencesReady = useCallback(() => setPreferencesReady(true), []);
+
+  return (
+    <MiraStudentRuntimeContext.Provider value={studentMode}>
+      {studentMode && <MiraStudentPreferences onReady={markPreferencesReady} />}
+      {studentMode && !preferencesReady ? (
+        <div className="flex h-screen items-center justify-center bg-slate-50 text-slate-600">
+          课程加载中…
+        </div>
+      ) : (
+        children
+      )}
+    </MiraStudentRuntimeContext.Provider>
+  );
+}
+
+export function useMiraStudentRuntime(): boolean {
+  return useContext(MiraStudentRuntimeContext);
+}
