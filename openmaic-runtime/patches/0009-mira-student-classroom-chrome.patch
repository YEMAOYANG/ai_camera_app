new file mode 100644
index 0000000..7c760af
--- /dev/null
+++ b/lib/mira/student-runtime.ts
@@ -0,0 +1,41 @@
+export const MIRA_STUDENT_RUNTIME_QUERY_KEY = 'mira';
+export const MIRA_STUDENT_RUNTIME_QUERY_VALUE = '1';
+
+export const MIRA_STUDENT_CHROME_POLICY = Object.freeze({
+  enforced: true,
+  policyVersion: 'mira-student-chrome.v1',
+  marker: 'mira=1',
+  locale: 'zh-CN',
+  theme: 'light',
+  operatorChromePreserved: true,
+  headerControlsHidden: true,
+  exportsHidden: true,
+});
+
+export const MIRA_STUDENT_CLASSROOM_METADATA = Object.freeze({
+  title: 'Mira 学习课堂',
+  description: 'Mira 学生互动学习课堂',
+  robots: { index: false, follow: false },
+  icons: {
+    icon: '/mira-classroom-icon.svg',
+    shortcut: '/mira-classroom-icon.svg',
+    apple: '/mira-classroom-icon.svg',
+  },
+});
+
+export type MiraStudentChromePolicy = typeof MIRA_STUDENT_CHROME_POLICY;
+
+/** Student chrome is enabled only for the exact `mira=1` marker. */
+export function isMiraStudentRuntimeSearch(search: string): boolean {
+  const values = new URLSearchParams(search).getAll(MIRA_STUDENT_RUNTIME_QUERY_KEY);
+  return values.length === 1 && values[0] === MIRA_STUDENT_RUNTIME_QUERY_VALUE;
+}
+
+/** Server-component equivalent of the exact client-side query check. */
+export function isMiraStudentRuntimeParam(value: string | string[] | undefined): boolean {
+  return typeof value === 'string' && value === MIRA_STUDENT_RUNTIME_QUERY_VALUE;
+}
+
+export function getMiraStudentChromeRuntimePolicy(): MiraStudentChromePolicy {
+  return MIRA_STUDENT_CHROME_POLICY;
+}
