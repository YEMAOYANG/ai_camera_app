+function validateSpeechReplacement(value: unknown): asserts value is ReviewSpeechReplacement {
+  check(keys(value, ['actionId', 'expectedOldText', 'replacementText', 'reason']), 'SPEECH_REPLACEMENT');
+  const item = value as ReviewSpeechReplacement;
+  check(/^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(item.actionId) && item.expectedOldText.length > 0 && item.replacementText.length > 0 && item.expectedOldText !== item.replacementText && item.reason.trim().length > 0, 'SPEECH_REPLACEMENT');
+}
+function validateAppendedSpeech(value: unknown): asserts value is ReviewAppendedSpeechAction {
+  check(keys(value, ['id', 'type', 'text', 'reason']), 'APPENDED_SPEECH');
+  const item = value as ReviewAppendedSpeechAction;
+  check(item.type === 'speech' && /^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(item.id) && item.text.trim().length > 0 && item.reason.trim().length > 0, 'APPENDED_SPEECH');
+}
+function validateGeometry(value: unknown): asserts value is ReviewCanvasGeometryChange {
+  check(keys(value, ['elementId', 'field', 'expectedOldValue', 'replacementValue', 'reason']), 'GEOMETRY');
+  const item = value as ReviewCanvasGeometryChange;
+  check(/^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(item.elementId) && ['left', 'top', 'width', 'height'].includes(item.field) && Number.isFinite(item.expectedOldValue) && Number.isFinite(item.replacementValue) && item.expectedOldValue !== item.replacementValue && item.replacementValue >= 0 && item.reason.trim().length > 0, 'GEOMETRY');
+}
+function validateImageReplacement(value: unknown): asserts value is ReviewCanvasImageReplacement {
