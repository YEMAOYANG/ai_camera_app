@@ -0,0 +1,87 @@
+import { describe, expect, it } from 'vitest';
+import { inspectReviewHtml } from '@/lib/server/mira-textbook-current-review-revision';
+
+const media = '/api/classroom-media/stage-review/media/scene.png';
+const checkButton = '<button class="check-btn" id="checkSeatBtn" type="button" aria-label="检查当前座位">✓ 检查</button>';
+const speech = ['听完以后再操作。'];
+
+function page(options: {
+  code?: string;
+  cueText?: string;
+  image?: string;
+  widget?: string;
+  extraBody?: string;
+  style?: string;
+} = {}) {
+  const code = options.code ?? `
+    let played = false;
+    window.addEventListener('mira-narration-state', event => {
+      const detail = event.detail || {};
+      if (detail.status === 'playing' && detail.cueId === 'cue') played = true;
+      if (detail.status === 'ready' && detail.cueId === 'cue' && played) played = false;
+    });
+    document.addEventListener('visibilitychange', () => {
+      if (document.hidden && typeof window.miraCancelNarration === 'function') window.miraCancelNarration();
+    });
+    window.addEventListener('pagehide', () => {
+      if (typeof window.miraCancelNarration === 'function') window.miraCancelNarration();
+    });`;
+  return `<!doctype html><html><head><style>${options.style ?? 'button { min-height: 48px; min-width: 48px; }'}</style></head><body><main><img src="${options.image ?? media}"></main>${options.extraBody ?? ''}<script type="application/json" id="mira-narration-cues">${JSON.stringify({ schemaVersion: 'mira.interactive.narration-cues.v1', cues: [{ id: 'cue', text: options.cueText ?? speech[0] }] })}</script><script type="application/json" id="widget-config">${options.widget ?? '{"type":"simulation"}'}</script><script>${code}</script></body></html>`;
+}
+
+describe('bounded current review HTML revision', () => {
+  it('accepts behavior-only replacement with identical visible DOM, media, widget config, and matching cue speech', () => {
+    const before = page({ code: 'const oldBehavior = true;' });
+    const after = page();
+    const evidence = inspectReviewHtml(before, after, speech);
+    expect(evidence).toMatchObject({
+      cueCount: 1,
+      uniqueSpeechCount: 1,
+      visibleDomChange: 'none',
+      narrationGate: 'matching_cue_playing_then_ready',
+      hiddenRecovery: 'visibilitychange_and_pagehide_cancel_then_explicit_replay',
+      minimumTouchTargetPx: 48,
+    });
+  });
+
+  it('accepts only the exact explicit-check button as a visible DOM addition', () => {
+    const before = page({ code: 'const oldBehavior = true;' });
+    const after = page({ extraBody: checkButton });
+    expect(inspectReviewHtml(before, after, speech, 'add-explicit-check-button-v1').visibleDomChange).toBe('add-explicit-check-button-v1');
+  });
+
+  it.each([
+    ['media', () => page({ image: media.replace('scene.png', 'other.png') }), 'HTML_MEDIA_CHANGED'],
+    ['widget', () => page({ widget: '{"type":"matching"}' }), 'HTML_WIDGET_CHANGED'],
+    ['cue', () => page({ cueText: '另一句话。' }), 'HTML_CUE_ACTION_MISMATCH'],
+    ['timer', () => page({ code: `${pageCode()}\nsetTimeout(() => {}, 1);` }), 'HTML_FORBIDDEN_RUNTIME'],
+    ['no-playing', () => page({ code: pageCode().replace("detail.status === 'playing'", "detail.status === 'buffering'") }), 'HTML_PLAYING_GATE'],
+    ['no-ready', () => page({ code: pageCode().replace("detail.status === 'ready'", "detail.status === 'ended'") }), 'HTML_READY_GATE'],
+    ['visible-dom', () => page({ extraBody: '<p>extra</p>' }), 'HTML_VISIBLE_DOM_CHANGED'],
+  ])('rejects %s drift', (_name, changed, code) => {
+    const before = page({ code: 'const oldBehavior = true;' });
+    expect(() => inspectReviewHtml(before, changed(), speech)).toThrow(`TEXTBOOK_CURRENT_REVIEW_REVISION_${code}`);
+  });
+
