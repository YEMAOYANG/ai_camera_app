+async function inputs(input: CurrentReviewRevisionInput, env: CurrentReviewRevisionEnvironment) {
+  check(keys(input, ['jobDir', 'stageId', 'expectedDocumentSha256', 'expectedCandidateSha256', 'expectedCandidateFileSha256', 'stateTransitionNotes', 'revisions']), 'INPUT');
+  check(path.isAbsolute(input.jobDir) && /^[A-Za-z0-9_-]{1,160}$/.test(input.stageId) && [input.expectedDocumentSha256, input.expectedCandidateSha256, input.expectedCandidateFileSha256].every(hex), 'INPUT_ID');
+  check(Array.isArray(input.stateTransitionNotes) && input.stateTransitionNotes.every(note => typeof note === 'string' && note.trim().length > 0 && note.length <= 4000), 'STATE_NOTES');
+  check(Array.isArray(input.revisions) && input.revisions.length > 0 && input.revisions.length <= 11 && new Set(input.revisions.map(revision => revision.sceneId)).size === input.revisions.length, 'REVISIONS');
+  const html = new Map<string, string>();
+  for (const revision of input.revisions) {
+    check(keys(revision, ['sceneId', 'expectedSceneSha256', 'reviewBasis', 'speechTextReplacements', 'appendedSpeechActions', 'htmlReplacement', 'canvasGeometryChanges', 'canvasImageReplacements', 'canvasTextReplacements', 'canvasElementAppends']), 'REVISION');
+    check(/^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(revision.sceneId) && hex(revision.expectedSceneSha256) && revision.reviewBasis.trim().length > 0, 'REVISION');
+    check(Array.isArray(revision.speechTextReplacements) && Array.isArray(revision.appendedSpeechActions) && Array.isArray(revision.canvasGeometryChanges) && Array.isArray(revision.canvasImageReplacements) && Array.isArray(revision.canvasTextReplacements) && Array.isArray(revision.canvasElementAppends), 'REVISION');
+    revision.speechTextReplacements.forEach(validateSpeechReplacement);
+    revision.appendedSpeechActions.forEach(validateAppendedSpeech);
+    revision.canvasGeometryChanges.forEach(validateGeometry);
+    revision.canvasImageReplacements.forEach(validateImageReplacement);
+    revision.canvasTextReplacements.forEach(validateTextReplacement);
+    revision.canvasElementAppends.forEach(validateElementAppend);
+    check(new Set(revision.speechTextReplacements.map(item => item.actionId)).size === revision.speechTextReplacements.length, 'DUPLICATE_ACTION');
+    check(new Set(revision.appendedSpeechActions.map(item => item.id)).size === revision.appendedSpeechActions.length, 'DUPLICATE_ACTION');
+    check(new Set(revision.canvasGeometryChanges.map(item => `${item.elementId}:${item.field}`)).size === revision.canvasGeometryChanges.length, 'DUPLICATE_GEOMETRY');
+    check(new Set(revision.canvasImageReplacements.map(item => item.elementId)).size === revision.canvasImageReplacements.length && new Set(revision.canvasTextReplacements.map(item => item.elementId)).size === revision.canvasTextReplacements.length && new Set(revision.canvasElementAppends.map(item => item.element.id)).size === revision.canvasElementAppends.length, 'DUPLICATE_CANVAS');
+    check(revision.speechTextReplacements.length + revision.appendedSpeechActions.length + revision.canvasGeometryChanges.length + revision.canvasImageReplacements.length + revision.canvasTextReplacements.length + revision.canvasElementAppends.length + Number(!!revision.htmlReplacement) > 0, 'EMPTY_REVISION');
+    if (revision.htmlReplacement) {
+      check(keys(revision.htmlReplacement, ['expectedOldHtmlSha256', 'newHtmlPath', 'newHtmlSha256', 'visibleDomChange', 'reason']) && hex(revision.htmlReplacement.expectedOldHtmlSha256) && hex(revision.htmlReplacement.newHtmlSha256) && path.isAbsolute(revision.htmlReplacement.newHtmlPath) && ['none', 'add-explicit-check-button-v1'].includes(revision.htmlReplacement.visibleDomChange) && revision.htmlReplacement.reason.trim().length > 0, 'HTML_REPLACEMENT');
+      const bytes = await read(revision.htmlReplacement.newHtmlPath);
+      check(hash(bytes) === revision.htmlReplacement.newHtmlSha256, 'HTML_BYTES');
+      html.set(revision.sceneId, bytes.toString('utf8'));
+    }
+  }
+  const dataDir = await fs.realpath(env.dataDir);
+  const jobDir = path.resolve(input.jobDir);
+  const cookies = (await read(path.join(jobDir, 'owner.cookies'))).toString();
+  const owners = cookies.split(/\r?\n/).map(line => line.replace(/^#HttpOnly_/, '')).filter(line => line && !line.startsWith('#')).map(line => line.split('\t')).filter(parts => parts.length === 7 && parts[5] === 'anonymous_id').map(parts => parts[6]);
+  check(owners.length === 1 && /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(owners[0]), 'OWNER_COOKIE');
