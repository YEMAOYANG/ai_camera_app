+async function read(file: string): Promise<Buffer> {
+  check(typeof file === 'string' && path.isAbsolute(file), 'ABSOLUTE_PATH');
+  const exact = path.resolve(file);
+  check(await fs.realpath(exact) === exact, 'SYMLINK');
+  const handle = await fs.open(exact, constants.O_RDONLY | constants.O_NOFOLLOW);
+  try {
+    const stat = await handle.stat();
+    check(stat.isFile() && stat.size <= 64 * 1024 * 1024, 'FILE_SIZE');
+    return await handle.readFile();
+  } finally {
+    await handle.close();
+  }
+}
+async function directory(dir: string) {
+  let current = path.parse(dir).root;
+  for (const part of dir.slice(current.length).split(path.sep)) {
+    current = path.join(current, part);
+    try {
+      await fs.mkdir(current, { mode: 0o700 });
+    } catch (error: unknown) {
+      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+    }
+    const stat = await fs.lstat(current);
+    check(stat.isDirectory() && !stat.isSymbolicLink(), 'DIRECTORY');
+  }
+}
+async function immutable(file: string, bytes: Buffer) {
+  await directory(path.dirname(file));
+  try {
+    const handle = await fs.open(file, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, 0o600);
+    try {
+      await handle.writeFile(bytes);
+      await handle.sync();
+    } finally {
+      await handle.close();
+    }
+  } catch (error: unknown) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+    check((await read(file)).equals(bytes), 'IMMUTABLE_COLLISION');
+  }
+}
