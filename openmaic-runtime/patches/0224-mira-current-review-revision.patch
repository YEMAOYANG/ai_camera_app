+  check(/^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(item.elementId) && item.expectedOldSrc !== item.replacementSrc && item.expectedOldSrc.startsWith('/api/classroom-media/') && item.replacementSrc.startsWith('/api/classroom-media/') && item.reason.trim().length > 0, 'IMAGE_REPLACEMENT');
+}
+function validateTextReplacement(value: unknown): asserts value is ReviewCanvasTextReplacement {
+  check(keys(value, ['elementId', 'expectedOldContent', 'replacementContent', 'reason']), 'TEXT_REPLACEMENT');
+  const item = value as ReviewCanvasTextReplacement;
+  check(/^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(item.elementId) && item.expectedOldContent.length > 0 && item.replacementContent.length > 0 && item.expectedOldContent !== item.replacementContent && item.reason.trim().length > 0, 'TEXT_REPLACEMENT');
+}
+function validateElementAppend(value: unknown): asserts value is ReviewCanvasElementAppend {
+  check(keys(value, ['element', 'reason']) && object((value as ReviewCanvasElementAppend).element) && (value as ReviewCanvasElementAppend).reason.trim().length > 0, 'ELEMENT_APPEND');
+  const element = (value as ReviewCanvasElementAppend).element;
+  check(typeof element.id === 'string' && /^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(element.id) && element.type === 'image' && typeof element.src === 'string' && element.src.startsWith('/api/classroom-media/'), 'ELEMENT_APPEND');
+}
