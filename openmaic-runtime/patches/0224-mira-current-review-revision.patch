+}
+type State = Awaited<ReturnType<typeof inputs>>;
+
+async function transaction<T>(env: CurrentReviewRevisionEnvironment, readOnly: boolean, body: (query: Queryable, pool: TransactionSource) => Promise<T>): Promise<T> {
+  const client = await env.pool.connect();
+  const query: Queryable = { query: async <R extends Record<string, unknown>>(sql: string, args?: unknown[]) => {
+    if (readOnly) {
+      check(/^\s*SELECT\b/i.test(sql), 'READ_ONLY');
+      sql = sql.replace(/\s+FOR SHARE\s*$/i, '');
+    }
+    return { rows: (await client.query(sql, args)).rows as R[] };
+  } };
+  let serial = 0;
+  const nested: TransactionSource = { connect: async () => {
+    let savepoint: string | undefined;
+    return { release() {}, query: async (sql, args) => {
+      if (sql.startsWith('BEGIN')) {
+        check(!savepoint, 'TRANSACTION');
+        savepoint = `current_review_revision_${++serial}`;
+        return client.query(`SAVEPOINT ${savepoint}`);
+      }
+      if (sql === 'COMMIT' || sql === 'ROLLBACK') {
+        check(savepoint, 'TRANSACTION');
+        if (sql === 'ROLLBACK') await client.query(`ROLLBACK TO SAVEPOINT ${savepoint}`);
+        const result = await client.query(`RELEASE SAVEPOINT ${savepoint}`);
+        savepoint = undefined;
+        return result;
+      }
+      return client.query(sql, args);
+    } };
+  } };
+  try {
+    await client.query(readOnly ? 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY' : 'BEGIN');
+    const result = await body(query, nested);
+    await client.query('COMMIT');
+    return result;
+  } catch (error) {
+    await client.query('ROLLBACK');
+    throw error;
+  } finally {
+    client.release();
+  }
+}
+
+async function authority(query: Queryable, state: State, lock: boolean) {
+  const row = (await query.query('SELECT owner_id,prompt,status,deleted_at,lease_worker_id FROM agent_sessions WHERE id=$1' + (lock ? ' FOR UPDATE' : ''), [state.sessionId])).rows[0];
+  check(row && row.owner_id === state.ownerId && row.deleted_at === null && ['succeeded', 'failed', 'cancelled'].includes(String(row.status)) && row.lease_worker_id === null, 'SESSION_NOT_TERMINAL_OWNED');
+  const meta = (await query.query('SELECT owner_id,deleted_at FROM stage_meta WHERE stage_id=$1' + (lock ? ' FOR UPDATE' : ''), [state.stageId])).rows[0];
+  check(meta && meta.owner_id === state.ownerId && meta.deleted_at === null, 'STAGE_NOT_OWNED');
+  const active = await query.query("SELECT id FROM agent_sessions WHERE (stage_id=$1 OR active_stage_id=$1) AND deleted_at IS NULL AND (status IN ('queued','running') OR lease_worker_id IS NOT NULL)", [state.stageId]);
+  check(active.rows.length === 0, 'STAGE_ACTIVE');
+  const frozen = textbookContractFromPrompt(String(row.prompt));
+  check(frozen && textbookDigest(frozen) === textbookDigest(state.frozen), 'FROZEN_CHANGED');
+  const doc = await new PgDocumentStore(query, { withTransaction: async fn => fn(query) }).loadDocument(state.stageId) as CourseDocument | null;
+  check(doc && doc.stage.id === state.stageId && (doc.outline as Json)?.producerRef === state.sessionId, 'DOCUMENT_SESSION');
+  return doc!;
+}
+async function candidate(state: State) {
+  const bytes = await read(state.candidatePath);
+  const value = JSON.parse(bytes.toString());
+  unseal(value);
+  return { bytes, value };
+}
+async function validateAssets(state: State, ledger: Json) {
+  check(Array.isArray(ledger.assetBindings) && Array.isArray(ledger.bindingHistory), 'BINDINGS');
+  for (const binding of ledger.assetBindings) {
+    check(keys(binding, ['assetKey', 'src', 'sha256', 'width', 'height', 'bindingVersion', 'status']) && binding.status === 'author_candidate' && hex(binding.sha256), 'BINDING');
+    const prefix = `/api/classroom-media/${state.stageId}/media/`;
+    check(typeof binding.src === 'string' && binding.src.startsWith(prefix) && /^[A-Za-z0-9_.-]+\.(?:png|jpe?g|webp)$/.test(binding.src.slice(prefix.length)), 'BINDING_SOURCE');
+    const bytes = await read(path.join(state.dataDir, 'classrooms', state.stageId, 'media', binding.src.slice(prefix.length)));
+    check(hash(bytes) === binding.sha256, 'IMAGE_BYTES_CHANGED');
+  }
+}
+function validateDocument(state: State, doc: CourseDocument, ledger: Json) {
+  check(keys(ledger, ['schemaVersion', 'sessionId', 'stageId', 'frozenContract', 'status', 'verification', 'assetBindings', 'bindingHistory', 'scenes', 'sha256']) && ledger.schemaVersion === 'mira.textbook.authoring-candidate.v1' && ledger.sessionId === state.sessionId && ledger.stageId === state.stageId && textbookDigest(ledger.frozenContract) === textbookDigest(state.frozen) && ledger.status === 'author_candidate' && ledger.verification === 'static_contract_only_not_play_or_semantic_review', 'CANDIDATE_IDENTITY');
+  unseal(ledger);
+  check(doc.scenes.length === state.frozen.contract.pagePlan.length && Array.isArray(ledger.scenes) && doc.scenes.length === ledger.scenes.length && new Set(doc.scenes.map(scene => scene.id)).size === doc.scenes.length, 'COMPLETE_DOCUMENT');
+  for (const [index, scene] of doc.scenes.entries()) {
+    check(scene.order === index + 1 && scene.stageId === state.stageId && validateScene(scene).valid, 'SCENE_DSL');
+    assertTextbookScene(scene, state.frozen, ledger.assetBindings);
+    check(textbookDigest(ledger.scenes[index]) === textbookDigest({ sceneId: scene.id, order: scene.order, sha256: textbookDigest(scene), canonicalJson: textbookCanonical(scene), contractSha256: state.frozen.sha256 }), 'SCENE_LEDGER');
+  }
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+function applySceneRevision(scene: any, revision: ReviewSceneRevision, replacementHtml: string | undefined, boundSources: Set<string>) {
+  check(textbookDigest(scene) === revision.expectedSceneSha256, 'SCENE_CHANGED');
+  const next = structuredClone(scene);
+  const originalActions = structuredClone(scene.actions ?? []);
+  check(Array.isArray(next.actions) && new Set(next.actions.map((action: Json) => action.id)).size === next.actions.length, 'ACTIONS');
+  const fieldDiffs: Json[] = [];
+  for (const replacement of revision.speechTextReplacements) {
+    const index = next.actions.findIndex((action: Json) => action.id === replacement.actionId);
+    check(index >= 0 && next.actions[index].type === 'speech' && next.actions[index].text === replacement.expectedOldText, 'SPEECH_CHANGED');
+    next.actions[index].text = replacement.replacementText;
+    fieldDiffs.push({ path: `/actions/${index}/text`, kind: 'speech-text', before: replacement.expectedOldText, after: replacement.replacementText, reason: replacement.reason });
+  }
+  const existingIds = new Set(next.actions.map((action: Json) => action.id));
+  const existingSpeech = new Set(next.actions.filter((action: Json) => action.type === 'speech').map((action: Json) => action.text));
+  for (const appended of revision.appendedSpeechActions) {
+    check(!existingIds.has(appended.id) && !existingSpeech.has(appended.text), 'APPENDED_SPEECH_COLLISION');
+    const action = { id: appended.id, type: 'speech', text: appended.text };
+    fieldDiffs.push({ path: `/actions/${next.actions.length}`, kind: 'authorized-feedback-speech-append', before: null, after: action, reason: appended.reason });
+    next.actions.push(action);
+    existingIds.add(appended.id);
+    existingSpeech.add(appended.text);
+  }
+  check(next.actions.length === originalActions.length + revision.appendedSpeechActions.length, 'ACTION_LENGTH');
+  for (let index = 0; index < originalActions.length; index++) {
+    const allowed = revision.speechTextReplacements.find(item => item.actionId === originalActions[index].id);
+    const expected = allowed ? { ...originalActions[index], text: allowed.replacementText } : originalActions[index];
+    check(textbookCanonical(next.actions[index]) === textbookCanonical(expected), 'ACTION_PREFIX_CHANGED');
+  }
+  let htmlEvidence: Json | null = null;
+  if (revision.htmlReplacement) {
+    check(next.type === 'interactive' && typeof next.content?.html === 'string' && replacementHtml !== undefined, 'HTML_SCENE');
+    check(hash(next.content.html) === revision.htmlReplacement.expectedOldHtmlSha256 && hash(replacementHtml) === revision.htmlReplacement.newHtmlSha256, 'HTML_CHANGED');
+    const beforeHtml = next.content.html;
+    next.content.html = replacementHtml;
+    htmlEvidence = inspectReviewHtml(beforeHtml, replacementHtml, next.actions.filter((action: Json) => action.type === 'speech').map((action: Json) => action.text), revision.htmlReplacement.visibleDomChange);
+    fieldDiffs.push({ path: '/content/html', kind: 'complete-interactive-html', beforeSha256: hash(beforeHtml), afterSha256: hash(replacementHtml), beforeBytes: Buffer.byteLength(beforeHtml), afterBytes: Buffer.byteLength(replacementHtml), reason: revision.htmlReplacement.reason });
+  }
+  for (const geometry of revision.canvasGeometryChanges) {
+    check(next.type === 'slide' && Array.isArray(next.content?.canvas?.elements), 'GEOMETRY_SCENE');
+    const index = next.content.canvas.elements.findIndex((element: Json) => element.id === geometry.elementId);
+    check(index >= 0 && next.content.canvas.elements[index][geometry.field] === geometry.expectedOldValue, 'GEOMETRY_CHANGED');
+    next.content.canvas.elements[index][geometry.field] = geometry.replacementValue;
+    fieldDiffs.push({ path: `/content/canvas/elements/${index}/${geometry.field}`, kind: 'canvas-geometry', before: geometry.expectedOldValue, after: geometry.replacementValue, reason: geometry.reason });
+  }
+  for (const image of revision.canvasImageReplacements) {
+    check(next.type === 'slide' && Array.isArray(next.content?.canvas?.elements) && boundSources.has(image.replacementSrc), 'IMAGE_SCENE');
+    const index = next.content.canvas.elements.findIndex((element: Json) => element.id === image.elementId);
+    check(index >= 0 && next.content.canvas.elements[index].type === 'image' && next.content.canvas.elements[index].src === image.expectedOldSrc, 'IMAGE_CHANGED');
+    next.content.canvas.elements[index].src = image.replacementSrc;
+    fieldDiffs.push({ path: `/content/canvas/elements/${index}/src`, kind: 'bound-canvas-image', before: image.expectedOldSrc, after: image.replacementSrc, reason: image.reason });
+  }
+  for (const text of revision.canvasTextReplacements) {
+    check(next.type === 'slide' && Array.isArray(next.content?.canvas?.elements), 'TEXT_SCENE');
+    const index = next.content.canvas.elements.findIndex((element: Json) => element.id === text.elementId);
+    check(index >= 0 && next.content.canvas.elements[index].type === 'text' && next.content.canvas.elements[index].content === text.expectedOldContent, 'TEXT_CHANGED');
+    next.content.canvas.elements[index].content = text.replacementContent;
+    fieldDiffs.push({ path: `/content/canvas/elements/${index}/content`, kind: 'canvas-text', before: text.expectedOldContent, after: text.replacementContent, reason: text.reason });
+  }
+  for (const append of revision.canvasElementAppends) {
+    check(next.type === 'slide' && Array.isArray(next.content?.canvas?.elements) && boundSources.has(append.element.src) && !next.content.canvas.elements.some((element: Json) => element.id === append.element.id), 'ELEMENT_APPEND');
+    const index = next.content.canvas.elements.length;
+    next.content.canvas.elements.push(structuredClone(append.element));
+    fieldDiffs.push({ path: `/content/canvas/elements/${index}`, kind: 'bound-canvas-image-append', before: null, after: append.element, reason: append.reason });
+  }
+  check(textbookDigest(next) !== textbookDigest(scene), 'NO_CHANGE');
+  return {
+    next,
+    evidence: {
+      sceneId: scene.id,
+      beforeSceneSha256: textbookDigest(scene),
+      afterSceneSha256: textbookDigest(next),
+      originalActionsSha256: textbookDigest(originalActions),
+      revisedActionsSha256: textbookDigest(next.actions),
+      originalActionCount: originalActions.length,
+      revisedActionCount: next.actions.length,
+      originalActionPrefixPolicy: 'byte-equivalent-except-allowlisted-speech-text',
+      appendedSpeechPolicy: 'authorized-tail-only',
+      fieldDiffs,
+      htmlEvidence,
+      reviewBasis: revision.reviewBasis,
+    },
+  };
+}
+
+async function describe(input: CurrentReviewRevisionInput, state: State, doc: CourseDocument, ledgerBytes: Buffer) {
+  const ledger = JSON.parse(ledgerBytes.toString());
+  check(textbookDigest(doc) === input.expectedDocumentSha256 && ledger.sha256 === input.expectedCandidateSha256 && hash(ledgerBytes) === input.expectedCandidateFileSha256, 'STALE_BEFORE');
+  validateDocument(state, doc, ledger);
+  await validateAssets(state, ledger);
+  const after = structuredClone(doc);
+  const revisions: Json[] = [];
+  const boundSources = new Set<string>(ledger.assetBindings.map((binding: Json) => binding.src));
+  for (const revision of input.revisions) {
+    const index = after.scenes.findIndex(scene => scene.id === revision.sceneId);
+    check(index >= 0, 'SCENE_MISSING');
+    const result = applySceneRevision(doc.scenes[index], revision, state.html.get(revision.sceneId), boundSources);
+    after.scenes[index] = result.next;
+    revisions.push(result.evidence);
+  }
+  const body = unseal(ledger);
+  const afterCandidate = seal({ ...body, scenes: after.scenes.map(scene => ({ sceneId: scene.id, order: scene.order, sha256: textbookDigest(scene), canonicalJson: textbookCanonical(scene), contractSha256: state.frozen.sha256 })) });
+  validateDocument(state, after, afterCandidate);
+  await validateAssets(state, afterCandidate);
+  check(textbookCanonical(afterCandidate.assetBindings) === textbookCanonical(ledger.assetBindings) && textbookCanonical(afterCandidate.bindingHistory) === textbookCanonical(ledger.bindingHistory), 'ASSET_LEDGER_CHANGED');
+  const plan = seal({
+    schemaVersion: PLAN,
+    verification: VERIFY,
+    input,
+    dataDir: state.dataDir,
+    sessionId: state.sessionId,
+    stageId: state.stageId,
+    ownerFingerprint: state.ownerFingerprint,
+    contractSha256: state.frozen.sha256,
+    beforeDocumentSha256: textbookDigest(doc),
+    afterDocumentSha256: textbookDigest(after),
+    beforeCandidateSha256: ledger.sha256,
+    beforeCandidateFileSha256: hash(ledgerBytes),
+    afterCandidateSha256: afterCandidate.sha256,
+    afterCandidateFileSha256: hash(encoded(afterCandidate)),
+    stateTransitionNotes: input.stateTransitionNotes,
+    revisions,
+  });
+  return { plan, after, afterCandidate, beforeCandidate: ledger };
+}
+
+export async function prepareCurrentReviewRevision(input: CurrentReviewRevisionInput, env: CurrentReviewRevisionEnvironment): Promise<Json> {
+  const state = await inputs(input, env);
+  return transaction(env, true, async query => {
+    const doc = await authority(query, state, false);
+    const ledger = await candidate(state);
+    const result = await describe(input, state, doc, ledger.bytes);
+    check(hash((await candidate(state)).bytes) === hash(ledger.bytes), 'CANDIDATE_FENCE');
+    return result.plan;
+  });
+}
+
+/** Candidate rename and SQL commit are recoverable, not a cross-system atomic commit. */
+export async function runCurrentReviewRevision(plan: Json, approvedPlanSha256: string, env: CurrentReviewRevisionEnvironment): Promise<Json> {
+  unseal(plan);
+  check(plan.schemaVersion === PLAN && plan.sha256 === approvedPlanSha256, 'PLAN_APPROVAL');
+  const state = await inputs(plan.input, env);
+  const dir = path.join(state.dataDir, 'textbook-current-review-revisions', hash(state.sessionId), state.stageId, plan.sha256);
+  const intent = path.join(dir, 'intent.json');
+  const originalCandidate = path.join(dir, 'original-candidate.json');
+  const originalDocument = path.join(dir, 'original-document.json');
+  let prior = false;
+  try {
+    check((await read(intent)).equals(encoded(plan)), 'INTENT_COLLISION');
+    prior = true;
+  } catch (error: unknown) {
+    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+  }
+  const receipt = await transaction(env, false, async (query, pool) => {
+    const actualDoc = await authority(query, state, true);
+    const actual = await candidate(state);
+    check([plan.beforeDocumentSha256, ...(prior ? [plan.afterDocumentSha256] : [])].includes(textbookDigest(actualDoc)), 'DOCUMENT_CHANGED');
+    check([plan.beforeCandidateFileSha256, ...(prior ? [plan.afterCandidateFileSha256] : [])].includes(hash(actual.bytes)), 'CANDIDATE_CHANGED');
+    const beforeDoc = prior ? JSON.parse((await read(originalDocument)).toString()) : actualDoc;
+    const beforeBytes = prior ? await read(originalCandidate) : actual.bytes;
+    check(hash(beforeBytes) === plan.beforeCandidateFileSha256 && textbookDigest(beforeDoc) === plan.beforeDocumentSha256, 'ORIGINAL_CHANGED');
+    const next = await describe(plan.input, state, beforeDoc, beforeBytes);
+    check(textbookCanonical(next.plan) === textbookCanonical(plan), 'PLAN_STALE');
+    if (textbookDigest(actualDoc) === plan.afterDocumentSha256) check(textbookCanonical(actualDoc) === textbookCanonical(next.after), 'AFTER_DOCUMENT');
+    if (hash(actual.bytes) === plan.afterCandidateFileSha256) check(actual.bytes.equals(encoded(next.afterCandidate)), 'AFTER_CANDIDATE');
+    if (prior) {
+      check((await read(originalDocument)).equals(encoded(beforeDoc)) && (await read(originalCandidate)).equals(beforeBytes), 'ORIGINAL_CHANGED');
+      for (const revision of plan.revisions) {
+        const scene = beforeDoc.scenes.find((value: Json) => value.id === revision.sceneId);
+        check(scene && (await read(path.join(dir, `original-scene-${hash(scene.id)}.json`))).equals(encoded(scene)), 'ORIGINAL_CHANGED');
+        if (revision.htmlEvidence) {
+          check(hash(await read(path.join(dir, `original-html-${hash(scene.id)}.html`))) === revision.htmlEvidence.beforeHtmlSha256, 'ORIGINAL_CHANGED');
+          check(hash(await read(path.join(dir, `revised-html-${hash(scene.id)}.html`))) === revision.htmlEvidence.afterHtmlSha256, 'ORIGINAL_CHANGED');
+        }
+      }
+    }
+    await immutable(originalCandidate, beforeBytes);
+    await immutable(originalDocument, encoded(beforeDoc));
+    for (const revision of plan.revisions) {
+      const scene = beforeDoc.scenes.find((value: Json) => value.id === revision.sceneId);
+      check(scene, 'SCENE_MISSING');
+      await immutable(path.join(dir, `original-scene-${hash(scene.id)}.json`), encoded(scene));
+      if (revision.htmlEvidence) {
+        await immutable(path.join(dir, `original-html-${hash(scene.id)}.html`), Buffer.from(scene.content.html));
+        const revised = next.after.scenes.find((value: Json) => value.id === revision.sceneId)! as Json;
+        await immutable(path.join(dir, `revised-html-${hash(scene.id)}.html`), Buffer.from(revised.content.html));
+      }
+    }
+    await immutable(intent, encoded(plan));
+    let current = actualDoc;
+    if (textbookDigest(current) === plan.beforeDocumentSha256) {
+      for (const revised of next.after.scenes.filter(scene => plan.revisions.some((revision: Json) => revision.sceneId === scene.id))) {
+        const intermediate = { ...current, scenes: current.scenes.map(scene => scene.id === revised.id ? revised : scene) };
+        const fences = [textbookDigest(current), textbookDigest(intermediate)];
+        let index = 0;
+        const store = createOwnerBoundDocumentStore({
+          pool,
+          ownerId: state.ownerId,
+          validateScene,
+          validateStage: validateAppStage,
+          mutationFence: async transactionQuery => {
+            check(textbookDigest(await authority(transactionQuery, state, true)) === fences[index++], 'DOCUMENT_FENCE');
+            check(hash((await candidate(state)).bytes) === hash(actual.bytes), 'CANDIDATE_FENCE');
+          },
+        }) as unknown as CourseStore;
+        await store.putScene(state.stageId, revised);
+        check(index === 2, 'FENCE_COUNT');
+        current = intermediate;
+      }
+    }
+    const finalDoc = await authority(query, state, true);
+    check(textbookDigest(finalDoc) === plan.afterDocumentSha256, 'AFTER_DOCUMENT');
+    validateDocument(state, finalDoc, next.afterCandidate);
+    await validateAssets(state, next.afterCandidate);
+    check(hash((await candidate(state)).bytes) === hash(actual.bytes), 'CANDIDATE_FENCE');
+    if (hash(actual.bytes) !== plan.afterCandidateFileSha256) {
+      const temporary = `${state.candidatePath}.${randomUUID()}.tmp`;
+      await immutable(temporary, encoded(next.afterCandidate));
+      try {
+        check(hash((await candidate(state)).bytes) === hash(actual.bytes), 'CANDIDATE_FENCE');
+        await fs.rename(temporary, state.candidatePath);
+      } finally {
+        try {
+          await fs.unlink(temporary);
+        } catch (error: unknown) {
+          if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+        }
+      }
+      const parent = await fs.open(path.dirname(state.candidatePath), constants.O_RDONLY);
+      try {
+        await parent.sync();
+      } finally {
+        await parent.close();
+      }
+    }
+    check(hash((await candidate(state)).bytes) === plan.afterCandidateFileSha256, 'AFTER_CANDIDATE');
+    return seal({
+      schemaVersion: RECEIPT,
+      revisionId: plan.sha256,
+      status: 'static_candidate_review_revised',
+      verification: VERIFY,
+      sessionId: state.sessionId,
+      stageId: state.stageId,
+      planSha256: plan.sha256,
+      documentSha256: plan.afterDocumentSha256,
+      candidateSha256: plan.afterCandidateSha256,
+      candidateFileSha256: plan.afterCandidateFileSha256,
+      stateTransitionNotes: plan.stateTransitionNotes,
+      revisions: plan.revisions,
+      providerCalls: 0,
+    });
+  });
+  await immutable(path.join(dir, 'receipt.json'), encoded(receipt));
+  return receipt;
+}
