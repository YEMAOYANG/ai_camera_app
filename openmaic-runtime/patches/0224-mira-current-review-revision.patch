+const scriptBodyPattern = /(<script\b[^>]*>)[\s\S]*?(<\/script\s*>)/gi;
+const styleBodyPattern = /(<style\b[^>]*>)[\s\S]*?(<\/style\s*>)/gi;
+const mediaPattern = /\/api\/classroom-media\/[A-Za-z0-9_-]+\/media\/[A-Za-z0-9_.-]+\.(?:png|jpe?g|webp)/g;
+const jsonScript = (html: string, id: string): Json => {
+  const escaped = id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  const patterns = [
+    new RegExp(`<script\\b(?=[^>]*\\bid=["']${escaped}["'])[^>]*>([\\s\\S]*?)<\\/script\\s*>`, 'i'),
+    new RegExp(`<script\\b(?=[^>]*\\bid=${escaped}(?:\\s|>))[^>]*>([\\s\\S]*?)<\\/script\\s*>`, 'i'),
+  ];
+  const match = patterns.map(pattern => pattern.exec(html)).find(Boolean);
+  check(match, 'HTML_JSON_SCRIPT');
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(match![1]);
+  } catch {
+    check(false, 'HTML_JSON_SCRIPT');
+  }
+  check(object(parsed), 'HTML_JSON_SCRIPT');
+  return parsed;
+};
+const mediaSources = (html: string) => [...html.matchAll(mediaPattern)].map(match => match[0]).sort();
+const visibleSkeleton = (html: string) => html
+  .replace(styleBodyPattern, '$1$2')
+  .replace(scriptBodyPattern, '$1$2');
+const executableScripts = (html: string) => [...html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)]
+  .filter(match => !/\btype\s*=\s*["']application\/json["']/i.test(match[1]))
+  .map(match => match[2]).join('\n');
+
+export function inspectReviewHtml(before: string, after: string, speechTexts: string[], visibleDomChange: ReviewHtmlReplacement['visibleDomChange'] = 'none') {
+  check(before !== after, 'HTML_UNCHANGED');
+  check(textbookCanonical(mediaSources(after)) === textbookCanonical(mediaSources(before)), 'HTML_MEDIA_CHANGED');
+  const expectedCheckButton = '<button class="check-btn" id="checkSeatBtn" type="button" aria-label="检查当前座位">✓ 检查</button>';
+  if (visibleDomChange === 'none') check(visibleSkeleton(after) === visibleSkeleton(before), 'HTML_VISIBLE_DOM_CHANGED');
+  else {
+    check(visibleDomChange === 'add-explicit-check-button-v1' && visibleSkeleton(after).split(expectedCheckButton).length === 2, 'HTML_VISIBLE_DOM_CHANGED');
+    check(visibleSkeleton(after).replace(expectedCheckButton, '') === visibleSkeleton(before), 'HTML_VISIBLE_DOM_CHANGED');
+  }
+  const beforeWidget = jsonScript(before, 'widget-config');
+  const afterWidget = jsonScript(after, 'widget-config');
+  check(textbookCanonical(afterWidget) === textbookCanonical(beforeWidget), 'HTML_WIDGET_CHANGED');
+  const cueManifest = jsonScript(after, 'mira-narration-cues');
+  check(keys(cueManifest, ['schemaVersion', 'cues']) && cueManifest.schemaVersion === 'mira.interactive.narration-cues.v1' && Array.isArray(cueManifest.cues), 'HTML_CUES');
+  const cues = cueManifest.cues as Json[];
+  check(cues.every(cue => keys(cue, ['id', 'text']) && typeof cue.id === 'string' && cue.id.length > 0 && typeof cue.text === 'string' && cue.text.trim().length > 0), 'HTML_CUES');
+  check(new Set(cues.map(cue => cue.id)).size === cues.length && new Set(cues.map(cue => cue.text)).size === cues.length, 'HTML_CUE_DUPLICATE');
+  check(textbookCanonical([...new Set(cues.map(cue => cue.text))].sort()) === textbookCanonical([...new Set(speechTexts)].sort()), 'HTML_CUE_ACTION_MISMATCH');
+  const code = executableScripts(after);
+  check(!/(?:setTimeout\s*\(|speechSynthesis|new\s+Audio\s*\(|fetch\s*\(|XMLHttpRequest|WebSocket\s*\()/i.test(code), 'HTML_FORBIDDEN_RUNTIME');
+  check(/addEventListener\s*\(\s*['"]mira-narration-state['"]/.test(code), 'HTML_EVENT_GATE');
+  check(/(?:status|detail\.status)[\s\S]{0,80}(?:===|==)\s*['"]playing['"]/.test(code), 'HTML_PLAYING_GATE');
+  check(/(?:status|detail\.status)[\s\S]{0,80}(?:===|==)\s*['"]ready['"]/.test(code), 'HTML_READY_GATE');
+  check(/(?:cueId|detail\.cueId)/.test(code), 'HTML_CUE_ID_GATE');
+  check(/addEventListener\s*\(\s*['"]visibilitychange['"]/.test(code) && /addEventListener\s*\(\s*['"]pagehide['"]/.test(code), 'HTML_HIDDEN_RECOVERY');
+  check(/miraCancelNarration/.test(code) && /document\.hidden/.test(code), 'HTML_HIDDEN_RECOVERY');
+  check(/48px/.test(after), 'HTML_TOUCH_TARGET');
+  return {
+    beforeHtmlSha256: hash(before),
+    afterHtmlSha256: hash(after),
+    mediaSourcesSha256: textbookDigest(mediaSources(after)),
+    visibleSkeletonSha256: hash(visibleSkeleton(after)),
+    visibleDomChange,
+    widgetConfigSha256: textbookDigest(afterWidget),
+    cueManifestSha256: textbookDigest(cueManifest),
+    cueCount: cues.length,
+    uniqueSpeechCount: new Set(speechTexts).size,
+    narrationGate: 'matching_cue_playing_then_ready',
+    hiddenRecovery: 'visibilitychange_and_pagehide_cancel_then_explicit_replay',
+    minimumTouchTargetPx: 48,
+  };
+}
