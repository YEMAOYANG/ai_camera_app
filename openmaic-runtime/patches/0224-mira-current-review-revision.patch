+/**
+ * Explicit, bounded review revision for an already-complete textbook candidate.
+ *
+ * This operator has no HTTP entry point and never calls a model, TTS, ASR,
+ * publication, or runtime restart.  It changes only explicitly fenced speech
+ * text, tail-appended feedback speech, one complete interactive HTML field, or
+ * allowlisted slide geometry leaves.  The original candidate, document,
+ * affected scenes, and HTML are archived before the first public write.
+ */
+import { createHash, randomUUID } from 'node:crypto';
+import { constants, promises as fs } from 'node:fs';
+import path from 'node:path';
+import { validateScene } from '@openmaic/dsl';
+import { PgDocumentStore, type Queryable } from '@openmaic/storage/document/pg';
+import { validateAppStage } from '@/lib/document-store/validators';
+import { createOwnerBoundDocumentStore, type TransactionSource } from '@/lib/persistence/owner-bound-document-store';
+import { resolveRequestOwnerId } from './agent-runtime/owner';
+import type { CourseDocument, CourseStore } from './agent-runtime/course-tools';
+import { assertTextbookContract, assertTextbookScene, textbookCanonical, textbookDigest, textbookContractFromPrompt } from './mira-textbook-scene-contract';
+
+// The operator validates every externally supplied object before use. Dynamic
+// scene leaves stay intentionally JSON-shaped because the DSL is a tagged
+// union with element-specific fields.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+type Json = Record<string, any>;
+const PLAN = 'mira.textbook.current-review-revision-plan.v1';
+const RECEIPT = 'mira.textbook.current-review-revision-receipt.v1';
+const VERIFY = 'static_review_only_not_play_audio_or_publication';
+const hash = (value: string | Buffer) => createHash('sha256').update(value).digest('hex');
+const check: (value: unknown, code: string) => asserts value = (value, code) => {
+  if (!value) throw new Error(`TEXTBOOK_CURRENT_REVIEW_REVISION_${code}`);
+};
+const object = (value: unknown): value is Json => !!value && typeof value === 'object' && !Array.isArray(value);
+const hex = (value: unknown): value is string => typeof value === 'string' && /^[a-f0-9]{64}$/.test(value);
+const keys = (value: unknown, fields: string[]) => object(value) && Object.keys(value).sort().join(',') === [...fields].sort().join(',');
+const encoded = (value: unknown) => Buffer.from(textbookCanonical(value) + '\n');
+const seal = (value: Json): Json => ({ ...value, sha256: textbookDigest(value) });
+function unseal(value: Json): Json {
+  const { sha256, ...body } = value;
+  check(hex(sha256) && textbookDigest(body) === sha256, 'SEAL');
+  return body;
+}
