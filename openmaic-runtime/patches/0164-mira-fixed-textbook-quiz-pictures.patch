@@ -0,0 +1,40 @@
+'use client';
+
+import { cn } from '@/lib/utils';
+import type { QuizVisual } from '@openmaic/dsl';
+
+/** The visual never supplies an answer; its containing button owns the value. */
+export function QuizPicture({ visual, scene = false }: { visual: QuizVisual; scene?: boolean }) {
+  if (visual.kind === 'people') return (
+    <span data-quiz-visual="people" className="flex justify-center gap-4 rounded-xl bg-[#eef2e8] p-3">
+      {visual.members.map(member => <span key={member.id} data-person-id={member.id} className="block min-w-0 max-w-36 flex-1">
+        <QuizPicture visual={{ kind: 'image', src: member.src, alt: member.alt, cue: member.cue }} scene={scene} />
+      </span>)}
+    </span>
+  );
+  if (visual.kind === 'quantity') return (
+    <svg data-quiz-visual="quantity" data-quantity={visual.count} viewBox={`0 0 240 ${Math.max(120, Math.ceil(visual.count / 5) * 22 + 28)}`} role="img"
+      aria-label={visual.alt ?? `${visual.count} 个物体`} className={scene ? 'w-full h-36' : 'w-full h-24'}>
+      <rect x="6" y="6" width="228" height={Math.max(108, Math.ceil(visual.count / 5) * 22 + 16)} rx="20" fill="#eef2e8" stroke="#d1dccb" />
+      {Array.from({ length: visual.count }, (_, index) => (
+        <circle key={index} cx={30 + (index % 5) * 45} cy={29 + Math.floor(index / 5) * 22} r="9" fill="#d9a844" stroke="#9e782e" />
+      ))}
+    </svg>
+  );
+  return (
+    <span data-quiz-visual="image" className="relative block w-full">
+      {/* Approved local/original assets can cross the classroom origin. */}
+      {/* eslint-disable-next-line @next/next/no-img-element */}
+      <img src={visual.src} alt={visual.alt} className={cn('w-full object-contain rounded-xl', scene ? 'max-h-52' : 'h-28')} />
+      {visual.cue && visual.cue !== 'observer' && (
+        <svg data-person-cue={visual.cue} viewBox="0 0 64 48" aria-label={visual.cue === 'speaking' ? '正在说话' : '正在听'}
+          className="absolute right-1 top-1 w-12 h-10 drop-shadow-sm" role="img">
+          <path d="M8 4h45v30H29L18 44V34H8Z" fill="#fff9e6" stroke="#466a51" strokeWidth="2" />
+          {visual.cue === 'speaking'
+            ? <path d="M19 18v7m8-13v18m8-15v12m8-9v6" stroke="#466a51" strokeWidth="3" strokeLinecap="round" />
+            : <path d="M23 26c-6-11 2-19 10-16 9 3 4 12 0 13-3 1-1 8-5 8m1-12c2-5 7-3 5 1" fill="none" stroke="#466a51" strokeWidth="3" strokeLinecap="round" />}
+        </svg>
+      )}
+    </span>
+  );
+}
