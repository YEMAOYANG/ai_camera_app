+++ b/tests/scene-renderers/fixed-textbook-quiz-pictures.test.ts
@@ -0,0 +1,19 @@
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it } from 'vitest';
+import { FixedTextbookOptionFace } from '@/components/scene-renderers/fixed-textbook-quiz';
+
+describe('published textbook quiz options', () => {
+  it('shows the reviewed picture and keeps the label for assistive technology only', () => {
+    const markup = renderToStaticMarkup(
+      createElement(FixedTextbookOptionFace, { visual: { kind: 'quantity', count: 3, alt: '3个' }, label: '三个' }),
+    );
+    expect(markup).toContain('data-quiz-visual="quantity"');
+    expect(markup).toContain('data-quantity="3"');
+    expect(markup).toContain('<span class="sr-only">三个</span>');
+  });
+
+  it('keeps a text answer unchanged when a question has no pictures', () => {
+    expect(renderToStaticMarkup(createElement(FixedTextbookOptionFace, { label: '天' }))).toBe('天');
+  });
+});
