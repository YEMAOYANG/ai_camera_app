+      try { check(hash((await candidate(s)).bytes) === hash(actual.bytes), 'CANDIDATE_FENCE'); await fs.rename(temporary, s.candidatePath); }
+      finally { try { await fs.unlink(temporary); } catch (e: any) { if (e.code !== 'ENOENT') throw e; } }
+      const parent = await fs.open(path.dirname(s.candidatePath), constants.O_RDONLY); try { await parent.sync(); } finally { await parent.close(); }
