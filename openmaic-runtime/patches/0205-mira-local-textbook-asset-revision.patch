diff --git a/scripts/revise-textbook-assets.ts b/scripts/revise-textbook-assets.ts
new file mode 100644
index 0000000..930f069
--- /dev/null
+++ b/scripts/revise-textbook-assets.ts
@@ -0,0 +1,25 @@
+/** Local operator only. Explicit prepare/run JSON stdin; existing ownership is mandatory. */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { Pool } from 'pg';
+import { prepareTextbookAssetRevision, runTextbookAssetRevision } from '../lib/server/mira-textbook-asset-revision';
+
+async function main() {
+  const mode = process.argv[2];
+  if (!['prepare', 'run'].includes(mode)) throw new Error('USAGE');
+  let body = ''; for await (const chunk of process.stdin) { body += chunk; if (body.length > 1024 * 1024) throw new Error('INPUT_TOO_LARGE'); }
+  const input = JSON.parse(body), connectionString = process.env.MIRA_OPENMAIC_AGENT_DATABASE_URL ?? process.env.DATABASE_URL;
+  if (!connectionString) throw new Error('DATABASE_CONFIGURATION');
+  const pool = new Pool({ connectionString, max: 1 });
+  try {
+    const env = { pool, dataDir: path.resolve('data') };
+    if (mode === 'run' && Object.keys(input).sort().join(',') !== 'approvedPlanSha256,planPath') throw new Error('RUN_INPUT');
+    const result = mode === 'prepare' ? await prepareTextbookAssetRevision(input, env) : await runTextbookAssetRevision(JSON.parse(await fs.readFile(input.planPath, 'utf8')), input.approvedPlanSha256, env);
+    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
+  } finally { await pool.end(); }
+}
+main().catch(error => {
+  const message = String(error?.message ?? '');
+  process.stderr.write(JSON.stringify({ error: /^(TEXTBOOK_ASSET_REVISION_|TEXTBOOK_SCENE_)[A-Z0-9_]+$/.test(message) ? message : 'LOCAL_ASSET_REVISION_FAILED_NO_AUTOMATIC_RETRY' }) + '\n');
+  process.exitCode = 1;
+});
