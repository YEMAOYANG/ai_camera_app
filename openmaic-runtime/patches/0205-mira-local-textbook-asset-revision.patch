+async function transaction<T>(env: AssetRevisionEnvironment, readOnly: boolean, body: (q: Queryable, pool: TransactionSource) => Promise<T>): Promise<T> {
+  const client = await env.pool.connect();
+  const q: Queryable = { query: async <R extends Record<string, unknown>>(sql: string, args?: unknown[]) => {
+    if (readOnly) { check(/^\s*SELECT\b/i.test(sql), 'READ_ONLY'); sql = sql.replace(/\s+FOR SHARE\s*$/i, ''); }
+    return { rows: (await client.query(sql, args)).rows as R[] };
+  } };
+  let serial = 0;
+  const nested: TransactionSource = { connect: async () => {
+    let savepoint: string | undefined;
+    return { release() {}, query: async (sql, args) => {
+      if (sql.startsWith('BEGIN')) { check(!savepoint, 'TRANSACTION'); savepoint = `asset_revision_${++serial}`; return client.query(`SAVEPOINT ${savepoint}`); }
