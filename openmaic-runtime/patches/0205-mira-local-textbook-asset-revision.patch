+  const meta = await decoded.metadata();
+  check(['png', 'jpeg', 'webp'].includes(meta.format ?? '') && meta.width && meta.height && (!meta.pages || meta.pages === 1), 'IMAGE_FORMAT');
+  await decoded.stats(); // Decode, rather than accepting a truncated image header.
+  return { sha256: hash(bytes), width: meta.width!, height: meta.height!, extension: meta.format === 'jpeg' ? 'jpg' : meta.format! };
