@@ -0,0 +1,309 @@
+import { describe, expect, it } from 'vitest';
+import { chromium } from 'playwright-core';
+import { createRequire } from 'node:module';
+import { readFileSync, mkdirSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+
+type FixtureWindow = Window & {
+  mountReferenceQuiz: (fixed: boolean) => void;
+  changeReferenceSource: () => void;
+  unmountReferenceQuiz: () => void;
+  audioStats: { created: number; plays: number; pauses: number };
+  shortcutCalls: number;
+  posts: unknown[];
+};
+type BundleFile = { path: string; text: string };
+type BuildHooks = {
+  onResolve: (
+    options: { filter: RegExp },
+    callback: (args: { path: string }) => { path: string; namespace: string } | undefined,
+  ) => void;
+  onLoad: (
+    options: { filter: RegExp; namespace: string },
+    callback: (args: { path: string }) => { contents: string; loader: string },
+  ) => void;
+};
+
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== '1')('reference picture viewer', () => {
+  it('enlarges the original in both quizzes/fullscreen without changing answers, audio or lesson shortcuts', async () => {
+    const require = createRequire(import.meta.url);
+    const { build } = createRequire(require.resolve('tsx'))('esbuild');
+    const mocks: Record<string, string> = {
+      '@/lib/hooks/use-i18n': `export const useI18n=()=>({t:k=>k,locale:'zh-CN'});`,
+      '@/lib/store': `const state={stage:{fixedTextbook:true},currentSceneId:'quiz',scenes:[]};export const useStageStore=f=>f(state);useStageStore.getState=()=>state;`,
+      '@/lib/contexts/mira-student-runtime-context': `export const useMiraStudentRuntimeEvents=()=>null;`,
+      '@/lib/quiz/runtime': `export const createQuizAttemptWriter=()=>({});export const loadQuizAttemptState=async()=>({attemptId:'fixture'});export class QuizRetryProgressedError extends Error {}`,
+      '@/lib/quiz/view-state': `export const createQuizViewLifetime=()=>({});export const isQuizRuntimeReady=()=>true;export const persistQuizReview=async()=>{};export const persistQuizRetry=async()=>{};export const persistQuizSubmission=async()=>{};export const quizViewStateFromAttempt=()=>({});export const runQuizPersistenceTransition=async()=>{};`,
+      '@/lib/utils/model-config': `export const getCurrentModelConfig=()=>({});`,
+      '@/components/audio/speech-button': `export const SpeechButton=()=>null;`,
+    };
+    const bundle = await build({
+      stdin: {
+        resolveDir: process.cwd(),
+        loader: 'tsx',
+        contents: `
+import React,{useState} from 'react';import {createRoot} from 'react-dom/client';
+import {FixedTextbookQuiz} from './components/scene-renderers/fixed-textbook-quiz';
+import {SingleChoiceQuestion} from './components/scene-renderers/quiz-view';
+import {beginQuestionNarrationScene,releaseQuestionNarrationScene} from './lib/mira/lecture-audio';
+import styles from './components/scene-renderers/picture-quiz-layout.module.css';
+const image=(color,w=400,h=300)=>'data:image/svg+xml,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="'+w+'" height="'+h+'"><rect width="100%" height="100%" fill="'+color+'"/><path d="M0 100H400M0 300H400M0 500H400M0 700H400" stroke="black" stroke-width="4"/></svg>');
+const base=window.fixtureQuestion||{id:'q',type:'single',question:'看图，听老师说，再选一张。',visual:{kind:'image',src:image('#d9e8dc',400,800),alt:'reference'},options:['A','B','C'].map(value=>({value,label:value})),optionVisuals:Object.fromEntries(['A','B','C'].map((value,i)=>[value,{kind:'image',src:image(['#7cad98','#e0b183','#8fafd0'][i]),alt:value}]))};
+window.posts=[];window.fetch=async(_url,init)=>{if(init?.method==='POST')window.posts.push(JSON.parse(init.body));return{ok:true,json:async()=>({ok:true})}};
+const root=createRoot(document.querySelector('#app'));let generation=0;
+function Fixture({fixed}){const [value,setValue]=useState();const [q,setQ]=useState(()=>({...base,...(window.referenceTestAudio?{questionAudioUrl:'/api/classroom-media/fixture/audio/q.wav'}:{questionAudioUrl:undefined})}));window.changeReferenceSource=()=>setQ(old=>({...old,visual:{...old.visual,src:image('#c7d4e1',400,700)}}));return <><button id="fullscreen" type="button" onClick={()=>document.querySelector('#classroom').requestFullscreen()}>全屏</button><div className="fixture-lesson">{fixed?<FixedTextbookQuiz questions={[q]}/>:<div className={styles.root} data-quiz-phase="answering"><SingleChoiceQuestion question={q} index={0} value={value} onChange={setValue}/></div>}</div><output id="selection">{value||''}</output></>}
+window.mountReferenceQuiz=(fixed)=>{beginQuestionNarrationScene('quiz');releaseQuestionNarrationScene('quiz');root.render(<Fixture key={++generation} fixed={fixed}/>)};window.unmountReferenceQuiz=()=>root.render(null);
+const params=new URLSearchParams(location.search);const classroom=document.querySelector('#classroom');for(const name of ['w','h']){const n=Number(params.get(name));if(n>=280&&n<=1600)classroom.style[name==='w'?'width':'height']=n+'px'}window.mountReferenceQuiz(params.get('fixed')!=='0');`,
+      },
+      bundle: true,
+      write: false,
+      outfile: 'reference-test.js',
+      format: 'iife',
+      platform: 'browser',
+      logLevel: 'silent',
+      define: { 'process.env.NODE_ENV': '"test"' },
+      plugins: [
+        {
+          name: 'fixture-integrations',
+          setup(b: BuildHooks) {
+            b.onResolve({ filter: /^@\// }, (a) =>
+              mocks[a.path] ? { path: a.path, namespace: 'mock' } : undefined,
+            );
+            b.onLoad({ filter: /.*/, namespace: 'mock' }, (a) => ({
+              contents: mocks[a.path],
+              loader: 'js',
+            }));
+          },
+        },
+      ],
+    });
+    const tw = require('tailwindcss');
+    const compiled = await tw.compile(
+      readFileSync(join(dirname(require.resolve('tailwindcss/package.json')), 'index.css'), 'utf8'),
+    );
+    const source =
+      ['fixed-textbook-quiz', 'quiz-view', 'quiz-picture', 'quiz-reference-picture']
+        .map((f) => readFileSync(`components/scene-renderers/${f}.tsx`, 'utf8'))
+        .join('\n') + readFileSync('components/audio/question-narration.tsx', 'utf8');
+    const css =
+      compiled.build([
+        ...new Set(source.split(/[\s'"`{}(),]+/)),
+        'sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.5fr)]',
+      ]) +
+      '\n' +
+      bundle.outputFiles.find((f: BundleFile) => f.path.endsWith('.css')).text +
+      '\nhtml,body{margin:0;width:100%;height:100%}#classroom{width:100%;height:100%;background:white;overflow:auto}#classroom:fullscreen{width:100%!important;height:100%!important}.fixture-lesson{height:calc(100% - 48px)}#app{height:100%}#fullscreen{height:48px;min-width:48px}';
+    const js = bundle.outputFiles.find((f: BundleFile) => f.path.endsWith('.js')).text;
+    const html = '<html><body><main id="classroom"><div id="app"></div></main></body></html>';
+    // Optional operator fixture uses original local bytes; never calls a provider or a server API.
+    if (process.env.MIRA_FORMAL_QA_EXPORT_DIR) {
+      let question: unknown = null;
+      if (process.env.MIRA_QUIZ_REFERENCE_SCENE) {
+        const scene = JSON.parse(readFileSync(process.env.MIRA_QUIZ_REFERENCE_SCENE, 'utf8'));
+        question = scene.content.questions[0];
+        const embed = (value: unknown): unknown => {
+          if (Array.isArray(value)) return value.map(embed);
+          if (value && typeof value === 'object')
+            return Object.fromEntries(
+              Object.entries(value).map(([key, item]) => [
+                key,
+                key === 'src' &&
+                typeof item === 'string' &&
+                item.startsWith('/api/classroom-media/')
+                  ? 'data:image/png;base64,' +
+                    readFileSync(
+                      join('data/classrooms', item.slice('/api/classroom-media/'.length)),
+                    ).toString('base64')
+                  : embed(item),
+              ]),
+            );
+          return value;
+        };
+        question = embed(question);
+      }
+      mkdirSync(process.env.MIRA_FORMAL_QA_EXPORT_DIR, { recursive: true });
+      writeFileSync(
+        join(process.env.MIRA_FORMAL_QA_EXPORT_DIR, 'index.html'),
+        html
+          .replace(
+            '<body>',
+            `<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>题干原图组件检查（非正式课堂音频）</title><style>${css}</style></head><body>`,
+          )
+          .replace(
+            '</body>',
+            () =>
+              `<script>window.fixtureQuestion=${JSON.stringify(question)};</script><script>${js.replaceAll('</script', '<\\/script')}</script></body>`,
+          ),
+      );
+    }
+    const browser = await chromium.launch({
+      executablePath:
+        process.env.MIRA_FORMAL_QA_BROWSER_PATH ||
+        '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
+      headless: true,
+    });
+    try {
+      const page = await browser.newPage({ viewport: { width: 390, height: 563 } });
+      const errors: string[] = [];
+      page.on('pageerror', (error) => errors.push(error.message));
+      await page.route('**/*', (route) => route.abort());
+      await page.setContent(html);
+      await page.addStyleTag({ content: css });
+      await page.evaluate(() => {
+        const win = window as unknown as FixtureWindow;
+        win.audioStats = { created: 0, plays: 0, pauses: 0 };
+        win.shortcutCalls = 0;
+        Object.assign(window, { referenceTestAudio: true });
+        window.addEventListener('keydown', () => {
+          win.shortcutCalls++;
+        });
+        class FakeAudio extends EventTarget {
+          paused = true;
+          ended = false;
+          currentTime = 0;
+          src = '';
+          constructor() {
+            super();
+            win.audioStats.created++;
+          }
+          play() {
+            this.paused = false;
+            win.audioStats.plays++;
+            return Promise.resolve();
+          }
+          pause() {
+            if (!this.paused) {
+              this.paused = true;
+              win.audioStats.pauses++;
+              this.dispatchEvent(new Event('pause'));
+            }
+          }
+          removeAttribute() {}
+        }
+        Object.assign(window, { Audio: FakeAudio });
+      });
+      await page.addScriptTag({ content: js });
+      for (const fixed of [false, true]) {
+        await page.evaluate(
+          (value) => (window as unknown as FixtureWindow).mountReferenceQuiz(value),
