diff --git a/components/scene-renderers/quiz-reference-picture.tsx b/components/scene-renderers/quiz-reference-picture.tsx
new file mode 100644
--- /dev/null
+++ b/components/scene-renderers/quiz-reference-picture.tsx
@@ -0,0 +1,174 @@
+'use client';
+
+import { useEffect, useId, useLayoutEffect, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { X, ZoomIn, ZoomOut } from 'lucide-react';
+import type { QuizVisual } from '@openmaic/dsl';
+import { QuizPicture } from './quiz-picture';
+import styles from './quiz-reference-picture.module.css';
+
+/** Reference pictures alone can expand; this component never owns an answer or audio. */
+export function QuizReferencePicture({ visual }: { visual: QuizVisual }) {
+  const trigger = useRef<HTMLButtonElement>(null);
+  const [host, setHost] = useState<Element | null>(null);
+  const [open, setOpen] = useState(false);
+  const openedSource = useRef<string | null>(null);
+
+  useEffect(() => {
+    if (!open) return;
+    const sync = () => {
+      const doc = trigger.current?.ownerDocument;
+      if (doc) setHost(doc.fullscreenElement ?? doc.body);
+    };
+    sync();
+    const doc = trigger.current?.ownerDocument;
+    doc?.addEventListener('fullscreenchange', sync);
+    return () => doc?.removeEventListener('fullscreenchange', sync);
+  }, [open]);
+
+  // A new question must not retain the previous question's enlarged picture.
+  useEffect(() => {
+    if (open && (visual.kind !== 'image' || visual.src !== openedSource.current)) setOpen(false);
+  }, [open, visual]);
+
+  if (visual.kind !== 'image') return <QuizPicture visual={visual} scene />;
+  const close = () => {
+    setOpen(false);
+    trigger.current?.focus({ preventScroll: true });
+  };
+  return (
+    <span className={styles.reference} data-quiz-reference-picture>
+      <span className={styles.preview}>
+        <QuizPicture visual={visual} scene />
+      </span>
+      <button
+        type="button"
+        ref={trigger}
+        className={styles.control}
+        aria-label="放大题干图片"
+        title="看大图"
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        onKeyDown={(event) => event.stopPropagation()}
+        onClick={() => {
+          openedSource.current = visual.src;
+          const doc = trigger.current!.ownerDocument;
+          setHost(doc.fullscreenElement ?? doc.body);
+          setOpen(true);
+        }}
+      >
+        <ZoomIn size={18} aria-hidden />
+      </button>
+      {open &&
+        host &&
+        createPortal(<ReferenceDialog src={visual.src} alt={visual.alt} onClose={close} />, host)}
+    </span>
+  );
+}
+
+function ReferenceDialog({ src, alt, onClose }: { src: string; alt: string; onClose: () => void }) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  const viewport = useRef<HTMLDivElement>(null);
+  const closeButton = useRef<HTMLButtonElement>(null);
+  const title = useId();
+  const [width, setWidth] = useState(320);
+  const [zoom, setZoom] = useState(1);
+  const [failed, setFailed] = useState(false);
+
+  useLayoutEffect(() => {
+    const node = dialog.current!;
+    node.showModal();
+    closeButton.current?.focus();
+    const measure = () => setWidth(Math.max(1, viewport.current!.clientWidth - 16));
+    measure();
+    const observer = new ResizeObserver(measure);
+    observer.observe(viewport.current!);
+    return () => {
+      observer.disconnect();
+      node.close();
+    };
+  }, []);
+
+  const close = () => {
+    dialog.current?.close();
+    onClose();
+  };
+  return (
+    <dialog
+      ref={dialog}
+      className={styles.dialog}
+      aria-labelledby={title}
+      data-quiz-reference-dialog
+      onCancel={(event) => {
+        event.preventDefault();
+        close();
+      }}
+      onKeyDown={(event) => {
+        // PlaybackChrome owns window shortcuts. A picture viewer must not change the lesson.
+        event.stopPropagation();
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          close();
+        }
+      }}
+    >
+      <header className={styles.toolbar}>
+        <h2 id={title}>看大图</h2>
+        <div className={styles.zoomControls}>
+          <button
+            type="button"
+            className={styles.control}
+            aria-label="缩小图片"
+            disabled={zoom <= 1}
+            onClick={() => setZoom((value) => Math.max(1, value - 0.5))}
+          >
+            <ZoomOut size={18} aria-hidden />
+          </button>
+          <output aria-live="polite">{Math.round(zoom * 100)}%</output>
+          <button
+            type="button"
+            className={styles.control}
+            aria-label="放大图片"
+            disabled={zoom >= 4}
+            onClick={() => setZoom((value) => Math.min(4, value + 0.5))}
+          >
+            <ZoomIn size={18} aria-hidden />
+          </button>
+        </div>
+        <button
+          type="button"
+          ref={closeButton}
+          className={styles.control}
+          aria-label="关闭大图"
+          title="关闭大图"
+          onClick={close}
+        >
+          <X size={18} aria-hidden />
+        </button>
+      </header>
+      <div
+        ref={viewport}
+        className={styles.viewport}
+        tabIndex={0}
+        role="region"
+        aria-label="大图，可滚动查看"
+      >
+        {failed ? (
+          <p role="alert">图片暂时没有打开，请关闭后重试。</p>
+        ) : (
+          <div className={styles.surface} style={{ width: width * zoom }}>
+            {/* Keep the exact original media URL; no derived picture or provider call. */}
+            {/* eslint-disable-next-line @next/next/no-img-element */}
+            <img
+              src={src}
+              alt={alt}
+              className={styles.fullImage}
+              draggable={false}
+              onError={() => setFailed(true)}
+            />
+          </div>
+        )}
+      </div>
+    </dialog>
+  );
+}
