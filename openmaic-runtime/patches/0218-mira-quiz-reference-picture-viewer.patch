+.reference {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  min-height: 48px;
+}
+
+.reference > .control {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  z-index: 1;
+}
+
+.preview {
+  display: block;
+  flex: 1 1 0%;
+  min-width: 0;
+  height: 100%;
+}
+
+.preview > span {
+  height: 100%;
+}
+
+.control {
+  display: inline-flex;
+  flex: 0 0 48px;
+  align-items: center;
+  justify-content: center;
+  width: 48px;
+  height: 48px;
+  min-width: 48px;
+  min-height: 48px;
+  padding: 0;
+  border: 1px solid #597469;
+  border-radius: 10px;
+  background: #fff;
+  color: #254b3b;
+  cursor: pointer;
+  touch-action: manipulation;
+}
+
+.control > svg {
+  width: 18px;
+  height: 18px;
+  flex: none;
+}
+.control:hover:not(:disabled) {
+  background: #edf4ef;
+}
+.control:focus-visible,
+.viewport:focus-visible {
+  outline: 3px solid #31775a;
+  outline-offset: 2px;
+}
+.control:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+
+/* Portalled outside question descendants, and showModal enters the top layer. */
+.dialog {
+  position: fixed;
+  inset: 0;
+  width: min(1100px, calc(100vw - 16px));
+  height: calc(100dvh - 16px);
+  max-width: none;
+  max-height: none;
+  box-sizing: border-box;
+  margin: auto;
+  padding: 0;
+  border: 2px solid #597469;
+  border-radius: 12px;
+  background: #f7faf8;
+  color: #254b3b;
+  overflow: hidden;
+}
+
+.dialog[open] {
+  display: flex;
+  flex-direction: column;
+}
+.dialog::backdrop {
+  background: rgb(15 30 23 / 60%);
+}
+.toolbar {
+  display: flex;
+  flex: 0 0 auto;
+  align-items: center;
+  justify-content: space-between;
+  gap: 4px;
+  padding: 6px;
+  border-bottom: 1px solid #b9c9bf;
+  background: #fff;
+}
+.toolbar h2 {
+  margin: 0;
+  font-size: 16px;
+  font-weight: 600;
+  white-space: nowrap;
+}
+.zoomControls {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+.zoomControls output {
+  min-width: 42px;
+  font-size: 14px;
+  text-align: center;
+}
+.viewport {
+  flex: 1 1 0%;
+  min-height: 0;
+  min-width: 0;
+  padding: 8px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  touch-action: pan-x pan-y pinch-zoom;
+}
+.surface {
+  min-width: 100%;
+  margin: 0 auto;
+}
+.fullImage {
+  display: block;
+  width: 100%;
+  height: auto;
+  max-width: none;
+  max-height: none;
+  object-fit: contain;
+}
