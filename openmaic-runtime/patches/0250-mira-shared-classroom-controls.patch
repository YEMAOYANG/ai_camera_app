diff --git a/lib/ui/classroom-controls.ts b/lib/ui/classroom-controls.ts
new file mode 100644
--- /dev/null
+++ b/lib/ui/classroom-controls.ts
@@ -0,0 +1,133 @@
+/** One presentation contract for native classroom utilities and isolated games.
+ * Picture answers, draggable objects and visibility remain author-owned. */
+export function classroomControlCss(target: 'native' | 'iframe' = 'native'): string {
+  const utility =
+    ':is(.tools, #tools) > button:is(#start, #replay, #again, #finish, #reset, #restart, #retry, #listen, #hint)';
+  const control =
+    target === 'iframe'
+      ? `:is(${utility}, button[data-mira-activity-control]):not([data-mira-picture-choice]):not([draggable="true"])`
+      : '[data-mira-control][data-mira-control]';
+  const primary =
+    target === 'iframe'
+      ? `${control}:is(#start, #finish, [data-mira-activity-control="primary"])`
+      : `${control}[data-mira-control="primary"]`;
+  const toolbar = `${control}[data-mira-control="toolbar"]`;
+  // Iframe CSS precedes authored rules. Override normal inline dimensions,
+  // without changing display, visibility, pointer events or authored content.
+  const p = target === 'iframe' ? ' !important' : '';
+  return `
+:root {
+  --mira-classroom-secondary-size: 48px;
+  --mira-classroom-primary-size: 48px;
+  --mira-classroom-toolbar-size: 48px;
+  --mira-control-surface: var(--mira-orbit-panel, #fffbf3);
+  --mira-control-hover: var(--mira-orbit-raised, #f2eadb);
+  --mira-control-line: var(--mira-orbit-line, #ded4c2);
+  --mira-control-ink: var(--mira-orbit-text, #303b38);
+  --mira-control-muted: var(--mira-orbit-muted, #6d726b);
+  --mira-control-accent: var(--mira-orbit-lime, #f3c65b);
+  --mira-control-active: var(--mira-orbit-cyan, #786747);
+  --mira-control-danger: #9b3f32;
+  --mira-control-danger-surface: #fff0e9;
+}
+${control} {
+  --mira-control-size: var(--mira-classroom-secondary-size)${p};
+  --mira-control-icon: 18px${p};
+  --mira-control-font: 14px${p};
+  box-sizing: border-box${p};
+  flex-shrink: 0${p};
+  align-items: center${p};
+  justify-content: center${p};
+  gap: 6px${p};
+  width: auto${p};
+  min-width: var(--mira-control-size)${p};
+  height: var(--mira-control-size)${p};
+  min-height: var(--mira-control-size)${p};
+  padding: 6px 10px${p};
+  border: 1px solid var(--mira-control-line)${p};
+  border-radius: 8px${p};
+  background: var(--mira-control-surface)${p};
+  color: var(--mira-control-ink)${p};
+  box-shadow: none${p};
+  font-family: inherit${p};
+  font-size: var(--mira-control-font)${p};
+  font-weight: 500${p};
+  line-height: 20px${p};
+  text-decoration: none${p};
+  cursor: pointer${p};
+  touch-action: manipulation${p};
+  transition: background-color 150ms, border-color 150ms${p};
+}
+${control} > svg {
+  flex: 0 0 var(--mira-control-icon)${p};
+  width: var(--mira-control-icon)${p};
+  height: var(--mira-control-icon)${p};
+  max-width: var(--mira-control-icon)${p};
+  max-height: var(--mira-control-icon)${p};
+  vertical-align: middle${p};
+}
+${control} > span {
+  margin: 0${p};
+  font-size: inherit${p};
+  font-weight: inherit${p};
+  line-height: inherit${p};
+}
+${control} [data-mira-indicator="whiteboard-content"],
+${control} [data-mira-indicator="discussion-active"] {
+  width: 6px${p};
+  height: 6px${p};
+  min-width: 6px${p};
+  min-height: 6px${p};
+  flex: 0 0 6px${p};
+  border-radius: 50%${p};
+}
+${control} [data-mira-indicator="whiteboard-content"] { background: var(--mira-control-accent)${p}; }
+${control} [data-mira-indicator="discussion-active"] { background: var(--mira-control-danger)${p}; }
+${control}[data-mira-control-icon] {
+  width: var(--mira-control-size)${p};
+  padding: 0${p};
+}
+${toolbar} {
+  --mira-control-size: var(--mira-classroom-toolbar-size)${p};
+  --mira-control-icon: 16px${p};
+  --mira-control-font: 12px${p};
+  border-color: transparent${p};
+  background: transparent${p};
+  color: var(--mira-control-muted)${p};
+  padding-inline: 6px${p};
+}
+${primary} {
+  --mira-control-size: var(--mira-classroom-primary-size)${p};
+  border-color: var(--mira-control-accent)${p};
+  background: var(--mira-control-accent)${p};
+  color: var(--mira-control-ink)${p};
+  padding-inline: 14px${p};
+}
+${control}:hover:not(:disabled) { background: var(--mira-control-hover)${p}; }
+${primary}:hover:not(:disabled) { background: var(--mira-control-accent)${p}; }
+${toolbar}[aria-pressed="true"], ${toolbar}[data-mira-control-active="true"] {
+  color: var(--mira-control-active)${p};
+  background: var(--mira-control-hover)${p};
+}
+${control}[data-mira-control-tone="danger"] { color: var(--mira-control-danger)${p}; background: var(--mira-control-danger-surface)${p}; }
+${control}:disabled { opacity: .4${p}; cursor: default${p}; }
+${control}:focus-visible { outline: 2px solid var(--mira-control-active)${p}; outline-offset: 2px${p}; }
+@media (hover: hover) and (pointer: fine) {
+  :root {
+    --mira-classroom-secondary-size: 36px;
+    --mira-classroom-primary-size: 40px;
+    --mira-classroom-toolbar-size: 30px;
+  }
+}
+@media (any-pointer: coarse) {
+  :root {
+    --mira-classroom-secondary-size: 48px;
+    --mira-classroom-primary-size: 48px;
+    --mira-classroom-toolbar-size: 48px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  ${control} { transition: none${p}; }
+}
+`;
+}
