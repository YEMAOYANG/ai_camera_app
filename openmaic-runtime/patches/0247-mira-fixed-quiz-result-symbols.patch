+/** Result marks exist only after the server grades this question. */
+export function fixedTextbookOptionResult(value: string, feedback?: Graded): OptionResult | undefined {
+  if (!feedback) return undefined;
+  if (value === feedback.response) return feedback.correct ? 'correct' : 'incorrect';
+  return value === feedback.correctAnswer ? 'correct' : undefined;
+}
