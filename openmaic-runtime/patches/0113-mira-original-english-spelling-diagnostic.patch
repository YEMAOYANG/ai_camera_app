+  it('uses the original WAV once with an independent profile and no language or text hints', async () => {
+    const request = {...identity, requestId: `${asrId}.diagnostic1`, ttsRequestId: ttsId, audioSha256: originalTts.audioSha256!};
+    const result = await executeMiraEnglishSpellingAsrDiagnostic(request, 'c'.repeat(64));
+    expect(result.record.state).toBe('succeeded');
+    const body = JSON.parse(fetchMock.mock.calls[0][1].body);
+    expect(body).toEqual({model: 'qwen3-asr-flash', input: {messages: [{role: 'user', content: [
+      {audio: `data:audio/wav;base64,${oldWav.toString('base64')}`},
+    ]}]}, parameters: {asr_options: {}}});
+    expect(result.record.providerDiagnostic).toEqual({policyVersion: MIRA_ENGLISH_SPELLING_ASR_DIAGNOSTIC_POLICY,
+      sourceEvidenceSha256: 'c'.repeat(64), providerBodySha256: qualitySha(body)});
+    expect((await executeMiraEnglishSpellingAsrDiagnostic(request, 'c'.repeat(64))).created).toBe(false);
