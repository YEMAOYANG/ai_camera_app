+/** Separate operator lane for an original WAV with audited English spelling.
+ * No repair child is synthesized and the repair1 diagnostic contract is unchanged. */
+export async function executeMiraEnglishSpellingAsrDiagnostic(
+  value: unknown,
+  sourceEvidenceSha256: string,
+  dependencies: RuntimeDependencies = {},
+): Promise<{ record: MiraFormalAsrJob; created: boolean; transcript?: string }> {
+  const input = assertMiraFormalAsrRequest(value);
+  if (input.subject !== 'english' || !SHA256.test(sourceEvidenceSha256) ||
+      !/^formal_asr_[a-f0-9]{48}\.diagnostic1$/.test(input.requestId) ||
+      input.ttsRequestId !== input.requestId.replace(/^formal_asr_/, 'formal_tts_').replace(/\.diagnostic1$/, ''))
+    throw new MiraFormalAudioError('invalid_request', 'Invalid English spelling diagnostic identity');
+  return executeFormalAsr(input, dependencies,
+    {policyVersion: MIRA_ENGLISH_SPELLING_ASR_DIAGNOSTIC_POLICY, sourceEvidenceSha256});
+}
