diff --git a/tests/server/mira-formal-playful-3d-policy.test.ts b/tests/server/mira-formal-playful-3d-policy.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-playful-3d-policy.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it } from 'vitest';
+import type { Scene } from '@/lib/types/stage';
+import { MIRA_FORMAL_PLAYFUL_POLICY, MIRA_FORMAL_PLAYFUL_3D_POLICY,
+  formalPlayfulContext, formalPlayfulContextFromPrompt, formalPlayfulSceneInstructions,
+  formalPlayfulReviewInstructions, withMiraFormalPlayfulInstructions,
+  assertMiraFormalPlayfulScenes } from '@/lib/server/mira-formal-playful-policy';
+import { MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY, MIRA_PLAYFUL_3D_PROFESSIONAL_CREATION_POLICY,
+  isExactMiraProfessionalCreationPolicy } from '@/lib/server/mira-formal-generation-policy';
+
+const spec = { course: { subject: 'english' }, guided: [{ id: 'g1' }, { id: 'g2' }],
+  independent: [{ id: 'i1' }, { id: 'i2' }] } as Parameters<typeof formalPlayfulContext>[1];
+const old = formalPlayfulContext(MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY, spec)!;
+const current = formalPlayfulContext(MIRA_PLAYFUL_3D_PROFESSIONAL_CREATION_POLICY, spec)!;
+const prompt = '- Use between one and four quiz scenes. Distribute the four locked assessment questions across them in original order so every locked question appears exactly once.';
+const game = { id: 'game', order: 1, type: 'interactive', content: { type: 'interactive', widgetType: 'game',
+  widgetConfig: { type: 'game', gameType: 'puzzle', scoring: { correctPoints: 0 } } } } as Scene;
+const threeD = { id: '3d', order: 0, type: 'interactive', content: { type: 'interactive', widgetType: 'visualization3d',
+  widgetConfig: { type: 'visualization3d' } } } as Scene;
+const quizzes = [old.guidedQuestionIds, old.independentQuestionIds].map((ids, index) => ({
+  id: `quiz-${index}`, order: index + 2, type: 'quiz', content: { type: 'quiz', questions: ids.map(id => ({ id })) },
+})) as Scene[];
+
+describe('explicit language 3D and game opt-in', () => {
+  it('recognises exact v2 while preserving frozen v1', () => {
+    expect(old.policy).toEqual(MIRA_FORMAL_PLAYFUL_POLICY);
+    expect(current.policy).toEqual(MIRA_FORMAL_PLAYFUL_3D_POLICY);
+    expect(isExactMiraProfessionalCreationPolicy(MIRA_PLAYFUL_3D_PROFESSIONAL_CREATION_POLICY)).toBe(true);
+    expect(isExactMiraProfessionalCreationPolicy({ ...MIRA_PLAYFUL_PROFESSIONAL_CREATION_POLICY,
+      playfulLearningPolicy: { ...MIRA_FORMAL_PLAYFUL_POLICY, threeDUsage: 'required' } })).toBe(false);
+  });
+  it('threads 3D authority through frozen main, isolated pages and independent review', () => {
+    const frozen = withMiraFormalPlayfulInstructions(prompt, current);
+    expect(formalPlayfulContextFromPrompt(frozen)).toEqual(current);
+    const instructions = [frozen, formalPlayfulReviewInstructions(current),
+      ...(['content', 'actions'] as const).map(phase => formalPlayfulSceneInstructions(current, { sceneType: 'interactive', phase }))];
+    for (const text of instructions) {
+      expect(text).toContain('BOTH a separate interactive visualization3d page and a separate interactive game page');
+      expect(text).toContain('Independent review must reject');
+      expect(text).not.toMatch(/language does not require 3D|Language does not require 3D|no compulsory\s+3D/);
+    }
+    expect(withMiraFormalPlayfulInstructions(prompt, old)).not.toContain('EXPLICIT 3D AND GAME REQUIREMENTS v2');
+  });
+  it('requires both distinct page kinds but never treats structure as proof of semantics', () => {
+    expect(() => assertMiraFormalPlayfulScenes([game, ...quizzes], old)).not.toThrow();
+    expect(() => assertMiraFormalPlayfulScenes([game, ...quizzes], current)).toThrow('THREE_D_MISSING');
+    expect(() => assertMiraFormalPlayfulScenes([threeD, ...quizzes], current)).toThrow('GAME_MISSING');
+    expect(() => assertMiraFormalPlayfulScenes([threeD, game, ...quizzes], current)).not.toThrow();
+    const mislabeled = structuredClone(threeD);
+    if (mislabeled.content.type === 'interactive') mislabeled.content.widgetConfig = { type: 'game' } as never;
+    expect(() => assertMiraFormalPlayfulScenes([mislabeled, game, ...quizzes], current)).toThrow('THREE_D_MISSING');
+  });
+});
