new file mode 100644
--- /dev/null
+++ b/lib/mira/student-teaching-navigation.ts
@@ -0,0 +1,18 @@
+import type { Scene } from '@/lib/types/stage';
+
+/** A later page cannot hide an unfinished required teaching discussion. */
+export function firstUnfinishedTeachingScene(
+  scenes: readonly Scene[],
+  targetSceneId: string,
+  isCompleted: (sceneId: string) => boolean,
+): Scene | undefined {
+  const ordered = [...scenes].sort((left, right) => left.order - right.order);
+  const targetIndex = ordered.findIndex((scene) => scene.id === targetSceneId);
+  if (targetIndex < 0) return undefined;
+  return ordered
+    .slice(0, targetIndex)
+    .find(
+      (scene) =>
+        scene.actions?.some((action) => action.type === 'discussion') && !isCompleted(scene.id),
+    );
+}
