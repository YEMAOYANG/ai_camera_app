diff --git a/lib/mira/interactive-audio-controls.ts b/lib/mira/interactive-audio-controls.ts
new file mode 100644
--- /dev/null
+++ b/lib/mira/interactive-audio-controls.ts
@@ -0,0 +1,206 @@
+import { getPageNarration, registerPageNarration } from './page-narration';
+import type { PageNarrationPhase } from './page-narration';
+
+/** An explicit parent-toolbar request, not a fabricated pointer/key event.
+ * Checkpoint profiles may listen to this to release their restore-only quiet
+ * flag. It never begins an activity or changes saved learning evidence. */
+export const INTERACTIVE_AUDIO_EXPLICIT_PLAY_EVENT = 'mira:interactive-audio-explicit-play';
+
+// Observed in reviewed course sources. Deliberately exclude generic "重播",
+// "重播当前顺序", help, demonstrations, start and reset: those may move objects
+// or give help. An ambiguous pair of matching controls is also unsupported.
+const REPLAY_LABELS = [
+  '重听当前提示', '再听一次老师的话', '重听任务', '重播当前语音',
+  '重听提示', '重听当前讲解', '重播老师提示', '重听口令', '再听任务',
+  '重听当前题目', '重听当前读题', '重听题目', '重听描红提示', '重听指令',
+  '重听当前页提示', '重听当前一句', '重听当前任务', '重听这回练习的方法',
+  '重播语音', '重播当前提示', '重播任务说明', '重播当前指导',
+  '重播任务语音', '重听任务说明', '再听当前任务', '再听老师的话',
+  '重播提示', '重播当前任务说明', '重听观察任务',
+] as const;
+
+/** Inject before authored scripts. Inert without the existing prerecorded
+ * helper and its finite cue manifest. The host separately requires a reviewed
+ * exact cue binding; iframe claims never establish that binding themselves. */
+export const INTERACTIVE_AUDIO_CONTROL_SHIM = `<script data-mira-interactive-audio-controls>
+(function () {
+  var type = 'MIRA_INTERACTIVE_AUDIO_CONTROL', stateType = 'MIRA_INTERACTIVE_AUDIO_STATE';
+  var labels = new Set(${JSON.stringify(REPLAY_LABELS)});
+  var channel = null, visible = false, cueId = null, phase = 'idle', timer = null;
+  function exact(value, keys) {
+    return value && typeof value === 'object' && !Array.isArray(value)
+      && Object.keys(value).length === keys.length && keys.every(function (key) { return Object.prototype.hasOwnProperty.call(value, key); });
+  }
+  function cues() {
+    var helpers = document.querySelectorAll('script[id="mira-pre-recorded-audio"]');
+    var manifests = document.querySelectorAll('script[id="mira-narration-cues"]');
+    if (helpers.length !== 1 || helpers[0].hasAttribute('src') || manifests.length !== 1
+        || manifests[0].getAttribute('type') !== 'application/json') return null;
+    try {
+      var value = JSON.parse(manifests[0].textContent);
+      if (value.schemaVersion !== 'mira.interactive.narration-cues.v1' || !Array.isArray(value.cues)
+          || !value.cues.length || value.cues.length > 120) return null;
+      var ids = value.cues.map(function (cue) { return cue && cue.id; });
+      if (ids.some(function (id) { return typeof id !== 'string' || !/^[\\w-]{1,128}$/.test(id); })
+          || new Set(ids).size !== ids.length) return null;
+      return new Set(ids);
+    } catch (_) { return null; }
+  }
+  function replay() {
+    if (!cues()) return null;
+    var matches = Array.from(document.querySelectorAll('button')).filter(function (button) {
+      // Prefer an explicit accessible label. Text fallback is also exact and
+      // audio-specific, never an id/name/substring or a guessed game action.
+      var label = (button.getAttribute('aria-label') || button.textContent || '').trim();
+      if (!labels.has(label) || button.disabled || button.closest('[hidden],[aria-hidden="true"]')) return false;
+      for (var node = button; node && node.nodeType === 1; node = node.parentElement) {
+        var style = window.getComputedStyle(node);
+        if (style.display === 'none' || style.visibility === 'hidden' || style.visibility === 'collapse') return false;
+      }
+      return true;
+    });
+    return matches.length === 1 ? matches[0] : null;
+  }
+  function emit() {
+    if (!channel || !cues()) return;
+    window.parent.postMessage({ type: stateType, channel: channel, cueId: cueId,
+      status: phase, hasReplay: !!replay() }, '*');
+  }
+  function clearPending() { if (timer !== null) clearTimeout(timer); timer = null; }
+  window.addEventListener('mira-narration-state', function (event) {
+    var detail = event && event.detail, known = cues();
+    if (!detail || !known) return;
+    if (detail.status === 'hidden') {
+      clearPending(); phase = 'paused';
+      if (known.has(detail.cueId)) cueId = detail.cueId;
+      emit(); return;
+    }
+    if (!known.has(detail.cueId)) return;
+    if (detail.status === 'playing') {
+      if (!visible || document.hidden) return;
+      clearPending(); cueId = detail.cueId; phase = 'playing';
+    } else if (detail.status === 'ready' && detail.cueId === cueId) {
+      clearPending(); phase = 'ended';
+    } else if (['error', 'missing', 'cancelled'].includes(detail.status)) {
+      clearPending(); cueId = detail.cueId; phase = 'paused';
+    } else return;
+    emit();
+  });
+  window.addEventListener('message', function (event) {
+    if (event.source !== window.parent) return;
+    var data = event.data;
+    if (exact(data, ['type', 'visible']) && data.type === 'MIRA_NARRATION_VISIBILITY'
+        && typeof data.visible === 'boolean') {
+      visible = data.visible;
+      if (!visible) { clearPending(); phase = 'paused'; }
+      emit(); return;
+    }
+    if (!exact(data, ['type', 'command', 'channel']) || data.type !== type
+        || typeof data.channel !== 'string' || !/^[\\w-]{8,128}$/.test(data.channel)) return;
+    if (data.command === 'connect') { channel = data.channel; emit(); return; }
+    if (data.channel !== channel) return;
+    if (data.command === 'disconnect') { clearPending(); channel = null; return; }
+    if (data.command === 'inspect') { emit(); return; }
+    if (data.command === 'pause') { clearPending(); phase = 'paused'; emit(); return; }
+    if (data.command !== 'play' || !visible || document.hidden) return;
+    var button = replay();
+    if (!button) { phase = 'paused'; emit(); return; }
+    clearPending(); phase = 'pending'; emit();
+    window.dispatchEvent(new CustomEvent('${INTERACTIVE_AUDIO_EXPLICIT_PLAY_EVENT}'));
+    // Use the authored handler so its cue queue and completion gate resume
+    // together. No fake trusted input or direct call to a detached audio clip.
+    button.click();
+    if (phase === 'pending') timer = setTimeout(function () {
+      timer = null; if (phase === 'pending') { phase = 'paused'; emit(); }
+    }, 2000);
+  });
+  window.addEventListener('load', emit);
+  document.addEventListener('visibilitychange', function () {
+    if (document.hidden) { clearPending(); phase = 'paused'; emit(); }
+  });
+})();
+</script>`;
+
+type StateMessage = {
+  type: 'MIRA_INTERACTIVE_AUDIO_STATE';
+  channel: string;
+  cueId: string | null;
+  status: PageNarrationPhase;
+  hasReplay: boolean;
+};
+
+function readState(value: unknown, channel: string, isBoundCue: (cueId: string) => boolean): StateMessage | null {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
+  const state = value as StateMessage;
+  if (Object.keys(state).length !== 5 || !['type', 'channel', 'cueId', 'status', 'hasReplay'].every(key => Object.hasOwn(state, key))
+      || state.type !== 'MIRA_INTERACTIVE_AUDIO_STATE' || state.channel !== channel
+      || typeof state.hasReplay !== 'boolean'
+      || !['idle', 'pending', 'playing', 'paused', 'ended'].includes(state.status)) return null;
+  if (state.cueId === null) {
+    if (!['idle', 'pending', 'paused'].includes(state.status)) return null;
+  } else if (typeof state.cueId !== 'string' || !isBoundCue(state.cueId)) return null;
+  return state;
+}
+
+export interface InteractiveAudioControlsOptions {
+  frame: HTMLIFrameElement;
+  /** Must include active scene identity, visibility and checkpoint readiness. */
+  active: () => boolean;
+  /** Exact reviewed text/audio binding from the parent-owned scene. */
+  isBoundCue: (cueId: string) => boolean;
+  /** The lecture/discussion keeps its sound channel until it finishes. */
+  canControl?: () => boolean;
+}
+
+/** Connect only for a reviewed, currently shown page with managed speech.
+ * A connection advertises controls but never plays on mount/restore/re-entry. */
+export function connectInteractiveAudioControls({ frame, active, isBoundCue,
+  canControl = () => true }: InteractiveAudioControlsOptions): () => void {
+  let disposed = false;
+  let channel = crypto.randomUUID();
+  let hasReplay = false;
+  let phase: PageNarrationPhase = 'idle';
+  const post = (command: string) => frame.contentWindow?.postMessage(
+    { type: 'MIRA_INTERACTIVE_AUDIO_CONTROL', command, channel }, '*',
+  );
+  const visibility = (visible: boolean) => frame.contentWindow?.postMessage(
+    { type: 'MIRA_NARRATION_VISIBILITY', visible }, '*',
+  );
+  const canAct = () => !disposed && active() && canControl();
+  const registration = registerPageNarration({
+    ready: () => canAct() && (hasReplay || phase === 'playing' || phase === 'pending'),
+    play: () => {
+      if (!canAct() || !hasReplay) return;
+      phase = 'pending'; registration.phase(phase);
+      visibility(true); post('play');
+    },
+    pause: () => {
+      if (disposed || !active()) return;
+      phase = 'paused'; registration.phase(phase);
+      visibility(false); post('pause');
+    },
+  });
+  const receive = (event: MessageEvent) => {
+    if (!canAct() || event.source !== frame.contentWindow) return;
+    const state = readState(event.data, channel, isBoundCue);
+    if (!state) return;
+    if (getPageNarration().paused && (state.status === 'playing' || state.status === 'pending')) return;
+    hasReplay = state.hasReplay; phase = state.status;
+    registration.phase(phase);
+  };
+  const connect = () => {
+    // A frame reload replaces its program. Late messages from that earlier
+    // document cannot change the current toolbar, even with the same Window.
+    channel = crypto.randomUUID(); hasReplay = false; phase = 'idle';
+    registration.phase(phase); post('connect');
+  };
+  window.addEventListener('message', receive);
+  frame.addEventListener('load', connect);
+  connect();
+  return () => {
+    if (disposed) return;
+    disposed = true; post('disconnect'); registration.dispose();
+    window.removeEventListener('message', receive);
+    frame.removeEventListener('load', connect);
+  };
+}
