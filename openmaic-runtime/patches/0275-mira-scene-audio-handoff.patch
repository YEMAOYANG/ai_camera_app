+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { connectInteractiveAudioControls, INTERACTIVE_AUDIO_CONTROL_SHIM,
+  INTERACTIVE_AUDIO_EXPLICIT_PLAY_EVENT } from '@/lib/mira/interactive-audio-controls';
+import { getPageNarration, releasePageNarrationPause, togglePageNarration } from '@/lib/mira/page-narration';
+
+const channel = 'test-audio-channel';
+const helper = '<script id="mira-pre-recorded-audio">const clips={};let active=null;</script>';
+const manifest = '<script id="mira-narration-cues" type="application/json">'
+  + '{"schemaVersion":"mira.interactive.narration-cues.v1","cues":[{"id":"task","text":"数数小船"},{"id":"feedback","text":"再看看"}]}</script>';
+
+function shim(markup: string, withHelper = true) {
+  document.body.innerHTML = (withHelper ? helper + manifest : '') + markup;
+  const handlers = new Map<string, Array<(event: any) => void>>();
+  const parent = { postMessage: vi.fn() };
+  const win = {
+    parent,
+    addEventListener(type: string, listener: (event: any) => void) {
+      handlers.set(type, [...(handlers.get(type) ?? []), listener]);
+    },
+    dispatchEvent(event: Event) {
+      for (const handler of handlers.get(event.type) ?? []) handler(event);
+      return true;
+    },
+    getComputedStyle: window.getComputedStyle.bind(window),
+  };
+  const code = INTERACTIVE_AUDIO_CONTROL_SHIM.match(/<script[^>]*>([\s\S]*)<\/script>/)![1];
+  new Function('window', 'document', 'CustomEvent', 'setTimeout', 'clearTimeout', code)(
+    win, document, CustomEvent, setTimeout, clearTimeout,
+  );
+  const send = (data: unknown, source: unknown = parent) => {
+    for (const listener of handlers.get('message') ?? []) listener({ source, data });
+  };
+  const command = (command: string, extra = {}) => send({ type: 'MIRA_INTERACTIVE_AUDIO_CONTROL', command, channel, ...extra });
+  const visibility = (visible: boolean) => send({ type: 'MIRA_NARRATION_VISIBILITY', visible });
+  const narration = (cueId: string | null, status: string) => win.dispatchEvent(
+    new CustomEvent('mira-narration-state', { detail: { cueId, status } }),
+  );
+  command('connect');
+  return { parent, win, send, command, visibility, narration,
+    latest: () => parent.postMessage.mock.calls.at(-1)?.[0] };
+}
+
+beforeEach(() => {
+  releasePageNarrationPause();
+  vi.spyOn(document, 'hidden', 'get').mockReturnValue(false);
+});
+afterEach(() => {
+  document.body.replaceChildren(); vi.restoreAllMocks(); vi.useRealTimers(); releasePageNarrationPause();
+});
+
+describe('reviewed iframe audio control shim', () => {
+  it('uses the original explicit audio replay handler, preserving domain state and real cue completion', () => {
+    const p = shim('<button aria-label="再听一次老师的话">听老师</button>');
+    const world = { answer: 3, completed: false };
+    let gateReady = false, replayCount = 0;
+    const explicitPlay = vi.fn();
+    p.win.addEventListener(INTERACTIVE_AUDIO_EXPLICIT_PLAY_EVENT, explicitPlay);
+    const button = document.querySelector('button')!;
+    button.onclick = event => {
+      expect(event.isTrusted).toBe(false); // No fabricated trusted user gesture.
+      replayCount += 1; gateReady = false; p.narration('task', 'playing');
+    };
+    p.win.addEventListener('mira-narration-state', event => {
+      if (event.detail.cueId === 'task' && event.detail.status === 'ready') gateReady = true;
+    });
+    expect(p.latest()).toMatchObject({ hasReplay: true, status: 'idle' });
+    expect(replayCount).toBe(0); // Mount/inspection never starts a completed or restored page.
+    p.visibility(true); p.command('play');
+    expect(replayCount).toBe(1); expect(explicitPlay).toHaveBeenCalledTimes(1);
+    expect(p.latest()).toMatchObject({ cueId: 'task', status: 'playing' });
+    expect(world).toEqual({ answer: 3, completed: false }); expect(gateReady).toBe(false);
+    p.narration('task', 'ready');
+    expect(gateReady).toBe(true); expect(p.latest().status).toBe('ended');
+    p.command('inspect'); expect(replayCount).toBe(1);
+  });
+
+  it('rejects foreign messages, extra fields, wrong channels, and hidden-page play', () => {
+    const p = shim('<button aria-label="重听当前提示">听</button>');
+    const replay = vi.fn(); document.querySelector('button')!.onclick = replay;
+    p.command('play');
+    p.visibility(true);
+    p.send({ type: 'MIRA_INTERACTIVE_AUDIO_CONTROL', command: 'play', channel }, {});
+    p.command('play', { text: 'untrusted' });
+    p.command('play', { channel: 'stale-audio-channel' });
+    vi.spyOn(document, 'hidden', 'get').mockReturnValue(true); p.command('play');
+    expect(replay).not.toHaveBeenCalled();
+    vi.spyOn(document, 'hidden', 'get').mockReturnValue(false);
+    p.visibility(false); p.command('play'); expect(replay).not.toHaveBeenCalled();
+    p.visibility(true); p.command('play'); expect(replay).toHaveBeenCalledTimes(1);
+    p.command('disconnect'); p.command('play'); expect(replay).toHaveBeenCalledTimes(1);
+  });
+
+  it('never guesses game replay, reset, help, demonstration, start, or ambiguous audio controls', () => {
+    for (const label of ['重播', '重播当前顺序', '重置', '开始游戏', '帮助', '重听并看当前字的笔顺示范']) {
+      const p = shim(`<button aria-label="${label}">${label}</button>`);
+      const action = vi.fn(); document.querySelector('button')!.onclick = action;
+      p.visibility(true); p.command('play');
+      expect(p.latest().hasReplay).toBe(false); expect(action).not.toHaveBeenCalled();
+      p.command('disconnect');
+    }
+    const p = shim('<button aria-label="重听当前提示">A</button><button aria-label="重听任务">B</button>');
+    p.visibility(true); p.command('play'); expect(p.latest().hasReplay).toBe(false);
+  });
+
+  it('ignores hidden/disabled alternatives and stays inert without the prerecorded helper', () => {
+    const p = shim('<button hidden aria-label="重听任务">隐藏</button>'
+      + '<button disabled aria-label="重听任务">禁用</button>'
+      + '<div style="display:none"><button aria-label="重听任务">隐藏祖先</button></div>'
+      + '<button id="current">重听任务</button>');
+    expect(p.latest().hasReplay).toBe(true);
+    const action = vi.fn(); document.getElementById('current')!.onclick = action;
+    p.visibility(true); p.command('play'); expect(action).toHaveBeenCalledTimes(1);
+    p.command('disconnect');
+    const inert = shim('<button aria-label="重听任务">听</button>', false);
+    const forbidden = vi.fn(); document.querySelector('button')!.onclick = forbidden;
+    inert.visibility(true); inert.command('play');
+    expect(inert.parent.postMessage).not.toHaveBeenCalled(); expect(forbidden).not.toHaveBeenCalled();
+  });
+
+  it('does not misreport an unrelated ended cue and bounds an unresponsive replay handler', () => {
+    vi.useFakeTimers();
+    const p = shim('<button aria-label="重播当前语音">听</button>');
+    p.visibility(true); p.narration('task', 'playing');
+    p.narration('feedback', 'ready'); expect(p.latest().status).toBe('playing');
+    p.command('play'); expect(p.latest().status).toBe('pending');
+    vi.advanceTimersByTime(2000); expect(p.latest().status).toBe('paused');
+    p.narration('task', 'playing'); expect(p.latest().status).toBe('playing');
+    p.visibility(false); expect(p.latest().status).toBe('paused');
+    p.narration('task', 'playing'); expect(p.latest().status).toBe('paused');
+  });
+});
+
+describe('parent audio toolbar connector', () => {
+  function setup() {
+    const frame = document.createElement('iframe'); document.body.append(frame);
+    const post = vi.spyOn(frame.contentWindow!, 'postMessage').mockImplementation(() => {});
+    let active = true, allowed = true;
+    const dispose = connectInteractiveAudioControls({ frame, active: () => active,
+      canControl: () => allowed, isBoundCue: cue => cue === 'task' });
+    const currentChannel = () => post.mock.calls.filter(([data]) => data.command === 'connect').at(-1)![0].channel;
+    const receive = (overrides: Record<string, unknown> = {}, source: Window | null = frame.contentWindow) => {
+      window.dispatchEvent(new MessageEvent('message', { source, data: {
+        type: 'MIRA_INTERACTIVE_AUDIO_STATE', channel: currentChannel(), cueId: 'task',
+        status: 'ended', hasReplay: true, ...overrides,
+      } }));
+    };
+    return { frame, post, dispose, receive, currentChannel,
+      hide: () => { active = false; }, block: () => { allowed = false; } };
+  }
+
+  it('advertises without autoplay and delegates toolbar play/pause to the currently bound frame', () => {
+    const p = setup();
+    try {
+      expect(p.post.mock.calls.map(([data]) => data.command)).toEqual(['connect']);
+      expect(togglePageNarration()).toBe(false);
+      p.receive(); expect(getPageNarration().phase).toBe('ended');
+      expect(togglePageNarration()).toBe(true);
+      expect(p.post.mock.calls.slice(-2).map(([data]) => data)).toEqual([
+        { type: 'MIRA_NARRATION_VISIBILITY', visible: true },
+        { type: 'MIRA_INTERACTIVE_AUDIO_CONTROL', command: 'play', channel: p.currentChannel() },
+      ]);
+      p.receive({ status: 'playing' }); expect(getPageNarration().phase).toBe('playing');
+      expect(togglePageNarration()).toBe(true);
+      expect(p.post.mock.calls.slice(-2).map(([data]) => data)).toEqual([
+        { type: 'MIRA_NARRATION_VISIBILITY', visible: false },
+        { type: 'MIRA_INTERACTIVE_AUDIO_CONTROL', command: 'pause', channel: p.currentChannel() },
+      ]);
+      p.receive({ status: 'playing' }); expect(getPageNarration().phase).toBe('paused');
+    } finally { p.dispose(); }
+  });
+
+  it('rejects foreign frames, unknown cues, extra payloads, hidden pages and late document callbacks', () => {
+    const p = setup();
+    try {
+      p.receive({ status: 'playing' }, window);
+      p.receive({ status: 'playing', cueId: 'unbound' });
+      p.receive({ status: 'playing', cueId: null });
+      p.receive({ status: 'playing', text: 'forged caption' });
+      expect(getPageNarration().phase).toBe('idle');
+      p.receive({ status: 'playing' }); expect(getPageNarration().phase).toBe('playing');
+      const old = p.currentChannel(); p.frame.dispatchEvent(new Event('load'));
+      expect(p.currentChannel()).not.toBe(old); expect(getPageNarration().phase).toBe('idle');
+      p.receive({ status: 'playing', channel: old }); expect(getPageNarration().phase).toBe('idle');
+      p.hide(); p.receive({ status: 'playing' }); expect(getPageNarration().phase).toBe('idle');
+      expect(togglePageNarration()).toBe(false);
+    } finally { p.dispose(); }
+    p.receive({ status: 'playing' }); expect(getPageNarration().registered).toBe(false);
+  });
+
+  it('does not take the lecture or discussion sound channel', () => {
+    const p = setup();
+    try {
+      p.receive(); p.block(); expect(togglePageNarration()).toBe(false);
+      p.receive({ status: 'playing' }); expect(getPageNarration().phase).toBe('ended');
+    } finally { p.dispose(); }
+  });
+});
