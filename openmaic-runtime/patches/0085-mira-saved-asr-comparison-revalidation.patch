+import { createHash } from 'node:crypto';
+import { describe, expect, it, vi } from 'vitest';
+import { buildAsrComparisonRevalidation } from '@/lib/server/mira-formal-asr-revalidation';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+import { miraFormalAsrSimilarityBps, prepareMiraFormalAsrComparisonText } from '@/lib/server/mira-formal-audio-lifecycle';
+import type { MiraFormalAsrJob, MiraFormalTtsJob } from '@/lib/server/mira-formal-audio';
+
+const sha = (value: string | Uint8Array) => createHash('sha256').update(value).digest('hex');
+function fixture() {
+  const audio = new Uint8Array([82, 73, 70, 70, 8]);
+  const timestamp = '2026-09-10T09:00:00.000Z';
+  const spokenText = '要解决的问题就是3/5的阅读组有多少人。';
+  const transcript = '要解决的问题就是五分之三的阅读组有多少人。';
+  const common = {
+    schemaVersion: 'mira.openmaic.formal-audio-job.v1' as const,
+    classroomId: 'stage-test', classroomContentSha256: 'd'.repeat(64), subject: 'math' as const,
+    teacherProfileId: 'mira_math_clear', teacherProfileVersion: 2, teacherProfileSha256: 'e'.repeat(64),
+    teacherGender: 'male' as const, sceneId: 'scene-test', sceneOrder: 2,
+    actionId: 'action-test', narrationSegmentId: 'narration-test',
+    state: 'succeeded' as const, fallbackUsed: false as const, languageCode: 'zh-CN',
+    audioSha256: sha(audio), createdAt: timestamp, updatedAt: timestamp,
+    completedAt: timestamp, providerAttemptedAt: timestamp, providerCompletedAt: timestamp,
+  };
+  const ttsRecord: MiraFormalTtsJob = {...common, kind: 'tts', requestId: 'formal_tts_test',
+    requestSha256: 'f'.repeat(64), textSha256: sha(spokenText), providerId: 'qwen-tts',
+    modelId: 'qwen3-tts-flash', voiceId: 'Ethan', voiceGender: 'male',
+    assetId: 'mirawav_test', assetFileName: 'mirawav_test.wav', mimeType: 'audio/wav', sizeBytes: audio.length};
+  const asrRecord: MiraFormalAsrJob = {...common, kind: 'asr', requestId: 'formal_asr_test',
+    requestSha256: 'a'.repeat(64), ttsRequestId: ttsRecord.requestId, providerId: 'qwen-asr',
+    modelId: 'qwen3-asr-flash', transcriptSha256: sha(transcript),
+    normalizedTranscriptSha256: 'b'.repeat(64), similarityBps: 8000};
+  return { binding: {sessionId: `miraformal_${'c'.repeat(64)}`, stageId: common.classroomId,
+    snapshotSha256: '1'.repeat(64), sourceJobSha256: '2'.repeat(64), asrRequestId: asrRecord.requestId},
+    original: {asrRecord, ttsRecord, spokenText, audio,
+      transcriptArchive: {requestId: asrRecord.requestId, audioSha256: sha(audio), transcript, transcriptSha256: sha(transcript)}},
+    timestamp };
+}
+
+describe('saved ASR comparator revalidation', () => {
+  it('replays original evidence without provider calls or replacing the rejected record', () => {
+    const network = vi.spyOn(globalThis, 'fetch').mockRejectedValue(new Error('no provider'));
+    try {
+      const {binding, original, timestamp} = fixture();
+      const originalSha = qualitySha(original);
