diff --git a/lib/server/mira-formal-asr-revalidation.ts b/lib/server/mira-formal-asr-revalidation.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-asr-revalidation.ts
@@ -0,0 +1,103 @@
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import type { Scene, Stage } from '@/lib/types/stage';
+import { qualitySha, qualitySnapshot } from './mira-formal-quality-contract';
+import { readMiraFormalAsrJob, readMiraFormalTtsAsset, readMiraFormalTtsJob,
+  type MiraFormalAsrJob, type MiraFormalTtsJob } from './mira-formal-audio';
+import { MIRA_FORMAL_ASR_COMPARISON_POLICY_VERSION, miraFormalAudioClassroomContentSha256, prepareMiraFormalSpeechText,
+  prepareMiraFormalAsrComparisonText, normalizeMiraFormalAsrText, miraFormalAsrSimilarityBps } from './mira-formal-audio-lifecycle';
+
+export type AsrComparisonBinding = {
+  sessionId: string; stageId: string; snapshotSha256: string; sourceJobSha256: string; asrRequestId: string;
+};
+export type AsrComparisonReference = AsrComparisonBinding & { receiptSha256: string };
+type TranscriptArchive = { requestId: string; audioSha256: string; transcript: string; transcriptSha256: string };
+type OriginalSources = { asrRecord: MiraFormalAsrJob; ttsRecord: MiraFormalTtsJob;
+  transcriptArchive: TranscriptArchive; spokenText: string; audio: Uint8Array };
+const sha = (value: string | Uint8Array) => createHash('sha256').update(value).digest('hex');
+const HASH = /^[a-f0-9]{64}$/;
+const identityKeys = ['classroomId','classroomContentSha256','subject','teacherProfileId',
+  'teacherProfileVersion','teacherProfileSha256','teacherGender','sceneId','sceneOrder','actionId','narrationSegmentId'] as const;
+function fail(): never { throw new Error('SAVED_ASR_COMPARISON_SOURCE_INVALID'); }
+const audioRoot = () => process.env.MIRA_FORMAL_AUDIO_DATA_DIR || path.join(process.cwd(),'data/formal-audio');
+
+/** Pure replay of existing evidence. It never substitutes a new transcript or audio. */
+export function buildAsrComparisonRevalidation(binding: AsrComparisonBinding, original: OriginalSources,
+  comparatorSourceSha256: string, createdAt: string) {
+  const {asrRecord:asr,ttsRecord:tts,transcriptArchive:archive,spokenText,audio} = original;
+  if (!/^miraformal_[a-f0-9]{64}$/.test(binding.sessionId) ||
+    !/^[A-Za-z0-9_-]+$/.test(binding.stageId) ||
+    ![binding.snapshotSha256,binding.sourceJobSha256,comparatorSourceSha256].every(value=>HASH.test(value)) ||
+    !Number.isFinite(Date.parse(createdAt)) || asr.requestId !== binding.asrRequestId ||
+    asr.classroomId !== binding.stageId || asr.subject !== 'math' || asr.kind !== 'asr' ||
+    asr.state !== 'succeeded' || tts.state !== 'succeeded' || tts.kind !== 'tts' ||
+    asr.providerId !== 'qwen-asr' || asr.modelId !== 'qwen3-asr-flash' || asr.fallbackUsed !== false ||
+    tts.providerId !== 'qwen-tts' || tts.modelId !== 'qwen3-tts-flash' || tts.fallbackUsed !== false ||
+    'operatorRepair' in asr || 'operatorRepair' in tts ||
+    !Number.isSafeInteger(asr.similarityBps) || asr.similarityBps! < 0 || asr.similarityBps! >= 8500 ||
+    !HASH.test(asr.normalizedTranscriptSha256 ?? '') || asr.ttsRequestId !== tts.requestId ||
+    identityKeys.some(key=>asr[key] !== tts[key]) ||
+    tts.textSha256 !== sha(spokenText) || tts.audioSha256 !== asr.audioSha256 ||
+    audio.byteLength !== tts.sizeBytes || sha(audio) !== asr.audioSha256 ||
+    archive.requestId !== asr.requestId || archive.audioSha256 !== asr.audioSha256 ||
+    typeof archive.transcript !== 'string' || archive.transcript.length > 64_000 ||
+    sha(archive.transcript) !== archive.transcriptSha256 || archive.transcriptSha256 !== asr.transcriptSha256)
+    fail();
+  const expected = prepareMiraFormalAsrComparisonText(spokenText, 'math');
+  const actual = prepareMiraFormalAsrComparisonText(archive.transcript, 'math');
+  const similarityBps = miraFormalAsrSimilarityBps(expected, actual);
+  if (similarityBps < 8500) throw new Error('SAVED_ASR_COMPARISON_STILL_REJECTED');
+  const receipt = {schemaVersion:'mira.openmaic.asr-comparison-revalidation.v1' as const, binding,
+    source:{asrRecord:asr,ttsRecord:tts,transcriptArchive:archive,spokenText,
+      asrRecordSha256:qualitySha(asr),ttsRecordSha256:qualitySha(tts),transcriptArchiveSha256:qualitySha(archive)},
+    comparison:{policyVersion:MIRA_FORMAL_ASR_COMPARISON_POLICY_VERSION,sourceSha256:comparatorSourceSha256,
+      normalizedTranscriptSha256:sha(normalizeMiraFormalAsrText(actual)),similarityBps},createdAt};
+  return {...receipt,receiptSha256:qualitySha(receipt)};
+}
+export type AsrComparisonRevalidation = ReturnType<typeof buildAsrComparisonRevalidation>;
+type Context = {binding:AsrComparisonBinding;stage:Stage;scenes:Scene[]};
+async function sourceAndPath(input: Context) {
+  const {binding,stage,scenes} = input;
+  if (binding.stageId !== stage.id || qualitySha(qualitySnapshot(stage,scenes)) !== binding.snapshotSha256) fail();
+  const asr = await readMiraFormalAsrJob(binding.asrRequestId);
+  if (!asr || asr.classroomContentSha256 !== miraFormalAudioClassroomContentSha256(stage,scenes)) fail();
+  const scene = scenes.find(scene=>scene.id===asr.sceneId);
+  const action = scene?.actions?.find(action=>action.id===asr.actionId);
+  if (!action || action.type !== 'speech') fail();
+  const tts = await readMiraFormalTtsJob(asr.ttsRequestId);
+  if (!tts) fail();
+  const asset = await readMiraFormalTtsAsset(tts.requestId);
+  if (qualitySha(asset.record) !== qualitySha(tts)) fail();
+  const transcriptArchive = JSON.parse(await fs.readFile(path.join(audioRoot(),'transcripts',`${sha(asr.requestId)}.json`),'utf8')) as TranscriptArchive;
+  const sourceSha256 = sha(await fs.readFile(path.join(process.cwd(),'lib/server/mira-formal-audio-lifecycle.ts')));
+  const file = path.join(audioRoot(),'comparison-revalidations',sha(asr.requestId),
+    `${binding.snapshotSha256}-${sourceSha256}.json`);
+  return {file,sourceSha256,original:{asrRecord:asr,ttsRecord:tts,transcriptArchive,
+    spokenText:prepareMiraFormalSpeechText(action.text.trim(),asr.subject),audio:asset.bytes}};
+}
+export async function revalidateSavedAsrComparison(input: Context): Promise<AsrComparisonRevalidation> {
+  const {file,sourceSha256,original} = await sourceAndPath(input);
+  let prior: AsrComparisonRevalidation | undefined;
+  try { prior=JSON.parse(await fs.readFile(file,'utf8')); }
+  catch(error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
+  const receipt=buildAsrComparisonRevalidation(input.binding,original,sourceSha256,prior?.createdAt ?? new Date().toISOString());
+  if (prior) {
+    if (qualitySha(prior) !== qualitySha(receipt)) throw new Error('SAVED_ASR_COMPARISON_AUDIT_CHANGED');
+    return receipt;
+  }
+  await fs.mkdir(path.dirname(file),{recursive:true,mode:0o700});
+  const handle=await fs.open(file,'wx',0o600);
+  try { await handle.writeFile(JSON.stringify(receipt,null,2)+'\n');await handle.sync(); }
+  finally { await handle.close(); }
+  return receipt;
+}
+export async function readValidatedAsrComparison(input: Omit<Context,'binding'> & {reference:AsrComparisonReference}) {
+  const {receiptSha256,...binding}=input.reference;
+  const {file,sourceSha256,original}=await sourceAndPath({...input,binding});
+  const saved=JSON.parse(await fs.readFile(file,'utf8')) as AsrComparisonRevalidation;
+  const replay=buildAsrComparisonRevalidation(binding,original,sourceSha256,saved.createdAt);
+  if (!HASH.test(receiptSha256) || replay.receiptSha256 !== receiptSha256 || qualitySha(saved) !== qualitySha(replay))
+    throw new Error('SAVED_ASR_COMPARISON_AUDIT_CHANGED');
+  return replay;
+}
