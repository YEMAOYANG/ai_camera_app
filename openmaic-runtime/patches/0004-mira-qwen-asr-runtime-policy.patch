+import { NextRequest } from 'next/server';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({
+  transcribeAudio: vi.fn(),
+  resolveASRApiKey: vi.fn(() => 'server-secret-never-return'),
+  resolveASRBaseUrl: vi.fn(() => 'https://server-owned.invalid/api/v1'),
+}));
+
+vi.mock('@/lib/audio/asr-providers', () => ({ transcribeAudio: mocks.transcribeAudio }));
+vi.mock('@/lib/server/provider-config', () => ({
+  getServerASRProviders: () => ({ 'qwen-asr': {} }),
+  isServerConfiguredProvider: () => true,
+  resolveASRApiKey: mocks.resolveASRApiKey,
+  resolveASRBaseUrl: mocks.resolveASRBaseUrl,
+}));
+
+function request(extra: Record<string, string> = {}): NextRequest {
+  const form = new FormData();
+  form.set('audio', new File(['audio'], 'student.webm', { type: 'audio/webm' }));
+  form.set('language', 'zh');
+  for (const [key, value] of Object.entries(extra)) form.set(key, value);
+  return new NextRequest('http://localhost/api/transcription', {
+    method: 'POST',
+    headers: { 'x-mira-runtime-session': 'runtime-session-1' },
+    body: form,
+  });
+}
+
+describe('Mira runtime transcription', () => {
+  beforeEach(() => {
+    process.env.MIRA_OPENMAIC_REQUIRE_QWEN_ASR = '1';
+    process.env.MIRA_OPENMAIC_QWEN_ASR_MODEL = 'qwen3-asr-flash';
+    mocks.transcribeAudio.mockReset().mockResolvedValue({ text: '我想到了二十' });
+  });
+
+  afterEach(() => {
+    delete process.env.MIRA_OPENMAIC_REQUIRE_QWEN_ASR;
+    delete process.env.MIRA_OPENMAIC_QWEN_ASR_MODEL;
+  });
+
+  it('uses only the fixed server-owned Qwen ASR configuration', async () => {
+    const { POST } = await import('@/app/api/transcription/route');
+    const response = await POST(request());
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(body.text).toBe('我想到了二十');
+    expect(mocks.transcribeAudio).toHaveBeenCalledOnce();
+    expect(mocks.transcribeAudio.mock.calls[0][0]).toEqual({
+      providerId: 'qwen-asr',
+      modelId: 'qwen3-asr-flash',
+      language: 'zh',
+      apiKey: 'server-secret-never-return',
+      baseUrl: 'https://server-owned.invalid/api/v1',
+    });
+    expect(JSON.stringify(body)).not.toContain('server-secret-never-return');
+    expect(JSON.stringify(body)).not.toContain('server-owned.invalid');
+  });
+
+  it.each([
+    ['providerId', 'browser-native'],
+    ['modelId', 'attacker-model'],
+    ['apiKey', 'attacker-key'],
+    ['baseUrl', 'https://attacker.invalid'],
+  ])('rejects client-owned %s before any provider call', async (field, value) => {
+    const { POST } = await import('@/app/api/transcription/route');
+    const response = await POST(request({ [field]: value }));
+    const body = await response.json();
+
+    expect(response.status).toBe(400);
+    expect(body.error).toBe('Mira runtime ASR provider configuration is server-owned');
+    expect(mocks.transcribeAudio).not.toHaveBeenCalled();
+    expect(JSON.stringify(body)).not.toContain(value);
+  });
+
+  it('does not expose provider errors or secrets to the response', async () => {
+    mocks.transcribeAudio.mockRejectedValueOnce(
+      new Error('upstream failed with server-secret-never-return'),
+    );
+    const { POST } = await import('@/app/api/transcription/route');
+    const response = await POST(request());
+    const serialized = JSON.stringify(await response.json());
+
+    expect(response.status).toBe(500);
+    expect(serialized).not.toContain('server-secret-never-return');
+    expect(serialized).not.toContain('server-owned.invalid');
+  });
+});
