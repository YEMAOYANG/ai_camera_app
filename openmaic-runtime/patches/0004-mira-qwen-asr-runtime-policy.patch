+import { describe, expect, it } from 'vitest';
+import {
+  isMiraRuntimeSearch,
+  resolveClientAsrProvider,
+  shouldUseBrowserNativeAsr,
+} from '@/lib/hooks/use-audio-recorder';
+
+describe('Mira runtime ASR client selection', () => {
+  it('recognizes only the explicit Mira classroom launch marker', () => {
+    expect(isMiraRuntimeSearch('?mira=1')).toBe(true);
+    expect(isMiraRuntimeSearch('?foo=bar&mira=1')).toBe(true);
+    expect(isMiraRuntimeSearch('')).toBe(false);
+    expect(isMiraRuntimeSearch('?mira=0')).toBe(false);
+  });
+
+  it('forces server Qwen and disables the browser-native path in Mira classrooms', () => {
+    expect(resolveClientAsrProvider('?mira=1', 'browser-native')).toBe('qwen-asr');
+    expect(shouldUseBrowserNativeAsr('?mira=1', 'browser-native')).toBe(false);
+    expect(resolveClientAsrProvider('', 'browser-native')).toBe('browser-native');
+    expect(shouldUseBrowserNativeAsr('', 'browser-native')).toBe(true);
+  });
+});
