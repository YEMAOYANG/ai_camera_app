@@ -0,0 +1,45 @@
+import { ASR_PROVIDERS } from '@/lib/audio/constants';
+
+export const MIRA_QWEN_ASR_PROVIDER_ID = 'qwen-asr' as const;
+export const MIRA_QWEN_ASR_MODEL_ID = 'qwen3-asr-flash' as const;
+
+export interface MiraAsrPolicy {
+  enforced: true;
+  providerId: typeof MIRA_QWEN_ASR_PROVIDER_ID;
+  modelId: typeof MIRA_QWEN_ASR_MODEL_ID;
+  fallbackAllowed: false;
+}
+
+export function getMiraAsrPolicy(
+  env: Readonly<Record<string, string | undefined>> = process.env,
+): MiraAsrPolicy {
+  if (env.MIRA_OPENMAIC_REQUIRE_QWEN_ASR !== '1') {
+    throw new Error('MIRA_OPENMAIC_REQUIRE_QWEN_ASR must be exactly 1');
+  }
+  const modelId = env.MIRA_OPENMAIC_QWEN_ASR_MODEL || MIRA_QWEN_ASR_MODEL_ID;
+  const registered = ASR_PROVIDERS[MIRA_QWEN_ASR_PROVIDER_ID].models.some(
+    (model) => model.id === modelId,
+  );
+  if (modelId !== MIRA_QWEN_ASR_MODEL_ID || !registered) {
+    throw new Error('Unsupported deterministic Qwen3-ASR model');
+  }
+  return {
+    enforced: true,
+    providerId: MIRA_QWEN_ASR_PROVIDER_ID,
+    modelId: MIRA_QWEN_ASR_MODEL_ID,
+    fallbackAllowed: false,
+  };
+}
+
+export function assertMiraAsrProviderReady(
+  policy: MiraAsrPolicy,
+  providers: Record<string, Record<string, never>>,
+): void {
+  if (!providers[policy.providerId]) {
+    throw new Error('Deterministic Qwen3-ASR is required but qwen-asr is not server-configured');
+  }
+}
+
+export function isMiraRuntimeRequest(headers: Headers): boolean {
+  return Boolean(headers.get('x-mira-runtime-session'));
+}
