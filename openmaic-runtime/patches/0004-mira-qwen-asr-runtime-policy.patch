+import { afterEach, describe, expect, it } from 'vitest';
+import {
+  assertMiraAsrProviderReady,
+  getMiraAsrPolicy,
+  isMiraRuntimeRequest,
+} from '@/lib/server/mira-asr-policy';
+
+describe('Mira deterministic Qwen ASR policy', () => {
+  afterEach(() => {
+    delete process.env.MIRA_OPENMAIC_REQUIRE_QWEN_ASR;
+    delete process.env.MIRA_OPENMAIC_QWEN_ASR_MODEL;
+  });
+
+  it('attests the only accepted server-owned provider and model', () => {
+    expect(
+      getMiraAsrPolicy({
+        MIRA_OPENMAIC_REQUIRE_QWEN_ASR: '1',
+        MIRA_OPENMAIC_QWEN_ASR_MODEL: 'qwen3-asr-flash',
+      }),
+    ).toEqual({
+      enforced: true,
+      providerId: 'qwen-asr',
+      modelId: 'qwen3-asr-flash',
+      fallbackAllowed: false,
+    });
+  });
+
+  it('fails closed for missing flags, other models, or a missing server provider', () => {
+    expect(() => getMiraAsrPolicy({})).toThrow('must be exactly 1');
+    expect(() =>
+      getMiraAsrPolicy({
+        MIRA_OPENMAIC_REQUIRE_QWEN_ASR: '1',
+        MIRA_OPENMAIC_QWEN_ASR_MODEL: 'other-model',
+      }),
+    ).toThrow('Unsupported deterministic Qwen3-ASR model');
+    expect(() =>
+      assertMiraAsrProviderReady(getMiraAsrPolicy({ MIRA_OPENMAIC_REQUIRE_QWEN_ASR: '1' }), {}),
+    ).toThrow('qwen-asr is not server-configured');
+  });
+
+  it('recognizes only gateway-attested runtime requests', () => {
+    expect(isMiraRuntimeRequest(new Headers())).toBe(false);
+    expect(
+      isMiraRuntimeRequest(new Headers({ 'x-mira-runtime-session': 'runtime-session-1' })),
+    ).toBe(true);
+  });
+});
