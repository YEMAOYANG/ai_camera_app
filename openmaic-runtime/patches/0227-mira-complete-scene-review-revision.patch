+/** Parsed-scene fences complement the raw byte fences checked below. */
+export function inspectCompleteSceneReplacement(current: Json, original: Json, replacement: Json, revisionSceneId: string, spec: ReviewCompleteSceneReplacement, frozenContractSha256: string) {
+  check(revisionSceneId === spec.exactSceneId, 'COMPLETE_SCENE_ID');
+  check(current.id === spec.exactSceneId && original.id === spec.exactSceneId && replacement.id === spec.exactSceneId, 'COMPLETE_SCENE_ID');
+  check(frozenContractSha256 === spec.expectedFrozenContractSha256, 'COMPLETE_SCENE_CONTRACT');
+  check(textbookDigest(original) === spec.expectedOriginalSceneSha256, 'COMPLETE_SCENE_ORIGINAL');
+  check(textbookDigest(current) === spec.expectedCurrentSceneSha256, 'COMPLETE_SCENE_CURRENT');
+  check(textbookDigest(replacement) === spec.expectedReplacementSceneSha256, 'COMPLETE_SCENE_REPLACEMENT');
+  for (const field of ['stageId', 'order', 'type', 'title', 'outlineId', 'createdAt']) check(original[field] === current[field] && replacement[field] === current[field], 'COMPLETE_SCENE_IDENTITY');
+  check(validateScene(original).valid && validateScene(current).valid && validateScene(replacement).valid, 'COMPLETE_SCENE_DSL');
+  check(Array.isArray(replacement.actions) && new Set(replacement.actions.map((action: Json) => action.id)).size === replacement.actions.length, 'COMPLETE_SCENE_ACTIONS');
+  check(textbookDigest(replacement) !== textbookDigest(current) && spec.reason.trim().length > 0, 'COMPLETE_SCENE_NO_CHANGE');
+  return {
+    exactSceneId: spec.exactSceneId,
+    frozenContractSha256,
+    originalSceneSha256: textbookDigest(original),
+    currentSceneSha256: textbookDigest(current),
+    replacementSceneSha256: textbookDigest(replacement),
+    preservedIdentity: { stageId: current.stageId, order: current.order, type: current.type, title: current.title, outlineId: current.outlineId, createdAt: current.createdAt },
+    reason: spec.reason,
+  };
+}
+
+export function inspectCompleteSceneReplacementBytes(originalBytes: Buffer, replacementBytes: Buffer, spec: ReviewCompleteSceneReplacement) {
+  check(hash(originalBytes) === spec.originalSceneFileSha256 && hash(replacementBytes) === spec.replacementSceneFileSha256, 'COMPLETE_SCENE_BYTES');
+  let original: unknown, replacement: unknown;
+  try {
+    original = JSON.parse(originalBytes.toString('utf8'));
+    replacement = JSON.parse(replacementBytes.toString('utf8'));
+  } catch {
+    check(false, 'COMPLETE_SCENE_JSON');
+  }
+  check(object(original) && object(replacement), 'COMPLETE_SCENE_JSON');
+  check(textbookDigest(original) === spec.expectedOriginalSceneSha256 && textbookDigest(replacement) === spec.expectedReplacementSceneSha256, 'COMPLETE_SCENE_DIGEST');
+  check(original.id === spec.exactSceneId && replacement.id === spec.exactSceneId, 'COMPLETE_SCENE_ID');
+  return { original, replacement };
+}
