+function exactKeys(value: unknown, keys: readonly string[]): value is Record<string, unknown> {
+  return !!value && typeof value === 'object' && !Array.isArray(value)
+    && Object.keys(value).length === keys.length && keys.every(key => Object.hasOwn(value, key));
+}
+
+/** The authenticated gateway derives this before replacing media with data/blob
+ * URLs. Recheck every action binding; never infer ownership by evaluating HTML.
+ */
+function gatewayManagedSpeechIds(scene: Scene): Set<string> {
+  const none = new Set<string>();
+  const value: unknown = scene.miraPageNarration;
+  if (!exactKeys(value, ['schemaVersion', 'classroomId', 'sceneId', 'bindings'])
+      || value.schemaVersion !== 'mira.textbook.page-narration.v1'
+      || typeof value.classroomId !== 'string' || !/^tbpub_[a-f0-9]{24}$/.test(value.classroomId)
+      || value.classroomId !== scene.stageId || value.sceneId !== scene.id
+      || !Array.isArray(value.bindings) || value.bindings.length < 1 || value.bindings.length > 120) return none;
+  if (!Array.isArray(scene.actions) || scene.actions.some(action => !action || typeof action.id !== 'string')) return none;
+  const actions = new Map(scene.actions.map(action => [action.id, action]));
+  if (actions.size !== scene.actions.length) return none;
+  const ids = new Set<string>();
+  const cueIds = new Set<string>();
+  for (const binding of value.bindings) {
+    if (!exactKeys(binding, ['speechId', 'cueId', 'text', 'audioPath'])
+        || typeof binding.speechId !== 'string' || !/^[\w-]{1,128}$/.test(binding.speechId) || ids.has(binding.speechId)
+        || typeof binding.cueId !== 'string' || !/^[\w-]{1,128}$/.test(binding.cueId) || cueIds.has(binding.cueId)
+        || typeof binding.text !== 'string' || !binding.text.trim() || binding.text.length > 1000
+        || typeof binding.audioPath !== 'string'
+        || recordedPath(binding.audioPath) !== binding.audioPath
+        || !binding.audioPath.startsWith(`/api/classroom-media/${value.classroomId}/audio/`)) return none;
+    const action = actions.get(binding.speechId);
+    if (!action || action.type !== 'speech' || action.text !== binding.text
+        || recordedPath(action.audioUrl) !== binding.audioPath) return none;
+    ids.add(binding.speechId);
+    cueIds.add(binding.cueId);
+  }
+  return ids;
+}
