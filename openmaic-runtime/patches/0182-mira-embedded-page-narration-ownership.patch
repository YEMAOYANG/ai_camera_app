+function deliveredActivity(large = false, separateOpening = false): Scene {
+  const scene = activity('mp3');
+  const classroomId = 'tbpub_' + 'a'.repeat(24);
+  scene.stageId = classroomId;
+  if (scene.content.type !== 'interactive') throw new Error();
+  scene.content.html = scene.content.html!.replaceAll('/lesson/', `/${classroomId}/`);
+  for (const action of scene.actions ?? []) {
+    if (action.type === 'speech') action.audioUrl = action.audioUrl!.replace('http://127.0.0.1:3100', '').replace('/lesson/', `/${classroomId}/`);
+  }
+  const bytes = Buffer.from('verified mp3 fixture bytes');
+  const media = cues.map(c => ({ path: `/api/classroom-media/${classroomId}/audio/${c.id}.mp3`,
+    mimeType:'audio/mpeg',byteSize:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex') }));
+  const assets = media.map(m => ({path:m.path,mimeType:m.mimeType,base64:bytes.toString('base64')}));
+  if (large) {
+    const imagePath=`/api/classroom-media/${classroomId}/media/atlas.png`;
+    scene.content.html+=`<img src="${imagePath}">`.repeat(3);
+    assets.push({path:imagePath,mimeType:'image/png',base64:Buffer.alloc(1024*1024).toString('base64')});
+  }
+  if (separateOpening) scene.actions!.unshift({id:'opening',type:'speech',text:'我们来做一个小游戏。',audioId:'opening',
+    audioUrl:`/api/classroom-media/${classroomId}/audio/opening.mp3`});
+  bindTextbookPageNarration(scene,{purpose:'fixed_textbook',classroomId,media},new Set(assets.map(asset=>asset.path)));
+  scene.content.html=embedTextbookSceneMedia(scene.content.html,assets);
+  return scene;
+}
