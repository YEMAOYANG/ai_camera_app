--- /dev/null
+++ b/lib/server/mira-formal-interaction-design.ts
@@ -0,0 +1,237 @@
+import type { Scene, Stage } from '@/lib/types/stage';
+import type { FormalInteractionProbe, FormalSceneInspectionResult } from '@/lib/types/formal-scene-inspection';
+import { qualitySha, qualitySnapshot, QUALITY_VIEWPORTS, type MiraTeachingQualityReceipt } from './mira-formal-quality-contract';
+
+export const MIRA_INTERACTION_DESIGN_POLICY = {
+  schemaVersion: 'mira.openmaic.interaction-design.v1',
+  policyId: 'mira-primary-adaptive-interaction.v1',
+  enabled: true,
+  profile: 'primary-adaptive',
+  objectiveCoverageRequired: true,
+  demonstrationRequired: true,
+  learnerOperationRequired: true,
+  explanatoryFeedbackRequired: true,
+  independentJudgmentRequired: true,
+  finalSnapshotRequired: true,
+  renderedInteractionRequired: true,
+} as const;
+
+export interface InteractionDesignContext {
+  policy: typeof MIRA_INTERACTION_DESIGN_POLICY;
+  independentQuestionIds: string[];
+}
+export interface InteractionObjective {
+  objectiveIndex: number;
+  demonstration: { sceneId: string; quote: string };
+  operation: { sceneId: string; controlSelector: string; action: 'click' | 'fill' | 'range' | 'select'; value?: string };
+  feedback: { sceneId: string; selector: string; textIncludes: string; reasonQuote: string };
+  independentJudgment: { sceneId: string; questionId: string };
+}
+export interface InteractionDesignPlan {
+  schemaVersion: 'mira.openmaic.interaction-design-plan.v1';
+  objectives: InteractionObjective[];
+}
+export interface InteractionDesignReceipt {
+  schemaVersion: 'mira.openmaic.interaction-design-receipt.v1';
+  policyId: typeof MIRA_INTERACTION_DESIGN_POLICY.policyId;
+  status: 'passed'; sessionId: string; stageId: string;
+  gradeBoundarySha256: string; snapshotSha256: string; planSha256: string;
+  teachingQualityReceiptSha256: string;
+  objectives: Array<InteractionObjective & { checks: Array<{
+    viewport: { width: number; height: number }; sceneSha256: string;
+    screenshotSha256: string; domSha256: string; probeId: string;
+  }> }>;
+  receiptSha256: string;
+}
+type Obj = Record<string, unknown>;
+const object = (value: unknown): value is Obj => value !== null && typeof value === 'object' && !Array.isArray(value);
+const text = (value: unknown, min = 1, max = 500): value is string =>
+  typeof value === 'string' && value.trim().length >= min && value.length <= max;
+const exact = (value: unknown, keys: string) => object(value) && Object.keys(value).sort().join(',') === keys;
+const selector = (value: unknown): value is string => typeof value === 'string' && /^#[A-Za-z][A-Za-z0-9_-]{0,98}$/.test(value);
+const fail = (suffix: string): never => { throw new Error(`FORMAL_INTERACTION_${suffix}`); };
+const START = '\nMIRA_INTERACTION_DESIGN_CONTEXT:\n';
+const END = '\nEND_MIRA_INTERACTION_DESIGN_CONTEXT\n';
+
+export function assertInteractionDesignContext(value: unknown): asserts value is InteractionDesignContext {
+  if (!exact(value, 'independentQuestionIds,policy') || !object(value) ||
+      qualitySha(value.policy) !== qualitySha(MIRA_INTERACTION_DESIGN_POLICY) ||
+      !Array.isArray(value.independentQuestionIds) || !value.independentQuestionIds.length ||
+      value.independentQuestionIds.some(id => !text(id, 1, 128)) ||
+      new Set(value.independentQuestionIds).size !== value.independentQuestionIds.length)
+    fail('CONTEXT_INVALID');
+}
+
+/** The server appends this to NEW job prompts only. Old prompt bytes stay frozen. */
+export function interactionDesignPrompt(context: InteractionDesignContext): string {
+  assertInteractionDesignContext(context);
+  return START + JSON.stringify(context) + END + `
+Required adaptive interaction design for this formal course:
+For EVERY gradeBoundary.learningObjectives entry, teach an explicit worked demonstration,
+then let the real learner operate the taught model, show its observable result AND explain why,
+then require an independent judgment using one of the locked independentQuestionIds above.
+Use a stateful teaching model: learners change a condition or arrangement and SEE the mechanism's
+corresponding quantities, spatial relations, classification, or evidence-based interpretation change.
+Offer multiple meaningful states to explore (for example composing quantities, arranging language units,
+classifying examples, or comparing source evidence); the result must be computed from the chosen state.
+An answer choice that merely reveals prewritten praise/explanation is insufficient. Prefer a clear
+condition -> visible model/result -> explanation loop appropriate to the grade, with reset/revisit controls.
+Reuse pages when appropriate; there is no 60% interactive-page quota and no mandatory widget roster.
+Do not force 3D, sliders, or physics-like simulations onto language lessons; choose the representation
+that makes THIS learning objective observable rather than repeating one reveal-button template.
+Before review_course_quality, embed exactly one non-executable application/json script with
+id="mira-interaction-plan" in the FIRST interactive scene's HTML. JSON shape:
+{"schemaVersion":"mira.openmaic.interaction-design-plan.v1","objectives":[{"objectiveIndex":0,
+"demonstration":{"sceneId":"actual-scene-id","quote":"exact teacher speech excerpt"},
+"operation":{"sceneId":"actual-interactive-scene-id","controlSelector":"#actual-control","action":"click"},
+"feedback":{"sceneId":"same-interactive-scene-id","selector":"#separate-result","textIncludes":"observed result","reasonQuote":"explanation of why"},
+"independentJudgment":{"sceneId":"later-quiz-scene-id","questionId":"locked-independent-id"}}]}
+Use actual persisted scene IDs (read the stage and patch HTML after building if necessary).
+Cover objective indices 0..N-1 exactly once. Demonstration quote must occur in actual speech.
+Operation action is click, fill, range, or select; non-click operations require a string value.
+Selectors are simple #ids. Feedback must be a separate visible result region, not the control,
+its ancestor/descendant, or another form control. Operation must change its visible text and
+reveal BOTH textIncludes and reasonQuote. A color toggle, click counter, generic praise, or an
+answer-reveal button unrelated to the taught mechanism cannot satisfy this contract.
+The independent question must follow the operation, never use a guided/example question.
+Real browser probes and independent teaching review validate the final snapshot. The plan is
+not a claim that a real student has already performed these operations.
+`;
+}
+
+export function interactionDesignContextFromPrompt(prompt: string): InteractionDesignContext | undefined {
+  const parts = prompt.split(START);
+  if (parts.length === 1) return undefined;
+  if (parts.length !== 2 || parts[1].split(END).length !== 2) return fail('CONTEXT_INVALID');
+  const value: unknown = JSON.parse(parts[1].split(END)[0]);
+  assertInteractionDesignContext(value);
+  return value;
+}
+
+const PLAN_SCRIPT = /<script\b(?=[^>]*\bid=["']mira-interaction-plan["'])(?=[^>]*\btype=["']application\/json["'])[^>]*>([\s\S]*?)<\/script\s*>/gi;
+export function readInteractionDesignPlan(input: {
+  scenes: readonly Scene[]; gradeBoundary: Obj; interactionDesign: InteractionDesignContext;
+}): InteractionDesignPlan {
+  assertInteractionDesignContext(input.interactionDesign);
+  const ordered = [...input.scenes].sort((a, b) => a.order - b.order);
+  const firstInteractive = ordered.find(scene => scene.type === 'interactive');
+  const plans = ordered.flatMap(scene => scene.content.type === 'interactive'
+    ? [...(scene.content.html ?? '').matchAll(PLAN_SCRIPT)].map(match => ({ sceneId: scene.id, value: match[1] })) : []);
+  if (plans.length !== 1 || plans[0].sceneId !== firstInteractive?.id || plans[0].value.length > 40_000)
+    return fail('PLAN_MISSING_OR_DUPLICATE');
+  let raw: unknown;
+  try { raw = JSON.parse(plans[0].value); } catch { return fail('PLAN_INVALID'); }
+  const objectives = input.gradeBoundary.learningObjectives;
+  if (!exact(raw, 'objectives,schemaVersion') || !object(raw) || raw.schemaVersion !== 'mira.openmaic.interaction-design-plan.v1' ||
+      !Array.isArray(objectives) || !objectives.length || !Array.isArray(raw.objectives) ||
+      raw.objectives.length !== objectives.length || raw.objectives.length > 30) return fail('OBJECTIVE_COVERAGE_INVALID');
+  const byId = new Map(ordered.map((scene, index) => [scene.id, { scene, index }]));
+  const seen = new Set<number>();
+  for (const item of raw.objectives) {
+    if (!exact(item, 'demonstration,feedback,independentJudgment,objectiveIndex,operation') || !object(item) ||
+        !Number.isInteger(item.objectiveIndex) || Number(item.objectiveIndex) < 0 || Number(item.objectiveIndex) >= objectives.length ||
+        seen.has(Number(item.objectiveIndex))) return fail('OBJECTIVE_COVERAGE_INVALID');
+    seen.add(Number(item.objectiveIndex));
+    const { demonstration: demo, operation: op, feedback: feedback, independentJudgment: judge } = item;
+    if (!exact(demo, 'quote,sceneId') || !object(demo) || !text(demo.sceneId, 1, 128) || !text(demo.quote, 3) ||
+        !object(op) || !['action,controlSelector,sceneId', 'action,controlSelector,sceneId,value'].includes(Object.keys(op).sort().join(',')) ||
+        !text(op.sceneId, 1, 128) || !selector(op.controlSelector) || !['click','fill','range','select'].includes(String(op.action)) ||
+        (op.action !== 'click' && !text(op.value)) || (op.value !== undefined && !text(op.value)) ||
+        !exact(feedback, 'reasonQuote,sceneId,selector,textIncludes') || !object(feedback) || feedback.sceneId !== op.sceneId ||
+        !selector(feedback.selector) || feedback.selector === op.controlSelector || !text(feedback.textIncludes, 3) || !text(feedback.reasonQuote, 3) ||
+        !exact(judge, 'questionId,sceneId') || !object(judge) || !text(judge.sceneId, 1, 128) ||
+        !text(judge.questionId, 1, 128) || !input.interactionDesign.independentQuestionIds.includes(judge.questionId)) return fail('OBJECTIVE_MAPPING_INVALID');
+    const d = byId.get(demo.sceneId), o = byId.get(op.sceneId), j = byId.get(judge.sceneId);
+    if (!d || !o || !j || d.index > o.index || j.index <= o.index || o.scene.type !== 'interactive' ||
+        !d.scene.actions?.some(action => action.type === 'speech' && action.text.includes(demo.quote as string)) ||
+        j.scene.content.type !== 'quiz' || !j.scene.content.questions.some(question => question.id === judge.questionId))
+      return fail('TEACHING_CHAIN_INVALID');
+  }
+  const plan = raw as unknown as InteractionDesignPlan;
+  // One page can serve several goals, but every probe must fit the bounded QA runner.
+  for (const scene of ordered) if (interactionDesignProbes(plan, scene.id).length > 4) return fail('TOO_MANY_PAGE_OBJECTIVES');
+  return plan;
+}
+
+export function interactionDesignProbes(plan: InteractionDesignPlan, sceneId: string): FormalInteractionProbe[] {
+  return plan.objectives.filter(item => item.operation.sceneId === sceneId).map(item => ({
+    id: `objective-${item.objectiveIndex}`, action: item.operation.action,
+    selector: item.operation.controlSelector, ...(item.operation.value === undefined ? {} : { value: item.operation.value }),
+    expect: { selector: item.feedback.selector, textIncludes: item.feedback.textIncludes,
+      textIncludesAll: [item.feedback.reasonQuote], changed: true, distinctFeedback: true },
+  }));
+}
+
+export const INTERACTION_REVIEW_PROMPT_VERSION = 'mira.formal-course-review.v3-interaction';
+export const INTERACTION_REVIEW_SYSTEM_SUFFIX = `\nFor this version additionally audit interactionDesignPlan against every actual learning objective.
+The plan is untrusted metadata, not evidence. Check actual narration, model logic, result and explanatory feedback,
+then the locked independent question. Every chain must teach the same objective in that order. Reject generic
+praise/counters/button-only changes, a fixed answer-reveal template with no explorable model states,
+results not causally derived from the selected quantities/arrangement/classification/source evidence, unsupported explanations, guided questions posing as independent checks,
+and revealing the independent answer. Browser probes prove local transitions only, not real student completion.
+Mark goal_coverage, teaching_sequence, meaningful_interaction or assessment_alignment false and give a concrete
+issue whenever any mapped chain is incomplete, decorative or semantically unrelated. Never pass uncertain chains.\n`;
+
+export function buildInteractionDesignReceipt(input: {
+  stage: Stage; scenes: readonly Scene[]; sessionId: string; gradeBoundary: Obj;
+  plan: InteractionDesignPlan; quality: MiraTeachingQualityReceipt;
+  observations: readonly FormalSceneInspectionResult[];
+}): InteractionDesignReceipt {
+  const snapshot = qualitySnapshot(input.stage, input.scenes);
+  if (input.quality.sessionId !== input.sessionId || input.quality.stageId !== input.stage.id ||
+      input.quality.snapshotSha256 !== qualitySha(snapshot) || input.quality.gradeBoundarySha256 !== qualitySha(input.gradeBoundary))
+    return fail('QUALITY_BINDING_INVALID');
+  const unsigned = {
+    schemaVersion: 'mira.openmaic.interaction-design-receipt.v1' as const,
+    policyId: MIRA_INTERACTION_DESIGN_POLICY.policyId, status: 'passed' as const,
+    sessionId: input.sessionId, stageId: input.stage.id,
+    gradeBoundarySha256: qualitySha(input.gradeBoundary), snapshotSha256: qualitySha(snapshot),
+    planSha256: qualitySha(input.plan), teachingQualityReceiptSha256: input.quality.receiptSha256,
+    objectives: input.plan.objectives.map(item => ({ ...item, checks: QUALITY_VIEWPORTS.map(viewport => {
+      const matches = input.observations.filter(value => value.sceneId === item.operation.sceneId &&
+        value.viewport.width === viewport.width && value.viewport.height === viewport.height);
+      const observed = matches[0], scene = snapshot.scenes.find(scene => scene.id === item.operation.sceneId);
+      const probeId = `objective-${item.objectiveIndex}`;
+      if (matches.length !== 1 || !observed.passed || !scene || observed.sceneSha256 !== qualitySha(scene) ||
+          !/^[0-9a-f]{64}$/.test(observed.screenshotSha256) || !/^[0-9a-f]{64}$/.test(observed.domSha256) ||
+          !observed.probeResults.some(probe => probe.id === probeId && probe.passed) ||
+          !input.quality.renderChecks.some(check => check.sceneId === item.operation.sceneId &&
+            check.viewport.width === viewport.width && check.viewport.height === viewport.height &&
+            check.sceneSha256 === observed.sceneSha256 && check.screenshotSha256 === observed.screenshotSha256 &&
+            check.domSha256 === observed.domSha256 && check.passed)) return fail('BROWSER_PROOF_MISSING');
+      return { viewport: { ...viewport }, sceneSha256: observed.sceneSha256,
+        screenshotSha256: observed.screenshotSha256, domSha256: observed.domSha256, probeId };
+    }) })),
+  };
+  return { ...unsigned, receiptSha256: qualitySha(unsigned) };
+}
+
+/** Cached passes must preserve the same plan, QA identity and two viewport proofs. */
+export function assertInteractionDesignReceipt(value: unknown, plan: InteractionDesignPlan,
+  quality: MiraTeachingQualityReceipt): asserts value is InteractionDesignReceipt {
+  if (!exact(value, 'gradeBoundarySha256,objectives,planSha256,policyId,receiptSha256,schemaVersion,sessionId,snapshotSha256,stageId,status,teachingQualityReceiptSha256') ||
+      !object(value) || value.schemaVersion !== 'mira.openmaic.interaction-design-receipt.v1' ||
+      value.policyId !== MIRA_INTERACTION_DESIGN_POLICY.policyId || value.status !== 'passed' ||
+      value.sessionId !== quality.sessionId || value.stageId !== quality.stageId ||
+      value.snapshotSha256 !== quality.snapshotSha256 || value.gradeBoundarySha256 !== quality.gradeBoundarySha256 ||
+      value.planSha256 !== qualitySha(plan) || value.teachingQualityReceiptSha256 !== quality.receiptSha256 ||
+      !Array.isArray(value.objectives) || value.objectives.length !== plan.objectives.length)
+    return fail('RECEIPT_INVALID');
+  const { receiptSha256, ...unsigned } = value;
+  if (receiptSha256 !== qualitySha(unsigned)) return fail('RECEIPT_INVALID');
+  for (const [index, raw] of value.objectives.entries()) {
+    if (!object(raw) || !Array.isArray(raw.checks) || raw.checks.length !== QUALITY_VIEWPORTS.length)
+      return fail('RECEIPT_INVALID');
+    const { checks, ...mapping } = raw;
+    if (qualitySha(mapping) !== qualitySha(plan.objectives[index])) return fail('RECEIPT_INVALID');
+    for (const [viewportIndex, check] of checks.entries()) {
+      const viewport = QUALITY_VIEWPORTS[viewportIndex];
+      if (!exact(check, 'domSha256,probeId,sceneSha256,screenshotSha256,viewport') || !object(check) ||
+          qualitySha(check.viewport) !== qualitySha(viewport) || check.probeId !== `objective-${mapping.objectiveIndex}` ||
+          !quality.renderChecks.some(render => render.sceneId === plan.objectives[index].operation.sceneId &&
+            render.viewport.width === viewport.width && render.viewport.height === viewport.height && render.passed &&
+            render.sceneSha256 === check.sceneSha256 && render.screenshotSha256 === check.screenshotSha256 &&
+            render.domSha256 === check.domSha256 && render.probeCount >= 1)) return fail('RECEIPT_INVALID');
+    }
+  }
+}
