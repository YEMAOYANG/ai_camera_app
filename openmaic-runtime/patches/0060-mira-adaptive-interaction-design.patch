+import { describe, expect, it } from 'vitest';
+import type { Scene, Stage } from '@/lib/types/stage';
+import {
+  MIRA_INTERACTION_DESIGN_POLICY, readInteractionDesignPlan, interactionDesignProbes,
+  interactionDesignPrompt, interactionDesignContextFromPrompt, buildInteractionDesignReceipt,
+  assertInteractionDesignReceipt, type InteractionDesignPlan,
+} from '@/lib/server/mira-formal-interaction-design';
+import {
+  MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY, MIRA_INTERACTION_PROFESSIONAL_CREATION_POLICY,
+  isExactMiraProfessionalCreationPolicy, isMiraInteractionCreationPolicy,
+} from '@/lib/server/mira-formal-generation-policy';
+import { qualitySha, qualitySnapshot, QUALITY_VIEWPORTS, MIRA_TEACHING_QUALITY_POLICY, type MiraTeachingQualityReceipt } from '@/lib/server/mira-formal-quality-contract';
+import type { FormalSceneInspectionResult } from '@/lib/types/formal-scene-inspection';
+
+function fixture() {
+  const plan: InteractionDesignPlan = {
+    schemaVersion: 'mira.openmaic.interaction-design-plan.v1', objectives: [{ objectiveIndex: 0,
+      demonstration: { sceneId: 'demo', quote: '两个部分合起来，数量就变多了。' },
+      operation: { sceneId: 'operate', controlSelector: '#count', action: 'range', value: '4' },
+      feedback: { sceneId: 'operate', selector: '#result', textIncludes: '一共四个', reasonQuote: '因为增加了两个' },
+      independentJudgment: { sceneId: 'judge', questionId: 'independent-1' },
+    }],
+  };
+  const scenes = [
+    { id: 'demo', type: 'slide', title: '看老师合起来', content: { type: 'slide' },
+      actions: [{ type: 'speech', text: plan.objectives[0].demonstration.quote }] },
+    { id: 'operate', type: 'interactive', title: '亲手试一次', content: { type: 'interactive',
+      html: `<input id="count" type="range"><output id="result">先动手</output><script type="application/json" id="mira-interaction-plan">${JSON.stringify(plan)}</script>` }, actions: [] },
+    { id: 'judge', type: 'quiz', title: '自己判断', content: { type: 'quiz', questions: [{ id: 'independent-1' }] }, actions: [] },
+  ].map((scene, order) => ({ ...scene, order, stageId: 'stage-1' })) as Scene[];
+  return { plan, scenes, stage: { id: 'stage-1', name: '动手合起来' } as Stage,
+    gradeBoundary: { learningObjectives: ['理解合并数量'] },
+    interactionDesign: { policy: MIRA_INTERACTION_DESIGN_POLICY, independentQuestionIds: ['independent-1'] } };
+}
+function withPlan(value: ReturnType<typeof fixture>, change: (plan: InteractionDesignPlan) => void) {
+  change(value.plan);
+  (value.scenes[1].content as { html: string }).html = `<script id="mira-interaction-plan" type="application/json">${JSON.stringify(value.plan)}</script>`;
+  return value;
+}
+function evidence(value = fixture()) {
+  const snapshot = qualitySnapshot(value.stage, value.scenes);
+  const observations = QUALITY_VIEWPORTS.map(viewport => ({ sceneId: 'operate', viewport: { ...viewport },
+    sceneSha256: qualitySha(snapshot.scenes[1]), screenshotSha256: 'a'.repeat(64), domSha256: 'b'.repeat(64),
+    passed: true, probeCount: 1, probeResults: [{ id: 'objective-0', passed: true, message: 'result and reason changed' }],
+  })) as FormalSceneInspectionResult[];
+  const quality: MiraTeachingQualityReceipt = {
+    schemaVersion: 'mira.openmaic.teaching-quality-receipt.v1', policyId: MIRA_TEACHING_QUALITY_POLICY.policyId,
+    status: 'passed', sessionId: 'session-1', stageId: value.stage.id, snapshotSha256: qualitySha(snapshot),
+    gradeBoundarySha256: qualitySha(value.gradeBoundary), receiptSha256: 'c'.repeat(64),
+    selectionPlanSha256: 'd'.repeat(64), teachingBriefSha256: 'e'.repeat(64),
+    sceneHashes: snapshot.scenes.map(scene => ({ sceneId: scene.id, sceneSha256: qualitySha(scene) })),
+    renderChecks: observations.map(check => ({ ...check, passed: true as const })),
+    review: { providerId: 'deepseek', modelId: 'deepseek-v4-flash', requestIdHash: 'f'.repeat(64),
+      inputSha256: '0'.repeat(64), dimensions: [], objectives: [] },
+  };
+  return { ...value, sessionId: 'session-1', observations, quality };
+}
+
+describe('formal adaptive interaction design', () => {
+  it('preserves the exact old video policy while registering a distinct future policy', () => {
+    expect(MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY).not.toHaveProperty('interactionDesignPolicy');
+    expect(isExactMiraProfessionalCreationPolicy(MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY)).toBe(true);
+    expect(isMiraInteractionCreationPolicy(MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY)).toBe(false);
+    expect(isExactMiraProfessionalCreationPolicy(MIRA_INTERACTION_PROFESSIONAL_CREATION_POLICY)).toBe(true);
+    expect(isExactMiraProfessionalCreationPolicy({ ...MIRA_INTERACTION_PROFESSIONAL_CREATION_POLICY,
+      interactionDesignPolicy: { ...MIRA_INTERACTION_DESIGN_POLICY, enabled: false } })).toBe(false);
+  });
+  it('keeps old prompts untouched and round trips only validated server context', () => {
+    expect(interactionDesignContextFromPrompt('old frozen job')).toBeUndefined();
+    const context = fixture().interactionDesign;
+    expect(interactionDesignContextFromPrompt('job' + interactionDesignPrompt(context))).toEqual(context);
+    expect(() => interactionDesignPrompt({ ...context, independentQuestionIds: [] })).toThrow('CONTEXT_INVALID');
+  });
+  it('requires every objective but allows a three-page teaching chain without a 60% quota', () => {
+    const value = fixture();
+    expect(readInteractionDesignPlan(value)).toEqual(value.plan);
+    expect(interactionDesignProbes(value.plan, 'operate')).toEqual([{ id: 'objective-0', action: 'range',
+      selector: '#count', value: '4', expect: { selector: '#result', textIncludes: '一共四个',
+        textIncludesAll: ['因为增加了两个'], changed: true, distinctFeedback: true } }]);
+    value.gradeBoundary.learningObjectives.push('分解数量');
+    expect(() => readInteractionDesignPlan(value)).toThrow('OBJECTIVE_COVERAGE_INVALID');
+  });
+  it('rejects missing or duplicate plan metadata rather than falling back to a badge', () => {
+    const value = fixture();
+    const html = value.scenes[1].content as { html: string };
+    html.html += html.html;
+    expect(() => readInteractionDesignPlan(value)).toThrow('PLAN_MISSING_OR_DUPLICATE');
+    html.html = '<button>我会了</button>';
+    expect(() => readInteractionDesignPlan(value)).toThrow('PLAN_MISSING_OR_DUPLICATE');
+  });
+  it.each([
+    ['guided assessment', (plan: InteractionDesignPlan) => { plan.objectives[0].independentJudgment.questionId = 'guided-1'; }],
+    ['button feedback', (plan: InteractionDesignPlan) => { plan.objectives[0].feedback.selector = '#count'; }],
+    ['arbitrary selector', (plan: InteractionDesignPlan) => { plan.objectives[0].operation.controlSelector = 'body *'; }],
+    ['unbound value', (plan: InteractionDesignPlan) => { delete plan.objectives[0].operation.value; }],
+  ])('rejects %s', (_name, change) => {
+    expect(() => readInteractionDesignPlan(withPlan(fixture(), change))).toThrow('OBJECTIVE_MAPPING_INVALID');
+  });
+  it('rejects evidence fabricated inside the plan instead of real teacher speech', () => {
+    expect(() => readInteractionDesignPlan(withPlan(fixture(), plan => {
+      plan.objectives[0].demonstration.quote = '没有实际讲过的示范';
+    }))).toThrow('TEACHING_CHAIN_INVALID');
