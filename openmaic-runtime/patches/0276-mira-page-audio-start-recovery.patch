diff --git a/tests/runtime/page-narration-start.test.ts b/tests/runtime/page-narration-start.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/runtime/page-narration-start.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it, vi } from 'vitest';
+import { registerPageNarration, togglePageNarration } from '@/lib/mira/page-narration';
+
+describe('page-owned student playback start', () => {
+  it('accepts audio in the originating click before replay, but never on pause or unavailable pages', () => {
+    const events: string[] = [];
+    const accept = vi.fn(() => events.push('accept'));
+    let ready = false;
+    const registration = registerPageNarration({
+      ready: () => ready,
+      play: () => events.push('play'),
+      pause: () => events.push('pause'),
+    });
+    try {
+      expect(togglePageNarration(accept)).toBe(false);
+      expect(events).toEqual([]);
+      ready = true;
+      registration.phase('paused');
+      expect(togglePageNarration(accept)).toBe(true);
+      expect(events).toEqual(['accept', 'play']);
+      registration.phase('playing');
+      expect(togglePageNarration(accept)).toBe(true);
+      expect(events).toEqual(['accept', 'play', 'pause']);
+      expect(accept).toHaveBeenCalledTimes(1);
+    } finally { registration.dispose(); }
+  });
+});
