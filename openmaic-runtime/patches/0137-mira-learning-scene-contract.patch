+import type { QuizQuestion, QuizVisual } from '@openmaic/dsl';
+
+/** Server-selected, versioned authority; never inferred from a child's response. */
+export interface LearningSceneContract {
+  schemaVersion: 'mira.learning.scene-contract.v1';
+  gradeCode: string;
+  subject: string;
+  maximumQuantity?: number;
+  pictureChoicesRequired: boolean;
+  noMasteryClaims: boolean;
+}
+
+const object = (value: unknown): value is Record<string, unknown> =>
+  !!value && typeof value === 'object' && !Array.isArray(value);
+function fail(code: string): never { throw new Error(`LEARNING_SCENE_${code}`); }
+export function assertLearningContract(value: unknown): asserts value is LearningSceneContract {
+  if (!object(value) || value.schemaVersion !== 'mira.learning.scene-contract.v1'
+    || !/^primary_[1-6]$/.test(String(value.gradeCode))
+    || !['chinese', 'math', 'english'].includes(String(value.subject))
+    || typeof value.pictureChoicesRequired !== 'boolean' || typeof value.noMasteryClaims !== 'boolean'
+    || (value.maximumQuantity !== undefined && (!Number.isInteger(value.maximumQuantity)
+      || Number(value.maximumQuantity) < 0 || Number(value.maximumQuantity) > 100))) fail('CONTRACT_INVALID');
+}
+
+export function learningSceneInstructions(contract: LearningSceneContract): string {
+  assertLearningContract(contract);
+  return [
+    '\nSERVER LEARNING SCENE CONTRACT (authoritative):', JSON.stringify(contract),
+    'Preserve option value keys exactly. answer contains value keys, never option labels. Never invent an answer for a server-locked hasAnswer:false question.',
+    ...(contract.pictureChoicesRequired ? [
+      'Children cannot independently read instructions. Each quiz question needs visual plus optionVisuals keyed by every option value. Use meaningful, distinguishable pictures, not emoji or a decorative common background.',
+      'Visual schema: {kind:"image",src:"approved image ID or source",alt:"brief description",cue?:"speaking"|"listening"|"observer"} or {kind:"quantity",count:integer,alt?:string}. Quantity renders that many objects; zero renders an empty tray. The target character may be taught, but other instructions cannot depend on reading.',
+      'For pronouns/people, use visual:{kind:"people",members:[{id,src,alt,cue:"speaking"|"listening"|"observer"}]} with exactly one speaker and one listener. Reuse these exact portraits in optionVisuals. The renderer places the cue on the corresponding person. Never infer a speaker from a shared photo where two mouths are open. Never style the correct choice before the learner responds. Provide teacher narration and replay; one task per screen, minimum 48px touch targets.',
+    ] : []),
+    ...(contract.maximumQuantity !== undefined ? [
+      `All taught quantities, operands, results, distractors and quantity controls stay between 0 and ${contract.maximumQuantity}. CSS coordinates/timers are not learning quantities.`,
+      'Every numeric/range input must have explicit min, max and initial value within that boundary. widget-config must contain learningQuantities:[{selector:"#control",min:0,max:...,initial:...}] for every quantity input; initial state, reset and all operations must obey the same bound. Do not add out-of-range examples.',
+    ] : []),
+    ...(contract.noMasteryClaims ? [
+      'No invented learner history, score, independent reading or mastery claim. Describe only the activity and actual local feedback. Exploration/game scoring.correctPoints must be 0; no rewards, mastery flags or completion/runtime events. Formal locked quiz scoring belongs to the server.',
+    ] : []),
+    'Interactive HTML is self-contained: no external/module scripts, no import/eval/Function; embed exactly one valid application/json widget-config whose type matches the requested widgetType. Inline JavaScript must parse and actual controls must change meaningful visible state. Do not fabricate preview/test receipts.',
+  ].join('\n');
+}
+
+/** Bind legacy label answers only when the label identifies one unique value. */
+export function normalizeQuizValueAnswers(question: Record<string, unknown>, options: QuizQuestion['options']): string[] | undefined {
+  if (question.hasAnswer === false) return undefined;
+  const raw = question.answer ?? question.correctAnswer ?? question.correct_answer;
+  if (raw === undefined || raw === null) return undefined;
+  const answers = Array.isArray(raw) ? raw : [raw];
+  if (!options?.length || new Set(options.map(o => o.value)).size !== options.length) fail('OPTION_VALUES_INVALID');
+  const values = answers.map(answer => {
+    if (typeof answer !== 'string' || !answer.trim()) fail('ANSWER_VALUE_INVALID');
+    if (options.some(o => o.value === answer)) return answer;
+    const matches = options.filter(o => o.label === answer);
+    if (matches.length !== 1) fail('ANSWER_VALUE_UNBOUND');
+    return matches[0].value;
+  });
+  if (!values.length || new Set(values).size !== values.length
+    || (question.type === 'single' && values.length !== 1)) fail('ANSWER_CARDINALITY_INVALID');
+  return values;
+}
+
+export function resolveQuizVisual(value: unknown, mapping?: Record<string, string>): QuizVisual | undefined {
+  if (!object(value)) return undefined;
+  if (value.kind === 'people' && Array.isArray(value.members) && value.members.length >= 2 && value.members.length <= 4) {
+    const members = value.members.map(member => {
+      if (!object(member) || typeof member.id !== 'string' || !member.id.trim() || !['speaking', 'listening', 'observer'].includes(String(member.cue))) return undefined;
+      const portrait = resolveQuizVisual({ ...member, kind: 'image' }, mapping);
+      return portrait?.kind === 'image' ? { id: member.id, src: portrait.src, alt: portrait.alt, cue: member.cue as 'speaking' | 'listening' | 'observer' } : undefined;
+    });
+    if (members.some(member => !member) || new Set(members.map(member => member!.id)).size !== members.length
+      || new Set(members.map(member => member!.src)).size !== members.length
+      || members.filter(member => member!.cue === 'speaking').length !== 1
+      || members.filter(member => member!.cue === 'listening').length !== 1) return undefined;
+    return { kind: 'people', members: members as Extract<QuizVisual, {kind: 'people'}>['members'] };
+  }
+  if (value.kind === 'quantity' && Number.isInteger(value.count) && Number(value.count) >= 0)
+    return { kind: 'quantity', count: Number(value.count), ...(typeof value.alt === 'string' ? { alt: value.alt } : {}) };
+  if (value.kind !== 'image' || typeof value.src !== 'string' || typeof value.alt !== 'string' || !value.alt.trim()) return undefined;
+  const src = mapping && Object.hasOwn(mapping, value.src) ? mapping[value.src] : value.src;
+  if (!/^(?:https?:\/\/|\/|data:image\/(?:png|jpeg|webp|svg\+xml);)/.test(src)) return undefined;
+  if (value.cue !== undefined && !['speaking', 'listening', 'observer'].includes(String(value.cue))) return undefined;
+  return { kind: 'image', src, alt: value.alt, ...(value.cue ? { cue: value.cue as 'speaking' | 'listening' | 'observer' } : {}) };
+}
+
+function assertVisual(visual: unknown, contract: LearningSceneContract): asserts visual is QuizVisual {
+  const resolved = resolveQuizVisual(visual);
+  if (!resolved) fail('PICTURE_INVALID');
+  if (resolved.kind === 'quantity' && resolved.count > (contract.maximumQuantity ?? 20)) fail('QUANTITY_OUT_OF_RANGE');
+}
+function fingerprint(visual: QuizVisual): string {
+  return visual.kind === 'quantity' ? `quantity:${visual.count}` : visual.kind === 'people'
+    ? 'people:' + JSON.stringify(visual.members) : `image:${visual.src}:${visual.cue ?? ''}`;
+}
+function assertArithmetic(text: string, maximum: number): void {
+  // Only arithmetic operands/results, not positions, timings, IDs or page numbers.
+  for (const match of text.matchAll(/(?:^|[^\d.])(\d+)\s*([+＋\-−])\s*(\d+)(?:\s*[=＝]\s*(\d+))?/g)) {
+    const left = Number(match[1]), right = Number(match[3]);
+    const result = match[2] === '+' || match[2] === '＋' ? left + right : left - right;
+    if ([left, right, result, ...(match[4] ? [Number(match[4])] : [])].some(n => n < 0 || n > maximum)) fail('ARITHMETIC_OUT_OF_RANGE');
+    if (match[4] && Number(match[4]) !== result) fail('ARITHMETIC_INCORRECT');
+  }
+}
+export function assertLearningQuiz(questions: QuizQuestion[], contract: LearningSceneContract): void {
+  assertLearningContract(contract);
+  if (!questions.length || new Set(questions.map(q => q.id)).size !== questions.length) fail('QUESTION_IDS_INVALID');
+  for (const question of questions) {
+    if (!['single', 'multiple', 'short_answer'].includes(question.type)
+      || typeof question.question !== 'string' || !question.question.trim()) fail('QUESTION_INVALID');
+    if (contract.pictureChoicesRequired && question.type === 'short_answer') fail('TEXT_INPUT_NOT_PICTURE_CHOICE');
+    const options = question.options;
+    if (question.type !== 'short_answer') {
+      if (!options?.length || options.length < 2 || new Set(options.map(o => o.value)).size !== options.length
+        || options.some(o => !o.value.trim())) fail('OPTION_VALUES_INVALID');
+      if (question.hasAnswer === false) {
+        if (question.answer?.length) fail('LOCKED_ANSWER_LEAK');
+      } else {
+        const answers = question.answer;
+        if (!answers?.length || answers.some(a => !options.some(o => o.value === a))
+          || new Set(answers).size !== answers.length || (question.type === 'single' && answers.length !== 1)) fail('ANSWER_VALUE_UNBOUND');
+      }
+    }
+    if (contract.pictureChoicesRequired) {
+      const source = question as unknown as Record<string, unknown>;
+      // Existing authoritative tap-object questions already render distinct real shapes.
+      const tap = source.sourceType === 'tap_objects' && Array.isArray(source.objects)
+        && source.objects.length === options?.length && source.objects.every(raw => object(raw)
+          && options?.some(o => o.value === raw.id) && ['circle', 'square', 'triangle'].includes(String(raw.shape))
+          && ['red', 'blue', 'yellow', 'green'].includes(String(raw.color)));
+      if (!tap) {
+        assertVisual(question.visual, contract);
+        if (!object(question.optionVisuals) || Object.keys(question.optionVisuals).sort().join('\0') !== options?.map(o => o.value).sort().join('\0')) fail('PICTURE_VALUE_BINDING_INVALID');
+        const pictures = options!.map(option => { const picture = question.optionVisuals![option.value]; assertVisual(picture, contract); return fingerprint(picture); });
+        if (new Set(pictures).size !== pictures.length) fail('PICTURES_NOT_DISTINCT');
+        const sceneVisual = question.visual;
+        if (sceneVisual?.kind === 'people' && options!.some(option => {
+          const portrait = question.optionVisuals![option.value];
+          return portrait.kind !== 'image' || !sceneVisual.members.some(member => member.src === portrait.src);
+        })) fail('PERSON_PORTRAIT_MISMATCH');
+      }
+    }
+    if (contract.maximumQuantity !== undefined) {
+      assertArithmetic(question.question, contract.maximumQuantity);
+      for (const option of options ?? []) {
+        if (/^\s*\d+\s*$/.test(option.label) && Number(option.label) > contract.maximumQuantity) fail('QUANTITY_OUT_OF_RANGE');
+        assertArithmetic(option.label, contract.maximumQuantity);
+      }
+    }
+  }
+}
+
+/** Resolve only caller-owned asset keys; unregistered IDs are never guessed. */
+export function resolveInteractiveImageIds(html: string, mapping?: Record<string, string>): string {
+  if (!mapping) return html;
+  return html.replace(/\bsrc\s*=\s*(["'])([^"']+)\1/gi, (all, quote: string, src: string) => {
+    if (!Object.hasOwn(mapping, src)) return all;
+    const resolved = mapping[src];
+    if (!/^(?:https?:\/\/|\/|data:image\/)/.test(resolved) || /["'<>]/.test(resolved)) fail('ASSET_SOURCE_INVALID');
+    return `src=${quote}${resolved}${quote}`;
+  });
+}
+
+export function interactiveScripts(html: string): string[] {
+  const scripts: string[] = [];
+  for (const match of html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)) {
+    const attrs = match[1];
+    if (/\bsrc\s*=/i.test(attrs) || /\btype\s*=\s*["']module["']/i.test(attrs)) fail('EXTERNAL_SCRIPT_UNSUPPORTED');
+    const type = attrs.match(/\btype\s*=\s*["']([^"']+)["']/i)?.[1];
+    if (type && !['text/javascript', 'application/javascript'].includes(type.toLowerCase())) continue;
+    if (/\b(?:eval|Function)\s*\(|\bimport\s*(?:\(|\{|["'])/.test(match[2])) fail('DYNAMIC_SCRIPT_UNSUPPORTED');
+    scripts.push(match[2]);
+  }
+  if (!scripts.some(script => script.trim())) fail('SCRIPT_MISSING');
+  return scripts;
+}
+function attr(attrs: string, name: string): string | undefined {
+  return attrs.match(new RegExp(`(?:^|\\s)${name}\\s*=\\s*(?:"([^"]*)"|'([^']*)'|([^\\s>]+))`, 'i'))?.slice(1).find(v => v !== undefined);
+}
+export function assertLearningInteractive(content: { html: string; widgetType?: string; widgetConfig?: Record<string, unknown> }, contract: LearningSceneContract): void {
+  assertLearningContract(contract);
+  interactiveScripts(content.html);
+  for (const image of content.html.matchAll(/<img\b([^>]*)>/gi)) {
+    const src = attr(image[1], 'src');
+    if (!src || !/^(?:https?:\/\/|\/|data:image\/)/.test(src)) fail('ASSET_SOURCE_INVALID');
+  }
+  if (!object(content.widgetConfig) || content.widgetConfig.type !== content.widgetType) fail('WIDGET_CONFIG_MISMATCH');
+  const embedded = [...content.html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)]
+    .filter(match => attr(match[1], 'id') === 'widget-config' && attr(match[1], 'type') === 'application/json');
+  if (embedded.length !== 1) fail('WIDGET_CONFIG_MISMATCH');
+  let parsed: unknown;
+  try { parsed = JSON.parse(embedded[0][2]); } catch { fail('WIDGET_CONFIG_INVALID'); }
+  if (!object(parsed) || parsed.type !== content.widgetType) fail('WIDGET_CONFIG_MISMATCH');
+  if (contract.noMasteryClaims) {
+    const scoring = content.widgetConfig.scoring;
+    if (object(scoring) && Object.values(scoring).some(v => typeof v === 'number' && v > 0)) fail('EXPLORATION_SCORE_FORBIDDEN');
+    if (/\b(?:mastered|masteryScore|independentReadingConfirmed)\s*[:=]\s*(?:true|[1-9])|mira:(?:course-completed|mastery)|student-runtime-events/.test(content.html)) fail('MASTERY_EVENT_FORBIDDEN');
+  }
+  if (contract.maximumQuantity !== undefined) {
+    const max = contract.maximumQuantity;
+    assertArithmetic(content.html.replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, ''), max);
+    const bounds = content.widgetConfig.learningQuantities;
+    for (const input of content.html.matchAll(/<input\b([^>]*)>/gi)) {
+      if (!['number', 'range'].includes(attr(input[1], 'type') ?? '')) continue;
+      const id = attr(input[1], 'id'), min = attr(input[1], 'min'), maximum = attr(input[1], 'max'), initial = attr(input[1], 'value');
+      if (!id || min === undefined || maximum === undefined || initial === undefined
+        || ![min, maximum, initial].every(v => /^\d+$/.test(v)) || Number(min) < 0
+        || Number(maximum) > max || Number(min) > Number(maximum) || Number(initial) < Number(min)
+        || Number(initial) > Number(maximum)) fail('PARAMETER_BOUND_INVALID');
+      if (!Array.isArray(bounds) || !bounds.some(bound => object(bound) && bound.selector === `#${id}`
+        && bound.min === Number(min) && bound.max === Number(maximum) && bound.initial === Number(initial))) fail('PARAMETER_BOUND_UNDECLARED');
+    }
+    if (bounds !== undefined && (!Array.isArray(bounds) || bounds.some(bound => !object(bound)
+      || !Number.isInteger(bound.min) || !Number.isInteger(bound.max) || !Number.isInteger(bound.initial)
+      || Number(bound.min) < 0 || Number(bound.max) > max || Number(bound.initial) < Number(bound.min)
+      || Number(bound.initial) > Number(bound.max)))) fail('PARAMETER_BOUND_INVALID');
+  }
+}
+
+/** This catches unsupported unconditional assertions; actual ability stays server-owned. */
+export function assertNoInventedMastery(text: string, contract: LearningSceneContract): void {
+  if (contract.noMasteryClaims && /(?:你(?:已经|完全)?(?:掌握了|学会了|都会了)|你也会啦|已(?:经)?独立(?:掌握|认字)|you have mastered|you can now independently read)/i.test(text)) fail('MASTERY_CLAIM_FORBIDDEN');
+}
