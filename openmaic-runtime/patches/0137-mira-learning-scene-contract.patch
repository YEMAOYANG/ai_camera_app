diff --git a/packages/@openmaic/generation/test/learning-scene-contract.test.ts b/packages/@openmaic/generation/test/learning-scene-contract.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/@openmaic/generation/test/learning-scene-contract.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, it } from 'vitest';
+import type { QuizQuestion } from '@openmaic/dsl';
+import { assertLearningInteractive, assertLearningQuiz, assertNoInventedMastery,
+  normalizeQuizValueAnswers, resolveQuizVisual, resolveInteractiveImageIds, type LearningSceneContract } from '../src/learning-scene-contract.js';
+import { extractWidgetConfig, generateSceneContent, resolveImageIds } from '../src/scene-generator.js';
+
+const contract: LearningSceneContract = { schemaVersion: 'mira.learning.scene-contract.v1',
+  gradeCode: 'primary_1', subject: 'math', maximumQuantity: 5, pictureChoicesRequired: true, noMasteryClaims: true };
+function question(): QuizQuestion {
+  return { id: 'q1', type: 'single', question: '2 + 1 = ?', options: [{ value: 'left', label: '2' }, { value: 'right', label: '3' }],
+    answer: ['right'], hasAnswer: true, visual: { kind: 'quantity', count: 3 },
+    optionVisuals: { left: { kind: 'quantity', count: 2 }, right: { kind: 'quantity', count: 3 } } };
+}
+const config = { type: 'simulation', learningQuantities: [{ selector: '#count', min: 0, max: 5, initial: 3 }] };
+function widget(overrides: Record<string, unknown> = {}) {
+  const widgetConfig = { ...config, ...overrides };
+  return { widgetType: 'simulation', widgetConfig,
+    html: '<html><input id="count" type="range" min="0" max="5" value="3"><p id="state"></p>'
+      + `<script id='widget-config' type='application/json'>${JSON.stringify(widgetConfig)}</script>`
+      + '<script>document.querySelector("#count").oninput=e=>document.querySelector("#state").textContent=e.target.value;</script></html>' };
+}
+describe('learning scene contract', () => {
+  it('passes a picture question with authoritative value binding', () => expect(() => assertLearningQuiz([question()], contract)).not.toThrow());
+  it('maps a unique legacy answer label to the actual value', () => expect(normalizeQuizValueAnswers({ type: 'single', correctAnswer: '3' }, question().options)).toEqual(['right']));
+  it('does not reinterpret a value as a label', () => expect(normalizeQuizValueAnswers({ type: 'single', answer: ['right'] }, question().options)).toEqual(['right']));
+  it('rejects ambiguous labels and unknown values', () => {
+    expect(() => normalizeQuizValueAnswers({ type: 'single', answer: 'absent' }, question().options)).toThrow('UNBOUND');
+    expect(() => normalizeQuizValueAnswers({ type: 'single', answer: 'same' }, [{ value: 'a', label: 'same' }, { value: 'b', label: 'same' }])).toThrow('UNBOUND');
+  });
+  it('keeps answer-blind server questions answerless', () => {
+    expect(normalizeQuizValueAnswers({ hasAnswer: false, answer: ['right'] }, question().options)).toBeUndefined();
+    const q = { ...question(), hasAnswer: false, answer: [] };
+    expect(() => assertLearningQuiz([q], contract)).not.toThrow();
+    expect(() => assertLearningQuiz([{ ...q, answer: ['right'] }], contract)).toThrow('LOCKED_ANSWER_LEAK');
+  });
+  it.each(['missing-picture', 'duplicate-picture', 'extra-key', 'unknown-answer', 'duplicate-option', 'out-of-range', 'text-input'])(
+    'rejects %s instead of accepting decorative text choices', reason => {
+      const q = question();
+      if (reason === 'missing-picture') delete q.optionVisuals;
+      if (reason === 'duplicate-picture') q.optionVisuals!.left = q.optionVisuals!.right;
+      if (reason === 'extra-key') q.optionVisuals!.unbound = { kind: 'quantity', count: 1 };
+      if (reason === 'unknown-answer') q.answer = ['absent'];
+      if (reason === 'duplicate-option') q.options![1].value = 'left';
+      if (reason === 'out-of-range') q.optionVisuals!.right = { kind: 'quantity', count: 6 };
+      if (reason === 'text-input') q.type = 'short_answer';
+      expect(() => assertLearningQuiz([q], contract)).toThrow('LEARNING_SCENE_');
+    });
+  it('renders zero as a valid empty quantity', () => expect(resolveQuizVisual({ kind: 'quantity', count: 0 })).toEqual({ kind: 'quantity', count: 0 }));
+  it('rejects outside-bound and incorrect arithmetic', () => {
+    expect(() => assertLearningQuiz([{ ...question(), question: '4 + 2 = 6' }], contract)).toThrow('OUT_OF_RANGE');
+    expect(() => assertLearningQuiz([{ ...question(), question: '2 + 1 = 4' }], contract)).toThrow('ARITHMETIC_INCORRECT');
+  });
+  it('resolves semantic asset IDs without inventing URLs', () => {
+    expect(resolveQuizVisual({ kind: 'image', src: 'portrait_blue', alt: '蓝衣同伴', cue: 'speaking' }, { portrait_blue: '/portraits/blue.png' })).toEqual({ kind: 'image', src: '/portraits/blue.png', alt: '蓝衣同伴', cue: 'speaking' });
+    expect(resolveQuizVisual({ kind: 'image', src: 'invented_name', alt: 'x' })).toBeUndefined();
+    expect(resolveImageIds([{ type: 'image', src: 'park', id: 'park' } as any], { park: '/original-park.png' })[0]).toMatchObject({ src: '/original-park.png' });
+  });
+  it('shows one real speaker/listener and preserves the same people in choices', () => {
+    const q = question(); q.visual = { kind: 'people', members: [
+      { id: 'blue', src: '/blue.png', alt: '蓝衣同伴', cue: 'speaking' },
+      { id: 'red', src: '/red.png', alt: '红衣同伴', cue: 'listening' },
+    ] };
+    q.optionVisuals = { left: { kind: 'image', src: '/blue.png', alt: '蓝衣同伴' }, right: { kind: 'image', src: '/red.png', alt: '红衣同伴' } };
+    expect(() => assertLearningQuiz([q], contract)).not.toThrow();
+    q.optionVisuals.right = { kind: 'image', src: '/another-child.png', alt: '另一位' };
+    expect(() => assertLearningQuiz([q], contract)).toThrow('PORTRAIT_MISMATCH');
+    q.visual.members[1].cue = 'speaking';
+    expect(resolveQuizVisual(q.visual)).toBeUndefined();
+  });
+  it('uses the same known mapping for HTML src, leaving unknown IDs rejected', () => {
+    expect(resolveInteractiveImageIds('<img src="park">', { park: '/original.png' })).toBe('<img src="/original.png">');
+    expect(() => assertLearningInteractive({ ...widget(), html: widget().html + '<img src="unknown">' }, contract)).toThrow('ASSET_SOURCE_INVALID');
+  });
+  it('parses widget JSON with either attribute order and rejects duplicates', () => {
+    const w = widget();
+    expect(extractWidgetConfig(w.html, 'simulation')).toEqual(config);
+    expect(extractWidgetConfig(w.html + `<script type="application/json" id="widget-config">${JSON.stringify(config)}</script>`, 'simulation')).toBeUndefined();
+  });
+  it('validates matching type and every declared numeric parameter', () => {
+    expect(() => assertLearningInteractive(widget(), contract)).not.toThrow();
+    expect(() => assertLearningInteractive(widget({ type: 'game' }), contract)).toThrow('MISMATCH');
+    expect(() => assertLearningInteractive(widget({ learningQuantities: [] }), contract)).toThrow('UNDECLARED');
+    const w = widget(); w.html = w.html.replace('max="5"', 'max="6"');
+    expect(() => assertLearningInteractive(w, contract)).toThrow('BOUND_INVALID');
+  });
+  it('blocks modules/external/dynamic scripts and fabricated mastery', () => {
+    for (const script of ['<script src="https://x/script.js"></script>', '<script type="module">const n=1;</script>', '<script>eval("x")</script>'])
+      expect(() => assertLearningInteractive({ ...widget(), html: widget().html + script }, contract)).toThrow('SCRIPT_UNSUPPORTED');
+    expect(() => assertLearningInteractive(widget({ scoring: { correctPoints: 10 } }), contract)).toThrow('SCORE_FORBIDDEN');
+    expect(() => assertNoInventedMastery('你已经掌握了所有汉字。', contract)).toThrow('MASTERY_CLAIM');
+    expect(() => assertNoInventedMastery('看图试一试，点图片听老师说。', contract)).not.toThrow();
+  });
+  it('real quiz generator preserves pictures and binds label answer', async () => {
+    const q = question();
+    const content = await generateSceneContent({ id: 'outline', type: 'quiz', title: '数量', description: '图片判断', order: 1,
+      quizConfig: { questionCount: 1, difficulty: 'easy', questionTypes: ['single'] } } as any,
+    async system => { expect(system).toContain('SERVER LEARNING SCENE CONTRACT'); return JSON.stringify([{ ...q, answer: undefined, correctAnswer: '3' }]); }, { learningContract: contract });
+    expect(content).toMatchObject({ questions: [{ answer: ['right'], optionVisuals: q.optionVisuals, visual: q.visual }] });
+  });
+});
