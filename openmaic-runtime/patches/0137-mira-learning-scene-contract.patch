@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest';
+import { assertLearningInteractiveSyntax, formalLearningContract, formalLearningContractFromPrompt,
+  MIRA_FORMAL_SCENE_LEARNING_POLICY, withFormalLearningContract } from '@/lib/server/mira-formal-learning-contract';
+
+const spec = { course: { gradeCode: 'primary_1', subject: 'math' as const } } as any;
+const policy = { sceneLearningPolicy: MIRA_FORMAL_SCENE_LEARNING_POLICY };
+describe('formal scene contract authority and compile-only checks', () => {
+  it('keeps historical policies and prompts unchanged', () => {
+    expect(formalLearningContract({}, spec, {})).toBeUndefined();
+    expect(withFormalLearningContract('historical bytes', undefined)).toBe('historical bytes');
+    expect(formalLearningContractFromPrompt('historical bytes')).toBeUndefined();
+  });
+  it('derives the exact registered lesson bound, never a title heuristic', () => {
+    const contract = formalLearningContract(policy, spec, { teachingBrief: { lesson: { constraints: { maximumNumber: 5 } } } })!;
+    expect(contract.maximumQuantity).toBe(5);
+    expect(contract.pictureChoicesRequired).toBe(true);
+    expect(formalLearningContractFromPrompt(withFormalLearningContract('formal', contract))).toEqual(contract);
+  });
+  it('rejects unknown policy and tampered duplicated context', () => {
+    expect(() => formalLearningContract({ sceneLearningPolicy: { ...MIRA_FORMAL_SCENE_LEARNING_POLICY, enforced: false } }, spec, {})).toThrow('POLICY_INVALID');
+    const prompt = withFormalLearningContract('', formalLearningContract(policy, spec, {})!);
+    expect(() => formalLearningContractFromPrompt(prompt + prompt)).toThrow('CONTEXT_INVALID');
+  });
+  it('compiles scripts without executing them, rejecting truncated JS', () => {
+    expect(() => assertLearningInteractiveSyntax('<script>throw new Error("must never execute");</script>')).not.toThrow();
+    expect(() => assertLearningInteractiveSyntax('<script>const result = ;</script>')).toThrow('SYNTAX_INVALID');
+    expect(() => assertLearningInteractiveSyntax('<button onclick="const x = ;">x</button><script>const x=1;</script>')).toThrow('HANDLER_SYNTAX_INVALID');
+  });
+});
