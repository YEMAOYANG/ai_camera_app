diff --git a/lib/server/mira-formal-learning-contract.ts b/lib/server/mira-formal-learning-contract.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-learning-contract.ts
@@ -0,0 +1,97 @@
+import { Script } from 'node:vm';
+import { assertLearningContract, assertLearningInteractive, assertLearningQuiz,
+  assertNoInventedMastery, interactiveScripts, learningSceneInstructions,
+  type LearningSceneContract } from '@openmaic/generation';
+import type { Scene } from '@/lib/types/stage';
+import type { FormalCoursewareSpec } from './mira-formal-compiled-classroom';
+import type { MiraProfessionalModelPolicyId } from './model-routes';
+
+/** New requests opt in; persisted creation policies are never rewritten. */
+export const MIRA_FORMAL_SCENE_LEARNING_POLICY = {
+  schemaVersion: 'mira.learning.scene-contract-policy.v1',
+  enforced: true,
+  pictureChoicesForGrades: ['primary_1', 'primary_2'],
+  noMasteryClaims: true,
+  scriptSyntaxRequired: true,
+} as const;
+const START = '\nMIRA_FORMAL_LEARNING_SCENE_CONTRACT:\n';
+const END = '\nEND_MIRA_FORMAL_LEARNING_SCENE_CONTRACT\n';
+const object = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
+const canonical = (value: unknown): string => JSON.stringify(value, (_, v) => object(v)
+  ? Object.fromEntries(Object.entries(v).sort(([a], [b]) => a.localeCompare(b))) : v);
+
+export function formalLearningContract(creationPolicy: unknown,
+  spec: Pick<FormalCoursewareSpec, 'course'>, payload: Record<string, unknown>): LearningSceneContract | undefined {
+  if (!object(creationPolicy) || !Object.hasOwn(creationPolicy, 'sceneLearningPolicy')) return undefined;
+  if (canonical(creationPolicy.sceneLearningPolicy) !== canonical(MIRA_FORMAL_SCENE_LEARNING_POLICY))
+    throw new Error('FORMAL_LEARNING_SCENE_POLICY_INVALID');
+  const brief = object(payload.teachingBrief) ? payload.teachingBrief : undefined;
+  const lesson = brief && object(brief.lesson) ? brief.lesson : undefined;
+  const constraints = lesson && object(lesson.constraints) ? lesson.constraints : undefined;
+  const boundary = object(payload.gradeBoundary) ? payload.gradeBoundary : undefined;
+  const boundaryConstraints = boundary && object(boundary.constraints) ? boundary.constraints : undefined;
+  const maximum = constraints?.maximumNumber ?? boundaryConstraints?.maximumNumber ?? boundary?.maximumNumber;
+  const contract: LearningSceneContract = {
+    schemaVersion: 'mira.learning.scene-contract.v1', gradeCode: spec.course.gradeCode,
+    subject: spec.course.subject,
+    pictureChoicesRequired: (MIRA_FORMAL_SCENE_LEARNING_POLICY.pictureChoicesForGrades as readonly string[]).includes(spec.course.gradeCode),
+    noMasteryClaims: true,
+    ...(typeof maximum === 'number' && Number.isInteger(maximum) && maximum >= 0 && maximum <= 100
+      ? { maximumQuantity: maximum } : {}),
+  };
+  assertLearningContract(contract);
+  return contract;
+}
+export function withFormalLearningContract(prompt: string, contract: LearningSceneContract | undefined): string {
+  return contract ? prompt + START + JSON.stringify(contract) + END + learningSceneInstructions(contract) : prompt;
+}
+export function formalModelPolicyFromPrompt(prompt: string): MiraProfessionalModelPolicyId | undefined {
+  const marker = '\nMIRA_FORMAL_MODEL_POLICY_ID:';
+  const parts = prompt.split(marker);
+  if (parts.length === 1) return undefined;
+  const id = parts[1].split('\n')[0].trim();
+  if (parts.length !== 2 || id !== 'deepseek-v4.1-flash-candidate-v1') throw new Error('FORMAL_MODEL_POLICY_CONTEXT_INVALID');
+  return id;
+}
+export function formalLearningContractFromPrompt(prompt: string): LearningSceneContract | undefined {
+  const parts = prompt.split(START);
+  if (parts.length === 1) return undefined;
+  if (parts.length !== 2 || parts[1].split(END).length !== 2) throw new Error('FORMAL_LEARNING_SCENE_CONTEXT_INVALID');
+  let value: unknown;
+  try { value = JSON.parse(parts[1].split(END)[0]); } catch { throw new Error('FORMAL_LEARNING_SCENE_CONTEXT_INVALID'); }
+  assertLearningContract(value);
+  return value;
+}
+
+/** Compile only: generated JavaScript is never evaluated in the backend. */
+export function assertLearningInteractiveSyntax(html: string): void {
+  let index = 0;
+  for (const script of interactiveScripts(html)) {
+    try { new Script(script, { filename: `learning-widget-${index++}.js` }); }
+    catch { throw new Error('LEARNING_SCENE_SCRIPT_SYNTAX_INVALID'); }
+  }
+  for (const match of html.matchAll(/\bon[a-z]+\s*=\s*(?:"([^"]*)"|'([^']*)')/gi)) {
+    const handler = (match[1] ?? match[2]).replaceAll('&quot;', '"').replaceAll('&#39;', "'").replaceAll('&amp;', '&');
+    try { new Script(`(function(event){${handler}\n})`); }
+    catch { throw new Error('LEARNING_SCENE_HANDLER_SYNTAX_INVALID'); }
+  }
+}
+export function assertFormalLearningScenes(scenes: Scene[], contract: LearningSceneContract | undefined): void {
+  if (!contract) return; // Historical jobs preserve their original contract.
+  assertLearningContract(contract);
+  for (const scene of scenes) {
+    if (scene.content.type === 'quiz') assertLearningQuiz(scene.content.questions, contract);
+    if (scene.content.type === 'interactive') {
+      const content = scene.content;
+      if (!content.html) throw new Error('LEARNING_SCENE_INLINE_HTML_REQUIRED');
+      assertLearningInteractive({ html: content.html, widgetType: content.widgetType,
+        widgetConfig: content.widgetConfig }, contract);
+      assertLearningInteractiveSyntax(content.html);
+    }
+    const rendered = scene.content.type === 'slide' ? JSON.stringify(scene.content.canvas.elements)
+      : scene.content.type === 'interactive' ? (scene.content.html ?? '')
+        : scene.content.type === 'quiz' ? scene.content.questions.map(q => q.question).join('\n') : '';
+    assertNoInventedMastery(rendered, contract);
+    for (const action of scene.actions ?? []) if (action.type === 'speech') assertNoInventedMastery(action.text, contract);
+  }
+}
