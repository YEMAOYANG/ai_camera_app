+++ b/packages/@openmaic/generation/test/frozen-textbook-quiz-routing.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it, vi } from 'vitest';
+import { buildPrompt, generateSceneContent, type SceneOutline } from '@openmaic/generation';
+
+const outline: SceneOutline = { id: 'locked-page', order: 3, title: 'Listen and choose',
+  type: 'quiz', description: 'One picture-supported question', keyPoints: ['frozen scope'] };
+const src = '/api/classroom-media/stage-frozen/media/one.png';
+const picture = { kind: 'image', src, alt: 'First picture' };
+const question = { id: 'locked-q', type: 'single', question: 'Listen and choose the picture.',
+  options: [{ value: 'A', label: 'First' }, { value: 'B', label: 'Second' }], answer: ['B'],
+  points: 10, analysis: 'The matching picture.', visual: picture, optionVisuals: { A: picture } };
+const media = [{ id: 'img_1', pageNumber: 1, src: 'not-the-final-source', description: 'Verified picture' }];
+const actions = [{ id: 'speech-locked-q', type: 'speech' as const, text: question.question }];
+const instruction = 'NATIVE QUIZ CONTENT\n' + JSON.stringify(question) + '\nExact implementation detail.\n';
+const config = (count: number) => ({ questionCount: count, difficulty: 'medium' as const, questionTypes: ['single' as const] });
+
+describe('frozen textbook quiz input routing', () => {
+  it.each([1, 2])('passes the server locked count %i, full instruction, exact actions and real image schema', async count => {
+    const aiCall = vi.fn(async (_system: string, _user: string) => JSON.stringify([question]));
+    const output = await generateSceneContent({ ...outline, quizConfig: config(count) }, aiCall, {
+      textbookPromptProfile: 'frozen-textbook-v1', editDirective: instruction, exactActions: actions,
+      assignedImages: media, imageMapping: { img_1: src },
+    });
+    expect(aiCall).toHaveBeenCalledTimes(1);
+    const [system, user] = aiCall.mock.calls[0]!;
+    expect(system).toContain('# Frozen Textbook Quiz Authoring v1');
+    expect(system).toContain('"kind":"image"');
+    expect(system).toContain('optionVisuals');
+    expect(system).toContain('server-owned AUTHORITATIVE');
+    expect(system).toContain('Do not invent questions, randomize answers');
+    expect(user).toContain(`Locked Question Count: ${count}`);
+    expect(user).toContain(instruction);
+    expect(user).toContain(JSON.stringify(actions));
+    expect(user).toContain(JSON.stringify([{ id: 'img_1', src, description: media[0].description }]));
+    expect(system + user).not.toContain('{{');
+    expect(output).toMatchObject({ questions: [{ ...question, hasAnswer: true }] });
+  });
+
+  it.each([undefined, config(0), config(1.5), { ...config(1), questionTypes: [] },
+    { ...config(1), questionTypes: ['multiple'] }])('rejects absent or incompatible frozen config before calling the model', async quizConfig => {
+    const aiCall = vi.fn();
+    await expect(generateSceneContent({ ...outline, quizConfig } as SceneOutline, aiCall,
+      { textbookPromptProfile: 'frozen-textbook-v1' })).rejects.toThrow('FROZEN_TEXTBOOK_QUIZ_CONFIG_REQUIRED');
+    expect(aiCall).not.toHaveBeenCalled();
+  });
+
+  it.each([undefined, 'textbook-v1'] as const)('preserves historical %s prompt bytes, default count and instruction behavior', async profile => {
+    for (const explicit of [undefined, config(2)]) {
+      let captured: unknown;
+      await generateSceneContent({ ...outline, ...(explicit ? { quizConfig: explicit } : {}) },
+        async (system, user) => { captured = { system, user }; return JSON.stringify([question]); }, {
+          ...(profile ? { textbookPromptProfile: profile } : {}), editDirective: instruction,
+          exactActions: actions, assignedImages: media, imageMapping: { img_1: src },
+        });
+      const prompts = buildPrompt('quiz-content', { title: outline.title, description: outline.description,
+        keyPoints: '1. frozen scope', questionCount: explicit?.questionCount ?? 3,
+        difficulty: 'medium', questionTypes: 'single', languageDirective: '' })!;
+      expect(captured).toEqual({ system: prompts.system, user: prompts.user +
+        '\nApproved visual assets (reuse exact IDs/sources):\n' + JSON.stringify([{ id: 'img_1', src, description: media[0].description }]) });
+    }
+  });
+
+  it('does not weaken malformed image normalization in the new profile', async () => {
+    const broken = { ...question, visual: { src, alt: 'missing kind' },
+      optionVisuals: { A: { kind: 'image', src, alt: '' } } };
+    const output = await generateSceneContent({ ...outline, quizConfig: config(1) },
+      async () => JSON.stringify([broken]), { textbookPromptProfile: 'frozen-textbook-v1' });
+    expect(JSON.parse(JSON.stringify(output))).toMatchObject({ questions: [{ optionVisuals: {} }] });
+    expect(JSON.parse(JSON.stringify(output)).questions[0]).not.toHaveProperty('visual');
+  });
+});
