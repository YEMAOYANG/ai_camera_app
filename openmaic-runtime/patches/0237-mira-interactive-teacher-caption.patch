+
+// Interactive captions use fixed cue identities; authored iframe text is never accepted.
+type InteractiveNarrationListener = (sceneId: string, cueId: string) => void;
+const interactiveListeners = new Set<InteractiveNarrationListener>();
+export function subscribeInteractiveNarration(listener: InteractiveNarrationListener): () => void {
+  interactiveListeners.add(listener);
+  return () => { interactiveListeners.delete(listener); };
+}
+export function notifyInteractiveNarration(sceneId: string, cueId: string): void {
+  interactiveListeners.forEach(listener => listener(sceneId, cueId));
+}
