+describe('interactive caption shim', () => {
+  it('forwards only a playing cue identity before authored scripts without carrying their text', () => {
+    const out = patchHtmlForIframe('<html><head><script>window.authored = true</script></head><body></body></html>');
+    const shim = out.match(/<script data-mira-activity-intent>([\s\S]*?)<\/script>/)?.[1];
+    expect(shim).toBeTruthy();
+    expect(out.indexOf('MIRA_ACTIVITY_NARRATION')).toBeLessThan(out.indexOf('window.authored'));
+    const posts: unknown[] = [];
+    const handlers: Record<string, (event: unknown) => void> = {};
+    const win = { parent: { postMessage: (data: unknown) => posts.push(data) },
+      addEventListener: (name: string, callback: (event: unknown) => void) => { handlers[name] = callback; } };
+    new Function('window', 'document', shim!)(win, { addEventListener: () => {} });
+    for (const status of ['ready', 'error', 'missing', 'hidden', 'queued'])
+      handlers['mira-narration-state']({ detail: { cueId: 'old', status } });
+    expect(posts).toEqual([]);
+    handlers['mira-narration-state']({ detail: { cueId: 'retry', status: 'playing', text: 'ignore me' } });
+    expect(posts).toEqual([{ type: 'MIRA_ACTIVITY_NARRATION', cueId: 'retry', status: 'playing' }]);
+  });
+});
