@@ -117,3 +117,35 @@
   } catch { return new Set<string>(); }
   return managed;
 }
+
+/** Resolve a caption from the same exact audio/text binding used for ownership.
+ * A playing event is only a cue identity, never an authority for teacher text. */
+export function fixedInteractiveNarrationText(scene: Scene | null | undefined, fixedTextbook: boolean,
+  sceneId: string, cueId: string): string | null {
+  if (!scene || scene.id !== sceneId || scene.type !== 'interactive' || scene.content.type !== 'interactive'
+      || !/^[\w-]{1,128}$/.test(cueId)) return null;
+  const managed = fixedPageManagedSpeechIds(scene, fixedTextbook);
+  if (!managed.size) return null;
+  if (scene.miraPageNarration !== undefined) {
+    const binding = scene.miraPageNarration.bindings.find(item => item.cueId === cueId && managed.has(item.speechId));
+    return binding?.text ?? null;
+  }
+  try {
+    const html = scene.content.html ?? '';
+    const cues = JSON.parse(script(html, 'mira-narration-cues', 'application/json') ?? 'null');
+    const helper = script(html, 'mira-pre-recorded-audio');
+    const clips = JSON.parse(helper?.match(/\bconst clips=(\{[^\n]*?\});let active=null;/)?.[1] ?? 'null');
+    const cue = cues.cues.find((item: { id: string }) => item.id === cueId);
+    const audioPath = recordedPath(clips?.[cueId]);
+    if (!cue || !audioPath) return null;
+    const action = scene.actions?.find(action => action.type === 'speech' && managed.has(action.id)
+      && action.text.trim() === cue.text.trim() && recordedPath(action.audioUrl) === audioPath);
+    return action?.type === 'speech' ? action.text : null;
+  } catch { return null; }
+}
+
+/** A gesture takes the sound channel, not the already visible teacher sentence. */
+export function speechAfterActivityGesture(scene: Scene | null | undefined, previous: string | null): string | null {
+  if (scene?.type !== 'interactive') return null;
+  return previous ?? scene.actions?.find(action => action.type === 'speech')?.text ?? null;
+}
