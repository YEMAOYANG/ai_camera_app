+  assertProviderReady: () => void;
+  readTtsJob: typeof readMiraFormalTtsJob;
+  executeTts: (request: MiraFormalTtsRequest) => ReturnType<typeof executeMiraFormalTts>;
+  readTtsAsset: typeof readMiraFormalTtsAsset;
+  readAsrJob: typeof readMiraFormalAsrJob;
+  executeAsr: (
