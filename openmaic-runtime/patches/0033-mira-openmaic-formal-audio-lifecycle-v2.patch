+    expect(receipt.segments.map((segment) => segment.sceneOrder)).toEqual(
+      Array.from({ length: 10 }, (_, index) => index),
+    );
+    expect(receipt.segments.every((segment) => segment.asr.similarityBps === 10_000)).toBe(true);
+    const { receiptSha256, ...receiptWithoutHash } = receipt;
