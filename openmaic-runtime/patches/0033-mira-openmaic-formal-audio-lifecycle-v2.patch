+  onProgress?: (progress: {
+    phase: 'tts' | 'asr';
+    completed: number;
+    total: 10;
+  }) => Promise<void> | void;
+}
+
+const defaultDependencies: MiraFormalAudioLifecycleDependencies = {
+  assertProviderReady: assertMiraFormalAudioProviderReady,
+  readTtsJob: readMiraFormalTtsJob,
+  executeTts: (request) => executeMiraFormalTts(request),
+  readTtsAsset: readMiraFormalTtsAsset,
+  readAsrJob: readMiraFormalAsrJob,
+  executeAsr: (request, transcriptEvidence) =>
+    executeMiraFormalAsr(request, { transcriptEvidence }),
+};
+
+function sha256(value: string | Uint8Array): string {
+  return createHash('sha256').update(value).digest('hex');
+}
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(
+      Object.entries(value as Record<string, unknown>)
+        .sort(([left], [right]) => left.localeCompare(right))
+        .map(([key, nested]) => [key, canonical(nested)]),
+    );
+  }
+  return value;
+}
+
+function canonicalSha256(value: unknown): string {
+  return sha256(JSON.stringify(canonical(value)));
+}
+
+function speechAction(scene: Scene): Action & { type: 'speech'; text: string } {
+  const actions = Array.isArray(scene.actions) ? scene.actions : [];
+  const speech = actions.filter(
+    (action): action is Action & { type: 'speech'; text: string } =>
+      action.type === 'speech' && typeof action.text === 'string',
+  );
+  if (speech.length !== 1) {
+    throw new Error(`FORMAL_AUDIO_SPEECH_COUNT_INVALID:${scene.order}`);
+  }
+  return speech[0];
+}
+
+export function prepareMiraFormalSpeechText(
+  value: string,
+  subject: MiraFormalAudioSubject,
+): string {
+  const text = value.trim();
+  if (subject !== 'chinese' || !text) return text;
+  return text.replace(CHINESE_LATIN_TOKEN_PATTERN, (token) => {
+    return CHINESE_PINYIN_SPOKEN_TOKENS[token.toLowerCase()] || token;
+  });
+}
+
+function smallIntegerToSpokenChinese(value: string): string {
+  const normalized = value.normalize('NFKC');
+  if (normalized.length > 1 && normalized.startsWith('0')) {
+    return [...normalized].map((digit) => CHINESE_DIGITS[Number(digit)]).join('');
+  }
+  const number = Number(normalized);
+  if (number > 9_999) {
+    return [...normalized].map((digit) => CHINESE_DIGITS[Number(digit)]).join('');
+  }
+  if (number < 10) return CHINESE_DIGITS[number];
+  const units = [
+    [1_000, '千'],
+    [100, '百'],
+    [10, '十'],
+  ] as const;
+  let remaining = number;
+  const parts: string[] = [];
+  let pendingZero = false;
+  for (const [unit, label] of units) {
+    const digit = Math.floor(remaining / unit);
+    remaining %= unit;
+    if (digit) {
+      if (pendingZero) {
+        parts.push('零');
+        pendingZero = false;
+      }
+      if (!(unit === 10 && digit === 1 && parts.length === 0)) {
+        parts.push(CHINESE_DIGITS[digit]);
+      }
+      parts.push(label);
+    } else if (parts.length && remaining) {
+      pendingZero = true;
+    }
+  }
+  if (remaining) {
+    if (pendingZero) parts.push('零');
+    parts.push(CHINESE_DIGITS[remaining]);
+  }
+  return parts.join('');
+}
+
+export function prepareMiraFormalAsrComparisonText(
+  value: string,
+  subject: MiraFormalAudioSubject,
+): string {
+  let text = prepareMiraFormalSpeechText(value.normalize('NFKC'), subject);
+  if (subject !== 'chinese' && subject !== 'math') return text;
+  text = text.replace(CHINESE_NUMBER_PATTERN, (number) => smallIntegerToSpokenChinese(number));
+  text = text.replaceAll('+', '加').replaceAll('=', '等于');
+  text = text.replaceAll('×', '乘').replaceAll('*', '乘');
+  text = text.replaceAll('÷', '除以');
+  const numberCharacters = `${CHINESE_DIGITS}十百千`;
+  text = text.replace(
+    new RegExp(`(?<=[${numberCharacters}])-(?=[${numberCharacters}])`, 'gu'),
+    '减',
+  );
+  return text.replace(
+    new RegExp(`(?<=[${numberCharacters}])/(?=[${numberCharacters}])`, 'gu'),
+    '除以',
+  );
+}
+
+export function normalizeMiraFormalAsrText(value: string): string {
+  return [...value.normalize('NFKC').toLowerCase()]
+    .filter((character) => /[\p{L}\p{N}]/u.test(character))
+    .join('');
+}
+
+export function miraFormalAsrSimilarityBps(expected: string, actual: string): number {
+  let left = normalizeMiraFormalAsrText(expected);
+  let right = normalizeMiraFormalAsrText(actual);
+  if (!left || !right) return 0;
+  if (left.length < right.length) [left, right] = [right, left];
+  let previous = Array.from({ length: right.length + 1 }, (_, index) => index);
+  for (let leftIndex = 1; leftIndex <= left.length; leftIndex += 1) {
+    const current = [leftIndex];
+    for (let rightIndex = 1; rightIndex <= right.length; rightIndex += 1) {
+      current.push(
+        Math.min(
+          current[current.length - 1] + 1,
+          previous[rightIndex] + 1,
+          previous[rightIndex - 1] + (left[leftIndex - 1] === right[rightIndex - 1] ? 0 : 1),
+        ),
+      );
+    }
+    previous = current;
+  }
+  const distance = previous[previous.length - 1];
+  const denominator = Math.max(left.length, right.length);
+  return Math.max(0, Math.floor(((denominator - distance) * 10_000) / denominator));
+}
+
+function buildLifecycleSegments(input: FormalAudioLifecycleInput): {
+  classroomContentSha256: string;
+  segments: LifecycleSegment[];
+} {
+  if (!IDENTIFIER.test(input.buildItemId)) {
+    throw new Error('FORMAL_AUDIO_BUILD_ITEM_INVALID');
+  }
+  if (!IDENTIFIER.test(input.stage.id) || input.scenes.length !== EXPECTED_SEGMENT_COUNT) {
+    throw new Error('FORMAL_AUDIO_CLASSROOM_INVALID');
+  }
+  const seenSceneIds = new Set<string>();
+  const seenActionIds = new Set<string>();
+  const segments = input.scenes.map((scene, expectedOrder) => {
+    if (scene.order !== expectedOrder || !IDENTIFIER.test(scene.id) || seenSceneIds.has(scene.id)) {
+      throw new Error(`FORMAL_AUDIO_SCENE_INVALID:${expectedOrder}`);
+    }
+    const action = speechAction(scene);
+    if (!IDENTIFIER.test(action.id) || seenActionIds.has(action.id)) {
+      throw new Error(`FORMAL_AUDIO_ACTION_INVALID:${expectedOrder}`);
+    }
+    seenSceneIds.add(scene.id);
+    seenActionIds.add(action.id);
+    const sourceText = action.text.trim();
+    const text = prepareMiraFormalSpeechText(sourceText, input.subject);
+    if (!sourceText || !text) throw new Error(`FORMAL_AUDIO_TEXT_INVALID:${expectedOrder}`);
+    const textSha256 = sha256(text);
+    const identity = `${input.buildItemId}:${expectedOrder}:${scene.id}:${action.id}:${MIRA_FORMAL_SPEECH_TEXT_POLICY_VERSION}:${textSha256}`;
+    const identityDigest = sha256(identity);
+    return {
+      sceneOrder: expectedOrder,
+      sceneId: scene.id,
+      actionId: action.id,
+      narrationSegmentId: `formal_narration_${identityDigest.slice(0, 48)}`,
+      sourceTextSha256: sha256(sourceText),
+      text,
+      textSha256,
+      ttsRequestId: `formal_tts_${identityDigest.slice(0, 48)}`,
+      asrRequestId: `formal_asr_${identityDigest.slice(0, 48)}`,
+    };
+  });
+  return {
+    classroomContentSha256: canonicalSha256({ stage: input.stage, scenes: input.scenes }),
+    segments,
+  };
+}
+
+function assertTtsRecord(
+  record: MiraFormalTtsJob,
+  request: MiraFormalTtsRequest,
+  expectedVoiceId: 'Serena' | 'Ethan' | 'Jennifer',
+): asserts record is MiraFormalTtsJob & {
+  state: 'succeeded';
+  audioSha256: string;
+  mimeType: 'audio/wav';
+  sizeBytes: number;
+} {
+  if (
+    record.requestSha256 !== canonicalSha256(request) ||
+    record.requestId !== request.requestId ||
+    record.classroomId !== request.classroomId ||
+    record.classroomContentSha256 !== request.classroomContentSha256 ||
+    record.subject !== request.subject ||
+    record.teacherProfileId !== request.teacherProfileId ||
+    record.teacherProfileVersion !== request.teacherProfileVersion ||
+    record.teacherProfileSha256 !== request.teacherProfileSha256 ||
+    record.teacherGender !== request.teacherGender ||
+    record.sceneId !== request.sceneId ||
+    record.sceneOrder !== request.sceneOrder ||
+    record.actionId !== request.actionId ||
+    record.narrationSegmentId !== request.narrationSegmentId ||
+    record.textSha256 !== request.textSha256 ||
+    record.state !== 'succeeded' ||
+    !record.audioSha256 ||
+    !SHA256.test(record.audioSha256) ||
+    record.mimeType !== 'audio/wav' ||
+    !Number.isSafeInteger(record.sizeBytes) ||
+    !record.sizeBytes ||
+    record.providerId !== 'qwen-tts' ||
+    record.modelId !== 'qwen3-tts-flash' ||
+    record.voiceId !== expectedVoiceId ||
+    record.fallbackUsed !== false
+  ) {
+    throw new Error(`FORMAL_AUDIO_TTS_INCOMPLETE:${request.sceneOrder}:${record.state}`);
+  }
+}
+
+function assertAsrRecord(
+  record: MiraFormalAsrJob,
+  request: MiraFormalAsrRequest,
+): asserts record is MiraFormalAsrJob & {
+  state: 'succeeded';
+  transcriptSha256: string;
+  normalizedTranscriptSha256: string;
+  similarityBps: number;
+} {
+  const similarityBps = record.similarityBps;
+  if (
+    record.requestSha256 !== canonicalSha256(request) ||
+    record.requestId !== request.requestId ||
+    record.ttsRequestId !== request.ttsRequestId ||
+    record.classroomId !== request.classroomId ||
+    record.classroomContentSha256 !== request.classroomContentSha256 ||
+    record.subject !== request.subject ||
+    record.teacherProfileId !== request.teacherProfileId ||
+    record.teacherProfileVersion !== request.teacherProfileVersion ||
+    record.teacherProfileSha256 !== request.teacherProfileSha256 ||
+    record.teacherGender !== request.teacherGender ||
+    record.sceneId !== request.sceneId ||
+    record.sceneOrder !== request.sceneOrder ||
+    record.actionId !== request.actionId ||
+    record.narrationSegmentId !== request.narrationSegmentId ||
+    record.audioSha256 !== request.audioSha256 ||
+    record.state !== 'succeeded' ||
+    !record.transcriptSha256 ||
+    !SHA256.test(record.transcriptSha256) ||
+    !record.normalizedTranscriptSha256 ||
+    !SHA256.test(record.normalizedTranscriptSha256) ||
+    !Number.isSafeInteger(similarityBps) ||
+    similarityBps === undefined ||
+    similarityBps < MINIMUM_ASR_SIMILARITY_BPS ||
+    similarityBps > 10_000 ||
+    record.providerId !== 'qwen-asr' ||
+    record.modelId !== 'qwen3-asr-flash' ||
+    record.fallbackUsed !== false
+  ) {
+    throw new Error(`FORMAL_AUDIO_ASR_INCOMPLETE:${request.sceneOrder}:${record.state}`);
+  }
+}
+
+export async function completeMiraFormalAudioLifecycle(
+  input: FormalAudioLifecycleInput,
+  dependencies: MiraFormalAudioLifecycleDependencies = defaultDependencies,
+  options: MiraFormalAudioLifecycleOptions = {},
+): Promise<MiraFormalAudioLifecycleReceipt> {
+  const policy = getMiraFormalAudioRuntimePolicy();
+  const subjectPolicy = policy.subjects[input.subject];
+  if (!subjectPolicy) throw new Error('FORMAL_AUDIO_SUBJECT_INVALID');
+  const teachers = (input.stage.generatedAgentConfigs || []).filter(
+    (agent) => agent.role === 'teacher',
+  );
+  const teacher = teachers[0];
+  const teacherVoiceConfig = teacher?.voiceConfig as
+    | (NonNullable<typeof teacher.voiceConfig> & { modelId?: string })
+    | undefined;
+  if (
+    teachers.length !== 1 ||
+    teacher.name !== subjectPolicy.teacherName ||
+    teacherVoiceConfig?.providerId !== policy.tts.providerId ||
+    teacherVoiceConfig?.modelId !== policy.tts.modelId ||
+    teacherVoiceConfig?.voiceId !== subjectPolicy.voiceId
+  ) {
+    throw new Error('FORMAL_AUDIO_TEACHER_CONTRACT_INVALID');
+  }
+  const { classroomContentSha256, segments } = buildLifecycleSegments(input);
+  let providerReady = false;
+  const ensureProviderReady = () => {
+    if (providerReady) return;
+    dependencies.assertProviderReady();
+    providerReady = true;
+  };
+
+  const completedSegments: MiraFormalAudioLifecycleSegmentReceipt[] = [];
+  for (const segment of segments) {
+    const identity = {
+      classroomId: input.stage.id,
+      classroomContentSha256,
+      subject: input.subject,
+      teacherProfileId: subjectPolicy.teacherProfileId,
+      teacherProfileVersion: subjectPolicy.teacherProfileVersion,
+      teacherProfileSha256: subjectPolicy.teacherProfileSha256,
+      teacherGender: subjectPolicy.teacherGender,
+      sceneId: segment.sceneId,
+      sceneOrder: segment.sceneOrder,
+      actionId: segment.actionId,
+      narrationSegmentId: segment.narrationSegmentId,
+    } as const;
+    const ttsRequest: MiraFormalTtsRequest = {
+      requestId: segment.ttsRequestId,
+      ...identity,
+      text: segment.text,
+      textSha256: segment.textSha256,
+    };
+    let ttsRecord = await dependencies.readTtsJob(ttsRequest.requestId);
+    if (!ttsRecord) {
+      ensureProviderReady();
+      ttsRecord = (await dependencies.executeTts(ttsRequest)).record;
+    }
+    assertTtsRecord(ttsRecord, ttsRequest, subjectPolicy.voiceId);
+    const asset = await dependencies.readTtsAsset(ttsRequest.requestId);
+    if (
+      asset.record.requestSha256 !== ttsRecord.requestSha256 ||
+      asset.bytes.byteLength !== ttsRecord.sizeBytes ||
+      sha256(asset.bytes) !== ttsRecord.audioSha256
+    ) {
+      throw new Error(`FORMAL_AUDIO_TTS_ASSET_INVALID:${segment.sceneOrder}`);
+    }
+    await options.onProgress?.({
+      phase: 'tts',
+      completed: segment.sceneOrder + 1,
+      total: EXPECTED_SEGMENT_COUNT as 10,
+    });
+
+    const asrRequest: MiraFormalAsrRequest = {
+      requestId: segment.asrRequestId,
+      ttsRequestId: ttsRequest.requestId,
+      ...identity,
+      audioSha256: ttsRecord.audioSha256,
+    };
+    const transcriptEvidence = (transcript: string): MiraFormalAsrTranscriptEvidence => {
+      const expected = prepareMiraFormalAsrComparisonText(segment.text, input.subject);
+      const actual = prepareMiraFormalAsrComparisonText(transcript, input.subject);
+      return {
+        normalizedTranscriptSha256: sha256(normalizeMiraFormalAsrText(actual)),
+        similarityBps: miraFormalAsrSimilarityBps(expected, actual),
+      };
+    };
+    let asrRecord = await dependencies.readAsrJob(asrRequest.requestId);
+    if (!asrRecord) {
+      ensureProviderReady();
+      asrRecord = (await dependencies.executeAsr(asrRequest, transcriptEvidence)).record;
+    }
+    assertAsrRecord(asrRecord, asrRequest);
+    await options.onProgress?.({
+      phase: 'asr',
+      completed: segment.sceneOrder + 1,
+      total: EXPECTED_SEGMENT_COUNT as 10,
+    });
+    completedSegments.push({
+      sceneOrder: segment.sceneOrder,
+      sceneId: segment.sceneId,
+      actionId: segment.actionId,
+      narrationSegmentId: segment.narrationSegmentId,
+      sourceTextSha256: segment.sourceTextSha256,
+      textSha256: segment.textSha256,
+      tts: {
+        requestId: ttsRecord.requestId,
+        requestSha256: ttsRecord.requestSha256,
+        state: 'succeeded',
+        audioSha256: ttsRecord.audioSha256,
+        mimeType: 'audio/wav',
+        sizeBytes: ttsRecord.sizeBytes,
+        providerId: 'qwen-tts',
+        modelId: 'qwen3-tts-flash',
+        voiceId: ttsRecord.voiceId,
+        fallbackUsed: false,
+      },
+      asr: {
+        requestId: asrRecord.requestId,
+        requestSha256: asrRecord.requestSha256,
+        state: 'succeeded',
+        transcriptSha256: asrRecord.transcriptSha256,
+        normalizedTranscriptSha256: asrRecord.normalizedTranscriptSha256,
+        similarityBps: asrRecord.similarityBps,
+        providerId: 'qwen-asr',
+        modelId: 'qwen3-asr-flash',
+        fallbackUsed: false,
+      },
+    });
+  }
+
+  if (completedSegments.length !== EXPECTED_SEGMENT_COUNT) {
+    throw new Error('FORMAL_AUDIO_SEGMENT_COUNT_INVALID');
+  }
+  const receiptWithoutHash = {
+    schemaVersion: MIRA_FORMAL_AUDIO_LIFECYCLE_VERSION,
+    status: 'succeeded' as const,
+    buildItemId: input.buildItemId,
+    classroomId: input.stage.id,
+    classroomContentSha256,
+    subject: input.subject,
+    speechTextPolicyVersion: MIRA_FORMAL_SPEECH_TEXT_POLICY_VERSION,
+    teacherProfile: {
+      id: subjectPolicy.teacherProfileId,
+      version: subjectPolicy.teacherProfileVersion,
+      sha256: subjectPolicy.teacherProfileSha256,
+      gender: subjectPolicy.teacherGender,
+    },
+    expectedSegmentCount: EXPECTED_SEGMENT_COUNT as 10,
+    ttsSucceededCount: EXPECTED_SEGMENT_COUNT as 10,
+    asrPassedCount: EXPECTED_SEGMENT_COUNT as 10,
+    segments: completedSegments,
+  };
+  return {
+    ...receiptWithoutHash,
+    receiptSha256: canonicalSha256(receiptWithoutHash),
+  };
+}
