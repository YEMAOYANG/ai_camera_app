+import { createHash } from 'node:crypto';
+import type { Action } from '@/lib/types/action';
+import type { Scene, Stage } from '@/lib/types/stage';
+import {
+  assertMiraFormalAudioProviderReady,
+  executeMiraFormalAsr,
