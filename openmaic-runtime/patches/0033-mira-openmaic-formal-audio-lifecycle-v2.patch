+      schemaVersion: 'mira.openmaic.formal-audio-job.v1',
+      kind: 'tts',
+      requestId: request.requestId,
+      requestSha256: requestSha256(request),
+      classroomId: request.classroomId,
+      classroomContentSha256: request.classroomContentSha256,
+      subject: request.subject,
+      teacherProfileId: request.teacherProfileId,
+      teacherProfileVersion: request.teacherProfileVersion,
+      teacherProfileSha256: request.teacherProfileSha256,
+      teacherGender: request.teacherGender,
+      sceneId: request.sceneId,
+      sceneOrder: request.sceneOrder,
+      actionId: request.actionId,
