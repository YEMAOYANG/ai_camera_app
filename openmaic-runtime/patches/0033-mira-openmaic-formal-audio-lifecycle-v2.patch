+export const MIRA_FORMAL_AUDIO_LIFECYCLE_VERSION =
+  'mira.openmaic.formal-audio-lifecycle.v2' as const;
+export const MIRA_FORMAL_SPEECH_TEXT_POLICY_VERSION =
+  'mira.learning.formal-speech-text.v2' as const;
+
+const EXPECTED_SEGMENT_COUNT = 10;
+const MINIMUM_ASR_SIMILARITY_BPS = 8_500;
+const IDENTIFIER = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
+const SHA256 = /^[a-f0-9]{64}$/;
+const CHINESE_LATIN_TOKEN_PATTERN = /(?<![A-Za-z])([A-Za-z]+)(?![A-Za-z])/gu;
+const CHINESE_NUMBER_PATTERN = /\d+/gu;
+const CHINESE_DIGITS = '零一二三四五六七八九';
+const CHINESE_PINYIN_SPOKEN_TOKENS: Readonly<Record<string, string>> = {
+  a: '啊',
+  o: '喔',
+  e: '鹅',
+  i: '衣',
+  u: '乌',
+  b: '波',
+  p: '坡',
+  m: '摸',
+  f: '佛',
+  d: '得',
+  t: '特',
+  n: '讷',
+  l: '勒',
+  g: '哥',
+  k: '科',
+  h: '喝',
+  j: '鸡',
+  q: '七',
+  x: '西',
+  zh: '知',
+  ch: '吃',
+  sh: '诗',
+  r: '日',
+  z: '资',
+  c: '次',
+  s: '思',
+  y: '衣',
+  w: '乌',
+  ba: '八',
+  che: '车',
+};
+
+interface FormalAudioLifecycleInput {
+  buildItemId: string;
+  subject: MiraFormalAudioSubject;
+  stage: Stage;
+  scenes: Scene[];
+}
+
+interface FormalAudioLifecycleTtsReceipt {
+  requestId: string;
+  requestSha256: string;
+  state: 'succeeded';
+  audioSha256: string;
+  mimeType: 'audio/wav';
+  sizeBytes: number;
+  providerId: 'qwen-tts';
+  modelId: 'qwen3-tts-flash';
+  voiceId: 'Serena' | 'Ethan' | 'Jennifer';
+  fallbackUsed: false;
+}
+
+interface FormalAudioLifecycleAsrReceipt {
+  requestId: string;
+  requestSha256: string;
+  state: 'succeeded';
+  transcriptSha256: string;
+  normalizedTranscriptSha256: string;
+  similarityBps: number;
+  providerId: 'qwen-asr';
+  modelId: 'qwen3-asr-flash';
+  fallbackUsed: false;
+}
+
+export interface MiraFormalAudioLifecycleSegmentReceipt {
+  sceneOrder: number;
+  sceneId: string;
+  actionId: string;
+  narrationSegmentId: string;
+  sourceTextSha256: string;
