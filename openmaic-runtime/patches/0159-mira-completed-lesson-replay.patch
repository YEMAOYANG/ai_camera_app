diff --git a/tests/runtime/mira-student-runtime-events.test.ts b/tests/runtime/mira-student-runtime-events.test.ts
--- a/tests/runtime/mira-student-runtime-events.test.ts
+++ b/tests/runtime/mira-student-runtime-events.test.ts
@@ -641,3 +641,35 @@ it('reads accepted progress without flushing the rejected teaching completion, t
