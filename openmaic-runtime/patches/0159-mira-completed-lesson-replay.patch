+
+it('replays a finished lesson quietly on a device that never emitted its page markers', async () => {
+  const posted: unknown[] = [];
+  const client = createMiraStudentRuntimeEventClient({
+    classroomId: 'classroom-a',
+    storage: memoryStorage(),
+    fetcher: vi.fn(async (_input, init) => {
+      if ((init?.method ?? 'GET') === 'GET') return response({ ...status(17), completed: true });
+      posted.push(JSON.parse(String(init?.body)));
+      return response({ ok: false, error: 'unexpected_post' }, 500);
+    }),
+  });
+
+  // The page moved from index 2 to 3 after the lesson was finished, so neither
+  // marker matches anything this browser has stored.
+  await expect(
+    client.sceneEntered({ sceneIndex: 3, sceneId: 'scene-earth' }),
+  ).resolves.toBeUndefined();
+  await expect(
+    client.actionCompleted({ sceneIndex: 3, sceneId: 'scene-earth', actionId: 'action-earth' }),
+  ).resolves.toBeUndefined();
+  // Replay never manufactures new evidence for a closed stream.
+  await expect(
+    client.answerSubmitted({
+      sceneIndex: 3,
+      sceneId: 'scene-earth',
+      questionId: 'question-1',
+      response: 'A',
+    }),
+  ).rejects.toThrow('Mira Runtime event stream is already completed');
+  expect(posted).toEqual([]);
+});
