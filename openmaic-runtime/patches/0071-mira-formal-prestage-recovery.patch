+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { describe, expect, it, vi } from 'vitest';
+vi.mock('@/lib/persistence/server-provider', () => ({
+  getServerPersistenceProvider: vi.fn(() => {
+    throw new Error('DB must not be called');
+  }),
+}));
+import { validatePrestageHistory, PRESTAGE_JOB } from '@/lib/server/mira-formal-prestage-recovery';
+// Optional local diagnostic fixture: never query live DB or call a provider.
+const exported = resolve('../../../output/primary6-math-native-failed-session.json');
+const jobFile = resolve(`data/classroom-jobs/${PRESTAGE_JOB}.json`);
+describe.skipIf(!existsSync(exported) || !existsSync(jobFile))('reviewed pre-stage history', () => {
+  it('accepts the original frozen history and rejects state/identity drift without calling providers', () => {
+    const x = JSON.parse(readFileSync(exported, 'utf8'));
+    const source = {
+      job: JSON.parse(readFileSync(jobFile, 'utf8')),
+      session: x.session,
+      events: x.events,
+      entries: x.entries,
+      stageCount: 0,
+      sceneCount: 0,
+    };
+    expect(validatePrestageHistory(source)).toMatchObject({
+      jobId: PRESTAGE_JOB,
+      sessionSeq: 175,
+      remainingSearchAttempts: 1,
+    });
+    for (const changed of [
+      { ...source, stageCount: 1 },
+      { ...source, sceneCount: 1 },
+      { ...source, session: { ...source.session, attempt: 0 } },
+      { ...source, job: { ...source.job, formalInputSha256: '0'.repeat(64) } },
+      { ...source, events: source.events.slice(0, -1) },
+    ]) {
+      expect(() => validatePrestageHistory(changed)).toThrow(
+        'FORMAL_PRESTAGE_RECOVERY_SOURCE_MISMATCH',
+      );
+    }
+  });
+});
