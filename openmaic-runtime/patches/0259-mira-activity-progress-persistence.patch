+      releaseSha256:metadata.releaseSha256,contentSha256:metadata.contentSha256});
+    await act(async () => original.dispatchEvent(new Event('load')));
+    expect(visibility().at(-1)).toBe(false);
+    await act(async () => callbacks().onRestoring?.());
