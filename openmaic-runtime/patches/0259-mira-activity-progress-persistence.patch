+++ b/lib/mira/activity-checkpoint-client.ts
@@ -0,0 +1,206 @@
+/** UI continuity only. These snapshots never submit answers or learning credit. */
+export const ACTIVITY_CHECKPOINT_SCHEMA = 'mira.textbook.activity-state.v1';
+export type ActivityState = Record<string, unknown>;
+export type ActivityIdentity = {
+  classroomId: string; sceneId: string; sceneIndex: number;
+  releaseSha256: string; contentSha256: string;
+};
+type Descriptor = {
+  sceneId: string; sceneIndex: number; contentSha256: string;
+  revision: number; mutationId: string | null; state: ActivityState | null;
+};
+type Mutation = ActivityIdentity & {
+  schemaVersion: string; learningSessionId: string; expectedRevision: number; mutationId: string; state: ActivityState;
+};
+type Outbox = { version: 1; pending: Mutation | null; desired: ActivityState | null };
+
+export function activityState(value: unknown): ActivityState {
+  let nodes = 0;
+  const inspect = (item: unknown, depth: number): void => {
+    if (++nodes > 4096 || depth > 16) throw new Error('activity_state_invalid');
+    if (item === null || typeof item === 'boolean') return;
+    if (typeof item === 'number' && Number.isFinite(item) && Math.abs(item) <= Number.MAX_SAFE_INTEGER) return;
+    if (typeof item === 'string' && item.length <= 16000) return;
+    if (Array.isArray(item) && item.length <= 2000) { item.forEach(v => inspect(v, depth + 1)); return; }
+    if (item && typeof item === 'object' && Object.getPrototypeOf(item) === Object.prototype) {
+      for (const [key, child] of Object.entries(item)) {
+        if (!key || ['__proto__', 'constructor', 'prototype'].includes(key) || key.length > 128) throw new Error('activity_state_invalid');
+        inspect(child, depth + 1);
+      }
+      return;
+    }
+    throw new Error('activity_state_invalid');
+  };
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('activity_state_invalid');
+  inspect(value, 0);
+  const json = JSON.stringify(value);
+  if (new TextEncoder().encode(json).length > 48 * 1024) throw new Error('activity_state_too_large');
+  return JSON.parse(json) as ActivityState;
+}
+
+function canonical(value: unknown): string | undefined {
+  const ordered = (item: unknown): unknown => Array.isArray(item) ? item.map(ordered)
+    : item && typeof item === 'object' ? Object.fromEntries(Object.keys(item).sort()
+      .map(key => [key, ordered((item as Record<string, unknown>)[key])])) : item;
+  return JSON.stringify(ordered(value));
+}
+const equal = (a: unknown, b: unknown) => canonical(a) === canonical(b);
+const mutationIdentifier = () => typeof globalThis.crypto?.randomUUID === 'function'
+  ? globalThis.crypto.randomUUID()
+  : 'activity_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2);
+export function createActivityCheckpointClient(identity: ActivityIdentity, options: {
+  fetcher?: typeof fetch; storage?: Storage | null; onError?: (error: Error) => void;
+} = {}) {
+  const fetcher = options.fetcher ?? fetch;
+  let storage: Storage | null = options.storage ?? null;
+  if (options.storage === undefined) { try { storage = window.localStorage; } catch { /* server remains authoritative */ } }
+  let scope = '', learningSessionId = '', current: Descriptor | null = null, desired: ActivityState | null = null;
+  let pending: Mutation | null = null, saving: Promise<void> | null = null, closed = false;
+  let loaded = false, failureNotified = false, lastStored: string | null = null, conflicted = false;
+  const notify = (reason: unknown) => {
+    const error = reason instanceof Error ? reason : new Error('activity_checkpoint_failed');
+    if (!closed && !failureNotified) { failureNotified = true; options.onError?.(error); }
+    return error;
+  };
+  const descriptor = (value: unknown): Descriptor => {
+    const d = value as Descriptor;
+    if (!d || d.sceneId !== identity.sceneId || d.sceneIndex !== identity.sceneIndex
+        || d.contentSha256 !== identity.contentSha256 || !Number.isSafeInteger(d.revision) || d.revision < 0
+        || !(d.mutationId === null || typeof d.mutationId === 'string')) throw new Error('activity_identity_changed');
+    return { ...d, state: d.state === null ? null : activityState(d.state) };
+  };
+  const checkAuthority = (data: Record<string, unknown>) => {
+    if (data.ok !== true || data.schemaVersion !== ACTIVITY_CHECKPOINT_SCHEMA
+        || data.classroomId !== identity.classroomId || data.releaseSha256 !== identity.releaseSha256
+        || typeof data.learningSessionId !== 'string' || !data.learningSessionId) throw new Error('activity_identity_changed');
+    const nextScope = 'mira:activity-checkpoint:v1:' + encodeURIComponent(JSON.stringify([
+      data.learningSessionId, identity.classroomId, identity.releaseSha256, identity.sceneId, identity.contentSha256,
+    ]));
+    if (scope && scope !== nextScope) throw new Error('activity_session_changed');
+    scope = nextScope;
+    learningSessionId = data.learningSessionId;
+  };
+  const persist = () => {
+    if (!scope || !storage || closed || conflicted) return;
+    try {
+      if (storage.getItem(scope) !== lastStored) {
+        conflicted = true;
+        notify(new Error('activity_state_conflict'));
+        return;
+      }
+      if (!pending && equal(desired, current?.state)) { storage.removeItem(scope); lastStored = null; }
+      else {
+        const nextStored = JSON.stringify({ version: 1, pending, desired } satisfies Outbox);
+        storage.setItem(scope, nextStored);
+        lastStored = nextStored;
+      }
+    } catch {
+      // A full browser quota must not disable the authoritative server writes.
+      storage = null;
+      notify(new Error('activity_local_buffer_unavailable'));
+    }
+  };
+  const request = async (body?: Mutation) => {
+    const controller = new AbortController();
+    const deadline = setTimeout(() => controller.abort(), 12000);
+    try {
+      // The endpoint uses the existing HttpOnly classroom ticket. No token enters Storage.
+      const response = await fetcher('/mira/activity-state', {
+        method: body ? 'POST' : 'GET', credentials: 'same-origin', cache: 'no-store',
+        headers: body ? { 'Content-Type': 'application/json' } : undefined,
+        body: body ? JSON.stringify(Object.fromEntries(Object.entries(body).filter(([key]) => key !== 'classroomId'))) : undefined,
+        keepalive: !!body, signal: controller.signal,
+      });
+      if (!response.ok) throw new Error(response.status === 409 ? 'activity_state_conflict' : 'activity_checkpoint_unavailable');
+      const result = await response.json() as Record<string, unknown>;
+      checkAuthority(result);
+      return result;
+    } finally { clearTimeout(deadline); }
+  };
+  const flush = (): Promise<void> => {
+    if (saving) return saving;
+    if (!loaded || closed) return Promise.resolve();
+    saving = (async () => {
+      while (!closed && !conflicted && current && (pending || !equal(desired, current.state))) {
+        if (!pending) {
+          if (desired === null) break;
+          pending = { ...identity, schemaVersion: ACTIVITY_CHECKPOINT_SCHEMA, learningSessionId,
+            expectedRevision: current.revision, mutationId: mutationIdentifier(), state: desired };
+          persist();
+        }
+        const sent = pending;
+        const result = await request(sent);
+        const accepted = descriptor(result.activity);
+        // Replaying an old idempotency key must never overwrite a newer document's work.
+        if (accepted.mutationId !== sent.mutationId || accepted.revision < sent.expectedRevision + 1)
+          throw new Error('activity_state_conflict');
+        current = accepted;
+        pending = null;
+        failureNotified = false;
+        persist();
+      }
+    })().catch(reason => {
+      if (reason instanceof Error && reason.message === 'activity_state_conflict') conflicted = true;
+      throw notify(reason);
+    }).finally(() => { saving = null; });
+    return saving;
+  };
+  return {
+    async load(): Promise<ActivityState | null> {
+      try {
+        const result = await request();
+        if (closed) throw new Error('activity_checkpoint_closed');
+        if (!Array.isArray(result.activities)) throw new Error('activity_identity_changed');
+        current = descriptor(result.activities.find((d: Descriptor) => d.sceneId === identity.sceneId));
+        desired = current.state;
+        let raw: string | null = null;
+        try { raw = storage?.getItem(scope) ?? null; lastStored = raw; } catch { notify(new Error('activity_local_buffer_unavailable')); }
+        if (raw) {
+          const saved = JSON.parse(raw) as Outbox;
+          if (saved.version !== 1) throw new Error('activity_local_buffer_invalid');
+          if (saved.pending) {
+            const p = saved.pending;
+            if (p.learningSessionId !== learningSessionId || p.classroomId !== identity.classroomId || p.sceneId !== identity.sceneId || p.sceneIndex !== identity.sceneIndex
+                || p.releaseSha256 !== identity.releaseSha256 || p.contentSha256 !== identity.contentSha256
+                || p.schemaVersion !== ACTIVITY_CHECKPOINT_SCHEMA || !Number.isSafeInteger(p.expectedRevision)
+                || p.expectedRevision < 0 || typeof p.mutationId !== 'string') throw new Error('activity_local_buffer_invalid');
+            pending = { ...p, state: activityState(p.state) };
+          }
+          desired = saved.desired === null ? null : activityState(saved.desired);
+        }
+        loaded = true;
+        await flush();
+        return current.state;
+      } catch (reason) {
+        // A stale tab's obsolete outbox cannot trap the returning learner in a
+        // permanent conflict. Read the accepted state; never replay stale UI on it.
+        if (reason instanceof Error && reason.message === 'activity_state_conflict' && !closed) {
+          const result = await request();
+          if (!Array.isArray(result.activities)) throw new Error('activity_identity_changed');
+          current = descriptor(result.activities.find((d: Descriptor) => d.sceneId === identity.sceneId));
+          pending = null; desired = current.state; conflicted = false; persist();
+          if (conflicted) { loaded = false; throw notify(reason); }
+          loaded = true;
+          return current.state;
+        }
+        loaded = false; throw notify(reason);
+      }
+    },
+    save(value: unknown): boolean {
+      if (!loaded || closed || conflicted) return false;
+      try {
+        const next = activityState(value);
+        if (equal(next, desired)) return true;
+        desired = next;
+        // Persist before the first await: immediate reload can retry the same mutation.
+        if (!pending && current) pending = { ...identity, schemaVersion: ACTIVITY_CHECKPOINT_SCHEMA, learningSessionId,
+          expectedRevision: current.revision, mutationId: mutationIdentifier(), state: next };
+        persist();
+        void flush().catch(() => undefined);
+        return !conflicted;
+      } catch (reason) { notify(reason); return false; }
+    },
+    flush,
+    close() { closed = true; },
+  };
+}
diff --git a/lib/mira/activity-checkpoint-bridge.ts b/lib/mira/activity-checkpoint-bridge.ts
