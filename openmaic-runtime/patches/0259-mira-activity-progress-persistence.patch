+describe('activity checkpoint restoration and narration fence', () => {
+  beforeEach(() => {
+    vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true);
+    useInteractiveIframePool.getState().reset();
+    useStageStore.setState({stage:null,scenes:[],currentSceneId:null});
+    releasePageNarrationPause(); setLectureSpeaking(false);
+    messages = vi.fn(); mocks.connect.mockClear(); mocks.disconnect.mockClear();
+    const view = {postMessage:messages} as unknown as Window;
+    vi.spyOn(HTMLIFrameElement.prototype,'contentWindow','get').mockReturnValue(view);
+  });
+  afterEach(async () => {
+    await act(async () => root?.unmount()); root = undefined;
+    useStageStore.setState({stage:null,scenes:[],currentSceneId:null});
+    useInteractiveIframePool.getState().reset(); document.body.replaceChildren();
+    vi.restoreAllMocks(); vi.unstubAllGlobals();
+    releasePageNarrationPause(); setLectureSpeaking(false);
+  });
+
+  it('keeps metadata-free legacy classrooms playable without a checkpoint connection', async () => {
+    await mount(false);
+    expect(mocks.connect).not.toHaveBeenCalled();
+    expect(visibility().at(-1)).toBe(true);
+    await act(async () => frame().dispatchEvent(new Event('load')));
+    expect(visibility().at(-1)).toBe(true);
+    expect(frame().srcdoc).toContain('original activity');
+    expect(frame().getAttribute('sandbox')).toBe('allow-scripts allow-forms allow-popups');
+  });
+
+  it('does not gate an older activity that has backend metadata but no supported adapter marker', async () => {
+    await mount(true, false);
+    expect(mocks.connect).not.toHaveBeenCalled();
