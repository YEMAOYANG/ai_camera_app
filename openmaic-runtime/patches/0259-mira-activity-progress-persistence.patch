+function authoredGame(hooks = true) {
+  return `<button id="forward">向前一步</button><output id="position">0</output>
+<script>
+window.game={step:0,history:[],clicks:0,audio:0,restoreCalls:0,beginCalls:0};
+document.querySelector('#forward').onclick=function(event){game.step++;game.history.push(game.step);game.clicks++;game.audio++;document.querySelector('#position').textContent=String(game.step);document.body.dataset.trusted=String(event.isTrusted)};
