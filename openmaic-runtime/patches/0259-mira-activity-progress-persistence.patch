+    expect(fetcher).toHaveBeenCalledTimes(1); client.close();
+  });
+
+  it('accepts only bounded plain JSON state and does not alias caller objects', () => {
+    const source = { nested: [1, true, null, '汉字'] }; const copy = activityState(source);
+    source.nested[0] = 9; expect(copy).toEqual({ nested: [1, true, null, '汉字'] });
+    const invalid = [null, [], new Date(), { x: NaN }, { x: Infinity }, { x: undefined },
+      JSON.parse('{"__proto__":{}}'), { x: 'x'.repeat(16001) }, { x: Array(2001).fill(1) }];
+    for (const value of invalid) expect(() => activityState(value)).toThrow('activity_state_invalid');
+    expect(() => activityState({ a: '汉'.repeat(16000), b: '汉'.repeat(1000) })).toThrow('activity_state_too_large');
+  });
+});
