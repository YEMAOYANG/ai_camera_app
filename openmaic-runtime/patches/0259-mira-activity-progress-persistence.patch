--- /dev/null
+++ b/lib/mira/activity-checkpoint-bridge.ts
@@ -0,0 +1,157 @@
+import { activityState, createActivityCheckpointClient, type ActivityIdentity } from './activity-checkpoint-client';
+
+/** Separate from participation/assessment channels; no completion or grading calls. */
+export function connectActivityCheckpointFrame(options: {
+  frame: HTMLIFrameElement; identity: ActivityIdentity; active: () => boolean;
+  onError: (error: Error) => void; fetcher?: typeof fetch; storage?: Storage | null;
+  onReady?: () => void; onRestoring?: () => void;
+}): () => void {
+  let alive = true, channel: MessageChannel | null = null;
+  let retry: ReturnType<typeof setTimeout> | undefined;
+  let client: ReturnType<typeof createActivityCheckpointClient> | null = null;
+  let connectedDocument: string | null = null;
+  let restoring: Promise<unknown> | null = null;
+  const connect = () => {
+    if (!alive) return;
+    clearTimeout(retry);
+    channel?.port1.close();
+    const current = new MessageChannel(); channel = current;
+    let ready = false;
+    current.port1.onmessage = async event => {
+      if (!alive || channel !== current) return;
+      const data = event.data;
+      if (data?.type === 'mira:checkpoint-unsupported') { clearTimeout(retry); options.onReady?.(); return; }
+      if (data?.type === 'mira:checkpoint-ready' && typeof data.documentId === 'string') {
+        clearTimeout(retry);
+        if (connectedDocument !== data.documentId) {
+          options.onRestoring?.();
+          client?.close();
+          client = createActivityCheckpointClient(options.identity, options);
+          connectedDocument = data.documentId;
+          restoring = client.load();
+        }
+        try {
+          const state = await restoring;
+          if (!alive || channel !== current) return;
+          current.port1.postMessage({ type: 'mira:checkpoint-restore', state, active: options.active() });
+        } catch {
+          // Keep the old server snapshot; never replace it with fresh initial state.
+          if (alive && channel === current) current.port1.postMessage({ type: 'mira:checkpoint-unavailable' });
+        }
+        return;
+      }
+      if (data?.type === 'mira:checkpoint-restored') { ready = true; options.onReady?.(); return; }
+      if (data?.type === 'mira:checkpoint-rejected') {
+        ready = false;
+        current.port1.postMessage({ type: 'mira:checkpoint-unavailable' });
+        options.onError(new Error('activity_restore_rejected')); return;
+      }
+      if (data?.type === 'mira:checkpoint-state' && ready && options.active()) {
+        try {
+          const accepted = client?.save(activityState(data.state)) === true;
+          current.port1.postMessage({ type: 'mira:checkpoint-captured', snapshotId: data.snapshotId, accepted });
+        } catch (error) { options.onError(error as Error); }
+      } else if (data?.type === 'mira:checkpoint-state') {
+        current.port1.postMessage({ type: 'mira:checkpoint-captured', snapshotId: data.snapshotId, accepted: false });
+      }
+    };
+    retry = setTimeout(connect, 500);
+    options.frame.contentWindow?.postMessage({ type: 'mira:activity-checkpoint-connect' }, '*', [current.port2]);
+  };
+  const flush = () => { void client?.flush().catch(() => undefined); };
+  options.frame.addEventListener('load', connect);
+  window.addEventListener('pagehide', flush);
+  window.addEventListener('online', flush);
+  connect();
+  return () => {
+    alive = false; clearTimeout(retry);
+    flush(); client?.close();
+    options.frame.removeEventListener('load', connect);
+    window.removeEventListener('pagehide', flush);
+    window.removeEventListener('online', flush);
+    channel?.port1.close();
+  };
+}
+
+/** A private port, sandbox preserved. Restoring does not replay input or teacher cues. */
+export const ACTIVITY_CHECKPOINT_SHIM = `<script data-mira-activity-checkpoint>
+(function () {
+  var port = null, hydrated = false, restoring = false, last = null, notice = null, sent = null, sequence = 0, fresh = false;
+  var documentId = Math.random().toString(36).slice(2) + Date.now().toString(36);
+  function contract() {
+    var api = window.miraActivityCheckpoint;
+    return api && api.version === 1 && typeof api.capture === 'function' && typeof api.restore === 'function' ? api : null;
+  }
+  function send(data) { if (port) { try { port.postMessage(data); } catch (_) {} } }
+  function status(text) {
+    if (!document.body) return;
+    if (!notice) {
+      notice = document.createElement('div'); notice.setAttribute('role','status');
+      notice.setAttribute('data-mira-progress-notice','');
+      notice.style.cssText = 'position:fixed;left:50%;top:8px;transform:translateX(-50%);z-index:2147483646;padding:6px 12px;border-radius:10px;background:#fff;color:#334155;font:14px system-ui;box-shadow:0 1px 6px #0002;';
+      document.body.appendChild(notice);
+    }
+    notice.textContent = text; notice.hidden = !text;
+  }
+  function capture() {
+    if (!port || !hydrated || restoring) return;
+    var api = contract(); if (!api) return;
+    try {
+      var state = api.capture(), json = JSON.stringify(state);
+      if (!json || json.length > 49152 || json === last || (sent && sent.json === json)) return;
+      sent = {id:++sequence,json:json};
+      send({type:'mira:checkpoint-state', snapshotId:sent.id, state:JSON.parse(json)});
+    } catch (_) { send({type:'mira:checkpoint-rejected'}); }
+  }
+  window.addEventListener('message', function (event) {
+    if (event.source !== window.parent) return;
+    if (event.data?.type === 'MIRA_NARRATION_VISIBILITY') {
+      if (event.data.visible === true && hydrated && fresh) {
+        fresh = false;
+        queueMicrotask(function () { var api = contract(); if (api && typeof api.begin === 'function') api.begin(); });
+      }
+      return;
+    }
+    if (event.data?.type !== 'mira:activity-checkpoint-connect' || !event.ports[0]) return;
+    event.stopImmediatePropagation();
+    if (port) port.close(); port = event.ports[0]; sent = null;
+    port.onmessage = function (message) {
+      var data = message.data;
+      if (data?.type === 'mira:checkpoint-captured' && sent && data.snapshotId === sent.id) {
+        if (data.accepted === true) last = sent.json;
+        sent = null; return;
+      }
+      if (data?.type === 'mira:checkpoint-unavailable') {
+        status('进度暂时无法恢复，请重新进入课堂。'); return;
+      }
+      if (data?.type !== 'mira:checkpoint-restore') return;
+      try {
+        if (!hydrated) {
+          fresh = data.state === null;
+          if (!fresh) {
+            restoring = true;
+            if (contract().restore(data.state) !== true) throw new Error('invalid_checkpoint');
+          }
+        }
