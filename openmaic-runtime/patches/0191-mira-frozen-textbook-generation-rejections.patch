--- /dev/null
+++ b/lib/server/mira-textbook-rejected-scene.ts
@@ -0,0 +1,77 @@
+import { createHash } from 'node:crypto';
+import { constants, promises as fs } from 'node:fs';
+import path from 'node:path';
+
+export interface RejectedSceneReceipt {
+  status: 'rejected';
+  archiveId?: string;
+  archiveSha256?: string;
+  sceneSha256: string;
+  archivalStatus: 'saved' | 'failed';
+}
+
+/** Preserve existing TEXTBOOK_SCENE_* messages; details do not weaken the gate. */
+export class TextbookSceneValidationError extends Error {
+  rejection?: RejectedSceneReceipt;
+  constructor(readonly code: string, readonly diagnostics: Record<string, unknown> = {}, originalMessage?: string) {
+    super(originalMessage ?? `TEXTBOOK_SCENE_${code}`);
+    this.name = 'TextbookSceneValidationError';
+  }
+}
+
+const sha = (value: string) => createHash('sha256').update(value).digest('hex');
+
+/** Private, content-addressed evidence only. Never a classroom or success ledger. */
+export async function archiveRejectedTextbookScene(input: {
+  root: string;
+  sessionId: string;
+  stageId: string;
+  sceneCanonicalJson: string;
+  contractSha256: string;
+  beforeDocumentSha256: string;
+  beforeCandidateSha256: string;
+  code: string;
+  diagnostics: Record<string, unknown>;
+}): Promise<RejectedSceneReceipt> {
+  if (!/^[A-Za-z0-9_-]{1,160}$/.test(input.stageId) || !input.sessionId)
+    throw new Error('REJECTED_SCENE_IDENTITY_INVALID');
+  for (const value of [input.contractSha256, input.beforeDocumentSha256, input.beforeCandidateSha256])
+    if (!/^[a-f0-9]{64}$/.test(value)) throw new Error('REJECTED_SCENE_HASH_INVALID');
+  const sceneSha256 = sha(input.sceneCanonicalJson);
+  const body = JSON.stringify({
+    schemaVersion: 'mira.textbook.rejected-scene.v1', status: 'rejected',
+    verification: 'rejected_not_saved_not_reviewed', sessionId: input.sessionId,
+    stageId: input.stageId, contractSha256: input.contractSha256,
+    beforeDocumentSha256: input.beforeDocumentSha256,
+    beforeCandidateSha256: input.beforeCandidateSha256,
+    sceneSha256, sceneCanonicalJson: input.sceneCanonicalJson,
+    error: { code: input.code, diagnostics: input.diagnostics },
+  }) + '\n';
+  const archiveSha256 = sha(body);
+  // No raw owner/session identity or user-controlled path component is exposed.
+  const parts = [sha(input.sessionId), input.stageId];
+  let directory = path.resolve(input.root);
+  for (const part of [null, ...parts]) {
+    if (part) directory = path.join(directory, part);
+    await fs.mkdir(directory, { recursive: true, mode: 0o700 });
+    const stat = await fs.lstat(directory);
+    if (!part && !stat.isSymbolicLink()) directory = await fs.realpath(directory);
+    if (stat.isSymbolicLink() || !stat.isDirectory() || await fs.realpath(directory) !== directory)
+      throw new Error('REJECTED_SCENE_PRIVATE_PATH_INVALID');
+    await fs.chmod(directory, 0o700);
+  }
+  const file = path.join(directory, `${archiveSha256}.json`);
+  try {
+    const handle = await fs.open(file, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, 0o600);
+    try { await handle.writeFile(body); await handle.sync(); } finally { await handle.close(); }
+  } catch (error: any) {
+    if (error.code !== 'EEXIST') throw error;
+    const handle = await fs.open(file, constants.O_RDONLY | constants.O_NOFOLLOW);
+    try {
+      if (!(await handle.stat()).isFile() || await handle.readFile('utf8') !== body)
+        throw new Error('REJECTED_SCENE_ARCHIVE_COLLISION');
+    } finally { await handle.close(); }
+  }
+  return { status: 'rejected', archivalStatus: 'saved', sceneSha256, archiveSha256,
+    archiveId: [...parts, `${archiveSha256}.json`].join('/') };
+}
