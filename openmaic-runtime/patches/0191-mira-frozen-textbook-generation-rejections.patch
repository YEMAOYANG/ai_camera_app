+import { describe, expect, it } from 'vitest';
+import { buildPrompt, generateSceneContent, generateWidgetContent, type SceneOutline } from '@openmaic/generation';
+
+const kinds = ['simulation', 'diagram', 'game', 'visualization3d', 'procedural-skill'] as const;
+const precise = { concept: 'frozen goal', gameType: 'memory-with-revision',
+  keyVariables: { domain: 'positions' }, playerControls: 'listen then move; may revise',
+  notTeachingFlowchart: true, geometry: { stroke: 'M0 0 L30 10', sourceSha256: 'a'.repeat(64) } };
+const outline = (widgetType: (typeof kinds)[number]): SceneOutline => ({
+  id: 'frozen-page', order: 2, title: 'Prescribed task', description: 'change domain state',
+  type: 'interactive', widgetType, widgetOutline: precise, keyPoints: ['scope only'],
+});
+const response = '<html><head></head><body><script id="widget-config" type="application/json">{"type":"game"}</script></body></html>';
+
+describe('server-only frozen-textbook-v1 routing', () => {
+  it.each(kinds)('routes %s through the new contract without generic contradictory instructions', async kind => {
+    let captured = { system: '', user: '' };
+    await generateSceneContent(outline(kind), async (system, user) => { captured = { system, user }; return response; }, {
+      textbookPromptProfile: 'frozen-textbook-v1', allowProceduralSkill: true,
+      interactiveIncludeKatex: false, includeWidgetOutline: true, editDirective: 'exact source controller here',
+      exactActions: [{ id: 'speech-intro', type: 'speech', text: 'exact words' }],
+      assignedImages: [{ id: 'real', pageNumber: 1, src: '/api/classroom-media/stage-fixture/media/real.png', description: 'real teaching picture' }],
+    });
+    expect(captured.system).toContain('# Frozen Textbook Interactive Authoring v1');
+    expect(captured.system).toContain('exactly one `<meta name="mira-responsive-activity"');
+    expect(captured.system).toContain('mira.interactive.narration-cues.v1');
+    expect(captured.system).toContain('only ready after matching playing');
+    expect(captured.system).toContain('If required source bytes or exact implementation details are absent');
+    expect(captured.user).toContain(JSON.stringify(precise));
+    expect(captured.user).toContain('exact source controller here');
+    expect(captured.user).toContain('speech-intro');
+    expect(captured.user).toContain('/api/classroom-media/stage-fixture/media/real.png');
+    expect(captured.system + captured.user).not.toMatch(/localStorage|sessionStorage|indexedDB|speedBonus|correctPoints|56 CSS|44px|Do not use external media assets|\{\{/);
+    expect(captured.user).toContain('memory-with-revision');
+    expect(captured.system).toContain('touch dimensions');
+  });
+  it('does not enable procedural widgets when the existing capability is absent', async () => {
+    let calls = 0;
+    expect(await generateWidgetContent(outline('procedural-skill'), async () => { calls++; return response; }, '', { textbookPromptProfile: 'frozen-textbook-v1' })).toBeNull();
+    expect(calls).toBe(0);
+  });
+  it.each(['game', 'visualization3d'] as const)('keeps historical textbook-v1 %s system and user bytes exact', async kind => {
+    let captured: unknown;
+    const o = { ...outline(kind), widgetOutline: { gameType: 'quiz', visualizationType: 'geometry' as const, objects: [], interactions: [] } };
+    await generateSceneContent(o, async (system, user) => { captured = { system, user }; return response; }, { textbookPromptProfile: 'textbook-v1' });
+    const variables = { title: o.title, description: o.description, keyPoints: o.keyPoints.join('\n'), languageDirective: '',
+      ...(kind === 'game' ? { gameType: 'Choose puzzle, card or strategy with picture matching, placement, sorting or building for the exact frozen objective. No quiz or assessment.', scoring: {} }
+        : { visualizationType: 'geometry', objects: [], interactions: [] }) };
+    expect(captured).toEqual(buildPrompt(kind === 'game' ? 'textbook-game-content' : 'textbook-visualization3d-content', variables));
+  });
+});
