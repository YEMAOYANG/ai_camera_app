new file mode 100644
index 0000000..76e92e2
--- /dev/null
+++ b/lib/playback/audio-availability.ts
@@ -0,0 +1,15 @@
+import type { Action, SpeechAction } from '@/lib/types/action';
+
+/** Whether a speech action points at already-generated narration audio. */
+export function hasSpeechAudioReference(
+  action: Pick<SpeechAction, 'audioId' | 'audioUrl'>,
+): boolean {
+  return Boolean(action.audioId?.trim() || action.audioUrl?.trim());
+}
+
+/** Whether a playback timeline contains any already-generated narration audio. */
+export function hasPreGeneratedSpeechAudio(actions: readonly Action[] | undefined): boolean {
+  return Boolean(
+    actions?.some((action) => action.type === 'speech' && hasSpeechAudioReference(action)),
+  );
+}
