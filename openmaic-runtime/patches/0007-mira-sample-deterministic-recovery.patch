+    process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_ENABLED = '1';
+    process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_SOURCE_JOB_ID = 'uKQl3vMr4d';
+    process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_PATCH_SHA256 = 'c'.repeat(64);
+    process.env.MIRA_INTERNAL_API_TOKEN = 'internal-test-token';
