+      error: 'structured_output_exhausted',
+      scenesGenerated: 4,
+      totalScenes: 10,
+      completedAt: '2026-08-18T10:36:50.864Z',
+      jobSnapshotSha256: 'a'.repeat(64),
+      jobSnapshotHashBasis: 'canonical_json_v1',
+      rawJobFileSha256: 'raw-do-not-expose',
+    },
+    policy: {
+      marker: 'MIRA_OPENMAIC_SAMPLE_STRUCTURAL_POLICY_V1',
+      version: 'mira-sample-deterministic-classroom.v1',
+      canonicalSpecSha256: 'b'.repeat(64),
+      patchSha256: 'c'.repeat(64),
+    },
+    calls: {
+      llm: 0,
+      webSearch: 0,
+      imageGeneration: 0,
+      videoGeneration: 0,
+      tts: {
+        expected: 10,
+        attempted: status === 'succeeded' ? 10 : 0,
+        completed: status === 'succeeded' ? 10 : 0,
+      },
+    },
+    status,
+    step: status === 'queued' ? 'queued' : status,
+    progress: status === 'succeeded' ? 100 : 0,
+    message: 'safe status',
+    scenesGenerated: status === 'succeeded' ? 10 : 0,
+    totalScenes: 10,
+    createdAt: '2026-08-18T11:00:00.000Z',
+    updatedAt: '2026-08-18T11:00:00.000Z',
+    ...(status === 'succeeded'
+      ? {
+          completedAt: '2026-08-18T11:02:00.000Z',
+          artifact: {
+            classroomId: 'classroom-1',
+            url: '/classroom/classroom-1',
+            sceneCount: 10,
+            contentSha256: 'd'.repeat(64),
+            artifactSha256: 'e'.repeat(64),
