+    mocks.claim.mockResolvedValueOnce({ record: record('running'), created: false });
+    const repeated = await POST(request(exactBody), {
+      params: Promise.resolve({ jobId: 'uKQl3vMr4d' }),
+    });
+    expect(repeated.status).toBe(202);
+    expect(mocks.after).toHaveBeenCalledTimes(1);
+  });
+
+  it('rejects contract drift, forwarded/public requests, and invalid credentials before claim', async () => {
+    const { POST } =
+      await import('@/app/api/generate-classroom/[jobId]/deterministic-recovery/route');
+    const extra = await POST(request({ ...exactBody, extra: true }), {
+      params: Promise.resolve({ jobId: 'uKQl3vMr4d' }),
+    });
+    expect(extra.status).toBe(400);
+
+    const publicRequest = request(
+      exactBody,
+      'http://192.168.1.50:3100/api/generate-classroom/uKQl3vMr4d/deterministic-recovery',
+    );
+    const publicResponse = await POST(publicRequest, {
+      params: Promise.resolve({ jobId: 'uKQl3vMr4d' }),
+    });
+    expect(publicResponse.status).toBe(403);
+
+    const badToken = request(exactBody);
+    badToken.headers.set('x-mira-internal-token', 'wrong-token');
+    const denied = await POST(badToken, {
+      params: Promise.resolve({ jobId: 'uKQl3vMr4d' }),
+    });
+    expect(denied.status).toBe(403);
+    expect(mocks.claim).not.toHaveBeenCalled();
+  });
+
+  it('accepts only the exact Next 16 direct-loopback header topology', async () => {
+    mocks.claim.mockResolvedValue({ record: record('queued'), created: false });
+    const { POST } =
+      await import('@/app/api/generate-classroom/[jobId]/deterministic-recovery/route');
+    const exact = await POST(request(exactBody), {
+      params: Promise.resolve({ jobId: 'uKQl3vMr4d' }),
+    });
+    expect(exact.status).toBe(202);
+    expect(mocks.claim).toHaveBeenCalledOnce();
+
+    const adversarialCases: Array<[string, (req: NextRequest) => void]> = [
+      ['public forwarded-for', (req) => req.headers.set('x-forwarded-for', '203.0.113.8')],
+      [
+        'mixed forwarded-for chain',
+        (req) => req.headers.set('x-forwarded-for', '127.0.0.1, 203.0.113.8'),
+      ],
+      ['missing forwarded-for', (req) => req.headers.delete('x-forwarded-for')],
+      ['missing host', (req) => req.headers.delete('host')],
+      ['missing forwarded-host', (req) => req.headers.delete('x-forwarded-host')],
+      ['missing forwarded-proto', (req) => req.headers.delete('x-forwarded-proto')],
+      ['missing forwarded-port', (req) => req.headers.delete('x-forwarded-port')],
+      ['forwarded-for with port', (req) => req.headers.set('x-forwarded-for', '127.0.0.1:3100')],
