@@ -0,0 +1,103 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { generateTTS, QWEN_TTS_REQUEST_TIMEOUT_MS } from '@/lib/audio/tts-providers';
+
+describe('Qwen TTS bounded network contract', () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+  });
+
+  it('uses a separate fixed AbortSignal for synthesis and audio download with no retry', async () => {
+    const synthesisSignal = new AbortController().signal;
+    const downloadSignal = new AbortController().signal;
+    const timeout = vi
+      .spyOn(AbortSignal, 'timeout')
+      .mockReturnValueOnce(synthesisSignal)
+      .mockReturnValueOnce(downloadSignal);
+    const fetchMock = vi
+      .fn()
+      .mockResolvedValueOnce({
+        ok: true,
+        json: async () => ({ output: { audio: { url: 'https://audio.invalid/qwen.wav' } } }),
+      })
+      .mockResolvedValueOnce({
+        ok: true,
+        arrayBuffer: async () => Uint8Array.from([82, 73, 70, 70]).buffer,
+      });
+    vi.stubGlobal('fetch', fetchMock);
+
+    const result = await generateTTS(
+      {
+        providerId: 'qwen-tts',
+        modelId: 'qwen3-tts-flash',
+        apiKey: 'offline-test-key',
+        baseUrl: 'https://dashscope.invalid/api/v1',
+        voice: 'Serena',
+      },
+      '我们来认识二十以内的数。',
+    );
+
+    expect(result.audio).toEqual(Uint8Array.from([82, 73, 70, 70]));
+    expect(timeout.mock.calls).toEqual([
+      [QWEN_TTS_REQUEST_TIMEOUT_MS],
+      [QWEN_TTS_REQUEST_TIMEOUT_MS],
+    ]);
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+    expect(fetchMock.mock.calls[0][1]).toMatchObject({ signal: synthesisSignal });
+    expect(fetchMock.mock.calls[1][1]).toEqual({ signal: downloadSignal });
+  });
+
+  it('propagates a synthesis timeout after one attempt and never starts the download', async () => {
+    const timeout = vi.spyOn(AbortSignal, 'timeout').mockReturnValue(new AbortController().signal);
+    const timeoutError = new Error('offline timeout');
+    timeoutError.name = 'TimeoutError';
+    const fetchMock = vi.fn().mockRejectedValueOnce(timeoutError);
+    vi.stubGlobal('fetch', fetchMock);
+
+    await expect(
+      generateTTS(
+        {
+          providerId: 'qwen-tts',
+          modelId: 'qwen3-tts-flash',
+          apiKey: 'offline-test-key',
+          baseUrl: 'https://dashscope.invalid/api/v1',
+          voice: 'Serena',
+        },
+        '第一段语音',
+      ),
+    ).rejects.toMatchObject({ name: 'TimeoutError' });
+    expect(timeout).toHaveBeenCalledOnce();
+    expect(fetchMock).toHaveBeenCalledOnce();
+  });
+
+  it('propagates an audio download timeout after exactly one synthesis and one download', async () => {
+    const timeout = vi
+      .spyOn(AbortSignal, 'timeout')
+      .mockReturnValue(new AbortController().signal);
+    const timeoutError = new Error('offline audio download timeout');
+    timeoutError.name = 'TimeoutError';
+    const fetchMock = vi
+      .fn()
+      .mockResolvedValueOnce({
+        ok: true,
+        json: async () => ({ output: { audio: { url: 'https://audio.invalid/qwen.wav' } } }),
+      })
+      .mockRejectedValueOnce(timeoutError);
+    vi.stubGlobal('fetch', fetchMock);
+
+    await expect(
+      generateTTS(
+        {
+          providerId: 'qwen-tts',
+          modelId: 'qwen3-tts-flash',
+          apiKey: 'offline-test-key',
+          baseUrl: 'https://dashscope.invalid/api/v1',
+          voice: 'Serena',
+        },
+        '第四段语音',
+      ),
+    ).rejects.toMatchObject({ name: 'TimeoutError' });
+    expect(timeout).toHaveBeenCalledTimes(2);
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+  });
+});
