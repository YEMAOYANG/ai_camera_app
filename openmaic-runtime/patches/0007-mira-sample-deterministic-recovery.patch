+        (req) => req.headers.set('x-forwarded-for', '::ffff:127.0.0.1'),
+      ],
+      ['zone-id forwarded-for', (req) => req.headers.set('x-forwarded-for', 'fe80::1%lo0')],
+      ['public host', (req) => req.headers.set('host', '192.168.1.50:3100')],
+      ['multi host', (req) => req.headers.set('host', '127.0.0.1:3100, localhost:3100')],
