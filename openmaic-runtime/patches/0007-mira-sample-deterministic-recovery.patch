+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Scene } from '@/lib/types/stage';
+
+const mocks = vi.hoisted(() => ({
+  generateTTS: vi.fn(),
+  mkdir: vi.fn(),
+  writeFile: vi.fn(),
+  stat: vi.fn(),
+}));
+
+vi.mock('fs', () => ({
+  promises: {
+    mkdir: mocks.mkdir,
+    writeFile: mocks.writeFile,
+    stat: mocks.stat,
+  },
+}));
+vi.mock('@/lib/audio/tts-providers', () => ({ generateTTS: mocks.generateTTS }));
+vi.mock('@/lib/server/provider-config', () => ({
+  getServerImageProviders: () => ({}),
+  getServerVideoProviders: () => ({}),
+  getServerTTSProviders: () => ({ 'qwen-tts': {} }),
+  resolveImageApiKey: () => '',
+  resolveImageBaseUrl: () => '',
+  resolveVideoApiKey: () => '',
+  resolveVideoBaseUrl: () => '',
+  resolveTTSApiKey: () => 'offline-test-key',
+  resolveTTSBaseUrl: () => 'https://dashscope.invalid/api/v1',
+}));
+vi.mock('@/lib/server/mira-tts-policy', () => ({
+  getMiraTtsPolicy: () => ({
+    enforced: true,
+    providerId: 'qwen-tts',
+    modelId: 'qwen3-tts-flash',
+    voiceId: 'Serena',
+  }),
+  assertMiraTtsProviderReady: () => undefined,
+}));
+
+function speechScenes(count: number): Scene[] {
+  return Array.from({ length: count }, (_, index) => ({
+    id: `scene-${index + 1}`,
+    stageId: 'stage-tts-fail-fast',
+    type: 'slide',
+    title: `第${index + 1}场`,
+    order: index + 1,
+    content: {
+      type: 'slide',
+      canvas: { id: `canvas-${index + 1}`, elements: [] },
+    },
+    actions: [
+      {
+        id: `speech-${index + 1}`,
+        type: 'speech',
+        text: `这是第${index + 1}段语音。`,
+      },
+    ],
+  })) as unknown as Scene[];
+}
+
+describe('classroom Qwen TTS fail-fast accounting', () => {
+  beforeEach(() => {
+    for (const mock of Object.values(mocks)) mock.mockReset();
+    mocks.mkdir.mockResolvedValue(undefined);
+    mocks.writeFile.mockResolvedValue(undefined);
+    mocks.stat.mockResolvedValue({ isFile: () => true, size: 4 });
+    mocks.generateTTS.mockImplementation(async () => {
+      if (mocks.generateTTS.mock.calls.length === 4) {
+        const error = new Error('offline download timeout');
+        error.name = 'TimeoutError';
+        throw error;
+      }
+      return { audio: Uint8Array.from([82, 73, 70, 70]), format: 'wav' };
+    });
+  });
+
+  it('records the fourth attempt, only three verified assets, and never starts speech five', async () => {
+    const { generateTTSForClassroom } = await import('@/lib/server/classroom-media-generation');
+    const scenes = speechScenes(5);
+    const attempted: number[] = [];
+    const completed: number[] = [];
+
+    await expect(
+      generateTTSForClassroom(scenes, 'stage-tts-fail-fast', '', {
+        onSpeechAttempted: (count) => {
+          attempted.push(count);
+        },
+        onSpeechGenerated: (count) => {
+          completed.push(count);
+        },
+      }),
+    ).rejects.toMatchObject({ name: 'TimeoutError' });
+
+    expect(attempted).toEqual([1, 2, 3, 4]);
+    expect(completed).toEqual([1, 2, 3]);
+    expect(mocks.generateTTS).toHaveBeenCalledTimes(4);
+    expect(scenes[3].actions?.[0]).not.toHaveProperty('audioMetadata');
+    expect(scenes[4].actions?.[0]).not.toHaveProperty('audioMetadata');
+  });
+});
