@@ -0,0 +1,220 @@
+import { createHash, timingSafeEqual } from 'crypto';
+import { after, type NextRequest } from 'next/server';
+import { apiError, apiSuccess } from '@/lib/server/api-response';
+import {
+  claimMiraSampleDeterministicRecovery,
+  MiraSampleDeterministicRecoveryError,
+  readMiraSampleDeterministicRecovery,
+  runMiraSampleDeterministicRecovery,
+  type MiraSampleDeterministicRecoveryRecord,
+  type MiraSampleRecoveryExpectedSource,
+} from '@/lib/server/mira-sample-deterministic-recovery';
+
+export const dynamic = 'force-dynamic';
+export const maxDuration = 3600;
+
+function secureEqual(left: string, right: string): boolean {
+  const leftDigest = createHash('sha256').update(left).digest();
+  const rightDigest = createHash('sha256').update(right).digest();
+  return timingSafeEqual(leftDigest, rightDigest);
+}
+
+const RECOVERY_RUNTIME_PORT = '3100';
+const LOOPBACK_HOSTNAMES = new Set(['localhost', '127.0.0.1', '::1']);
+
+function singleHeader(req: NextRequest, name: string): string | null {
+  const value = req.headers.get(name);
+  if (
+    value === null ||
+    value.length === 0 ||
+    value !== value.trim() ||
+    value.includes(',') ||
+    /[%\s]/.test(value)
+  ) {
+    return null;
+  }
+  return value;
+}
+
+function normalizedLoopbackHostname(value: string): string | null {
+  const hostname = value.replace(/^\[|\]$/g, '').toLowerCase();
+  return LOOPBACK_HOSTNAMES.has(hostname) ? 'loopback' : null;
+}
+
+function isExactLoopbackAuthority(value: string | null, expectedPort: string): boolean {
+  if (!value) return false;
+  try {
+    const parsed = new URL(`http://${value}`);
+    return Boolean(
+      !parsed.username &&
+      !parsed.password &&
+      parsed.pathname === '/' &&
+      !parsed.search &&
+      !parsed.hash &&
+      parsed.port === expectedPort &&
+      normalizedLoopbackHostname(parsed.hostname),
+    );
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Next 16.1.2 injects x-forwarded-host/port/proto/for even for a direct
+ * request. On the reviewed native listener their exact non-secret shape is:
+ * Host/forwarded-host=127.0.0.1:3100, proto=http, port=3100, and one
+ * forwarded-for loopback address. These headers are consistency checks only;
+ * the 127.0.0.1 listener binding plus the internal token remain the positive
+ * security boundary.
+ */
+function isDirectRecoveryLoopbackRequest(req: NextRequest): boolean {
+  if (req.headers.has('forwarded') || req.headers.has('x-real-ip') || req.headers.has('via')) {
+    return false;
+  }
+  if (
+    req.nextUrl.protocol !== 'http:' ||
+    req.nextUrl.port !== RECOVERY_RUNTIME_PORT ||
+    !normalizedLoopbackHostname(req.nextUrl.hostname)
+  ) {
+    return false;
+  }
+
+  const host = singleHeader(req, 'host');
+  const forwardedHost = singleHeader(req, 'x-forwarded-host');
+  const forwardedFor = singleHeader(req, 'x-forwarded-for');
+  const forwardedProto = singleHeader(req, 'x-forwarded-proto');
+  const forwardedPort = singleHeader(req, 'x-forwarded-port');
+  return Boolean(
+    isExactLoopbackAuthority(host, RECOVERY_RUNTIME_PORT) &&
+    isExactLoopbackAuthority(forwardedHost, RECOVERY_RUNTIME_PORT) &&
+    forwardedFor &&
+    normalizedLoopbackHostname(forwardedFor) &&
+    forwardedProto === 'http' &&
+    forwardedPort === RECOVERY_RUNTIME_PORT,
+  );
+}
+
+function authorize(req: NextRequest, sourceJobId: string): ReturnType<typeof apiError> | null {
+  if (process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_ENABLED !== '1') {
+    return apiError('PROVIDER_DISABLED', 404, 'Deterministic recovery is disabled');
+  }
+  if (process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_SOURCE_JOB_ID !== sourceJobId) {
+    return apiError('INVALID_REQUEST', 404, 'Deterministic recovery source not found');
+  }
+  if (!isDirectRecoveryLoopbackRequest(req)) {
+    return apiError(
+      'INVALID_CREDENTIALS',
+      403,
+      'Deterministic recovery requires direct loopback access',
+    );
+  }
+  const expectedToken = process.env.MIRA_INTERNAL_API_TOKEN || '';
+  const suppliedToken = req.headers.get('x-mira-internal-token') || '';
+  if (!expectedToken || !suppliedToken || !secureEqual(expectedToken, suppliedToken)) {
+    return apiError('INVALID_CREDENTIALS', 403, 'Invalid deterministic recovery credentials');
+  }
+  return null;
+}
+
+function responsePayload(record: MiraSampleDeterministicRecoveryRecord, req: NextRequest) {
+  return {
+    schemaVersion: record.schemaVersion,
+    kind: record.kind,
+    recoveryId: record.recoveryId,
+    mode: record.mode,
+    source: {
+      jobId: record.source.jobId,
+      status: record.source.status,
+      error: record.source.error,
+      scenesGenerated: record.source.scenesGenerated,
+      totalScenes: record.source.totalScenes,
+      completedAt: record.source.completedAt,
+      jobSnapshotSha256: record.source.jobSnapshotSha256,
+      jobSnapshotHashBasis: record.source.jobSnapshotHashBasis,
+    },
+    policy: record.policy,
+    calls: record.calls,
+    status: record.status,
+    step: record.step,
+    progress: record.progress,
+    message: record.message,
+    scenesGenerated: record.scenesGenerated,
+    totalScenes: record.totalScenes,
+    createdAt: record.createdAt,
+    updatedAt: record.updatedAt,
+    ...(record.startedAt ? { startedAt: record.startedAt } : {}),
+    ...(record.completedAt ? { completedAt: record.completedAt } : {}),
+    ...(record.artifact ? { artifact: record.artifact } : {}),
+    ...(record.error ? { error: record.error } : {}),
+    pollUrl: `${req.nextUrl.origin}${req.nextUrl.pathname}`,
+    done: record.status === 'succeeded' || record.status === 'failed',
+  };
+}
+
+function responseStatus(record: MiraSampleDeterministicRecoveryRecord): number {
+  return record.status === 'queued' || record.status === 'running' ? 202 : 200;
+}
+
+export async function POST(req: NextRequest, context: { params: Promise<{ jobId: string }> }) {
+  const { jobId } = await context.params;
+  const denied = authorize(req, jobId);
+  if (denied) return denied;
+
+  try {
+    const rawBody: unknown = await req.json();
+    if (!rawBody || typeof rawBody !== 'object' || Array.isArray(rawBody)) {
+      return apiError('INVALID_REQUEST', 400, 'Invalid deterministic recovery request contract');
+    }
+    const body = rawBody as Record<string, unknown>;
+    const topKeys = Object.keys(body).sort();
+    const expectedValue = body.expectedSource;
+    if (
+      topKeys.join(',') !== 'expectedSource,recoveryRequestId' ||
+      !expectedValue ||
+      typeof expectedValue !== 'object' ||
+      Array.isArray(expectedValue) ||
+      Object.keys(expectedValue).sort().join(',') !== 'error,scenesGenerated,status,totalScenes'
+    ) {
+      return apiError('INVALID_REQUEST', 400, 'Invalid deterministic recovery request contract');
+    }
+    const expected = expectedValue as Partial<MiraSampleRecoveryExpectedSource>;
+    if (
+      typeof body.recoveryRequestId !== 'string' ||
+      expected?.status !== 'failed' ||
+      expected.error !== 'structured_output_exhausted' ||
+      expected.scenesGenerated !== 4 ||
+      expected.totalScenes !== 10
+    ) {
+      return apiError('INVALID_REQUEST', 400, 'Invalid deterministic recovery request contract');
+    }
+    const { record, created } = await claimMiraSampleDeterministicRecovery({
+      sourceJobId: jobId,
+      recoveryRequestId: body.recoveryRequestId,
+      expectedSource: expected as MiraSampleRecoveryExpectedSource,
+      patchSha256: process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_PATCH_SHA256 || '',
+    });
+    if (created) {
+      after(() => runMiraSampleDeterministicRecovery(jobId));
+    }
+    return apiSuccess(responsePayload(record, req), responseStatus(record));
+  } catch (error) {
+    if (error instanceof MiraSampleDeterministicRecoveryError) {
+      const status = error.code === 'recovery_already_claimed' ? 409 : 400;
+      return apiError('INVALID_REQUEST', status, error.message, error.code);
+    }
+    return apiError('INTERNAL_ERROR', 500, 'Failed to claim deterministic recovery');
+  }
+}
+
+export async function GET(req: NextRequest, context: { params: Promise<{ jobId: string }> }) {
+  const { jobId } = await context.params;
+  const denied = authorize(req, jobId);
+  if (denied) return denied;
+  try {
+    const record = await readMiraSampleDeterministicRecovery(jobId);
+    if (!record) return apiError('INVALID_REQUEST', 404, 'Deterministic recovery not found');
+    return apiSuccess(responsePayload(record, req), responseStatus(record));
+  } catch (error) {
+    return apiError('INTERNAL_ERROR', 500, 'Failed to read deterministic recovery');
+  }
+}
