+canvas.addEventListener('pointerdown',function(event){dragging=true;lastX=event.clientX;lastY=event.clientY;canvas.setPointerCapture(event.pointerId)});canvas.addEventListener('pointermove',function(event){if(!dragging)return;model.rotation.y += (event.clientX-lastX)*.01;model.rotation.x += (event.clientY-lastY)*.01;lastX=event.clientX;lastY=event.clientY;renderModel()});canvas.addEventListener('pointerup',function(){dragging=false});canvas.addEventListener('wheel',function(event){event.preventDefault();zoom=Math.max(.65,Math.min(1.7,zoom-event.deltaY*.001));model.scale.x = zoom;model.scale.y = zoom;model.scale.z = zoom;renderModel()},{passive:false});document.getElementById('cube-count').addEventListener('input',function(event){count=Number(event.target.value);renderModel()});document.getElementById('reset-view').addEventListener('click',function(){model.rotation.x=-.35;model.rotation.y=.45;model.rotation.z=0;zoom=1;model.scale.x=1;model.scale.y=1;model.scale.z=1;renderModel()});renderModel();
