+  };
+}
+
+function request(
+  body: object,
+  url = 'http://127.0.0.1:3100/api/generate-classroom/uKQl3vMr4d/deterministic-recovery',
+) {
+  return new NextRequest(url, {
+    method: 'POST',
+    headers: {
+      'content-type': 'application/json',
+      host: '127.0.0.1:3100',
+      'x-forwarded-host': '127.0.0.1:3100',
+      'x-forwarded-for': '127.0.0.1',
+      'x-forwarded-proto': 'http',
+      'x-forwarded-port': '3100',
+      'x-mira-internal-token': 'internal-test-token',
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+function directGetRequest() {
+  return new NextRequest(
+    'http://127.0.0.1:3100/api/generate-classroom/uKQl3vMr4d/deterministic-recovery',
+    {
+      headers: {
+        host: '127.0.0.1:3100',
+        'x-forwarded-host': '127.0.0.1:3100',
+        'x-forwarded-for': '127.0.0.1',
+        'x-forwarded-proto': 'http',
+        'x-forwarded-port': '3100',
