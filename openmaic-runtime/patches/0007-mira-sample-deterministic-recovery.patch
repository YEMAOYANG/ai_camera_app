+import { createLogger } from '@/lib/logger';
+
+export const MIRA_SAMPLE_DETERMINISTIC_RECOVERY_SCHEMA =
+  'mira.openmaic.deterministic-recovery.v1' as const;
+export const CLASSROOM_RECOVERIES_DIR = path.join(process.cwd(), 'data', 'classroom-recoveries');
+export const MIRA_SAMPLE_DETERMINISTIC_RECOVERY_STALE_TIMEOUT_MS = 15 * 60 * 1000;
+const RECOVERY_LOCK_STALE_TIMEOUT_MS = 60 * 1000;
+const RECOVERY_LOCK_RETRY_MS = 10;
+const RECOVERY_LOCK_MAX_ATTEMPTS = 500;
+const log = createLogger('MiraDeterministicRecovery');
+
+export type MiraSampleDeterministicRecoveryStatus = 'queued' | 'running' | 'succeeded' | 'failed';
+
+export interface MiraSampleDeterministicRecoveryRecord {
+  schemaVersion: typeof MIRA_SAMPLE_DETERMINISTIC_RECOVERY_SCHEMA;
+  kind: typeof MIRA_SAMPLE_DETERMINISTIC_RECOVERY_KIND;
+  recoveryId: string;
+  mode: typeof MIRA_SAMPLE_DETERMINISTIC_RECOVERY_MODE;
+  requestIdSha256: string;
+  source: {
+    jobId: string;
+    status: 'failed';
+    error: 'structured_output_exhausted';
+    scenesGenerated: 4;
+    totalScenes: 10;
+    completedAt: string;
+    jobSnapshotSha256: string;
+    jobSnapshotHashBasis: 'canonical_json_v1';
+    rawJobFileSha256: string;
+  };
+  policy: {
+    marker: typeof MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER;
+    version: typeof MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION;
+    canonicalSpecSha256: string;
+    patchSha256: string;
+  };
+  calls: {
+    llm: 0;
+    webSearch: 0;
+    imageGeneration: 0;
+    videoGeneration: 0;
+    tts: { expected: 10; attempted: number; completed: number };
+  };
+  status: MiraSampleDeterministicRecoveryStatus;
+  step: string;
+  progress: number;
+  message: string;
+  scenesGenerated: number;
+  totalScenes: 10;
+  createdAt: string;
+  updatedAt: string;
+  startedAt?: string;
+  completedAt?: string;
+  artifact?: {
+    classroomId: string;
+    url: string;
+    sceneCount: 10;
+    contentSha256: string;
+    artifactSha256: string;
+    tts: {
+      providerId: string;
+      modelId: string;
+      voiceId: string;
+      speechCount: 10;
+      fallbackUsed: false;
+    };
+  };
+  error?: { code: 'deterministic_recovery_failed'; message: string };
+}
+
+export interface MiraSampleRecoveryExpectedSource {
+  status: 'failed';
+  error: 'structured_output_exhausted';
+  scenesGenerated: 4;
+  totalScenes: 10;
+}
+
+export class MiraSampleDeterministicRecoveryError extends Error {
+  constructor(
+    public readonly code:
+      | 'invalid_recovery_request'
+      | 'recovery_source_mismatch'
+      | 'recovery_already_claimed',
+    message: string,
+  ) {
+    super(message);
+    this.name = 'MiraSampleDeterministicRecoveryError';
+  }
+}
+
+function sha256(value: string | Uint8Array): string {
+  return createHash('sha256').update(value).digest('hex');
+}
+
+function recoveryPath(sourceJobId: string): string {
+  return path.join(CLASSROOM_RECOVERIES_DIR, `${sourceJobId}.json`);
+}
+
+function recoveryLockPath(sourceJobId: string): string {
+  return path.join(CLASSROOM_RECOVERIES_DIR, `.${sourceJobId}.lock`);
+}
+
+function sourceJobPath(sourceJobId: string): string {
+  return path.join(CLASSROOM_JOBS_DIR, `${sourceJobId}.json`);
+}
+
+function validIdentifier(value: string): boolean {
+  return /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+function validRecoveryRequestId(value: string): boolean {
+  return /^[A-Za-z0-9._:-]{8,128}$/.test(value);
+}
+
+function exactSource(
+  value: unknown,
+  sourceJobId: string,
+  expected: MiraSampleRecoveryExpectedSource,
+): value is {
+  id: string;
+  status: 'failed';
+  error: 'structured_output_exhausted';
+  scenesGenerated: 4;
+  totalScenes: 10;
+  completedAt: string;
+  inputSummary: { requirementPreview: string };
+} {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+  const job = value as Record<string, unknown>;
+  const summary = job.inputSummary;
+  return Boolean(
+    job.id === sourceJobId &&
+    job.status === expected.status &&
+    job.error === expected.error &&
+    job.scenesGenerated === expected.scenesGenerated &&
+    job.totalScenes === expected.totalScenes &&
+    typeof job.completedAt === 'string' &&
+    summary &&
+    typeof summary === 'object' &&
+    !Array.isArray(summary) &&
+    (summary as Record<string, unknown>).requirementPreview?.toString().split('\n')[0] ===
+      MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER,
+  );
+}
+
+export function canonicalMiraSampleRecoverySourceSnapshot(input: {
+  id: string;
+  completedAt: string;
+}): string {
+  // Keys are deliberately emitted in lexicographic order. Cross-language
+  // callers hash these UTF-8 JSON bytes with no insignificant whitespace.
+  return JSON.stringify({
+    completedAt: input.completedAt,
+    error: 'structured_output_exhausted',
+    id: input.id,
+    requirementMarker: MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER,
+    scenesGenerated: 4,
+    status: 'failed',
+    totalScenes: 10,
+  });
+}
+
+export function getMiraSampleDeterministicRecoveryRuntimePolicy(): {
+  enabled: boolean;
+  sourceJobId: string;
+  policyVersion: typeof MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION;
+  canonicalSpecSha256: string;
+  patchSha256: string;
+} {
+  const plan = resolveMiraSampleStructuralPlan(MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER);
+  if (!plan) throw new Error('Mira sample deterministic plan unavailable');
+  return {
+    enabled: process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_ENABLED === '1',
+    sourceJobId: process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_SOURCE_JOB_ID || '',
+    policyVersion: MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION,
+    canonicalSpecSha256: miraSampleCanonicalSpecSha256(plan),
+    patchSha256: process.env.MIRA_OPENMAIC_DETERMINISTIC_RECOVERY_PATCH_SHA256 || '',
+  };
+}
+
+async function readExisting(
+  sourceJobId: string,
+): Promise<MiraSampleDeterministicRecoveryRecord | null> {
+  try {
+    return JSON.parse(
+      await fs.readFile(recoveryPath(sourceJobId), 'utf8'),
+    ) as MiraSampleDeterministicRecoveryRecord;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+}
+
+const recoveryLocks = new Map<string, Promise<void>>();
+
+async function waitForRecoveryLockRetry(): Promise<void> {
+  await new Promise<void>((resolve) => {
+    setTimeout(resolve, RECOVERY_LOCK_RETRY_MS);
+  });
+}
+
+async function withFileRecoveryLock<T>(sourceJobId: string, fn: () => Promise<T>): Promise<T> {
+  await fs.mkdir(CLASSROOM_RECOVERIES_DIR, { recursive: true });
+  const lockPath = recoveryLockPath(sourceJobId);
+  let lockHandle: Awaited<ReturnType<typeof fs.open>> | null = null;
+  for (let attempt = 0; attempt < RECOVERY_LOCK_MAX_ATTEMPTS; attempt += 1) {
+    try {
+      lockHandle = await fs.open(lockPath, 'wx');
+      break;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+      try {
+        const stat = await fs.stat(lockPath);
+        if (Date.now() - stat.mtimeMs > RECOVERY_LOCK_STALE_TIMEOUT_MS) {
+          await fs.unlink(lockPath);
+          continue;
+        }
+      } catch (statError) {
+        if ((statError as NodeJS.ErrnoException).code === 'ENOENT') continue;
+        throw statError;
+      }
+      await waitForRecoveryLockRetry();
+    }
+  }
+  if (!lockHandle) {
+    throw new Error(`Timed out acquiring deterministic recovery lock: ${sourceJobId}`);
+  }
+  try {
+    return await fn();
+  } finally {
+    await lockHandle.close();
+    try {
+      await fs.unlink(lockPath);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+    }
+  }
+}
+
+/**
+ * Serialize recovery read-modify-write operations in-process and with a short
+ * filesystem lease. The on-disk status check is the compare part of CAS; the
+ * atomic rename in writeJsonFileAtomic is the swap. This prevents a late TTS
+ * callback in another request/process from reviving a terminal record.
+ */
+async function withRecoveryLock<T>(sourceJobId: string, fn: () => Promise<T>): Promise<T> {
+  const previous = recoveryLocks.get(sourceJobId) ?? Promise.resolve();
+  let release: () => void;
+  const next = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  recoveryLocks.set(sourceJobId, next);
+  try {
+    await previous;
+    return await withFileRecoveryLock(sourceJobId, fn);
+  } finally {
+    release!();
+    if (recoveryLocks.get(sourceJobId) === next) recoveryLocks.delete(sourceJobId);
+  }
+}
+
+function staleFailureRecord(
+  record: MiraSampleDeterministicRecoveryRecord,
+  nowMs: number,
+  nowIso: string,
+): MiraSampleDeterministicRecoveryRecord | null {
+  if (record.status !== 'queued' && record.status !== 'running') return null;
+  const updatedAtMs = Date.parse(record.updatedAt);
+  if (
+    Number.isFinite(updatedAtMs) &&
+    nowMs - updatedAtMs < MIRA_SAMPLE_DETERMINISTIC_RECOVERY_STALE_TIMEOUT_MS
+  ) {
+    return null;
+  }
+  return {
+    ...record,
+    status: 'failed',
+    step: 'failed',
+    message: 'Deterministic Mira sample recovery expired without persisted progress',
+    updatedAt: nowIso,
+    completedAt: nowIso,
+    error: {
+      code: 'deterministic_recovery_failed',
+      message:
+        'Deterministic recovery expired after 15 minutes without persisted progress; it will not be replayed',
+    },
+  };
+}
+
+async function readAndExpireStaleRecovery(
+  sourceJobId: string,
+): Promise<MiraSampleDeterministicRecoveryRecord | null> {
+  return withRecoveryLock(sourceJobId, async () => {
+    const current = await readExisting(sourceJobId);
+    if (!current) return null;
+    const nowMs = Date.now();
+    const nowIso = new Date(nowMs).toISOString();
+    const expired = staleFailureRecord(current, nowMs, nowIso);
+    if (!expired) return current;
+    await writeJsonFileAtomic(recoveryPath(sourceJobId), expired);
+    return expired;
+  });
+}
+
+type RecoveryPatch = Partial<MiraSampleDeterministicRecoveryRecord>;
+
+async function compareAndSwapRecovery(
+  sourceJobId: string,
+  expectedStatuses: readonly MiraSampleDeterministicRecoveryStatus[],
+  makePatch: (current: MiraSampleDeterministicRecoveryRecord, nowIso: string) => RecoveryPatch,
+): Promise<{ record: MiraSampleDeterministicRecoveryRecord; applied: boolean }> {
+  return withRecoveryLock(sourceJobId, async () => {
+    const current = await readExisting(sourceJobId);
+    if (!current) throw new Error(`Deterministic recovery not found: ${sourceJobId}`);
+    const nowMs = Date.now();
+    const nowIso = new Date(nowMs).toISOString();
+    const expired = staleFailureRecord(current, nowMs, nowIso);
+    if (expired) {
+      await writeJsonFileAtomic(recoveryPath(sourceJobId), expired);
+      return { record: expired, applied: false };
+    }
+    if (!expectedStatuses.includes(current.status)) {
+      return { record: current, applied: false };
+    }
+    const updated: MiraSampleDeterministicRecoveryRecord = {
+      ...current,
+      ...makePatch(current, nowIso),
+      updatedAt: nowIso,
+    };
+    await writeJsonFileAtomic(recoveryPath(sourceJobId), updated);
+    return { record: updated, applied: true };
+  });
+}
+
+export async function readMiraSampleDeterministicRecovery(
+  sourceJobId: string,
+): Promise<MiraSampleDeterministicRecoveryRecord | null> {
+  if (!validIdentifier(sourceJobId)) return null;
+  return readAndExpireStaleRecovery(sourceJobId);
+}
+
+export async function claimMiraSampleDeterministicRecovery(input: {
+  sourceJobId: string;
+  recoveryRequestId: string;
+  expectedSource: MiraSampleRecoveryExpectedSource;
+  patchSha256: string;
+}): Promise<{ record: MiraSampleDeterministicRecoveryRecord; created: boolean }> {
+  if (!validIdentifier(input.sourceJobId) || !validRecoveryRequestId(input.recoveryRequestId)) {
+    throw new MiraSampleDeterministicRecoveryError(
+      'invalid_recovery_request',
+      'Invalid deterministic recovery identifier',
+    );
+  }
+  if (!/^[a-f0-9]{64}$/.test(input.patchSha256)) {
+    throw new MiraSampleDeterministicRecoveryError(
+      'invalid_recovery_request',
+      'Deterministic recovery patch SHA-256 is not configured',
+    );
+  }
+  const requestIdSha256 = sha256(input.recoveryRequestId);
+  const existing = await readAndExpireStaleRecovery(input.sourceJobId);
+  if (existing) {
+    if (existing.requestIdSha256 !== requestIdSha256) {
+      throw new MiraSampleDeterministicRecoveryError(
+        'recovery_already_claimed',
+        'The source job already has a deterministic recovery claimed with a different idempotency key',
+      );
+    }
+    return { record: existing, created: false };
+  }
+
+  const rawSource = await fs.readFile(sourceJobPath(input.sourceJobId));
+  let source: unknown;
+  try {
+    source = JSON.parse(rawSource.toString('utf8'));
+  } catch {
+    throw new MiraSampleDeterministicRecoveryError(
+      'recovery_source_mismatch',
+      'The source job snapshot is not valid JSON',
+    );
+  }
+  if (!exactSource(source, input.sourceJobId, input.expectedSource)) {
+    throw new MiraSampleDeterministicRecoveryError(
+      'recovery_source_mismatch',
+      'The source job does not match the frozen failed third-job snapshot contract',
+    );
+  }
+  const plan = resolveMiraSampleStructuralPlan(MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER);
+  if (!plan) throw new Error('Mira sample deterministic plan unavailable');
+  const now = new Date().toISOString();
+  const record: MiraSampleDeterministicRecoveryRecord = {
+    schemaVersion: MIRA_SAMPLE_DETERMINISTIC_RECOVERY_SCHEMA,
+    kind: MIRA_SAMPLE_DETERMINISTIC_RECOVERY_KIND,
+    recoveryId: `omrec_${sha256(`${input.sourceJobId}:${requestIdSha256}`).slice(0, 24)}`,
+    mode: MIRA_SAMPLE_DETERMINISTIC_RECOVERY_MODE,
+    requestIdSha256,
+    source: {
+      jobId: input.sourceJobId,
+      status: 'failed',
+      error: 'structured_output_exhausted',
+      scenesGenerated: 4,
+      totalScenes: 10,
+      completedAt: source.completedAt,
+      jobSnapshotSha256: sha256(
+        canonicalMiraSampleRecoverySourceSnapshot({
+          id: input.sourceJobId,
+          completedAt: source.completedAt,
+        }),
+      ),
+      jobSnapshotHashBasis: 'canonical_json_v1',
+      rawJobFileSha256: sha256(rawSource),
+    },
+    policy: {
+      marker: MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER,
+      version: MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION,
+      canonicalSpecSha256: miraSampleCanonicalSpecSha256(plan),
+      patchSha256: input.patchSha256,
+    },
+    calls: {
+      llm: 0,
+      webSearch: 0,
+      imageGeneration: 0,
+      videoGeneration: 0,
+      tts: { expected: 10, attempted: 0, completed: 0 },
+    },
+    status: 'queued',
+    step: 'queued',
+    progress: 0,
+    message: 'Deterministic Mira sample recovery queued',
+    scenesGenerated: 0,
+    totalScenes: 10,
+    createdAt: now,
+    updatedAt: now,
+  };
+
+  await fs.mkdir(CLASSROOM_RECOVERIES_DIR, { recursive: true });
+  try {
+    await fs.writeFile(recoveryPath(input.sourceJobId), JSON.stringify(record, null, 2), {
+      encoding: 'utf8',
+      flag: 'wx',
+    });
+    return { record, created: true };
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+    const winner = await readExisting(input.sourceJobId);
+    if (!winner) throw error;
+    if (winner.requestIdSha256 !== requestIdSha256) {
+      throw new MiraSampleDeterministicRecoveryError(
+        'recovery_already_claimed',
+        'The source job already has a deterministic recovery claimed with a different idempotency key',
+      );
+    }
+    return { record: winner, created: false };
+  }
+}
+
+const runningRecoveries = new Map<string, Promise<void>>();
+
+export function runMiraSampleDeterministicRecovery(sourceJobId: string): Promise<void> {
+  const existing = runningRecoveries.get(sourceJobId);
+  if (existing) return existing;
+  const task = (async () => {
+    try {
+      // Only a fresh append-only queued claim may transition to running. Every
+      // later update is a status-checked CAS from running, so a stale-failed or
+      // otherwise terminal record can never be revived and can never spend TTS
+      // again.
+      const started = await compareAndSwapRecovery(sourceJobId, ['queued'], (_current, nowIso) => ({
+        status: 'running',
+        step: 'initializing',
+        progress: 1,
+        message: 'Deterministic Mira sample recovery started',
+        startedAt: nowIso,
+      }));
+      if (!started.applied) return;
+      const plan = resolveMiraSampleStructuralPlan(MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER);
+      if (!plan) throw new Error('Mira sample deterministic plan unavailable');
+      const result = await generateMiraSampleDeterministicClassroom(plan, {
+        // Persist same-origin references. The backend resolves them against the
+        // private 3100 origin; a student resolves them against the authenticated
+        // 3101 gateway. Never bake loopback or one machine's LAN host into data.
+        baseUrl: '',
+        onProgress: async (progress: MiraSampleDeterministicProgress) => {
+          const update = await compareAndSwapRecovery(sourceJobId, ['running'], () => ({
+            status: 'running',
+            step: progress.step,
+            progress: progress.progress,
+            message: progress.message,
+            scenesGenerated: progress.scenesGenerated,
+          }));
+          if (!update.applied) {
+            throw new Error('Deterministic recovery is no longer running');
+          }
+        },
+        onTtsAttempted: async (attempted) => {
+          const update = await compareAndSwapRecovery(sourceJobId, ['running'], (current) => {
+            if (
+              !Number.isInteger(attempted) ||
+              attempted !== current.calls.tts.attempted + 1 ||
+              attempted > current.calls.tts.expected
+            ) {
+              throw new Error('Invalid deterministic recovery TTS attempt count');
+            }
+            return {
+              calls: {
+                ...current.calls,
+                tts: { ...current.calls.tts, attempted },
+              },
+            };
+          });
+          if (!update.applied) {
+            throw new Error('Deterministic recovery is no longer running');
+          }
+        },
+        onTtsProgress: async (completed) => {
+          const update = await compareAndSwapRecovery(sourceJobId, ['running'], (current) => {
+            if (
+              !Number.isInteger(completed) ||
+              completed !== current.calls.tts.completed + 1 ||
+              completed > current.calls.tts.attempted
+            ) {
+              throw new Error('Invalid deterministic recovery TTS progress');
+            }
+            return {
+              calls: {
+                ...current.calls,
+                tts: { ...current.calls.tts, completed },
+              },
+            };
+          });
+          if (!update.applied) {
+            throw new Error('Deterministic recovery is no longer running');
+          }
+        },
+      });
+      const receipt = result.deterministicReceipt;
+      await compareAndSwapRecovery(sourceJobId, ['running'], (_current, nowIso) => ({
+        status: 'succeeded',
+        step: 'completed',
+        progress: 100,
+        message: 'Deterministic Mira sample recovery completed',
+        scenesGenerated: 10,
+        completedAt: nowIso,
+        calls: {
+          llm: 0,
+          webSearch: 0,
+          imageGeneration: 0,
+          videoGeneration: 0,
+          tts: { expected: 10, attempted: 10, completed: 10 },
+        },
+        artifact: {
+          classroomId: result.id,
+          url: result.url,
+          sceneCount: 10,
+          contentSha256: receipt.contentSha256,
+          artifactSha256: receipt.artifactSha256,
+          tts: receipt.tts,
+        },
+      }));
+    } catch (error) {
+      log.error(`Deterministic recovery ${sourceJobId} failed`, {
+        errorType: error instanceof Error ? error.name : 'unknown',
+      });
+      // If a GET/POST observation already stale-failed this record, this CAS is
+      // deliberately a no-op. A late provider rejection or completion must not
+      // rewrite terminal audit history.
+      await compareAndSwapRecovery(sourceJobId, ['running'], (_current, nowIso) => ({
+        status: 'failed',
+        step: 'failed',
+        message: 'Deterministic Mira sample recovery failed',
+        completedAt: nowIso,
+        error: {
+          code: 'deterministic_recovery_failed',
+          message: 'Deterministic recovery execution failed; inspect the server log',
+        },
+      }));
+    } finally {
+      runningRecoveries.delete(sourceJobId);
+    }
+  })();
+  runningRecoveries.set(sourceJobId, task);
+  return task;
+}
diff --git a/tests/audio/qwen-tts-timeout.test.ts b/tests/audio/qwen-tts-timeout.test.ts
