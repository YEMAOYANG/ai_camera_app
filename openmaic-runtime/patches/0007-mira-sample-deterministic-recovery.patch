+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({
+  resolveModel: vi.fn(),
+  callLLM: vi.fn(),
+  generateSceneContent: vi.fn(),
+  generateSceneActions: vi.fn(),
+  generateTTSForClassroom: vi.fn(),
+  persistClassroom: vi.fn(),
+  readFile: vi.fn(),
+}));
+
+vi.mock('@/lib/server/resolve-model', () => ({ resolveModel: mocks.resolveModel }));
+vi.mock('@/lib/ai/llm', () => ({ callLLM: mocks.callLLM }));
+vi.mock('@openmaic/generation', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@openmaic/generation')>()),
+  generateSceneContent: mocks.generateSceneContent,
+  generateSceneActions: mocks.generateSceneActions,
+}));
+vi.mock('@/lib/server/classroom-media-generation', () => ({
+  generateTTSForClassroom: mocks.generateTTSForClassroom,
+}));
+vi.mock('@/lib/server/classroom-storage', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/lib/server/classroom-storage')>()),
+  persistClassroom: mocks.persistClassroom,
+  CLASSROOMS_DIR: '/deterministic-test/classrooms',
+}));
+vi.mock('fs', () => ({ promises: { readFile: mocks.readFile } }));
+
+describe('Mira sample deterministic classroom', () => {
+  beforeEach(() => {
+    for (const mock of Object.values(mocks)) mock.mockReset();
+    process.env.MIRA_OPENMAIC_REQUIRE_QWEN_TTS = '1';
+    process.env.MIRA_OPENMAIC_QWEN_TTS_MODEL = 'qwen3-tts-flash';
+    process.env.MIRA_OPENMAIC_QWEN_TTS_VOICE = 'Serena';
+    mocks.readFile.mockResolvedValue(Buffer.from('RIFF deterministic qwen audio bytes'));
+    mocks.persistClassroom.mockImplementation(async ({ id, stage, scenes }) => ({
+      id,
+      stage,
+      scenes,
+      createdAt: '2026-08-18T00:00:00.000Z',
+      url: `/classroom/${id}`,
+    }));
+    mocks.generateTTSForClassroom.mockImplementation(
+      async (scenes, classroomId, baseUrl, options) => {
+        expect(baseUrl).toBe('');
+        let completed = 0;
+        for (const scene of scenes) {
+          for (const action of scene.actions || []) {
+            if (action.type !== 'speech') continue;
+            completed += 1;
+            await options?.onSpeechAttempted?.(completed);
+            Object.assign(action, {
