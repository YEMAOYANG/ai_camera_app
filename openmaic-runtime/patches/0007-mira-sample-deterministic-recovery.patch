+import { createHash } from 'crypto';
+import { promises as fs } from 'fs';
+import path from 'path';
+import { CLASSROOM_JOBS_DIR, writeJsonFileAtomic } from '@/lib/server/classroom-storage';
+import {
+  generateMiraSampleDeterministicClassroom,
+  MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION,
+  MIRA_SAMPLE_DETERMINISTIC_RECOVERY_KIND,
+  MIRA_SAMPLE_DETERMINISTIC_RECOVERY_MODE,
