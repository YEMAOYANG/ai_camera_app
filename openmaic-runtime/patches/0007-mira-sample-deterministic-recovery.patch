+  generateMiraSampleDeterministicClassroom: generateRecoveryArtifact,
+}));
+
+const ORIGINAL_CWD = process.cwd();
+let testDir = '';
+
+async function sourceJobBytes(): Promise<Buffer> {
+  const payload = {
+    id: 'uKQl3vMr4d',
+    status: 'failed',
+    step: 'failed',
+    progress: 54,
+    message: 'Classroom generation failed',
+    createdAt: '2026-08-18T10:22:55.804Z',
+    updatedAt: '2026-08-18T10:36:50.864Z',
+    inputSummary: {
+      requirementPreview: 'MIRA_OPENMAIC_SAMPLE_STRUCTURAL_POLICY_V1\n固定一年级数学样板课堂合同',
+      hasPdf: false,
+      pdfTextLength: 0,
+      pdfImageCount: 0,
+    },
+    scenesGenerated: 4,
+    startedAt: '2026-08-18T10:22:55.806Z',
+    totalScenes: 10,
+    completedAt: '2026-08-18T10:36:50.864Z',
+    error: 'structured_output_exhausted',
+  };
+  return Buffer.from(JSON.stringify(payload, null, 2));
+}
+
+const expectedSource = {
+  status: 'failed' as const,
+  error: 'structured_output_exhausted' as const,
+  scenesGenerated: 4 as const,
+  totalScenes: 10 as const,
+};
+
+describe('Mira deterministic recovery append-only store', () => {
+  beforeEach(async () => {
+    generateRecoveryArtifact.mockReset();
+    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'mira-deterministic-recovery-'));
+    process.chdir(testDir);
+    await fs.mkdir(path.join(testDir, 'data', 'classroom-jobs'), { recursive: true });
+    await fs.writeFile(
+      path.join(testDir, 'data', 'classroom-jobs', 'uKQl3vMr4d.json'),
+      await sourceJobBytes(),
+    );
+    vi.resetModules();
+  });
+
+  afterEach(async () => {
+    vi.useRealTimers();
+    process.chdir(ORIGINAL_CWD);
+    await fs.rm(testDir, { recursive: true, force: true });
+  });
+
+  it('claims once, preserves the failed source bytes, and hashes the frozen canonical snapshot', async () => {
+    const sourcePath = path.join(testDir, 'data', 'classroom-jobs', 'uKQl3vMr4d.json');
+    const originalBytes = await fs.readFile(sourcePath);
+    const { canonicalMiraSampleRecoverySourceSnapshot, claimMiraSampleDeterministicRecovery } =
+      await import('@/lib/server/mira-sample-deterministic-recovery');
+    const first = await claimMiraSampleDeterministicRecovery({
+      sourceJobId: 'uKQl3vMr4d',
+      recoveryRequestId: 'stage2-number-sense-deterministic-recovery-v1',
+      expectedSource,
+      patchSha256: 'a'.repeat(64),
