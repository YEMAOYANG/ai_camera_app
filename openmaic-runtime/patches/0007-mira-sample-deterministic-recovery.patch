+
+  it('claims before scheduling after(), returns a flattened allowlisted receipt, and schedules once', async () => {
+    mocks.claim.mockResolvedValueOnce({ record: record('queued'), created: true });
+    const { POST, maxDuration } =
+      await import('@/app/api/generate-classroom/[jobId]/deterministic-recovery/route');
+    const response = await POST(request(exactBody), {
+      params: Promise.resolve({ jobId: 'uKQl3vMr4d' }),
+    });
