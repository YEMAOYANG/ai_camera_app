+}
+
+function interactiveContent(order: number): GeneratedSceneContent {
+  if (order === 3)
+    return { html: simulationHtml(), widgetType: 'simulation', widgetConfig: SIMULATION_CONFIG };
+  if (order === 5) return { html: gameHtml(), widgetType: 'game', widgetConfig: GAME_CONFIG };
+  return {
+    html: visualizationHtml(),
+    widgetType: 'visualization3d',
+    widgetConfig: VISUALIZATION_CONFIG,
+  };
+}
+
+function contentFor(order: number): GeneratedSceneContent {
+  if ([1, 2, 4, 6, 10].includes(order)) return slideContent(order);
+  if ([8, 9].includes(order)) return quizContent(order);
+  return interactiveContent(order);
+}
+
+function actionsFor(order: number, content: GeneratedSceneContent): Action[] {
+  const actions: Action[] = [];
+  if ('html' in content) {
+    actions.push({
+      id: `mira-sample-widget-action-${String(order).padStart(2, '0')}`,
+      type: 'widget_highlight',
+      target: order === 3 ? '#count' : order === 5 ? '#train' : '#model-canvas',
+      content: '请操作画面并观察结果。',
+    });
+  }
+  return actions;
+}
+
+function stableSpec(plan: MiraSampleStructuralPlan): object {
+  return {
+    policyVersion: MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION,
+    courseTitle: plan.courseTitle,
+    languageDirective: plan.languageDirective,
+    agents: plan.agents,
+    scenes: plan.outlines.map((outline) => {
+      const content = contentFor(outline.order);
+      return {
+        outline,
+        content,
+        actions: ensureMiraSampleSceneActions(outline, content, actionsFor(outline.order, content)),
+      };
+    }),
+  };
+}
+
+export function miraSampleCanonicalSpecSha256(plan: MiraSampleStructuralPlan): string {
+  return sha256(JSON.stringify(stableSpec(plan)));
+}
+
+export function assertMiraSampleDeterministicInteractiveContract(scenes: readonly Scene[]): void {
+  const expected = new Map<string, WidgetConfigBase>([
+    ['simulation', SIMULATION_CONFIG],
+    ['game', GAME_CONFIG],
+    ['visualization3d', VISUALIZATION_CONFIG],
+  ]);
+  for (const scene of scenes.filter((item) => item.type === 'interactive')) {
+    const content = scene.content;
+    const widgetType = content.widgetType || '';
+    const config = expected.get(widgetType);
+    if (!config || JSON.stringify(content.widgetConfig) !== JSON.stringify(config)) {
+      throw new Error(`mira_sample_deterministic_interactive_failed:config:${widgetType}`);
+    }
+    const match = content.html?.match(
+      /<script\b(?=[^>]*\btype=["']application\/json["'])(?=[^>]*\bid=["']widget-config["'])[^>]*>([\s\S]*?)<\/script\s*>/i,
+    );
+    if (!match || JSON.stringify(JSON.parse(match[1])) !== JSON.stringify(config)) {
+      throw new Error(`mira_sample_deterministic_interactive_failed:embedded_config:${widgetType}`);
+    }
+    const html = content.html || '';
+    const complete =
+      widgetType === 'simulation'
+        ? /<input\b[^>]*type=["']range["']/i.test(html) &&
+          /addEventListener\(["']input["']/.test(html) &&
+          /\.textContent\s*=/.test(html)
+        : widgetType === 'game'
+          ? /dragstart/.test(html) &&
+            /\bdrop\b/.test(html) &&
+            /slot\.addEventListener\(['"]click['"]/.test(html) &&
+            /function selectCard\(/.test(html) &&
+            /score\s*\+=/.test(html) &&
+            /level\s*\+=/.test(html) &&
+            /progress\s*=/.test(html) &&
+            /requestAnimationFrame\(/.test(html)
+          : /<canvas\b/i.test(html) &&
+            /getContext\(["']webgl["']\)/.test(html) &&
+            /createShader\(/.test(html) &&
+            /gl\.enable\(gl\.DEPTH_TEST\)/.test(html) &&
+            /function perspective\(/.test(html) &&
+            /drawArrays\(gl\.TRIANGLES,0,36\)/.test(html) &&
+            /model\.rotation\.[xyz]\s*\+=/.test(html);
+    if (!complete) {
+      throw new Error(`mira_sample_deterministic_interactive_failed:behavior:${widgetType}`);
+    }
+  }
+}
+
+/**
+ * Build and strictly validate the complete deterministic classroom draft.
+ * This boundary performs no LLM, media, persistence, or TTS calls, so backend
+ * contract validators can inspect the exact 10-scene artifact before any paid
+ * speech request is allowed.
+ */
+export function buildMiraSampleDeterministicDraft(plan: MiraSampleStructuralPlan): {
+  stage: Stage;
+  scenes: Scene[];
+} {
+  const ttsPolicy = getMiraTtsPolicy();
+  if (!ttsPolicy) {
+    throw new Error('mira_sample_deterministic_recovery_requires_qwen3_tts_policy');
+  }
+  const stageId = nanoid(10);
+  const stage: Stage = {
+    id: stageId,
+    name: plan.courseTitle,
+    languageDirective: plan.languageDirective,
+    videoManifest: buildVideoManifestFromOutlines(plan.outlines),
+    style: 'interactive',
+    createdAt: Date.now(),
+    updatedAt: Date.now(),
+    generatedAgentConfigs: plan.agents.map((agent, index) => {
+      const voiceConfig = getMiraTeacherVoiceConfig(agent.role, ttsPolicy);
+      return {
+        id: agent.id,
+        name: getMiraTeacherName(agent.role, agent.name, ttsPolicy),
+        role: agent.role,
+        persona: agent.persona || '',
+        avatar: AGENT_DEFAULT_AVATARS[index % AGENT_DEFAULT_AVATARS.length],
+        color: AGENT_COLOR_PALETTE[index % AGENT_COLOR_PALETTE.length],
+        priority: agent.role === 'teacher' ? 10 : 5,
+        ...(voiceConfig ? { voiceConfig } : {}),
+      };
+    }),
+  };
+  const scenes = plan.outlines.map((outline) => {
+    const content = contentFor(outline.order);
+    const actions = ensureMiraSampleSceneActions(
+      outline,
+      content,
+      actionsFor(outline.order, content),
+    );
+    const scene = buildCompleteScene(outline, content, actions, stageId);
+    if (!scene) throw new Error(`mira_sample_deterministic_scene_failed:${outline.id}`);
+    return scene as Scene;
+  });
+  assertMiraSampleClassroomStructure(stage, scenes);
+  assertMiraSampleDeterministicInteractiveContract(scenes);
+  return { stage, scenes };
+}
+
+async function audioManifest(stageId: string, scenes: readonly Scene[]) {
+  const manifest: Array<{ actionId: string; bytes: number; sha256: string }> = [];
+  for (const scene of scenes) {
+    for (const action of scene.actions || []) {
+      if (action.type !== 'speech' || !action.audioUrl) continue;
+      const filename = path.basename(new URL(action.audioUrl, 'http://runtime.invalid').pathname);
+      const bytes = await fs.readFile(path.join(CLASSROOMS_DIR, stageId, 'audio', filename));
+      manifest.push({ actionId: action.id, bytes: bytes.length, sha256: sha256(bytes) });
+    }
+  }
+  return manifest;
+}
+
+export async function generateMiraSampleDeterministicClassroom(
+  plan: MiraSampleStructuralPlan,
+  options: GenerateOptions,
+): Promise<MiraSampleDeterministicResult> {
+  if (options.baseUrl !== '') {
+    throw new Error('mira_sample_deterministic_recovery_requires_relative_urls');
+  }
+  await options.onProgress?.({
+    step: 'initializing',
+    progress: 5,
+    message: 'Initializing deterministic Mira sample recovery',
+    scenesGenerated: 0,
+  });
+  await options.onProgress?.({
+    step: 'generating_outlines',
+    progress: 20,
+    message: 'Loading server-owned 10-scene lesson specification',
+    scenesGenerated: 0,
+    totalScenes: 10,
+  });
+  const { stage, scenes } = buildMiraSampleDeterministicDraft(plan);
+  await options.onProgress?.({
+    step: 'generating_scenes',
+    progress: 88,
+    message: 'Built and validated 10 deterministic scenes without LLM calls',
+    scenesGenerated: 10,
+    totalScenes: 10,
+  });
+  await options.onProgress?.({
+    step: 'generating_tts',
+    progress: 94,
+    message: 'Generating required Qwen3-TTS narration',
+    scenesGenerated: 10,
+    totalScenes: 10,
+  });
+  const tts = await generateTTSForClassroom(scenes, stage.id, options.baseUrl, {
+    onSpeechAttempted: options.onTtsAttempted,
+    onSpeechGenerated: options.onTtsProgress,
+  });
+  if (tts.speechCount !== 10) {
+    throw new Error(`mira_sample_deterministic_tts_count:${tts.speechCount}`);
+  }
+  assertMiraSampleClassroomStructure(stage, scenes);
+  assertMiraSampleDeterministicInteractiveContract(scenes);
+  await options.onProgress?.({
+    step: 'persisting',
+    progress: 98,
+    message: 'Persisting deterministic recovery artifact',
+    scenesGenerated: 10,
+    totalScenes: 10,
+  });
+  const persisted = await persistClassroom({ id: stage.id, stage, scenes }, options.baseUrl);
+  const audio = await audioManifest(stage.id, scenes);
+  if (audio.length !== 10) throw new Error(`mira_sample_deterministic_audio_count:${audio.length}`);
+  const contentSha256 = sha256(JSON.stringify({ stage, scenes }));
+  const artifactSha256 = sha256(JSON.stringify({ contentSha256, audio }));
+  const deterministicReceipt: MiraSampleDeterministicReceipt = {
+    schemaVersion: 'mira.openmaic.deterministic-classroom-receipt.v1',
+    kind: MIRA_SAMPLE_DETERMINISTIC_RECOVERY_KIND,
+    mode: MIRA_SAMPLE_DETERMINISTIC_RECOVERY_MODE,
+    policyVersion: MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION,
+    canonicalSpecSha256: miraSampleCanonicalSpecSha256(plan),
+    calls: { llm: 0, webSearch: 0, imageGeneration: 0, videoGeneration: 0, tts: 10 },
+    contentSha256,
+    artifactSha256,
+    audio,
+    tts: {
+      providerId: String(tts.providerId),
+      modelId: tts.modelId,
+      voiceId: tts.voiceId,
+      speechCount: 10,
+      fallbackUsed: false,
+    },
+  };
+  await options.onProgress?.({
+    step: 'completed',
+    progress: 100,
+    message: 'Deterministic Mira sample recovery completed',
+    scenesGenerated: 10,
+    totalScenes: 10,
+  });
+  return {
+    id: persisted.id,
+    url: persisted.url,
+    stage,
+    scenes,
+    scenesCount: scenes.length,
+    createdAt: persisted.createdAt,
+    deterministicReceipt,
+  };
+}
