+// @vitest-environment jsdom
+import { describe, expect, it, vi } from 'vitest';
+import { connectStudentParentReady, hasVisibleStudentClassroom } from '../../lib/mira/student-parent-ready';
+
+function fixture() {
+  let receiver: ((event: MessageEvent) => void) | undefined;
+  let ready = false;
+  const parent = { postMessage: vi.fn() };
+  const listeners = {
+    parent,
+    addEventListener: (_type: string, fn: (event: MessageEvent) => void) => { receiver = fn; },
+    removeEventListener: (_type: string, fn: (event: MessageEvent) => void) => { if (receiver === fn) receiver = undefined; },
+    setTimeout: globalThis.setTimeout,
+    clearTimeout: globalThis.clearTimeout,
+  };
+  const channel = connectStudentParentReady(listeners as unknown as Window, ['https://student.example'], () => ready);
+  const ping = (changes: Partial<MessageEvent> = {}) => receiver?.({
+    isTrusted: true, source: parent, origin: 'https://student.example',
+    data: {type: 'mira.textbook.ready-ping'}, ...changes,
+  } as unknown as MessageEvent);
+  return { channel, ping, parent, setReady: (value: boolean) => { ready = value; } };
+}
+
+describe('student parent readiness channel', () => {
+  it('accepts only a trusted exact ping from the configured immediate parent', () => {
+    const f = fixture(); f.setReady(true);
+    for (const changes of [
+      {origin: 'null'}, {origin: 'https://student.example.evil.test'}, {origin: 'http://student.example'},
+      {source: {} as Window}, {isTrusted: false}, {data: null},
+      {data: {type: 'mira.textbook.ready-ping', ticket: 'extra'}}, {data: {type: 'mira.textbook.pause'}},
+    ]) f.ping(changes);
+    expect(f.parent.postMessage).not.toHaveBeenCalled();
+    f.ping();
+    expect(f.parent.postMessage).toHaveBeenCalledExactlyOnceWith({type: 'mira.textbook.ready'}, 'https://student.example');
+    f.channel.dispose();
+    f.ping();
+    expect(f.parent.postMessage).toHaveBeenCalledTimes(1);
+  });
+
+  it('holds an early ping until the scene is ready, then cleans up on course change', () => {
+    vi.useFakeTimers();
+    try {
+      const f = fixture(); f.ping();
+      expect(f.parent.postMessage).not.toHaveBeenCalled();
+      vi.advanceTimersByTime(300);
+      expect(f.parent.postMessage).not.toHaveBeenCalled();
+      f.setReady(true); vi.advanceTimersByTime(100);
+      expect(f.parent.postMessage).toHaveBeenCalledExactlyOnceWith({type: 'mira.textbook.ready'}, 'https://student.example');
+      const other = fixture(); other.ping(); other.channel.dispose(); other.setReady(true);
+      vi.advanceTimersByTime(1000);
+      expect(other.parent.postMessage).not.toHaveBeenCalled();
+      f.channel.dispose();
+    } finally { vi.useRealTimers(); }
+  });
+
+  it('does not answer loading/error content, detached or invisible scenes, or another scene', () => {
+    const scene = document.createElement('div');
+    const shell = document.createElement('div');
+    const root = document.createElement('div');
+    root.appendChild(shell); shell.appendChild(scene); document.body.appendChild(root);
+    shell.setAttribute('data-mira-playback-shell', 'storybook');
+    scene.setAttribute('data-mira-scene-content', 'scene-p1');
+    vi.spyOn(scene, 'getBoundingClientRect').mockReturnValue({width: 800,height: 450} as DOMRect);
+    const styles = vi.spyOn(window, 'getComputedStyle').mockReturnValue({display:'block',visibility:'visible',opacity:'1'} as CSSStyleDeclaration);
+    try {
+      expect(hasVisibleStudentClassroom(root, 'scene-p1')).toBe(true);
+      expect(hasVisibleStudentClassroom(root, 'scene-p2')).toBe(false);
+      styles.mockReturnValue({display:'block',visibility:'hidden',opacity:'1'} as CSSStyleDeclaration);
+      expect(hasVisibleStudentClassroom(root, 'scene-p1')).toBe(false);
+      styles.mockImplementation(node => ({display:'block',visibility:'visible',opacity:node===document.body?'0':'1'}) as CSSStyleDeclaration);
+      expect(hasVisibleStudentClassroom(root, 'scene-p1')).toBe(false); // A hidden ancestor above the classroom also counts.
+      scene.remove(); // Loading, error, or not-found surfaces have no scene marker.
+      expect(hasVisibleStudentClassroom(root, 'scene-p1')).toBe(false);
+      root.remove();
+      expect(hasVisibleStudentClassroom(root, 'scene-p1')).toBe(false);
+    } finally { styles.mockRestore(); root.remove(); }
+  });
+
+  it('accepts the visible whiteboard for the current scene without accepting a previous scene', () => {
+    const root = document.createElement('div'); const shell = document.createElement('div');
+    const whiteboard = document.createElement('div'); document.body.appendChild(root);
+    root.appendChild(shell); shell.appendChild(whiteboard);
+    shell.setAttribute('data-mira-playback-shell', 'storybook');
+    whiteboard.setAttribute('data-mira-whiteboard-scene', 'scene-p1');
+    vi.spyOn(whiteboard, 'getBoundingClientRect').mockReturnValue({width: 800,height: 450} as DOMRect);
+    const styles = vi.spyOn(window, 'getComputedStyle').mockReturnValue({display:'block',visibility:'visible',opacity:'1'} as CSSStyleDeclaration);
+    try {
+      expect(hasVisibleStudentClassroom(root, 'scene-p1')).toBe(true);
+      expect(hasVisibleStudentClassroom(root, 'scene-p2')).toBe(false);
+      whiteboard.removeAttribute('data-mira-whiteboard-scene');
+      expect(hasVisibleStudentClassroom(root, 'scene-p1')).toBe(false);
+    } finally { styles.mockRestore(); root.remove(); }
+  });
+});
