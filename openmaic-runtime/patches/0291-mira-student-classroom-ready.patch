+/** A ready message is a presentation handshake, not a learning receipt. */
+const READY_PING = 'mira.textbook.ready-ping';
+const READY = 'mira.textbook.ready';
+
+export interface StudentParentReadyChannel {
+  /** Recheck a previously validated ping after the classroom commits. */
+  flush(): void;
+  dispose(): void;
+}
+
+/**
+ * Only the configured immediate parent can ask whether this document has
+ * mounted its classroom.  Never post to '*', and never include a ticket,
+ * course identity, or learning state in the reply.
+ */
+export function connectStudentParentReady(
+  self: Window,
+  origins: readonly string[],
+  canAnnounce: () => boolean,
+): StudentParentReadyChannel {
+  const parent = self.parent;
+  let active = true;
+  let pendingOrigin: string | null = null;
+  let retry: number | null = null;
+  let retryCount = 0;
+
+  const flush = () => {
+    if (!active || !pendingOrigin || parent === self) return;
+    let ready = false;
+    try { ready = canAnnounce(); } catch { /* Remain silent until ready can be verified. */ }
+    if (!ready) {
+      // A scene can mount at opacity zero or before its viewport is sized;
+      // a bounded retry also handles a ping received during the load screen.
+      if (retry === null && retryCount < 100) {
+        retryCount += 1;
+        retry = self.setTimeout(() => { retry = null; flush(); }, 100);
+      }
+      return;
+    }
+    const origin = pendingOrigin;
+    pendingOrigin = null;
+    if (retry !== null) self.clearTimeout(retry);
+    retry = null;
+    parent.postMessage({ type: READY }, origin);
+  };
+  const receive = (event: MessageEvent) => {
+    if (!active || parent === self || event.source !== parent || !origins.includes(event.origin)
+        || event.isTrusted !== true || !event.data || typeof event.data !== 'object'
+        || Array.isArray(event.data) || Object.keys(event.data).length !== 1
+        || event.data.type !== READY_PING) return;
+    pendingOrigin = event.origin;
+    retryCount = 0;
+    flush();
+  };
+  self.addEventListener('message', receive);
+  return {
+    flush,
+    dispose() {
+      active = false;
+      pendingOrigin = null;
+      if (retry !== null) self.clearTimeout(retry);
+      retry = null;
+      self.removeEventListener('message', receive);
+    },
+  };
+}
+
+/** The current scene or its open whiteboard must have a laid-out playback canvas. */
+export function hasVisibleStudentClassroom(root: HTMLElement | null, sceneId: string): boolean {
+  if (!root?.isConnected || !sceneId) return false;
+  const shell = root.querySelector<HTMLElement>('[data-mira-playback-shell="storybook"]');
+  const scene = shell?.querySelector<HTMLElement>('[data-mira-scene-content], [data-mira-whiteboard-scene]');
+  if (!scene || (scene.getAttribute('data-mira-scene-content') ?? scene.getAttribute('data-mira-whiteboard-scene')) !== sceneId
+      || !scene.isConnected) return false;
+  const view = root.ownerDocument.defaultView;
+  if (!view) return false;
+  const box = scene.getBoundingClientRect();
+  if (!(box.width > 0 && box.height > 0)) return false;
+  // Motion may initially mount its shell at zero opacity. Do not advertise a
+  // classroom that is still hidden by its own layout or transition.
+  let withinRoot = false;
+  for (let node: HTMLElement | null = scene; node; node = node.parentElement) {
+    const style = view.getComputedStyle(node);
+    if (style.display === 'none' || style.visibility === 'hidden' || style.visibility === 'collapse'
+        || Number(style.opacity) === 0) return false;
+    if (node === root) withinRoot = true;
+  }
+  return withinRoot;
+}
