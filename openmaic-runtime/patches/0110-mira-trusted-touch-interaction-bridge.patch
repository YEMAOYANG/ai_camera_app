 describe('injected student observer observes changes without rehearsing golden answers', () => {
+  it('keeps pre-touch feedback when a compatibility click arrives before polling and reports once', () => {
+    const h = observerHarness(fractionObjectives);
+    const port = h.connect();
+    const control = h.nodes.get('#numerator-plus')!;
+    h.dispatch('touchstart', control);
+    h.nodes.get('#reason')!.textContent = '触摸操作后的可见反馈';
+    h.dispatch('click', control);
+    h.flush();
+    h.dispatch('click', control);
+    h.nodes.get('#reason')!.textContent = '重复事件后的反馈';
+    h.flush();
+    expect(port.observations).toHaveLength(1);
