+      action: 'click',
+      feedbackText: '触摸操作后的可见反馈',
+    });
+  });
+
+  it('rejects synthetic and unchanged touches and expires their pending observation before a later click', () => {
+    const h = observerHarness(fractionObjectives);
+    const port = h.connect();
+    const control = h.nodes.get('#numerator-plus')!;
+    h.dispatch('touchstart', control, false);
+    h.nodes.get('#reason')!.textContent = '脚本改了反馈';
+    h.flush();
+    h.dispatch('touchstart', control);
+    h.flush();
+    expect(port.observations).toEqual([]);
+    h.dispatch('click', control);
+    h.nodes.get('#reason')!.textContent = '之后真实点击的新反馈';
+    h.flush();
+    expect(port.observations).toHaveLength(1);
