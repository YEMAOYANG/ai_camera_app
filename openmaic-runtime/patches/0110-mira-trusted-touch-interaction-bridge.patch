diff --git a/tests/runtime/mira-student-touch-bridge.browser.test.ts b/tests/runtime/mira-student-touch-bridge.browser.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/runtime/mira-student-touch-bridge.browser.test.ts
@@ -0,0 +1,169 @@
+import { describe, expect, it } from 'vitest';
+import { chromium } from 'playwright-core';
+import { createRequire } from 'node:module';
+import { patchHtmlForIframe } from '@/lib/utils/iframe';
+
+const objective = {
+  objectiveIndex: 1,
+  operation: { sceneId: 'operate', controlSelector: '#sing', action: 'click' },
+  feedback: { sceneId: 'operate', selector: '#result' },
+};
+type Host = Window & { events: unknown[]; active: boolean; disconnect: () => void };
+const escape = (value: string) =>
+  value.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;');
+// Real p6 behavior: two local touch handlers change feedback and cancel click.
+const fixture = (cancel: boolean, touchChanges = true, clickChanges = true) => `
+<button id="sing" style="width:120px;height:60px">sing</button>
+<output id="result" style="display:block">He ate yesterday.</output>
+<script>
+window.nativeEvents=[];
+['touchstart','click'].forEach(type=>window.addEventListener(type,e=>window.nativeEvents.push({type,trusted:e.isTrusted}),true));
+const change=()=>{result.textContent='He sang yesterday. sing 的过去式 sang';};
+for(let i=0;i<2;i++)sing.addEventListener('touchstart',e=>{${cancel ? 'e.preventDefault();' : ''}${touchChanges ? 'change();' : ''}},{passive:false});
+sing.addEventListener('click',()=>{${clickChanges ? 'change();' : ''}});
+window.addEventListener('message',e=>{if(e.data.type==='SET_WIDGET_STATE')change();});
+</script>`;
+
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== '1')(
+  'trusted touch participation bridge',
+  () => {
+    it('records canceled and compatible taps once while preserving private-port and visible-change checks', async () => {
+      const require = createRequire(import.meta.url);
+      const { build } = createRequire(require.resolve('tsx'))('esbuild');
+      const bundle = await build({
+        stdin: {
+          resolveDir: process.cwd(),
+          loader: 'ts',
+          contents: `
+import {connectStudentInteractionFrame} from './lib/mira/student-interaction-bridge';
+window.events=[];window.active=true;
+window.disconnect=connectStudentInteractionFrame({frame:document.querySelector('iframe'),objectives:${JSON.stringify([objective])},active:()=>window.active,onOperation:op=>window.events.push(op)});`,
+        },
+        bundle: true,
+        write: false,
+        format: 'iife',
+        platform: 'browser',
+        logLevel: 'silent',
+      });
+      const browser = await chromium.launch({
+        executablePath:
+          process.env.MIRA_FORMAL_QA_BROWSER_PATH ||
+          '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
+        headless: true,
+      });
+      try {
+        for (const mode of [
+          'cancel',
+          'compatibility',
+          'click-only',
+          'no-change',
+          'untrusted',
+          'hidden-feedback',
+          'inactive',
+          'disconnected',
+          'mouse',
+          'keyboard',
+        ]) {
+          const context = await browser.newContext({
+            viewport: { width: 800, height: 600 },
+            hasTouch: true,
+          });
+          try {
+            const page = await context.newPage();
+            await page.route('**/*', (route) => route.abort());
+            const markup = fixture(
+              mode !== 'compatibility' && mode !== 'click-only',
+              mode !== 'no-change' && mode !== 'click-only',
+              mode !== 'no-change',
+            );
+            await page.setContent(
+              `<iframe sandbox="allow-scripts" style="width:600px;height:300px" srcdoc="${escape(patchHtmlForIframe(markup))}"></iframe>`,
+            );
+            await page.addScriptTag({ content: bundle.outputFiles[0].text });
+            const frame = page.frames().find((frame) => frame !== page.mainFrame())!;
+            await page.waitForTimeout(50); // Private MessagePort delivery is asynchronous.
+            if (mode === 'untrusted') {
+              await frame.evaluate(() => {
+                const button = document.querySelector('button')!;
+                button.dispatchEvent(new Event('touchstart', { bubbles: true, cancelable: true }));
+                button.click();
+                window.parent.postMessage(
+                  { objectiveIndex: 1, action: 'click', feedbackText: 'forged' },
+                  '*',
+                );
+              });
+              await page
+                .locator('iframe')
+                .evaluate((frame) =>
+                  (frame as HTMLIFrameElement).contentWindow!.postMessage(
+                    { type: 'SET_WIDGET_STATE', state: { action: 'sing' } },
+                    '*',
+                  ),
+                );
+            } else {
+              if (mode === 'hidden-feedback')
+                await frame.locator('output').evaluate((e) => (e.style.opacity = '0'));
+              if (mode === 'inactive')
+                await page.evaluate(() => ((window as unknown as Host).active = false));
+              if (mode === 'disconnected')
+                await page.evaluate(() => (window as unknown as Host).disconnect());
+              if (mode === 'mouse') await frame.getByRole('button').click();
+              else if (mode === 'keyboard') await frame.getByRole('button').press('Enter');
+              else await frame.getByRole('button').tap();
+            }
+            const accepted = [
+              'cancel',
+              'compatibility',
+              'click-only',
+              'mouse',
+              'keyboard',
+            ].includes(mode);
+            if (accepted)
+              await page.waitForFunction(() => (window as unknown as Host).events.length === 1);
+            await page.waitForTimeout(mode === 'no-change' ? 2150 : 100);
+            const events = await page.evaluate(() => (window as unknown as Host).events);
+            expect(events, mode).toHaveLength(accepted ? 1 : 0);
+            if (accepted) {
+              expect(events[0], mode).toMatchObject({
+                objectiveIndex: 1,
+                controlSelector: '#sing',
+                action: 'click',
+                value: '',
+                feedbackText: 'He sang yesterday. sing 的过去式 sang',
+              });
+              await frame.getByRole('button').tap();
+              await page.waitForTimeout(100);
+              expect(
+                await page.evaluate(() => (window as unknown as Host).events.length),
+                mode + ' repeated tap',
+              ).toBe(1);
+            }
+            if (mode === 'cancel') {
+              expect(
+                await frame.evaluate(
+                  () => (window as unknown as { nativeEvents: unknown[] }).nativeEvents,
+                ),
+              ).toEqual([
+                { type: 'touchstart', trusted: true },
+                { type: 'touchstart', trusted: true },
+              ]);
+            }
+            if (mode === 'compatibility') {
+              expect(
+                await frame.evaluate(() =>
+                  (
+                    window as unknown as { nativeEvents: Array<{ type: string }> }
+                  ).nativeEvents.some((e) => e.type === 'click'),
+                ),
+              ).toBe(true);
+            }
+          } finally {
+            await context.close();
+          }
+        }
+      } finally {
+        await browser.close();
+      }
+    }, 30_000);
+  },
+);
