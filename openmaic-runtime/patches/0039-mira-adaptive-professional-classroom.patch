+            type: 'text',
+            content: '<p>先看这里</p>',
+            left: 120,
+            top: 120,
+            width: 320,
+            height: 80,
+            rotate: 0,
+          },
+          {
+            id: 'detail-target',
+            type: 'text',
+            content: '<p>再看这里</p>',
+            left: 520,
+            top: 120,
+            width: 320,
+            height: 80,
+            rotate: 0,
+          },
+        ],
+      },
+    },
+    actions,
+    createdAt: Date.UTC(2026, 0, 1),
+    updatedAt: Date.UTC(2026, 0, 1),
+  } as Scene;
+}
+
+describe('Mira formal slide spotlight sequence', () => {
+  it('accepts official focus sequences while allowing unfocused transition speech', () => {
+    expect(
+      hasMiraFormalSlideSpotlightSequence(
+        slide([
+          { id: 'speech-opening', type: 'speech', text: '我们先看整张图。' },
+          { id: 'spotlight-1', type: 'spotlight', elementId: 'focus-target' },
+          { id: 'spotlight-2', type: 'spotlight', elementId: 'detail-target' },
+          { id: 'speech-focused', type: 'speech', text: '这两个位置共同说明了重点。' },
+          { id: 'speech-closing', type: 'speech', text: '现在把它们连起来想一想。' },
+        ]),
+      ),
+    ).toBe(true);
+
+    expect(
+      hasMiraFormalSlideSpotlightSequence(
+        slide([
+          { id: 'speech-1', type: 'speech', text: '顺序错误。' },
+          { id: 'spotlight-1', type: 'spotlight', elementId: 'focus-target' },
+        ]),
+      ),
+    ).toBe(false);
+    expect(
+      hasMiraFormalSlideSpotlightSequence(
+        slide([
+          { id: 'spotlight-1', type: 'spotlight', elementId: 'missing-target' },
+          { id: 'speech-1', type: 'speech', text: '目标不存在。' },
+        ]),
+      ),
+    ).toBe(false);
+    expect(
+      hasMiraFormalSlideSpotlightSequence(
+        slide([
+          { id: 'spotlight-1', type: 'spotlight', elementId: 'focus-target' },
+          { id: 'speech-1', type: 'speech', text: '第一段。' },
+          { id: 'speech-2', type: 'speech', text: '第二段。' },
+        ]),
+      ),
+    ).toBe(true);
+    expect(
+      hasMiraFormalSlideSpotlightSequence(
