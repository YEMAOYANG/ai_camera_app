+
+function slide(actions: Scene['actions'], elementId = 'focus-target'): Scene {
+  return {
+    id: 'slide-1',
+    stageId: 'stage-1',
+    order: 0,
+    type: 'slide',
+    title: '聚光讲解',
+    content: {
+      type: 'slide',
+      canvas: {
+        id: 'canvas-1',
