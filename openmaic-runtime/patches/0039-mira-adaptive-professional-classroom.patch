+export function hasMiraFormalSlideSpotlightSequence(scene: Scene): boolean {
+  if (scene.type !== 'slide' || scene.content.type !== 'slide') return false;
+  const canvas = plainObject(scene.content.canvas);
+  const renderableElementIds = new Set(
+    (Array.isArray(canvas?.elements) ? canvas.elements : []).flatMap((element) => {
+      const candidate = plainObject(element);
+      return candidate &&
+        typeof candidate.id === 'string' &&
+        candidate.id.trim() &&
+        typeof candidate.type === 'string' &&
+        candidate.type.trim() &&
+        candidate.visible !== false
+        ? [candidate.id]
+        : [];
+    }),
+  );
+  const actions = Array.isArray(scene.actions) ? scene.actions : [];
+  const rawSpeechIndexes = actions.flatMap((action, index) =>
+    action.type === 'speech' ? [index] : [],
+  );
+  const speechIndexes = rawSpeechIndexes.filter((index) => {
+    const action = actions[index];
+    return action?.type === 'speech' && typeof action.text === 'string' && !!action.text.trim();
+  });
+  const speechPolicy = MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT.speechActions.perScene;
+  if (
+    rawSpeechIndexes.length !== speechIndexes.length ||
+    speechIndexes.length < speechPolicy.min ||
+    speechIndexes.length > speechPolicy.max
+  ) {
+    return false;
+  }
+  const spotlightIndexes = actions.flatMap((action, index) =>
+    action.type === 'spotlight' ? [index] : [],
+  );
+  if (
+    spotlightIndexes.length <
+      MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT.slideSpotlight.minimumPerSlide ||
+    spotlightIndexes.some((index) => {
+      const spotlight = actions[index];
+      return (
+        spotlight?.type !== 'spotlight' ||
+        typeof spotlight.elementId !== 'string' ||
+        !renderableElementIds.has(spotlight.elementId)
+      );
+    })
+  ) {
+    return false;
+  }
+  const speechIndexSet = new Set(speechIndexes);
+  return spotlightIndexes.some((index) => speechIndexSet.has(index + 1));
+}
