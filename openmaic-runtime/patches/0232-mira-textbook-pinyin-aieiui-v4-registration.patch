+describe('AI EI UI frozen v4 registration', () => {
+  const v4 = 'mira.textbook.pinyin-aieiui-ssml.v4';
+  const backendV4 = JSON.parse(readFileSync(fileURLToPath(new URL(
+    '../../../../../backend/content/textbook_pinyin_pronunciation_aieiui.v4.json',
+    import.meta.url,
+  )), 'utf8'));
+
+  it('matches the frozen backend policy without changing v1', () => {
+    expect(registry.MIRA_TEXTBOOK_PINYIN_AIEIUI_V4_PRONUNCIATION_POLICY).toEqual(backendV4);
+    expect(prepare('请听。', v4).profile.policySha256).toBe(
+      'd26d1744a110f0ed327d08cdfeb950fe8f15b198fb322f98aa5611f866c6b8b8',
+    );
+    expect(prepare('请听。', version).profile.policySha256).toBe(
+      '8b927f95d0f279c31c9ae90c7aebcaf8520c34ed829982fda8aa4dfebadd4188',
+    );
+    expect(prepare('luó bo', version).ssml).toBe(
+      '<speak><phoneme alphabet="py" ph="luo2">萝</phoneme> <phoneme alphabet="py" ph="bo5">卜</phoneme></speak>',
+    );
+  });
+
+  it('uses the approved full-source override only for its exact source', () => {
+    expect(prepare('luó bo', v4).ssml).toBe('<speak><sub alias="萝卜">luó bo</sub>。</speak>');
+    expect(prepare('请听，luó bo。', v4).ssml).toBe(prepare('请听，luó bo。', version).ssml);
+    expect(prepare('luó  bo', v4).ssml).not.toContain('<sub');
+    expect(() => prepare(' luó bo', v4)).toThrow();
+  });
+
+  it('keeps other whole-token recipes identical and rejects unregistered tokens', () => {
+    for (const text of Object.keys(probes).filter(text => text !== 'luó bo')) {
+      expect(prepare(text, v4).ssml).toBe(prepare(text, version).ssml);
+      expect(prepare(text, v4).providerRequest).toEqual(prepare(text, version).providerRequest);
+    }
+    for (const text of ['ai', 'ūi', 'bo5', 'luo', 'áí', 'abc', 'u\u0301i']) {
+      expect(() => prepare(text, v4)).toThrow();
+    }
+    expect(() => prepare('请听。', 'mira.textbook.pinyin-aieiui-ssml.v5')).toThrow();
+  });
