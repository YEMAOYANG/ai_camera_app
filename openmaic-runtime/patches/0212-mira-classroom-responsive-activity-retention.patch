+import { describe, expect, it } from 'vitest';
+import { chromium } from 'playwright-core';
+import { createRequire } from 'node:module';
+
+type ActivityWindow = Window & {
+  cards: number;
+  documentToken: string;
+  poolInfo: () => { ids: string[]; retained: string[]; classroomId: string | null; active: string | null };
+};
+type BuildHooks = {
+  onResolve: (options: { filter: RegExp }, callback: (args: { path: string }) =>
+    { path: string; namespace: string } | undefined) => void;
+  onLoad: (options: { filter: RegExp; namespace: string }, callback: (args: { path: string }) =>
+    { contents: string; loader: string; resolveDir: string }) => void;
+};
+
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== '1')(
+  'current classroom activity retention in a real browser',
+  () => {
+    it('keeps five responsive works, bounds ordinary frames, and resets on content or classroom changes', async () => {
+      const require = createRequire(import.meta.url);
+      const { build } = createRequire(require.resolve('tsx'))('esbuild');
+      const mocks: Record<string, string> = {
+        '@/lib/contexts/mira-student-runtime-context':
+          'export const useMiraStudentRuntimeEvents=()=>null;',
+        '@/lib/mira/student-interaction-bridge':
+          "export const studentInteractionObjectives=()=>[];export const connectStudentInteractionFrame=()=>()=>{};export const STUDENT_INTERACTION_OBSERVER='';",
+        '@/lib/hooks/use-i18n': 'export const useI18n=()=>({t:k=>k});',
+        '@/lib/store/stage':
+          "import {create} from 'zustand';export const useStageStore=create(()=>({stage:null,scenes:[]}));",
+        '@/lib/store/canvas':
+          'const s={pickTarget:null,setPickTarget(){}};export const useCanvasStore={use:{pickTarget:()=>null},getState:()=>s};',
+        '@/lib/store/element-refs':
+          'const refs=[];export const useElementRefsStore={use:{refs:()=>refs},getState:()=>({refs})};',
+      };
+      const html = `<!doctype html><html><head><meta name="mira-responsive-activity" content="low-reading-v1"></head><body>
+<button id="make">Add to my work</button><output id="work">0</output>
+<script>window.documentToken=Math.random().toString(36);window.cards=0;make.onclick=()=>{work.textContent=String(++cards)};</script></body></html>`;
+      const bundle = await build({
+        stdin: {
+          resolveDir: process.cwd(), loader: 'tsx',
+          contents: `
+import React,{useState} from 'react';import {createRoot} from 'react-dom/client';
+import {InteractiveIframeHost} from './components/scene-renderers/InteractiveIframeHost';
+import {InteractiveRenderer} from './components/scene-renderers/interactive-renderer';
+import {useInteractiveIframePool} from './lib/store/interactive-iframe-pool';
+import {useStageStore} from '@/lib/store/stage';
+const initial=${JSON.stringify(html)};const ids=['a','b','c','d','e'];
+const ordinary=initial.replace('<meta name="mira-responsive-activity" content="low-reading-v1">','');
+const scenes=[...ids.map(id=>({id,order:1,type:'interactive',content:{type:'interactive',html:initial}})),
+...Array.from({length:5},(_,i)=>({id:'ordinary-'+i,order:2,type:'interactive',content:{type:'interactive',html:ordinary}})),
+{id:'comment-marker',order:3,type:'interactive',content:{type:'interactive',html:ordinary.replace('<head>','<head><!-- <meta name="mira-responsive-activity" content="low-reading-v1"> -->')}},
+{id:'slide-marker',order:4,type:'slide',content:{type:'slide',html:initial}}];
+window.poolInfo=()=>{const p=useInteractiveIframePool.getState();return{ids:Object.keys(p.entries),retained:p.retainedSceneIds,classroomId:p.classroomId,active:p.activeSceneId}};
+function App(){const[container,setContainer]=useState(null);const[host,setHost]=useState(true);const[current,setCurrent]=useState(null);const[revision,setRevision]=useState(false);return <div ref={setContainer} style={{height:'100vh',background:'white'}}>
+<button id='load' onClick={()=>useStageStore.setState({stage:{id:'lesson-one'},scenes})}>Load lesson</button>
+{[...ids,...Array.from({length:5},(_,i)=>'ordinary-'+i)].map(id=><button key={id} id={'visit-'+id} onClick={()=>setCurrent(id)}>{id}</button>)}
+<button id='replace' onClick={()=>setRevision(true)}>Update activity</button>
+<button id='switch' onClick={()=>useStageStore.setState({stage:{id:'lesson-two'},scenes})}>Switch classroom</button>
+<button id='leave' onClick={()=>setHost(false)}>Leave classroom</button>
+{host&&current&&<div style={{position:'absolute',left:10,top:160,width:360,height:320}}><InteractiveRenderer sceneId={current} content={{type:'interactive',url:'',html:ids.includes(current)?(revision?initial.replace('window.cards=0','window.cards=40'):initial):ordinary}}/></div>}
+{host&&<InteractiveIframeHost container={container}/>}</div>};createRoot(document.querySelector('#app')).render(<App/>);`,
+        },
+        bundle: true, write: false, format: 'iife', platform: 'browser', logLevel: 'silent',
+        define: { 'process.env.NODE_ENV': '"test"' },
+        plugins: [{ name: 'isolated-app-integrations', setup(b: BuildHooks) {
+          b.onResolve({ filter: /^@\// }, (args) => mocks[args.path]
+            ? { path: args.path, namespace: 'test-mock' } : undefined);
+          b.onLoad({ filter: /.*/, namespace: 'test-mock' }, (args) =>
+            ({ contents: mocks[args.path], loader: 'js', resolveDir: process.cwd() }));
+        } }],
+      });
+      const browser = await chromium.launch({
+        executablePath: process.env.MIRA_FORMAL_QA_BROWSER_PATH ||
+          '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', headless: true,
+      });
+      try {
+        const page = await browser.newPage({ viewport: { width: 800, height: 600 } });
+        page.setDefaultTimeout(8000);
+        await page.route('**/*', (route) => route.abort());
+        await page.setContent('<style>.w-full{width:100%}.h-full{height:100%}</style><div id="app"></div>');
+        await page.addScriptTag({ content: bundle.outputFiles[0].text });
+        // The first child may mount before the asynchronous classroom identity.
+        await page.locator('#visit-a').click();
+        const first = await (await page.locator('iframe[title="Interactive Scene a"]').elementHandle())!.contentFrame();
+        await first!.getByRole('button', { name: 'Add to my work' }).click();
+        const token = await first!.evaluate(() => (window as unknown as ActivityWindow).documentToken);
+        await page.locator('#load').click();
+        await page.waitForFunction(() => (window as unknown as ActivityWindow).poolInfo().classroomId === 'lesson-one');
+        expect(await first!.evaluate(() => (window as unknown as ActivityWindow).cards)).toBe(1);
+        expect(await first!.evaluate(() => (window as unknown as ActivityWindow).documentToken)).toBe(token);
+        expect(await page.evaluate(() => (window as unknown as ActivityWindow).poolInfo().retained)).toEqual(['a', 'b', 'c', 'd', 'e']);
+        for (const id of ['b', 'c', 'd', 'e']) {
+          await page.locator('#visit-' + id).click();
+          const child = await (await page.locator(`iframe[title="Interactive Scene ${id}"]`).elementHandle())!.contentFrame();
+          await child!.getByRole('button', { name: 'Add to my work' }).click();
+        }
+        await page.locator('#visit-a').click();
+        expect(await first!.evaluate(() => ({ token: (window as unknown as ActivityWindow).documentToken, cards: (window as unknown as ActivityWindow).cards })))
+          .toEqual({ token, cards: 1 });
+        for (let i = 0; i < 5; i++) await page.locator('#visit-ordinary-' + i).click();
+        const info = await page.evaluate(() => (window as unknown as ActivityWindow).poolInfo());
+        expect(info.ids).toHaveLength(8);
+        expect(info.ids.filter((id: string) => id.startsWith('ordinary-')))
+          .toEqual(['ordinary-2', 'ordinary-3', 'ordinary-4']);
+        await page.locator('#visit-a').click();
+        expect(await first!.evaluate(() => (window as unknown as ActivityWindow).cards)).toBe(1);
+        await page.locator('#switch').click();
+        await page.waitForFunction(() => (window as unknown as ActivityWindow).poolInfo().classroomId === 'lesson-two');
+        expect(await page.evaluate(() => (window as unknown as ActivityWindow).poolInfo().ids)).toEqual(['a']);
+        const second = await (await page.locator('iframe[title="Interactive Scene a"]').elementHandle())!.contentFrame();
+        await second!.waitForFunction(() => (window as unknown as ActivityWindow).cards === 0);
+        expect(await second!.evaluate(() => (window as unknown as ActivityWindow).documentToken)).not.toBe(token);
+        const secondToken = await second!.evaluate(() => (window as unknown as ActivityWindow).documentToken);
+        await page.locator('#replace').click();
+        await second!.waitForFunction(() => (window as unknown as ActivityWindow).cards === 40);
+        expect(await second!.evaluate(() => (window as unknown as ActivityWindow).documentToken)).not.toBe(secondToken);
+        await page.locator('#leave').click();
+        await page.waitForFunction(() => document.querySelectorAll('iframe').length === 0);
+        expect(await page.evaluate(() => (window as unknown as ActivityWindow).poolInfo()))
+          .toEqual({ ids: [], retained: [], classroomId: null, active: null });
+      } finally { await browser.close(); }
+    }, 30000);
+  },
+);
