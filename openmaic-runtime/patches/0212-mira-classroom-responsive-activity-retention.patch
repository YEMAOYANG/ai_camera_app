diff --git a/tests/store/interactive-iframe-pool.test.ts b/tests/store/interactive-iframe-pool.test.ts
--- a/tests/store/interactive-iframe-pool.test.ts
+++ b/tests/store/interactive-iframe-pool.test.ts
@@ -137,3 +137,62 @@
     expect(pool().activeSceneId).toBeNull();
   });
 });
+
+describe('current-classroom responsive activity retention', () => {
+  const responsive = ['a', 'b', 'c', 'd', 'e'];
+
+  test('late initial classroom identity preserves an already mounted first activity', () => {
+    pool().mount('a', { srcDoc: '<p>work</p>' });
+    pool().claim('a', 'owner');
+    pool().setActive('a');
+    const first = pool().entries.a;
+    pool().configureClassroom('lesson-one', responsive);
+    expect(pool().entries.a).toBe(first);
+    expect(pool().activeSceneId).toBe('a');
+    expect(pool().classroomGeneration).toBe(0);
+  });
+
+  test('retains five lesson activities while ordinary activities still obey LRU three', () => {
+    pool().configureClassroom('lesson-one', responsive);
+    for (const id of responsive) pool().mount(id, { srcDoc: id });
+    for (let i = 0; i < 5; i++) pool().mount(`ordinary-${i}`, { srcDoc: `ordinary-${i}` });
+    expect(responsive.every((id) => !!pool().entries[id])).toBe(true);
+    expect(Object.keys(pool().entries).filter((id) => !responsive.includes(id)))
+      .toEqual(['ordinary-2', 'ordinary-3', 'ordinary-4']);
+    pool().mount('a', { srcDoc: 'a' });
+    expect(Object.keys(pool().entries)).toHaveLength(8);
+  });
+
+  test('removed retention returns to the existing LRU bound', () => {
+    pool().configureClassroom('lesson-one', responsive);
+    for (const id of responsive) pool().mount(id, { srcDoc: id });
+    pool().configureClassroom('lesson-one', []);
+    expect(Object.keys(pool().entries)).toEqual(['c', 'd', 'e']);
+  });
+
+  test('a different classroom clears work even when it reuses scene IDs', () => {
+    pool().configureClassroom('lesson-one', responsive);
+    pool().mount('a', { srcDoc: 'old' });
+    pool().setActive('a');
+    pool().configureClassroom('lesson-two', ['a']);
+    expect(pool().entries).toEqual({});
+    expect(pool().activeSceneId).toBeNull();
+    expect(pool().tick).toBe(0);
+    expect(pool().retainedSceneIds).toEqual(['a']);
+    expect(pool().classroomGeneration).toBe(1);
+    pool().mount('a', { srcDoc: 'new' });
+    expect(pool().entries.a.srcDoc).toBe('new');
+  });
+
+  test('content replacement and explicit eviction still apply to retained scenes', () => {
+    pool().configureClassroom('lesson-one', responsive);
+    pool().mount('a', { srcDoc: 'old' });
+    pool().mount('a', { srcDoc: 'new' });
+    expect(pool().entries.a.srcDoc).toBe('new');
+    pool().evict('a');
+    expect(pool().entries.a).toBeUndefined();
+    pool().reset();
+    expect(pool().classroomId).toBeNull();
+    expect(pool().retainedSceneIds).toEqual([]);
+  });
+});
