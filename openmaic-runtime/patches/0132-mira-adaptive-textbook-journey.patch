+.contextStage {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  min-height: 260px;
+  padding: 24px;
+  background: #e7eee1;
+  border-radius: 16px;
+  text-align: center;
+  gap: 24px;
+}
+.contextName { font-size: clamp(24px, 4cqw, 42px); font-weight: 700; }
+.wordConstellation { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 360px; }
+.wordConstellation span { display: grid; place-items: center; width: 80px; height: 80px; border-radius: 14px; background: #fbf7ed; font-size: 42px; color: #465d4d; transition: background .2s; }
+.wordConstellation span[data-lit='true'] { background: #28664d; color: white; }
+.zone[data-demonstrate='true'], .options button[data-demonstrate='true'] { outline: 4px solid #bf851c; outline-offset: -4px; background: #efcf7366; }
+.recordLine { display: block; margin-top: 8px; }
+.options button { min-height: 54px; padding: 12px; font-size: clamp(22px, 2.8cqw, 32px); }
+.primary { text-decoration: none; }
+@media (prefers-reduced-motion: reduce) { .wordConstellation span { transition: none; } }
