 .control:disabled {
   opacity: 0.4;
   cursor: default;
+}
+
+/* Utility actions share a fine-pointer scale without shrinking picture answers. */
+.activityControl {
+  box-sizing: border-box;
+  min-width: 48px;
+  min-height: 48px;
+  padding: 8px 12px;
+  gap: 6px;
+  border-radius: 8px;
+  font-size: 14px;
+  font-weight: 500;
+  line-height: 20px;
+}
+.activityControl > svg {
+  flex-shrink: 0;
+  width: 18px;
+  height: 18px;
+}
+.activityIconControl {
+  width: 48px;
+  height: 48px;
+  padding: 0;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .activityControl {
+    min-width: 36px;
+    min-height: 36px;
+    padding-block: 6px;
+  }
+  .activityPrimary {
+    min-height: 40px;
+    padding-inline: 14px;
+  }
+  .activityIconControl,
+  .control,
+  .controls.controls[data-question-narration-controls] > button {
+    flex-basis: 36px;
+    width: 36px;
+    min-width: 36px;
+    height: 36px;
+    min-height: 36px;
+  }
 }
 
