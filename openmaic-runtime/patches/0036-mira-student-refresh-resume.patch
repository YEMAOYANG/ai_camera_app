+export function getMiraStudentAudioStartStorageKey(classroomId: string): string {
+  return `${MIRA_STUDENT_AUDIO_START_STORAGE_PREFIX}:${encodeURIComponent(classroomId.trim())}`;
+}
+
+export function readMiraStudentAudioStartAccepted(
+  storage: MiraStudentAudioStartStorage,
+  classroomId: string,
+): boolean {
+  if (!classroomId.trim()) return false;
+  try {
+    return storage.getItem(getMiraStudentAudioStartStorageKey(classroomId)) === 'accepted';
+  } catch {
+    return false;
+  }
+}
+
+export function rememberMiraStudentAudioStartAccepted(
+  storage: MiraStudentAudioStartStorage,
+  classroomId: string,
+): void {
+  if (!classroomId.trim()) return;
+  try {
+    storage.setItem(getMiraStudentAudioStartStorageKey(classroomId), 'accepted');
+  } catch {
+    // A blocked sessionStorage must not prevent the explicit play gesture.
+  }
+}
