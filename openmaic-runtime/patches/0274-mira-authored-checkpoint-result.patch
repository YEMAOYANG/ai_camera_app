+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { patchActivityCheckpointAdapters } from '@/lib/mira/activity-checkpoint-adapters';
+
+it('never upgrades an unknown authored restore function', () => {
+  const html = '<script>window.miraActivityCheckpoint = {restore(){}}</script>';
+  expect(patchActivityCheckpointAdapters(html)).toBe(html);
+});
+
+// Reuse the reviewed local publication; do not duplicate paid course/media fixtures.
+describe.skipIf(!process.env.MIRA_SPLIT_CHECKPOINT_RELEASE)('reviewed split checkpoint return contract', () => {
+  const original = process.env.MIRA_SPLIT_CHECKPOINT_RELEASE
+    ? JSON.parse(readFileSync(process.env.MIRA_SPLIT_CHECKPOINT_RELEASE, 'utf8')).release.classroom.scenes.find((s: {id:string}) => s.id === 'scene-p2').content.html : '';
+  it('normalizes success and failure without altering the rest of the game', () => {
+    const patched = patchActivityCheckpointAdapters(original);
+    expect(patched).toBe(original.replace('render();updateStatusForPhase();maybeAutoAdvance();\n                    } catch (e) {}',
+      'render();updateStatusForPhase();maybeAutoAdvance();return true;\n                    } catch (e) { return false; }'));
+    expect(patched).not.toBe(original);
+    expect(patchActivityCheckpointAdapters(patched)).toBe(patched);
+  });
+  it('fails closed if any executable part of the reviewed model changes', () => {
+    const changed = original.replace('phase = snapshot.phase;', 'phase = 9;');
+    expect(patchActivityCheckpointAdapters(changed)).toBe(changed);
+  });
+  it('returns success only after rendering the restored world', () => {
+    const patched = patchActivityCheckpointAdapters(original);
+    const body = patched.slice(patched.indexOf('restore(snapshot) {') + 'restore(snapshot) {'.length).split('\n                }\n            };')[0];
+    const restore = new Function('snapshot', 'broken', `let phase,currentDirection,unsentBalls,leftDock,rightDock,ballIdCounter,helpShown,currentHelpBallId,hasPlayedCue2,hasStartedInitialCue;const allBalls=new Map();const getBallColor=()=> 'color';const render=()=>{if(broken)throw new Error('render failed')};const updateStatusForPhase=()=>{};const maybeAutoAdvance=()=>{};${body}`);
+    const snapshot = {phase:2,currentDirection:'left',unsentBalls:[],leftDock:['ball-3'],rightDock:['ball-1','ball-2']};
+    expect(restore(snapshot, false)).toBe(true);
+    expect(restore(snapshot, true)).toBe(false);
+    expect(restore({}, false)).toBe(false);
+  });
+});
