+++ b/tests/ai/formal-thinking-wire.test.ts
@@ -0,0 +1,199 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import type { ThinkingConfig } from '@/lib/types/provider';
+
+// Keep routing, model construction, generation callbacks and the AI SDK real.
+// Only credentials and the final HTTP transport are replaced; no local config
+// file or real Provider endpoint is read/called by these regressions.
+vi.mock('@/lib/server/provider-config', () => ({
+  isServerConfiguredProvider: () => true,
+  resolveApiKey: () => 'offline-fixture-key',
+  resolveBaseUrl: () => 'https://thinking-wire.invalid/v1',
+  resolveProxy: () => undefined,
+}));
+
+interface WireBody {
+  model: string;
+  thinking?: { type: string };
+  reasoning_effort?: string;
+  stream?: boolean;
+  messages: Array<{ content: string }>;
+}
+
+function responseFor(body: WireBody): Response {
+  const usage = { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 };
+  if (body.stream) {
+    const chunks = [
+      { choices: [{ index: 0, delta: { content: 'ok' }, finish_reason: null }] },
+      { choices: [{ index: 0, delta: {}, finish_reason: 'stop' }], usage },
+    ].map((chunk) => ({
+      id: 'offline',
+      object: 'chat.completion.chunk',
+      created: 1,
+      model: body.model,
+      ...chunk,
+    }));
+    return new Response(
+      `${chunks.map((chunk) => `data: ${JSON.stringify(chunk)}\n\n`).join('')}data: [DONE]\n\n`,
+      { headers: { 'content-type': 'text/event-stream' } },
+    );
+  }
+  return new Response(
+    JSON.stringify({
+      id: 'offline',
+      object: 'chat.completion',
+      created: 1,
+      model: body.model,
+      choices: [{ index: 0, message: { role: 'assistant', content: 'ok' }, finish_reason: 'stop' }],
+      usage,
+    }),
+    { headers: { 'content-type': 'application/json' } },
+  );
+}
+
+async function loadInstance() {
+  const llm = await import('@/lib/ai/llm');
+  const { thinkingContext } = await import('@/lib/ai/thinking-context');
+  const { resolveModel } = await import('@/lib/server/resolve-model');
+  const { createGenerationAiCallFactory } =
+    await import('@/lib/server/agent-runtime/generation-ai-call');
+  return { ...llm, thinkingContext, resolveModel, createGenerationAiCallFactory };
+}
+
+describe('formal thinking policy at the actual SDK HTTP boundary', () => {
+  beforeEach(() => {
+    vi.resetModules();
+    vi.stubEnv('MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY', 'deepseek-v4-pro-flash-v1');
+    vi.stubEnv('DEFAULT_MODEL', 'deepseek:deepseek-v4-pro');
+    vi.stubEnv('LLM_THINKING_DISABLED', '');
+    vi.stubEnv('OPENAI_COMPAT_USE_STREAMING_CHAT', 'false');
+    const disabled = { mode: 'disabled', enabled: false };
+    vi.stubEnv(
+      'MODEL_ROUTES',
+      JSON.stringify({
+        'maic-agent-driver': {
+          model: 'deepseek:deepseek-v4-pro',
+          thinking: { mode: 'enabled', enabled: true, effort: 'high' },
+        },
+        'generate-classroom': { model: 'deepseek:deepseek-v4-pro', thinking: disabled },
+        'mira-courseware-creator': { model: 'deepseek:deepseek-v4-pro', thinking: disabled },
+        'mira-courseware-verifier': { model: 'deepseek:deepseek-v4-flash', thinking: disabled },
+        'web-search-query-rewrite': { model: 'deepseek:deepseek-v4-pro', thinking: disabled },
+        // A caller/operator route cannot loosen the formal action contract.
+        'scene-actions': {
+          model: 'deepseek:deepseek-v4-flash',
+          thinking: { mode: 'enabled', enabled: true },
+        },
+      }),
+    );
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    vi.unstubAllEnvs();
+  });
+
+  it('keeps the original generation callback disabled after another module instance loads', async () => {
+    const bodies: WireBody[] = [];
+    vi.stubGlobal('fetch', async (input: RequestInfo | URL, init?: RequestInit) => {
+      expect(String(input)).toBe('https://thinking-wire.invalid/v1/chat/completions');
+      const body = JSON.parse(String(init?.body)) as WireBody;
+      bodies.push(body);
+      return responseFor(body);
+    });
+    const first = await loadInstance();
+    const generate = first.createGenerationAiCallFactory()('scene-content:slide');
+    expect(await generate('system', 'before second instance')).toBe('ok');
+    vi.resetModules();
+    const second = await loadInstance();
+    expect(await generate('system', 'after second instance')).toBe('ok');
+
+    expect(bodies.map((body) => body.thinking)).toEqual([
+      { type: 'disabled' },
+      { type: 'disabled' },
+    ]);
+    expect(second.thinkingContext).toBe(first.thinkingContext);
+    expect(first.thinkingContext.getStore()).toBeUndefined();
+  });
+
+  it('isolates overlapping driver, content, actions, creator, verifier and search requests across instances', async () => {
+    const first = await loadInstance();
+    vi.resetModules();
+    const second = await loadInstance();
+    const stages = [
+      'scene-content',
+      'scene-content:slide',
+      'scene-content:quiz',
+      'scene-content:interactive',
+      'scene-content:pbl',
+      'scene-actions',
+      'generate-classroom',
+      'mira-courseware-creator',
+      'mira-courseware-verifier',
+      'web-search-query-rewrite',
+    ] as const;
+    const captured: Array<{ body: WireBody; before?: ThinkingConfig; after?: ThinkingConfig }> = [];
+    let release!: () => void;
+    const allRequestsEntered = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    vi.stubGlobal('fetch', async (input: RequestInfo | URL, init?: RequestInit) => {
+      expect(String(input)).toBe('https://thinking-wire.invalid/v1/chat/completions');
+      const body = JSON.parse(String(init?.body)) as WireBody;
+      const item = {
+        body,
+        before: first.thinkingContext.getStore(),
+        after: undefined as ThinkingConfig | undefined,
+      };
+      captured.push(item);
+      if (captured.length === stages.length + 1) release();
+      // Hold every actual SDK request concurrently before any can finish.
+      await allRequestsEntered;
+      item.after = first.thinkingContext.getStore();
+      return responseFor(body);
+    });
+    const driver = await second.resolveModel({ stage: 'maic-agent-driver' });
+    const stream = first.streamLLM(
+      { model: driver.model, prompt: 'maic-agent-driver', maxRetries: 0 },
+      'maic-agent-driver',
+      driver.thinkingConfig,
+    );
+    const results = await Promise.all([
+      ...stages.map((stage, index) =>
+        (index % 2 ? first : second).createGenerationAiCallFactory()(stage)('system', stage),
+      ),
+      stream.text,
+    ]);
+    expect(results).toEqual(Array.from({ length: stages.length + 1 }, () => 'ok'));
+    expect(captured).toHaveLength(stages.length + 1);
+    for (const { body, before, after } of captured) {
+      const stage = body.messages.at(-1)?.content;
+      const driverRequest = stage === 'maic-agent-driver';
+      expect(body.model).toBe(
+        stage === 'mira-courseware-verifier' ? 'deepseek-v4-flash' : 'deepseek-v4-pro',
+      );
+      expect(body.thinking).toEqual({ type: driverRequest ? 'enabled' : 'disabled' });
+      expect(body.reasoning_effort).toBe(driverRequest ? 'high' : undefined);
+      expect(before?.mode).toBe(driverRequest ? 'enabled' : 'disabled');
+      expect(after).toEqual(before);
+    }
+    expect(first.thinkingContext.getStore()).toBeUndefined();
+    expect(second.thinkingContext.getStore()).toBeUndefined();
+  });
+
+  it('does not leak a completed request policy into a later unconfigured call', async () => {
+    const bodies: WireBody[] = [];
+    vi.stubGlobal('fetch', async (input: RequestInfo | URL, init?: RequestInit) => {
+      expect(String(input)).toBe('https://thinking-wire.invalid/v1/chat/completions');
+      const body = JSON.parse(String(init?.body)) as WireBody;
+      bodies.push(body);
+      return responseFor(body);
+    });
+    const instance = await loadInstance();
+    await instance.createGenerationAiCallFactory()('scene-content:slide')('system', 'formal');
+    const plain = await instance.resolveModel({ stage: 'chat-adapter' });
+    await instance.callLLM({ model: plain.model, prompt: 'plain', maxRetries: 0 }, 'plain');
+    expect(bodies[0].thinking).toEqual({ type: 'disabled' });
+    expect(bodies[1]).not.toHaveProperty('thinking');
+  });
+});
