diff --git a/packages/@openmaic/generation/src/slide-element-inventory.ts b/packages/@openmaic/generation/src/slide-element-inventory.ts
new file mode 100644
--- /dev/null
+++ b/packages/@openmaic/generation/src/slide-element-inventory.ts
@@ -0,0 +1,167 @@
+import type { PPTElement } from '@openmaic/dsl';
+
+const MAX_TEXT = 160;
+const MAX_RELATED_IDS = 12;
+const MAX_APPEARANCES = 8;
+const MAX_SPATIAL_ELEMENTS = 256;
+
+type Bounds = { left: number; top: number; width: number; height: number };
+
+function excerpt(value: string, maximum = MAX_TEXT): string {
+  const text = value
+    .replace(/<(script|style)\b[^>]*>[\s\S]*?<\/\1\s*>/gi, '')
+    .replace(/<[^>]*>/g, '')
+    .replace(/\s+/g, ' ')
+    .trim();
+  return text.length > maximum ? `${text.slice(0, maximum)}…` : text;
+}
+
+function bounds(element: PPTElement): Bounds | undefined {
+  if (!('height' in element)) return undefined;
+  const { left, top, width, height } = element;
+  if (![left, top, width, height].every(Number.isFinite) || width <= 0 || height <= 0)
+    return undefined;
+  return { left, top, width, height };
+}
+
+function unrotated(element: PPTElement): boolean {
+  return 'rotate' in element && element.rotate === 0;
+}
+
+function relatedIds(elements: readonly PPTElement[]) {
+  return {
+    count: elements.length,
+    ids: elements.slice(0, MAX_RELATED_IDS).map((element) => element.id),
+    ...(elements.length > MAX_RELATED_IDS ? { idsTruncated: true } : {}),
+  };
+}
+
+function appearance(element: PPTElement): Record<string, unknown> {
+  const box = bounds(element);
+  return {
+    type: element.type,
+    ...(box ? { width: box.width, height: box.height } : {}),
+    ...(element.type === 'text' ? { text: excerpt(element.content, 80) } : {}),
+    ...(element.type === 'shape'
+      ? {
+          fillMode: element.pattern ? 'pattern' : element.gradient ? 'gradient' : 'solid',
+          ...(element.pattern
+            ? {
+                patternSource: element.pattern.startsWith('data:')
+                  ? '(inline pattern omitted)'
+                  : excerpt(element.pattern, 96),
+              }
+            : element.gradient
+              ? {
+                  gradient: {
+                    type: element.gradient.type,
+                    rotation: element.gradient.rotate,
+                    colorStopCount: element.gradient.colors.length,
+                    colors: element.gradient.colors
+                      .slice(0, 4)
+                      .map((stop) => ({ position: stop.pos, color: excerpt(stop.color, 80) })),
+                    ...(element.gradient.colors.length > 4 ? { colorsTruncated: true } : {}),
+                  },
+                }
+              : { fill: excerpt(element.fill || 'none', 80) }),
+          ...(typeof element.opacity === 'number' && Number.isFinite(element.opacity)
+            ? { opacity: element.opacity }
+            : {}),
+          path: excerpt(element.path, 96),
+        }
+      : {}),
+  };
+}
+
+function containedAppearance(elements: readonly PPTElement[]) {
+  const counts = new Map<string, { appearance: Record<string, unknown>; count: number }>();
+  for (const element of elements) {
+    const value = appearance(element);
+    // Bounded gradient/pattern summaries are not full visual identities. Keep
+    // them separate even if their abbreviated descriptions happen to match.
+    const key = JSON.stringify([
+      value,
+      element.type === 'shape' && (element.pattern || element.gradient) ? element.id : null,
+    ]);
+    const existing = counts.get(key);
+    if (existing) existing.count += 1;
+    else counts.set(key, { appearance: value, count: 1 });
+  }
+  const rows = [...counts.values()];
+  return {
+    ...relatedIds(elements),
+    appearances: rows.slice(0, MAX_APPEARANCES),
+    ...(rows.length > MAX_APPEARANCES ? { appearancesTruncated: true } : {}),
+  };
+}
+
+/** Describe actual canvas evidence without inventing semantic groups or target IDs. */
+export function formatSlideElementsForPrompt(elements: readonly PPTElement[]): string {
+  const groups = new Map<string, PPTElement[]>();
+  for (const element of elements) {
+    if (element.groupId) {
+      const members = groups.get(element.groupId) ?? [];
+      members.push(element);
+      groups.set(element.groupId, members);
+    }
+  }
+  const inventory = elements.map((element, index) => {
+    const box = bounds(element);
+    const details: Record<string, unknown> = {
+      ...(box ? { bounds: box } : {}),
+      ...('rotate' in element && Number.isFinite(element.rotate)
+        ? { rotation: element.rotate }
+        : {}),
+      ...(element.name ? { name: excerpt(element.name, 80) } : {}),
+    };
+    if (element.type === 'text') details.text = excerpt(element.content);
+    if (element.type === 'shape') {
+      details.appearance = appearance(element);
+      details.viewBox = element.viewBox;
+      if (typeof element.opacity === 'number' && Number.isFinite(element.opacity))
+        details.opacity = element.opacity;
+      if (element.text?.content) details.text = excerpt(element.text.content);
+    } else if (element.type === 'chart') details.chartType = element.chartType;
+    else if (element.type === 'latex') details.formula = excerpt(element.latex);
+
+    if (element.groupId) {
+      details.explicitGroup = {
+        label: excerpt(element.groupId, 80),
+        ...relatedIds(groups.get(element.groupId)!),
+      };
+    }
+
+    // Canvas order is paint order. A region can describe later, smaller bounds
+    // inside it, but geometry alone cannot establish a pedagogical grouping.
+    // Exclude rotation: the stored unrotated box would give false containment.
+    if (
+      elements.length <= MAX_SPATIAL_ELEMENTS &&
+      element.type === 'shape' &&
+      box &&
+      unrotated(element)
+    ) {
+      const inside = elements.slice(index + 1).filter((candidate) => {
+        const child = bounds(candidate);
+        return (
+          child &&
+          unrotated(candidate) &&
+          (child.width < box.width || child.height < box.height) &&
+          child.left >= box.left &&
+          child.top >= box.top &&
+          child.left + child.width <= box.left + box.width &&
+          child.top + child.height <= box.top + box.height
+        );
+      });
+      if (inside.length) details.laterElementsWithinBounds = containedAppearance(inside);
+    }
+    return `- id: ${JSON.stringify(element.id)}, type: ${JSON.stringify(element.type)}, details: ${JSON.stringify(details)}`;
+  });
+  return [
+    'Use only the listed element IDs as action targets; IDs do not describe meaning. Bounds use canvas coordinates.',
+    'Explicit group labels are not target IDs. Bounds containment is spatial evidence only, not proof of a semantic group. Match the highlighted region to the narration; one small member does not highlight its whole group.',
+    ...(elements.length > MAX_SPATIAL_ELEMENTS
+      ? ['Spatial containment omitted for this large canvas; per-element bounds remain available.']
+      : []),
+    ...inventory,
+  ].join('\n');
+}
