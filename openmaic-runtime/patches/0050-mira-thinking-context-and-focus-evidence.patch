--- /dev/null
+++ b/packages/@openmaic/generation/test/slide-element-inventory.test.ts
@@ -0,0 +1,268 @@
+import { readFileSync } from 'node:fs';
+import { describe, expect, it, vi } from 'vitest';
+import type { PPTElement, PPTShapeElement } from '@openmaic/dsl';
+import {
+  buildCompleteScene,
+  generateSceneActions,
+  generateSceneContent,
+  type AICallFn,
+  type SceneOutline,
+} from '@openmaic/generation';
+import { formatSlideElementsForPrompt } from '../src/slide-element-inventory.js';
+
+const fixture = JSON.parse(
+  readFileSync(new URL('./fixtures/primary-one-dots-slide-elements.json', import.meta.url), 'utf8'),
+) as { elements: PPTElement[] };
+const outline: SceneOutline = {
+  id: 'p1',
+  order: 1,
+  type: 'slide',
+  title: '圆点小侦探：先猜一猜，再数一数',
+  description: '先指向一排10个蓝点，再指向旁边3个黄色散点。',
+  keyPoints: [],
+};
+const bluePanelId = 'shape_SnYbul8Z';
+const yellowPanelId = 'shape_gVEgJCYl';
+const yellowDotId = 'shape_g8DpN7mU';
+
+type InventoryDetails = {
+  bounds: Record<string, number>;
+  appearance: { fill: string };
+  text?: string;
+  laterElementsWithinBounds?: { count: number; ids: string[] };
+};
+
+function inventoryLine(prompt: string, id: string) {
+  const line = prompt.split('\n').find((row) => row.startsWith(`- id: ${JSON.stringify(id)},`));
+  if (!line) throw new Error(`missing inventory ${id}`);
+  return JSON.parse(line.split(', details: ')[1]!) as InventoryDetails;
+}
+
+async function captureInventory(
+  elements = structuredClone(fixture.elements),
+  target = bluePanelId,
+) {
+  let userPrompt = '';
+  const aiCall: AICallFn = vi.fn(async (_system, user) => {
+    userPrompt = user;
+    return JSON.stringify([
+      { type: 'action', name: 'spotlight', params: { elementId: target } },
+      { type: 'text', content: '这一排整整齐齐，等一下我们会把它看成一个十。' },
+    ]);
+  });
+  const actions = await generateSceneActions(outline, { elements }, aiCall);
+  expect(aiCall).toHaveBeenCalledTimes(1);
+  return { prompt: userPrompt, actions };
+}
+
+describe('slide action inventory grounded in actual elements', () => {
+  it('distinguishes the real ten-blue-dot and three-yellow-dot regions in the actions AI prompt', async () => {
+    expect(fixture.elements).toHaveLength(21);
+    const { prompt } = await captureInventory();
+    const blue = inventoryLine(prompt, bluePanelId);
+    const yellow = inventoryLine(prompt, yellowPanelId);
+    expect(blue.bounds).toEqual({ left: 60, top: 230, width: 520, height: 96 });
+    expect(blue.laterElementsWithinBounds).toMatchObject({
+      count: 10,
+      appearances: [
+        {
+          appearance: { type: 'shape', fill: '#2563eb', width: 34, height: 34 },
+          count: 10,
+        },
+      ],
+    });
+    expect(yellow.bounds).toEqual({ left: 620, top: 230, width: 320, height: 96 });
+    expect(yellow.laterElementsWithinBounds).toMatchObject({
+      count: 3,
+      appearances: [
+        {
+          appearance: { type: 'shape', fill: '#d97706', width: 32, height: 32 },
+          count: 3,
+        },
+      ],
+    });
+    const dot = inventoryLine(prompt, yellowDotId);
+    expect(dot.bounds).toEqual({ left: 758, top: 238, width: 32, height: 32 });
+    expect(dot.appearance.fill).toBe('#d97706');
+    expect(dot.laterElementsWithinBounds).toBeUndefined();
+    const instructionPanel = inventoryLine(prompt, 'shape_VRR5AkAM');
+    expect(instructionPanel.laterElementsWithinBounds).toMatchObject({
+      count: 1,
+      ids: ['text_jvfSO9IA'],
+      appearances: [
+        { appearance: { type: 'text', text: '先猜一个数，再说说你打算怎么数。' }, count: 1 },
+      ],
+    });
+    expect(prompt).toContain('not proof of a semantic group');
+    expect(prompt).toContain('one small member does not highlight its whole group');
+  });
+
+  it('leaves all original IDs and geometry intact, and preserves an existing action target through assembly', async () => {
+    const elements = structuredClone(fixture.elements);
+    const before = structuredClone(elements);
+    const { prompt, actions } = await captureInventory(elements);
+    for (const element of elements)
+      expect(prompt).toContain(`- id: ${JSON.stringify(element.id)},`);
+    expect(elements).toEqual(before);
+    expect(actions[0]).toMatchObject({ type: 'spotlight', elementId: bluePanelId });
+    const scene = buildCompleteScene(outline, { elements }, actions, 'stage-test');
+    expect(scene?.actions).toBe(actions);
+    expect(scene?.content).toMatchObject({ canvas: { elements: before } });
+  });
+
+  it('does not reinterpret a valid single-dot ID or change the existing invalid-ID fallback', async () => {
+    const single = await captureInventory(undefined, yellowDotId);
+    expect(single.actions[0]).toMatchObject({ elementId: yellowDotId });
+    const invalid = await captureInventory(undefined, 'dots-row-not-an-existing-id');
+    expect(invalid.actions[0]).toMatchObject({ elementId: fixture.elements[0]!.id });
+    expect(invalid.actions[0]).not.toMatchObject({ elementId: yellowDotId });
+  });
+
+  it('uses post-normalization IDs consistently from content generation to action generation', async () => {
+    const content = await generateSceneContent(outline, async () =>
+      JSON.stringify({ elements: fixture.elements }),
+    );
+    if (!content || !('elements' in content)) throw new Error('expected slide');
+    const panel = content.elements.find(
+      (element) => element.left === 60 && element.top === 230 && element.width === 520,
+    )!;
+    expect(panel.id).not.toBe(bluePanelId);
+    const { prompt, actions } = await captureInventory(content.elements, panel.id);
+    expect(prompt).not.toContain(`- id: ${JSON.stringify(bluePanelId)},`);
+    expect(inventoryLine(prompt, panel.id).laterElementsWithinBounds?.count).toBe(10);
+    const scene = buildCompleteScene(outline, content, actions, 'stage-test');
+    expect(scene?.actions?.[0]).toMatchObject({ elementId: panel.id });
+  });
+
+  it('reports explicit groups and actual shape text without inventing a focusable group ID', async () => {
+    const elements = structuredClone(fixture.elements);
+    const panel = elements.find((element) => element.id === yellowPanelId) as PPTShapeElement;
+    const dot = elements.find((element) => element.id === yellowDotId)!;
+    panel.groupId = dot.groupId = 'loose-ones';
+    panel.name = 'Three loose objects';
+    panel.text = {
+      content: '<p>三个一</p>',
+      defaultFontName: 'Arial',
+      defaultColor: '#000000',
+      align: 'middle',
+    };
+    const { prompt } = await captureInventory(elements);
+    const row = inventoryLine(prompt, yellowPanelId);
+    expect(row).toMatchObject({
+      name: 'Three loose objects',
+      text: '三个一',
+      explicitGroup: { label: 'loose-ones', count: 2, ids: [yellowPanelId, yellowDotId] },
+    });
+    expect(prompt).toContain('Explicit group labels are not target IDs');
+    expect(prompt).not.toContain('- id: "loose-ones"');
+  });
+
+  it('does not assert bounds containment for rotated shapes, preceding elements, or equal boxes', () => {
+    const panel = structuredClone(
+      fixture.elements.find((element) => element.id === bluePanelId)!,
+    ) as PPTShapeElement;
+    const dot = structuredClone(
+      fixture.elements.find((element) => element.id === yellowDotId)!,
+    ) as PPTShapeElement;
+    dot.left = 100;
+    dot.top = 250;
+    expect(
+      inventoryLine(formatSlideElementsForPrompt([dot, panel]), panel.id).laterElementsWithinBounds,
+    ).toBeUndefined();
+    expect(
+      inventoryLine(formatSlideElementsForPrompt([panel, { ...dot, rotate: 45 }]), panel.id)
+        .laterElementsWithinBounds,
+    ).toBeUndefined();
+    expect(
+      inventoryLine(formatSlideElementsForPrompt([{ ...panel, rotate: 45 }, dot]), panel.id)
+        .laterElementsWithinBounds,
+    ).toBeUndefined();
+    expect(
+      inventoryLine(formatSlideElementsForPrompt([panel, { ...panel, id: 'same-box' }]), panel.id)
+        .laterElementsWithinBounds,
+    ).toBeUndefined();
+  });
+
+  it('bounds text and relation descriptions while retaining the full related count and every element ID', () => {
+    const panel = structuredClone(
+      fixture.elements.find((element) => element.id === bluePanelId)!,
+    ) as PPTShapeElement;
+    panel.text = {
+      content: '<style>UNREADABLE</style><script>HIDDEN</script><p>' + '点'.repeat(1000) + '</p>',
+      defaultFontName: 'Arial',
+      defaultColor: '#000000',
+      align: 'middle',
+    };
+    const dot = fixture.elements.find((element) => element.id === yellowDotId)!;
+    const children = Array.from({ length: 20 }, (_, index) => ({
+      ...dot,
+      id: `dot-${index}`,
+      left: 80 + index,
+      top: 250,
+    }));
+    const prompt = formatSlideElementsForPrompt([panel, ...children]);
+    const row = inventoryLine(prompt, panel.id);
+    expect(row.text).toHaveLength(161);
+    expect(row.laterElementsWithinBounds).toMatchObject({ count: 20, idsTruncated: true });
+    expect(row.laterElementsWithinBounds?.ids).toHaveLength(12);
+    expect(prompt).not.toContain('UNREADABLE');
+    expect(prompt).not.toContain('HIDDEN');
+    for (const child of children) expect(prompt).toContain(`- id: "${child.id}"`);
+  });
+
+  it('limits quadratic spatial analysis on large canvases without losing target IDs or bounds', () => {
+    const dot = fixture.elements.find((element) => element.id === yellowDotId)!;
+    const elements = Array.from({ length: 257 }, (_, index) => ({ ...dot, id: `large-${index}` }));
+    const prompt = formatSlideElementsForPrompt(elements);
+    expect(prompt).toContain('Spatial containment omitted for this large canvas');
+    expect(inventoryLine(prompt, 'large-256').bounds).toEqual({
+      left: 758,
+      top: 238,
+      width: 32,
+      height: 32,
+    });
+    expect(prompt).not.toContain('laterElementsWithinBounds');
+  });
+
+  it('describes effective gradient/pattern paint without claiming the unused solid fill or merging abbreviated styles', () => {
+    const panel = structuredClone(
+      fixture.elements.find((element) => element.id === bluePanelId)!,
+    ) as PPTShapeElement;
+    const dot = structuredClone(
+      fixture.elements.find((element) => element.id === yellowDotId)!,
+    ) as PPTShapeElement;
+    const gradient = {
+      type: 'linear' as const,
+      rotate: 0,
+      colors: [
+        { pos: 0, color: '#ff0000' },
+        { pos: 100, color: '#00ff00' },
+      ],
+    };
+    const first = { ...dot, id: 'gradient-one', left: 100, top: 250, gradient };
+    const second = { ...first, id: 'gradient-two', left: 150 };
+    const pattern = { ...first, id: 'pattern', left: 200, pattern: '/example-pattern.png' };
+    const prompt = formatSlideElementsForPrompt([panel, first, second, pattern]);
+    expect(inventoryLine(prompt, first.id).appearance).toMatchObject({
+      fillMode: 'gradient',
+      gradient: {
+        colorStopCount: 2,
+        colors: [
+          { position: 0, color: '#ff0000' },
+          { position: 100, color: '#00ff00' },
+        ],
+      },
+    });
+    expect(inventoryLine(prompt, first.id).appearance).not.toHaveProperty('fill');
+    expect(inventoryLine(prompt, pattern.id).appearance).toMatchObject({
+      fillMode: 'pattern',
+      patternSource: '/example-pattern.png',
+    });
+    expect(inventoryLine(prompt, pattern.id).appearance).not.toHaveProperty('fill');
+    expect(inventoryLine(prompt, pattern.id).appearance).not.toHaveProperty('gradient');
+    expect(inventoryLine(prompt, panel.id).laterElementsWithinBounds).toMatchObject({
+      count: 3,
+      appearances: [{ count: 1 }, { count: 1 }, { count: 1 }],
+    });
+  });
+});
diff --git a/tests/ai/formal-thinking-wire.test.ts b/tests/ai/formal-thinking-wire.test.ts
