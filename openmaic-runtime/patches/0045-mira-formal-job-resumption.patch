+/** A restart may reattach completion, but may never claim a second dispatch. */
+export async function readResumableFormalClassroomGenerationJob(
+  jobId: string,
+): Promise<ClassroomGenerationJob | null> {
+  const job = await readStoredClassroomGenerationJob(jobId);
+  if (
+    !job || job.status !== 'running' || !job.runtimeRequestId || !job.formalInput ||
+    job.id !== formalJobId(job.runtimeRequestId) ||
+    job.formalContractVersion !== MIRA_FORMAL_RUNTIME_CONTRACT_VERSION ||
+    job.formalInput.runtimeRequestId !== job.runtimeRequestId ||
+    sha256(JSON.stringify(canonical(job.formalInput))) !== job.formalInputSha256
+  ) return null;
+  assertMiraFormalGenerationInput(job.formalInput);
+  try {
+    const marker = JSON.parse(await fs.readFile(formalDispatchMarkerPath(jobId), 'utf-8'));
+    if (
+      marker.schemaVersion !== 'mira.openmaic.formal-dispatch-start.v1' ||
+      marker.jobId !== job.id || marker.runtimeRequestId !== job.runtimeRequestId ||
+      marker.formalInputSha256 !== job.formalInputSha256
+    ) return null;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+  return job;
+}
