@@ -0,0 +1,53 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({
+  query: vi.fn(), release: vi.fn(), on: vi.fn(), removeListener: vi.fn(),
+  claim: vi.fn(), saved: vi.fn(), running: vi.fn(), succeeded: vi.fn(), failed: vi.fn(),
+  progress: vi.fn(), generate: vi.fn(), resume: vi.fn(),
+}));
+vi.mock('@/lib/persistence/server-provider', () => ({
+  getServerPersistenceProvider: async () => ({ pool: { connect: async () => mocks } }),
+}));
+vi.mock('@/lib/server/classroom-generation', () => ({ generateClassroom: mocks.generate }));
+vi.mock('@/lib/server/mira-formal-professional-classroom', () => ({ resumeMiraFormalProfessionalClassroom: mocks.resume }));
+vi.mock('@/lib/server/classroom-job-store', () => ({
+  claimFormalClassroomGenerationDispatch: mocks.claim,
+  readResumableFormalClassroomGenerationJob: mocks.saved,
+  markClassroomGenerationJobRunning: mocks.running,
+  markClassroomGenerationJobSucceeded: mocks.succeeded,
+  markClassroomGenerationJobFailed: mocks.failed,
+  updateClassroomGenerationJobProgress: mocks.progress,
+}));
+import { runClassroomGenerationJob } from '@/lib/server/classroom-job-runner';
+const input = { runtimeRequestId: 'mira-owner-resume', requirement: 'locked brief' };
+describe('formal completion owner', () => {
+  beforeEach(() => {
+    vi.resetAllMocks();
+    vi.stubEnv('DATABASE_URL', 'postgres://unused-test-connection');
+    mocks.query.mockResolvedValue({ rows: [{ acquired: true }] });
+    mocks.claim.mockResolvedValue(false);
+    mocks.saved.mockResolvedValue({ formalInput: input });
+    mocks.resume.mockResolvedValue({ classroomId: 'existing-stage' });
+  });
+  it('reattaches one completion to the original session across concurrent polls', async () => {
+    await Promise.all([runClassroomGenerationJob('same-job', input, 'http://local'), runClassroomGenerationJob('same-job', input, 'http://local')]);
+    expect(mocks.resume).toHaveBeenCalledTimes(1);
+    expect(mocks.generate).not.toHaveBeenCalled();
+    expect(mocks.succeeded).toHaveBeenCalledWith('same-job', { classroomId: 'existing-stage' });
+    expect(mocks.failed).not.toHaveBeenCalled();
+  });
+  it('does no work if another process owns completion', async () => {
+    mocks.query.mockResolvedValue({ rows: [{ acquired: false }] });
+    await runClassroomGenerationJob('busy-job', input, 'http://local');
+    expect(mocks.claim).not.toHaveBeenCalled();
+    expect(mocks.resume).not.toHaveBeenCalled();
+    expect(mocks.running).not.toHaveBeenCalled();
+  });
+  it('preserves a job whose durable authority cannot be verified', async () => {
+    mocks.saved.mockResolvedValue(null);
+    await runClassroomGenerationJob('unverified-job', input, 'http://local');
+    expect(mocks.generate).not.toHaveBeenCalled();
+    expect(mocks.resume).not.toHaveBeenCalled();
+    expect(mocks.failed).not.toHaveBeenCalled();
+    expect(mocks.running).not.toHaveBeenCalled();
+  });
+});
