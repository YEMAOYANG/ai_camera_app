+++ b/tests/server/mira-formal-job-resumption.test.ts
@@ -0,0 +1,58 @@
+import { promises as fs } from 'fs';
+import os from 'os';
+import path from 'path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+describe('formal job restart authority', () => {
+  let cwd: string;
+  let root: string;
+  beforeEach(async () => {
+    cwd = process.cwd();
+    root = await fs.mkdtemp(path.join(os.tmpdir(), 'mira-job-resume-'));
+    process.chdir(root);
+    vi.resetModules();
+  });
+  afterEach(async () => {
+    process.chdir(cwd);
+    await fs.rm(root, { recursive: true, force: true });
+  });
+  async function fixture() {
+    const policy = await import('@/lib/server/mira-formal-generation-policy');
+    const store = await import('@/lib/server/classroom-job-store');
+    const input = {
+      requirement: 'locked formal brief', runtimeRequestId: 'mira-restart-authority-1',
+      formalRuntimeContract: policy.MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT,
+      coursewareAuthority: policy.MIRA_COURSEWARE_AUTHORITY,
+      professionalCreationPolicy: policy.MIRA_PROFESSIONAL_CREATION_POLICY,
+      enableWebSearch: true, enableImageGeneration: false, enableVideoGeneration: false,
+      enableTTS: false, agentMode: 'generate' as const,
+    };
+    const { job } = await store.createOrGetFormalClassroomGenerationJob(input);
+    return { store, input, job };
+  }
+  it('reattaches only the original running dispatch and never claims it twice', async () => {
+    const { store, job } = await fixture();
+    expect(await store.readResumableFormalClassroomGenerationJob(job.id)).toBeNull();
+    expect(await store.claimFormalClassroomGenerationDispatch(job.id)).toBe(true);
+    await store.markClassroomGenerationJobRunning(job.id);
+    expect(await store.readResumableFormalClassroomGenerationJob(job.id)).toMatchObject({ id: job.id, status: 'running' });
+    expect(await store.claimFormalClassroomGenerationDispatch(job.id)).toBe(false);
+  });
+  it('rejects missing or altered durable dispatch authority', async () => {
+    const { store, job } = await fixture();
+    await store.markClassroomGenerationJobRunning(job.id);
+    expect(await store.readResumableFormalClassroomGenerationJob(job.id)).toBeNull();
+    const marker = path.join(root, 'data/classroom-jobs', `${job.id}.formal-dispatch-started.json`);
+    await fs.writeFile(marker, JSON.stringify({ schemaVersion: 'mira.openmaic.formal-dispatch-start.v1', jobId: job.id, runtimeRequestId: job.runtimeRequestId, formalInputSha256: 'wrong' }));
+    expect(await store.readResumableFormalClassroomGenerationJob(job.id)).toBeNull();
+  });
+  it('rejects changed input and terminal jobs', async () => {
+    const { store, job, input } = await fixture();
+    await store.claimFormalClassroomGenerationDispatch(job.id);
+    await store.markClassroomGenerationJobRunning(job.id);
+    await store.updateClassroomGenerationJob(job.id, { formalInput: { ...input, requirement: 'changed' } });
+    expect(await store.readResumableFormalClassroomGenerationJob(job.id)).toBeNull();
+    await store.updateClassroomGenerationJob(job.id, { formalInput: input, status: 'succeeded' });
+    expect(await store.readResumableFormalClassroomGenerationJob(job.id)).toBeNull();
+  });
+});
