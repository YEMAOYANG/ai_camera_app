+// A PostgreSQL session lock survives HTTP requests and is released by the
+// server on process exit. It also excludes duplicate owners across bundles
+// and processes without creating another Agent, job, or dispatch receipt.
+async function withFormalJobOwner(
+  jobId: string,
+  body: (assertOwner: () => Promise<void>) => Promise<void>,
+): Promise<void> {
+  const connectionString = process.env.DATABASE_URL?.trim();
+  if (!connectionString) throw new Error('FORMAL_PROFESSIONAL_AGENT_RUNTIME_NOT_CONFIGURED');
+  const { pool } = await getServerPersistenceProvider(connectionString);
+  const client = await pool.connect();
+  const key = `mira.formal-classroom-completion:${jobId}`;
+  let locked = false;
+  let lost = false;
+  const onError = () => { lost = true; };
+  client.on('error', onError);
+  const assertOwner = async () => {
+    if (!lost) {
+      try { await client.query('SELECT 1'); } catch { lost = true; }
+    }
+    if (lost) throw new Error('FORMAL_CLASSROOM_OWNER_LOST');
+  };
+  try {
+    const result = await client.query<{ acquired: boolean }>(
+      'SELECT pg_try_advisory_lock(hashtextextended($1, 0)) AS acquired', [key],
+    );
+    locked = result.rows[0]?.acquired === true;
+    if (locked) await body(assertOwner);
+  } finally {
+    if (locked) {
+      await client.query('SELECT pg_advisory_unlock(hashtextextended($1, 0))', [key])
+        .catch(() => {});
+    }
+    client.removeListener('error', onError);
+    client.release(lost);
+  }
+}
 
