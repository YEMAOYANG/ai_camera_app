+describe('ordinary embedded student game layout', () => {
+  const marker = '[data-mira-compact-student-game]';
+  const chrome = readFileSync('components/edit/PlaybackChromeRoot.tsx', 'utf8');
+  const css = postcss.parse(readFileSync('app/mira-student-orbit.css', 'utf8'));
+  const rules: Rule[] = [];
+  css.walkRules(rule => {
+    if (rule.selectors.some(selector => selector.includes(marker))) rules.push(rule);
+  });
+
+  it('enables compact chrome only for a certified student game outside presentation', () => {
+    expect(chrome).toMatch(
+      /data-mira-compact-student-game=\{\s*!isPresenting && studentActivityControlsKey\(studentMode, stage, currentScene\) \? '' : undefined\s*\}/,
+    );
+    expect(studentActivityControlsKey(true, stage, gameFor('shutterScout'))).toBeDefined();
+    expect(studentActivityControlsKey(false, stage, game)).toBeUndefined();
+    expect(studentActivityControlsKey(true, stage, { ...game, miraStudentActivityControls: undefined })).toBeUndefined();
+    for (const type of ['slide', 'quiz'] as const) {
+      expect(studentActivityControlsKey(true, stage, { ...game, type } as Scene)).toBeUndefined();
+    }
+  });
+
+  it('limits the new rules to short landscape outside fullscreen and preserves the quiz selectors', () => {
+    expect(rules).not.toHaveLength(0);
+    for (const rule of rules) {
+      expect(rule.parent).toMatchObject({ type: 'atrule', name: 'media' });
+      expect((rule.parent as AtRule).params).toMatch(
+        /^\(max-width: (640|520)px\) and \(max-height: 380px\) and \(orientation: landscape\)$/,
+      );
+      for (const selector of rule.selectors.filter(selector => selector.includes(marker))) {
+        expect(selector).toContain('[data-mira-classroom-root]:not(:fullscreen) ' + marker);
+      }
+      expect(rule.selectors.some(selector => selector.includes('[data-mira-student-quiz]'))).toBe(true);
+    }
+  });
+
+  it('fits the original 48px controls in the 640×360 Student Web frame', () => {
+    const discussion = rules.find(rule =>
+      rule.selectors.some(selector => selector.includes(marker + " [data-mira-chrome='discussion']")));
+    const height = discussion?.nodes.find(node => node.type === 'decl' && node.prop === 'height');
+    expect(height).toMatchObject({ type: 'decl', value: '105px' });
+
+    const frameHeight = 360 - 60; // Student Web's pinned schoolbag header.
+    const slotWithDiscussion = (discussionHeight: number) => ({
+      left: 8, top: 56, width: 623, height: frameHeight - 48 - discussionHeight - 16,
+    });
+    const oldSlot = slotWithDiscussion(153);
+    expect(planStudentActivityControls(oldSlot, oldSlot)).toBeNull();
+
+    const slot = slotWithDiscussion(105);
+    const plan = planStudentActivityControls(slot, slot)!;
+    expect(plan).not.toBeNull();
+    const target = CLASSROOM_TOUCH_CONTROL_SIZE;
+    expect(target).toBe(48);
+    expect(plan.buttons).toHaveLength(7);
+    for (const button of plan.buttons) {
+      expect(button.left).toBeGreaterThanOrEqual(0);
+      expect(button.top).toBeGreaterThanOrEqual(0);
+      expect(button.left + target).toBeLessThanOrEqual(slot.width);
+      expect(button.top + target).toBeLessThanOrEqual(slot.height);
+      expect(button.left + target <= plan.canvas.left
+        || button.left >= plan.canvas.left + plan.canvas.width).toBe(true);
+    }
+  });
+});
