@@ -5,15 +5,59 @@ import {
   useCallback,
   useContext,
   useLayoutEffect,
+  useMemo,
+  useRef,
   useState,
+  type MutableRefObject,
   type ReactNode,
 } from 'react';
 import { useI18n } from '@/lib/hooks/use-i18n';
 import { useTheme } from '@/lib/hooks/use-theme';
 import { supportedLocales, type Locale } from '@/lib/i18n';
+import { MIRA_STUDENT_AUTO_PLAY_DEFAULT } from '@/lib/mira/student-runtime';
 
 const MiraStudentRuntimeContext = createContext(false);
 
+export interface MiraStudentAutoPlayRuntime {
+  readonly autoPlayLecture: boolean;
+  readonly autoPlayLectureRef: MutableRefObject<boolean>;
+  readonly setAutoPlayLecture: (enabled: boolean) => void;
+}
+
+const MiraStudentAutoPlayRuntimeContext = createContext<MiraStudentAutoPlayRuntime | null>(null);
+
+function MiraStudentAutoPlaySession({
+  studentMode,
+  children,
+}: {
+  readonly studentMode: boolean;
+  readonly children: ReactNode;
+}) {
+  const [autoPlayLecture, setAutoPlayLectureState] = useState(MIRA_STUDENT_AUTO_PLAY_DEFAULT);
+  const autoPlayLectureRef = useRef(MIRA_STUDENT_AUTO_PLAY_DEFAULT);
+  const setAutoPlayLecture = useCallback((enabled: boolean) => {
+    autoPlayLectureRef.current = enabled;
+    setAutoPlayLectureState(enabled);
+  }, []);
+  const autoPlayRuntime = useMemo<MiraStudentAutoPlayRuntime | null>(
+    () =>
+      studentMode
+        ? {
+            autoPlayLecture,
+            autoPlayLectureRef,
+            setAutoPlayLecture,
+          }
+        : null,
+    [autoPlayLecture, setAutoPlayLecture, studentMode],
+  );
+
+  return (
+    <MiraStudentAutoPlayRuntimeContext.Provider value={autoPlayRuntime}>
+      {children}
+    </MiraStudentAutoPlayRuntimeContext.Provider>
+  );
+}
+
 type StoredTheme = 'light' | 'dark' | 'system';
 
