+
+export async function prepareEnglish1ReviewRevalidation(args:Args) {
+  const {root,input,prepared,recoveryFolder}=args;
+  const evidence=await json(args.evidencePath);
+  check(evidence.schemaVersion==='mira.english1.saved-quality-response-revalidation.v1'
+    &&evidence.jobId==='omformal_35329ccda267db6155963636'&&evidence.authorizationId===AUTH
+    &&qualitySha(input)==='ec788e0b8393230e870a2f221cfe1329d1b40263ab814485c9d8b1671f6c414e'
