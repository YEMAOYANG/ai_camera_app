+  check(qualitySha(storedInput.teachingBrief)===qualitySha(frozen.teachingBrief)
+    &&qualitySha(storedInput.gradeBoundary)===qualitySha(frozen.gradeBoundary)
+    &&qualitySha(storedInput.snapshot)===TARGET&&storedInput.ownerId===prepared.ownerId
+    &&storedInput.sessionId===prepared.sessionId&&storedInput.stageId===prepared.stage.id);
+  const qualityInput:FormalQualityInput={stage:prepared.stage,scenes:prepared.scenes,ownerId:prepared.ownerId,
+    sessionId:prepared.sessionId,gradeBoundary:storedInput.gradeBoundary,teachingBrief:storedInput.teachingBrief,
+    selectionPlan:storedInput.selectionPlan,difficultyPolicy:storedInput.teachingBrief.difficultyPolicy,
+    playfulLearning:formalPlayfulContext(input.professionalCreationPolicy,spec),
+    interactionDesign:{policy:(input.professionalCreationPolicy as {interactionDesignPolicy:InteractionDesignContext['policy']}).interactionDesignPolicy,
