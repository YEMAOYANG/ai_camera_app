+  const identity={ownerId:prepared.ownerId,sessionId:prepared.sessionId,stageId:prepared.stage.id,
+    gradeBoundarySha256:qualitySha(qualityInput.gradeBoundary),teachingBriefSha256:qualitySha(qualityInput.teachingBrief),
+    selectionPlanSha256:qualityInput.selectionPlan.planSha256,interactionDesignContextSha256:qualitySha(qualityInput.interactionDesign),
+    playfulContextSha256:qualitySha(qualityInput.playfulLearning),difficultyPolicySha256:qualitySha(qualityInput.difficultyPolicy)};
+  check(qualitySha(identity)===REVIEW&&response.requestId===`quality-${qualitySha({...identity,snapshotSha256:TARGET})}`
+    &&response.phase==='verification_after_repair'&&response.billingEvidence==='reported'
+    &&response.providerRequestIdHash==='3359f77f16846de1554320caaf7f288187d9bbba14f4b13da0941d9a64ca782a');
+  const row=evidence.providerReservation;
+  check(row.id==='8a7153a3449ecc8b2bdb03977ecf88bf2163be26a1dad54989aca2025496f2b5'
+    &&row.authorization_id===AUTH&&row.state==='settled'
+    &&JSON.parse(row.actual_units_json).input_tokens===response.inputTokens
+    &&JSON.parse(row.actual_units_json).output_tokens===response.outputTokens);
+  const budget=await readBrowserRecheckBudget(AUTH);
+  check(budget.authorizationId===AUTH&&budget.purpose==='production'&&budget.unsettledReservationCount===0
+    &&budget.latestProviderDispatchAt===row.dispatched_at);
+  const result=finalizeFormalQualityResponse(qualityInput,response,observations,visual);
+  check(result.status==='passed'&&result.receipt&&result.interactionDesign);
+  const stored={...result,reviewPromptVersion:MIRA_FORMAL_PLAYFUL_REVIEW_VERSION,playfulContextSha256:identity.playfulContextSha256};
+  const audit={schemaVersion:evidence.schemaVersion,sourceArtifactPrefix:PREFIX,snapshotSha256:TARGET,
+    evidenceSha256:qualitySha(evidence),sourceResponseSha256:bytesSha(raw),priorAttemptsSha256:qualitySha(attempts),
+    kind:'local_response_revalidation',newProviderCalls:0,originalProviderRequestId:response.requestId,
+    resultSha256:qualitySha(stored),qualityReceiptSha256:result.receipt.receiptSha256,
+    reason:'Align the ID wire-format bound with the existing 30-source-quote bound; preserve all original evidence and judgments.'};
+  const proof={audit,auditSha256:qualitySha(audit),stored,folder,attempts};originals.set(proof,args);return proof;
+}
