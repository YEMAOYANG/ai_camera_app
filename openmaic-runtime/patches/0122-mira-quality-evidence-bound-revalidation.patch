+
+const TARGET='278de60ab4580431b84b6b8fe656a82cc25b4b8409871857a8217f172ece6983';
+const REVIEW='550b7f32a490d9374d2291c2de3077712d1e491819c1e771e03b0ec2aa9b382b';
+const PREFIX=TARGET+'-predispatch-1356e0162f945f506ee93d1727a4009c4a72666fc4e11f49a9601cc25c7afd92';
+const AUTH='d8eca649c6be4ccb5d19b8422b1333253d76bef3ef0b555b7027efb6471f74fc';
+const bytesSha=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
