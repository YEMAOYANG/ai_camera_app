+/** Caller owns the saved-stage lock; the quality lock guards append + canonical receipt. */
+export async function commitEnglish1ReviewRevalidation(proof:Awaited<ReturnType<typeof prepareEnglish1ReviewRevalidation>>) {
+  const args=originals.get(proof);check(args);
+  const lease=await acquireFormalQualityLock(join(proof.folder,'review.lock'));
+  try {
