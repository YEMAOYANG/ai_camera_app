+  const all=await readdir(folder);
+  check(!all.includes(TARGET+'.json')&&!all.some(f=>f.startsWith(TARGET+'-local-revalidation'))
+    &&!(await readdir(recoveryFolder)).includes('completion.json'));
+  const raw=await readFile(join(folder,PREFIX+'-provider.json'));
+  check(bytesSha(raw)==='b820d569bc564c65ca6faaef62c06e22981cf2015e8f8d1903087b9613cbb690'
+    &&evidence.providerResponseSha256===bytesSha(raw));
