+/** A pooled frame can parse while its measured viewport is still 0 x 0.
+ * Notify authored resize handlers when real dimensions arrive. This changes
+ * layout only: it neither reloads the document nor starts activity/audio work. */
+export const RESPONSIVE_FRAME_LAYOUT_SHIM = `<script data-mira-responsive-frame-layout>
+(function () {
+  var queued = false, width = 0, height = 0;
+  function measure() {
+    queued = false;
+    var root = document.documentElement;
+    var nextWidth = root && root.clientWidth, nextHeight = root && root.clientHeight;
+    if (!(nextWidth > 0 && nextHeight > 0)) { width = height = 0; return; }
+    if (nextWidth === width && nextHeight === height) return;
+    width = nextWidth; height = nextHeight;
+    window.dispatchEvent(new Event('resize'));
+  }
+  function schedule() {
+    if (!queued) { queued = true; requestAnimationFrame(measure); }
+  }
+  function start() {
+    if (typeof ResizeObserver === 'function') {
+      var observer = new ResizeObserver(schedule);
+      observer.observe(document.documentElement);
+    }
+    schedule();
+  }
+  window.addEventListener('resize', schedule);
+  window.addEventListener('message', function (event) {
+    var value = event.data;
+    if (event.source !== window.parent || !value || typeof value !== 'object') return;
+    var visible = value.type === 'mira:checkpoint-visibility' ? value.active
+      : value.type === 'MIRA_NARRATION_VISIBILITY' ? value.visible : undefined;
+    if (typeof visible !== 'boolean') return;
+    width = height = 0;
+    if (visible) schedule();
+  });
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
+  else start();
+})();
+</script>`;
