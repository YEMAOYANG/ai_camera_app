+import { readFileSync } from 'fs';
+import { fileURLToPath } from 'url';
+import { describe, expect, it } from 'vitest';
+import * as registry from '@/lib/server/mira-textbook-pinyin-pronunciation';
+
+const corpus = JSON.parse(readFileSync(process.env.MIRA_GARDEN3_CORPUS || fileURLToPath(new URL('../../../../../backend/tests/fixtures/textbook_pinyin_garden3/corpus.v1.json', import.meta.url)), 'utf8'));
+const policy = JSON.parse(readFileSync(fileURLToPath(new URL('../../../../../backend/content/textbook_pinyin_pronunciation_garden3.v2.json', import.meta.url)), 'utf8'));
+const v1 = 'mira.textbook.pinyin-garden3-ssml.v1';
+const v2 = 'mira.textbook.pinyin-garden3-ssml.v2';
+const prepare = registry.prepareMiraTextbookPinyinPronunciation;
+const exact = 'cā bō li。';
+const ssml = '<speak><sub alias="擦玻璃">cā bō li</sub>。</speak>';
+
+describe('Garden 3 v2 full-source alias, no approval inference', () => {
+  it('mirrors the complete backend policy and the observed request bytes', () => {
+    expect(registry.MIRA_TEXTBOOK_PINYIN_GARDEN3_V2_PRONUNCIATION_POLICY).toEqual(policy);
+    const result = prepare(exact, v2);
+    expect(result.ssml).toBe(ssml);
+    expect(result.providerPronunciation.providerBodySha256).toBe('e661190ad790121af353b4c8d502792a31a9fcc35224308dc2d18e4e7c6f5261');
+    expect(result.profile.ssmlSha256).toBe('c754de128d19ee137ddc491f2272c14dad75bd46a17e62e7040184514425fb52');
+    expect(policy.words).toEqual({});
+    expect(policy.approvalBoundary).toMatchObject({ formalUseAllowed: false, pronunciationApproved: false,
+      humanListeningVerified: false, perceptualToneVerified: false, shortConsonantAccepted: false });
+  });
+  it('changes exactly one provider request among 150, keeping all old identities', () => {
+    const changed: string[] = [];
+    expect(corpus.speech).toHaveLength(150);
+    for (const row of corpus.speech) {
+      const old = prepare(row.text, v1);
+      const current = prepare(row.text, v2);
+      expect(old.providerPronunciation).toEqual(row.providerPronunciation);
+      if (current.providerBody !== old.providerBody) changed.push(row.actionId);
+      expect(current.providerPronunciation.policyVersion).toBe(v2);
+    }
+    expect(changed).toEqual(['speech-p9-word3']);
+    const prior = { ...corpus.priorHashes, [v1]: corpus.policySha256 };
+    expect(Object.keys(prior)).toHaveLength(12);
+    for (const [version, hash] of Object.entries(prior)) expect(prepare('请听。', version).profile.policySha256).toBe(hash);
+  });
+  it.each(['请听：'+exact, 'cā bō li', 'cā  bō li。', 'cā bō li！', exact+exact,
+    '玻璃、萝卜、一模一样、星期、数学、孩子。'])('does not match a substring or normalize %s', text => {
+    expect(prepare(text, v2).providerBody).toBe(prepare(text, v1).providerBody);
+  });
+  it.each([' '+exact, exact+' ', 'cā bō li5。', 'cā bō lı。', 'ca\u0304 bō li。', 'constructor', '𝒛'])('rejects %s through unchanged token checks', text => {
+    expect(() => prepare(text, v2)).toThrow();
+  });
+  it('keeps whole-token inventory and does not treat arbitrary versions as aliases', () => {
+    expect(policy.symbols).toEqual(registry.MIRA_TEXTBOOK_PINYIN_GARDEN3_PRONUNCIATION_POLICY.symbols);
+    expect(() => prepare(exact, v2+'-caller')).toThrow();
+    expect(prepare('z、zh、c、ch、s、sh、li、bo。', v2).ssml)
+      .toBe(prepare('z、zh、c、ch、s、sh、li、bo。', v1).ssml);
+  });
+});
