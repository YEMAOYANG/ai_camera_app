diff --git a/lib/server/mira-textbook-scene-contract.ts b/lib/server/mira-textbook-scene-contract.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-textbook-scene-contract.ts
@@ -0,0 +1,801 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import sharp from 'sharp';
+import { parse, type DefaultTreeAdapterTypes as Tree } from 'parse5';
+import type { Scene } from '@/lib/types/stage';
+import type { CourseStore, CourseDocument } from './agent-runtime/course-tools';
+import { CLASSROOMS_DIR } from './classroom-storage';
+import { assertLearningInteractiveSyntax } from './mira-formal-learning-contract';
+import { formalSceneImageReferences } from './mira-formal-media';
+
+const START = '\nMIRA_TEXTBOOK_SCENE_AUTHORING_CONTRACT:\n';
+const END = '\nEND_MIRA_TEXTBOOK_SCENE_AUTHORING_CONTRACT\n';
+const HEX = /^[a-f0-9]{64}$/;
+const CATALOG_ID = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$/;
+const STAGE_ID = /^[A-Za-z0-9_-]{1,160}$/;
+const CUE_ID = /^[A-Za-z0-9_-]{1,128}$/;
+type Json = Record<string, any>;
+const nonempty = (v: unknown): v is string => typeof v === 'string' && !!v.trim();
+const object = (v: unknown): v is Json => !!v && typeof v === 'object' && !Array.isArray(v);
+function fail(code: string): never {
+  throw new Error(`TEXTBOOK_SCENE_${code}`);
+}
+function compareCodePoints(a: string, b: string): number {
+  const left = Array.from(a, (c) => c.codePointAt(0)!);
+  const right = Array.from(b, (c) => c.codePointAt(0)!);
+  for (let i = 0; i < Math.min(left.length, right.length); i++)
+    if (left[i] !== right[i]) return left[i] - right[i];
+  return left.length - right.length;
+}
+/** Match Python sort_keys even for numeric-looking and non-BMP object keys. */
+export function textbookCanonical(v: any): string {
+  if (Array.isArray(v))
+    return '[' + v.map((item) => textbookCanonical(item ?? null)).join(',') + ']';
+  if (object(v))
+    return (
+      '{' +
+      Object.keys(v)
+        .filter((k) => v[k] !== undefined)
+        .sort(compareCodePoints)
+        .map((k) => JSON.stringify(k) + ':' + textbookCanonical(v[k]))
+        .join(',') +
+      '}'
+    );
+  return JSON.stringify(v);
+}
+export const textbookDigest = (v: unknown): string =>
+  createHash('sha256').update(textbookCanonical(v)).digest('hex');
+function safeContractJson(v: unknown): void {
+  if (typeof v === 'number' && !Number.isSafeInteger(v)) fail('CONTRACT_NUMBER_UNSUPPORTED');
+  if (Array.isArray(v)) for (const item of v) safeContractJson(item);
+  else if (object(v)) for (const item of Object.values(v)) safeContractJson(item);
+}
+
+export interface FrozenTextbookContract {
+  schemaVersion: 'mira.frozen-textbook-scene-authoring.v1';
+  contract: {
+    schemaVersion: 'mira.textbook.scene-authoring-contract.v1';
+    binding: Json;
+    catalogEvidence: Json;
+    teacherContract: Json;
+    interactionPolicy: Json;
+    qualityRules: string[];
+    scopeReview: Json;
+    pagePlan: Json[];
+    lockedAssessments: Json[];
+  };
+  sha256: string;
+}
+export interface TextbookPageInput {
+  stageId: string;
+  order: number;
+  type: string;
+  title: string;
+  widgetType?: string;
+  widgetOutline?: Json;
+  media?: { src: string; assetKey?: string; description?: string }[];
+}
+export interface TextbookPageContext {
+  text: string;
+  brief: string;
+  widgetOutline?: Json;
+}
+interface AssetBinding {
+  assetKey: string;
+  src: string;
+  sha256: string;
+  width: number;
+  height: number;
+  bindingVersion: number;
+  status: 'author_candidate';
+}
+interface Candidate extends Json {
+  schemaVersion: 'mira.textbook.authoring-candidate.v1';
+  sessionId: string;
+  stageId: string;
+  frozenContract: FrozenTextbookContract;
+  assetBindings: AssetBinding[];
+  bindingHistory: { assetKey: string; from: AssetBinding; to: AssetBinding }[];
+  scenes: {
+    sceneId: string;
+    order: number;
+    sha256: string;
+    canonicalJson: string;
+    contractSha256: string;
+  }[];
+}
+
+export function assertTextbookContract(raw: unknown): asserts raw is FrozenTextbookContract {
+  safeContractJson(raw);
+  if (
+    !object(raw) ||
+    Object.keys(raw).sort().join(',') !== 'contract,schemaVersion,sha256' ||
+    raw.schemaVersion !== 'mira.frozen-textbook-scene-authoring.v1' ||
+    !object(raw.contract) ||
+    raw.sha256 !== textbookDigest(raw.contract)
+  )
+    fail('CONTRACT_INTEGRITY');
+  const c = raw.contract;
+  if (
+    Object.keys(c).sort().join(',') !==
+      'binding,catalogEvidence,interactionPolicy,lockedAssessments,pagePlan,qualityRules,schemaVersion,scopeReview,teacherContract' ||
+    c.schemaVersion !== 'mira.textbook.scene-authoring-contract.v1' ||
+    !object(c.binding) ||
+    !/^primary_[1-6]$/.test(c.binding.gradeCode) ||
+    !['chinese', 'math', 'english', 'science'].includes(c.binding.subject) ||
+    ['editionId', 'revisionId', 'nodeId', 'unitId'].some((k) => !CATALOG_ID.test(c.binding[k])) ||
+    !['upper', 'lower', 'full'].includes(c.binding.volume) ||
+    !['six_year', 'five_four'].includes(c.binding.schoolSystem) ||
+    (c.binding.schoolSystem === 'five_four' && c.binding.gradeCode === 'primary_6') ||
+    !nonempty(c.binding.unitTitle) ||
+    !nonempty(c.binding.lessonTitle) ||
+    !object(c.catalogEvidence) ||
+    !HEX.test(c.catalogEvidence.manifestSha256) ||
+    !HEX.test(c.catalogEvidence.lessonScopeSha256) ||
+    !object(c.teacherContract) ||
+    c.teacherContract.subject !== c.binding.subject ||
+    ['teacherProfileId', 'teacherProfileHash', 'teacherName', 'voiceId', 'languageCode'].some(
+      (k) => !nonempty(c.teacherContract[k]),
+    ) ||
+    !Number.isSafeInteger(c.teacherContract.teacherProfileVersion) ||
+    c.teacherContract.teacherProfileVersion < 1 ||
+    !object(c.scopeReview) ||
+    !Object.keys(c.scopeReview).length ||
+    !Array.isArray(c.qualityRules) ||
+    !c.qualityRules.length ||
+    c.qualityRules.some((x: unknown) => typeof x !== 'string' || !x.trim()) ||
+    !object(c.interactionPolicy) ||
+    c.interactionPolicy.schemaVersion !== 'mira.frozen-interaction-policy.v1' ||
+    !object(c.interactionPolicy.policy) ||
+    c.interactionPolicy.sha256 !== textbookDigest(c.interactionPolicy.policy) ||
+    !Array.isArray(c.pagePlan) ||
+    !c.pagePlan.length ||
+    !Array.isArray(c.lockedAssessments)
+  )
+    fail('CONTRACT_INVALID');
+  const seen = new Set<string>();
+  for (const [index, p] of c.pagePlan.entries()) {
+    if (
+      !object(p) ||
+      p.page !== index + 1 ||
+      !['slide', 'interactive', 'quiz'].includes(p.type) ||
+      typeof p.title !== 'string' ||
+      !p.title.trim() ||
+      !nonempty(p.move)
+    )
+      fail('PAGE_PLAN_INVALID');
+    if (
+      p.narrationGuidance !== undefined &&
+      (!Array.isArray(p.narrationGuidance) ||
+        (p.narrationGuidance.length && p.type !== 'quiz') ||
+        p.narrationGuidance.some((x: unknown) => typeof x !== 'string' || !x.trim()) ||
+        new Set(p.narrationGuidance).size !== p.narrationGuidance.length)
+    )
+      fail('QUIZ_GUIDANCE_INVALID');
+    const ids = p.questionIds ?? [];
+    if (
+      !Array.isArray(ids) ||
+      ids.some((id) => !CATALOG_ID.test(id)) ||
+      new Set(ids).size !== ids.length ||
+      (p.type === 'quiz' &&
+        (!ids.length ||
+          (['primary_1', 'primary_2'].includes(c.binding.gradeCode) && ids.length !== 1))) ||
+      (p.type !== 'quiz' && ids.length)
+    )
+      fail('LOCKED_QUESTION_SCOPE');
+  }
+  for (const q of c.lockedAssessments) {
+    if (
+      !object(q) ||
+      !CATALOG_ID.test(q.id) ||
+      seen.has(q.id) ||
+      typeof q.question !== 'string' ||
+      !q.question.trim() ||
+      q.type !== 'single' ||
+      !Number.isSafeInteger(q.page) ||
+      !Number.isInteger(q.points) ||
+      q.points <= 0 ||
+      !nonempty(q.analysis) ||
+      (q.visualAsset !== undefined && !CATALOG_ID.test(q.visualAsset)) ||
+      !Array.isArray(q.choices) ||
+      q.choices.length < 2 ||
+      q.choices.length > 6 ||
+      q.choices.some(
+        (o: Json) =>
+          !object(o) ||
+          !nonempty(o.value) ||
+          !nonempty(o.label) ||
+          (['primary_1', 'primary_2'].includes(c.binding.gradeCode) && !CATALOG_ID.test(o.asset)) ||
+          (o.asset !== undefined && !CATALOG_ID.test(o.asset)),
+      ) ||
+      new Set(q.choices.map((o: Json) => o.value)).size !== q.choices.length
+    )
+      fail('LOCKED_QUESTION_INVALID');
+    const page = c.pagePlan[q.page - 1];
+    if (!page || page.type !== 'quiz' || !page.questionIds.includes(q.id))
+      fail('LOCKED_QUESTION_SCOPE');
+    const answers = Array.isArray(q.answer) ? q.answer : [q.answer];
+    if (
+      typeof q.answer !== 'string' ||
+      !answers.length ||
+      answers.some((a: string) => !q.choices.some((o: Json) => o.value === a))
+    )
+      fail('LOCKED_ANSWER_INVALID');
+    if (
+      (page.narrationGuidance ?? []).some(
+        (line: string) => line === q.question || line === q.analysis,
+      )
+    )
+      fail('QUIZ_GUIDANCE_INVALID');
+    seen.add(q.id);
+  }
+  const planned = c.pagePlan.flatMap((p: Json) => (p.type === 'quiz' ? p.questionIds : []));
+  if (
+    planned.length !== seen.size ||
+    new Set(planned).size !== seen.size ||
+    planned.some((id: string) => !seen.has(id))
+  )
+    fail('LOCKED_QUESTION_SCOPE');
+}
+
+/** Only the immutable opening request is authority; follow-ups/tool booleans cannot downgrade it. */
+export function textbookContractFromPrompt(prompt: string): FrozenTextbookContract | undefined {
+  if (!prompt.includes('MIRA_TEXTBOOK_SCENE_AUTHORING_CONTRACT')) return undefined;
+  const parts = prompt.split(START);
+  if (parts.length !== 2 || parts[1].split(END).length !== 2) fail('CONTRACT_ENVELOPE_INVALID');
+  let raw: unknown;
+  try {
+    raw = JSON.parse(parts[1].split(END)[0]);
+  } catch {
+    fail('CONTRACT_ENVELOPE_INVALID');
+  }
+  assertTextbookContract(raw);
+  return raw;
+}
+
+function pageFor(
+  frozen: FrozenTextbookContract,
+  input: Pick<TextbookPageInput, 'order' | 'type' | 'title' | 'widgetType' | 'widgetOutline'>,
+): Json {
+  const p = frozen.contract.pagePlan[input.order - 1];
+  if (
+    !p ||
+    p.page !== input.order ||
+    p.type !== input.type ||
+    p.title !== input.title ||
+    (p.widgetType && p.widgetType !== input.widgetType)
+  )
+    fail('PAGE_SCOPE_MISMATCH');
+  if (
+    p.widgetOutline &&
+    input.widgetOutline &&
+    textbookDigest(p.widgetOutline) !== textbookDigest(input.widgetOutline)
+  )
+    fail('PAGE_SCOPE_MISMATCH');
+  return p;
+}
+function htmlDetails(html: string): {
+  cues: Json[];
+  images: string[];
+  marker: boolean;
+} {
+  const document = parse(html);
+  let markerCount = 0;
+  const blocks: string[] = [];
+  const images: string[] = [];
+  const visit = (node: Tree.Node, parent?: string) => {
+    if ('tagName' in node) {
+      const attrs = Object.fromEntries(node.attrs.map((a) => [a.name, a.value]));
+      if (
+        node.tagName === 'meta' &&
+        attrs.name === 'mira-responsive-activity' &&
+        parent === 'head'
+      ) {
+        if (attrs.content !== 'low-reading-v1') fail('RESPONSIVE_MARKER_INVALID');
+        markerCount++;
+      }
+      if (node.tagName === 'script') {
+        if (attrs.src || attrs.type === 'module') fail('EXTERNAL_RESOURCE');
+        if (attrs.id === 'mira-narration-cues') {
+          if (attrs.type !== 'application/json') fail('CUES_INVALID');
+          blocks.push(node.childNodes.map((n) => ('value' in n ? n.value : '')).join(''));
+        }
+      }
+      if (
+        ['iframe', 'object', 'embed', 'audio', 'video', 'source'].includes(node.tagName) ||
+        (node.tagName === 'link' && attrs.href)
+      )
+        fail('EXTERNAL_RESOURCE');
+      if (node.tagName === 'img') {
+        if (!attrs.src || attrs.srcset) fail('IMAGE_BINDING_MISSING');
+        images.push(attrs.src);
+      }
+      // Templates are inert and cannot provide the required marker/cues/pictures.
+      if (node.tagName === 'template') return;
+    }
+    if ('childNodes' in node)
+      for (const child of node.childNodes) visit(child, 'tagName' in node ? node.tagName : parent);
+  };
+  visit(document);
+  if (
+    /speechSynthesis|SpeechSynthesisUtterance|\bnew\s+Audio\s*\(|\b(?:localStorage|sessionStorage|indexedDB)\b|document\s*\.\s*cookie|\b(?:fetch|XMLHttpRequest|WebSocket|EventSource)\b/.test(
+      html,
+    ) ||
+    /(?:window\s*\.\s*miraNarrate\s*=(?!=)|function\s+miraNarrate\b)/.test(html)
+  )
+    fail('UNSAFE_AUDIO_OR_STORAGE');
+  if (/@import\b|url\(\s*["']?(?:https?:|\/\/|data:)/i.test(html)) fail('EXTERNAL_RESOURCE');
+  assertLearningInteractiveSyntax(html);
+  let cues: Json[] = [];
+  if (blocks.length) {
+    if (blocks.length !== 1) fail('CUES_INVALID');
+    let payload: Json;
+    try {
+      payload = JSON.parse(blocks[0]);
+    } catch {
+      fail('CUES_INVALID');
+    }
+    if (
+      payload!.schemaVersion !== 'mira.interactive.narration-cues.v1' ||
+      !Array.isArray(payload!.cues)
+    )
+      fail('CUES_INVALID');
+    cues = payload!.cues;
+    if (
+      !cues.length ||
+      cues.length > 120 ||
+      cues.some(
+        (c) =>
+          !object(c) ||
+          !CUE_ID.test(c.id) ||
+          typeof c.text !== 'string' ||
+          !c.text.trim() ||
+          c.text !== c.text.trim() ||
+          Array.from(c.text).length > 1000,
+      ) ||
+      new Set(cues.map((c) => c.id)).size !== cues.length
+    )
+      fail('CUES_INVALID');
+  }
+  return { cues, images, marker: markerCount === 1 };
+}
+
+function sceneImages(scene: Scene): string[] {
+  const refs = new Set(formalSceneImageReferences(scene));
+  const add = (v: any) => {
+    if (v?.kind === 'image' && typeof v.src === 'string') refs.add(v.src);
+    if (v?.kind === 'people')
+      for (const member of v.members ?? [])
+        if (typeof member.src === 'string') refs.add(member.src);
+  };
+  if (scene.content.type === 'quiz')
+    for (const q of scene.content.questions) {
+      add(q.visual);
+      for (const v of Object.values(q.optionVisuals ?? {})) add(v);
+    }
+  return [...refs];
+}
+
+/** Static contract checks, never a claim that a game or pictured meaning was play-tested. */
+export function assertTextbookScene(
+  scene: Scene,
+  frozen: FrozenTextbookContract,
+  bindings: AssetBinding[],
+): void {
+  if (scene.content.type !== scene.type) fail('PAGE_SCOPE_MISMATCH');
+  const p = pageFor(frozen, {
+    order: scene.order,
+    type: scene.type,
+    title: scene.title,
+    widgetType: (scene.content as any).widgetType,
+  });
+  const low = ['primary_1', 'primary_2'].includes(frozen.contract.binding.gradeCode);
+  const speech = (scene.actions ?? []).filter((a) => a.type === 'speech') as {
+    id: string;
+    text: string;
+  }[];
+  if (
+    !speech.length ||
+    speech.some((a) => !a.id || !a.text?.trim()) ||
+    new Set(speech.map((a) => a.id)).size !== speech.length
+  )
+    fail('SPEECH_MISSING');
+  const byKey = new Map(bindings.map((b) => [b.assetKey, b]));
+  if (scene.content.type === 'interactive') {
+    if (typeof scene.content.html !== 'string') fail('INLINE_HTML_REQUIRED');
+    const h = htmlDetails(scene.content.html);
+    if (low && (!h.marker || !h.images.length || !h.cues.length))
+      fail('LOW_READING_INTERACTIVE_INCOMPLETE');
+    if (
+      h.cues.length &&
+      (h.cues.length !== speech.length ||
+        new Set(h.cues.map((c) => c.text)).size !== h.cues.length ||
+        h.cues.some((c) => speech.filter((a) => a.text === c.text).length !== 1))
+    )
+      fail('CUE_SPEECH_MISMATCH');
+  }
+  if (scene.content.type === 'quiz') {
+    const qs = scene.content.questions;
+    if (textbookDigest(qs.map((q) => q.id)) !== textbookDigest(p.questionIds))
+      fail('LOCKED_QUESTION_SCOPE');
+    for (const q of qs) {
+      const lock = frozen.contract.lockedAssessments.find((a) => a.id === q.id)!;
+      const expected = {
+        id: lock.id,
+        type: lock.type,
+        question: lock.question,
+        points: lock.points,
+        options: lock.choices.map((c: Json) => ({
+          value: c.value,
+          label: c.label,
+        })),
+        answer: Array.isArray(lock.answer) ? lock.answer : [lock.answer],
+        analysis: lock.analysis,
+      };
+      const actual = Object.fromEntries(Object.keys(expected).map((k) => [k, (q as any)[k]]));
+      if (q.hasAnswer === false || textbookDigest(expected) !== textbookDigest(actual))
+        fail('LOCKED_QUESTION_CHANGED');
+      if (
+        speech.filter((a) => a.text === q.question).length !== 1 ||
+        speech.some(
+          (a) =>
+            !qs.some((t) => t.question === a.text) && !(p.narrationGuidance ?? []).includes(a.text),
+        ) ||
+        new Set(speech.map((a) => a.text)).size !== speech.length
+      )
+        fail('QUIZ_SPEECH_MISMATCH');
+      if (lock.visualAsset) {
+        const expectedVisual = byKey.get(lock.visualAsset);
+        if (!expectedVisual || q.visual?.kind !== 'image' || q.visual.src !== expectedVisual.src)
+          fail('QUIZ_ASSET_BINDING_MISSING');
+      } else if (
+        q.visual !== undefined &&
+        (!object(q.visual) ||
+          q.visual.kind !== 'image' ||
+          !bindings.some((b) => b.src === (q.visual as { src: string }).src))
+      )
+        fail('QUIZ_ASSET_BINDING_MISSING');
+      if (low || lock.choices.some((choice: Json) => choice.asset)) {
+        if (
+          !object(q.optionVisuals) ||
+          Object.keys(q.optionVisuals).sort().join('\0') !==
+            lock.choices
+              .map((c: Json) => c.value)
+              .sort()
+              .join('\0')
+        )
+          fail('QUIZ_PICTURES_MISSING');
+        const hashes = lock.choices.map((choice: Json) => {
+          const b = byKey.get(choice.asset);
+          const visual = q.optionVisuals![choice.value];
+          if (
+            !b ||
+            !visual ||
+            visual.kind !== 'image' ||
+            visual.src !== b.src ||
+            !visual.alt?.trim()
+          )
+            fail('QUIZ_ASSET_BINDING_MISSING');
+          return b.sha256;
+        });
+        if (low && new Set(hashes).size !== hashes.length) fail('QUIZ_PICTURES_NOT_DISTINCT');
+      }
+    }
+  }
+  const refs = sceneImages(scene);
+  if (low && !refs.length) fail('TEACHING_IMAGE_MISSING');
+  if (refs.some((src) => !bindings.some((b) => b.src === src))) fail('IMAGE_BINDING_MISSING');
+}
+
+export function createTextbookAuthoringGuard(
+  frozen: FrozenTextbookContract,
+  sessionId: string,
+  options: {
+    classroomsDir?: string;
+    onCandidate?: (candidate: Json) => Promise<void>;
+  } = {},
+) {
+  assertTextbookContract(frozen);
+  const root = path.resolve(options.classroomsDir ?? CLASSROOMS_DIR);
+  const inMemory = new Map<string, Candidate>();
+  const writes = new Map<string, Promise<unknown>>();
+  const serial = <T>(id: string, task: () => Promise<T>): Promise<T> => {
+    const running = (writes.get(id) ?? Promise.resolve()).catch(() => undefined).then(task);
+    writes.set(id, running);
+    void running
+      .finally(() => {
+        if (writes.get(id) === running) writes.delete(id);
+      })
+      .catch(() => undefined);
+    return running;
+  };
+  let ownerStore: CourseStore | undefined;
+  const fileFor = (id: string) => {
+    if (!STAGE_ID.test(id)) fail('STAGE_INVALID');
+    return path.join(root, id, 'textbook-authoring-candidate.json');
+  };
+  async function read(id: string): Promise<Candidate> {
+    if (inMemory.has(id)) return inMemory.get(id)!;
+    let candidate: Candidate;
+    try {
+      const { sha256, ...saved } = JSON.parse(await fs.readFile(fileFor(id), 'utf8'));
+      if (
+        sha256 !== textbookDigest(saved) ||
+        saved.schemaVersion !== 'mira.textbook.authoring-candidate.v1' ||
+        saved.sessionId !== sessionId ||
+        saved.stageId !== id ||
+        !object(saved.frozenContract) ||
+        textbookDigest(saved.frozenContract) !== textbookDigest(frozen) ||
+        saved.status !== 'author_candidate' ||
+        saved.verification !== 'static_contract_only_not_play_or_semantic_review' ||
+        !Array.isArray(saved.assetBindings) ||
+        !Array.isArray(saved.bindingHistory) ||
+        !Array.isArray(saved.scenes)
+      )
+        fail('CANDIDATE_INTEGRITY');
+      candidate = saved as Candidate;
+    } catch (e: any) {
+      if (e.code !== 'ENOENT') throw e;
+      candidate = {
+        schemaVersion: 'mira.textbook.authoring-candidate.v1',
+        sessionId,
+        stageId: id,
+        frozenContract: frozen,
+        status: 'author_candidate',
+        verification: 'static_contract_only_not_play_or_semantic_review',
+        assetBindings: [],
+        bindingHistory: [],
+        scenes: [],
+      };
+    }
+    inMemory.set(id, candidate);
+    return candidate;
+  }
+  async function image(src: string, stageId: string) {
+    const prefix = `/api/classroom-media/${stageId}/media/`;
+    if (
+      !src.startsWith(prefix) ||
+      !/^[A-Za-z0-9_.-]+\.(?:png|jpg|jpeg|webp)$/.test(src.slice(prefix.length))
+    )
+      fail('IMAGE_NOT_STAGE_OWNED');
+    const file = path.join(await fs.realpath(root), stageId, 'media', src.slice(prefix.length));
+    let bytes: Buffer;
+    try {
+      if ((await fs.realpath(file)) !== file || (await fs.stat(file)).size > 32 * 1024 * 1024)
+        fail('IMAGE_BYTES_INVALID');
+      bytes = await fs.readFile(file);
+    } catch (e: any) {
+      if (e.message?.startsWith('TEXTBOOK_SCENE_')) throw e;
+      fail('IMAGE_FILE_MISSING');
+    }
+    let meta;
+    try {
+      meta = await sharp(bytes!, { limitInputPixels: 40_000_000 }).metadata();
+    } catch {
+      fail('IMAGE_BYTES_INVALID');
+    }
+    if (!['png', 'jpeg', 'webp'].includes(meta!.format ?? '') || !meta!.width || !meta!.height)
+      fail('IMAGE_BYTES_INVALID');
+    return {
+      src,
+      sha256: createHash('sha256').update(bytes!).digest('hex'),
+      width: meta!.width!,
+      height: meta!.height!,
+    };
+  }
+  async function persist(candidate: Candidate) {
+    const file = fileFor(candidate.stageId);
+    const pending = file + '.' + randomUUID() + '.tmp';
+    await fs.mkdir(path.dirname(file), { recursive: true });
+    await fs.writeFile(
+      pending,
+      JSON.stringify({ ...candidate, sha256: textbookDigest(candidate) }),
+      { mode: 0o600 },
+    );
+    await fs.rename(pending, file);
+  }
+  async function verifyBytes(candidate: Candidate, scenes: Scene[]) {
+    const refs = new Set(scenes.flatMap(sceneImages));
+    for (const src of refs) {
+      const actual = await image(src, candidate.stageId);
+      if (!candidate.assetBindings.some((b) => b.src === src && b.sha256 === actual.sha256))
+        fail('IMAGE_BYTES_CHANGED');
+    }
+  }
+  return {
+    context(input: TextbookPageInput): Promise<TextbookPageContext> {
+      return serial(input.stageId, async () => {
+        const page = pageFor(frozen, input);
+        const document = await ownerStore?.loadDocument(input.stageId);
+        if ((document?.outline as any)?.producerRef !== sessionId) fail('STAGE_SESSION_MISMATCH');
+        const candidate = await read(input.stageId);
+        if (
+          document!.scenes.length !== candidate.scenes.length ||
+          document!.scenes.some(
+            (scene) =>
+              !candidate.scenes.some(
+                (saved) => saved.sceneId === scene.id && saved.sha256 === textbookDigest(scene),
+              ),
+          )
+        ) {
+          fail('SAVED_CANDIDATE_REVIEW_REQUIRED');
+        }
+        const next = structuredClone(candidate);
+        const seen = new Set<string>();
+        for (const media of input.media ?? []) {
+          // Unlabelled non-assessment images still get a stable byte-derived key.
+          const actual = await image(media.src, input.stageId);
+          const key = media.assetKey ?? `image-${actual.sha256}`;
+          if (!CATALOG_ID.test(key) || seen.has(key)) fail('ASSET_KEY_INVALID');
+          seen.add(key);
+          const previous = next.assetBindings.find((b) => b.assetKey === key);
+          if (!previous || previous.src !== actual.src || previous.sha256 !== actual.sha256) {
+            const binding: AssetBinding = {
+              ...actual,
+              assetKey: key,
+              bindingVersion: (previous?.bindingVersion ?? 0) + 1,
+              status: 'author_candidate',
+            };
+            if (previous)
+              next.bindingHistory.push({
+                assetKey: key,
+                from: previous,
+                to: binding,
+              });
+            next.assetBindings = [...next.assetBindings.filter((b) => b.assetKey !== key), binding];
+          }
+        }
+        // Reused bindings are evidence only while their original bytes still exist.
+        // Check before any provider call, including when this call supplies no media.
+        for (const binding of next.assetBindings) {
+          const actual = await image(binding.src, input.stageId);
+          if (
+            actual.sha256 !== binding.sha256 ||
+            actual.width !== binding.width ||
+            actual.height !== binding.height
+          )
+            fail('IMAGE_BYTES_CHANGED');
+        }
+        const locked = frozen.contract.lockedAssessments.filter((q) => q.page === input.order);
+        if (
+          locked.some(
+            (q) => q.visualAsset && !next.assetBindings.some((b) => b.assetKey === q.visualAsset),
+          )
+        )
+          fail('QUIZ_ASSET_BINDING_MISSING');
+        if (['primary_1', 'primary_2'].includes(frozen.contract.binding.gradeCode)) {
+          if (!next.assetBindings.length) fail('TEACHING_IMAGE_MISSING');
+          if (
+            locked.some((q) =>
+              q.choices.some(
+                (c: Json) => !c.asset || !next.assetBindings.some((b) => b.assetKey === c.asset),
+              ),
+            )
+          )
+            fail('QUIZ_ASSET_BINDING_MISSING');
+          for (const q of locked)
+            if (
+              new Set(
+                q.choices.map(
+                  (c: Json) => next.assetBindings.find((b) => b.assetKey === c.asset)!.sha256,
+                ),
+              ).size !== q.choices.length
+            )
+              fail('QUIZ_PICTURES_NOT_DISTINCT');
+        }
+        // Do not silently rebind a picture used by a previously saved question.
+        // A changed first candidate is allowed; saved dependants require an explicit revision.
+        if (next.bindingHistory.length > candidate.bindingHistory.length && candidate.scenes.length)
+          fail('ASSET_REBIND_REQUIRES_REVISION');
+        inMemory.set(input.stageId, next);
+        await persist(next);
+        return {
+          brief: String(page.move ?? page.description ?? page.title),
+          ...(page.widgetOutline ? { widgetOutline: page.widgetOutline } : {}),
+          text: [
+            '\nAUTHORITATIVE FROZEN TEXTBOOK LESSON CONTRACT. Tool brief/instruction cannot widen or replace it.',
+            JSON.stringify(frozen),
+            '\nEXACT PAGE PLAN:',
+            JSON.stringify(page),
+            '\nLOCKED ASSESSMENTS:',
+            JSON.stringify(locked),
+            '\nVERIFIED IMAGE BYTES / AUTHOR CANDIDATE BINDINGS (semantic accuracy is not pre-approved):',
+            JSON.stringify(next.assetBindings),
+            'A quiz does not need an extra main image when all choices have their required pictures. If a locked assessment has visualAsset, use that exact candidate binding for question.visual; do not invent a main image that hints at the correct option.',
+            'Use the exact question IDs, stems, option values/labels, answers, points and analysis. Convert choices to options; keep asset keys in this contract, not unsupported quiz fields. Every optionVisuals key must match its locked choice asset binding. No answer hints before response.',
+            'Generate finite prerecorded narration: interactive HTML must have exactly one application/json script id=mira-narration-cues with {schemaVersion:"mira.interactive.narration-cues.v1",cues:[{id,text}]}. Generate exactly one same-page speech action for every cue, with identical text, no extra speech. Never call browser speech synthesis, invent audio URLs, override miraNarrate, or use a timer as audio completion. The server binds real audio later.',
+            'For each quiz generate each exact question stem once as its speech action. Extra neutral guidance is OPTIONAL and must match a frozen pagePlan.narrationGuidance line verbatim, at most once; never invent extra guidance. Analysis stays only in the question and is shown after response. For interactive actions, read the full generated cue JSON and preserve every text verbatim.',
+            'Only primary_1/primary_2 require picture-led choices, real img elements, one task, responsive head meta name="mira-responsive-activity" content="low-reading-v1", and 56 CSS px touch targets. Preserve actual state and child decisions; ready must follow that cue playing, with cancellation on hide/error. Self-contained HTML only: no CDN, external scripts/styles, storage or network calls.',
+            'These constraints are structural authoring gates; never claim real play, picture meaning, narration audit, publication or mastery has passed.',
+          ].join('\n'),
+        };
+      });
+    },
+    wrapStore(store: CourseStore): CourseStore {
+      ownerStore = store;
+      const guarded = async (doc: CourseDocument) => {
+        const producer = (doc.outline as any)?.producerRef;
+        if (producer !== sessionId) fail('STAGE_SESSION_MISMATCH');
+        const candidate = await read(doc.stage.id);
+        if (new Set(doc.scenes.map((s) => s.order)).size !== doc.scenes.length)
+          fail('PAGE_SCOPE_MISMATCH');
+        for (const scene of doc.scenes) {
+          if (scene.stageId !== doc.stage.id) fail('STAGE_SESSION_MISMATCH');
+          assertTextbookScene(scene, frozen, candidate.assetBindings);
+        }
+        await verifyBytes(candidate, doc.scenes);
+        return {
+          ...candidate,
+          scenes: [...doc.scenes]
+            .sort((a, b) => a.order - b.order)
+            .map((s) => ({
+              sceneId: s.id,
+              order: s.order,
+              sha256: textbookDigest(s),
+              canonicalJson: textbookCanonical(s),
+              contractSha256: frozen.sha256,
+            })),
+        };
+      };
+      const record = async (candidate: Candidate) => {
+        inMemory.set(candidate.stageId, candidate);
+        await persist(candidate);
+        await options.onCandidate?.({
+          schemaVersion: candidate.schemaVersion,
+          stageId: candidate.stageId,
+          sessionId,
+          contractSha256: frozen.sha256,
+          candidateSha256: textbookDigest(candidate),
+          scenes: candidate.scenes.map(({ canonicalJson: _canonicalJson, ...summary }) => summary),
+          verification: 'static_contract_only_not_play_or_semantic_review',
+        });
+      };
+      return new Proxy(store, {
+        get(target, property) {
+          if (property === 'putScene')
+            return (id: string, scene: Scene) =>
+              serial(id, async () => {
+                const doc = await target.loadDocument(id);
+                if (!doc) fail('STAGE_MISSING');
+                const next = {
+                  ...doc!,
+                  scenes: [...doc!.scenes.filter((s) => s.id !== scene.id), scene],
+                };
+                const candidate = await guarded(next);
+                const result = await target.putScene(id, scene);
+                await record(candidate);
+                return result;
+              });
+          if (property === 'saveDocument')
+            return (doc: CourseDocument) =>
+              serial(doc.stage.id, async () => {
+                const candidate = await guarded(doc);
+                const result = await target.saveDocument(doc);
+                await record(candidate);
+                return result;
+              });
+          if (property === 'deleteDocument')
+            return async () => {
+              fail('DOCUMENT_REMOVAL_REQUIRES_REVIEW');
+            };
+          if (property === 'deleteScene')
+            return (id: string, sceneId: string) =>
+              serial(id, async () => {
+                const doc = await target.loadDocument(id);
+                if (!doc) fail('STAGE_MISSING');
+                const candidate = await guarded({
+                  ...doc!,
+                  scenes: doc!.scenes.filter((s) => s.id !== sceneId),
+                });
+                const result = await target.deleteScene(id, sceneId);
+                await record(candidate);
+                return result;
+              });
+          const value = Reflect.get(target, property);
+          return typeof value === 'function' ? value.bind(target) : value;
+        },
+      });
+    },
+  };
+}
