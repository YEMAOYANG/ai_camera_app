+
+export type MiraFormalProviderReadinessErrorCode =
+  | 'invalid_request'
+  | 'request_conflict'
+  | 'not_found'
+  | 'unauthorized'
+  | 'provider_unavailable'
+  | 'asset_unavailable';
+
+export class MiraFormalProviderReadinessError extends Error {
+  constructor(
+    public readonly code: MiraFormalProviderReadinessErrorCode,
+    message: string,
+  ) {
+    super(message);
+    this.name = 'MiraFormalProviderReadinessError';
+  }
+}
+
+interface RuntimeDependencies {
+  fetchImpl?: typeof fetch;
+  now?: () => Date;
+}
+
+class OperationalFailure extends Error {
+  constructor(
+    public readonly outcome: 'failed' | 'ambiguous',
+    public readonly safeCode: string,
+  ) {
+    super(safeCode);
+  }
+}
+
+const IDENTIFIER = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$/;
+const GRADE_CODE = /^[a-z][a-z0-9_]{0,63}$/;
+const SHA256 = /^[a-f0-9]{64}$/;
+const REQUEST_KEYS = [
+  'audioJobTerminalReceiptSha256',
+  'buildItemId',
+  'classroomContentSha256',
+  'gradeCode',
+  'releaseId',
+  'requestId',
+  'routeSession',
+  'runtimeClassroomId',
+  'runtimeRequestId',
+  'schemaVersion',
+  'targetFingerprint',
+  'upstreamClassroomId',
+  'validation',
+] as const;
+const VALIDATION_KEYS = [
+  'audioSha256',
+  'machineReceiptSha256',
+  'sceneOrder',
+  'subject',
+  'ttsRequestId',
+] as const;
+const ROUTE_KEYS = [
+  'conversationProbeId',
+  'providerCall',
+  'receiptSha256',
+  'schemaVersion',
+] as const;
+const FORBIDDEN_KEYS = new Set([
+  'provider',
+  'model',
+  'voice',
+  'apikey',
+  'key',
+  'baseurl',
+  'fallback',
+  'audiourl',
+  'base64',
+  'providerproof',
+]);
+const MAX_PROVIDER_JSON_BYTES = 1024 * 1024;
+const STALE_RUNNING_MS = 5 * 60 * 1000;
+
+function sha256(value: string | Uint8Array): string {
+  return createHash('sha256').update(value).digest('hex');
+}
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(
+      Object.entries(value as Record<string, unknown>)
+        .sort(([left], [right]) => left.localeCompare(right))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  }
+  return value;
+}
+
+function digest(value: unknown): string {
+  return sha256(JSON.stringify(canonical(value)));
+}
+
+function assertNoForbiddenKeys(value: unknown): void {
+  if (!value || typeof value !== 'object') return;
+  if (Array.isArray(value)) {
+    for (const item of value) assertNoForbiddenKeys(item);
+    return;
+  }
+  for (const [key, item] of Object.entries(value as Record<string, unknown>)) {
+    if (FORBIDDEN_KEYS.has(key.toLowerCase())) {
+      throw new MiraFormalProviderReadinessError('invalid_request', 'Invalid readiness request');
+    }
+    assertNoForbiddenKeys(item);
+  }
+}
+
+function exactObject(value: unknown, keys: readonly string[]): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new MiraFormalProviderReadinessError('invalid_request', 'Invalid readiness request');
+  }
+  if (Object.keys(value).sort().join(',') !== [...keys].sort().join(',')) {
+    throw new MiraFormalProviderReadinessError('invalid_request', 'Invalid readiness request');
+  }
+  return value as Record<string, unknown>;
+}
+
+export function assertMiraFormalProviderReadinessRequest(
+  value: unknown,
+): MiraFormalProviderReadinessRequest {
+  assertNoForbiddenKeys(value);
+  const input = exactObject(value, REQUEST_KEYS);
+  const validation = exactObject(input.validation, VALIDATION_KEYS);
+  const routeSession = exactObject(input.routeSession, ROUTE_KEYS);
+  if (
+    input.schemaVersion !== MIRA_FORMAL_PROVIDER_READINESS_VERSION ||
+    !IDENTIFIER.test(String(input.requestId || '')) ||
+    !IDENTIFIER.test(String(input.buildItemId || '')) ||
+    !IDENTIFIER.test(String(input.releaseId || '')) ||
+    !GRADE_CODE.test(String(input.gradeCode || '')) ||
+    !SHA256.test(String(input.targetFingerprint || '')) ||
+    !IDENTIFIER.test(String(input.runtimeClassroomId || '')) ||
+    !IDENTIFIER.test(String(input.runtimeRequestId || '')) ||
+    !IDENTIFIER.test(String(input.upstreamClassroomId || '')) ||
+    !SHA256.test(String(input.classroomContentSha256 || '')) ||
+    !SHA256.test(String(input.audioJobTerminalReceiptSha256 || '')) ||
+    typeof validation.subject !== 'string' ||
+    !(validation.subject in SUBJECT_TTS) ||
+    !Number.isInteger(validation.sceneOrder) ||
+    Number(validation.sceneOrder) < 0 ||
+    Number(validation.sceneOrder) > 9 ||
+    !IDENTIFIER.test(String(validation.ttsRequestId || '')) ||
+    !SHA256.test(String(validation.audioSha256 || '')) ||
+    !SHA256.test(String(validation.machineReceiptSha256 || '')) ||
+    routeSession.schemaVersion !== 'mira.openmaic.conversation-proof.v1' ||
+    !IDENTIFIER.test(String(routeSession.conversationProbeId || '')) ||
+    !SHA256.test(String(routeSession.receiptSha256 || '')) ||
+    routeSession.providerCall !== false
+  ) {
+    throw new MiraFormalProviderReadinessError('invalid_request', 'Invalid readiness request');
+  }
+  return input as unknown as MiraFormalProviderReadinessRequest;
+}
+
+function dataRoot(): string {
+  return (
+    process.env.MIRA_FORMAL_PROVIDER_READINESS_DATA_DIR ||
+    path.join(process.cwd(), 'data', 'formal-provider-readiness')
+  );
+}
+
+function jobPath(requestId: string): string {
+  return path.join(dataRoot(), 'jobs', `${sha256(requestId)}.json`);
+}
+
+async function writeExclusiveAtomic(filePath: string, value: unknown): Promise<boolean> {
+  await fs.mkdir(path.dirname(filePath), { recursive: true });
+  const temp = `${filePath}.${process.pid}.${Date.now()}.${Math.random().toString(16).slice(2)}.tmp`;
+  const handle = await fs.open(temp, 'wx', 0o600);
+  try {
+    await handle.writeFile(JSON.stringify(value, null, 2), 'utf8');
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  try {
+    await fs.link(temp, filePath);
+    return true;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'EEXIST') return false;
+    throw error;
+  } finally {
+    await fs.unlink(temp).catch(() => undefined);
+  }
+}
+
+async function writeAtomic(filePath: string, value: unknown): Promise<void> {
+  await fs.mkdir(path.dirname(filePath), { recursive: true });
+  const temp = `${filePath}.${process.pid}.${Date.now()}.${Math.random().toString(16).slice(2)}.tmp`;
+  const handle = await fs.open(temp, 'wx', 0o600);
+  try {
+    await handle.writeFile(JSON.stringify(value, null, 2), 'utf8');
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  await fs.rename(temp, filePath);
+}
+
+function proofFor(record: MiraFormalProviderReadinessJob): MiraFormalProviderProof {
+  const safe = {
+    schemaVersion: MIRA_FORMAL_PROVIDER_READINESS_VERSION,
+    providerCall: record.calls.length > 0,
+    expectedCallCount: 5 as const,
+    attemptedCallCount: record.providerAttemptedCount,
+    passedCallCount: record.providerPassedCount,
+    calls: record.calls,
+  };
+  return { ...safe, receiptSha256: digest(safe) };
+}
+
+async function observeStale(
+  record: MiraFormalProviderReadinessJob,
+  now: Date,
+): Promise<MiraFormalProviderReadinessJob> {
+  if (
+    record.state !== 'running' ||
+    now.getTime() - new Date(record.updatedAt).getTime() <= STALE_RUNNING_MS
+  ) {
+    return record;
+  }
+  const timestamp = now.toISOString();
+  const stale: MiraFormalProviderReadinessJob = {
+    ...record,
+    state: 'ambiguous',
+    safeErrorCode: 'stale_provider_outcome_unknown',
+    providerProof: proofFor(record),
+    updatedAt: timestamp,
+    completedAt: timestamp,
+  };
+  await writeAtomic(jobPath(record.requestId), stale);
+  return stale;
+}
+
+export async function readMiraFormalProviderReadinessJob(
+  requestId: string,
+  now = new Date(),
+): Promise<MiraFormalProviderReadinessJob | null> {
+  if (!IDENTIFIER.test(requestId)) {
+    throw new MiraFormalProviderReadinessError('invalid_request', 'Invalid readiness request id');
+  }
+  try {
+    const record = JSON.parse(
+      await fs.readFile(jobPath(requestId), 'utf8'),
+    ) as MiraFormalProviderReadinessJob;
+    return observeStale(record, now);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+}
+
+function identityFrom(input: MiraFormalProviderReadinessRequest) {
+  return {
+    buildItemId: input.buildItemId,
+    releaseId: input.releaseId,
+    gradeCode: input.gradeCode,
+    targetFingerprint: input.targetFingerprint,
+    runtimeClassroomId: input.runtimeClassroomId,
+    runtimeRequestId: input.runtimeRequestId,
+    upstreamClassroomId: input.upstreamClassroomId,
+    classroomContentSha256: input.classroomContentSha256,
+    audioJobTerminalReceiptSha256: input.audioJobTerminalReceiptSha256,
+    validation: { ...input.validation },
+    routeSessionProof: { ...input.routeSession },
+  };
+}
+
+async function claim(
+  input: MiraFormalProviderReadinessRequest,
+  now: Date,
+): Promise<{ record: MiraFormalProviderReadinessJob; created: boolean }> {
+  const requestSha256 = digest(input);
+  const existing = await readMiraFormalProviderReadinessJob(input.requestId, now);
+  if (existing) {
+    if (existing.requestSha256 !== requestSha256) {
+      throw new MiraFormalProviderReadinessError('request_conflict', 'Readiness request conflict');
+    }
+    return { record: existing, created: false };
+  }
+  const timestamp = now.toISOString();
+  const record: MiraFormalProviderReadinessJob = {
+    schemaVersion: MIRA_FORMAL_PROVIDER_READINESS_JOB_VERSION,
+    requestId: input.requestId,
+    requestSha256,
+    ...identityFrom(input),
+    state: 'running',
+    providerAttemptedCount: 0,
+    providerPassedCount: 0,
+    calls: [],
+    createdAt: timestamp,
+    updatedAt: timestamp,
+  };
+  if (await writeExclusiveAtomic(jobPath(input.requestId), record)) {
+    return { record, created: true };
+  }
+  const winner = await readMiraFormalProviderReadinessJob(input.requestId, now);
+  if (!winner || winner.requestSha256 !== requestSha256) {
+    throw new MiraFormalProviderReadinessError('request_conflict', 'Readiness request conflict');
+  }
+  return { record: winner, created: false };
+}
+
+function qwenEndpoint(baseUrl: string | undefined): string {
+  const parsed = safeHttpsBase(baseUrl || 'https://dashscope.aliyuncs.com/api/v1');
+  return `${parsed}/services/aigc/multimodal-generation/generation`;
+}
+
+function kimiEndpoint(baseUrl: string | undefined): string {
+  return `${safeHttpsBase(baseUrl || 'https://api.moonshot.cn/v1')}/chat/completions`;
+}
+
+function safeHttpsBase(value: string): string {
+  let parsed: URL;
+  try {
+    parsed = new URL(value);
+  } catch {
+    throw new MiraFormalProviderReadinessError(
+      'provider_unavailable',
+      'Formal readiness provider is unavailable',
+    );
+  }
+  if (
+    parsed.protocol !== 'https:' ||
+    parsed.username ||
+    parsed.password ||
+    parsed.search ||
+    parsed.hash ||
+    (parsed.port && parsed.port !== '443')
+  ) {
+    throw new MiraFormalProviderReadinessError(
+      'provider_unavailable',
+      'Formal readiness provider is unavailable',
+    );
+  }
+  return parsed.toString().replace(/\/$/u, '');
+}
+
+export function assertMiraFormalProviderReadinessProviderReady(): void {
+  const kimi = getServerProviders().kimi;
+  const tts = getServerTTSProviders()['qwen-tts'];
+  const asr = getServerASRProviders()['qwen-asr'];
+  if (
+    !kimi ||
+    (kimi.models !== undefined && !kimi.models.includes('kimi-k2.6')) ||
+    !resolveApiKey('kimi') ||
+    !tts ||
+    tts.disabled === true ||
+    !resolveTTSApiKey('qwen-tts') ||
+    !asr ||
+    !resolveASRApiKey('qwen-asr')
+  ) {
+    throw new MiraFormalProviderReadinessError(
+      'provider_unavailable',
+      'Formal readiness providers are unavailable',
+    );
+  }
+  kimiEndpoint(resolveBaseUrl('kimi'));
+  qwenEndpoint(resolveTTSBaseUrl('qwen-tts'));
+  qwenEndpoint(resolveASRBaseUrl('qwen-asr'));
+}
+
+function callSpecs(subject: Subject) {
+  return [
+    {
+      callOrdinal: 1,
+      kind: 'kimi_text' as const,
+      providerId: 'kimi' as const,
+      modelId: 'kimi-k2.6' as const,
+    },
+    {
+      callOrdinal: 2,
+      kind: 'qwen_asr' as const,
+      subject,
+      providerId: 'qwen-asr' as const,
+      modelId: 'qwen3-asr-flash' as const,
+      languageCode: SUBJECT_TTS[subject].languageCode,
+    },
+    ...(['chinese', 'math', 'english'] as const).map((ttsSubject, index) => ({
+      callOrdinal: index + 3,
+      kind: 'qwen_tts' as const,
+      subject: ttsSubject,
+      providerId: 'qwen-tts' as const,
+      modelId: 'qwen3-tts-flash' as const,
+      voiceId: SUBJECT_TTS[ttsSubject].voiceId,
+      languageCode: SUBJECT_TTS[ttsSubject].languageCode,
+    })),
+  ];
+}
+
+type CallSpec = ReturnType<typeof callSpecs>[number];
+
+function requestForCall(
+  spec: CallSpec,
+  input: MiraFormalProviderReadinessRequest,
+  audio: Uint8Array,
+): { endpoint: string; apiKey: string; body: Record<string, unknown> } {
+  if (spec.kind === 'kimi_text') {
+    return {
+      endpoint: kimiEndpoint(resolveBaseUrl('kimi')),
+      apiKey: resolveApiKey('kimi'),
+      body: {
+        model: 'kimi-k2.6',
+        messages: [
+          {
+            role: 'user',
+            content: `Mira formal readiness ${digest(input)}. Reply READY.`,
+          },
+        ],
+        temperature: 0.6,
+        max_completion_tokens: 16,
+        thinking: { type: 'disabled' },
+      },
+    };
+  }
+  if (spec.kind === 'qwen_asr') {
+    return {
+      endpoint: qwenEndpoint(resolveASRBaseUrl('qwen-asr')),
+      apiKey: resolveASRApiKey('qwen-asr'),
+      body: {
+        model: 'qwen3-asr-flash',
+        input: {
+          messages: [
+            {
+              role: 'user',
+              content: [{ audio: `data:audio/wav;base64,${Buffer.from(audio).toString('base64')}` }],
+            },
+          ],
+        },
+        parameters: {
+          asr_options: { language: spec.languageCode === 'en-US' ? 'en' : 'zh' },
+        },
+      },
+    };
+  }
+  const ttsPolicy = SUBJECT_TTS[spec.subject];
+  return {
+    endpoint: qwenEndpoint(resolveTTSBaseUrl('qwen-tts')),
+    apiKey: resolveTTSApiKey('qwen-tts'),
+    body: {
+      model: 'qwen3-tts-flash',
+      input: {
+        text: ttsPolicy.validationText,
+        voice: ttsPolicy.voiceId,
+        language_type: ttsPolicy.qwenLanguageType,
+      },
+      parameters: { rate: 0 },
+    },
+  };
+}
+
+async function fetchJson(
+  fetchImpl: typeof fetch,
+  endpoint: string,
+  apiKey: string,
+  body: Record<string, unknown>,
+): Promise<Record<string, unknown>> {
+  let response: Response;
+  try {
+    response = await fetchImpl(endpoint, {
+      method: 'POST',
+      headers: {
+        Authorization: `Bearer ${apiKey}`,
+        'Content-Type': 'application/json; charset=utf-8',
+      },
+      body: JSON.stringify(body),
+      signal: AbortSignal.timeout(MIRA_FORMAL_PROVIDER_TIMEOUT_MS),
+    });
+  } catch {
+    throw new OperationalFailure('ambiguous', 'provider_outcome_unknown');
+  }
+  if (!response.ok) throw new OperationalFailure('failed', 'provider_rejected');
+  const mime = response.headers.get('content-type')?.split(';', 1)[0].trim().toLowerCase();
+  if (mime !== 'application/json') {
+    throw new OperationalFailure('failed', 'provider_content_type_invalid');
+  }
+  let bytes: Uint8Array;
+  try {
+    bytes = new Uint8Array(await response.arrayBuffer());
+  } catch {
+    throw new OperationalFailure('ambiguous', 'provider_response_lost');
+  }
+  if (bytes.byteLength > MAX_PROVIDER_JSON_BYTES) {
+    throw new OperationalFailure('failed', 'provider_response_too_large');
+  }
+  try {
+    const parsed = JSON.parse(Buffer.from(bytes).toString('utf8'));
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('invalid');
+    return parsed as Record<string, unknown>;
+  } catch {
+    throw new OperationalFailure('failed', 'provider_response_invalid');
+  }
+}
+
+function providerResultSha256(spec: CallSpec, payload: Record<string, unknown>): string {
+  if (spec.kind === 'kimi_text') {
+    const choices = payload.choices;
+    const first = Array.isArray(choices) ? choices[0] : undefined;
+    const message =
+      first && typeof first === 'object' ? (first as Record<string, unknown>).message : undefined;
+    const content =
+      message && typeof message === 'object'
+        ? (message as Record<string, unknown>).content
+        : undefined;
+    if (typeof content !== 'string' || !content.trim() || content.length > 64_000) {
+      throw new OperationalFailure('failed', 'provider_response_invalid');
+    }
+    return sha256(content);
+  }
+  if (spec.kind === 'qwen_asr') {
+    const output = payload.output as Record<string, unknown> | undefined;
+    const choices = output?.choices;
+    const first = Array.isArray(choices) ? choices[0] : undefined;
+    const message =
+      first && typeof first === 'object' ? (first as Record<string, unknown>).message : undefined;
+    const content =
+      message && typeof message === 'object'
+        ? (message as Record<string, unknown>).content
+        : undefined;
+    const item = Array.isArray(content) ? content[0] : undefined;
+    const transcript =
+      item && typeof item === 'object' ? (item as Record<string, unknown>).text : undefined;
+    if (typeof transcript !== 'string' || !transcript.trim() || transcript.length > 64_000) {
+      throw new OperationalFailure('failed', 'provider_response_invalid');
+    }
+    return sha256(transcript);
+  }
+  const output = payload.output as Record<string, unknown> | undefined;
+  const audio = output?.audio as Record<string, unknown> | undefined;
+  if (!audio || typeof audio.url !== 'string') {
+    throw new OperationalFailure('failed', 'provider_response_invalid');
+  }
+  let url: URL;
+  try {
+    url = new URL(audio.url);
+  } catch {
+    throw new OperationalFailure('failed', 'provider_response_invalid');
+  }
+  if (url.protocol !== 'https:' || url.username || url.password) {
+    throw new OperationalFailure('failed', 'provider_response_invalid');
+  }
+  return sha256(audio.url);
+}
+
+async function recordAttempt(
+  record: MiraFormalProviderReadinessJob,
+  spec: CallSpec,
+  requestSha256: string,
+  now: Date,
+): Promise<MiraFormalProviderReadinessJob> {
+  const attemptedAt = now.toISOString();
+  const call: MiraFormalProviderCallReceipt = {
+    callOrdinal: spec.callOrdinal,
+    kind: spec.kind,
+    ...(spec.subject ? { subject: spec.subject } : {}),
+    providerId: spec.providerId,
+    modelId: spec.modelId,
+    ...('voiceId' in spec && spec.voiceId ? { voiceId: spec.voiceId } : {}),
+    ...(spec.languageCode ? { languageCode: spec.languageCode } : {}),
+    fallbackUsed: false,
+    providerCall: true,
+    requestSha256,
+    state: 'attempted',
+    attemptedAt,
+  };
+  const updated: MiraFormalProviderReadinessJob = {
+    ...record,
+    calls: [...record.calls, call],
+    providerAttemptedCount: record.providerAttemptedCount + 1,
+    updatedAt: attemptedAt,
+  };
+  await writeAtomic(jobPath(record.requestId), updated);
+  return updated;
+}
+
+async function completeCall(
+  record: MiraFormalProviderReadinessJob,
+  state: 'passed' | 'failed' | 'ambiguous',
+  responseSha256: string,
+  now: Date,
+  safeErrorCode?: string,
+): Promise<MiraFormalProviderReadinessJob> {
+  const completedAt = now.toISOString();
+  const calls = [...record.calls];
+  calls[calls.length - 1] = {
+    ...calls[calls.length - 1],
+    state,
+    responseSha256,
+    completedAt,
+    ...(safeErrorCode ? { safeErrorCode } : {}),
+  };
+  const updated: MiraFormalProviderReadinessJob = {
+    ...record,
+    calls,
+    providerPassedCount: record.providerPassedCount + (state === 'passed' ? 1 : 0),
+    updatedAt: completedAt,
+  };
+  await writeAtomic(jobPath(record.requestId), updated);
+  return updated;
+}
+
+async function terminalizeFailure(
+  record: MiraFormalProviderReadinessJob,
+  failure: OperationalFailure,
+  now: Date,
+): Promise<MiraFormalProviderReadinessJob> {
+  const responseSha256 = digest({ outcome: failure.outcome, safeCode: failure.safeCode });
+  const withCall = await completeCall(
+    record,
+    failure.outcome,
+    responseSha256,
+    now,
+    failure.safeCode,
+  );
+  const completedAt = now.toISOString();
+  const proof = proofFor(withCall);
+  const terminal: MiraFormalProviderReadinessJob = {
+    ...withCall,
+    state: failure.outcome,
+    providerProof: proof,
+    safeErrorCode: failure.safeCode,
+    updatedAt: completedAt,
+    completedAt,
+  };
+  await writeAtomic(jobPath(record.requestId), terminal);
+  return terminal;
+}
+
+export async function executeMiraFormalProviderReadiness(
+  value: unknown,
+  dependencies: RuntimeDependencies = {},
+): Promise<{ record: MiraFormalProviderReadinessJob; created: boolean }> {
+  const input = assertMiraFormalProviderReadinessRequest(value);
+  assertMiraFormalProviderReadinessProviderReady();
+  let asset;
+  try {
+    asset = await readMiraFormalTtsAsset(input.validation.ttsRequestId);
+  } catch (error) {
+    if (error instanceof MiraFormalAudioError) {
+      throw new MiraFormalProviderReadinessError(
+        'asset_unavailable',
+        'Formal validation WAV is unavailable',
+      );
+    }
+    throw error;
+  }
+  if (
+    asset.record.state !== 'succeeded' ||
+    asset.record.classroomId !== input.upstreamClassroomId ||
+    asset.record.classroomContentSha256 !== input.classroomContentSha256 ||
+    asset.record.subject !== input.validation.subject ||
+    asset.record.sceneOrder !== input.validation.sceneOrder ||
+    asset.record.audioSha256 !== input.validation.audioSha256 ||
+    sha256(asset.bytes) !== input.validation.audioSha256
+  ) {
+    throw new MiraFormalProviderReadinessError(
+      'asset_unavailable',
+      'Formal validation WAV binding is invalid',
+    );
+  }
+
+  const now = dependencies.now?.() || new Date();
+  const claimed = await claim(input, now);
+  if (!claimed.created) return claimed;
+  let record = claimed.record;
+  const fetchImpl = dependencies.fetchImpl || fetch;
+  for (const spec of callSpecs(input.validation.subject)) {
+    const providerRequest = requestForCall(spec, input, asset.bytes);
+    record = await recordAttempt(
+      record,
+      spec,
+      digest(providerRequest.body),
+      dependencies.now?.() || new Date(),
+    );
+    let responseSha256: string;
+    try {
+      const response = await fetchJson(
+        fetchImpl,
+        providerRequest.endpoint,
+        providerRequest.apiKey,
+        providerRequest.body,
+      );
+      responseSha256 = providerResultSha256(spec, response);
+    } catch (error) {
+      const failure =
+        error instanceof OperationalFailure
+          ? error
+          : new OperationalFailure('failed', 'provider_readiness_internal_failure');
+      return {
+        record: await terminalizeFailure(record, failure, dependencies.now?.() || new Date()),
+        created: true,
+      };
+    }
+    try {
+      record = await completeCall(
+        record,
+        'passed',
+        responseSha256,
+        dependencies.now?.() || new Date(),
+      );
+    } catch {
+      // The Provider has already returned successfully. A local completion
+      // write failure makes the durable outcome unknown and can never be
+      // represented as a safe failure or redispatched automatically.
+      const failure = new OperationalFailure(
+        'ambiguous',
+        'provider_completion_persist_unknown',
+      );
+      return {
+        record: await terminalizeFailure(record, failure, dependencies.now?.() || new Date()),
+        created: true,
+      };
+    }
+  }
+  const completedAt = (dependencies.now?.() || new Date()).toISOString();
+  const proof = proofFor(record);
+  const completed: MiraFormalProviderReadinessJob = {
+    ...record,
+    state: 'auto_validated',
+    providerProof: proof,
+    updatedAt: completedAt,
+    completedAt,
+  };
+  await writeAtomic(jobPath(input.requestId), completed);
+  return { record: completed, created: true };
+}
+
+export function getMiraFormalProviderReadinessPolicy() {
+  return MIRA_FORMAL_PROVIDER_READINESS_POLICY;
+}
+
+export function authorizeMiraFormalProviderReadinessRequest(req: NextRequest): void {
+  try {
+    authorizeMiraFormalAudioRequest(req);
+  } catch (error) {
+    if (error instanceof MiraFormalAudioError) {
+      throw new MiraFormalProviderReadinessError(
+        'unauthorized',
+        'Invalid formal readiness credentials',
+      );
+    }
+    throw error;
+  }
