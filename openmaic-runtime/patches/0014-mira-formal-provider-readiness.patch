+import type { NextRequest } from 'next/server';
+import { apiError, apiSuccess } from '@/lib/server/api-response';
+import {
+  authorizeMiraFormalProviderReadinessRequest,
+  executeMiraFormalProviderReadiness,
+  MiraFormalProviderReadinessError,
+  readMiraFormalProviderReadinessJob,
+} from '@/lib/server/mira-formal-provider-readiness';
+
+export const dynamic = 'force-dynamic';
+export const maxDuration = 600;
+
+function errorResponse(error: unknown) {
+  if (error instanceof MiraFormalProviderReadinessError) {
+    if (error.code === 'unauthorized') {
+      return apiError('INVALID_CREDENTIALS', 403, 'Invalid formal readiness credentials');
+    }
+    if (error.code === 'request_conflict') {
+      return apiError('INVALID_REQUEST', 409, 'Formal readiness request conflict');
+    }
+    if (error.code === 'not_found' || error.code === 'asset_unavailable') {
+      return apiError('INVALID_REQUEST', 404, 'Formal readiness evidence is unavailable');
+    }
+    if (error.code === 'provider_unavailable') {
+      return apiError('PROVIDER_DISABLED', 503, 'Formal readiness providers are unavailable');
+    }
+    return apiError('INVALID_REQUEST', 400, 'Invalid formal readiness request');
+  }
+  return apiError('INTERNAL_ERROR', 500, 'Formal readiness request failed');
+}
+
+export async function POST(req: NextRequest) {
+  try {
+    authorizeMiraFormalProviderReadinessRequest(req);
+    const result = await executeMiraFormalProviderReadiness(await req.json());
+    return apiSuccess(
+      { ...result.record, done: result.record.state !== 'running' },
+      result.record.state === 'running' ? 202 : 200,
+    );
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function GET(req: NextRequest) {
+  try {
+    authorizeMiraFormalProviderReadinessRequest(req);
+    if ([...req.nextUrl.searchParams.keys()].join(',') !== 'requestId') {
+      return apiError('INVALID_REQUEST', 400, 'Invalid formal readiness query');
+    }
+    const record = await readMiraFormalProviderReadinessJob(
+      req.nextUrl.searchParams.get('requestId') || '',
+    );
+    if (!record) return apiError('INVALID_REQUEST', 404, 'Formal readiness job not found');
+    return apiSuccess(
+      { ...record, done: record.state !== 'running' },
+      record.state === 'running' ? 202 : 200,
+    );
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
