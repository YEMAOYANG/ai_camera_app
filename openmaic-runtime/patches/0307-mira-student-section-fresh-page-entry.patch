+export async function initialActionPlaybackPosition({
+  sectionEntry, sceneId, actions, readSessionState, loadPersistedCursor,
+}: {
+  sectionEntry?: string;
+  sceneId?: string;
+  actions: readonly Action[];
+  readSessionState: () => StoredActionResumeState | undefined;
+  loadPersistedCursor: () => Promise<{ sceneId: string; actionIndex: number } | undefined>;
+}): Promise<{ actionIndex: number; resumed: boolean }> {
+  // Section progress is authoritative per speech. A browser cursor is only a
+  // playback position and must never skip the opening of a selected page.
+  if (sectionEntry || !sceneId) return { actionIndex: 0, resumed: false };
+
+  const session = readSessionState();
+  if (session) {
+    const cursor = getActionResumeRestoreCursor(session, sceneId, actions);
+    if (cursor.position) return { actionIndex: cursor.actionIndex, resumed: true };
+  }
+  const saved = await loadPersistedCursor();
+  if (saved?.sceneId === sceneId && canJumpWithinReconstructablePrefix(actions, 0, saved.actionIndex)) {
+    return { actionIndex: saved.actionIndex, resumed: true };
+  }
+  return { actionIndex: 0, resumed: false };
+}
