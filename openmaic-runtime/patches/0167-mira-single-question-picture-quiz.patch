diff --git a/lib/mira/page-narration.ts b/lib/mira/page-narration.ts
new file mode 100644
--- /dev/null
+++ b/lib/mira/page-narration.ts
@@ -0,0 +1,50 @@
+/** Native page audio shares the classroom controls without moving the lecture cursor. */
+export type PageNarrationPhase = 'idle' | 'pending' | 'playing' | 'paused' | 'ended';
+export type PageAudioPreferences = { muted: boolean; volume: number; rate: number };
+type Controller = { ready: () => boolean; play: () => void; pause: () => void };
+type Snapshot = PageAudioPreferences & { phase: PageNarrationPhase; registered: boolean; paused: boolean };
+let snapshot: Snapshot = { muted: false, volume: 1, rate: 1, phase: 'idle', registered: false, paused: false };
+let controller: Controller | null = null;
+const listeners = new Set<() => void>();
+const publish = (patch: Partial<Snapshot>) => {
+  if (Object.entries(patch).every(([key, value]) => snapshot[key as keyof Snapshot] === value)) return;
+  snapshot = { ...snapshot, ...patch };
+  listeners.forEach(listener => listener());
+};
+export const getPageNarration = () => snapshot;
+export function subscribePageNarration(listener: () => void) {
+  listeners.add(listener);
+  return () => { listeners.delete(listener); };
+}
+export function setPageAudioPreferences(preferences: PageAudioPreferences) {
+  publish({ muted: preferences.muted, volume: Math.max(0, Math.min(1, preferences.volume)), rate: preferences.rate });
+}
+export function registerPageNarration(next: Controller) {
+  controller?.pause();
+  controller = next;
+  publish({ registered: true, phase: 'idle' });
+  return {
+    phase: (phase: PageNarrationPhase) => { if (controller === next) publish({ phase }); },
+    dispose: () => {
+      if (controller !== next) return;
+      controller = null;
+      publish({ registered: false, phase: 'idle' });
+    },
+  };
+}
+export function pausePageNarration() {
+  publish({ paused: true });
+  controller?.pause();
+}
+export function releasePageNarrationPause() { publish({ paused: false }); }
+
+/** True means the current page owns the click; do not restart the lecture opening. */
+export function togglePageNarration(): boolean {
+  if (!controller?.ready()) return false;
+  if (snapshot.phase === 'playing' || snapshot.phase === 'pending') pausePageNarration();
+  else {
+    releasePageNarrationPause();
+    controller.play();
+  }
+  return true;
+}
diff --git a/lib/mira/student-parent-pause.ts b/lib/mira/student-parent-pause.ts
new file mode 100644
--- /dev/null
+++ b/lib/mira/student-parent-pause.ts
@@ -0,0 +1,31 @@
+/** Same configured Student Web origin and fixed loopback aliases as the gateway CSP. */
+function privateHttpOrigin(url: URL): boolean {
+  if (url.protocol !== 'http:' || url.username || url.password) return false;
+  const hostname = url.hostname.toLowerCase();
+  if (hostname === 'localhost' || hostname === '[::1]') return true;
+  if (hostname.startsWith('[fc') || hostname.startsWith('[fd')) return true;
+  const octets = hostname.split('.').map(Number);
+  if (octets.length !== 4 || octets.some(part => !Number.isInteger(part) || part < 0 || part > 255)) return false;
+  return octets[0] === 10 || octets[0] === 127 || octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31
+    || octets[0] === 192 && octets[1] === 168;
+}
+
+export function studentParentOrigins(configured: string, localLan: boolean, runtimeOrigin = configured): string[] {
+  try {
+    const url = new URL(configured);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) return [];
+    const origins = new Set([url.origin]);
+    if (localLan && privateHttpOrigin(url) && privateHttpOrigin(new URL(runtimeOrigin))) {
+      for (const hostname of ['localhost', '127.0.0.1']) {
+        const alias = new URL(url); alias.hostname = hostname; origins.add(alias.origin);
+      }
+    }
+    return [...origins];
+  } catch { return []; }
+}
+
+export function isStudentParentPause(event: MessageEvent, parent: Window, self: Window, origins: readonly string[]): boolean {
+  return parent !== self && event.source === parent && origins.includes(event.origin)
+    && event.data !== null && typeof event.data === 'object'
+    && Object.keys(event.data).length === 1 && event.data.type === 'mira.textbook.pause';
+}
