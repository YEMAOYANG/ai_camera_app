+// @vitest-environment jsdom
+import { describe, expect, it, vi } from 'vitest';
+import { isStudentParentPause, studentParentOrigins } from '@/lib/mira/student-parent-pause';
+import { patchHtmlForIframe } from '@/lib/utils/iframe';
+
+describe('bounded Student Web pause channel', () => {
+  it('requires exact configured origin and immediate parent even without ancestorOrigins', () => {
+    const parent = {} as Window;
+    const origins = studentParentOrigins('https://student.example', false);
+    const event = (origin: string, source: Window = parent, data: unknown = { type: 'mira.textbook.pause' }) =>
+      ({ origin, source, data }) as MessageEvent;
+    expect(isStudentParentPause(event('https://student.example'), parent, window, origins)).toBe(true);
+    for (const origin of ['null', 'https://student.example.evil.test', 'http://student.example', 'https://other.example'])
+      expect(isStudentParentPause(event(origin), parent, window, origins)).toBe(false);
+    expect(isStudentParentPause(event('https://student.example', window), parent, window, origins)).toBe(false);
+    expect(isStudentParentPause(event('https://student.example', parent, { type: 'mira.textbook.pause', text: 'unsafe' }), parent, window, origins)).toBe(false);
+    expect(isStudentParentPause(event('https://student.example'), parent, parent, origins)).toBe(false);
+    expect(isStudentParentPause(event('https://student.example'), parent, window, [])).toBe(false);
+    expect(studentParentOrigins('http://127.0.0.1:3000', true)).toEqual(['http://127.0.0.1:3000', 'http://localhost:3000']);
+    expect(studentParentOrigins('http://127.0.0.1:3000', false)).toEqual(['http://127.0.0.1:3000']);
+    expect(studentParentOrigins('invalid', true)).toEqual([]);
+    expect(studentParentOrigins('http://192.168.228.95:3000', true, 'http://192.168.228.95:3101'))
+      .toEqual(['http://192.168.228.95:3000', 'http://localhost:3000', 'http://127.0.0.1:3000']);
+    expect(studentParentOrigins('http://192.168.228.95:3000', false, 'http://192.168.228.95:3101'))
+      .toEqual(['http://192.168.228.95:3000']);
+    expect(studentParentOrigins('https://student.example', true, 'http://127.0.0.1:3101')).toEqual(['https://student.example']);
+    expect(studentParentOrigins('http://192.168.228.95:3000', true, 'https://runtime.example')).toEqual(['http://192.168.228.95:3000']);
+  });
+
+  it('sends only a gesture intent from trusted pointer or activation keys, including repeated clicks', () => {
+    const html = patchHtmlForIframe('<html><head></head><body><button>开始</button></body></html>');
+    const shim = html.match(/<script data-mira-activity-intent>([\s\S]*?)<\/script>/)?.[1];
+    expect(shim).toBeTruthy();
+    const listeners = new Map<string, (event: unknown) => void>();
+    const postMessage = vi.fn();
+    new Function('window', 'document', shim!)(
+      { parent: { postMessage } }, { addEventListener: (type: string, callback: (event: unknown) => void) => listeners.set(type, callback) },
+    );
+    listeners.get('pointerdown')!({ type: 'pointerdown', isTrusted: false });
+    listeners.get('keydown')!({ type: 'keydown', isTrusted: true, key: 'a' });
+    expect(postMessage).not.toHaveBeenCalled();
+    listeners.get('pointerdown')!({ type: 'pointerdown', isTrusted: true });
+    listeners.get('pointerdown')!({ type: 'pointerdown', isTrusted: true });
+    listeners.get('keydown')!({ type: 'keydown', isTrusted: true, key: 'Enter' });
+    expect(postMessage.mock.calls).toEqual(Array(3).fill([{ type: 'MIRA_ACTIVITY_INTERACTION' }, '*']));
+  });
+});
