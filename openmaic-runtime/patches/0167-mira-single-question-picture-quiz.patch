+function lecture(scene: Scene) {
+  let ended = () => {};
+  const audio = { play: vi.fn(async () => true), pause: vi.fn(), stop: vi.fn(),
+    onEnded: vi.fn((callback: () => void) => { ended = callback; }), hasActiveAudio: () => false, isPlaying: () => true };
+  const transcript = vi.fn();
+  const managed = fixedQuizManagedSpeechIds(scene, true);
+  const engine = new PlaybackEngine([scene], {
+    clearEffects: vi.fn(), resetPlaybackVisualState: vi.fn(), execute: vi.fn(),
+  } as unknown as ActionEngine, audio as unknown as AudioPlayer, {
+    isSpeechManagedByPage: id => managed.has(id), onSpeechStart: transcript,
+    onModeChange: mode => {
+      setLectureSpeaking(mode === 'playing');
+      if (mode === 'idle' && engine.isExhausted()) releaseQuestionNarrationScene(scene.id);
+    },
+  });
+  return { engine, audio, transcript, finishOpening: () => ended() };
+}
