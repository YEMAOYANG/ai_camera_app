+    audioId: 'opening', audioUrl: '/api/classroom-media/lesson/audio/opening.wav' },
+  ...questions.map(q => ({ id: `speech-${q.id}`, type: 'speech', text: q.question,
+    audioId: q.id, audioUrl: `http://127.0.0.1:3100${q.questionAudioUrl}` }))];
+  return { id: 'fixed-quiz', type: 'quiz', stageId: 'lesson', order: 4,
+    content: { type: 'quiz', questions }, actions } as Scene;
