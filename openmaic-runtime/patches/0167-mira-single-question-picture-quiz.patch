diff --git a/lib/mira/fixed-quiz-narration.ts b/lib/mira/fixed-quiz-narration.ts
new file mode 100644
--- /dev/null
+++ b/lib/mira/fixed-quiz-narration.ts
@@ -0,0 +1,37 @@
+import type { Scene } from '@/lib/types/stage';
+
+function audioPath(value: unknown): string | null {
+  if (typeof value !== 'string' || !value) return null;
+  try { return new URL(value, 'http://classroom.local').pathname; } catch { return null; }
+}
+
+/** Keep the original action indices/audio intact; only transfer playback ownership.
+ * Fixed quiz pages may contain an opening followed by every question/answer.
+ * Once the first question begins, the visible-question UI owns that narration.
+ */
+export function fixedQuizManagedSpeechIds(scene: Scene, fixedTextbook: boolean): Set<string> {
+  const managed = new Set<string>();
+  if (!fixedTextbook || scene.type !== 'quiz' || scene.content.type !== 'quiz') return managed;
+  const questions = scene.content.questions;
+  const texts = new Set(questions.map(question => question.question.trim()));
+  const paths = new Set(questions.map(question => audioPath(
+    (question as unknown as Record<string, unknown>).questionAudioUrl,
+  )).filter((path): path is string => path !== null));
+  let questionStarted = false;
+  for (const action of scene.actions ?? []) {
+    if (action.type !== 'speech') continue;
+    const source = audioPath(action.audioUrl);
+    if (texts.has(action.text.trim()) || source !== null && paths.has(source)) questionStarted = true;
+    // Explanations and closing answer lines after a question must not leak early.
+    if (questionStarted) managed.add(action.id);
+  }
+  return managed;
+}
+
+/** Resolve native narration identity against this scene; never accept message text. */
+export function fixedQuizQuestionNarrationText(
+  scene: Scene | null | undefined, fixedTextbook: boolean, sceneId: string, questionId: string,
+): string | null {
+  if (!fixedTextbook || scene?.id !== sceneId || scene.type !== 'quiz' || scene.content.type !== 'quiz') return null;
+  return scene.content.questions.find(question => question.id === questionId)?.question ?? null;
+}
