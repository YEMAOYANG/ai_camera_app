--- /dev/null
+++ b/tests/quiz/question-narration-lifecycle.test.ts
@@ -0,0 +1,359 @@
+// @vitest-environment jsdom
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { QuestionNarration } from '@/components/audio/question-narration';
+import { ACTIVITY_AUDIO_EVENT, beginQuestionNarrationScene, releaseQuestionNarrationScene, setLectureSpeaking, subscribeQuestionNarration, notifyQuestionNarration } from '@/lib/mira/lecture-audio';
+import { PlaybackEngine } from '@/lib/playback/engine';
+import { fixedQuizManagedSpeechIds, fixedQuizQuestionNarrationText } from '@/lib/mira/fixed-quiz-narration';
+import type { Scene } from '@/lib/types/stage';
+import type { ActionEngine } from '@/lib/action/engine';
+import type { AudioPlayer } from '@/lib/utils/audio-player';
+import { getPageNarration, pausePageNarration, releasePageNarrationPause, setPageAudioPreferences, togglePageNarration } from '@/lib/mira/page-narration';
+import { computePlaybackView, type PlaybackRawState } from '@/lib/playback/derived-state';
+
+vi.mock('@/lib/store/settings', () => ({ useSettingsStore: { getState: () => ({ ttsProvidersConfig: {} }) } }));
+
+const players: FakeAudio[] = [];
+class FakeAudio extends EventTarget {
+  src = '';
+  preload = '';
+  paused = true;
+  currentTime = 0;
+  muted = false;
+  volume = 1;
+  playbackRate = 1;
+  ended = false;
+  play = vi.fn(async () => { this.paused = false; });
+  pause = vi.fn(() => { this.paused = true; this.dispatchEvent(new Event('pause')); });
+  removeAttribute(name: string) { if (name === 'src') this.src = ''; }
+  constructor() { super(); players.push(this); }
+}
+let root: Root | undefined;
+let host: HTMLDivElement;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+beforeEach(() => {
+  vi.useFakeTimers();
+  releasePageNarrationPause();
+  setPageAudioPreferences({ muted: false, volume: 1, rate: 1 });
+  vi.stubGlobal('Audio', FakeAudio);
+  host = document.createElement('div');
+  document.body.append(host);
+  root = createRoot(host);
+});
+afterEach(() => {
+  act(() => root?.unmount());
+  root = undefined;
+  setLectureSpeaking(false);
+  beginQuestionNarrationScene(null);
+  players.splice(0);
+  document.body.replaceChildren();
+  vi.unstubAllGlobals();
+  vi.useRealTimers();
+});
+const src = '/api/classroom-media/lesson/audio/question.wav';
+async function render(autoPlay: boolean, source = src, sceneId?: string, questionId?: string) {
+  await act(async () => root!.render(createElement(QuestionNarration, { src: source, number: 1, autoPlay, sceneId, questionId })));
+}
+async function tick() { await act(async () => { await vi.advanceTimersByTimeAsync(150); }); }
+
+describe('recorded question audio lifecycle', () => {
+  it('waits for the lecture, reads once, and pauses if the lecture resumes', async () => {
+    setLectureSpeaking(true);
+    await render(true);
+    await tick();
+    expect(players[0].play).not.toHaveBeenCalled();
+    act(() => setLectureSpeaking(false));
+    await tick();
+    expect(players[0].play).toHaveBeenCalledTimes(1);
+    act(() => setLectureSpeaking(true));
+    expect(players[0].paused).toBe(true);
+    act(() => setLectureSpeaking(false));
+    await tick();
+    expect(players[0].play).toHaveBeenCalledTimes(1);
