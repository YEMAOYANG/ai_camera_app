+/** Preserve source bytes: only quoted, literal HTML img[src] values are mutable. */
+function patchHtmlImageSources(html: string, from: string, to: string) {
+  const spans: { start: number; end: number }[] = [], errors: string[] = [];
+  const tree = parse(html, { sourceCodeLocationInfo: true, onParseError: e => errors.push(e.code) });
+  check(!errors.includes('duplicate-attribute'), 'UNSUPPORTED_DEPENDENCY');
+  const visit = (node: DefaultTreeAdapterMap['node']) => {
+    if ('tagName' in node) {
+      if (node.tagName === 'template') return;
+      const source = node.attrs.find(a => a.name === 'src');
+      if (node.tagName === 'img' && node.namespaceURI === 'http://www.w3.org/1999/xhtml' && source?.value === from) {
+        const loc = node.sourceCodeLocation?.attrs?.src;
+        check(loc, 'UNSUPPORTED_DEPENDENCY');
+        const raw = html.slice(loc!.startOffset, loc!.endOffset), match = /^src\s*=\s*(['"])([\s\S]*)\1$/i.exec(raw);
+        check(match && match[2] === from, 'UNSUPPORTED_DEPENDENCY');
+        const start = loc!.startOffset + raw.indexOf(match![1]) + 1;
+        spans.push({ start, end: start + from.length });
+      }
+    }
+    if ('childNodes' in node) node.childNodes.forEach(visit);
+  };
+  visit(tree); spans.sort((a, b) => a.start - b.start);
+  // Every occurrence must be one of those exact attributes, never script,
+  // style, comment, template, another attribute or a longer URL.
+  let cursor = 0;
+  for (const span of spans) {
+    check(span.start >= cursor && !html.slice(cursor, span.start).includes(from), 'UNSUPPORTED_DEPENDENCY');
+    cursor = span.end;
+  }
+  check(spans.length > 0 && !html.slice(cursor).includes(from), 'UNSUPPORTED_DEPENDENCY');
+  let revised = html;
+  for (const span of [...spans].reverse()) revised = revised.slice(0, span.start) + to + revised.slice(span.end);
+  return { revised, spans };
