+.root {
+  height: 100%;
+  overflow: auto;
+  background: #fbf7ed;
+  color: #344b40;
+  font-family: inherit;
+  container-type: inline-size;
+  padding: clamp(12px, 2.4%, 28px);
+}
+.root button {
+  cursor: pointer;
+  touch-action: manipulation;
+  font: inherit;
+  transition:
+    background 0.18s,
+    transform 0.18s;
+}
+.root button:disabled {
+  cursor: default;
+  opacity: 0.55;
+}
+.root button:focus-visible,
+.root summary:focus-visible {
+  outline: 3px solid #28664d;
+  outline-offset: 4px;
+}
+.header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 18px;
+}
+.header p {
+  font-size: 13px;
+  color: #68776b;
+  margin: 0 0 4px;
+}
+.header h2 {
+  font-size: clamp(22px, 3cqw, 32px);
+  font-weight: 700;
+  margin: 0;
+}
+.progress {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+}
+.progress span {
+  width: 10px;
+  height: 10px;
+  background: #e5ddc9;
+  border-radius: 50%;
+}
+.progress span[data-done='true'] {
+  background: #558461;
+}
+.progress span[data-current='true'] {
+  background: #e4b451;
+  box-shadow: 0 0 0 3px #f4e8c8;
+}
+.progress b {
+  margin-left: 7px;
+  white-space: nowrap;
+  font-size: 15px;
+}
+.playArea {
+  display: grid;
+  grid-template-columns: minmax(0, 1.75fr) minmax(245px, 1fr);
+  gap: 24px;
+  align-items: start;
+}
+.picture {
+  position: relative;
+  aspect-ratio: 2/1;
+  border-radius: 24px;
+  overflow: hidden;
+  border: 3px solid #e9dfc9;
+  align-self: center;
+  background: #e1ecdc;
+}
+.picture img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+  user-select: none;
+}
+.picture[data-success] {
+  border-color: #75a37e;
+}
+.zone {
+  position: absolute;
+  border: 2px solid transparent;
+  border-radius: 16px;
+  background: transparent;
+  min-width: 30px;
+  min-height: 30px;
+}
+.zone:hover:not(:disabled) {
+  background: #fff6cc44;
+  border-color: #c9983c;
+}
+.zone:focus-visible {
+  outline-offset: -4px !important;
+  background: #fff6cc44;
+}
+.speaker {
+  position: absolute;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 3px;
+  top: 2px;
+  left: 50%;
+  transform: translate(-50%, -70%);
+  background: #f6c861;
+  color: #463918;
+  box-shadow: 0 2px 8px #4e543129;
+  border-radius: 18px;
+  padding: 5px 8px;
+  font-size: 13px;
+  font-weight: 700;
+  white-space: nowrap;
+  pointer-events: none;
+}
+.found {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  transform: translate(-50%, -50%);
+  display: flex;
+  gap: 8px;
+  align-items: center;
+  border: 2px solid #fff;
+  background: #f7fbebf2;
+  color: #2b6b45;
+  border-radius: 30px;
+  padding: 8px 18px;
+  pointer-events: none;
+  animation: appear 0.25s ease-out;
+  font-weight: 700;
+}
+.task {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 12px;
+}
+.task h3 {
+  font-size: clamp(20px, 2.6cqw, 28px);
+  font-weight: 700;
+  line-height: 1.45;
+  margin: 0;
+}
+.context {
+  font-size: 15px;
+  line-height: 1.6;
+  margin: 0;
+  color: #667457;
+}
+.listen,
+.secondary {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  min-height: 48px;
+  border-radius: 24px;
+  padding: 10px 18px;
+  background: #f5e7bd;
+  border: 1px solid #e8d391;
+}
+.listen:hover {
+  background: #eddaa3;
+}
+.wordTray {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.wordTray p {
+  font-size: 14px;
+  color: #758170;
+  margin: 0;
+  max-width: 85px;
+}
+.word {
+  display: grid;
+  place-items: center;
+  width: 84px;
+  height: 84px;
+  font-size: 52px !important;
+  font-family: serif !important;
+  background: #fffef6;
+  border: 2px solid #cdbb8d;
+  border-bottom-width: 6px;
+  border-radius: 18px;
+  touch-action: none !important;
+  user-select: none;
+}
+.word:not(:disabled):hover {
+  transform: translateY(-2px);
+}
+.options {
+  display: flex;
+  gap: 10px;
+  width: 100%;
+}
+.options button {
+  min-width: 60px;
+  min-height: 76px;
+  flex: 1;
+  border: 2px solid #e2d6b9;
+  background: #fffdf5;
+  border-radius: 16px;
+  font-size: 40px;
+}
+.options button[aria-checked='true'] {
+  border-color: #528261;
+  background: #e6f0df;
+  box-shadow: 0 3px 0 #528261;
+}
+.help {
+  display: flex;
+  gap: 7px;
+  flex-wrap: wrap;
+}
+.help button,
+.feedback button {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 48px;
+  padding: 8px 10px;
+  font-size: 14px;
+  background: #f2eddf;
+  border: 1px solid #e3dac6;
+  border-radius: 12px;
+}
+.hint {
+  margin: 0;
+  font-size: 15px;
+  line-height: 1.6;
+  padding: 10px 12px;
+  background: #fff1c8;
+  border-radius: 12px;
+}
+.feedback {
+  width: 100%;
+  border-left: 4px solid #d3ac65;
+  padding: 10px 13px;
+  background: #f5edd9;
+  border-radius: 4px 12px 12px 4px;
+  animation: appear 0.2s ease-out;
+}
+.feedback[data-correct='true'] {
+  border-color: #74a077;
+  background: #edf3e5;
+}
+.feedback p {
+  font-size: 15px;
+  line-height: 1.6;
+  margin: 4px 0;
+}
+.primary {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  min-height: 52px;
+  background: #496d51;
+  color: #fff;
+  border: 0;
+  border-radius: 26px;
+  padding: 12px 25px;
+  font-weight: 600 !important;
+}
+.primary:hover:not(:disabled) {
+  background: #365b3e;
+}
+.footer {
+  font-size: 13px;
+  color: #697467;
+  margin-top: 18px;
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: 10px;
+}
+.footer p {
+  margin: 0;
+}
+.footer [role='alert'] {
+  color: #964a34;
+}
+.footer button {
+  min-height: 48px;
+  text-decoration: underline;
+  margin-left: 10px;
+}
+.loading {
+  display: flex;
+  min-height: 260px;
+  align-items: center;
+  justify-content: center;
+  gap: 20px;
+}
+.done {
+  display: flex;
+  align-items: center;
+  flex-direction: column;
+  text-align: center;
+  gap: 12px;
+  padding: 18px 10px;
+}
+.done h3 {
+  font-size: 26px;
+  font-weight: 700;
+  margin: 4px 0;
+}
+.done p {
+  margin: 0;
+  line-height: 1.65;
+}
+.badge {
+  display: grid;
+  place-items: center;
+  width: 86px;
+  height: 86px;
+  background: #f5d887;
+  border: 6px solid #f9e9b9;
+  border-radius: 50%;
+  color: #8b6726;
+}
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 12px;
+  margin-top: 8px;
+}
+.evidence {
+  text-align: left;
+  max-width: 480px;
+  padding: 8px 15px;
+  background: #f3eddf;
+  border-radius: 14px;
+  font-size: 14px;
+}
+.evidence summary {
+  min-height: 48px;
+  display: flex;
+  align-items: center;
+  cursor: pointer;
+  font-weight: 600;
+}
+.evidence p {
+  margin: 5px 0;
+}
+.dragWord {
+  position: fixed;
+  z-index: 10000;
+  transform: translate(-50%, -50%);
+  pointer-events: none;
+  display: grid;
+  place-items: center;
+  width: 70px;
+  height: 70px;
+  background: #fff8db;
+  color: #344b40;
+  border: 2px solid #d4b469;
+  border-radius: 16px;
+  font-size: 44px;
+  box-shadow: 0 8px 20px #44543c30;
+}
+@keyframes appear {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+@container (max-width:700px) {
+  .playArea {
+    grid-template-columns: 1fr;
+    gap: 18px;
+  }
+  .task {
+    align-items: stretch;
+  }
+  .task h3 {
+    text-align: center;
+  }
+  .task .listen {
+    align-self: center;
+  }
+  .wordTray {
+    justify-content: center;
+  }
+  .help {
+    justify-content: center;
+  }
+  .picture {
+    border-radius: 18px;
+  }
+  .speaker {
+    font-size: 11px;
+    padding: 3px 5px;
+  }
+  .progress span {
+    width: 7px;
+    height: 7px;
+  }
+  .header {
+    gap: 10px;
+  }
+  .done h3 {
+    font-size: 22px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .root * {
+    animation: none !important;
+    transition: none !important;
+  }
+}
