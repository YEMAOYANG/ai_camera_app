diff --git a/components/scene-renderers/textbook-play.tsx b/components/scene-renderers/textbook-play.tsx
new file mode 100644
--- /dev/null
+++ b/components/scene-renderers/textbook-play.tsx
@@ -0,0 +1,502 @@
+'use client';
+
+import { useCallback, useEffect, useRef, useState, type PointerEvent } from 'react';
+import { ArrowRight, Check, Hand, Lightbulb, Mic, RotateCcw, Star, Volume2 } from 'lucide-react';
+import { useStageStore } from '@/lib/store';
+import { useMiraStudentRuntimeEvents } from '@/lib/contexts/mira-student-runtime-context';
+import styles from './textbook-play.module.css';
+
+type Section = 'games' | 'challenge';
+type View = {
+  phase: 'hunt' | 'roles' | 'quiz' | 'repair' | 'transfer' | 'done';
+  index: number;
+  total?: number;
+  done: boolean;
+  replaying: boolean;
+  prompt?: string;
+  word?: string;
+  speaker?: string;
+  options?: { value: string; label: string }[];
+  audio?: string[];
+  hintAudio?: string[];
+  hintUsed: boolean;
+  adultHelp: boolean;
+  hint?: string;
+  feedback?: { correct: boolean; canNext: boolean; explanation: string };
+};
+type Snapshot = {
+  ok: true;
+  activityId: string;
+  version: number;
+  image: string;
+  games: View;
+  challenge: View;
+  evidence: {
+    answered: number;
+    independent: number;
+    hints: number;
+    adultHelp: number;
+    transferAnswered: number;
+    transferIndependent: number;
+    practiceSkills: string[];
+  };
+};
+const zones = [
+  { id: 'sky', name: '天空', x: 1, y: 1, w: 98, h: 23 },
+  { id: 'earth', name: '地面', x: 1, y: 87, w: 98, h: 12 },
+  { id: 'coral', name: '红衣女孩', x: 30, y: 29, w: 14, h: 57 },
+  { id: 'teal', name: '蓝衣男孩', x: 47, y: 25, w: 14, h: 61 },
+  { id: 'yellow', name: '黄衣男孩', x: 71, y: 35, w: 14, h: 47 },
+];
+const titles: Record<View['phase'], string> = {
+  hunt: '字宝宝，回家啦',
+  roles: '换个人来说',
+  quiz: '自己试一试',
+  repair: '再认一认',
+  transfer: '换种玩法，找一找',
+  done: '这一关完成啦',
+};
+
+/** A real OpenMAIC scene. The Python classroom owns questions, grading and resume. */
+export function TextbookPlay({ section, sceneId }: { section: Section; sceneId: string }) {
+  const [snapshot, setSnapshot] = useState<Snapshot | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [soundError, setSoundError] = useState('');
+  const [playing, setPlaying] = useState(false);
+  const [chosen, setChosen] = useState('');
+  const [drag, setDrag] = useState<{ x: number; y: number } | null>(null);
+  const picture = useRef<HTMLDivElement>(null);
+  const surface = useRef<HTMLElement>(null);
+  const dragOrigin = useRef<{ x: number; y: number } | null>(null);
+  const player = useRef<HTMLAudioElement | null>(null);
+  const soundRun = useRef(0);
+  const alive = useRef(true);
+  const inFlight = useRef(false);
+  const events = useMiraStudentRuntimeEvents();
+  const view = snapshot?.[section];
+  useEffect(() => {
+    surface.current?.scrollTo({ top: 0, behavior: 'instant' });
+  }, [view?.phase, view?.index]);
+
+  const silence = useCallback(() => {
+    soundRun.current += 1;
+    if (player.current) {
+      player.current.pause();
+      player.current.removeAttribute('src');
+    }
+    player.current = null;
+    if (alive.current) setPlaying(false);
+  }, []);
+
+  const load = useCallback(async (signal?: AbortSignal) => {
+    const response = await fetch('/mira/textbook-play', { cache: 'no-store', signal });
+    const payload = await response.json();
+    if (!response.ok || !payload.ok)
+      throw new Error(payload.message || '互动还没有打开，请再试一次。');
+    if (alive.current) setSnapshot(payload);
+  }, []);
+
+  useEffect(() => {
+    alive.current = true;
+    const controller = new AbortController();
+    void load(controller.signal).catch((caught: unknown) => {
+      if (!controller.signal.aborted)
+        setError(caught instanceof Error ? caught.message : '请重新打开互动');
+    });
+    const hidden = () => {
+      if (document.hidden) silence();
+    };
+    document.addEventListener('visibilitychange', hidden);
+    return () => {
+      alive.current = false;
+      controller.abort();
+      silence();
+      document.removeEventListener('visibilitychange', hidden);
+    };
+  }, [load, silence]);
+
+  function listen(urls = view?.audio || []) {
+    silence();
+    setSoundError('');
+    window.dispatchEvent(new Event('mira:textbook-play-audio'));
+    const run = soundRun.current;
+    const queue = [...urls];
+    const next = () => {
+      if (!alive.current || run !== soundRun.current) return;
+      const src = queue.shift();
+      if (!src) {
+        setPlaying(false);
+        return;
+      }
+      if (
+        !/^\/api\/classroom-media\/[A-Za-z0-9_-]+\/audio\/[A-Za-z0-9_-]+\.(wav|mp3|ogg)$/.test(src)
+      )
+        return;
+      const audio = new Audio(src);
+      player.current = audio;
+      const fail = () => {
+        if (alive.current && run === soundRun.current) {
+          setPlaying(false);
+          setSoundError('声音暂时没放出来，点喇叭再听一次。');
+        }
+      };
+      audio.onended = next;
+      audio.onerror = fail;
+      setPlaying(true);
+      void audio.play().catch(fail);
+    };
+    next();
+  }
+
+  async function act(action: string, choice?: string) {
+    if (!snapshot || inFlight.current) return;
+    inFlight.current = true;
+    setBusy(true);
+    setError('');
+    silence();
+    try {
+      const response = await fetch('/mira/textbook-play', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          section,
+          version: snapshot.version,
+          action,
+          ...(choice ? { choice } : {}),
+        }),
+      });
+      const payload = await response.json();
+      if (!response.ok || !payload.ok) {
+        if (response.status === 409) await load();
+        throw new Error(payload.message || '这一步还没有保存，请重试。');
+      }
+      if (!alive.current) return;
+      setSnapshot(payload);
+      setChosen('');
+      if (action === 'hint') listen(payload[section].hintAudio);
+      if (payload.challenge.done && events) {
+        const scenes = [...useStageStore.getState().scenes].sort((a, b) => a.order - b.order);
+        const last = scenes.at(-1);
+        if (last)
+          await events.completeWhenReady({ sceneId: last.id, sceneIndex: scenes.length - 1 });
+      }
+    } catch (caught) {
+      // A disconnected response can still have committed. Re-read; never blindly repeat a score.
+      if (alive.current) {
+        await load().catch(() => undefined);
+        setError(caught instanceof Error ? caught.message : '连接断开了，恢复后点“重新连接”。');
+      }
+    } finally {
+      inFlight.current = false;
+      if (alive.current) setBusy(false);
+    }
+  }
+
+  function nextScene() {
+    silence();
+    const store = useStageStore.getState();
+    const scenes = [...store.scenes].sort((a, b) => a.order - b.order);
+    const index = scenes.findIndex((s) => s.id === sceneId);
+    if (scenes[index + 1]) store.setCurrentSceneId(scenes[index + 1].id);
+  }
+
+  function drop(event: PointerEvent<HTMLButtonElement>) {
+    const origin = dragOrigin.current;
+    dragOrigin.current = null;
+    setDrag(null);
+    if (!origin || Math.hypot(event.clientX - origin.x, event.clientY - origin.y) < 8) return;
+    const bounds = picture.current?.getBoundingClientRect();
+    if (!bounds) return;
+    const x = ((event.clientX - bounds.left) / bounds.width) * 100;
+    const y = ((event.clientY - bounds.top) / bounds.height) * 100;
+    const target = zones.find((z) => x >= z.x && x <= z.x + z.w && y >= z.y && y <= z.y + z.h);
+    if (target) void act('answer', target.id);
+  }
+
+  const frozen = busy || Boolean(view?.feedback?.canNext);
+  return (
+    <section
+      ref={surface}
+      className={styles.root}
+      aria-label={section === 'games' ? '天地人互动花园' : '天地人自主练习'}
+    >
+      {!view || !snapshot ? (
+        <div className={styles.loading} role="status">
+          {error || '正在打开字宝宝花园…'}
+          {error && (
+            <button
+              className={styles.primary}
+              onClick={() => void load().catch(() => setError('请重新进入课堂'))}
+            >
+              重新连接
+            </button>
+          )}
+        </div>
+      ) : (
+        <>
+          <header className={styles.header}>
+            <div>
+              <p>
+                {section === 'games' ? '动手玩 · 认汉字' : '我会自己学'}
+                {view.replaying ? ' · 再玩一次' : ''}
+              </p>
+              <h2>{titles[view.phase]}</h2>
+            </div>
+            {!view.done && (
+              <div
+                className={styles.progress}
+                aria-label={`第 ${view.index + 1} 题，共 ${view.total} 题`}
+              >
+                {Array.from({ length: view.total || 0 }, (_, index) => (
+                  <span
+                    key={index}
+                    data-done={index < view.index}
+                    data-current={index === view.index}
+                  />
+                ))}
+                <b>
+                  {view.index + 1} / {view.total}
+                </b>
+              </div>
+            )}
+          </header>
+          {view.done ? (
+            <div className={styles.done}>
+              <div className={styles.badge}>
+                <Star size={44} aria-hidden />
+              </div>
+              <h3>
+                {section === 'games' ? '找到字宝宝，也会换角色啦！' : '你认真想，也动手试了！'}
+              </h3>
+              {section === 'challenge' && (
+                <>
+                  <p>
+                    第一次自己答对 <strong>{snapshot.evidence.independent} / 6</strong> 题
+                  </p>
+                  <p>
+                    换种玩法，独立找到 <strong>{snapshot.evidence.transferIndependent} / 6</strong>{' '}
+                    题
+                  </p>
+                  <details className={styles.evidence}>
+                    <summary>给家长的学习记录</summary>
+                    <p>
+                      选择题提示 {snapshot.evidence.hints} 题，大人帮助{' '}
+                      {snapshot.evidence.adultHelp} 题。
+                    </p>
+                    <p>
+                      {snapshot.evidence.practiceSkills.length
+                        ? `课内已安排再练：${snapshot.evidence.practiceSkills.join('、')}。`
+                        : '本次选择题均独立答对。'}
+                    </p>
+                    <p>这是看图和选择练习记录，尚未评价朗读、书写或长期掌握。</p>
+                  </details>
+                </>
+              )}
+              <div className={styles.actions}>
+                {section === 'games' && (
+                  <button
+                    disabled={busy}
+                    onClick={() => void act('replay')}
+                    className={styles.secondary}
+                  >
+                    <RotateCcw size={19} />
+                    再玩一次
+                  </button>
+                )}
+                <button onClick={nextScene} className={styles.primary}>
+                  继续上课
+                  <ArrowRight size={20} />
+                </button>
+              </div>
+            </div>
+          ) : (
+            <div className={styles.playArea}>
+              <div
+                ref={picture}
+                className={styles.picture}
+                data-success={view.feedback?.correct || undefined}
+              >
+                {/* Native authored lesson media is authorized by the classroom gateway. */}
+                <img
+                  src={snapshot.image}
+                  alt="花园里，红衣女孩和蓝衣男孩面对面，黄衣男孩在旁边挥手。上方是天空，脚下是小路。"
+                  draggable={false}
+                />
+                {!view.options &&
+                  zones
+                    .filter((z) => !view.speaker || !['sky', 'earth'].includes(z.id))
+                    .map((zone) => (
+                      <button
+                        key={zone.id}
+                        type="button"
+                        className={styles.zone}
+                        aria-label={`选择${zone.name}`}
+                        disabled={frozen}
+                        style={{
+                          left: `${zone.x}%`,
+                          top: `${zone.y}%`,
+                          width: `${zone.w}%`,
+                          height: `${zone.h}%`,
+                        }}
+                        onClick={() => void act('answer', zone.id)}
+                      >
+                        {view.speaker === zone.id && (
+                          <span className={styles.speaker}>
+                            <Mic size={18} aria-hidden />
+                            我在说
+                          </span>
+                        )}
+                      </button>
+                    ))}
+                {view.feedback?.correct && (
+                  <div className={styles.found} aria-hidden>
+                    <Check size={32} />
+                    找到了
+                  </div>
+                )}
+              </div>
+              <div className={styles.task}>
+                {view.speaker && (
+                  <p className={styles.context}>
+                    {view.speaker === 'teal' ? '蓝衣男孩' : '红衣女孩'}在说话，和
+                    {view.speaker === 'teal' ? '红衣女孩' : '蓝衣男孩'}聊天。
+                  </p>
+                )}
+                <h3>{view.prompt}</h3>
+                <button
+                  className={styles.listen}
+                  disabled={busy}
+                  onClick={() => (playing ? silence() : listen())}
+                >
+                  <Volume2 size={21} />
+                  {playing ? '暂停声音' : '听一听'}
+                </button>
+                {view.options ? (
+                  <div className={styles.options} role="radiogroup" aria-label="选择一个字">
+                    {view.options.map((option) => (
+                      <button
+                        key={option.value}
+                        role="radio"
+                        aria-checked={chosen === option.value}
+                        disabled={frozen}
+                        onClick={() => setChosen(option.value)}
+                      >
+                        {option.label}
+                      </button>
+                    ))}
+                  </div>
+                ) : (
+                  <div className={styles.wordTray}>
+                    <button
+                      className={styles.word}
+                      aria-label={`拖动${view.word}字，也可以直接点图`}
+                      disabled={frozen}
+                      onPointerDown={(event) => {
+                        dragOrigin.current = { x: event.clientX, y: event.clientY };
+                        event.currentTarget.setPointerCapture(event.pointerId);
+                      }}
+                      onPointerMove={(event) => {
+                        if (dragOrigin.current) setDrag({ x: event.clientX, y: event.clientY });
+                      }}
+                      onPointerUp={drop}
+                      onPointerCancel={() => {
+                        dragOrigin.current = null;
+                        setDrag(null);
+                      }}
+                    >
+                      {view.word}
+                    </button>
+                    <p>拖到图里，或直接点图</p>
+                  </div>
+                )}
+                <div className={styles.help}>
+                  <button disabled={frozen || view.hintUsed} onClick={() => void act('hint')}>
+                    <Lightbulb size={19} />
+                    给我提示
+                  </button>
+                  <button disabled={frozen || view.adultHelp} onClick={() => void act('adult')}>
+                    <Hand size={18} />
+                    请大人帮了忙
+                  </button>
+                </div>
+                {view.hint && (
+                  <p className={styles.hint} role="status">
+                    {view.hint}
+                  </p>
+                )}
+                {view.adultHelp && <p className={styles.hint}>已记为一起完成，慢慢来。</p>}
+                {view.feedback && (
+                  <div
+                    className={styles.feedback}
+                    data-correct={view.feedback.correct}
+                    role="status"
+                  >
+                    <strong>
+                      {view.feedback.correct
+                        ? '找到了！'
+                        : view.feedback.canNext
+                          ? '再听一遍讲解，我们继续试。'
+                          : '再看看，换个地方试一试。'}
+                    </strong>
+                    <p>{view.feedback.explanation}</p>
+                    {!!view.hintAudio?.length && (
+                      <button onClick={() => listen(view.hintAudio)}>
+                        <Volume2 size={18} />
+                        听讲解
+                      </button>
+                    )}
+                  </div>
+                )}
+                {view.feedback?.canNext ? (
+                  <button
+                    className={styles.primary}
+                    disabled={busy}
+                    onClick={() => void act('next')}
+                  >
+                    下一步
+                    <ArrowRight size={20} />
+                  </button>
+                ) : (
+                  view.options && (
+                    <button
+                      className={styles.primary}
+                      disabled={busy || !chosen}
+                      onClick={() => void act('answer', chosen)}
+                    >
+                      选好了
+                      <Check size={20} />
+                    </button>
+                  )
+                )}
+              </div>
+            </div>
+          )}
+          {drag && (
+            <div className={styles.dragWord} style={{ left: drag.x, top: drag.y }} aria-hidden>
+              {view.word}
+            </div>
+          )}
+          <footer className={styles.footer}>
+            <p role="status">{busy ? '正在保存…' : '学到哪里，课堂都会记住'}</p>
+            {soundError && <p role="status">{soundError}</p>}
+            {error && (
+              <p role="alert">
+                {error}
+                <button
+                  onClick={() =>
+                    void load()
+                      .then(() => setError(''))
+                      .catch(() => setError('连接还未恢复，请稍后重试'))
+                  }
+                >
+                  重新连接
+                </button>
+              </p>
+            )}
+          </footer>
+        </>
+      )}
+    </section>
+  );
+}
