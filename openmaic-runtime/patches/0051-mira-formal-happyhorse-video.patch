+/** Executes only in the disposable, owned preview. No narration or student events. */
+async function inspectVideoPlayback(target: Page | Frame) {
+  return target.evaluate(async () => {
+    const videos = Array.from(document.querySelectorAll('video'));
+    const results: Array<{ id: string; passed: boolean; message: string }> = [];
+    if (videos.length > 4)
+      return [{ id: 'video-playback', passed: false, message: 'Too many videos in one scene.' }];
+    for (const [index, video] of videos.entries()) {
+      const until = (condition: () => boolean) =>
+        new Promise<void>((resolve, reject) => {
+          const start = performance.now();
+          const poll = () => {
+            if (video.error) return reject(new Error(`Media decode error ${video.error.code}`));
+            if (condition()) return resolve();
+            if (performance.now() - start > 4000)
+              return reject(new Error('Media playback did not advance.'));
+            setTimeout(poll, 40);
+          };
+          poll();
+        });
+      try {
+        video.muted = true;
+        video.loop = false;
+        video.preload = 'auto';
+        await until(
+          () => video.readyState >= 2 && video.videoWidth > 0 && Number.isFinite(video.duration),
+        );
+        for (let pass = 0; pass < 2; pass++) {
+          video.pause();
+          video.currentTime = 0;
+          await Promise.all([video.play(), until(() => video.currentTime >= 0.2)]);
+        }
+        results.push({
+          id: `video-playback-${index}`,
+          passed: true,
+          message: `Decoded ${video.videoWidth}x${video.videoHeight}, ${video.duration.toFixed(2)}s; playback and replay advanced.`,
+        });
+      } catch (error) {
+        results.push({
+          id: `video-playback-${index}`,
+          passed: false,
+          message: error instanceof Error ? error.message : 'Video playback failed.',
+        });
+      } finally {
+        video.pause();
+      }
+    }
+    return results;
   });
 }
 
