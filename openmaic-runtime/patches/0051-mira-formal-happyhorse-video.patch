new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-video.ts
@@ -0,0 +1,401 @@
+import { createHash } from 'node:crypto';
+import { execFile } from 'node:child_process';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { promisify } from 'node:util';
+import { parse, type DefaultTreeAdapterTypes } from 'parse5';
+import { enumerateAssetManifest } from '@openmaic/dsl';
+import type { AgentTool } from '@earendil-works/pi-agent-core';
+import type { Scene } from '@/lib/types/stage';
+import { VIDEO_PROVIDERS } from '@/lib/media/video-providers';
+import { CLASSROOMS_DIR } from './classroom-storage';
+import { MIRA_FORMAL_VIDEO_POLICY } from './mira-formal-generation-policy';
+import {
+  getServerVideoProviders,
+  isServerProviderDisabled,
+  resolveVideoApiKey,
+  resolveVideoBaseUrl,
+  resolveVideoModel,
+} from './provider-config';
+
+export const MIRA_FORMAL_VIDEO_EVENT = 'mira_formal_video_generated';
+const MAX_BYTES = 200 * 1024 * 1024;
+const SAFE_ID = /^[A-Za-z0-9_-]{1,255}$/;
+const runFile = promisify(execFile);
+
+export interface MiraFormalVideoTrace {
+  schemaVersion: 'mira.openmaic.formal-video-trace.v1';
+  sessionId: string;
+  classroomId: string;
+  toolCallId: string;
+  src: string;
+  providerId: 'happyhorse';
+  modelId: 'happyhorse-1.0-t2v';
+}
+
+export interface MiraFormalVideoAsset {
+  src: string;
+  sha256: string;
+  mimeType: 'video/mp4';
+  byteSize: number;
+  width: number;
+  height: number;
+  durationMs: number;
+  sceneIds: string[];
+}
+
+export interface MiraFormalVideoReceipt {
+  schemaVersion: 'mira.openmaic.formal-video-receipt.v1';
+  status: 'succeeded';
+  runtimeRequestId: string;
+  buildItemId: string;
+  classroomId: string;
+  sessionId: string;
+  policyId: typeof MIRA_FORMAL_VIDEO_POLICY.policyId;
+  providerId: typeof MIRA_FORMAL_VIDEO_POLICY.providerId;
+  modelId: typeof MIRA_FORMAL_VIDEO_POLICY.modelId;
+  videoCount: number;
+  assets: MiraFormalVideoAsset[];
+  receiptSha256: string;
+}
+
+type Attempt = {
+  schemaVersion: 'mira.openmaic.formal-video-attempt.v1';
+  sessionId: string;
+  classroomId: string;
+  toolCallId: string;
+  status: 'reserved' | 'succeeded' | 'failed';
+  src?: string;
+};
+
+function fail(code: string): never {
+  throw new Error(`FORMAL_VIDEO_${code}`);
+}
+function sha(bytes: string | Buffer): string {
+  return createHash('sha256').update(bytes).digest('hex');
+}
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object')
+    return Object.fromEntries(
+      Object.entries(value)
+        .sort(([a], [b]) => a.localeCompare(b))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  return value;
+}
+function attemptPath(sessionId: string, directory?: string): string {
+  if (!SAFE_ID.test(sessionId)) fail('SESSION_INVALID');
+  return path.resolve(
+    directory ?? path.join(CLASSROOMS_DIR, '..', 'formal-video-attempts'),
+    `${sessionId}.json`,
+  );
+}
+async function readAttempt(sessionId: string, directory?: string): Promise<Attempt | null> {
+  try {
+    return JSON.parse(await fs.readFile(attemptPath(sessionId, directory), 'utf8')) as Attempt;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+}
+async function settleAttempt(file: string, attempt: Attempt): Promise<void> {
+  const temp = `${file}.${process.pid}.tmp`;
+  await fs.writeFile(temp, JSON.stringify(attempt), { mode: 0o600 });
+  await fs.rename(temp, file);
+}
+
+/** Configuration check only; the existing provider adapter remains authoritative. */
+export function assertMiraFormalVideoProviderReady(): void {
+  const policy = MIRA_FORMAL_VIDEO_POLICY;
+  const providers = getServerVideoProviders();
+  const configured = providers[policy.providerId];
+  // generate_video chooses the first configured, enabled, credentialed provider.
+  // DEFAULT_VIDEO_PROVIDER alone does not control that official selector.
+  const selected = Object.entries(providers).find(([id, info]) => {
+    if (info.disabled || !(id in VIDEO_PROVIDERS)) return false;
+    const provider = VIDEO_PROVIDERS[id as keyof typeof VIDEO_PROVIDERS];
+    return !provider.requiresApiKey || !!resolveVideoApiKey(id);
+  })?.[0];
+  if (
+    !configured ||
+    selected !== policy.providerId ||
+    configured.disabled ||
+    isServerProviderDisabled('video', policy.providerId) ||
+    process.env.DEFAULT_VIDEO_PROVIDER !== policy.providerId ||
+    resolveVideoModel(policy.providerId) !== policy.modelId ||
+    !resolveVideoApiKey(policy.providerId).trim()
+  )
+    fail('PROVIDER_NOT_READY');
+  const base = resolveVideoBaseUrl(policy.providerId);
+  if (base !== 'https://dashscope.aliyuncs.com' && base !== 'https://dashscope.aliyuncs.com/')
+    fail('PROVIDER_ORIGIN_INVALID');
+}
+
+/** Reserve the one paid attempt durably before provider I/O, including failures/crash resumes. */
+export function withMiraFormalVideoTrace(
+  tool: AgentTool<never, never>,
+  sessionId: string,
+  record: (trace: MiraFormalVideoTrace) => Promise<void>,
+  options: {
+    ownsStage: (stageId: string) => Promise<boolean>;
+    attemptsDir?: string;
+    assertReady?: () => void;
+  },
+): AgentTool<never, never> {
+  if (tool.name !== 'generate_video') return tool;
+  return {
+    ...tool,
+    async execute(...args: Parameters<typeof tool.execute>) {
+      const params = args[1] as unknown as {
+        stageId?: unknown;
+        prompt?: unknown;
+        durationSec?: unknown;
+        resolution?: unknown;
+        aspectRatio?: unknown;
+      };
+      if (
+        typeof params.stageId !== 'string' ||
+        !SAFE_ID.test(params.stageId) ||
+        typeof params.prompt !== 'string' ||
+        !params.prompt.trim() ||
+        (params.durationSec !== undefined && params.durationSec !== 5) ||
+        (params.resolution !== undefined && params.resolution !== '720p') ||
+        (params.aspectRatio !== undefined && params.aspectRatio !== '16:9')
+      )
+        fail('REQUEST_POLICY_INVALID');
+      if (!(await options.ownsStage(params.stageId))) fail('STAGE_NOT_OWNED');
+      if (args[2]?.aborted) fail('ABORTED');
+      (options.assertReady ?? assertMiraFormalVideoProviderReady)();
+      const file = attemptPath(sessionId, options.attemptsDir);
+      await fs.mkdir(path.dirname(file), { recursive: true });
+      const attempt: Attempt = {
+        schemaVersion: 'mira.openmaic.formal-video-attempt.v1',
+        sessionId,
+        classroomId: params.stageId,
+        toolCallId: args[0],
+        status: 'reserved',
+      };
+      let handle;
+      try {
+        handle = await fs.open(file, 'wx', 0o600);
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code === 'EEXIST') fail('ATTEMPT_LIMIT');
+        throw error;
+      }
+      try {
+        await handle.writeFile(JSON.stringify(attempt));
+        await handle.sync();
+      } finally {
+        await handle.close();
+      }
+      try {
+        const fixed = { ...params, durationSec: 5, resolution: '720p', aspectRatio: '16:9' };
+        const result = await tool.execute(args[0], fixed as never, args[2], args[3]);
+        const value = result as unknown as {
+          isError?: boolean;
+          details?: { src?: unknown; mime?: unknown; durationSec?: unknown };
+        };
+        const src = value.details?.src;
+        if (
+          value.isError ||
+          typeof src !== 'string' ||
+          value.details?.mime !== 'video/mp4' ||
+          typeof value.details.durationSec !== 'number' ||
+          value.details.durationSec < 4.9 ||
+          value.details.durationSec > 5.1 ||
+          !sourceFilename(src, params.stageId)
+        )
+          fail('TOOL_RESULT_INVALID');
+        const trace: MiraFormalVideoTrace = {
+          schemaVersion: 'mira.openmaic.formal-video-trace.v1',
+          sessionId,
+          classroomId: params.stageId,
+          toolCallId: args[0],
+          src,
+          providerId: MIRA_FORMAL_VIDEO_POLICY.providerId,
+          modelId: MIRA_FORMAL_VIDEO_POLICY.modelId,
+        };
+        await record(trace);
+        await settleAttempt(file, { ...attempt, status: 'succeeded', src });
+        return result;
+      } catch (error) {
+        await settleAttempt(file, { ...attempt, status: 'failed' }).catch(() => {});
+        throw error;
+      }
+    },
+  };
+}
+
+function sourceFilename(src: string, classroomId: string): RegExpExecArray | null {
+  const prefix = `/api/classroom-media/${classroomId}/media/`;
+  return src.startsWith(prefix)
+    ? /^generated-([a-f0-9]{64})\.mp4$/u.exec(src.slice(prefix.length))
+    : null;
+}
+
+/** Video slots only: audio/source and image/poster references keep their own contracts. */
+export function formalSceneVideoReferences(scene: Scene): string[] {
+  const refs = new Set(
+    enumerateAssetManifest({ stage: {}, scenes: [scene] })
+      .entries.filter((entry) => entry.kind === 'video')
+      .map((entry) => entry.ref),
+  );
+  const content = scene.content as unknown as { html?: unknown };
+  if (typeof content.html === 'string') {
+    const visit = (node: DefaultTreeAdapterTypes.Node, inVideo = false): void => {
+      if ('tagName' in node) {
+        const attrs = Object.fromEntries(node.attrs.map((attr) => [attr.name, attr.value]));
+        if ((node.tagName === 'video' || (node.tagName === 'source' && inVideo)) && attrs.src)
+          refs.add(attrs.src);
+        if (node.tagName === 'audio') inVideo = false;
+        if (node.tagName === 'video') inVideo = true;
+        if (node.tagName === 'template' && 'content' in node) visit(node.content, inVideo);
+      }
+      if ('childNodes' in node) for (const child of node.childNodes) visit(child, inVideo);
+    };
+    visit(parse(content.html));
+  }
+  return [...refs];
+}
+
+export async function probeMiraFormalVideo(
+  file: string,
+): Promise<{ width: number; height: number; durationMs: number }> {
+  const { stdout } = await runFile(
+    'ffprobe',
+    [
+      '-v',
+      'error',
+      '-protocol_whitelist',
+      'file,pipe',
+      '-show_entries',
+      'stream=codec_type,width,height:format=duration,format_name',
+      '-of',
+      'json',
+      file,
+    ],
+    { timeout: 10000, maxBuffer: 1024 * 1024, windowsHide: true },
+  );
+  const result = JSON.parse(stdout) as {
+    streams?: Array<{ codec_type?: string; width?: number; height?: number }>;
+    format?: { duration?: string; format_name?: string };
+  };
+  const videos = result.streams?.filter((stream) => stream.codec_type === 'video') ?? [];
+  if (videos.length !== 1 || !result.format?.format_name?.split(',').includes('mp4'))
+    fail('BYTES_INVALID');
+  return {
+    width: videos[0]!.width ?? 0,
+    height: videos[0]!.height ?? 0,
+    durationMs: Math.round(Number(result.format.duration) * 1000),
+  };
+}
+
+export async function buildMiraFormalVideoReceipt(
+  input: {
+    runtimeRequestId: string;
+    buildItemId: string;
+    classroomId: string;
+    sessionId: string;
+    scenes: Scene[];
+    traces: unknown[];
+  },
+  options: {
+    classroomsDir?: string;
+    attemptsDir?: string;
+    probe?: typeof probeMiraFormalVideo;
+  } = {},
+): Promise<MiraFormalVideoReceipt> {
+  if (!SAFE_ID.test(input.classroomId)) fail('STAGE_INVALID');
+  const refs = new Map<string, string[]>();
+  for (const scene of input.scenes) {
+    if (scene.stageId !== input.classroomId) fail('SCENE_STAGE_MISMATCH');
+    for (const src of formalSceneVideoReferences(scene)) {
+      const ids = refs.get(src) ?? [];
+      if (!ids.includes(scene.id)) ids.push(scene.id);
+      refs.set(src, ids);
+    }
+  }
+  if (refs.size > 1 || input.traces.length > 1) fail('ASSET_LIMIT');
+  const attempt = await readAttempt(input.sessionId, options.attemptsDir);
+  if (
+    attempt &&
+    (attempt.schemaVersion !== 'mira.openmaic.formal-video-attempt.v1' ||
+      attempt.sessionId !== input.sessionId ||
+      attempt.classroomId !== input.classroomId ||
+      attempt.status !== 'succeeded')
+  )
+    fail('ATTEMPT_UNRESOLVED');
+  const traced = new Set<string>();
+  for (const raw of input.traces) {
+    const trace = raw as Partial<MiraFormalVideoTrace> | null;
+    if (
+      !trace ||
+      trace.schemaVersion !== 'mira.openmaic.formal-video-trace.v1' ||
+      trace.sessionId !== input.sessionId ||
+      trace.classroomId !== input.classroomId ||
+      trace.providerId !== MIRA_FORMAL_VIDEO_POLICY.providerId ||
+      trace.modelId !== MIRA_FORMAL_VIDEO_POLICY.modelId ||
+      typeof trace.src !== 'string' ||
+      typeof trace.toolCallId !== 'string' ||
+      !trace.toolCallId ||
+      !attempt ||
+      attempt.toolCallId !== trace.toolCallId ||
+      attempt.src !== trace.src
+    )
+      fail('TRACE_INVALID');
+    if (!refs.has(trace.src)) fail('GENERATED_ASSET_UNREFERENCED');
+    traced.add(trace.src);
+  }
+  if (attempt && !traced.has(attempt.src!)) fail('TRACE_MISSING');
+  const assets: MiraFormalVideoAsset[] = [];
+  const root = path.resolve(options.classroomsDir ?? CLASSROOMS_DIR, input.classroomId, 'media');
+  for (const [src, sceneIds] of refs) {
+    const match = sourceFilename(src, input.classroomId);
+    if (!match || !traced.has(src)) fail('SOURCE_UNATTESTED');
+    const file = path.join(root, match[0]);
+    const real = await fs.realpath(file).catch(() => fail('FILE_MISSING'));
+    if (real !== file) fail('SOURCE_NOT_OWNED');
+    const stat = await fs.stat(real);
+    if (!stat.isFile() || stat.size < 1 || stat.size > MAX_BYTES) fail('BYTES_INVALID');
+    const bytes = await fs.readFile(real);
+    const digest = sha(bytes);
+    if (digest !== match[1]) fail('HASH_MISMATCH');
+    let metadata;
+    try {
+      metadata = await (options.probe ?? probeMiraFormalVideo)(real);
+    } catch {
+      fail('BYTES_INVALID');
+    }
+    if (
+      metadata.width !== 1280 ||
+      metadata.height !== 720 ||
+      !Number.isSafeInteger(metadata.durationMs) ||
+      metadata.durationMs < 4900 ||
+      metadata.durationMs > 5100
+    )
+      fail('OUTPUT_POLICY_INVALID');
+    assets.push({
+      src,
+      sha256: digest,
+      mimeType: 'video/mp4',
+      byteSize: bytes.length,
+      ...metadata,
+      sceneIds,
+    });
+  }
+  const unsigned = {
+    schemaVersion: 'mira.openmaic.formal-video-receipt.v1' as const,
+    status: 'succeeded' as const,
+    runtimeRequestId: input.runtimeRequestId,
+    buildItemId: input.buildItemId,
+    classroomId: input.classroomId,
+    sessionId: input.sessionId,
+    policyId: MIRA_FORMAL_VIDEO_POLICY.policyId,
+    providerId: MIRA_FORMAL_VIDEO_POLICY.providerId,
+    modelId: MIRA_FORMAL_VIDEO_POLICY.modelId,
+    videoCount: assets.length,
+    assets,
+  };
+  return { ...unsigned, receiptSha256: sha(JSON.stringify(canonical(unsigned))) };
+}
