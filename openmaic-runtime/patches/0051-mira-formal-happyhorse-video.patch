+    const bytes = Buffer.from(fixture.base64, 'base64');
+    expect(digest(bytes)).toBe(fixture.sha256);
+    const sha = digest(bytes);
+    const directory = path.join(root, identity.classroomId, 'media');
+    await fs.mkdir(directory, { recursive: true });
+    const file = path.join(directory, `generated-${sha}.mp4`);
+    await fs.writeFile(file, bytes);
+    return {
+      file,
+      bytes,
+      src: `/api/classroom-media/${identity.classroomId}/media/generated-${sha}.mp4`,
+      sha,
+    };
+  }
+  function tool(
+    src: string,
+    execute = vi.fn(async () => ({
+      content: [],
+      details: { src, mime: 'video/mp4', durationSec: 5 },
+    })),
+  ) {
+    const traces: MiraFormalVideoTrace[] = [];
+    const wrapped = withMiraFormalVideoTrace(
+      { name: 'generate_video', execute } as unknown as AgentTool<never, never>,
+      identity.sessionId,
+      async (trace) => {
+        traces.push(trace);
+      },
+      { attemptsDir, ownsStage: async (id) => id === identity.classroomId },
+    );
+    return { wrapped, traces, execute };
+  }
+  const invoke = (wrapped: AgentTool<never, never>, extra = {}, call = 'video-call-1') =>
+    wrapped.execute(
+      call,
+      {
+        stageId: identity.classroomId,
+        prompt: 'A five-second teaching situation',
+        ...extra,
+      } as never,
+      new AbortController().signal,
+    );
+  const receipt = (
+    scenes: Scene[],
+    traces: unknown[],
+    probe = vi.fn(async () => ({ width: 1280, height: 720, durationMs: 5000 })),
+  ) =>
+    buildMiraFormalVideoReceipt(
+      { ...identity, scenes, traces },
+      { classroomsDir: root, attemptsDir, probe },
+    );
+
+  it('fails before reservation when the actual official selector would choose another provider', () => {
+    config.providers = { seedance: {}, happyhorse: {} };
+    expect(() => assertMiraFormalVideoProviderReady()).toThrow('PROVIDER_NOT_READY');
+    config.providers = { seedance: { disabled: true }, happyhorse: {} };
+    expect(() => assertMiraFormalVideoProviderReady()).not.toThrow();
+    config.providers = { happyhorse: {}, seedance: {} };
+    expect(() => assertMiraFormalVideoProviderReady()).not.toThrow();
+  });
+
+  it('serves the exact final stage-owned MP4 bytes and MIME from the student media route', async () => {
+    const media = await asset();
+    const generated = tool(media.src);
+    await invoke(generated.wrapped);
+    const scenes = [
+      slide(media.src),
+      { ...html(`<video controls src="${media.src}"></video>`), id: 'scene-video-2' },
+    ];
+    const video = await receipt(scenes, generated.traces);
+    vi.doMock('@/lib/server/classroom-storage', () => ({
+      CLASSROOMS_DIR: root,
+      isValidClassroomId: (id: string) => /^[a-zA-Z0-9_-]+$/.test(id),
+    }));
+    try {
+      const { GET } = await import('@/app/api/classroom-media/[classroomId]/[...path]/route');
+      const { NextRequest } = await import('next/server');
+      const response = await GET(new NextRequest(`http://runtime.test${media.src}`), {
+        params: Promise.resolve({
+          classroomId: identity.classroomId,
+          path: ['media', `generated-${media.sha}.mp4`],
+        }),
+      });
+      expect(response.status).toBe(200);
+      expect(response.headers.get('Content-Type')).toBe('video/mp4');
+      expect(Buffer.from(await response.arrayBuffer())).toEqual(media.bytes);
+      expect(video.classroomId).toBe(identity.classroomId);
+      expect(video.assets[0]).toMatchObject({
+        src: media.src,
+        sha256: media.sha,
+        sceneIds: scenes.map((scene) => scene.id),
+      });
+      expect(JSON.parse(JSON.stringify(scenes))).toEqual(scenes);
+    } finally {
+      vi.doUnmock('@/lib/server/classroom-storage');
+    }
+  });
+
+  it('keeps all four old policies video-off and accepts video-on only for the new exact policy', () => {
+    const base = {
+      requirement: 'locked brief',
+      runtimeRequestId: identity.runtimeRequestId,
+      formalRuntimeContract: MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT,
+      coursewareAuthority: MIRA_COURSEWARE_AUTHORITY,
+      enableWebSearch: true,
+      enableTTS: false,
+      agentMode: 'generate' as const,
+    };
+    for (const policy of [
+      MIRA_LEGACY_PROFESSIONAL_CREATION_POLICY,
+      MIRA_IMAGE_PROFESSIONAL_CREATION_POLICY,
+      MIRA_INTEGRATED_PROFESSIONAL_CREATION_POLICY,
+      MIRA_PROFESSIONAL_CREATION_POLICY,
+    ]) {
+      expect(policy).not.toHaveProperty('video');
+      const input = {
+        ...base,
+        professionalCreationPolicy: policy,
+        enableImageGeneration: 'image' in policy,
+        enableVideoGeneration: false,
+      };
+      expect(() => assertMiraFormalGenerationInput(input)).not.toThrow();
+      expect(() =>
+        assertMiraFormalGenerationInput({ ...input, enableVideoGeneration: true }),
+      ).toThrow('INPUT_POLICY_INVALID');
+    }
+    const input = {
+      ...base,
+      professionalCreationPolicy: MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY,
+      enableImageGeneration: true,
+      enableVideoGeneration: true,
+    };
+    expect(() => assertMiraFormalGenerationInput(input)).not.toThrow();
+    expect(() =>
+      assertMiraFormalGenerationInput({ ...input, enableVideoGeneration: false }),
+    ).toThrow('INPUT_POLICY_INVALID');
+    expect(
+      isExactMiraProfessionalCreationPolicy({
+        ...MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY,
+        video: { ...MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY.video, maxCalls: 2 },
+      }),
+    ).toBe(false);
+    expect(MIRA_FORMAL_GENERATION_POLICY.professionalCreation).toEqual(
+      MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY,
+    );
+    expect(digest(JSON.stringify(MIRA_PROFESSIONAL_CREATION_POLICY))).not.toBe(
+      digest(JSON.stringify(MIRA_VIDEO_PROFESSIONAL_CREATION_POLICY)),
+    );
+  });
+
+  it('uses persisted video origin rather than global availability to expose tools and adaptive context', () => {
+    const tools = ['generate_video', 'generate_image', 'generate_scene'].map((name) => ({ name }));
+    expect(filterMiraFormalMediaTools(tools, session)).toEqual(tools);
+    expect(isMiraFormalAdaptiveSkillSession(session)).toBe(true);
+    expect(
+      filterMiraFormalMediaTools(tools, {
+        ...session,
+        origin: 'mira-formal-professional-adaptive-skills-v2',
+      }).map((t) => t.name),
+    ).toEqual(['generate_image', 'generate_scene']);
+    expect(
+      filterMiraFormalMediaTools(tools, { ...session, origin: 'mira-formal-professional' }).map(
+        (t) => t.name,
+      ),
+    ).toEqual(['generate_scene']);
+  });
+
+  it('rejects disabled/wrong model/wrong origin/missing credentials without I/O', () => {
+    expect(() => assertMiraFormalVideoProviderReady()).not.toThrow();
+    for (const change of [
+      { disabled: true },
+      { model: 'other' },
+      { key: '' },
+      { base: 'https://other.test' },
