+      throw new Error('uncertain provider result');
+    });
+    const job = tool(file.src, execute);
+    await expect(invoke(job.wrapped)).rejects.toThrow('uncertain provider result');
+    await expect(invoke(tool(file.src).wrapped)).rejects.toThrow('ATTEMPT_LIMIT');
