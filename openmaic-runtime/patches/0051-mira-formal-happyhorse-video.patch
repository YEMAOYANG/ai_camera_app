+  key: 'offline-key',
+  base: 'https://dashscope.aliyuncs.com',
+}));
+vi.mock('@/lib/server/provider-config', () => ({
+  getServerVideoProviders: () => config.providers ?? { happyhorse: { models: [config.model] } },
+  isServerProviderDisabled: () => config.disabled,
+  resolveVideoModel: () => config.model,
