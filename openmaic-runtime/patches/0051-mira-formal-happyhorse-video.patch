+    expect(outcomes.filter((r) => r.status === 'fulfilled')).toHaveLength(1);
+    expect(first.execute.mock.calls.length + second.execute.mock.calls.length).toBe(1);
+    await expect(invoke(tool(file.src).wrapped, {}, 'video-call-3')).rejects.toThrow(
+      'ATTEMPT_LIMIT',
+    );
+  });
+
+  it('does not restore paid allowance after provider failure or hide the failure as a zero-video course', async () => {
+    const file = await asset();
