+      const before = { ...config };
+      Object.assign(config, change);
+      expect(() => assertMiraFormalVideoProviderReady()).toThrow('FORMAL_VIDEO_');
+      Object.assign(config, before);
+    }
+    expect(fetch).not.toHaveBeenCalled();
+  });
+
+  it('pins one 5s/720p/16:9 attempt and durable trace before returning a local asset', async () => {
+    const file = await asset();
+    const job = tool(file.src);
+    await invoke(job.wrapped);
+    expect(job.execute).toHaveBeenCalledWith(
+      'video-call-1',
+      expect.objectContaining({ durationSec: 5, resolution: '720p', aspectRatio: '16:9' }),
+      expect.any(AbortSignal),
+      undefined,
+    );
+    expect(job.traces).toEqual([
+      expect.objectContaining({
+        src: file.src,
+        sessionId: identity.sessionId,
+        providerId: 'happyhorse',
+        modelId: 'happyhorse-1.0-t2v',
+      }),
+    ]);
+    const result = await receipt([slide(file.src)], job.traces);
+    expect(result).toMatchObject({
+      videoCount: 1,
+      assets: [
+        {
+          width: 1280,
+          height: 720,
+          durationMs: 5000,
+          sha256: file.sha,
+          sceneIds: ['scene-video-1'],
+        },
+      ],
+    });
+    expect(result.receiptSha256).toMatch(/^[0-9a-f]{64}$/);
+  });
+
+  it('blocks concurrent attempts and fresh-wrapper reentry without another provider call', async () => {
+    const file = await asset();
+    const first = tool(file.src);
+    const second = tool(file.src);
+    const outcomes = await Promise.allSettled([
+      invoke(first.wrapped),
+      invoke(second.wrapped, {}, 'video-call-2'),
