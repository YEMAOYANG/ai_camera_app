+  const record = source as Record<string, unknown>;
+  const value = record[name]
+    ?? record[name.toLowerCase()]
+    ?? record[name.toUpperCase()]
+    ?? record['Retry-After'];
+  return typeof value === 'string' && value.trim() ? value.trim() : null;
+}
+
+function providerRetryAfterSeconds(error: unknown, seen = new Set<unknown>()): number | null {
+  if (!error || seen.has(error) || typeof error !== 'object') return null;
+  seen.add(error);
+  const record = error as Record<string, unknown>;
+  const response = record.response && typeof record.response === 'object'
+    ? record.response as Record<string, unknown>
+    : null;
+  const raw = headerValue(record.responseHeaders, 'retry-after')
+    ?? headerValue(record.headers, 'retry-after')
+    ?? headerValue(response?.headers, 'retry-after');
+  if (raw !== null && /^[0-9]{1,6}$/.test(raw)) {
+    return Math.min(Number.parseInt(raw, 10), MAX_RATE_LIMIT_RETRY_AFTER_SECONDS);
+  }
+  const nested = [record.cause, record.lastError];
+  if (Array.isArray(record.errors)) nested.push(...record.errors);
+  for (const candidate of nested) {
+    const retryAfter = providerRetryAfterSeconds(candidate, seen);
+    if (retryAfter !== null) return retryAfter;
+  }
+  return null;
+}
+
+async function waitForRateLimitRetry(milliseconds: number, signal: AbortSignal): Promise<void> {
+  if (milliseconds <= 0) return;
+  if (signal.aborted) throw signal.reason;
+  await new Promise<void>((resolve, reject) => {
+    const timer = setTimeout(() => {
+      signal.removeEventListener('abort', onAbort);
+      resolve();
+    }, milliseconds);
+    const onAbort = () => {
+      clearTimeout(timer);
+      reject(signal.reason);
+    };
+    signal.addEventListener('abort', onAbort, { once: true });
+  });
