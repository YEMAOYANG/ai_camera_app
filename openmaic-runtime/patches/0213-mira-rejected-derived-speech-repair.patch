+export function derivedSpeechCueId(sceneSha256: string, text: string): string {
+  check(/^[a-f0-9]{64}$/.test(sceneSha256) && validText(text), 'ID_INPUT');
+  return `derived-cue-${hash(JSON.stringify(['cue', sceneSha256, text])).slice(0, 24)}`;
+}
+export function derivedSpeechActionId(sceneSha256: string, text: string): string {
+  check(/^[a-f0-9]{64}$/.test(sceneSha256) && validText(text), 'ID_INPUT');
+  return `derived-speech-${hash(JSON.stringify(['speech', sceneSha256, text])).slice(0, 24)}`;
+}
+
+function staticCues(html: unknown): Cue[] {
+  check(typeof html === 'string' && html.length > 0, 'HTML');
+  const blocks: string[] = [];
+  const visit = (node: DefaultTreeAdapterMap['node']) => {
+    if ('tagName' in node) {
+      const attrs = Object.fromEntries(node.attrs.map(a => [a.name, a.value]));
+      check(!['audio', 'video', 'source'].includes(node.tagName) && attrs.id !== 'mira-pre-recorded-audio', 'AUDIO_PRESENT');
+      if (node.tagName === 'template') return;
+      if (attrs.id === 'mira-narration-cues') {
+        check(node.tagName === 'script' && attrs.type === 'application/json' && !attrs.src, 'CUE_CONTAINER');
+        blocks.push(node.childNodes.map(n => 'value' in n ? n.value : '').join(''));
+      }
+    }
+    if ('childNodes' in node) for (const child of node.childNodes) visit(child);
+  };
+  visit(parse(html as string));
+  check(!/<(?:audio|video|source)\b|\bnew\s+Audio\s*\(|data:audio\/|\/audio\/[^\s'"<>]+|mira-pre-recorded-audio/i.test(html as string), 'AUDIO_PRESENT');
+  check(blocks.length === 1, 'CUE_CONTAINER');
+  let payload: unknown;
+  try { payload = JSON.parse(blocks[0]); } catch { check(false, 'CUE_JSON'); }
+  check(object(payload) && Object.keys(payload).sort().join(',') === 'cues,schemaVersion' && payload.schemaVersion === 'mira.interactive.narration-cues.v1' && Array.isArray(payload.cues), 'CUE_SCHEMA');
+  const cues = (payload as Json).cues as Cue[];
+  check(cues.length > 0 && cues.length <= 120 && cues.every(c => object(c) && Object.keys(c).sort().join(',') === 'id,text' && safeId(c.id) && validText(c.text)) && new Set(cues.map(c => c.id)).size === cues.length, 'CUE_ITEMS');
+  return cues;
+}
+
+function noRecordedAudio(value: unknown): void {
+  if (Array.isArray(value)) { value.forEach(noRecordedAudio); return; }
+  if (!object(value)) return;
+  check(!Object.keys(value).some(k => ['audioId', 'audioUrl', 'audioMetadata', 'questionAudioUrl', 'feedbackAudioUrl'].includes(k)), 'AUDIO_PRESENT');
+  Object.values(value).forEach(noRecordedAudio);
+}
+
+/** The manifest alone is not authorization; the caller still validates archive, owner and frozen contract. */
+export function deriveRejectedSpeechManifest(scene: Json, sceneSha256: string) {
+  check(scene.type === 'interactive' && scene.content?.type === 'interactive', 'INTERACTIVE_ONLY');
+  noRecordedAudio(scene);
+  const originalCues = staticCues(scene.content.html);
+  const actions: Json[] = scene.actions;
+  check(Array.isArray(actions) && actions.every(a => object(a) && safeId(a.id)) && new Set(actions.map(a => a.id)).size === actions.length, 'ACTION_IDS');
+  const speech = actions.filter(a => a.type === 'speech');
+  check(speech.length > 0 && speech.every(a => validText(a.text)) && new Set(speech.map(a => a.text)).size === speech.length, 'SOURCE_SPEECH');
+  const union = new Map<string, { cueIds: string[]; actionIds: string[] }>();
+  for (const cue of originalCues) {
+    if (!union.has(cue.text)) union.set(cue.text, { cueIds: [], actionIds: [] });
+    union.get(cue.text)!.cueIds.push(cue.id);
+  }
+  for (const action of speech) {
+    if (!union.has(action.text)) union.set(action.text, { cueIds: [], actionIds: [] });
+    union.get(action.text)!.actionIds.push(action.id);
+  }
+  check(union.size <= 120, 'UNION_SIZE');
+  const expectedCues = [...union].map(([text, origins]) => ({ id: origins.cueIds[0] ?? derivedSpeechCueId(sceneSha256, text), text }));
+  check(new Set(expectedCues.map(c => c.id)).size === expectedCues.length, 'CUE_ID_COLLISION');
+  const addedSpeech = [...union].filter(([, origins]) => !origins.actionIds.length).map(([text]) => ({ id: derivedSpeechActionId(sceneSha256, text), type: 'speech' as const, text }));
+  check(addedSpeech.length > 0 && addedSpeech.every(a => !actions.some(prior => prior.id === a.id)) && new Set(addedSpeech.map(a => a.id)).size === addedSpeech.length, 'ACTION_ID_COLLISION');
+  return {
+    originalCueCount: originalCues.length,
+    originalSpeechCount: speech.length,
+    originalActionsSha256: hash(canonical(actions)),
+    expectedCues,
+    addedSpeech,
+    textOrigins: [...union].map(([text, origins]) => ({ text, ...origins })),
+    mergedCues: [...union].filter(([, origins]) => origins.cueIds.length > 1).map(([text, origins]) => ({ text, retainedCueId: origins.cueIds[0], removedCueIds: origins.cueIds.slice(1) })),
+  };
+}
+
+export function restoreDerivedSpeech(scene: Json, revised: Json, frozenFile: Json, sceneSha256: string) {
+  const page = frozenFile.sceneContract?.contract?.pagePlan?.[scene.order - 1];
+  check(page?.page === scene.order && page.type === 'interactive' && page.title === scene.title, 'FROZEN_PAGE');
+  check(page.speechPlan === undefined && page.cueSpeechMap === undefined, 'FROZEN_PLAN_PRESENT');
+  const manifest = deriveRejectedSpeechManifest(scene, sceneSha256);
+  noRecordedAudio(revised);
+  const cues = staticCues(revised.content?.html);
+  check(cues.length === manifest.expectedCues.length && new Set(cues.map(c => c.text)).size === cues.length && cues.every(c => manifest.expectedCues.some(expected => expected.text === c.text && expected.id === c.id)), 'REVISED_CUE_UNION');
+  // Clone the original actions, never accept an action override from the operator's HTML input.
+  revised.actions = [...structuredClone(scene.actions), ...manifest.addedSpeech];
+  return manifest;
+}
