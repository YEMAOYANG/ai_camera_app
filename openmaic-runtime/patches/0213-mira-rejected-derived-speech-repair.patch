+type Json = Record<string, any>;
+type Cue = { id: string; text: string };
+const check = (ok: unknown, code: string): void => {
+  if (!ok) throw new Error(`TEXTBOOK_REPAIR_DERIVED_SPEECH_${code}`);
+};
+const object = (value: unknown): value is Json => !!value && typeof value === 'object' && !Array.isArray(value);
+const safeId = (value: unknown): value is string => typeof value === 'string' && /^[A-Za-z0-9_-]{1,128}$/.test(value);
+const validText = (value: unknown): value is string => typeof value === 'string' && value.length > 0 && value === value.trim() && Array.from(value).length <= 1000;
+const hash = (value: string) => createHash('sha256').update(value).digest('hex');
+const canonical = (value: any): string => Array.isArray(value)
+  ? '[' + value.map(canonical).join(',') + ']'
