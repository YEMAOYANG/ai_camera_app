+import { type NextRequest, NextResponse } from 'next/server';
+import { authorizeMiraInternalLoopbackRequest } from '@/lib/server/mira-internal-loopback-auth';
+import {
+  BUDGET_RESUME_JOB,
+  resumeFormalBudgetFailure,
+} from '@/lib/server/mira-formal-budget-resume';
+export const dynamic = 'force-dynamic';
+export async function POST(req: NextRequest, context: { params: Promise<{ jobId: string }> }) {
+  try {
+    authorizeMiraInternalLoopbackRequest(req);
+  } catch {
+    return NextResponse.json({ error: 'INVALID_CREDENTIALS' }, { status: 403 });
+  }
+  if ((await context.params).jobId !== BUDGET_RESUME_JOB)
+    return NextResponse.json({ error: 'NOT_FOUND' }, { status: 404 });
+  try {
+    const body = await req.json();
+    if (Object.keys(body).some((k) => !['mode', 'expectedHistorySha256'].includes(k)))
+      throw new Error('FORMAL_BUDGET_RESUME_INVALID_REQUEST');
+    return NextResponse.json({ ok: true, recovery: await resumeFormalBudgetFailure(body) });
+  } catch (error) {
+    const message =
+      error instanceof Error && /^FORMAL_BUDGET_RESUME_[A-Z_]+$/.test(error.message)
+        ? error.message
+        : 'FORMAL_BUDGET_RESUME_UNAVAILABLE';
+    return NextResponse.json({ ok: false, error: message }, { status: 409 });
+  }
+}
diff --git a/tests/server/mira-formal-budget-resume.test.ts b/tests/server/mira-formal-budget-resume.test.ts
