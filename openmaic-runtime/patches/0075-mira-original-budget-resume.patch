@@ -0,0 +1,56 @@
+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { describe, expect, it, vi } from 'vitest';
+vi.mock('@/lib/persistence/server-provider', () => ({
+  getServerPersistenceProvider: vi.fn(() => {
+    throw new Error('DB must not be called');
+  }),
+}));
+import { validateBudgetResumeHistory } from '@/lib/server/mira-formal-budget-resume';
+import { planResume } from '@/lib/server/agent-runtime/resume';
+
+const file = resolve('../../../output/primary6-math-budget-paused-snapshot.json');
+describe.skipIf(!existsSync(file))('actual budget-refused sample snapshot', () => {
+  it('preserves the exact successful research and continues after fetch without providers', () => {
+    const source = JSON.parse(readFileSync(file, 'utf8'));
+    const before = JSON.stringify(source);
+    const receipt = validateBudgetResumeHistory(source);
+    expect(receipt).toMatchObject({
+      searchAttempts: 4,
+      remainingSearchAttempts: 0,
+      stageCount: 0,
+      qaCount: 0,
+    });
+    const plan = planResume(
+      source.entries
+        .filter((entry: any) => entry.type === 'message')
+        .map((entry: any) => entry.data.message),
+    );
+    expect(plan.kind).toBe('continue');
+    if (plan.kind !== 'continue') throw new Error('Unexpected resume branch');
+    expect(plan.repairedToolCalls).toEqual([]);
+    expect(plan.messages.at(-1)).toMatchObject({
+      role: 'toolResult',
+      toolName: 'fetch_url',
+      isError: false,
+    });
+    expect(JSON.stringify(source)).toBe(before);
+  });
+  it('rejects changed identity, a paid or ambiguous failure and missing research evidence', () => {
+    const source = JSON.parse(readFileSync(file, 'utf8'));
+    const variants = [
+      { ...source, stageCount: 1 },
+      { ...source, job: { ...source.job, formalInputSha256: '0'.repeat(64) } },
+      { ...source, session: { ...source.session, error: 'MIRA_PAID_BUDGET_DISPATCH_REJECTED' } },
+      {
+        ...source,
+        events: source.events.filter((event: any) => event.type !== 'mira_formal_research_search'),
+      },
+      { ...source, entries: source.entries.slice(0, -1) },
+    ];
+    for (const changed of variants)
+      expect(() => validateBudgetResumeHistory(changed)).toThrow(
+        'FORMAL_BUDGET_RESUME_SOURCE_MISMATCH',
+      );
+  });
+});
