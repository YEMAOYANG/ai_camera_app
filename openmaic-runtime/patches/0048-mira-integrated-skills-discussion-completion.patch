@@ -0,0 +1,163 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { PlaybackEngine } from '@/lib/playback/engine';
+import { finishGuidedDiscussionPlayback } from '@/lib/playback/discussion-completion';
+import type { CleanupSource } from '@/lib/playback/auto-resume';
+import type { ActionEngine } from '@/lib/action/engine';
+import type { AudioPlayer } from '@/lib/utils/audio-player';
+import type { Action } from '@/lib/types/action';
+import type { Scene } from '@/lib/types/stage';
+
+async function joinedDiscussion(followedBySpeech = false) {
+  vi.useFakeTimers();
+  const onComplete = vi.fn();
+  const onSpeechStart = vi.fn();
+  let audioEnded = () => {};
+  const audio = {
+    play: vi.fn(async () => true),
+    onEnded: vi.fn((callback: () => void) => {
+      audioEnded = callback;
+    }),
+    stop: vi.fn(),
+    pause: vi.fn(),
+    resume: vi.fn(),
+    isPlaying: vi.fn(() => false),
+    hasActiveAudio: vi.fn(() => false),
+  } as unknown as AudioPlayer;
+  const actions: Action[] = [
+    { id: 'final-discussion', type: 'discussion', topic: 'Compare numbers' },
+  ];
+  if (followedBySpeech)
+    actions.push({
+      id: 'after-discussion',
+      type: 'speech',
+      text: 'Now try the next example.',
+      audioId: 'saved-audio',
+    });
+  const scene = {
+    id: 'scene-p5',
+    stageId: 'stage-math',
+    type: 'interactive',
+    title: 'Compare',
+    order: 5,
+    content: { type: 'interactive', html: '<p>Compare</p>' },
+    actions,
+  } as Scene;
+  const engine = new PlaybackEngine(
+    [scene],
+    {
+      execute: vi.fn(async () => {}),
+      clearEffects: vi.fn(),
+      resetPlaybackVisualState: vi.fn(),
+    } as unknown as ActionEngine,
+    audio,
+    { onComplete, onSpeechStart },
+  );
+  engine.start();
+  await vi.advanceTimersByTimeAsync(4000);
+  engine.confirmDiscussion();
+  expect(engine.getMode()).toBe('live');
+  const binding = { engine, sceneId: scene.id, settled: false };
+  const cleanup = vi.fn(() => engine.handleEndDiscussion());
+  const prepareLecture = vi.fn();
+  const finish = (source: CleanupSource, isCurrent = () => true) =>
+    finishGuidedDiscussionPlayback({ binding, source, isCurrent, cleanup, prepareLecture });
+  return {
+    engine,
+    binding,
+    cleanup,
+    prepareLecture,
+    onComplete,
+    onSpeechStart,
+    finish,
+    endAudio: () => audioEnded(),
+  };
+}
+
+describe('scripted discussion completion uses the ordinary playback exit', () => {
+  afterEach(() => vi.useRealTimers());
+
+  it.each(['turn_complete', 'soft_close_confirmed', 'soft_close_timeout'] as const)(
+    'finishes a final discussion exactly once after %s',
+    async (source) => {
+      const test = await joinedDiscussion();
+      expect(test.onComplete).not.toHaveBeenCalled();
+      test.finish(source);
+      expect(test.cleanup).toHaveBeenCalledTimes(1);
+      expect(test.onComplete).toHaveBeenCalledTimes(1);
+      expect(test.prepareLecture).not.toHaveBeenCalled();
+      test.finish(source);
+      expect(test.cleanup).toHaveBeenCalledTimes(1);
+      expect(test.onComplete).toHaveBeenCalledTimes(1);
+    },
+  );
+
+  it('continues remaining actions and reports completion only after their real audio end', async () => {
+    const test = await joinedDiscussion(true);
+    test.finish('turn_complete');
+    await Promise.resolve();
+    expect(test.prepareLecture).toHaveBeenCalledTimes(1);
+    expect(test.onSpeechStart).toHaveBeenCalledWith('Now try the next example.');
+    expect(test.onComplete).not.toHaveBeenCalled();
+    test.endAudio();
+    expect(test.onComplete).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(['manual_stop', 'error', 'scene_switch', 'soft_close_enter'] as const)(
+    'never resumes or completes on %s',
+    async (source) => {
+      const test = await joinedDiscussion();
+      test.finish(source);
+      expect(test.onComplete).not.toHaveBeenCalled();
+      expect(test.prepareLecture).not.toHaveBeenCalled();
+      expect(test.binding.settled).toBe(source !== 'soft_close_enter');
+    },
+  );
+
+  it('ignores an old engine, scene or superseded chat session before cleanup', async () => {
+    const test = await joinedDiscussion();
+    test.finish('turn_complete', () => false);
+    expect(test.cleanup).not.toHaveBeenCalled();
+    expect(test.onComplete).not.toHaveBeenCalled();
+  });
+
+  it('rechecks ownership after cleanup and does not complete a replacement scene', async () => {
+    const test = await joinedDiscussion();
+    let current = true;
+    finishGuidedDiscussionPlayback({
+      binding: test.binding,
+      source: 'turn_complete',
+      isCurrent: () => current,
+      cleanup: () => {
+        test.engine.handleEndDiscussion();
+        current = false;
+      },
+      prepareLecture: test.prepareLecture,
+    });
+    expect(test.onComplete).not.toHaveBeenCalled();
+  });
+
+  it('does not treat a late successful callback after an interruption as completion', async () => {
+    const test = await joinedDiscussion();
+    test.finish('manual_stop');
+    test.engine.handleUserInterrupt('A different question');
+    expect(test.engine.getMode()).toBe('live');
+    test.finish('turn_complete');
+    expect(test.cleanup).toHaveBeenCalledTimes(1);
+    expect(test.engine.getMode()).toBe('live');
+    expect(test.onComplete).not.toHaveBeenCalled();
+  });
+
+  it('leaves ordinary unbound Q&A on its existing cleanup path', () => {
+    const cleanup = vi.fn();
+    expect(
+      finishGuidedDiscussionPlayback({
+        binding: undefined,
+        source: 'turn_complete',
+        isCurrent: () => true,
+        cleanup,
+        prepareLecture: vi.fn(),
+      }),
+    ).toBe(false);
+    expect(cleanup).not.toHaveBeenCalled();
+  });
+});
