diff --git a/lib/playback/discussion-completion.ts b/lib/playback/discussion-completion.ts
new file mode 100644
index 0000000..a95209d
--- /dev/null
+++ b/lib/playback/discussion-completion.ts
@@ -0,0 +1,47 @@
+import type { CleanupSource } from './auto-resume';
+import type { PlaybackEngine } from './engine';
+
+export interface GuidedDiscussionPlayback {
+  readonly engine: PlaybackEngine;
+  readonly sceneId: string;
+  settled: boolean;
+}
+
+/**
+ * Only a successful, current scripted discussion may resume the lecture.
+ * Continuing an exhausted cursor deliberately reaches the engine's ordinary
+ * onComplete callback, keeping formal scene evidence on its single exit path.
+ */
+export function finishGuidedDiscussionPlayback(input: {
+  binding: GuidedDiscussionPlayback | undefined;
+  source: CleanupSource;
+  isCurrent: (binding: GuidedDiscussionPlayback) => boolean;
+  cleanup: () => void;
+  prepareLecture: () => void;
+}): boolean {
+  const { binding } = input;
+  if (!binding) return false; // An ordinary Q&A keeps its existing cleanup path.
+  if (binding.settled || !input.isCurrent(binding)) return true;
+  if (input.source === 'soft_close_enter') return true;
+
+  const engine = binding.engine;
+  const normalEnd =
+    input.source === 'turn_complete' ||
+    input.source === 'soft_close_confirmed' ||
+    input.source === 'soft_close_timeout';
+  const canContinue =
+    normalEnd &&
+    (engine.getMode() === 'live' || engine.getMode() === 'paused') &&
+    engine.hasLectureInterruption();
+
+  // An interrupted session is terminal too: a late callback must not resume
+  // a newer live session that happens to reuse this engine and scene.
+  binding.settled = true;
+  // Clear the live session and restore its saved cursor before any continuation.
+  input.cleanup();
+  if (!canContinue) return true;
+  if (!input.isCurrent(binding) || engine.getMode() !== 'idle') return true;
+  if (!engine.isExhausted()) input.prepareLecture();
+  if (input.isCurrent(binding) && engine.getMode() === 'idle') engine.continuePlayback();
+  return true;
+}
