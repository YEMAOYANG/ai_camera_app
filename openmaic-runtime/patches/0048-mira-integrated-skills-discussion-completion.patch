new file mode 100644
index 0000000..8155c77
--- /dev/null
+++ b/lib/server/mira-formal-skill-policy.ts
@@ -0,0 +1,402 @@
+import { createHash, randomBytes } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { dirname, join, resolve } from 'node:path';
+import type { AgentMessage } from '@earendil-works/pi-agent-core';
+import type { Scene } from '@/lib/types/stage';
+import {
+  createNativeSkillReadTool,
+  readSkillFileText,
+  type LoadedSkill,
+} from './agent-runtime/skills';
+import { buildSkillPreload, type SkillPreload } from './agent-runtime/skill-preload';
+
+export const MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY = {
+  schemaVersion: 'mira.openmaic.skill-orchestration.v1',
+  profileId: 'mira-primary-integrated.v1',
+  skillIds: [
+    'mira-primary-courseware',
+    'stage-design',
+    'k12-core-literacy-planning',
+    'deep-interactive',
+    'slide-craft',
+    'learning-to-learn',
+  ],
+  sceneContextRequired: true,
+} as const;
+
+export const MIRA_FORMAL_SKILL_SESSION_ORIGIN = 'mira-formal-professional-integrated-skills-v1';
+export const MIRA_FORMAL_SKILL_CONTEXT_EVENT = 'mira_formal_skill_scene_context';
+const CONTEXT_SCHEMA = 'mira.openmaic.skill-scene-context.v1';
+const PROMPT_MARKER = 'MIRA_FORMAL_SKILL_PROFILE: ';
+type Subject = 'math' | 'chinese' | 'english';
+type SceneType = 'slide' | 'quiz' | 'interactive' | 'pbl';
+type Phase = 'content' | 'actions';
+
+function sha256(text: string): string {
+  return createHash('sha256').update(text, 'utf8').digest('hex');
+}
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(
+      Object.entries(value)
+        .sort(([a], [b]) => a.localeCompare(b))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  }
+  return value;
+}
+
+function digest(value: unknown): string {
+  return sha256(JSON.stringify(canonical(value)));
+}
+
+export function formalSkillReferencePaths(subject: Subject): string[] {
+  return [
+    'k12-core-literacy-planning/references/core-literacy.md',
+    `k12-core-literacy-planning/references/subjects/${subject === 'math' ? 'mathematics' : 'languages'}.md`,
+  ];
+}
+
+export function formalSkillPromptSuffix(subject: Subject): string {
+  return (
+    '\n\n' +
+    PROMPT_MARKER +
+    JSON.stringify({
+      profileId: MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.profileId,
+      subject,
+    }) +
+    '\n' +
+    [
+      'The server preloads all six approved Skills and the subject references. Apply them together.',
+      'Formal authority wins over generic Skill defaults: the approved brief needs no ask_user or sign-off;',
+      'locked assessments, age boundary, roster, adaptive page count and server-managed audio stay unchanged.',
+      'Deep-interactive supplies meaningful controls and feedback, not a 60% page ratio, forced widget alternation, or extra pages.',
+      'Integrate only 1-2 learning-to-learn actions (prediction, recall, self-explanation or checking) into the subject task.',
+      'Page briefs must state the learner action, observable evidence, likely misconception and correction, source attribution,',
+      'and transition to the next page. Static text must not expose planning labels or spoken role dialogue.',
+      'Use slide-craft for visual quality and read back each page. Generate every page with generate_scene so its',
+      'content and narration receive the approved context; no duplicate_scene shortcut. Do not activate personal Skills,',
+      'series planners, lecture/workshop styles, or a separate research course. Research remains the existing 1-4-call gate.',
+    ].join('\n')
+  );
+}
+
+export function formalSkillSubjectFromPrompt(prompt: string): Subject {
+  const lines = prompt.split('\n').filter((line) => line.startsWith(PROMPT_MARKER));
+  if (lines.length !== 1) throw new Error('FORMAL_SKILL_PROFILE_PROMPT_INVALID');
+  const value = JSON.parse(lines[0]!.slice(PROMPT_MARKER.length));
+  if (
+    value.profileId !== MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.profileId ||
+    !['math', 'chinese', 'english'].includes(value.subject)
+  ) {
+    throw new Error('FORMAL_SKILL_PROFILE_PROMPT_INVALID');
+  }
+  return value.subject;
+}
+
+interface SkillResource {
+  resourcePath: string;
+  filePath: string;
+  skillId?: string;
+  text: string;
+  sourceHash: string;
+}
+
+export interface MiraFormalSkillBundle {
+  subject: Subject;
+  skills: LoadedSkill[];
+  resources: SkillResource[];
+}
+
+/** Read the exact registered builtins. User skills never define a formal profile. */
+export async function prepareMiraFormalSkillBundle(
+  installed: readonly LoadedSkill[],
+  subject: Subject,
+): Promise<MiraFormalSkillBundle> {
+  const skills = MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.skillIds.map((id) => {
+    const skill = installed.find((entry) => entry.id === id && entry.source === 'builtin');
+    if (!skill) throw new Error(`FORMAL_SKILL_MISSING:${id}`);
+    return skill;
+  });
+  const resources: SkillResource[] = [];
+  for (const skill of skills) {
+    const text = await readSkillFileText(skill);
+    resources.push({
+      skillId: skill.id,
+      resourcePath: `${skill.id}/SKILL.md`,
+      filePath: resolve(skill.filePath),
+      text,
+      sourceHash: sha256(text),
+    });
+  }
+  const skillRoot = dirname(
+    dirname(skills.find((entry) => entry.id === 'k12-core-literacy-planning')!.filePath),
+  );
+  for (const resourcePath of formalSkillReferencePaths(subject)) {
+    const filePath = resolve(join(skillRoot, resourcePath));
+    const text = await readFile(filePath, 'utf8');
+    resources.push({ resourcePath, filePath, text, sourceHash: sha256(text) });
+  }
+  return { subject, skills, resources };
+}
+
+function provesResourceRead(message: AgentMessage, resource: SkillResource): boolean {
+  if (message.role !== 'toolResult') return false;
+  const value = message as unknown as {
+    toolName?: string;
+    isError?: boolean;
+    details?: Record<string, unknown>;
+    content?: Array<{ type: string; text?: string }>;
+  };
+  const details = value.details;
+  if (
+    value.toolName !== 'read' ||
+    value.isError ||
+    !details ||
+    details.path !== resource.filePath ||
+    details.offset !== 1 ||
+    typeof details.lines !== 'number' ||
+    typeof details.totalLines !== 'number' ||
+    details.lines < details.totalLines ||
+    details.sourceHash !== resource.sourceHash.slice(0, 16)
+  )
+    return false;
+  const body = value.content
+    ?.filter((part) => part.type === 'text')
+    .map((part) => part.text ?? '')
+    .join('\n');
+  return (
+    body !== undefined &&
+    sha256(body) === resource.sourceHash &&
+    details.totalLines === body.split(/\r?\n/).length
+  );
+}
+
+export function collectMiraFormalSkillReads(
+  messages: readonly AgentMessage[],
+  bundle: MiraFormalSkillBundle,
+) {
+  for (const resource of bundle.resources) {
+    if (!messages.some((message) => provesResourceRead(message, resource))) {
+      throw new Error(`FORMAL_SKILL_READ_MISSING:${resource.resourcePath}`);
+    }
+  }
+  return {
+    skillReads: bundle.resources
+      .filter((resource) => resource.skillId)
+      .map((resource) => ({
+        skillId: resource.skillId!,
+        sourceHash: resource.sourceHash,
+      })),
+    referenceReads: bundle.resources
+      .filter((resource) => !resource.skillId)
+      .map((resource) => ({
+        resourcePath: resource.resourcePath,
+        sourceHash: resource.sourceHash,
+      })),
+  };
+}
+
+/** Same native read transcript protocol, with a formal-only six-Skill limit. */
+export async function buildMiraFormalSkillPreload(
+  input: Parameters<typeof buildSkillPreload>[0],
+  bundle: MiraFormalSkillBundle,
+): Promise<SkillPreload> {
+  const preload = await buildSkillPreload({ ...input, forced: bundle.skills, maxCount: 6 });
+  const read = createNativeSkillReadTool(bundle.skills, () => undefined);
+  for (const resource of bundle.resources.filter((entry) => !entry.skillId)) {
+    if (
+      [...input.transcript, ...preload.messages].some((message) =>
+        provesResourceRead(message, resource),
+      )
+    )
+      continue;
+    const id = `call_mira_skill_${randomBytes(12).toString('hex')}`;
+    const args = { path: resource.filePath, limit: resource.text.split(/\r?\n/).length };
+    const result = await read.execute(id, args);
+    const timestamp = Date.now();
+    preload.messages.push(
+      {
+        role: 'assistant',
+        content: [{ type: 'toolCall', id, name: 'read', arguments: args }],
+        api: input.model.api,
+        provider: input.model.provider,
+        usage: {
+          input: 0,
+          output: 0,
+          cacheRead: 0,
+          cacheWrite: 0,
+          totalTokens: 0,
+          cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+        },
+        model: input.model.id,
+        stopReason: 'toolUse',
+        timestamp,
+      } as unknown as AgentMessage,
+      {
+        role: 'toolResult',
+        toolName: 'read',
+        toolCallId: id,
+        content: result.content,
+        details: result.details,
+        isError: false,
+        timestamp,
+      } as AgentMessage,
+    );
+  }
+  collectMiraFormalSkillReads([...input.transcript, ...preload.messages], bundle);
+  return preload;
+}
+
+function section(text: string, heading: string): string {
+  const start = text.indexOf(`\n## ${heading}\n`);
+  if (start < 0) throw new Error(`FORMAL_SKILL_SECTION_MISSING:${heading}`);
+  const end = text.indexOf('\n## ', start + 1);
+  return text.slice(start + 1, end < 0 ? undefined : end).trim();
+}
+
+export interface MiraFormalSceneSkillInput {
+  stageId: string;
+  sceneId: string;
+  sceneType: string;
+  phase: Phase;
+}
+
+export interface MiraFormalSceneSkillContext {
+  text: string;
+  contextSha256: string;
+}
+
+/** The page model gets applicable source sections, not the Agent's hidden memory. */
+export function composeMiraFormalSceneSkillContext(
+  bundle: MiraFormalSkillBundle,
+  input: Pick<MiraFormalSceneSkillInput, 'sceneType' | 'phase'>,
+): MiraFormalSceneSkillContext {
+  const source = (id: string) => bundle.resources.find((entry) => entry.skillId === id)!.text;
+  const blocks = [
+    'MIRA SERVER-OWNED INTEGRATED PAGE RULES v1',
+    `Profile: ${MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.profileId}; subject: ${bundle.subject}; phase: ${input.phase}; page: ${input.sceneType}.`,
+    'Produce only this requested page/output. The formal brief is approved. Keep its grade, locked questions, roster, source facts and answer-blind boundary.',
+    'Stage-design applies as one durable page per call and a complete learning sequence. Do not emit planning or tool instructions into learner content.',
+    ...bundle.resources.map(
+      (entry) => `Read source: ${entry.resourcePath} sha256=${entry.sourceHash}`,
+    ),
+    section(
+      source('mira-primary-courseware'),
+      input.phase === 'actions' ? 'Narration and focus' : 'Page craft',
+    ),
+    section(source('k12-core-literacy-planning'), 'Settle the learning contract'),
+    section(source('k12-core-literacy-planning'), 'Universal non-negotiables'),
+    ...bundle.resources.filter((entry) => !entry.skillId).map((entry) => entry.text),
+    section(source('learning-to-learn'), '两条内容红线'),
+    section(source('learning-to-learn'), '四个嵌入点'),
+    'Choose only 1-2 suitable learning actions across the lesson; weave them into the existing concept task, never add a separate learning-strategy course or mandatory extra pages.',
+  ];
+  if (input.sceneType === 'slide' && input.phase === 'content') {
+    blocks.push(source('slide-craft').replace(/^---[\s\S]*?---\s*/, ''));
+  }
+  if (input.sceneType === 'interactive') {
+    blocks.push(
+      section(source('deep-interactive'), 'Choosing a widget type'),
+      section(source('deep-interactive'), 'keyPoints'),
+    );
+  }
+  blocks.push(
+    input.phase === 'actions'
+      ? 'Narration uses short age-appropriate instructions tied to visible content. Preserve valid spotlight/speech sequences, exact element IDs and real widget selectors. Spoken role dialogue belongs only in actions.'
+      : 'Keep learner-facing text concise and visually legible. Use meaningful manipulation/feedback when interactive, concrete evidence and misconceptions when assessing. Internal planning labels and role speeches never belong in static text.',
+  );
+  blocks.push(
+    'FORMAL PRIORITY: no ask_user, no extra scene plan, no fixed page count, no 60% interactive quota or forced widget rotation. Do not change locked assessment wording/options or invent answers. Server promotion owns audio; output this page and its requested data only.',
+  );
+  const text = blocks.join('\n\n');
+  return { text, contextSha256: sha256(text) };
+}
+
+export interface MiraFormalSkillContextTrace extends MiraFormalSceneSkillInput {
+  schemaVersion: typeof CONTEXT_SCHEMA;
+  profileId: typeof MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.profileId;
+  sessionId: string;
+  contextSha256: string;
+}
+
+export function formalSkillContextTrace(
+  sessionId: string,
+  input: MiraFormalSceneSkillInput,
+  context: MiraFormalSceneSkillContext,
+): MiraFormalSkillContextTrace {
+  return {
+    schemaVersion: CONTEXT_SCHEMA,
+    profileId: MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.profileId,
+    sessionId,
+    ...input,
+    contextSha256: context.contextSha256,
+  };
+}
+
+export interface MiraFormalSkillReceipt {
+  schemaVersion: 'mira.openmaic.skill-orchestration-receipt.v1';
+  profileId: typeof MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.profileId;
+  status: 'succeeded';
+  skillReads: Array<{ skillId: string; sourceHash: string }>;
+  referenceReads: Array<{ resourcePath: string; sourceHash: string }>;
+  sceneContexts: Array<{
+    sceneId: string;
+    sceneType: SceneType;
+    contentContextSha256: string;
+    actionsContextSha256: string;
+  }>;
+  receiptSha256: string;
+}
+
+export function buildMiraFormalSkillReceipt(input: {
+  sessionId: string;
+  stageId: string;
+  bundle: MiraFormalSkillBundle;
+  messages: readonly AgentMessage[];
+  scenes: readonly Scene[];
+  events: ReadonlyArray<{ type: string; data: unknown }>;
+}): MiraFormalSkillReceipt {
+  const reads = collectMiraFormalSkillReads(input.messages, input.bundle);
+  const sceneContexts = input.scenes.map((scene) => {
+    if (scene.stageId !== input.stageId) throw new Error('FORMAL_SKILL_SCENE_STAGE_MISMATCH');
+    const hashes = (['content', 'actions'] as const).map((phase) => {
+      const expected = composeMiraFormalSceneSkillContext(input.bundle, {
+        phase,
+        sceneType: scene.type,
+      });
+      const match = input.events.some((event) => {
+        if (event.type !== MIRA_FORMAL_SKILL_CONTEXT_EVENT) return false;
+        const trace = event.data as MiraFormalSkillContextTrace | null;
+        return (
+          trace?.schemaVersion === CONTEXT_SCHEMA &&
+          trace.profileId === MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.profileId &&
+          trace.sessionId === input.sessionId &&
+          trace.stageId === input.stageId &&
+          trace.sceneId === scene.id &&
+          trace.sceneType === scene.type &&
+          trace.phase === phase &&
+          trace.contextSha256 === expected.contextSha256
+        );
+      });
+      if (!match) throw new Error(`FORMAL_SKILL_SCENE_CONTEXT_MISSING:${scene.id}:${phase}`);
+      return expected.contextSha256;
+    });
+    return {
+      sceneId: scene.id,
+      sceneType: scene.type as SceneType,
+      contentContextSha256: hashes[0]!,
+      actionsContextSha256: hashes[1]!,
+    };
+  });
+  const unsigned = {
+    schemaVersion: 'mira.openmaic.skill-orchestration-receipt.v1' as const,
+    profileId: MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.profileId,
+    status: 'succeeded' as const,
+    ...reads,
+    sceneContexts,
+  };
+  return { ...unsigned, receiptSha256: digest(unsigned) };
+}
