+import { createHash } from 'node:crypto';
+import { beforeAll, describe, expect, it } from 'vitest';
+import type { AgentMessage } from '@earendil-works/pi-agent-core';
+import {
+  MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY,
+  MIRA_FORMAL_SKILL_SESSION_ORIGIN,
+  MIRA_FORMAL_SKILL_CONTEXT_EVENT,
+  prepareMiraFormalSkillBundle,
+  buildMiraFormalSkillPreload,
+  collectMiraFormalSkillReads,
+  composeMiraFormalSceneSkillContext,
+  buildMiraFormalSkillReceipt,
+  formalSkillContextTrace,
+  formalSkillReferencePaths,
+  formalSkillPromptSuffix,
+  formalSkillSubjectFromPrompt,
+  type MiraFormalSkillBundle,
+} from '@/lib/server/mira-formal-skill-policy';
+import { listSkills } from '@/lib/server/agent-runtime/skills';
+import { buildSkillPreload } from '@/lib/server/agent-runtime/skill-preload';
+import {
+  MIRA_LEGACY_PROFESSIONAL_CREATION_POLICY,
+  MIRA_IMAGE_PROFESSIONAL_CREATION_POLICY,
+  MIRA_PROFESSIONAL_CREATION_POLICY,
+  isExactMiraProfessionalCreationPolicy,
+  isMiraIntegratedSkillCreationPolicy,
+  isMiraImageCreationPolicy,
+} from '@/lib/server/mira-formal-generation-policy';
+import {
+  withMiraFormalImageInstructions,
+  withMiraFormalSkillInstructions,
+} from '@/lib/server/mira-formal-professional-classroom';
+import {
+  isMiraFormalIntegratedSkillSession,
+  isMiraFormalImageSession,
+} from '@/lib/server/mira-professional-research-policy';
+import type { Scene } from '@/lib/types/stage';
+
+const model = { api: 'openai-completions', provider: 'test', id: 'test' } as const;
+let bundle: MiraFormalSkillBundle;
+let messages: AgentMessage[];
+beforeAll(async () => {
+  bundle = await prepareMiraFormalSkillBundle(await listSkills(), 'math');
+  const preload = await buildMiraFormalSkillPreload(
+    { text: 'Build the approved course.', skills: bundle.skills, transcript: [], model },
+    bundle,
+  );
+  messages = preload.messages;
+});
+
+describe('formal integrated Skills', () => {
+  it('uses exact versioned policies and preserves both historical prompt byte streams', () => {
+    const original = 'historical prompt\nwith whitespace  \n';
+    for (const policy of [
+      MIRA_LEGACY_PROFESSIONAL_CREATION_POLICY,
+      MIRA_IMAGE_PROFESSIONAL_CREATION_POLICY,
+    ]) {
+      expect(isExactMiraProfessionalCreationPolicy(policy)).toBe(true);
+      expect(isMiraIntegratedSkillCreationPolicy(policy)).toBe(false);
+      const historical = withMiraFormalImageInstructions(original, policy);
+      expect(withMiraFormalSkillInstructions(historical, policy, 'math')).toBe(historical);
+    }
+    expect(isMiraImageCreationPolicy(MIRA_PROFESSIONAL_CREATION_POLICY)).toBe(true);
+    expect(isMiraIntegratedSkillCreationPolicy(MIRA_PROFESSIONAL_CREATION_POLICY)).toBe(true);
+    expect(
+      isExactMiraProfessionalCreationPolicy({
+        ...MIRA_PROFESSIONAL_CREATION_POLICY,
+        skillOrchestration: {
+          ...MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY,
+          sceneContextRequired: false,
+        },
+      }),
+    ).toBe(false);
+    expect(formalSkillSubjectFromPrompt(original + formalSkillPromptSuffix('math'))).toBe('math');
+    expect(formalSkillReferencePaths('english')).toEqual(formalSkillReferencePaths('chinese'));
+    expect(formalSkillReferencePaths('math')[1]).toMatch(/mathematics\.md$/);
+  });
+
+  it('requires the internal formal identity and new origin, without changing public Pro', () => {
+    const formal = {
+      ownerId: `mira-formal-professional:${'a'.repeat(64)}`,
+      sessionId: `miraformal_${'a'.repeat(64)}`,
+      skillId: 'mira-primary-courseware',
+      origin: MIRA_FORMAL_SKILL_SESSION_ORIGIN,
+    };
+    expect(isMiraFormalIntegratedSkillSession(formal)).toBe(true);
+    expect(isMiraFormalImageSession(formal)).toBe(true);
+    expect(isMiraFormalIntegratedSkillSession({ ...formal, ownerId: 'anonymous-operator' })).toBe(
+      false,
+    );
+    expect(
+      isMiraFormalIntegratedSkillSession({ ...formal, origin: 'mira-formal-professional' }),
+    ).toBe(false);
+  });
+
+  it('actually reads six builtin Skills plus the two subject references and deduplicates on resume', async () => {
+    const reads = collectMiraFormalSkillReads(messages, bundle);
+    expect(reads.skillReads.map((read) => read.skillId)).toEqual(
+      MIRA_FORMAL_SKILL_ORCHESTRATION_POLICY.skillIds,
+    );
+    expect(reads.referenceReads.map((read) => read.resourcePath)).toEqual(
+      formalSkillReferencePaths('math'),
+    );
+    expect(
+      [...reads.skillReads, ...reads.referenceReads].every((read) =>
+        /^[a-f0-9]{64}$/.test(read.sourceHash),
+      ),
+    ).toBe(true);
+    expect(messages.filter((message) => message.role === 'toolResult')).toHaveLength(8);
+    const resumed = await buildMiraFormalSkillPreload(
+      { text: 'Continue.', skills: bundle.skills, transcript: messages, model },
+      bundle,
+    );
+    expect(resumed.messages).toEqual([]);
+    const publicPreload = await buildSkillPreload({
+      text: 'Public Pro',
+      forced: bundle.skills,
+      skills: bundle.skills,
+      transcript: [],
+      model,
+    });
+    expect(publicPreload.injected).toHaveLength(3);
+    expect(publicPreload.deferred).toHaveLength(3);
+  });
+
+  it('rejects missing, partial, mismatched or merely claimed read evidence', () => {
+    expect(() => collectMiraFormalSkillReads(messages.slice(2), bundle)).toThrow(
+      'FORMAL_SKILL_READ_MISSING',
+    );
+    const partial = structuredClone(messages) as Array<
+      AgentMessage & { details?: Record<string, unknown> }
+    >;
+    partial[1]!.details!.lines = 1;
+    expect(() => collectMiraFormalSkillReads(partial, bundle)).toThrow('FORMAL_SKILL_READ_MISSING');
+    const forged = structuredClone(messages) as Array<AgentMessage & { content?: unknown }>;
+    forged[1]!.content = [{ type: 'text', text: 'Skill was applied.' }];
+    expect(() => collectMiraFormalSkillReads(forged, bundle)).toThrow('FORMAL_SKILL_READ_MISSING');
+  });
+
+  it('carries source-derived page rules into content and actions with explicit formal precedence', () => {
+    const slide = composeMiraFormalSceneSkillContext(bundle, {
+      sceneType: 'slide',
+      phase: 'content',
+    });
+    expect(slide.text).toContain('The canvas you are editing inside');
+    expect(slide.text).toContain('50px');
+    expect(slide.text).toContain('两条内容红线');
+    expect(slide.text).toContain('先预测');
+    expect(slide.text).toContain('mathematics.md');
+    expect(slide.text).toContain('no 60% interactive quota');
+    expect(slide.contextSha256).toBe(createHash('sha256').update(slide.text).digest('hex'));
+    const interactive = composeMiraFormalSceneSkillContext(bundle, {
+      sceneType: 'interactive',
+      phase: 'content',
+    });
