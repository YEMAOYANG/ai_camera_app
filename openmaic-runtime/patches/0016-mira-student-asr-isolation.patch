diff --git a/e2e/tests/classroom-interaction.spec.ts b/e2e/tests/classroom-interaction.spec.ts
index 1c2e68b..f65b5e0 100644
--- a/e2e/tests/classroom-interaction.spec.ts
+++ b/e2e/tests/classroom-interaction.spec.ts
@@ -371,4 +371,34 @@ test.describe('Classroom Interaction', () => {
       'true',
     );
   });
+
+  test('keeps Mira student voice input available without changing the operator ASR preference', async ({
+    page,
+  }) => {
+    await page.addInitScript(() => {
+      const key = 'maic:account:settings-storage';
+      const raw = localStorage.getItem(key);
+      if (!raw) throw new Error('Expected seeded settings storage');
+      const settings = JSON.parse(raw);
+      settings.state.asrEnabled = false;
+      localStorage.setItem(key, JSON.stringify(settings));
+    });
+
+    await page.goto(`/classroom/${TEST_STAGE_ID}?mira=1`);
+    await expect(page.getByText('课程加载中…')).toBeHidden({ timeout: 15_000 });
+    await expect(page.locator('[data-testid="scene-item"]')).toHaveCount(3, { timeout: 10_000 });
+
+    const studentVoiceButton = page.getByRole('button', { name: '语音输入', exact: true });
+    await expect(studentVoiceButton).toBeVisible();
+    await expect(studentVoiceButton).toBeEnabled();
+
+    await page.goto(`/classroom/${TEST_STAGE_ID}`);
+    await expect(page.locator('[data-testid="scene-item"]')).toHaveCount(3, { timeout: 10_000 });
+    const operatorVoiceButton = page.getByRole('button', {
+      name: 'Voice input disabled',
+      exact: true,
+    });
+    await expect(operatorVoiceButton).toBeVisible();
+    await expect(operatorVoiceButton).toBeDisabled();
+  });
 });
