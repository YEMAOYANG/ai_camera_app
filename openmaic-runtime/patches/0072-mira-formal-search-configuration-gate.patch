+++ b/lib/server/mira-web-search-production-config.ts
@@ -0,0 +1,17 @@
+import { isServerProviderDisabled, resolveWebSearchApiKey } from '@/lib/server/provider-config';
+
+/** Configuration metadata only: no request, secret, or connectivity claim. */
+export function getMiraWebSearchProductionConfig(providerId?: string) {
+  // One argument is the legacy Tavily client-key overload. Explicit undefined
+  // is essential: the literal provider name must never be treated as a key.
+  const hasBraveKey = Boolean(resolveWebSearchApiKey('brave', undefined).trim());
+  const isBrave = providerId === 'brave';
+  return {
+    schemaVersion: 'mira.openmaic.web-search-production-config.v1',
+    providerId: providerId ?? null,
+    productionMode: isBrave ? (hasBraveKey ? 'brave_api' : 'public_html') : null,
+    formalProductionConfigured:
+      isBrave && hasBraveKey && !isServerProviderDisabled('webSearch', 'brave'),
+    verification: 'configuration_only',
+  };
+}
