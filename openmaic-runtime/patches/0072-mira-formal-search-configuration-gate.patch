--- /dev/null
+++ b/tests/server/mira-web-search-production-config.test.ts
@@ -0,0 +1,41 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+const state = vi.hoisted(() => ({ key: '', disabled: false }));
+const keyResolver = vi.hoisted(() => vi.fn());
+vi.mock('@/lib/server/provider-config', () => ({
+  resolveWebSearchApiKey: keyResolver,
+  isServerProviderDisabled: () => state.disabled,
+}));
+import { getMiraWebSearchProductionConfig } from '@/lib/server/mira-web-search-production-config';
+afterEach(() => {
+  state.key = '';
+  state.disabled = false;
+  keyResolver.mockReset();
+});
+describe('formal search configuration metadata', () => {
+  it('reports public HTML without claiming production configuration or failing health', () => {
+    keyResolver.mockReturnValue('  ');
+    expect(getMiraWebSearchProductionConfig('brave')).toMatchObject({
+      productionMode: 'public_html',
+      formalProductionConfigured: false,
+      verification: 'configuration_only',
+    });
+    expect(keyResolver).toHaveBeenCalledWith('brave', undefined);
+    expect(keyResolver.mock.calls[0]).toHaveLength(2);
+  });
+  it('reports the effective keyed mode without returning a secret or claiming connectivity', () => {
+    keyResolver.mockReturnValue('secret-test-key-not-for-output');
+    const configured = getMiraWebSearchProductionConfig('brave');
+    expect(configured).toMatchObject({
+      productionMode: 'brave_api',
+      formalProductionConfigured: true,
+      verification: 'configuration_only',
+    });
+    expect(JSON.stringify(configured)).not.toContain('secret-test-key');
+    state.disabled = true;
+    expect(getMiraWebSearchProductionConfig('brave').formalProductionConfigured).toBe(false);
+    expect(getMiraWebSearchProductionConfig('searxng')).toMatchObject({
+      productionMode: null,
+      formalProductionConfigured: false,
+    });
+  });
+});
