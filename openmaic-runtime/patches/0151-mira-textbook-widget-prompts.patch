+import { describe, expect, it } from 'vitest';
+import {
+  buildPrompt,
+  generateSceneContent,
+  generateWidgetContent,
+  type AICallFn,
+  type SceneContentOptions,
+  type SceneOutline,
+} from '@openmaic/generation';
+
+const title = 'Frozen activity title';
+const description = 'Frozen grade-bound observation';
+const keyPoints = ['Only the frozen concept'];
+const languageDirective = 'Registered teacher and language';
+const types = ['game', 'visualization3d'] as const;
+
+function outline(widgetType: (typeof types)[number]): SceneOutline {
+  return {
+    id: 'routing-fixture',
+    type: 'interactive',
+    title,
+    description,
+    keyPoints,
+    order: 1,
+    widgetType,
+    widgetOutline: {
+      gameType: 'quiz',
+      visualizationType: 'geometry',
+      objects: [],
+      interactions: [],
+    },
+  };
+}
+
+async function capture(widgetType: (typeof types)[number], options: SceneContentOptions = {}) {
+  let captured = { system: '', user: '' };
+  // This minimal response tests prompt routing, not courseware/content approval.
+  const call: AICallFn = async (system, user) => {
+    captured = { system, user };
+    return `<html><head></head><body><script type="application/json" id="widget-config">{"type":"${widgetType}"}</script></body></html>`;
+  };
+  await generateSceneContent(outline(widgetType), call, { languageDirective, ...options });
+  return captured;
+}
+
+describe('host-selected textbook widget prompt profile', () => {
+  it.each(types)(
+    'keeps the ordinary %s system and user prompts exactly unchanged',
+    async (type) => {
+      const variables =
+        type === 'game'
+          ? {
+              title,
+              description,
+              keyPoints: keyPoints.join('\n'),
+              languageDirective,
+              gameType: 'quiz',
+              scoring: { correctPoints: 10, speedBonus: 5 },
+            }
+          : {
+              title,
+              description,
+              keyPoints: keyPoints.join('\n'),
+              languageDirective,
+              visualizationType: 'geometry',
+              objects: [],
+              interactions: [],
+            };
+      expect(await capture(type)).toEqual(
+        buildPrompt(type === 'game' ? 'game-content' : 'visualization3d-content', variables),
+      );
+    },
+  );
+
+  it('does not mistake an ordinary exploration game for a textbook task', async () => {
+    const prompts = await capture('game', { explorationGame: true });
+    expect(prompts.system).toContain('# Educational Game Widget Generator');
+    expect(prompts.user).toContain('Scoring Configuration');
+    expect(prompts.user).toContain('"correctPoints": 0');
+    expect(prompts.system).not.toContain('Authoritative textbook activity contract');
+  });
+
+  it.each(types)(
+    'selects a complete textbook %s template pair with all variables resolved',
+    async (type) => {
+      const prompts = await capture(type, {
+        textbookPromptProfile: 'textbook-v1',
+        interactiveIncludeKatex: false,
+      });
+      expect(prompts.system).toContain(
+        type === 'game'
+          ? '# Textbook Picture Game Authoring v1'
+          : '# Textbook Manipulable Geometry Authoring v1',
+      );
+      expect(prompts.user).toContain(title);
+      expect(prompts.user).toContain(description);
+      expect(prompts.user).toContain(keyPoints[0]);
+      expect(prompts.user).toContain(languageDirective);
+      expect(prompts.system + prompts.user).not.toMatch(/\{\{/);
+      expect(prompts.system + prompts.user).not.toMatch(
+        /[\p{Extended_Pictographic}\u{1f1e6}-\u{1f1ff}\u20e3]/u,
+      );
+      for (const command of [
+        'SET_WIDGET_STATE',
+        'HIGHLIGHT_ELEMENT',
+        'ANNOTATE_ELEMENT',
+        'REVEAL_ELEMENT',
+      ]) {
+        expect(prompts.system).toContain(`case '${command}'`);
+      }
+      expect(prompts.system).toContain('event.source !== window.parent');
+      expect(prompts.system).toContain('const { type, state, target, content } = data');
+      expect(prompts.system).toContain("window.miraNarrate('observe')");
+      expect(prompts.system).toContain('initial HTML');
+      expect(prompts.system).toContain('min-width:48px; min-height:48px; flex-shrink:0');
+    expect(prompts.system).toContain('mira-responsive-activity');
+    expect(prompts.system).toContain('mira-narration-state');
+    expect(prompts.system).toContain('null cue ID');
+      expect(prompts.system).toContain('pairwise different actual visual signature');
+      expect(prompts.user).not.toContain('## Scoring Configuration');
+      expect(prompts.user).not.toContain('"correctPoints"');
+      expect(prompts.system).not.toContain('Achievement popups');
+    },
+  );
+
+  it('passes the explicit profile through the direct widget factory too', async () => {
+    let system = '';
+    await generateWidgetContent(
+      outline('game'),
+      async (prompt) => {
+        system = prompt;
+        return '<html><body></body></html>';
+      },
+      languageDirective,
+      { textbookPromptProfile: 'textbook-v1', includeKatex: false },
+    );
+    expect(system).toContain('# Textbook Picture Game Authoring v1');
+  });
+
+  it('gives textbook 3D real resize, opaque-origin dependency and transform instructions', async () => {
+    const prompts = await capture('visualization3d', { textbookPromptProfile: 'textbook-v1' });
+    expect(prompts.system).toContain('new ResizeObserver');
+    expect(prompts.system).toContain('renderer.setSize(width, height, false)');
+    expect(prompts.system).toContain('camera.aspect = width / height');
+    expect(prompts.system).toContain('same-host ES module URLs also require CORS');
+    expect(prompts.system).toContain('normalized nonzero orientation values');
+    expect(prompts.system).not.toContain('44px');
+    expect(prompts.user).not.toContain('Three.js from CDN');
+  });
+});
