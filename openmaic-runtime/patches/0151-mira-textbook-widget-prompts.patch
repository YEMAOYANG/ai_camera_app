+import { describe, expect, it, vi } from 'vitest';
+import type { AICallFn } from '@openmaic/generation';
+import { generateSceneContent } from '../../packages/@openmaic/generation/src/scene-generator';
+import {
+  assertTextbookBatchContent,
+  withTextbookBatchContext,
+} from '@/lib/server/mira-textbook-batch-generation';
+import { textbookContext, textbookInteractive } from '@/tests/fixtures/textbook-batch';
+
+const outline = {
+  id: 'picture-game',
+  type: 'interactive' as const,
+  title: '看图观察',
+  description: '先观察图片，再移动物体',
+  keyPoints: ['观察'],
+  order: 1,
+  widgetType: 'game' as const,
+  widgetOutline: { gameType: 'puzzle' as const },
+};
+
+async function draft(html: string) {
+  const context = textbookContext();
+  const call = vi.fn<AICallFn>(async () => html);
+  const retainRaw = vi.fn(async () => {});
+  const content = await generateSceneContent(
+    outline,
+    withTextbookBatchContext(call, context, retainRaw),
+    { textbookPromptProfile: 'textbook-v1', interactiveIncludeKatex: false },
+  );
+  return { context, call, retainRaw, content };
+}
+
+describe('actual textbook widget factory and unchanged strict guard', () => {
+  it('combines the dedicated system/user pair with exact frozen scope, retains raw, and accepts static SVG/literal cues', async () => {
+    const result = await draft(textbookInteractive().html);
+    expect(result.call).toHaveBeenCalledTimes(1);
+    expect(result.call.mock.calls[0][0]).toContain('# Textbook Picture Game Authoring v1');
+    expect(result.call.mock.calls[0][0]).toContain(result.context.requirement);
+    expect(result.call.mock.calls[0][0]).toContain('整个 HTML 源');
+    expect(result.call.mock.calls[0][1]).not.toContain('## Scoring Configuration');
+    expect(result.retainRaw).toHaveBeenCalledWith(textbookInteractive().html);
+    expect(() =>
+      assertTextbookBatchContent('interactive', result.content, result.context),
+    ).not.toThrow();
+  });
+
+  it.each([
+    [
+      'emoji in markup',
+      (html: string) => html.replace('<svg><circle r="12"/></svg>', '&#x1F34E;'),
+      'emoji_picture',
+    ],
+    [
+      'emoji in a source comment',
+      (html: string) => html.replace('</body>', '<!-- \\u{1F34E} --></body>'),
+      'emoji_picture',
+    ],
+    [
+      'guarded bridge reference',
+      (html: string) =>
+        html.replace(
+          "window.miraNarrate('intro')",
+          "window.miraNarrate && window.miraNarrate('intro')",
+        ),
+      'narration_call_must_be_fixed_cue',
+    ],
+    [
+      'computed cue',
+      (html: string) =>
+        html.replace("window.miraNarrate('intro')", 'window.miraNarrate(state.cueId)'),
+      'narration_call_must_be_fixed_cue',
+    ],
+    [
+      'only dynamically added picture markers',
+      (html: string) => html.replaceAll('data-mira-picture-choice=', 'data-example='),
+      'distinct_picture_choices_missing',
+    ],
+  ] as const)(
+    'still rejects %s after one recorded draft without retry or persistence',
+    async (_name, mutate, code) => {
+      const raw = mutate(textbookInteractive().html);
+      const result = await draft(raw);
+      expect(result.call).toHaveBeenCalledTimes(1);
+      expect(result.retainRaw).toHaveBeenCalledWith(raw);
+      expect(() =>
+        assertTextbookBatchContent('interactive', result.content, result.context),
+      ).toThrow(code);
+    },
+  );
+});
