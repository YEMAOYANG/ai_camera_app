--- /dev/null
+++ b/lib/ai/autorouter-tool-deltas.ts
@@ -0,0 +1,69 @@
+/** AutoRouter's empty tool-call header deltas mean "no new header value". */
+export function wrapAutoRouterToolCallDeltas(response: Response): Response {
+  if (!response.body) return response;
+  const started = new Map<string, { id: string; name: string }>();
+  const decoder = new TextDecoder();
+  const encoder = new TextEncoder();
+  let buffer = '';
+
+  const rewriteLine = (line: string): string => {
+    if (!line.startsWith('data:')) return line;
+    let value: unknown;
+    try { value = JSON.parse(line.slice(5).trim()); } catch { return line; }
+    if (!value || typeof value !== 'object') return line;
+    const choices = (value as { choices?: unknown }).choices;
+    if (!Array.isArray(choices)) return line;
+    let changed = false;
+    for (const [position, choice] of choices.entries()) {
+      if (!choice || typeof choice !== 'object') continue;
+      const calls = choice.delta?.tool_calls;
+      if (!Array.isArray(calls)) continue;
+      for (const call of calls) {
+        if (!call || typeof call !== 'object') continue;
+        const key = `${choice.index ?? position}:${call.index}`;
+        const previous = started.get(key);
+        const fn = call.function;
+        // Never invent an initial identity. Missing initial id/name still fails
+        // the SDK; empty continuations cannot overwrite an established identity.
+        if (call.id === '') { delete call.id; changed = true; }
+        if (fn && typeof fn === 'object' && fn.name === '') {
+          delete fn.name;
+          changed = true;
+        }
+        const sameIdentity = previous
+          && (call.id == null || call.id === previous.id)
+          && (fn?.name == null || fn.name === previous.name);
+        if (call.type === '' && sameIdentity) {
+          delete call.type;
+          changed = true;
+        }
+        if (Number.isInteger(call.index) && call.index >= 0
+          && (call.type == null || call.type === 'function')
+          && typeof call.id === 'string' && call.id.length > 0
+          && typeof fn?.name === 'string' && fn.name.length > 0 && !previous) {
+          started.set(key, { id: call.id, name: fn.name });
+        }
+        // Arguments, unknown nonempty types, and conflicting identities are
+        // deliberately untouched. The SDK remains the validation authority.
+      }
+    }
+    return changed ? 'data: ' + JSON.stringify(value) + (line.endsWith('\r') ? '\r' : '') : line;
+  };
+  const transform = new TransformStream<Uint8Array, Uint8Array>({
+    transform(bytes, controller) {
+      buffer += decoder.decode(bytes, { stream: true });
+      const lines = buffer.split('\n');
+      buffer = lines.pop() ?? '';
+      for (const line of lines) controller.enqueue(encoder.encode(rewriteLine(line) + '\n'));
+    },
+    flush(controller) {
+      buffer += decoder.decode();
+      if (buffer) controller.enqueue(encoder.encode(rewriteLine(buffer)));
+    },
+  });
+  const headers = new Headers(response.headers);
+  headers.delete('content-length');
+  return new Response(response.body.pipeThrough(transform), {
+    status: response.status, statusText: response.statusText, headers,
+  });
+}
