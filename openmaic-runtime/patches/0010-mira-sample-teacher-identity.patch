+/** Fixed visual identity for Mira's controlled Grade-1 math sample teacher. */
+export const MIRA_SAMPLE_TEACHER_ID = 'mira-sample-teacher' as const;
+export const MIRA_SAMPLE_TEACHER_AVATAR = '/avatars/teacher-2.png' as const;
+
+type TeacherAvatarIdentity = {
+  id: string;
+  role: string;
+  avatar: string;
+};
+
+/**
+ * Repair only the exact controlled sample teacher.
+ *
+ * This keeps the already-published immutable classroom artifact auditable while
+ * ensuring its in-memory UI identity matches the server-owned classroom identity.
+ * Every other generated/default/operator agent keeps its configured avatar.
+ */
+export function normalizeMiraSampleTeacherAvatar<T extends TeacherAvatarIdentity>(agent: T): T {
+  if (
+    agent.id !== MIRA_SAMPLE_TEACHER_ID ||
+    agent.role !== 'teacher' ||
+    agent.avatar === MIRA_SAMPLE_TEACHER_AVATAR
+  ) {
+    return agent;
+  }
+  return { ...agent, avatar: MIRA_SAMPLE_TEACHER_AVATAR };
+}
