+/**
+ * Keep the selected lecture teacher available before React state commits.
+ * Lecture actions can be emitted immediately after startLecture resolves, so
+ * their identity cannot depend on a later sessions-state render.
+ */
+export function createLectureAgentIdentityRegistry(): LectureAgentIdentityRegistry {
+  const agentIds = new Map<string, string>();
+  return {
+    remember(sessionId, agentId) {
+      agentIds.set(sessionId, agentId);
+    },
+    resolve(sessionId) {
+      return agentIds.get(sessionId) ?? DEFAULT_LECTURE_AGENT_ID;
+    },
+    clear(sessionId) {
+      agentIds.delete(sessionId);
+    },
+  };
+}
 
