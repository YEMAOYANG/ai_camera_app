+  const fetcher = vi.fn()
+    .mockResolvedValueOnce(response({ error: 'unavailable' }, 503))
+    .mockResolvedValueOnce(response(status(4)))
+    .mockResolvedValueOnce(response(status(5)));
+  const client = createMiraStudentRuntimeEventClient({
+    classroomId: 'classroom-a',
+    fetcher,
+    storage: memoryStorage(),
+  });
+  await expect(client.readEntryProgress()).rejects.toThrow();
+  const entry = client.readEntryProgress();
+  expect(client.readEntryProgress()).toBe(entry);
+  await entry;
+  await client.readEntryProgress();
+  expect(fetcher).toHaveBeenCalledTimes(2);
+  await client.readProgress();
+  expect(fetcher).toHaveBeenCalledTimes(3);
+});
