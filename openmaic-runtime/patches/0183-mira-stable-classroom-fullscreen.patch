+          ).toBe(true);
+          expect(
+            await child!.evaluate(() => ({
+              token: (window as any).documentToken,
+              cards: (window as any).cards,
+            })),
+          ).toEqual({ token, cards: 1 });
+          await page.getByRole("button", { name: "Exit", exact: true }).click();
+          await page.waitForFunction(() => !document.fullscreenElement);
+          expect(
+            await child!.evaluate(() => (window as any).documentToken),
+          ).toBe(token);
+        }
+        await page.getByRole("button", { name: "Pause", exact: true }).click();
+        await child!.waitForFunction(
+          () => document.querySelector("#visibility")?.textContent === "false",
+        );
+        expect(
+          await child!.evaluate(() => ({
+            cards: (window as any).cards,
+            cancels: (window as any).cancels,
+            pending: (window as any).pending,
+          })),
+        ).toEqual({ cards: 1, cancels: 1, pending: false });
+        await page.getByRole("button", { name: "Resume", exact: true }).click();
+        await child!.waitForFunction(
+          () => document.querySelector("#visibility")?.textContent === "true",
+        );
+        await page
+          .getByRole("button", { name: "Other scene", exact: true })
+          .click();
+        await child!.waitForFunction(
+          () => document.querySelector("#visibility")?.textContent === "false",
+        );
+        await page.getByRole("button", { name: "Return", exact: true }).click();
+        await child!.waitForFunction(
+          () => document.querySelector("#visibility")?.textContent === "true",
+        );
+        expect(await child!.evaluate(() => (window as any).cards)).toBe(1);
+        await page
+          .getByRole("button", { name: "Replace authored HTML", exact: true })
+          .click();
+        await child!.waitForFunction(() => (window as any).cards === 40);
+        expect(
+          await child!.evaluate(() => (window as any).documentToken),
+        ).not.toBe(token);
+      } finally {
+        await browser.close();
+      }
+    }, 30000);
+  },
+);
