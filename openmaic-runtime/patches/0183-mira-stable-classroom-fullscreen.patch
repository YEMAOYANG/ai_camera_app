new file mode 100644
--- /dev/null
+++ b/tests/scene-renderers/interactive-fullscreen-preservation.test.ts
@@ -0,0 +1,144 @@
+// @vitest-environment jsdom
+import { act, createElement } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { InteractiveIframeHost } from "@/components/scene-renderers/InteractiveIframeHost";
+import { classroomFullscreenRoot } from "@/lib/interactive/classroom-fullscreen-root";
+import { useInteractiveIframePool } from "@/lib/store/interactive-iframe-pool";
+import {
+  pausePageNarration,
+  releasePageNarrationPause,
+} from "@/lib/mira/page-narration";
+
+vi.mock("@/lib/contexts/mira-student-runtime-context", () => ({
+  useMiraStudentRuntimeEvents: () => null,
+}));
+vi.mock("@/lib/mira/student-interaction-bridge", () => ({
+  studentInteractionObjectives: () => [],
+  connectStudentInteractionFrame: vi.fn(),
+}));
+vi.mock("@/lib/hooks/use-i18n", () => ({
+  useI18n: () => ({ t: (key: string) => key }),
+}));
+let root: Root | undefined;
+let container: HTMLDivElement;
+let messages: WeakMap<HTMLIFrameElement, ReturnType<typeof vi.fn>>;
+let windows: WeakMap<HTMLIFrameElement, Window>;
+const frame = () => document.querySelector("iframe") as HTMLIFrameElement;
+
+beforeEach(() => {
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  useInteractiveIframePool.getState().reset();
+  releasePageNarrationPause();
+  messages = new WeakMap();
+  windows = new WeakMap();
+  vi.spyOn(
+    HTMLIFrameElement.prototype,
+    "contentWindow",
+    "get",
+  ).mockImplementation(function (this: HTMLIFrameElement) {
+    if (!windows.has(this)) {
+      const postMessage = vi.fn();
+      messages.set(this, postMessage);
+      windows.set(this, { postMessage } as unknown as Window);
+    }
+    return windows.get(this)!;
+  });
+  container = document.createElement("div");
+  container.dataset.miraClassroomRoot = "";
+  const mount = document.createElement("div");
+  container.append(mount);
+  document.body.append(container);
+  root = createRoot(mount);
+  const pool = useInteractiveIframePool.getState();
+  pool.mount("one", {
+    srcDoc: "<html><body>an authored activity</body></html>",
+  });
+  pool.claim("one", "owner");
+  pool.setActive("one");
+  pool.setRect("one", { left: 0, top: 0, width: 640, height: 360 });
+});
+afterEach(async () => {
+  await act(async () => root?.unmount());
+  root = undefined;
+  document.body.replaceChildren();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe("stable classroom fullscreen boundary", () => {
+  it("uses the nearest stable classroom ancestor, with a legacy standalone fallback", () => {
+    const shell = document.createElement("div");
+    container.append(shell);
+    expect(classroomFullscreenRoot(shell)).toBe(container);
+    const nested = document.createElement("div");
+    nested.dataset.miraClassroomRoot = "";
+    container.append(nested);
+    nested.append(shell);
+    expect(classroomFullscreenRoot(shell)).toBe(nested);
+    nested.removeAttribute("data-mira-classroom-root");
+    container.removeAttribute("data-mira-classroom-root");
+    expect(classroomFullscreenRoot(shell)).toBe(shell);
+  });
+  it("does not briefly mount into body while the Stage DOM ref is still null", async () => {
+    await act(async () =>
+      root!.render(createElement(InteractiveIframeHost, { container: null })),
+    );
+    expect(frame()).toBeNull();
+    await act(async () =>
+      root!.render(createElement(InteractiveIframeHost, { container })),
+    );
+    expect(container.contains(frame())).toBe(true);
+  });
+  it("preserves iframe identity and its registered window on enter, exit and repeated fullscreen", async () => {
+    await act(async () =>
+      root!.render(createElement(InteractiveIframeHost, { container })),
+    );
+    const initial = frame(),
+      windowRef = initial.contentWindow;
+    for (const fullscreen of [container, null, container, null]) {
+      Object.defineProperty(document, "fullscreenElement", {
+        configurable: true,
+        value: fullscreen,
+      });
+      await act(async () => {
+        document.dispatchEvent(new Event("fullscreenchange"));
+        root!.render(createElement(InteractiveIframeHost, { container }));
+      });
+      expect(frame()).toBe(initial);
+      expect(frame().contentWindow).toBe(windowRef);
+      expect(container.contains(frame())).toBe(true);
+    }
+    expect(frame().getAttribute("sandbox")).toBe(
+      "allow-scripts allow-forms allow-popups",
+    );
+  });
+  it("retains cancellation and explicit resume while the same fullscreen document stays mounted", async () => {
+    await act(async () =>
+      root!.render(createElement(InteractiveIframeHost, { container })),
+    );
+    const initial = frame();
+    Object.defineProperty(document, "fullscreenElement", {
+      configurable: true,
+      value: container,
+    });
+    await act(async () =>
+      document.dispatchEvent(new Event("fullscreenchange")),
+    );
+    await act(async () => pausePageNarration());
+    expect(
+      messages
+        .get(initial)!
+        .mock.calls.filter(([m]) => m.type === "MIRA_NARRATION_VISIBILITY")
+        .at(-1)?.[0].visible,
+    ).toBe(false);
+    await act(async () => releasePageNarrationPause());
+    expect(
+      messages
+        .get(initial)!
+        .mock.calls.filter(([m]) => m.type === "MIRA_NARRATION_VISIBILITY")
+        .at(-1)?.[0].visible,
+    ).toBe(true);
+    expect(frame()).toBe(initial);
+  });
+});
