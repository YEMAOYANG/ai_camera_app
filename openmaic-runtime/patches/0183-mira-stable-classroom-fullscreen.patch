+import { describe, expect, it } from "vitest";
+import { chromium } from "playwright-core";
+import { createRequire } from "node:module";
+
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== "1")(
+  "real browser pooled-iframe fullscreen",
+  () => {
+    it("keeps the child document and work through enter/exit, pauses, page return and real content replacement", async () => {
+      const require = createRequire(import.meta.url);
+      const { build } = createRequire(require.resolve("tsx"))("esbuild");
+      // Only unrelated app integrations are mocked. Host, pool, React portal,
+      // fullscreen target resolution, narration visibility and iframe are real.
+      const mocks: Record<string, string> = {
+        "@/lib/contexts/mira-student-runtime-context":
+          "export const useMiraStudentRuntimeEvents=()=>null;",
+        "@/lib/mira/student-interaction-bridge":
+          "export const studentInteractionObjectives=()=>[];export const connectStudentInteractionFrame=()=>()=>{};",
+        "@/lib/hooks/use-i18n": "export const useI18n=()=>({t:k=>k});",
+        "@/lib/store/stage":
+          "const scenes=[];export const useStageStore=selector=>selector({scenes});useStageStore.getState=()=>({scenes});",
+        "@/lib/store/canvas":
+          "const s={pickTarget:null,setPickTarget(){}};export const useCanvasStore={use:{pickTarget:()=>null},getState:()=>s};",
+        "@/lib/store/element-refs":
+          "const refs=[];export const useElementRefsStore={use:{refs:()=>refs},getState:()=>({refs})};",
+      };
+      const html = `<!doctype html><html><head><meta name="mira-responsive-activity" content="low-reading-v1"></head><body>
+<button id="make">Make observation card</button><output id="album">0</output><output id="visibility">waiting</output>
+<script>window.documentToken=Math.random().toString(36);window.cards=0;window.cancels=0;window.pending=false;make.onclick=()=>{album.textContent=String(++cards);pending=true};addEventListener('message',e=>{if(e.source===parent&&e.data?.type==='MIRA_NARRATION_VISIBILITY'){visibility.textContent=String(e.data.visible);if(!e.data.visible&&pending){pending=false;cancels++}}});</script></body></html>`;
+      const bundle = await build({
+        stdin: {
+          resolveDir: process.cwd(),
+          loader: "tsx",
+          contents: `
+import React,{useState} from 'react';import {createRoot} from 'react-dom/client';
+import {InteractiveIframeHost} from './components/scene-renderers/InteractiveIframeHost';
+import {classroomFullscreenRoot} from './lib/interactive/classroom-fullscreen-root';
+import {useInteractiveIframePool} from './lib/store/interactive-iframe-pool';
+import {pausePageNarration,releasePageNarrationPause} from './lib/mira/page-narration';
+const initial=${JSON.stringify(html)};const pool=useInteractiveIframePool.getState();
+for(const id of ['one','two']){pool.mount(id,{srcDoc:initial});pool.claim(id,id);pool.setRect(id,{left:20,top:100,width:600,height:300});}pool.setActive('one');
+function App(){const [container,setContainer]=useState(null);return <div data-mira-classroom-root ref={setContainer} style={{width:'100vw',height:'100vh',background:'white'}}><div id="shell"><button id="fullscreen" onClick={()=>classroomFullscreenRoot(document.querySelector('#shell')).requestFullscreen()}>Fullscreen</button><button id="exit" onClick={()=>document.exitFullscreen()}>Exit</button><button id="pause" onClick={()=>pausePageNarration()}>Pause</button><button id="resume" onClick={()=>releasePageNarrationPause()}>Resume</button><button id="other" onClick={()=>pool.setActive('two')}>Other scene</button><button id="back" onClick={()=>pool.setActive('one')}>Return</button><button id="replace" onClick={()=>pool.mount('one',{srcDoc:initial.replace('window.cards=0','window.cards=40')})}>Replace authored HTML</button></div><InteractiveIframeHost container={container}/></div>};createRoot(document.querySelector('#app')).render(<App/>);`,
+        },
+        bundle: true,
+        write: false,
+        format: "iife",
+        platform: "browser",
+        logLevel: "silent",
+        define: { "process.env.NODE_ENV": '"test"' },
+        plugins: [
+          {
+            name: "isolated-app-integrations",
+            setup(b: any) {
+              b.onResolve({ filter: /^@\// }, (args: any) =>
+                mocks[args.path]
+                  ? { path: args.path, namespace: "test-mock" }
+                  : undefined,
+              );
+              b.onLoad(
+                { filter: /.*/, namespace: "test-mock" },
+                (args: any) => ({ contents: mocks[args.path], loader: "js" }),
+              );
+            },
+          },
+        ],
+      });
+      const browser = await chromium.launch({
+        executablePath:
+          process.env.MIRA_FORMAL_QA_BROWSER_PATH ||
+          "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
+        headless: true,
+      });
+      try {
+        const page = await browser.newPage({
+          viewport: { width: 800, height: 600 },
+        });
+        await page.route("**/*", (route) => route.abort());
+        await page.setContent('<div id="app"></div>');
+        await page.addScriptTag({ content: bundle.outputFiles[0].text });
+        const iframe = page.locator('iframe[title="Interactive Scene one"]');
+        const child = await (await iframe.elementHandle())!.contentFrame();
+        await child!
+          .getByRole("button", { name: "Make observation card" })
+          .click();
+        const token = await child!.evaluate(
+          () => (window as any).documentToken,
+        );
+        await page.evaluate(() => {
+          (window as any).originalFrame = document.querySelector(
+            'iframe[title="Interactive Scene one"]',
+          );
+          (window as any).originalWindow = (
+            window as any
+          ).originalFrame.contentWindow;
+        });
+        for (let n = 0; n < 2; n++) {
+          await page
+            .getByRole("button", { name: "Fullscreen", exact: true })
+            .click();
+          await page.waitForFunction(() =>
+            document.fullscreenElement?.hasAttribute(
+              "data-mira-classroom-root",
+            ),
+          );
+          expect(
+            await page.evaluate(
+              () =>
+                document.querySelector(
