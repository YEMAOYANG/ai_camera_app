diff --git a/lib/interactive/classroom-fullscreen-root.ts b/lib/interactive/classroom-fullscreen-root.ts
new file mode 100644
--- /dev/null
+++ b/lib/interactive/classroom-fullscreen-root.ts
@@ -0,0 +1,13 @@
+/** Fullscreen the stable ancestor shared by playback and pooled activities.
+ * Requesting fullscreen on the inner playback shell would force the iframe
+ * portal to move and recreate the child document, losing its learning state.
+ * An isolated legacy playback shell retains its original fullscreen target.
+ */
+export function classroomFullscreenRoot(
+  playbackShell: HTMLElement,
+): HTMLElement {
+  return (
+    playbackShell.closest<HTMLElement>("[data-mira-classroom-root]") ??
+    playbackShell
+  );
+}
