+    throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_ORIGINAL_NOT_PROVEN');
+  const originalEvidence = await readMiraEnglishPronunciationRepairEvidence({asrRequestId: input.asrRequestId,
+    tts: source.tts, asr: source.asr, text: input.text});
+  if (qualitySha(originalEvidence) !== qualitySha(source.englishPronunciationRepair))
+    throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_ORIGINAL_CHANGED');
+  const tts = await readMiraFormalTtsJob(`${source.tts.requestId}.repair1`);
+  const priorAsr = await readMiraFormalAsrJob(`${input.asrRequestId}.repair1`);
+  if (!tts || !priorAsr || tts.requestId !== `${source.tts.requestId}.repair1` ||
+      priorAsr.requestId !== `${input.asrRequestId}.repair1` ||
+      tts.kind !== 'tts' || priorAsr.kind !== 'asr' || tts.state !== 'succeeded' || priorAsr.state !== 'succeeded' ||
+      tts.providerId !== 'qwen-tts' || tts.modelId !== 'qwen3-tts-flash' || tts.fallbackUsed !== false ||
+      priorAsr.providerId !== 'qwen-asr' || priorAsr.modelId !== 'qwen3-asr-flash' || priorAsr.fallbackUsed !== false ||
+      priorAsr.ttsRequestId !== tts.requestId || priorAsr.audioSha256 !== tts.audioSha256 ||
+      !Number.isSafeInteger(priorAsr.similarityBps) || (priorAsr.similarityBps ?? 0) < 8500 ||
+      (priorAsr.similarityBps ?? 10001) > 10000 || priorAsr.providerDiagnostic ||
+      'operatorRepair' in tts || 'operatorRepair' in priorAsr ||
