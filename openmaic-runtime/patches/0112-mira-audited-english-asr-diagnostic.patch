+      priorAsr.requestSha256 !== qualitySha({...identity, requestId: priorAsr.requestId, ttsRequestId: tts.requestId, audioSha256: tts.audioSha256}))
+    throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_REPAIR_REQUEST_CHANGED');
+  const archive = await verifiedEnglishTranscript(priorAsr, input.text);
+  if (miraEnglishPronunciationTermsPreserved(input.text, archive.transcript))
+    throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_STRICT_TERMS_DID_NOT_FAIL');
+  const asset = await readMiraFormalTtsAsset(tts.requestId);
+  if (qualitySha(asset.record) !== qualitySha(tts) || sha(asset.bytes) !== tts.audioSha256)
+    throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_REPAIR_WAV_CHANGED');
+  const evidence = {policyVersion: MIRA_ENGLISH_REPAIR_ASR_DIAGNOSTIC_POLICY,
+    originalAsrRequestId: input.asrRequestId, sourceSha256: qualitySha(source),
+    originalPronunciationEvidenceSha256: qualitySha(originalEvidence), sourceTextSha256: sha(input.text),
+    repairTtsSha256: qualitySha(tts), repairAsrSha256: qualitySha(priorAsr),
+    repairAudioSha256: tts.audioSha256!, repairTranscriptArchiveSha256: qualitySha(archive)};
+  return {evidence, tts, priorAsr, bytes: asset.bytes};
+}
+
+/** Prepare is read-only and cannot create a diagnostic dispatch or promotion. */
+export async function readMiraEnglishRepairAsrDiagnosticSource(input: EnglishRepairDiagnosticInput) {
+  return (await englishDiagnosticContext(input)).evidence;
+}
+
+/** One distinct ASR job on the already paid repair WAV; no TTS or hints. */
+export async function diagnoseMiraEnglishRepairAsr(input: EnglishRepairDiagnosticInput) {
+  const context = await englishDiagnosticContext(input);
+  const folder = englishDiagnosticFolder(input.asrRequestId);
+  await fs.mkdir(folder, {recursive: true, mode: 0o700});
+  const lock = await acquireFormalQualityLock(path.join(folder, 'diagnostic.lock'));
+  try {
+    const sourcePath = path.join(folder, 'source.json');
+    try {
+      if (qualitySha(JSON.parse(await fs.readFile(sourcePath, 'utf8'))) !== qualitySha(context.evidence))
+        throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_SOURCE_CHANGED');
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      await writeJsonFileAtomic(sourcePath, context.evidence);
+    }
+    const identity = Object.fromEntries(identityKeys.map(key => [key, context.tts[key]]));
+    const request = {...identity, requestId: `${input.asrRequestId}.repair1.diagnostic1`,
+      ttsRequestId: context.tts.requestId, audioSha256: context.tts.audioSha256!} as MiraFormalAsrRequest;
+    const result = await executeMiraEnglishRepairAsrDiagnostic(request, qualitySha(context.evidence), {
+      transcriptEvidence: transcript => {
+        const actual = prepareMiraFormalAsrComparisonText(transcript, 'english');
+        return {normalizedTranscriptSha256: sha(normalizeMiraFormalAsrText(actual)),
+          similarityBps: miraFormalAsrSimilarityBps(prepareMiraFormalAsrComparisonText(input.text, 'english'), actual)};
+      },
+    });
+    const receipt = {policyVersion: MIRA_ENGLISH_REPAIR_ASR_DIAGNOSTIC_POLICY, source: context.evidence, asr: result.record};
+    // Retain failed/ambiguous results too. The fixed job ID never grants a retry.
+    await writeJsonFileAtomic(path.join(folder, 'receipt.json'), receipt);
+    await readMiraEnglishRepairAsrDiagnostic({...input, receiptSha256: qualitySha(receipt)});
+    return {diagnosticAsrRequestId: result.record.requestId, receiptSha256: qualitySha(receipt),
+      similarityBps: result.record.similarityBps};
+  } finally { await lock.release(); }
+}
+
+/** Adoption and completion re-read all source/WAV/transcript/provider proofs. */
+export async function readMiraEnglishRepairAsrDiagnostic(input: EnglishRepairDiagnosticInput & {receiptSha256: string}) {
+  if (!/^[a-f0-9]{64}$/.test(input.receiptSha256)) throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_RECEIPT_INVALID');
+  const {evidence, tts, priorAsr, bytes} = await englishDiagnosticContext(input);
+  const folder = englishDiagnosticFolder(input.asrRequestId);
+  const receipt = JSON.parse(await fs.readFile(path.join(folder, 'receipt.json'), 'utf8'));
+  const savedSource = JSON.parse(await fs.readFile(path.join(folder, 'source.json'), 'utf8'));
+  const asr = await readMiraFormalAsrJob(`${input.asrRequestId}.repair1.diagnostic1`);
+  if (qualitySha(receipt) !== input.receiptSha256 || receipt.policyVersion !== MIRA_ENGLISH_REPAIR_ASR_DIAGNOSTIC_POLICY ||
+      qualitySha(receipt.source) !== qualitySha(evidence) || qualitySha(savedSource) !== qualitySha(evidence) ||
+      !asr || qualitySha(receipt.asr) !== qualitySha(asr) || asr.requestId !== `${input.asrRequestId}.repair1.diagnostic1` ||
+      asr.kind !== 'asr' || asr.providerId !== 'qwen-asr' || asr.modelId !== 'qwen3-asr-flash' || asr.fallbackUsed !== false ||
+      'operatorRepair' in asr)
+    throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_RECEIPT_NOT_PROVEN');
+  const identity = Object.fromEntries(identityKeys.map(key => [key, tts[key]]));
+  const request = {...identity, requestId: asr.requestId, ttsRequestId: tts.requestId, audioSha256: tts.audioSha256};
+  const diagnosticProfile = {policyVersion: MIRA_ENGLISH_REPAIR_ASR_DIAGNOSTIC_POLICY, sourceEvidenceSha256: qualitySha(evidence)};
+  const providerRequest = {model: 'qwen3-asr-flash', input: {messages: [{role: 'user', content: [
+    {audio: `data:audio/wav;base64,${Buffer.from(bytes).toString('base64')}`},
+  ]}]}, parameters: {asr_options: {}}};
+  if (asr.requestSha256 !== qualitySha({logicalRequest: request, diagnosticProfile}) ||
+      qualitySha(asr.providerDiagnostic) !== qualitySha({...diagnosticProfile, providerBodySha256: qualitySha(providerRequest)}))
+    throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_PROVIDER_INPUT_NOT_PROVEN');
+  if (asr.state !== 'succeeded') throw new Error('AUDIO_ENGLISH_DIAGNOSTIC_NOT_SUCCEEDED');
+  await verifiedEnglishTranscript(asr, input.text);
+  await assertMiraEnglishPronunciationRepairResult({text: input.text, tts, asr});
+  return {tts, asr, priorAsr, receipt};
 }
 
