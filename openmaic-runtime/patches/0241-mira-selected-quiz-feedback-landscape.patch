+
+/* Selected feedback is a third task region, never the question replay control.
+   Keep the actual picture, explanation, and prerecorded replay together even
+   in a short landscape classroom. Text may scroll within its own cell; the
+   meaningful picture and replay control remain fully visible. */
+@container fixed-picture-quiz (min-width: 561px) and (max-height: 260px) {
+  .task:has([data-quiz-selected-feedback]) {
+    grid-template-columns: minmax(72px, .5fr) 100px minmax(156px, .8fr) minmax(180px, 1.4fr);
+    align-items: stretch;
+  }
+  .task:has([data-quiz-selected-feedback]):not(:has(.scenePicture)) {
+    grid-template-columns: 100px minmax(140px, .85fr) minmax(220px, 1.4fr);
+  }
+  .task:has([data-quiz-selected-feedback]) .question > div[data-quiz-selected-feedback] {
+    grid-column: -2 / -1;
+    grid-row: 1;
+    align-self: stretch;
+    min-width: 0;
+    min-height: 0;
+    margin: 0;
+    padding: 4px;
+    display: grid;
+    grid-template-columns: minmax(64px, .8fr) minmax(100px, 1.2fr);
+    grid-template-rows: minmax(0, 1fr) auto;
+    gap: 4px;
+  }
+  .question > div[data-quiz-selected-feedback] > [data-quiz-feedback-picture] {
+    grid-column: 1;
+    grid-row: 1 / 3;
+    min-width: 0;
+    min-height: 0;
+    height: 100%;
+    margin: 0;
+  }
+  .question [data-quiz-feedback-picture] > [data-quiz-visual],
+  .question [data-quiz-feedback-picture] [data-quiz-visual] > img {
+    width: 100%;
+    height: 100%;
+    min-height: 0;
+    max-height: 100%;
+    object-fit: contain;
+  }
+  .question > div[data-quiz-selected-feedback] > p {
+    grid-column: 2;
+    grid-row: 1;
+    min-width: 0;
+    min-height: 0;
+    margin: 0;
+    font-size: 13px;
+    line-height: 17px;
+    overflow-y: auto;
+  }
+  .question > div[data-quiz-selected-feedback] > div:not([data-quiz-feedback-picture]) {
+    grid-column: 2;
+    grid-row: 2;
+    min-width: 0;
+    margin: 0;
+  }
+  .question > div[data-quiz-selected-feedback] > div:not([data-quiz-feedback-picture]) > button {
+    width: 100%;
+    min-width: 48px;
+    min-height: 48px;
+    height: 48px;
+    padding: 0 8px;
+    justify-content: center;
+    gap: 4px;
+    font-size: 14px;
+  }
+}
