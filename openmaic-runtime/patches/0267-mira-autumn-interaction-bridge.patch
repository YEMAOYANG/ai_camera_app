@@ -0,0 +1,91 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+import { createMiraStudentRuntimeEventClient } from './lib/mira/student-runtime-events';
+import { connectCourseOperationFrame, COURSE_OPERATION_SHIM } from './lib/mira/course-operation-bridge';
+
+test('sandbox supports securely random operation ids when randomUUID is unavailable', async () => {
+  const handlers = new Map<string, (event: any) => void>();
+  const parent = {};
+  const window = {
+    parent,
+    crypto: { getRandomValues: (values: Uint8Array) => { values.fill(42); return values; } },
+    addEventListener: (name: string, callback: (event: any) => void) => handlers.set(name, callback),
+    dispatchEvent: () => true,
+  };
+  class CustomEvent { constructor(public type: string, public options?: unknown) {} }
+  class Event { constructor(public type: string) {} }
+  const script = COURSE_OPERATION_SHIM.replace(/^<script[^>]*>/, '').replace(/<\/script>$/, '');
+  vm.runInNewContext(script, {window, crypto: window.crypto, document: {readyState: 'complete'},
+    Uint8Array, Array, Map, Promise, CustomEvent, Event});
+  const sent: any[] = [];
+  const port = {postMessage: (message: any) => sent.push(message), close: () => {}, onmessage: null as any};
+  handlers.get('message')?.({source: parent, data: {type: 'mira:course-operation-connect'}, ports: [port]});
+  port.onmessage({data: {type: 'mira:course-operation-authorized', sceneId: 'scene-p2'}});
+  const result = (window as any).miraCourseOperation.send({name: 'start'});
+  await Promise.resolve();
+  const event = sent.find(message => message.type === 'mira:course-operation');
+  assert.match(event.operationId, /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
+  port.onmessage({data: {type: 'mira:course-operation-ack', operationId: event.operationId}});
+  await result;
+});
+
+test('identical real operations retain distinct ids while pending retry is idempotent', async () => {
+  let last = 0, failOnce = true;
+  const accepted = new Map<number, unknown>();
+  const fetcher: typeof fetch = async (_url, init) => {
+    if (init?.method === 'GET') return Response.json({ok:true, schemaVersion:'mira.openmaic.student-runtime-event-receipt.v1',
+      runtimeSessionId:'runtime', lastSequence:last, nextSequence:last+1, completed:false, completionReady:false, answeredQuestionIds:[]});
+    const event = JSON.parse(String(init?.body));
+    if (!accepted.has(event.sequence)) { accepted.set(event.sequence,event); last=event.sequence; }
+    if (failOnce) { failOnce=false; throw new Error('lost acknowledgement'); }
+    return Response.json({ok:true,sequence:event.sequence,receiptSha256:'a'.repeat(64)});
+  };
+  const memory = new Map<string,string>();
+  const storage = {getItem:(k:string)=>memory.get(k)??null,setItem:(k:string,v:string)=>void memory.set(k,v),
+    removeItem:(k:string)=>void memory.delete(k),clear:()=>memory.clear(),key:()=>null,get length(){return memory.size;}} as Storage;
+  const client = createMiraStudentRuntimeEventClient({classroomId:'room', fetcher,storage});
+  const op = (operationId:string) => client.courseOperation({sceneId:'scene-p3',sceneIndex:2,
+    contractSha256:'a'.repeat(64),operationId,operation:{name:'add'}});
+  await assert.rejects(op('first'));
+  await client.resume(); await op('second');
+  assert.equal(accepted.size,2);
+  assert.equal((accepted.get(1) as any).payload.operationId,'first');
+  assert.equal((accepted.get(2) as any).payload.operationId,'second');
+});
+
+test('host sends only its own bound scene and rejects inactive page actions', async () => {
+  let port: MessagePort | null = null, active = true, saved: any = null;
+  const frame = {contentWindow:{postMessage:(_data:any,_origin:string,ports:MessagePort[])=>{port=ports[0];}},
+    addEventListener:()=>{},removeEventListener:()=>{}} as unknown as HTMLIFrameElement;
+  const dispose = connectCourseOperationFrame({frame,sceneId:'scene-p2',sceneIndex:1,contractSha256:'a'.repeat(64),
+    active:()=>active,events:{resume:async()=>{},getCourseSceneState:()=>({phase:'ready'}),courseOperation:async (p:any)=>{saved=p;}} as any,onError:()=>{}});
+  const channel = port!;
+  const next = () => new Promise<any>(resolve => {channel.onmessage = e => resolve(e.data);});
+  let response=next(); channel.postMessage({type:'mira:course-operation-ready'});
+  assert.deepEqual(await response,{type:'mira:course-operation-restore',sceneId:'scene-p2',serverState:{phase:'ready'}});
+  response=next();channel.postMessage({type:'mira:course-operation-restored',matches:true});
+  assert.equal((await response).type,'mira:course-operation-authorized');
+  response=next();channel.postMessage({type:'mira:course-operation',operationId:'one',operation:{name:'start'},sceneId:'forged'});
+  assert.equal((await response).type,'mira:course-operation-ack');
+  assert.equal(saved.sceneId,'scene-p2');
+  active=false;response=next();channel.postMessage({type:'mira:course-operation',operationId:'two',operation:{name:'start'}});
+  assert.equal((await response).type,'mira:course-operation-error');
+  dispose();channel.close();
+});
+
+test('mismatched restored screen cannot send an operation', async () => {
+  let port: MessagePort | null = null, errors=0, writes=0;
+  const frame = {contentWindow:{postMessage:(_data:any,_origin:string,ports:MessagePort[])=>{port=ports[0];}},
+    addEventListener:()=>{},removeEventListener:()=>{}} as unknown as HTMLIFrameElement;
+  const dispose = connectCourseOperationFrame({frame,sceneId:'scene-p2',sceneIndex:1,contractSha256:'a'.repeat(64),
+    active:()=>true,events:{resume:async()=>{},getCourseSceneState:()=>({phase:'playing'}),courseOperation:async()=>{writes++;}} as any,
+    onError:()=>{errors++;}});
+  const channel=port!;
+  const next=()=>new Promise<any>(resolve=>{channel.onmessage=e=>resolve(e.data);});
+  let response=next();channel.postMessage({type:'mira:course-operation-ready'});await response;
+  channel.postMessage({type:'mira:course-operation-restored',matches:false});
+  response=next();channel.postMessage({type:'mira:course-operation',operationId:'x',operation:{name:'add'}});
+  assert.equal((await response).type,'mira:course-operation-error');assert.equal(writes,0);assert.equal(errors,1);
+  dispose();channel.close();
+});
