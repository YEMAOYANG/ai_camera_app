+}
+
+/** Installed in the sandbox only; no host identity or completion assertion originates here. */
+export const COURSE_OPERATION_SHIM = `<script data-mira-course-operation>
+(function () {
+  var port=null, ready=false, pending=new Map(), tail=Promise.resolve(), adapter=null;
+  // randomUUID is restricted to secure contexts; getRandomValues remains
+  // available in ordinary HTTP classroom sandboxes and is still cryptographic.
+  function operationId(){
+    if(!window.crypto || typeof crypto.getRandomValues!=='function') throw new Error('operation_unavailable');
+    var bytes=new Uint8Array(16);crypto.getRandomValues(bytes);
+    bytes[6]=(bytes[6]&15)|64;bytes[8]=(bytes[8]&63)|128;
+    var hex=Array.from(bytes,function(v){return v.toString(16).padStart(2,'0');}).join('');
+    return hex.slice(0,8)+'-'+hex.slice(8,12)+'-'+hex.slice(12,16)+'-'+hex.slice(16,20)+'-'+hex.slice(20);
+  }
+  var api=Object.freeze({get ready(){return ready;}, restoreConfirmed:function(matches){
+    if(port)port.postMessage({type:'mira:course-operation-restored',matches:matches===true});
+  }, send:function(operation){
+    if(!ready || !port) return Promise.reject(new Error('operation_unavailable'));
+    var id;try{id=operationId();}catch(error){return Promise.reject(error);}
+    var run=function(){return new Promise(function(resolve,reject){
+      if(!ready || !port){reject(new Error('operation_unavailable'));return;}
+      pending.set(id,{resolve:resolve,reject:reject});
+      try {port.postMessage({type:'mira:course-operation',operationId:id,operation:operation});}
+      catch(error){pending.delete(id);ready=false;reject(error);}
+    });};
+    var result=tail.then(run); tail=result.catch(function(){ready=false;window.dispatchEvent(new Event('mira-course-operation-error'));});
+    return result;
+  }});
+  Object.defineProperty(window,'miraCourseOperation',{value:api,configurable:false,writable:false});
+  window.addEventListener('message',function(event){
+    if(event.source!==window.parent || event.data?.type!=='mira:course-operation-connect' || !event.ports[0])return;
+    if(port)port.close();ready=false;if(adapter){adapter.dispose();adapter=null;}
+    pending.forEach(function(entry){entry.reject(new Error('operation_connection_changed'));});pending.clear();
+    port=event.ports[0];
+    port.onmessage=function(message){var data=message.data;
+      if(data?.type==='mira:course-operation-authorized'){ready=true;window.dispatchEvent(new CustomEvent('mira-course-operation-ready',{detail:{sceneId:data.sceneId}}));return;}
+      if(data?.type==='mira:course-operation-restore'){
+        ready=false;
+        if(/^scene-p(?:8|9|10|11|12)$/.test(data.sceneId) && typeof window.installAutumnCourseAdapter==='function'){
+          if(adapter)adapter.dispose();adapter=window.installAutumnCourseAdapter(data.sceneId);
+        }
+        window.dispatchEvent(new CustomEvent('mira-course-operation-restore',{detail:{sceneId:data.sceneId,serverState:data.serverState}}));return;
+      }
+      if(data?.type==='mira:course-operation-unavailable'){ready=false;pending.forEach(function(entry){entry.reject(new Error('operation_unavailable'));});pending.clear();return;}
+      var entry=pending.get(data?.operationId);if(!entry)return;pending.delete(data.operationId);
+      if(data.type==='mira:course-operation-ack')entry.resolve(true);
+      else {ready=false;entry.reject(new Error('operation_not_saved'));}
+    };
+    var openedPort=port;
+    var announce=function(){if(port===openedPort)openedPort.postMessage({type:'mira:course-operation-ready'});};
+    if(document.readyState==='complete')announce();else window.addEventListener('load',announce,{once:true});
+  });
+})();
+</script>`;
