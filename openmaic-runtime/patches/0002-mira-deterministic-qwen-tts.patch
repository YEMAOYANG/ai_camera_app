diff --git a/lib/server/mira-tts-policy.ts b/lib/server/mira-tts-policy.ts
new file mode 100644
index 0000000..dceb4ce
--- /dev/null
+++ b/lib/server/mira-tts-policy.ts
@@ -0,0 +1,70 @@
+import { TTS_PROVIDERS } from '@/lib/audio/constants';
+
+export const MIRA_QWEN_TTS_PROVIDER_ID = 'qwen-tts' as const;
+
+const ALLOWED_MODELS = new Set(['qwen3-tts-flash']);
+const ALLOWED_TEACHER_VOICES = new Set(['Serena']);
+
+export interface MiraTtsPolicy {
+  enforced: true;
+  providerId: typeof MIRA_QWEN_TTS_PROVIDER_ID;
+  modelId: string;
+  voiceId: string;
+}
+
+export function getMiraTtsPolicy(
+  env: Readonly<Record<string, string | undefined>> = process.env,
+): MiraTtsPolicy | null {
+  const required = env.MIRA_OPENMAIC_REQUIRE_QWEN_TTS;
+  if (required === undefined || required === '' || required === '0') return null;
+  if (required !== '1') {
+    throw new Error('MIRA_OPENMAIC_REQUIRE_QWEN_TTS must be exactly 0 or 1');
+  }
+
+  const modelId = env.MIRA_OPENMAIC_QWEN_TTS_MODEL || 'qwen3-tts-flash';
+  if (!ALLOWED_MODELS.has(modelId)) {
+    throw new Error(`Unsupported deterministic Qwen3-TTS model: ${modelId}`);
+  }
+
+  const voiceId = env.MIRA_OPENMAIC_QWEN_TTS_VOICE || 'Serena';
+  const qwenVoices = new Set(
+    TTS_PROVIDERS[MIRA_QWEN_TTS_PROVIDER_ID].voices.map((voice) => voice.id),
+  );
+  if (!ALLOWED_TEACHER_VOICES.has(voiceId) || !qwenVoices.has(voiceId)) {
+    throw new Error(`Unsupported deterministic Qwen3-TTS teacher voice: ${voiceId}`);
+  }
+
+  return {
+    enforced: true,
+    providerId: MIRA_QWEN_TTS_PROVIDER_ID,
+    modelId,
+    voiceId,
+  };
+}
+
+export function assertMiraTtsProviderReady(
+  policy: MiraTtsPolicy | null,
+  providers: Record<string, { disabled?: boolean }>,
+): void {
+  if (!policy) return;
+  const provider = providers[policy.providerId];
+  if (!provider || provider.disabled) {
+    throw new Error('Deterministic Qwen3-TTS is required but qwen-tts is not server-configured');
+  }
+}
+
+export function getMiraTeacherVoiceConfig(
+  role: string,
+  policy: MiraTtsPolicy | null,
+): { providerId: string; modelId: string; voiceId: string } | undefined {
+  if (role !== 'teacher' || !policy) return undefined;
+  return { providerId: policy.providerId, modelId: policy.modelId, voiceId: policy.voiceId };
+}
+
+export function getMiraTeacherName(
+  role: string,
+  currentName: string,
+  policy: MiraTtsPolicy | null,
+): string {
+  return role === 'teacher' && policy ? '小数老师' : currentName;
+}
