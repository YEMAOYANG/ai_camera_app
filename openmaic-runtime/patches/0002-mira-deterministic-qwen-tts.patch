+import { describe, expect, test } from 'vitest';
+import {
+  assertMiraTtsProviderReady,
+  getMiraTeacherName,
+  getMiraTeacherVoiceConfig,
+  getMiraTtsPolicy,
+} from '@/lib/server/mira-tts-policy';
+
+describe('Mira deterministic Qwen3-TTS policy', () => {
+  test('is disabled unless explicitly opted in', () => {
+    expect(getMiraTtsPolicy({})).toBeNull();
+  });
+
+  test('pins the hosted-like Serena voice and Qwen3 model', () => {
+    const policy = getMiraTtsPolicy({ MIRA_OPENMAIC_REQUIRE_QWEN_TTS: '1' });
+    expect(policy).toEqual({
+      enforced: true,
+      providerId: 'qwen-tts',
+      modelId: 'qwen3-tts-flash',
+      voiceId: 'Serena',
+    });
+    expect(getMiraTeacherVoiceConfig('teacher', policy)).toEqual({
+      providerId: 'qwen-tts',
+      modelId: 'qwen3-tts-flash',
+      voiceId: 'Serena',
+    });
+    expect(getMiraTeacherVoiceConfig('student', policy)).toBeUndefined();
+    expect(getMiraTeacherName('teacher', '随机教师名', policy)).toBe('小数老师');
+    expect(getMiraTeacherName('student', '小明', policy)).toBe('小明');
+  });
+
+  test('rejects unreviewed model and voice identities', () => {
+    expect(() =>
+      getMiraTtsPolicy({
+        MIRA_OPENMAIC_REQUIRE_QWEN_TTS: '1',
+        MIRA_OPENMAIC_QWEN_TTS_MODEL: 'qwen3-tts-instruct-flash',
+      }),
+    ).toThrow(/Unsupported deterministic Qwen3-TTS model/);
+    expect(() =>
+      getMiraTtsPolicy({
+        MIRA_OPENMAIC_REQUIRE_QWEN_TTS: '1',
+        MIRA_OPENMAIC_QWEN_TTS_VOICE: 'Cherry',
+      }),
+    ).toThrow(/Unsupported deterministic Qwen3-TTS teacher voice/);
+  });
+
+  test('requires the server-managed qwen-tts provider', () => {
+    const policy = getMiraTtsPolicy({ MIRA_OPENMAIC_REQUIRE_QWEN_TTS: '1' });
+    expect(() => assertMiraTtsProviderReady(policy, {})).toThrow(/not server-configured/);
+    expect(() => assertMiraTtsProviderReady(policy, { 'qwen-tts': { disabled: true } })).toThrow(
+      /not server-configured/,
+    );
+    expect(() => assertMiraTtsProviderReady(policy, { 'qwen-tts': {} })).not.toThrow();
+  });
+});
