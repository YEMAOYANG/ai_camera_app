 import type { Scene } from '@/lib/types/stage';
 import { fixedQuizManagedSpeechIds } from './fixed-quiz-narration';
+
+/** Private operator playback shares cue ownership, never student grading. */
+export function usesTextbookPageNarration(stage: unknown): boolean {
+  if (!stage || typeof stage !== 'object') return false;
+  const value = stage as { fixedTextbook?: unknown; miraTextbookPreviewNarration?: unknown };
+  return value.fixedTextbook === true || value.miraTextbookPreviewNarration === true;
+}
+
+/** Skipping page-owned speech emits no lecture audio. Do not briefly hide the
+ * active game's narration merely because the cursor traverses those actions. */
+export function lectureModeOwnsAudio(mode: string, scene: Scene, managed: ReadonlySet<string>): boolean {
+  if (mode === 'live') return true;
+  if (mode !== 'playing') return false;
+  const actions = scene.actions ?? [];
+  return !(actions.length > 0 && actions.every(action => action.type === 'speech' && managed.has(action.id)));
+}
 
