+async function archiveEmptySpeechFailure(record: TeachingConversation, deps: Deps) {
+  const content = JSON.stringify(record);
+  const path = join(directory(record.id, deps), `failed-empty-speech-revision-${record.revision}.json`);
+  try {
+    const handle = await open(path, 'wx', 0o600);
+    try { await handle.writeFile(content); await handle.sync(); } finally { await handle.close(); }
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST' || await readFile(path, 'utf8') !== content) throw error;
+  }
+  return { reason: 'no_visible_teaching_speech' as const, failedRevision: record.revision,
+    failedRecordSha256: textSha(content) };
+}
