+/** Applied only by the trusted required-teaching execution path, including saved conversations. */
+export const CLASSROOM_SPEAKER_IDENTITY_VERSION = 'mira.classroom-speaker-identity.v1';
+
+export const REQUIRED_LEARNER_IDENTITY_PROMPT = `
+# Real learner and virtual classmates (${CLASSROOM_SPEAKER_IDENTITY_VERSION})
+- Messages marked [Real learner / 真人学生] come from the real child using this classroom's text or voice input. They are never a virtual classmate's turn.
+- Names in the course script, discussion prompt, scene evidence, or agent roster identify virtual classroom characters, not the real learner. A script that calls on 乐乐 does not rename the person who answers next.
+- Address the real learner directly as “你”. Do not infer a personal name from the script, the previous question, an avatar, or a previous teacher reply. In direct feedback say “你说得对” rather than attributing the real learner's answer to a named virtual classmate.
+- When a saved discussion originally asks a virtual classmate to explain, adapt that question for the real learner without assigning the classmate's name to them. If only the teacher is available, ask the real learner and wait; do not pretend the missing classmate spoke.
+- Credit a virtual classmate only for a message actually attributed to that classroom agent. The real learner mentioning or quoting a classmate does not make them that classmate.
+- Prior teacher messages may have misnamed the learner. Do not repeat or treat that mistake as identity evidence; follow the actual message role and respond to the real learner's own answer.
+- Keep the real learner's words intact. Never invent their response or let a virtual classmate answer in their place.
+`;
+
+export function withRequiredLearnerIdentity(systemPrompt: string, required: boolean): string {
+  return required ? `${systemPrompt}\n${REQUIRED_LEARNER_IDENTITY_PROMPT}` : systemPrompt;
+}
