+    expect(history.map((message) => message.role)).toEqual(['assistant', 'user']);
+    expect(historyText(history[0])).toContain(AI_AGENT);
+    expect(historyText(history[0])).toContain('agentId="peer-lele"');
+    expect(historyText(history[0])).not.toContain(REAL_LEARNER);
