+    ]);
+    const history = toHistoryMessages(body.messages, 12, true);
+
+    expect(history[0].role).toBe('user');
+    expect(historyText(history[0])).toContain(REAL_LEARNER);
+    expect(historyText(history[0])).not.toContain(AI_AGENT);
+    expect(historyText(history[0])).not.toContain('乐乐');
+    expect(historyText(history[0])).not.toContain('peer-lele');
+    expect(buildUserPrompt(body, true)).toContain(`${REAL_LEARNER}`);
+    expect(buildUserPrompt(body, true)).not.toContain('[乐乐]');
+  });
