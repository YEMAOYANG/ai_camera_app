+    expect(history.map((message) => message.role)).toEqual(['assistant', 'user']);
+    expect(historyText(history[0])).toContain(AI_AGENT);
+    expect(historyText(history[0])).toContain('agentId="teacher"');
+    expect(historyText(history[0])).toContain(oldTeacherReply);
+    expect(historyText(history[1])).toContain(REAL_LEARNER);
+    expect(historyText(history[1])).toContain(learnerReply);
+    expect(historyText(history[1])).not.toContain('乐乐');
+    expect(body).toEqual(before);
+  });
