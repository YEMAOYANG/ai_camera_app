+// Run the production injected script against an isolated DOM/event simulator.
+// This does not open a browser or send any learning-progress request. Trusted
+// and synthetic event flags explicitly exercise the observer's boundary.
+class ObserverElement {
+  value = '';
+  visible = true;
+  validity = { valid: true };
+  constructor(
+    public tagName: string,
+    public textContent = '',
+  ) {}
+  get innerText() {
+    return this.textContent;
+  }
+  contains(target: unknown) {
+    return target === this;
+  }
+  getBoundingClientRect() {
+    return { width: this.visible ? 100 : 0, height: this.visible ? 30 : 0 };
+  }
+  checkVisibility() {
+    return this.visible;
+  }
+}
+class ObserverPort {
+  observations: MiraInteractionOperation[] = [];
+  closed = false;
+  close() {
+    this.closed = true;
+  }
+  postMessage(observation: MiraInteractionOperation) {
+    this.observations.push(observation);
+  }
+}
+
+function observerHarness(plan: InteractionObjective[]) {
+  const nodes = new Map<string, ObserverElement>();
+  for (const item of plan) {
+    nodes.set(
+      item.operation.controlSelector,
+      new ObserverElement(item.operation.action === 'click' ? 'BUTTON' : 'INPUT'),
+    );
+    nodes.set(item.feedback.selector, new ObserverElement('OUTPUT', '原来的可见反馈'));
+  }
+  const listeners = new Map<string, Array<(event: Record<string, unknown>) => void>>();
+  const queue: Array<{ at: number; run: () => void }> = [];
+  let now = 0;
+  const parent = {};
+  const emit = (type: string, event: Record<string, unknown>) => {
+    for (const listener of listeners.get(type) ?? []) listener(event);
+  };
+  runInNewContext(
+    STUDENT_INTERACTION_OBSERVER.replace(/^<script[^>]*>/, '').replace(/<\/script>$/, ''),
+    {
+      window: {
+        parent,
+        setTimeout: (run: () => void, delay = 0) => queue.push({ at: now + delay, run }),
+        addEventListener: (type: string, listener: (event: Record<string, unknown>) => void) => {
+          listeners.set(type, [...(listeners.get(type) ?? []), listener]);
+        },
+      },
+      document: { querySelector: (selector: string) => nodes.get(selector) },
+      HTMLElement: ObserverElement,
+      MessagePort: ObserverPort,
+      performance: { now: () => now },
+    },
+  );
+  const connect = (source: object = parent) => {
+    const port = new ObserverPort();
+    emit('message', {
+      source,
+      data: { type: 'mira:observe-student-interactions', objectives: plan },
+      ports: [port],
+      stopImmediatePropagation() {},
+    });
+    return port;
+  };
+  const flush = () => {
+    const end = now + 2100;
+    while (queue.length) {
+      queue.sort((a, b) => a.at - b.at);
+      if (queue[0].at > end) break;
+      const next = queue.shift()!;
+      now = next.at;
+      next.run();
+    }
+    now = end;
+  };
+  const dispatch = (type: string, control: ObserverElement, trusted = true) =>
+    emit(type, { type, target: control, isTrusted: trusted });
+  return { nodes, connect, flush, dispatch };
+}
