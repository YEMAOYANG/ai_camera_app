new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-english-pronunciation.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest';
+import { prepareMiraEnglishTtsPronunciation, miraEnglishPronunciationProblem,
+  miraEnglishPronunciationTermsPreserved } from '@/lib/server/mira-formal-english-pronunciation';
+
+describe('physical English spelling pronunciation', () => {
+  it('spells complete three-or-more-letter runs while retaining logical text and surrounding punctuation', () => {
+    const text = '比如 walk,走。昨天走了,就是 walked。w-a-l-k-e-d。';
+    expect(prepareMiraEnglishTtsPronunciation(text)).toBe('比如 walk,走。昨天走了,就是 walked。W, A, L, K, E, D。');
+    expect(prepareMiraEnglishTtsPronunciation('e-a-t 变成 a-t-e。')).toBe('E, A, T 变成 A, T, E。');
+    expect(prepareMiraEnglishTtsPronunciation('(W-a-L-K)')).toBe('(W, A, L, K)');
+    expect(text).toContain('w-a-l-k-e-d');
+  });
+  it('names -ed only in explicit English suffix teaching phrases', () => {
+    expect(prepareMiraEnglishTtsPronunciation('哪些动词加 -ed,哪些加上 -ed；以 -ed 结尾；-ed后缀。'))
+      .toBe('哪些动词加 E, D,哪些加上 E, D；以 E, D 结尾；E, D后缀。');
+  });
+  it.each(['well-known mother-in-law', 'word-a-b-c a-b-c-word', 'x_a-b-c a-b-c_1',
+    '1-a-b-c a-b-c2 -a-b-c a-b-c-', 'a-b g-o', 'a - b - c', '1-2-3 -7 2−1 a−b−c',
+    'w--a-l-k', '-ed value-ed user-ed 1-ed', '加 1-ed x=-ed', 'Ｅ-Ｄ'])('leaves ambiguous/nonspelling text unchanged: %s', text => {
+    expect(prepareMiraEnglishTtsPronunciation(text)).toBe(text);
+  });
+  it('requires the specific source/transcript minus disagreement', () => {
+    expect(miraEnglishPronunciationProblem('哪些动词加 -ed?', '哪些动词加减ed?')).toBe('suffix_read_as_minus');
+    expect(miraEnglishPronunciationProblem('w-a-l-k-e-d。', 'w减a减l减k减e减d。')).toBe('spelling_read_as_minus');
+    expect(miraEnglishPronunciationProblem('哪些动词加 -ed?', '哪些动词加ED?')).toBeNull();
+    expect(miraEnglishPronunciationProblem('减去一个字母。加 -ed?', '加减ed。')).toBeNull();
+    expect(miraEnglishPronunciationProblem('a-b。', 'a减b。')).toBeNull();
+    expect(miraEnglishPronunciationProblem('well-known。', '减ed。')).toBeNull();
+  });
+  it('accepts case/punctuation/spelling grouping only and rejects missing, extra or substituted English words', () => {
+    const text = 'eat 和 sing,yesterday 和 tomorrow。加 -ed。';
+    expect(miraEnglishPronunciationTermsPreserved(text, 'EAT 和 SING，YESTERDAY 和 TOMORROW，加 E, D。')).toBe(true);
+    for (const actual of ['eat see yesterday tomorrow ed', 'eat sing see yesterday tomorrow ed',
+      'eat sing yesterday tomorrow', 'sing eat yesterday tomorrow ed'])
+      expect(miraEnglishPronunciationTermsPreserved(text, actual)).toBe(false);
+    expect(miraEnglishPronunciationTermsPreserved('walk，walked，w-a-l-k-e-d。', 'Walk，walked，W A L K E D。')).toBe(true);
+  });
+});
