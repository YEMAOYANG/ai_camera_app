+/** Physical English TTS input only. Logical narration, classroom bytes, ASR
+ * comparison rules and request identity keep the author's original spelling. */
+export const MIRA_FORMAL_ENGLISH_TTS_PRONUNCIATION_POLICY =
+  'mira.english.tts-spelling-pronunciation.v1' as const;
+
+const spellingRuns = () => /(?<![A-Za-z0-9_-])[A-Za-z](?:-[A-Za-z]){2,}(?![A-Za-z0-9_-])/g;
+
+function prepareSuffix(text: string): string {
+  // These Chinese teaching phrases explicitly name the English -ed suffix.
+  // Bare -ed, identifiers, negative values and ordinary hyphenated words stay.
+  return text.replace(/(加(?:上)?\s*|以\s*)-ed(?![A-Za-z0-9_-])/gi, '$1E, D')
+    .replace(/(?<![A-Za-z0-9_-])-ed(?=\s*(?:后缀|词尾|结尾))/gi, 'E, D');
+}
+
+export function prepareMiraEnglishTtsPronunciation(text: string): string {
+  // Require a complete ASCII token with at least three single letters. Do not
+  // take a suffix out of a hyphenated word, identifier or numeric expression;
+  // two-letter a-b, spaced subtraction and Unicode minus signs are ambiguous.
+  return prepareSuffix(text).replace(spellingRuns(),
+    run => run.toUpperCase().split('-').join(', '));
+}
+
+/** An operator repair needs a specific source/transcript disagreement, not a
+ * generic high-score override. Callers additionally bind all archived hashes. */
+export function miraEnglishPronunciationProblem(source: string, transcript: string):
+  'suffix_read_as_minus' | 'spelling_read_as_minus' | null {
+  if (source.includes('减')) return null;
+  if (prepareSuffix(source) !== source && /减\s*e\s*[,，]?\s*d(?![A-Za-z])/i.test(transcript))
+    return 'suffix_read_as_minus';
+  for (const run of source.match(spellingRuns()) ?? []) {
+    if (new RegExp('(?<![A-Za-z])' + run.split('-').join('\\s*减\\s*') + '(?![A-Za-z])', 'i').test(transcript))
+      return 'spelling_read_as_minus';
+  }
+  return null;
+}
+
+/** Extra Chinese filler may vary, but the taught English words/letters must
+ * match exactly in order. Combine spelling letters; never map a different word back. */
+export function miraEnglishPronunciationTermsPreserved(source: string, transcript: string): boolean {
+  const words = (text: string) => (text.replace(
+    /(?<![A-Za-z])[A-Za-z](?:[\s,，-]+[A-Za-z])+(?![A-Za-z])/g,
+    run => run.replace(/[\s,，-]+/g, ''),
+  ).match(/[A-Za-z]+/g) ?? []).map(word => word.toLowerCase());
+  const expected = words(source), actual = words(transcript);
+  return expected.length === actual.length && expected.every((word, index) => word === actual[index]);
+}
