+it('cached-only completion shares frozen difficulty identity and never starts browser or paid review', async () => {
+  const value = input();
+  const unsigned = { schemaVersion: 'mira.learning.difficulty-policy.v1', difficultyCode: 'standard' };
+  const difficulty = { ...unsigned, policySha256: qualitySha(unsigned) };
+  value.teachingBrief.difficultyPolicy = difficulty;
+  const deps = { ...mocks(value), cacheRoot };
+  await expect(reviewFormalCourse(value, undefined, { ...deps, cachedOnly: true }))
+    .rejects.toThrow('FORMAL_AUDIO_TAIL_NEW_REVIEW_FORBIDDEN');
+  expect(deps.inspect).not.toHaveBeenCalled();
+  expect(deps.provider).not.toHaveBeenCalled();
+  expect(reviewFormalVisualSnapshot).not.toHaveBeenCalled();
+  const first = await reviewFormalCourse(value, undefined, deps);
+  expect(first.status).toBe('passed');
+  const browserCalls = deps.inspect.mock.calls.length;
+  const completion = await reviewFormalCourse({ ...value, difficultyPolicy: difficulty }, undefined,
+    { ...deps, cachedOnly: true });
+  expect(completion.receipt).toEqual(first.receipt);
+  expect(deps.inspect).toHaveBeenCalledTimes(browserCalls);
+  expect(deps.provider).toHaveBeenCalledTimes(1);
+  expect(reviewFormalVisualSnapshot).not.toHaveBeenCalled();
+  await expect(reviewFormalCourse({ ...value, difficultyPolicy: { ...difficulty, difficultyCode: 'basic' } }, undefined,
+    { ...deps, cachedOnly: true })).rejects.toThrow('FORMAL_QUALITY_DIFFICULTY_INVALID');
