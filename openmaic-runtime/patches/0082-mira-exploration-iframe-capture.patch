--- /dev/null
+++ b/tests/server/mira-formal-diagram-capture.browser.test.ts
@@ -0,0 +1,54 @@
+import { createHash } from 'node:crypto';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { chromium, type Browser, type Frame, type Page } from 'playwright-core';
+import sharp from 'sharp';
+import { captureFormalDiagram, projectFormalFrameRect } from '@/lib/server/mira-formal-exploration';
+
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== '1')('diagram capture through iframe geometry', () => {
+  let browser: Browser;
+  let page: Page;
+  let outer: Frame;
+  let inner: Frame;
+  beforeAll(async () => {
+    browser = await chromium.launch({ headless: true, executablePath:
+      process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH ?? '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' });
+    page = await browser.newPage({ viewport: { width: 1024, height: 768 } });
+    await page.route('**/*', route => route.abort());
+    await page.setContent('<style>body{margin:0;height:2000px;background:#f00}iframe{position:absolute;left:60px;top:280px;width:800px;height:600px;border:2px solid black;transform:scale(.8);transform-origin:top left}</style><iframe></iframe>');
+    outer = (await (await page.locator('iframe').elementHandle())!.contentFrame())!;
+    await outer.setContent('<style>body{margin:0;height:1200px;background:#f00}iframe{position:absolute;left:100px;top:250px;width:400px;height:300px;border:0;transform:scale(.5);transform-origin:top left}</style><iframe></iframe>');
+    inner = (await (await outer.locator('iframe').elementHandle())!.contentFrame())!;
+    await inner.setContent('<style>body{margin:0;height:900px;background:#f00}#model{position:absolute;left:40px;top:160px;width:160px;height:80px;background:#0f0}</style><div id="model"></div>');
+    await outer.evaluate(() => scrollTo(0, 100));
+    await inner.evaluate(() => scrollTo(0, 100));
+    await page.evaluate(() => scrollTo(0, 200));
+  });
+  afterAll(async () => { await browser?.close(); });
+  it('captures only the diagram after both scales, borders and page plus frame scroll', async () => {
+    const clip = await projectFormalFrameRect(inner, { x: 40, y: 60, width: 160, height: 80 });
+    expect(clip.x).toBeCloseTo(157.6, 2);
+    expect(clip.y).toBeCloseTo(225.6, 2);
+    expect(clip.width).toBeCloseTo(64, 2);
+    expect(clip.height).toBeCloseTo(32, 2);
+    const baseline = await captureFormalDiagram(inner, '#model');
+    const pixels = await sharp(baseline).raw().toBuffer({ resolveWithObject: true });
+    expect(pixels.info.width).toBe(64);
+    expect(pixels.info.height).toBe(32);
+    const center = (16 * 64 + 32) * pixels.info.channels;
+    expect([...pixels.data.subarray(center, center + 3)]).toEqual([0, 255, 0]);
+    await inner.locator('#model').evaluate(element => (element as HTMLElement).style.background = '#00f');
+    const changed = await captureFormalDiagram(inner, '#model');
+    await inner.locator('#model').evaluate(element => (element as HTMLElement).style.background = '#0f0');
+    const reset = await captureFormalDiagram(inner, '#model');
+    const sha = (data: Buffer) => createHash('sha256').update(data).digest('hex');
+    expect(sha(changed)).not.toBe(sha(baseline));
+    expect(sha(reset)).toBe(sha(baseline));
+  });
+  it('rejects clipped regions and unsupported transforms instead of guessing coordinates', async () => {
+    await expect(projectFormalFrameRect(inner, { x: -5, y: 60, width: 160, height: 80 }))
+      .rejects.toThrow('outside the viewport');
+    await outer.locator('iframe').evaluate(element => (element as HTMLElement).style.transform = 'rotate(3deg)');
+    await expect(projectFormalFrameRect(inner, { x: 40, y: 60, width: 160, height: 80 }))
+      .rejects.toThrow('transform is unsupported');
+  });
+});
