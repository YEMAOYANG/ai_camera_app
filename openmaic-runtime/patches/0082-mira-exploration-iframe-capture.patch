 /** A bounded browser verifier. Generated code supplies observations, never executable oracle code. */
+export type FormalViewportRect = { x: number; y: number; width: number; height: number };
+
+/** Chromium's iframe locator boxes may omit host CSS scale. Project through
+ * every actual host, just as the native control probe does, into page pixels. */
+export async function projectFormalFrameRect(target: Page | Frame, local: FormalViewportRect): Promise<FormalViewportRect> {
+  let frame: Frame = 'frameElement' in target ? target : target.mainFrame();
+  let rect: FormalViewportRect = local;
+  for (;;) {
+    const viewport = await frame.evaluate(() => ({ width: innerWidth, height: innerHeight }));
+    if (Object.values(rect).some(value => !Number.isFinite(value)) ||
+        rect.width < 0 || rect.height < 0 || rect.x < 0 || rect.y < 0 ||
+        rect.x + rect.width > viewport.width + 0.5 || rect.y + rect.height > viewport.height + 0.5)
+      throw new Error('probe region is outside the viewport');
+    const parent: Frame | null = frame.parentFrame();
+    if (!parent) return rect;
+    const host = await frame.frameElement();
+    try {
+      rect = await host.evaluate((element, local) => {
+        const iframe = element as HTMLIFrameElement;
+        const bounds = iframe.getBoundingClientRect();
+        // Bounding rectangles cannot reconstruct rotated/skewed/perspective
+        // hosts. Reject those instead of guessing a clip or click coordinate.
+        for (let ancestor: Element | null = iframe; ancestor; ancestor = ancestor.parentElement) {
+          const matrix = new DOMMatrix(getComputedStyle(ancestor).transform);
+          if (!matrix.is2D || matrix.b !== 0 || matrix.c !== 0 || matrix.a <= 0 || matrix.d <= 0)
+            throw new Error('probe iframe transform is unsupported');
+        }
+        const style = getComputedStyle(iframe);
+        if (iframe.offsetWidth <= 0 || iframe.offsetHeight <= 0 || bounds.width <= 0 || bounds.height <= 0 ||
+          parseFloat(style.paddingLeft) !== 0 || parseFloat(style.paddingTop) !== 0 ||
+          parseFloat(style.paddingRight) !== 0 || parseFloat(style.paddingBottom) !== 0)
+          throw new Error('probe iframe geometry is unsupported');
+        const scaleX = bounds.width / iframe.offsetWidth;
+        const scaleY = bounds.height / iframe.offsetHeight;
+        const projected = {
+          x: bounds.x + (iframe.clientLeft + local.x) * scaleX,
+          y: bounds.y + (iframe.clientTop + local.y) * scaleY,
+          width: local.width * scaleX, height: local.height * scaleY,
+        };
+        if (document.elementFromPoint(projected.x + projected.width / 2,
+          projected.y + projected.height / 2) !== iframe)
+          throw new Error('probe iframe is outside the viewport or covered');
+        return projected;
+      }, rect);
+    } finally { await host.dispose(); }
+    frame = parent;
+  }
+}
+
+export async function captureFormalDiagram(target: Page | Frame, selector: string): Promise<Buffer> {
+  const diagram = target.locator(selector);
+  await diagram.scrollIntoViewIfNeeded({ timeout: 2500 });
+  const local = await diagram.evaluate(element => {
+    const { x, y, width, height } = element.getBoundingClientRect();
+    return { x, y, width, height };
+  });
+  const clip = await projectFormalFrameRect(target, local);
+  const page = 'frameElement' in target ? target.page() : target;
+  // fullPage=false uses viewport-relative clip coordinates, including when the
+  // main page has scrolled. Adding scroll offsets here would crop the wrong area.
+  return page.screenshot({ clip, animations: 'disabled', timeout: 2500 });
+}
