+  const currentEntry = () => {
+    const entry = useWidgetIframeStore.getState().readyByScene[options.sceneId];
+    const pool = useInteractiveIframePool.getState();
+    return entry?.lease.classroomId === options.classroomId && pool.classroomId === options.classroomId
+      && pool.entries[options.sceneId]?.documentGeneration === entry.lease.documentGeneration
+      && entry.lease.frame.isConnected
+      && entry.lease.frame.contentWindow === entry.lease.target ? entry : undefined;
+  };
+  const cancel = () => {
+    if (!endWait) return false;
+    const cleanup = endWait;
+    endWait = undefined;
+    cleanup();
+    options.onWaiting(false);
+    return true;
+  };
+  const detach = () => {
+    releaseLease?.();
+    releaseLease = undefined;
+    held = undefined;
+  };
+  const attach = (lease: ReadyWidgetIframe) => {
+    if (held === lease) return;
+    detach();
+    held = lease;
+    const check = () => {
+      if (currentEntry()?.lease === lease) return;
+      detach();
+      if (!disposed && options.isCurrent()) options.onUnavailable('replaced');
+    };
+    const unsubscribeFrame = useWidgetIframeStore.subscribe(check);
+    const unsubscribePool = useInteractiveIframePool.subscribe(check);
+    releaseLease = () => { unsubscribeFrame(); unsubscribePool(); };
+  };
+
+  return {
+    run(start: () => void, isRequested: () => boolean) {
+      if (disposed || endWait) return;
+      const getDocument = () => useInteractiveIframePool.getState().entries[options.sceneId]?.documentGeneration;
+      let requestedDocument = getDocument();
+      const tryStart = () => {
+        if (!options.isCurrent() || !isRequested()) {
+          cancel();
+          return true;
+        }
+        const document = getDocument();
+        if (requestedDocument !== undefined && document !== requestedDocument) {
+          cancel();
+          options.onUnavailable('replaced');
+          return true;
+        }
+        requestedDocument ??= document;
+        const entry = currentEntry();
+        if (!entry?.visible) return false;
+        cancel();
+        attach(entry.lease);
+        start();
+        return true;
+      };
+      if (tryStart()) return;
+      const unsubscribeFrame = useWidgetIframeStore.subscribe(tryStart);
+      const unsubscribePool = useInteractiveIframePool.subscribe(tryStart);
+      const timer = setTimeout(() => {
+        cancel();
+        if (!disposed && options.isCurrent() && isRequested()) options.onUnavailable('timeout');
+      }, WIDGET_READY_TIMEOUT_MS);
+      endWait = () => { unsubscribeFrame(); unsubscribePool(); clearTimeout(timer); };
+      options.onWaiting(true);
+    },
+    send(type: string, payload: Record<string, unknown>) {
