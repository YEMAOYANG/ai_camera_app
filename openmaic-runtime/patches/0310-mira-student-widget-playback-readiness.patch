+
+/** Playback waits for the active document before it can emit any timeline actions. */
+export function createWidgetIframePlayback(options: {
+  classroomId: string;
+  sceneId: string;
+  isCurrent: () => boolean;
+  onWaiting: (waiting: boolean) => void;
+  onUnavailable: (reason: 'timeout' | 'replaced') => void;
+}) {
+  let disposed = false;
+  let endWait: (() => void) | undefined;
+  let releaseLease: (() => void) | undefined;
+  let held: ReadyWidgetIframe | undefined;
