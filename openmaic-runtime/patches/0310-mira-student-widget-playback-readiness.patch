+import {
+  createWidgetIframePlayback, supportsRecordedWidgetReadiness, useWidgetIframeStore, type ReadyWidgetIframe,
+} from '@/lib/store/widget-iframe';
+
+const room = 'classroom';
+const scene = 'scene-game';
+const otherScene = 'scene-other';
+const firstWidget = { state: { demo: true, level: 1, pause: true } };
+const pool = () => useInteractiveIframePool.getState();
+const store = () => useWidgetIframeStore.getState();
+
+function mount(classroomId = room, sceneId = scene, srcDoc = '<script>/* game */</script>') {
+  pool().configureClassroom(classroomId, []);
+  pool().mount(sceneId, { srcDoc });
+  const postMessage = vi.fn();
+  const target = { postMessage } as unknown as Window;
+  const frame = { isConnected: true, contentWindow: target } as HTMLIFrameElement;
+  const lease: ReadyWidgetIframe = {
+    classroomId, sceneId, documentGeneration: pool().entries[sceneId].documentGeneration, frame, target,
+  };
+  return { lease, postMessage };
+}
+
+const gates: ReturnType<typeof createWidgetIframePlayback>[] = [];
+function playback(isCurrent = () => true) {
+  const onWaiting = vi.fn();
+  const onUnavailable = vi.fn();
+  const gate = createWidgetIframePlayback({ classroomId: room, sceneId: scene, isCurrent, onWaiting, onUnavailable });
+  gates.push(gate);
+  const start = vi.fn(() => gate.send('SET_WIDGET_STATE', firstWidget));
+  return { gate, start, onWaiting, onUnavailable };
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  pool().reset();
+  useWidgetIframeStore.setState({ readyByScene: {}, sendMessageByScene: {}, activeSceneId: null });
+});
+
+afterEach(() => {
+  for (const gate of gates.splice(0)) gate.dispose();
+  vi.useRealTimers();
+});
+
+describe('student widget playback readiness', () => {
+  test('cold start waits for the selected loaded visible iframe before the first action', () => {
+    const { gate, start, onWaiting } = playback();
+    gate.run(start, () => true);
+    const wrong = mount(room, otherScene);
+    store().registerReadyIframe(wrong.lease, true);
+    const actual = mount();
+    store().registerIframe(scene, vi.fn());
+    vi.advanceTimersByTime(640);
+    store().registerReadyIframe(actual.lease, false);
+    expect(start).not.toHaveBeenCalled();
+    store().setReadyIframeVisible(actual.lease, true);
+    expect(start).toHaveBeenCalledTimes(1);
+    expect(actual.postMessage).toHaveBeenCalledWith({ type: 'SET_WIDGET_STATE', ...firstWidget }, '*');
+    expect(wrong.postMessage).not.toHaveBeenCalled();
+    expect(onWaiting.mock.calls).toEqual([[true], [false]]);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  test('a warm iframe starts in the initiating event and a layout change does not replace it', () => {
+    const { lease, postMessage } = mount();
+    store().registerReadyIframe(lease, true);
+    const { gate, start, onWaiting, onUnavailable } = playback();
+    gate.run(start, () => true);
+    expect(start).toHaveBeenCalledTimes(1);
+    expect(onWaiting).not.toHaveBeenCalled();
+    store().setReadyIframeVisible(lease, false);
