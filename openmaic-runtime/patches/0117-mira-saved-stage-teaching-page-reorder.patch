+/** Reorder teaching pages without changing scene identities or locked quizzes. */
+export function validateMiraFormalSavedStageSceneRepair(
+  sourceScenes: readonly Scene[],
+  repairedScenes: readonly Scene[],
+): Scene[] {
+  const reject = () => { throw new Error('FORMAL_SAVED_STAGE_LOCKED_ASSESSMENT_CHANGED'); };
+  const ordered = (scenes: readonly Scene[]) => {
+    if (scenes.some((scene) => !scene || !Number.isFinite(scene.order))
+        || new Set(scenes.map((scene) => scene.id)).size !== scenes.length
+        || new Set(scenes.map((scene) => scene.order)).size !== scenes.length) reject();
+    return [...scenes].sort((a, b) => a.order - b.order);
+  };
+  const source = ordered(sourceScenes);
+  const repaired = ordered(repairedScenes);
+  const sourceById = new Map(source.map((scene) => [scene.id, scene]));
+  if (source.length !== repaired.length || repaired.some((target) => {
+    const original = sourceById.get(target.id);
+    return !original || original.type !== target.type || original.stageId !== target.stageId
+      || (original.type === 'quiz' && qualitySha(original.content) !== qualitySha(target.content));
+  })) reject();
+  const sourceQuizzes = source.filter((scene) => scene.type === 'quiz');
+  const repairedQuizzes = repaired.filter((scene) => scene.type === 'quiz');
+  if (sourceQuizzes.some((scene, index) => scene.id !== repairedQuizzes[index]?.id)) reject();
+  return repaired;
+}
