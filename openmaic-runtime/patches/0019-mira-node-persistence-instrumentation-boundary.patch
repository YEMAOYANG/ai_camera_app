diff --git a/tests/server/instrumentation-boundary.test.ts b/tests/server/instrumentation-boundary.test.ts
new file mode 100644
index 0000000..edf8aa5
--- /dev/null
+++ b/tests/server/instrumentation-boundary.test.ts
@@ -0,0 +1,31 @@
+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { describe, expect, it } from 'vitest';
+
+const root = resolve(__dirname, '../..');
+const read = (relativePath: string) => readFileSync(resolve(root, relativePath), 'utf8');
+
+describe('Next instrumentation persistence boundary', () => {
+  it('keeps the Edge registration entry free of Node-only persistence imports', () => {
+    const source = read('instrumentation.ts');
+
+    expect(source).toContain("await import('./instrumentation.node')");
+    expect(source).not.toContain('asset-collector-schedule');
+    expect(source).not.toContain('@openmaic/storage');
+    expect(source).not.toContain("from 'pg'");
+  });
+
+  it('declares a dedicated Node entry and server-external persistence packages', () => {
+    const nodeEntry = resolve(root, 'instrumentation.node.ts');
+    expect(existsSync(nodeEntry)).toBe(true);
+    if (existsSync(nodeEntry)) {
+      const source = read('instrumentation.node.ts');
+      expect(source).toContain('asset-collector-schedule');
+      expect(source).toContain('startAssetCollectorSchedule');
+    }
+
+    const nextConfig = read('next.config.ts');
+    expect(nextConfig).toContain("'@openmaic/storage'");
+    expect(nextConfig).toContain("'pg'");
+  });
+});
