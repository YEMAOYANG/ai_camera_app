diff --git a/components/roundtable/use-presentation-toolbar-height.ts b/components/roundtable/use-presentation-toolbar-height.ts
new file mode 100644
--- /dev/null
+++ b/components/roundtable/use-presentation-toolbar-height.ts
@@ -0,0 +1,40 @@
+"use client";
+
+import { useEffect, useRef, useState, type RefObject } from "react";
+
+/** Keep fullscreen discussion controls above the toolbar, including wrapped rows. */
+export function usePresentationToolbarHeight(
+  isPresenting: boolean,
+  dockRef: RefObject<HTMLDivElement | null>,
+  dockVisible: boolean,
+) {
+  const toolbarRef = useRef<HTMLDivElement>(null);
+  const [toolbarHeight, setToolbarHeight] = useState(176);
+
+  const [dockHeight, setDockHeight] = useState(76);
+
+  useEffect(() => {
+    if (!isPresenting) return;
+    const toolbar = toolbarRef.current;
+    if (!toolbar) return;
+    const dock = dockVisible ? dockRef.current : null;
+    const measure = () => {
+      setToolbarHeight(toolbar.offsetHeight);
+      setDockHeight(dock ? dock.offsetHeight : 0);
+    };
+    measure();
+    const observer =
+      typeof ResizeObserver === "undefined"
+        ? null
+        : new ResizeObserver(measure);
+    observer?.observe(toolbar);
+    if (dock) observer?.observe(dock);
+    window.addEventListener("resize", measure);
+    return () => {
+      observer?.disconnect();
+      window.removeEventListener("resize", measure);
+    };
+  }, [isPresenting, dockRef, dockVisible]);
+
+  return { toolbarRef, toolbarHeight, dockHeight };
+}
