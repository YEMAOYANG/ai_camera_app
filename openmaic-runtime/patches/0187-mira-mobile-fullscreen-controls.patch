+    min-height: max(48px, var(--mira-orbit-control-height, 48px));
+    height: auto;
+  }
+  [data-mira-presentation-chrome]
+    [data-mira-chrome="playback-controls"]
+    [data-mira-indicator="toolbar-divider"] {
+    display: none;
+  }
+  [data-mira-presentation-chrome] [data-mira-presentation-dock],
+  [data-mira-presentation-chrome] [data-mira-presentation-end-flash] {
+    bottom: calc(var(--mira-presentation-toolbar-height, 176px) + 12px);
+  }
+  [data-mira-presentation-chrome] [data-mira-presentation-backdrop] {
+    bottom: var(--mira-presentation-toolbar-height, 176px);
+  }
+  [data-mira-presentation-chrome] [data-mira-presentation-dock] {
+    right: 12px !important;
+    max-width: calc(100vw - 24px);
+  }
+  [data-mira-presentation-chrome] [data-mira-presentation-input] {
+    bottom: calc(
+      var(--mira-presentation-toolbar-height, 176px) +
+        var(--mira-presentation-dock-height, 76px) + 24px
+    );
+    right: 0 !important;
+  }
+}
