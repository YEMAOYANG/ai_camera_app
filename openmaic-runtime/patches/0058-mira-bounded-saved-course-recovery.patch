new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-review-evidence.ts
@@ -0,0 +1,79 @@
+import { qualitySceneText, qualitySnapshot, QUALITY_DIMENSIONS } from './mira-formal-quality-contract';
+import type { FormalQualityInput } from './mira-formal-teaching-quality';
+
+export interface ReviewEvidence { id: string; sceneId: string; quote: string }
+/** Supply exact source excerpts once; the reviewer selects IDs instead of
+ * inventing quotes from rendered HTML or evaluated JavaScript templates. */
+export function buildFormalReviewEvidence(input: FormalQualityInput): ReviewEvidence[] {
+  const result: ReviewEvidence[] = [];
+  for (const scene of qualitySnapshot(input.stage, input.scenes).scenes) {
+    const source = qualitySceneText(scene), excerpts = new Set<string>();
+    const add = (raw: string) => {
+      const quote = raw.trim();
+      if (quote.length >= 3 && quote.length <= 500 && source.includes(quote) && excerpts.size < 80)
+        excerpts.add(quote);
+    };
+    const visit = (value: unknown) => {
+      if (typeof value === 'string') {
+        if (value.length <= 500 && !/<[a-z]/i.test(value)) add(value);
+        else {
+          value.replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, '')
+            .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, '')
+            .split(/<[^>]+>/).forEach(add);
+          for (const match of value.matchAll(/['"`]([^'"`\n]{3,200})['"`]/g))
+            if (/[\u4e00-\u9fff]/.test(match[1]) && !match[1].includes('${')) add(match[1]);
+        }
+      } else if (Array.isArray(value)) value.forEach(visit);
+      else if (value && typeof value === 'object') Object.values(value).forEach(visit);
+    };
+    visit(scene.actions); visit(scene.content);
+    for (const [index, quote] of [...excerpts].entries())
+      result.push({ id: `${scene.id}:e${index + 1}`, sceneId: scene.id, quote });
+  }
+  if (!result.length) throw new Error('FORMAL_QUALITY_EVIDENCE_CATALOG_EMPTY');
+  return result;
+}
+
+export function formalReviewEvidenceSchema(evidence: ReviewEvidence[]) {
+  const ids = { type: 'array', minItems: 1, maxItems: 10,
+    items: { type: 'string', enum: evidence.map(item => item.id) } };
+  return { type: 'object', additionalProperties: false, required: ['dimensions', 'objectives', 'issues'],
+    properties: {
+      dimensions: { type: 'array', minItems: 7, maxItems: 7, items: { type: 'object',
+        additionalProperties: false, required: ['id', 'passed', 'evidenceIds'], properties: {
+          id: { type: 'string', enum: [...QUALITY_DIMENSIONS] }, passed: { type: 'boolean' }, evidenceIds: ids } } },
+      objectives: { type: 'array', items: { type: 'object', additionalProperties: false,
+        required: ['objectiveIndex', 'evidenceIds'], properties: {
+          objectiveIndex: { type: 'integer', minimum: 0 }, evidenceIds: ids } } },
+      issues: { type: 'array', items: { type: 'object', additionalProperties: false,
+        required: ['sceneId', 'problem', 'repair'], properties: {
+          sceneId: { type: 'string' }, problem: { type: 'string' }, repair: { type: 'string' } } } },
+    } };
+}
+
+export function decodeFormalReviewEvidence(raw: unknown, catalog: ReviewEvidence[]) {
+  if (!raw || typeof raw !== 'object' || Object.keys(raw).sort().join(',') !== 'dimensions,issues,objectives')
+    throw new Error('FORMAL_QUALITY_EVIDENCE_REPORT_INVALID');
+  const report = raw as Record<string, unknown>;
+  if (!Array.isArray(report.dimensions) || !Array.isArray(report.objectives) || !Array.isArray(report.issues))
+    throw new Error('FORMAL_QUALITY_EVIDENCE_REPORT_INVALID');
+  const byId = new Map(catalog.map(item => [item.id, item]));
+  const decode = (row: unknown, keys: string) => {
+    if (!row || typeof row !== 'object' || Object.keys(row).sort().join(',') !== keys)
+      throw new Error('FORMAL_QUALITY_EVIDENCE_ROW_INVALID');
+    const { evidenceIds, ...fields } = row as Record<string, unknown>;
+    if (!Array.isArray(evidenceIds) || !evidenceIds.length || evidenceIds.length > 10
+        || evidenceIds.some(id => typeof id !== 'string' || !byId.has(id)))
+      throw new Error('FORMAL_QUALITY_EVIDENCE_ID_INVALID');
+    return { ...fields, evidence: evidenceIds.map(id => {
+      const { sceneId, quote } = byId.get(id)!; return { sceneId, quote };
+    }) };
+  };
+  const dimensions = report.dimensions.map(row => decode(row, 'evidenceIds,id,passed'));
+  const objectives = report.objectives.map(row => decode(row, 'evidenceIds,objectiveIndex'));
+  // The model owns each judgment; the host computes the redundant roll-up.
+  // No issue or failing dimension can be overwritten by a positive summary.
+  const passed = dimensions.length === 7 && dimensions.every(row => 'passed' in row && row.passed === true)
+    && report.issues.length === 0;
+  return { status: passed ? 'passed' : 'needs_revision', dimensions, objectives, issues: report.issues };
+}
diff --git a/lib/server/mira-formal-audio-repair.ts b/lib/server/mira-formal-audio-repair.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-audio-repair.ts
@@ -0,0 +1,96 @@
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { qualitySha } from './mira-formal-quality-contract';
+import { acquireFormalQualityLock } from './mira-formal-quality-lock';
+import { writeJsonFileAtomic } from './classroom-storage';
+import { readMiraFormalAsrJob, readMiraFormalTtsJob, executeMiraFormalTts, executeMiraFormalAsr,
+  type MiraFormalTtsRequest, type MiraFormalAsrRequest } from './mira-formal-audio';
+import { prepareMiraFormalAsrComparisonText, normalizeMiraFormalAsrText, miraFormalAsrSimilarityBps } from './mira-formal-audio-lifecycle';
+
+const sha = (value: string | Uint8Array) => createHash('sha256').update(value).digest('hex');
+const identityKeys = ['classroomId', 'classroomContentSha256', 'subject', 'teacherProfileId',
+  'teacherProfileVersion', 'teacherProfileSha256', 'teacherGender', 'sceneId', 'sceneOrder',
+  'actionId', 'narrationSegmentId'] as const;
+
+/** One explicit operator repair of a known bad narration segment. Canonical job
+ * IDs remain logical handles; physical replacement dispatches have .repair1 IDs.
+ * Both original records and child records are retained, with a promotion journal.
+ * Normal TTS/ASR APIs remain no-retry; failed/ambiguous repair children cannot be rerun. */
+export async function repairMiraFormalAudioSegment(input: {
+  asrRequestId: string; classroomId: string; text: string; expectedOriginalAudioSha256: string | null;
+  ttsRequestId?: string; expectedOriginalTtsRequestSha256?: string;
+}) {
+  if (!/^[A-Za-z0-9._:-]{1,128}$/.test(input.asrRequestId)
+      || (input.expectedOriginalAudioSha256 !== null && !/^[a-f0-9]{64}$/.test(input.expectedOriginalAudioSha256)))
+    throw new Error('AUDIO_REPAIR_IDENTITY_INVALID');
+  const root = process.env.MIRA_FORMAL_AUDIO_DATA_DIR || path.join(process.cwd(), 'data/formal-audio');
+  const folder = path.join(root, 'repairs', sha(input.asrRequestId));
+  await fs.mkdir(folder, { recursive: true, mode: 0o700 });
+  const lock = await acquireFormalQualityLock(path.join(folder, 'repair.lock'));
+  try {
+    const sourcePath = path.join(folder, 'source.json');
+    let source;
+    try { source = JSON.parse(await fs.readFile(sourcePath, 'utf8')); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      const asr = await readMiraFormalAsrJob(input.asrRequestId);
+      const tts = await readMiraFormalTtsJob(asr?.ttsRequestId ?? input.ttsRequestId ?? '');
+      const knownBadAudio = asr && tts && asr.state === 'succeeded' && tts.state === 'succeeded'
+        && asr.similarityBps !== undefined && asr.similarityBps < 8500
+        && asr.audioSha256 === input.expectedOriginalAudioSha256 && tts.audioSha256 === asr.audioSha256
+        && asr.classroomId === input.classroomId;
+      const failedTts = !asr && tts && ['failed', 'ambiguous'].includes(tts.state)
+        && input.expectedOriginalAudioSha256 === null && !tts.audioSha256
+        && tts.requestSha256 === input.expectedOriginalTtsRequestSha256
+        && input.asrRequestId === tts.requestId.replace(/^formal_tts_/, 'formal_asr_');
+      if (!tts || (!knownBadAudio && !failedTts) || tts.classroomId !== input.classroomId
+          || tts.textSha256 !== sha(input.text)) throw new Error('AUDIO_REPAIR_SOURCE_NOT_PROVEN');
+      source = { asr, asrRequestId: input.asrRequestId, tts, policy: 'mira-single-narration-repair.v1', createdAt: new Date().toISOString() };
+      await writeJsonFileAtomic(sourcePath, source);
+    }
+    if ((source.asrRequestId ?? source.asr?.requestId) !== input.asrRequestId
+        || (source.asr?.audioSha256 ?? null) !== input.expectedOriginalAudioSha256
+        || source.tts.textSha256 !== sha(input.text) || source.tts.classroomId !== input.classroomId)
+      throw new Error('AUDIO_REPAIR_SOURCE_CHANGED');
+    const identity = Object.fromEntries(identityKeys.map(key => [key, source.tts[key]]));
+    const ttsRequest = { ...identity, requestId: `${source.tts.requestId}.repair1`,
+      text: input.text, textSha256: sha(input.text) } as MiraFormalTtsRequest;
+    const tts = (await executeMiraFormalTts(ttsRequest)).record;
+    if (tts.state !== 'succeeded' || !tts.audioSha256 || tts.requestSha256 !== qualitySha(ttsRequest))
+      throw new Error('AUDIO_REPAIR_TTS_NOT_VERIFIED');
+    const asrRequest = { ...identity, requestId: `${input.asrRequestId}.repair1`,
+      ttsRequestId: tts.requestId, audioSha256: tts.audioSha256 } as MiraFormalAsrRequest;
+    const asr = (await executeMiraFormalAsr(asrRequest, { transcriptEvidence: transcript => {
+      const actual = prepareMiraFormalAsrComparisonText(transcript, tts.subject);
+      return { normalizedTranscriptSha256: sha(normalizeMiraFormalAsrText(actual)),
+        similarityBps: miraFormalAsrSimilarityBps(prepareMiraFormalAsrComparisonText(input.text, tts.subject), actual) };
+    } })).record;
+    if (asr.state !== 'succeeded' || asr.similarityBps === undefined || asr.similarityBps < 8500
+        || asr.requestSha256 !== qualitySha(asrRequest) || asr.audioSha256 !== tts.audioSha256)
+      throw new Error('AUDIO_REPAIR_ASR_NOT_VERIFIED');
+    const audit = { policy: source.policy, originalTtsSha256: qualitySha(source.tts),
+      originalAsrSha256: source.asr ? qualitySha(source.asr) : null, originalAudioSha256: source.asr?.audioSha256 ?? null,
+      physicalTtsRequestId: tts.requestId, physicalAsrRequestId: asr.requestId };
+    const promotedTts = { ...tts, requestId: source.tts.requestId,
+      requestSha256: source.tts.requestSha256, createdAt: source.tts.createdAt, operatorRepair: audit };
+    const canonicalAsrRequest = { ...asrRequest, requestId: input.asrRequestId, ttsRequestId: source.tts.requestId };
+    const promotedAsr = { ...asr, requestId: input.asrRequestId, ttsRequestId: source.tts.requestId,
+      requestSha256: qualitySha(canonicalAsrRequest), createdAt: source.asr?.createdAt ?? asr.createdAt, operatorRepair: audit };
+    const journal = { ...audit, tts: promotedTts, asr: promotedAsr };
+    await writeJsonFileAtomic(path.join(folder, 'promotion.json'), journal);
+    // If interrupted between these two writes, the next invocation verifies
+    // each side against the source or the same journal, then finishes the pair.
+    for (const [kind, previous, promoted] of [['tts', source.tts, promotedTts], ['asr', source.asr, promotedAsr]] as const) {
+      const file = path.join(root, 'jobs', kind, `${sha(promoted.requestId)}.json`);
+      let current = null;
+      try { current = JSON.parse(await fs.readFile(file, 'utf8')); }
+      catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
+      if (qualitySha(current) !== qualitySha(previous) && qualitySha(current) !== qualitySha(promoted))
+        throw new Error('AUDIO_REPAIR_PROMOTION_SOURCE_CHANGED');
+      await writeJsonFileAtomic(file, promoted);
+    }
+    return { ...audit, audioSha256: tts.audioSha256, similarityBps: asr.similarityBps,
+      receiptSha256: qualitySha(journal) };
+  } finally { await lock.release(); }
+}
