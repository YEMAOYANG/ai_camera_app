+export interface MiraSavedStageRecoveryInput {
+  expectedSessionId: string;
+  expectedStageId: string;
+  expectedSourceSnapshotSha256: string;
+  scenes: Scene[];
+}
+
+/** Operator-only recovery of a terminal, persisted course. No Agent is resumed.
+ * Source events, research, immutable assessment and all release gates still apply.
+ * The source document and terminal Agent remain intact for audit. */
+export async function prepareMiraFormalSavedStageRecovery(
+  input: GenerateClassroomInput,
+  repair: MiraSavedStageRecoveryInput,
+) {
+  const { qualitySha, qualitySnapshot } = await import('./mira-formal-quality-contract');
+  const spec = parseFormalCoursewareSpec(input);
+  const identity = professionalIdentity(input);
+  const session = await (await getAgentSessionStore()).getSession(identity.sessionId);
+  if (!session || !['succeeded', 'failed', 'cancelled'].includes(session.status)
+      || identity.sessionId !== repair.expectedSessionId
+      || session.ownerId !== identity.ownerId || session.prompt !== professionalPrompt(input, spec)
+      || session.origin !== professionalSessionOrigin(input) || session.existingCourse
+      || !isMiraFormalProfessionalSessionIdentity({ ownerId: session.ownerId,
+        sessionId: session.id, skillId: session.skillId }))
+    throw new Error('FORMAL_SAVED_STAGE_SESSION_MISMATCH');
+  const events = await readAllSessionEvents(identity.sessionId);
+  const stageId = resolveMiraFormalStageId(events);
+  const document = await (await getOwnerScopedDocumentStore(identity.ownerId)).loadDocument(stageId);
+  if (!document || stageId !== repair.expectedStageId
+      || qualitySha(qualitySnapshot(document.stage, document.scenes)) !== repair.expectedSourceSnapshotSha256)
+    throw new Error('FORMAL_SAVED_STAGE_SOURCE_MISMATCH');
+  const sourceScenes = [...document.scenes].sort((a, b) => a.order - b.order);
+  const repairedScenes = [...repair.scenes].sort((a, b) => a.order - b.order);
+  if (sourceScenes.length !== repairedScenes.length || sourceScenes.some((source, index) => {
+    const target = repairedScenes[index];
+    return source.id !== target.id || source.type !== target.type || source.order !== target.order
+      || source.stageId !== target.stageId
+      || (source.type === 'quiz' && qualitySha(source.content) !== qualitySha(target.content));
+  })) throw new Error('FORMAL_SAVED_STAGE_LOCKED_ASSESSMENT_CHANGED');
+  const promoted = promoteProfessionalDocument(document.stage as Stage, repairedScenes, spec,
+    isMiraAdaptiveSkillCreationPolicy(input.professionalCreationPolicy));
+  assertProfessionalClassroom(promoted.stage, promoted.scenes, spec, identity.sessionId, document.outline);
+  const evidence = await loadResearchEvidence(events, identity.sessionId);
+  const canonicalized = canonicalizeMiraFormalResearchFooters(promoted.scenes, evidence.fetched);
+  buildResearchReceipt(evidence, canonicalized.scenes, spec, identity.sessionId);
+  return { ...identity, stage: promoted.stage, scenes: canonicalized.scenes,
+    originalSessionStatus: session.status };
+}
+
+/** May spend only the remaining independent review and required TTS/ASR work;
+ * unlike citation-only recovery this is explicitly NOT a zero-model path. */
+export async function recoverMiraFormalSavedStage(
+  input: GenerateClassroomInput,
+  repair: MiraSavedStageRecoveryInput,
+  options: { baseUrl: string; cachedQualityOnly?: boolean; onProgress?: (progress: ClassroomGenerationProgress) => Promise<void> | void },
+) {
+  const prepared = await prepareMiraFormalSavedStageRecovery(input, repair);
+  return completeMiraFormalProfessionalClassroom(input, parseFormalCoursewareSpec(input), prepared,
+    { ...options, expectedStageId: repair.expectedStageId, recoveredScenes: repair.scenes,
+      recheckUnsentBrowserReview: true });
+}
