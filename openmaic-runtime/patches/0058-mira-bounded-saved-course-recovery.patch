new file mode 100644
--- /dev/null
+++ b/scripts/recover-formal-saved-stage.ts
@@ -0,0 +1,177 @@
+/** Local operator command: inspect -> complete. Never starts an Agent or search.
+ * Failed source bytes and the terminal session stay in the recovery audit.
+ * A completion consumes the original session's existing quality budget.
+ */
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { qualitySha, qualitySnapshot, QUALITY_VIEWPORTS } from '../lib/server/mira-formal-quality-contract';
+import { prepareMiraFormalSavedStageRecovery, recoverMiraFormalSavedStage } from '../lib/server/mira-formal-professional-classroom';
+import { inspectFormalScene } from '../lib/server/mira-formal-scene-inspector';
+import { CLASSROOM_JOBS_DIR, writeJsonFileAtomic } from '../lib/server/classroom-storage';
+import type { ClassroomGenerationJob } from '../lib/server/classroom-job-store';
+import { assertMiraFormalAudioProviderReady, readMiraFormalAsrJob, readMiraFormalTtsJob,
+  executeMiraFormalAsr, type MiraFormalAsrRequest } from '../lib/server/mira-formal-audio';
+import { prepareMiraFormalSpeechText, prepareMiraFormalAsrComparisonText,
+  normalizeMiraFormalAsrText, miraFormalAsrSimilarityBps } from '../lib/server/mira-formal-audio-lifecycle';
+import { acquireFormalQualityLock, type QualityLockLease } from '../lib/server/mira-formal-quality-lock';
+import { repairMiraFormalAudioSegment } from '../lib/server/mira-formal-audio-repair';
+
+const sha = (value: Buffer) => createHash('sha256').update(value).digest('hex');
+let lease: QualityLockLease | undefined;
+async function main() {
+  const [mode, manifestPath] = process.argv.slice(2);
+  if (!['prepare', 'inspect', 'complete', 'diagnose-audio', 'repair-audio', 'complete-audio-tail'].includes(mode) || !manifestPath)
+    throw new Error('Usage: recover-formal-saved-stage.ts prepare|inspect|complete manifest.json');
+  const manifest = JSON.parse(await fs.readFile(manifestPath, 'utf8'));
+  if (!/^[A-Za-z0-9_-]+$/.test(manifest.jobId) || !/^[a-f0-9]{64}$/.test(manifest.sourceJobSha256))
+    throw new Error('SAVED_STAGE_MANIFEST_INVALID');
+  const jobPath = path.join(CLASSROOM_JOBS_DIR, `${manifest.jobId}.json`);
+  const source = await fs.readFile(jobPath);
+  const job = JSON.parse(source.toString('utf8')) as ClassroomGenerationJob;
+  const folder = path.join(process.cwd(), 'data/formal-saved-stage-recoveries', manifest.jobId);
+  await fs.mkdir(folder, { recursive: true, mode: 0o700 });
+  if (job.status === 'succeeded' && job.formalSavedStageRecovery?.sourceJobSha256 === manifest.sourceJobSha256) {
+    console.log(JSON.stringify({ status: 'already_completed', jobId: job.id })); return;
+  }
+  if (sha(source) !== manifest.sourceJobSha256 || job.status !== 'failed' || !job.formalInput
+      || !job.completedAt || !job.error || job.formalSavedStageRecovery || job.formalCitationRecovery)
+    throw new Error('SAVED_STAGE_SOURCE_JOB_CHANGED');
+  const proposal = JSON.parse(await fs.readFile(path.resolve(path.dirname(manifestPath), manifest.repairPath), 'utf8'));
+  const repair = { expectedSessionId: manifest.sessionId, expectedStageId: manifest.stageId,
+    expectedSourceSnapshotSha256: manifest.sourceSnapshotSha256, scenes: proposal.scenes };
+  const prepared = await prepareMiraFormalSavedStageRecovery(job.formalInput, repair);
+  const snapshotSha256 = qualitySha(qualitySnapshot(prepared.stage, prepared.scenes));
+  const identity = { sourceJobSha256: sha(source), sourceSnapshotSha256: manifest.sourceSnapshotSha256,
+    repairSnapshotSha256: snapshotSha256, sessionId: prepared.sessionId, stageId: prepared.stage.id };
+  await writeJsonFileAtomic(path.join(folder, 'prepared-snapshot.json'), qualitySnapshot(prepared.stage, prepared.scenes));
+  if (mode === 'prepare') { console.log(JSON.stringify(identity)); return; }
+  assertMiraFormalAudioProviderReady();
+  if (mode === 'repair-audio' && manifest.ttsSourceRequestId) {
+    const prior = await readMiraFormalTtsJob(manifest.ttsSourceRequestId);
+    const action = prepared.scenes.flatMap(scene => scene.actions ?? []).find(action => action.id === prior?.actionId);
+    if (!prior || prior.classroomId !== prepared.stage.id || !action || action.type !== 'speech'
+        || !['failed', 'ambiguous'].includes(prior.state)) throw new Error('SAVED_STAGE_FAILED_TTS_SOURCE_INVALID');
+    console.log(JSON.stringify(await repairMiraFormalAudioSegment({
+      asrRequestId: manifest.asrSourceRequestId, ttsRequestId: prior.requestId,
+      expectedOriginalTtsRequestSha256: prior.requestSha256, classroomId: prepared.stage.id,
+      text: prepareMiraFormalSpeechText(action.text, prior.subject), expectedOriginalAudioSha256: null })));
+    return;
+  }
+  if (mode === 'diagnose-audio' || mode === 'repair-audio') {
+    const prior = await readMiraFormalAsrJob(manifest.asrSourceRequestId);
+    if (!prior || prior.state !== 'succeeded' || prior.classroomId !== prepared.stage.id
+        || prior.similarityBps === undefined || prior.similarityBps >= 8500)
+      throw new Error('SAVED_STAGE_AUDIO_DIAGNOSTIC_SOURCE_INVALID');
+    const action = prepared.scenes.flatMap(scene => scene.actions ?? []).find(action => action.id === prior.actionId);
+    if (!action || action.type !== 'speech') throw new Error('SAVED_STAGE_AUDIO_ACTION_MISSING');
+    const expected = prepareMiraFormalSpeechText(action.text, prior.subject);
+    const tts = await readMiraFormalTtsJob(prior.ttsRequestId);
+    if (tts?.textSha256 !== sha(Buffer.from(expected))) throw new Error('SAVED_STAGE_AUDIO_TEXT_CHANGED');
+    if (mode === 'repair-audio') {
+      console.log(JSON.stringify(await repairMiraFormalAudioSegment({ asrRequestId: prior.requestId,
+        classroomId: prepared.stage.id, text: expected, expectedOriginalAudioSha256: prior.audioSha256 })));
+      return;
+    }
+    const keys = ['ttsRequestId', 'classroomId', 'classroomContentSha256', 'subject',
+      'teacherProfileId', 'teacherProfileVersion', 'teacherProfileSha256', 'teacherGender',
+      'sceneId', 'sceneOrder', 'actionId', 'narrationSegmentId', 'audioSha256'] as const;
+    const request = { requestId: `${prior.requestId}.diagnostic1`,
+      ...Object.fromEntries(keys.map(key => [key, prior[key]])) } as MiraFormalAsrRequest;
+    const result = await executeMiraFormalAsr(request, { transcriptEvidence: transcript => {
+      const actual = prepareMiraFormalAsrComparisonText(transcript, prior.subject);
+      return { normalizedTranscriptSha256: sha(Buffer.from(normalizeMiraFormalAsrText(actual))),
+        similarityBps: miraFormalAsrSimilarityBps(prepareMiraFormalAsrComparisonText(expected, prior.subject), actual) };
+    } });
+    await writeJsonFileAtomic(path.join(folder, 'audio-diagnostic.json'),
+      { originalAsrRequestId: prior.requestId, originalTranscriptSha256: prior.transcriptSha256,
+        expected, ...result });
+    console.log(JSON.stringify({ expected, transcript: result.transcript,
+      similarityBps: result.record.similarityBps, originalTranscriptMatched: result.record.transcriptSha256 === prior.transcriptSha256 }));
+    return;
+  }
+  const preflightPath = path.join(folder, 'browser-preflight.json');
+  if (mode === 'inspect') {
+    const checks = [];
+    for (const [sceneIndex, scene] of prepared.scenes.entries()) for (const viewport of QUALITY_VIEWPORTS) {
+      const check = await inspectFormalScene({ ...prepared, scene, sceneIndex, snapshotSha256, viewport });
+      checks.push(check);
+      console.log(JSON.stringify({ sceneId: scene.id, viewport, passed: check.passed, issues: check.issues }));
+    }
+    await writeJsonFileAtomic(preflightPath, { ...identity, checkedAt: new Date().toISOString(),
+      passed: checks.every(check => check.passed), checks });
+    if (checks.some(check => !check.passed)) throw new Error('SAVED_STAGE_BROWSER_PREFLIGHT_FAILED');
+    return;
+  }
+  const preflight = JSON.parse(await fs.readFile(preflightPath, 'utf8'));
+  if (!preflight.passed || Object.entries(identity).some(([key, value]) => preflight[key] !== value)
+      || Date.now() - Date.parse(preflight.checkedAt) > 24 * 60 * 60 * 1000)
+    throw new Error('SAVED_STAGE_BROWSER_PREFLIGHT_REQUIRED');
+  let audioTailReceipt: string | undefined;
+  if (mode === 'complete-audio-tail') {
+    const repairedAsr = await readMiraFormalAsrJob(manifest.asrSourceRequestId);
+    const qualityFolders = await fs.readdir(path.join(process.cwd(), 'data/formal-quality-reviews'));
+    let cachedPass = false;
+    for (const directory of qualityFolders) {
+      try {
+        const review = JSON.parse(await fs.readFile(path.join('data/formal-quality-reviews', directory, `${snapshotSha256}.json`), 'utf8'));
+        const receipt = review.receipt;
+        if (review.status === 'passed' && receipt?.sessionId === prepared.sessionId
+            && receipt.stageId === prepared.stage.id && receipt.snapshotSha256 === snapshotSha256) {
+          const { receiptSha256, ...unsigned } = receipt;
+          cachedPass = qualitySha(unsigned) === receiptSha256;
+          if (cachedPass) break;
+        }
+      } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
+    }
+    if (!cachedPass || !repairedAsr || repairedAsr.classroomId !== prepared.stage.id
+        || repairedAsr.state !== 'succeeded' || (repairedAsr.similarityBps ?? 0) < 8500
+        || !('operatorRepair' in repairedAsr)) throw new Error('SAVED_STAGE_VERIFIED_AUDIO_REPAIR_REQUIRED');
+    audioTailReceipt = qualitySha(repairedAsr);
+  }
+  // A crash or concurrent operator is fail-closed; never delete a durable claim
+  // automatically. Review the saved result/paid ledger before resuming it.
+  lease = await acquireFormalQualityLock(path.join(folder, 'active.lock'));
+  const legacyClaim = path.join(folder, 'complete.claim');
+  try {
+    const legacy = JSON.parse(await fs.readFile(legacyClaim, 'utf8'));
+    if (!audioTailReceipt && legacy.repairSnapshotSha256 === snapshotSha256) throw new Error('SAVED_STAGE_PRIOR_COMPLETION_CLAIM');
+  } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
+  const claim = await fs.open(path.join(folder,
+    `complete-${snapshotSha256}${audioTailReceipt ? `-audio-${audioTailReceipt}` : ''}.claim`), 'wx', 0o600);
+  await claim.writeFile(JSON.stringify({ ...identity, pid: process.pid, createdAt: new Date().toISOString() }));
+  await claim.sync(); await claim.close();
+  try { await fs.writeFile(path.join(folder, 'source-job.json'), source, { flag: 'wx', mode: 0o600 }); }
+  catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST'
+        || sha(await fs.readFile(path.join(folder, 'source-job.json'))) !== sha(source)) throw error;
+  }
+  await writeJsonFileAtomic(path.join(folder, `repair-proposal-${snapshotSha256}.json`), proposal);
+  const completion = await recoverMiraFormalSavedStage(job.formalInput, repair, {
+    baseUrl: 'http://127.0.0.1:3100', cachedQualityOnly: !!audioTailReceipt,
+    onProgress: progress => { console.log(JSON.stringify(progress)); },
+  });
+  const receipt = { ...identity, kind: 'operator_saved_stage_repair', originalSessionStatus: prepared.originalSessionStatus,
+    recoveryId: `omsaved_${qualitySha(identity).slice(0, 24)}`, completedAt: new Date().toISOString(),
+    newAgentSessions: 0, newSearches: 0, result: completion.result };
+  const receiptSha256 = qualitySha(receipt);
+  await writeJsonFileAtomic(path.join(folder, 'completion.json'), { ...receipt, receiptSha256 });
+  if (sha(await fs.readFile(jobPath)) !== manifest.sourceJobSha256)
+    throw new Error('SAVED_STAGE_PROMOTION_SOURCE_CHANGED');
+  const result = completion.result;
+  await writeJsonFileAtomic(jobPath, { ...job, status: 'succeeded', step: 'completed', progress: 100,
+    error: undefined, message: 'Completed after audited repair of the saved classroom',
+    updatedAt: receipt.completedAt, completedAt: receipt.completedAt,
+    scenesGenerated: result.scenesCount, totalScenes: result.scenesCount,
+    result: { classroomId: result.id, url: result.url, scenesCount: result.scenesCount,
+      speechActionCount: result.speechActionCount, formalAudio: result.formalAudio,
+      professionalCreation: result.professionalCreation, research: result.research,
+      ...(result.media ? { media: result.media } : {}), ...(result.video ? { video: result.video } : {}) },
+    formalSavedStageRecovery: { originalStatus: 'failed', originalError: job.error,
+      originalCompletedAt: job.completedAt, sourceJobSha256: identity.sourceJobSha256,
+      sourceSnapshotSha256: identity.sourceSnapshotSha256, repairSnapshotSha256: snapshotSha256,
+      recoveryId: receipt.recoveryId, receiptSha256 } } satisfies ClassroomGenerationJob);
+  console.log(JSON.stringify({ status: 'succeeded', jobId: job.id, classroomId: result.id, receiptSha256 }));
+}
+main().then(async () => { await lease?.release(); process.exit(0); })
+  .catch(async error => { await lease?.release(); console.error(error.message); process.exit(1); });
diff --git a/tests/server/mira-formal-agent-budget.test.ts b/tests/server/mira-formal-agent-budget.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-agent-budget.test.ts
@@ -0,0 +1,28 @@
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { MIRA_FORMAL_AGENT_BUDGET, reserveMiraFormalAgentDispatch } from '@/lib/server/mira-formal-agent-budget';
+let root: string;
+const sessionId = `miraformal_${'a'.repeat(64)}`;
+const lockDeps = { withMutex: async <T>(_key: string, work: () => Promise<T>) => work(),
+  identity: async () => ({ pid: 123, hostname: 'test-host', startIdentity: 'current' }) };
+beforeEach(async () => { root = await mkdtemp(join(tmpdir(), 'formal-agent-budget-')); });
+afterEach(async () => { await rm(root, { recursive: true, force: true }); });
+describe('formal Agent provider dispatch allowance', () => {
+  it('includes legacy paid turns and retains a reservation across restarts', async () => {
+    await reserveMiraFormalAgentDispatch({ sessionId, inputCharacters: 100 },
+      { root, lockDeps, priorCalls: async () => 47 });
+    await expect(reserveMiraFormalAgentDispatch({ sessionId, inputCharacters: 100 },
+      { root, lockDeps, priorCalls: async () => 0 })).rejects.toThrow('FORMAL_AGENT_DISPATCH_BUDGET_EXHAUSTED');
+    const data = JSON.parse(await readFile(join(root, sessionId, 'dispatches.json'), 'utf8'));
+    expect(data.priorCalls).toBe(47); expect(data.dispatches).toHaveLength(1);
+  });
+  it('rejects long cumulative contexts before another paid dispatch', async () => {
+    await reserveMiraFormalAgentDispatch({ sessionId,
+      inputCharacters: MIRA_FORMAL_AGENT_BUDGET.maxCumulativeInputCharacters },
+      { root, lockDeps, priorCalls: async () => 0 });
+    await expect(reserveMiraFormalAgentDispatch({ sessionId, inputCharacters: 1 },
+      { root, lockDeps })).rejects.toThrow('FORMAL_AGENT_CONTEXT_BUDGET_EXHAUSTED');
+  });
+});
diff --git a/tests/server/mira-formal-audio-repair.test.ts b/tests/server/mira-formal-audio-repair.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-audio-repair.test.ts
@@ -0,0 +1,61 @@
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+const audio = vi.hoisted(() => ({ readMiraFormalAsrJob: vi.fn(), readMiraFormalTtsJob: vi.fn(),
+  executeMiraFormalTts: vi.fn(), executeMiraFormalAsr: vi.fn(), readMiraFormalTtsAsset: vi.fn(),
+  assertMiraFormalAudioProviderReady: vi.fn() }));
+vi.mock('@/lib/server/mira-formal-audio', () => audio);
+vi.mock('@/lib/server/mira-formal-quality-lock', () => ({ acquireFormalQualityLock: async () => ({ release: async () => {} }) }));
+import { repairMiraFormalAudioSegment } from '@/lib/server/mira-formal-audio-repair';
+const sha = (s: string) => createHash('sha256').update(s).digest('hex');
+const text = '张大嘴巴，跟着老师读。';
+const original = { requestId: 'formal_tts_example', requestSha256: '1'.repeat(64), classroomId: 'stage-example',
+  textSha256: sha(text), state: 'ambiguous', kind: 'tts', subject: 'chinese', createdAt: '2026-09-09T00:00:00Z' };
+const input = { asrRequestId: 'formal_asr_example', ttsRequestId: original.requestId,
+  expectedOriginalTtsRequestSha256: original.requestSha256, classroomId: original.classroomId,
+  expectedOriginalAudioSha256: null, text };
+let root: string;
+const jobFile = (kind: string, id: string) => path.join(root, 'jobs', kind, sha(id) + '.json');
+beforeEach(async () => {
+  vi.clearAllMocks(); root = await fs.mkdtemp(path.join(os.tmpdir(), 'mira-audio-repair-'));
+  vi.stubEnv('MIRA_FORMAL_AUDIO_DATA_DIR', root);
+  await fs.mkdir(path.join(root, 'jobs/tts'), { recursive: true });
+  await fs.mkdir(path.join(root, 'jobs/asr'), { recursive: true });
+  await fs.writeFile(jobFile('tts', original.requestId), JSON.stringify(original));
+  audio.readMiraFormalTtsJob.mockResolvedValue(original); audio.readMiraFormalAsrJob.mockResolvedValue(null);
+  audio.executeMiraFormalTts.mockImplementation(async request => ({ record: { ...original, ...request,
+    state: 'succeeded', requestSha256: qualitySha(request), audioSha256: '2'.repeat(64), assetId: 'replacement' } }));
+  audio.executeMiraFormalAsr.mockImplementation(async request => ({ record: { ...request,
+    state: 'succeeded', kind: 'asr', requestSha256: qualitySha(request), similarityBps: 9700 } }));
+});
+afterEach(async () => { vi.unstubAllEnvs(); await fs.rm(root, { recursive: true, force: true }); });
+describe('single narration recovery audit', () => {
+  it('preserves an ambiguous original and resumes a partially promoted pair', async () => {
+    await repairMiraFormalAudioSegment(input);
+    const promoted = JSON.parse(await fs.readFile(jobFile('tts', original.requestId), 'utf8'));
+    expect(promoted.operatorRepair.physicalTtsRequestId).toBe('formal_tts_example.repair1');
+    expect(promoted.requestSha256).toBe(original.requestSha256);
+    const source = JSON.parse(await fs.readFile(path.join(root, 'repairs', sha(input.asrRequestId), 'source.json'), 'utf8'));
+    expect(source.tts).toEqual(original);
+    // Simulate interruption after just the TTS side of the journal was applied.
+    await fs.unlink(jobFile('asr', input.asrRequestId));
+    await repairMiraFormalAudioSegment(input);
+    const asr = JSON.parse(await fs.readFile(jobFile('asr', input.asrRequestId), 'utf8'));
+    expect(asr.similarityBps).toBe(9700); expect(asr.audioSha256).toBe(promoted.audioSha256);
+    expect(asr.ttsRequestId).toBe(original.requestId);
+  });
+  it('leaves the original untouched when replacement ASR does not pass', async () => {
+    audio.executeMiraFormalAsr.mockImplementation(async request => ({ record: { ...request,
+      state: 'succeeded', requestSha256: qualitySha(request), similarityBps: 8000 } }));
+    await expect(repairMiraFormalAudioSegment(input)).rejects.toThrow('AUDIO_REPAIR_ASR_NOT_VERIFIED');
+    expect(JSON.parse(await fs.readFile(jobFile('tts', original.requestId), 'utf8'))).toEqual(original);
+    await expect(fs.stat(jobFile('asr', input.asrRequestId))).rejects.toMatchObject({ code: 'ENOENT' });
+  });
+  it('rejects mismatched source text before any paid request', async () => {
+    await expect(repairMiraFormalAudioSegment({ ...input, text: 'another narration' })).rejects.toThrow('AUDIO_REPAIR_SOURCE_NOT_PROVEN');
+    expect(audio.executeMiraFormalTts).not.toHaveBeenCalled();
+  });
+});
