+import { mkdir, readFile } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { getServerPersistenceProvider } from '@/lib/persistence/server-provider';
+import { acquireFormalQualityLock, type QualityLockDeps } from './mira-formal-quality-lock';
+import { writeJsonFileAtomic } from './classroom-storage';
+
+/** Separate from content creation, independent-review and media budgets. */
+export const MIRA_FORMAL_AGENT_BUDGET = {
+  policyId: 'mira-formal-agent-budget.v1', maxDispatches: 48,
+  maxCumulativeInputCharacters: 8_000_000, maxOutputTokensPerDispatch: 16_384,
+  maxRetries: 0,
+} as const;
+
+export async function reserveMiraFormalAgentDispatch(input: {
+  sessionId: string; inputCharacters: number;
+}, deps: { root?: string; priorCalls?: () => Promise<number>; lockDeps?: QualityLockDeps } = {}) {
+  if (!/^miraformal_[a-f0-9]{64}$/.test(input.sessionId)
+      || !Number.isSafeInteger(input.inputCharacters) || input.inputCharacters < 1)
+    throw new Error('FORMAL_AGENT_BUDGET_IDENTITY_INVALID');
+  const folder = join(resolve(deps.root ?? 'data/formal-agent-budgets'), input.sessionId);
+  await mkdir(folder, { recursive: true, mode: 0o700 });
+  const lock = await acquireFormalQualityLock(join(folder, 'budget.lock'), deps.lockDeps);
+  try {
+    const file = join(folder, 'dispatches.json');
+    let ledger: { policyId: string; priorCalls: number; dispatches: Array<{ inputCharacters: number; reservedAt: string }> };
+    try { ledger = JSON.parse(await readFile(file, 'utf8')); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      const priorCalls = deps.priorCalls ? await deps.priorCalls() : await (async () => {
+        const { pool } = await getServerPersistenceProvider(process.env.DATABASE_URL ?? '');
+        const result = await pool.query<{ count: string }>(
+          `SELECT COUNT(*)::text AS count FROM agent_session_entries WHERE session_id=$1
+            AND data#>>'{message,role}'='assistant' AND data#>>'{message,model}'='maic-connector'`,
+          [input.sessionId]);
+        return Number(result.rows[0].count);
+      })();
+      ledger = { policyId: MIRA_FORMAL_AGENT_BUDGET.policyId, priorCalls, dispatches: [] };
+    }
+    if (ledger.policyId !== MIRA_FORMAL_AGENT_BUDGET.policyId || !Number.isSafeInteger(ledger.priorCalls)
+        || ledger.priorCalls < 0 || !Array.isArray(ledger.dispatches)
+        || ledger.dispatches.some(row => !Number.isSafeInteger(row.inputCharacters) || row.inputCharacters < 1))
+      throw new Error('FORMAL_AGENT_BUDGET_LEDGER_INVALID');
+    if (ledger.priorCalls + ledger.dispatches.length >= MIRA_FORMAL_AGENT_BUDGET.maxDispatches)
+      throw new Error('FORMAL_AGENT_DISPATCH_BUDGET_EXHAUSTED');
+    const characters = ledger.dispatches.reduce((sum, row) => sum + row.inputCharacters, 0);
+    if (characters + input.inputCharacters > MIRA_FORMAL_AGENT_BUDGET.maxCumulativeInputCharacters)
+      throw new Error('FORMAL_AGENT_CONTEXT_BUDGET_EXHAUSTED');
+    ledger.dispatches.push({ inputCharacters: input.inputCharacters, reservedAt: new Date().toISOString() });
+    // Reserve before touching the provider. Aborted/unknown dispatches stay charged
+    // to this cap; process restarts cannot give the session a fresh allowance.
+    await writeJsonFileAtomic(file, ledger);
+  } finally { await lock.release(); }
+}
