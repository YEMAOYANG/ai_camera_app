index 0000000000000000000000000000000000000000..d684fec8fccc28f299fabe2857f4d95599a7145d
--- /dev/null
+++ b/app/api/generate-classroom/[jobId]/formal-citation-recovery/route.ts
@@ -0,0 +1,144 @@
+import { after, type NextRequest, NextResponse } from 'next/server';
+
+import { createLogger } from '@/lib/logger';
+import { buildRequestOrigin } from '@/lib/server/classroom-storage';
+import {
+  claimMiraFormalCitationRecovery,
+  getMiraFormalCitationRecoveryRuntimePolicy,
+  MIRA_FORMAL_CITATION_RECOVERY_FIXED_SOURCE_JOB_ID,
+  MIRA_FORMAL_CITATION_RECOVERY_SOURCE_ERROR,
+  MiraFormalCitationRecoveryError,
+  publicMiraFormalCitationRecoveryPayload,
+  readMiraFormalCitationRecovery,
+  runMiraFormalCitationRecovery,
+  type MiraFormalCitationRecoveryExpectedSource,
+  type MiraFormalCitationRecoveryRecord,
+} from '@/lib/server/mira-formal-citation-recovery';
+import {
+  authorizeMiraInternalLoopbackRequest,
+  MiraInternalLoopbackAuthError,
+} from '@/lib/server/mira-internal-loopback-auth';
+
+export const dynamic = 'force-dynamic';
+export const maxDuration = 3600;
+
+const log = createLogger('FormalCitationRecovery API');
+
+function json(payload: unknown, status = 200): NextResponse {
+  return NextResponse.json(payload, { status });
+}
+
+function error(code: string, message: string, status: number): NextResponse {
+  return json({ code, message }, status);
+}
+
+function authorize(req: NextRequest, sourceJobId: string): NextResponse | null {
+  try {
+    const policy = getMiraFormalCitationRecoveryRuntimePolicy();
+    if (
+      !policy.enabled ||
+      sourceJobId !== MIRA_FORMAL_CITATION_RECOVERY_FIXED_SOURCE_JOB_ID ||
+      sourceJobId !== policy.sourceJobId
+    ) {
+      return error('NOT_FOUND', 'Formal citation recovery source not found', 404);
+    }
+    authorizeMiraInternalLoopbackRequest(req);
+    return null;
+  } catch (caught) {
+    if (caught instanceof MiraInternalLoopbackAuthError) {
+      return error('INVALID_CREDENTIALS', 'Invalid formal citation recovery credentials', 403);
+    }
+    log.error('Formal citation recovery policy is unavailable:', caught);
+    return error('PROVIDER_DISABLED', 'Formal citation recovery policy is unavailable', 503);
+  }
+}
+
+function responseStatus(record: MiraFormalCitationRecoveryRecord): number {
+  return record.status === 'queued' || record.status === 'running' ? 202 : 200;
+}
+
+function scheduleRecovery(req: NextRequest, record: MiraFormalCitationRecoveryRecord): void {
+  if (
+    record.status === 'queued' ||
+    (record.status === 'running' && record.step === 'publishing' && record.pendingTerminalSuccess)
+  ) {
+    const baseUrl = buildRequestOrigin(req);
+    after(() => runMiraFormalCitationRecovery(record.source.jobId, baseUrl));
+  }
+}
+
+function parseRequestBody(value: unknown): {
+  recoveryRequestId: string;
+  expectedSource: MiraFormalCitationRecoveryExpectedSource;
+} | null {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
+  const body = value as Record<string, unknown>;
+  if (Object.keys(body).sort().join(',') !== 'expectedSource,recoveryRequestId') return null;
+  const rawExpected = body.expectedSource;
+  if (!rawExpected || typeof rawExpected !== 'object' || Array.isArray(rawExpected)) return null;
+  if (
+    Object.keys(rawExpected).sort().join(',') !== 'error,formalInputSha256,runtimeRequestId,status'
+  ) {
+    return null;
+  }
+  const expected = rawExpected as Record<string, unknown>;
+  if (
+    typeof body.recoveryRequestId !== 'string' ||
+    typeof expected.runtimeRequestId !== 'string' ||
+    typeof expected.formalInputSha256 !== 'string' ||
+    expected.status !== 'failed' ||
+    expected.error !== MIRA_FORMAL_CITATION_RECOVERY_SOURCE_ERROR
+  ) {
+    return null;
+  }
+  return {
+    recoveryRequestId: body.recoveryRequestId,
+    expectedSource: {
+      status: 'failed',
+      error: MIRA_FORMAL_CITATION_RECOVERY_SOURCE_ERROR,
+      runtimeRequestId: expected.runtimeRequestId,
+      formalInputSha256: expected.formalInputSha256,
+    },
+  };
+}
+
+export async function POST(req: NextRequest, context: { params: Promise<{ jobId: string }> }) {
+  const { jobId } = await context.params;
+  const denied = authorize(req, jobId);
+  if (denied) return denied;
+  try {
+    const parsed = parseRequestBody(await req.json());
+    if (!parsed) {
+      return error('INVALID_REQUEST', 'Invalid formal citation recovery request contract', 400);
+    }
+    const { record } = await claimMiraFormalCitationRecovery({
+      sourceJobId: jobId,
+      recoveryRequestId: parsed.recoveryRequestId,
+      expectedSource: parsed.expectedSource,
+    });
+    scheduleRecovery(req, record);
+    return json(publicMiraFormalCitationRecoveryPayload(record), responseStatus(record));
+  } catch (caught) {
+    if (caught instanceof MiraFormalCitationRecoveryError) {
+      const status = caught.code === 'recovery_already_claimed' ? 409 : 400;
+      return error('INVALID_REQUEST', caught.message, status);
+    }
+    log.error('Failed to claim formal citation recovery:', caught);
+    return error('INTERNAL_ERROR', 'Failed to claim formal citation recovery', 500);
+  }
+}
+
+export async function GET(req: NextRequest, context: { params: Promise<{ jobId: string }> }) {
+  const { jobId } = await context.params;
+  const denied = authorize(req, jobId);
+  if (denied) return denied;
+  try {
+    const record = await readMiraFormalCitationRecovery(jobId);
+    if (!record) return error('NOT_FOUND', 'Formal citation recovery not found', 404);
+    scheduleRecovery(req, record);
+    return json(publicMiraFormalCitationRecoveryPayload(record), responseStatus(record));
+  } catch (caught) {
+    log.error('Failed to read formal citation recovery:', caught);
+    return error('INTERNAL_ERROR', 'Failed to read formal citation recovery', 500);
+  }
+}
