 }
 
@@ -404,3 +416,89 @@ export async function markClassroomGenerationJobFailed(
     error,
   });
 }
+
+/**
+ * Atomically promote the one exact citation-recovery source job. The original
+ * terminal bytes are the compare token; no ordinary generation transition is
+ * reused, and a repeated call is accepted only when the same recovery receipt
+ * is already present.
+ */
+export async function promoteFailedFormalClassroomGenerationJobFromCitationRecovery(input: {
+  jobId: string;
+  expected: {
+    error: 'FORMAL_PROFESSIONAL_RESEARCH_CITATION_MISSING';
+    formalInputSha256: string;
+    completedAt: string;
+    jobSnapshotSha256: string;
+  };
+  recovery: {
+    recoveryId: string;
+    receiptSha256: string;
+  };
+  result: NonNullable<ClassroomGenerationJob['result']>;
+}): Promise<{ job: ClassroomGenerationJob; applied: boolean }> {
+  if (
+    !isValidClassroomJobId(input.jobId) ||
+    input.expected.error !== 'FORMAL_PROFESSIONAL_RESEARCH_CITATION_MISSING' ||
+    !/^[a-f0-9]{64}$/u.test(input.expected.formalInputSha256) ||
+    !/^[a-f0-9]{64}$/u.test(input.expected.jobSnapshotSha256) ||
+    !/^[a-f0-9]{64}$/u.test(input.recovery.receiptSha256) ||
+    !/^[A-Za-z0-9_-]+$/u.test(input.recovery.recoveryId)
+  ) {
+    throw new Error('FORMAL_CITATION_RECOVERY_PROMOTION_INVALID');
+  }
+  return withJobLock(input.jobId, async () => {
+    const raw = await fs.readFile(jobFilePath(input.jobId));
+    const existing = JSON.parse(raw.toString('utf8')) as ClassroomGenerationJob;
+    const audit = existing.formalCitationRecovery;
+    if (existing.status === 'succeeded') {
+      if (
+        existing.formalInputSha256 === input.expected.formalInputSha256 &&
+        audit?.originalStatus === 'failed' &&
+        audit.originalError === input.expected.error &&
+        audit.originalCompletedAt === input.expected.completedAt &&
+        audit.jobSnapshotSha256 === input.expected.jobSnapshotSha256 &&
+        audit.recoveryId === input.recovery.recoveryId &&
+        audit.receiptSha256 === input.recovery.receiptSha256 &&
+        canonicalJson(existing.result) === canonicalJson(input.result)
+      ) {
+        return { job: existing, applied: false };
+      }
+      throw new Error('FORMAL_CITATION_RECOVERY_PROMOTION_CONFLICT');
+    }
+    if (
+      existing.status !== 'failed' ||
+      existing.error !== input.expected.error ||
+      existing.formalInputSha256 !== input.expected.formalInputSha256 ||
+      existing.completedAt !== input.expected.completedAt ||
+      sha256(raw) !== input.expected.jobSnapshotSha256 ||
+      existing.formalCitationRecovery !== undefined
+    ) {
+      throw new Error('FORMAL_CITATION_RECOVERY_SOURCE_MISMATCH');
+    }
+    const completedAt = new Date().toISOString();
+    const updated: ClassroomGenerationJob = {
+      ...existing,
+      status: 'succeeded',
+      step: 'completed',
+      progress: 100,
+      message: 'Classroom generation completed through formal citation recovery',
+      updatedAt: completedAt,
+      completedAt,
+      scenesGenerated: input.result.scenesCount,
+      totalScenes: input.result.scenesCount,
+      result: input.result,
+      formalCitationRecovery: {
+        originalStatus: 'failed',
+        originalError: input.expected.error,
+        originalCompletedAt: input.expected.completedAt,
+        jobSnapshotSha256: input.expected.jobSnapshotSha256,
+        recoveryId: input.recovery.recoveryId,
+        receiptSha256: input.recovery.receiptSha256,
+      },
+      error: undefined,
+    };
+    await writeJsonFileAtomic(jobFilePath(input.jobId), updated);
+    return { job: updated, applied: true };
+  });
+}
