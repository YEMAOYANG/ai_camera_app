@@ -0,0 +1,766 @@
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+
+import { createLogger } from '@/lib/logger';
+import type { GenerateClassroomInput } from '@/lib/server/classroom-generation';
+import { CLASSROOM_JOBS_DIR, writeJsonFileAtomic } from '@/lib/server/classroom-storage';
+import {
+  promoteFailedFormalClassroomGenerationJobFromCitationRecovery,
+  type ClassroomGenerationJob,
+} from '@/lib/server/classroom-job-store';
+import {
+  recoverMiraFormalProfessionalClassroomFromSucceededSession,
+  resolveMiraFormalProfessionalSucceededSession,
+} from '@/lib/server/mira-formal-professional-classroom';
+
+export const MIRA_FORMAL_CITATION_RECOVERY_SCHEMA =
+  'mira.openmaic.formal-citation-recovery.v1' as const;
+export const MIRA_FORMAL_CITATION_RECOVERY_KIND = 'formal_citation_recovery' as const;
+export const MIRA_FORMAL_CITATION_RECOVERY_POLICY_VERSION =
+  'mira-formal-citation-recovery.v1' as const;
+export const MIRA_FORMAL_CITATION_REPAIR_POLICY_VERSION =
+  'mira-formal-citation-footer-canonicalize.v1' as const;
+export const MIRA_FORMAL_CITATION_RECOVERY_SOURCE_ERROR =
+  'FORMAL_PROFESSIONAL_RESEARCH_CITATION_MISSING' as const;
+export const MIRA_FORMAL_CITATION_RECOVERY_FIXED_SOURCE_JOB_ID =
+  'omformal_e6b6986c631a548c9756037e' as const;
+
+const FORMAL_CITATION_RECOVERIES_DIR = path.join(
+  process.cwd(),
+  'data',
+  'formal-citation-recoveries',
+);
+const FILE_LOCK_RETRY_MS = 10;
+const FILE_LOCK_MAX_ATTEMPTS = 500;
+const FILE_LOCK_STALE_MS = 60_000;
+const log = createLogger('MiraFormalCitationRecovery');
+
+export type MiraFormalCitationRecoveryStatus = 'queued' | 'running' | 'succeeded' | 'failed';
+
+export interface MiraFormalCitationRecoveryExpectedSource {
+  status: 'failed';
+  error: typeof MIRA_FORMAL_CITATION_RECOVERY_SOURCE_ERROR;
+  runtimeRequestId: string;
+  formalInputSha256: string;
+}
+
+export interface MiraFormalCitationRecoverySource {
+  jobId: string;
+  runtimeRequestId: string;
+  status: 'failed';
+  error: typeof MIRA_FORMAL_CITATION_RECOVERY_SOURCE_ERROR;
+  formalInputSha256: string;
+  completedAt: string;
+  jobSnapshotSha256: string;
+}
+
+export interface MiraFormalCitationRecoveryRepair {
+  policyVersion: typeof MIRA_FORMAL_CITATION_REPAIR_POLICY_VERSION;
+  sourceUrls: string[];
+  repairedSceneIds: string[];
+  beforeScenesSha256: string;
+  afterScenesSha256: string;
+  repairSha256: string;
+}
+
+export interface MiraFormalCitationRecoveryResult {
+  classroomId: string;
+  url: string;
+  scenesCount: number;
+  speechActionCount: number;
+  formalAudio: NonNullable<NonNullable<ClassroomGenerationJob['result']>['formalAudio']>;
+  professionalCreation: NonNullable<
+    NonNullable<ClassroomGenerationJob['result']>['professionalCreation']
+  >;
+  research: NonNullable<NonNullable<ClassroomGenerationJob['result']>['research']>;
+  createdAt: string;
+}
+
+interface PendingTerminalSuccess {
+  completedAt: string;
+  updatedAt: string;
+  repair: MiraFormalCitationRecoveryRepair;
+  result: MiraFormalCitationRecoveryResult;
+  receiptSha256: string;
+}
+
+export interface MiraFormalCitationRecoveryRecord {
+  schemaVersion: typeof MIRA_FORMAL_CITATION_RECOVERY_SCHEMA;
+  kind: typeof MIRA_FORMAL_CITATION_RECOVERY_KIND;
+  recoveryId: string;
+  recoveryRequestId: string;
+  source: MiraFormalCitationRecoverySource;
+  calls: {
+    llm: 0;
+    webSearch: 0;
+    fetchUrl: 0;
+    imageGeneration: 0;
+    videoGeneration: 0;
+  };
+  policy: {
+    version: typeof MIRA_FORMAL_CITATION_RECOVERY_POLICY_VERSION;
+    patchSha256: string;
+  };
+  sessionId: string;
+  stageId: string;
+  status: MiraFormalCitationRecoveryStatus;
+  step: string;
+  progress: number;
+  message: string;
+  repair: MiraFormalCitationRecoveryRepair | null;
+  result: MiraFormalCitationRecoveryResult | null;
+  createdAt: string;
+  updatedAt: string;
+  startedAt?: string;
+  completedAt?: string;
+  error?: { code: string; message: string };
+  receiptSha256?: string;
+  pendingTerminalSuccess?: PendingTerminalSuccess;
+}
+
+export interface MiraFormalCitationRecoveryPublicPayload {
+  schemaVersion: typeof MIRA_FORMAL_CITATION_RECOVERY_SCHEMA;
+  kind: typeof MIRA_FORMAL_CITATION_RECOVERY_KIND;
+  recoveryId: string;
+  source: MiraFormalCitationRecoverySource;
+  status: MiraFormalCitationRecoveryStatus;
+  step: string;
+  progress: number;
+  message: string;
+  calls: MiraFormalCitationRecoveryRecord['calls'];
+  repair: MiraFormalCitationRecoveryRepair | null;
+  result: MiraFormalCitationRecoveryResult | null;
+  createdAt: string;
+  updatedAt: string;
+  startedAt?: string;
+  completedAt?: string;
+  error?: { code: string; message: string };
+  receiptSha256?: string;
+  pollUrl: string;
+  done: boolean;
+}
+
+export class MiraFormalCitationRecoveryError extends Error {
+  constructor(
+    public readonly code:
+      | 'invalid_recovery_request'
+      | 'recovery_source_mismatch'
+      | 'recovery_already_claimed'
+      | 'recovery_not_found',
+    message: string,
+  ) {
+    super(message);
+    this.name = 'MiraFormalCitationRecoveryError';
+  }
+}
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(
+      Object.entries(value as Record<string, unknown>)
+        .filter(([, item]) => item !== undefined)
+        .sort(([left], [right]) => left.localeCompare(right))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  }
+  return value;
+}
+
+function canonicalJson(value: unknown): string {
+  return JSON.stringify(canonical(value));
+}
+
+function sha256(value: string | Uint8Array): string {
+  return createHash('sha256').update(value).digest('hex');
+}
+
+function canonicalSha256(value: unknown): string {
+  return sha256(canonicalJson(value));
+}
+
+function validIdentifier(value: string): boolean {
+  return /^[A-Za-z0-9._:-]{8,128}$/u.test(value);
+}
+
+function validSha256(value: string): boolean {
+  return /^[0-9a-f]{64}$/u.test(value);
+}
+
+function recoveryPath(sourceJobId: string): string {
+  return path.join(FORMAL_CITATION_RECOVERIES_DIR, `${sourceJobId}.json`);
+}
+
+function lockPath(sourceJobId: string): string {
+  return path.join(FORMAL_CITATION_RECOVERIES_DIR, `.${sourceJobId}.lock`);
+}
+
+function sourceJobPath(sourceJobId: string): string {
+  return path.join(CLASSROOM_JOBS_DIR, `${sourceJobId}.json`);
+}
+
+function pollPath(sourceJobId: string): string {
+  return `/api/generate-classroom/${sourceJobId}/formal-citation-recovery`;
+}
+
+const inProcessLocks = new Map<string, Promise<void>>();
+
+async function waitForLock(): Promise<void> {
+  await new Promise<void>((resolve) => setTimeout(resolve, FILE_LOCK_RETRY_MS));
+}
+
+async function withFileLock<T>(sourceJobId: string, fn: () => Promise<T>): Promise<T> {
+  await fs.mkdir(FORMAL_CITATION_RECOVERIES_DIR, { recursive: true });
+  const filePath = lockPath(sourceJobId);
+  let handle: Awaited<ReturnType<typeof fs.open>> | null = null;
+  for (let attempt = 0; attempt < FILE_LOCK_MAX_ATTEMPTS; attempt += 1) {
+    try {
+      handle = await fs.open(filePath, 'wx');
+      break;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+      try {
+        const stat = await fs.stat(filePath);
+        if (Date.now() - stat.mtimeMs > FILE_LOCK_STALE_MS) {
+          await fs.unlink(filePath);
+          continue;
+        }
+      } catch (statError) {
+        if ((statError as NodeJS.ErrnoException).code === 'ENOENT') continue;
+        throw statError;
+      }
+      await waitForLock();
+    }
+  }
+  if (!handle) throw new Error('FORMAL_CITATION_RECOVERY_LOCK_TIMEOUT');
+  try {
+    return await fn();
+  } finally {
+    await handle.close();
+    await fs.unlink(filePath).catch((error: NodeJS.ErrnoException) => {
+      if (error.code !== 'ENOENT') throw error;
+    });
+  }
+}
+
+async function withRecoveryLock<T>(sourceJobId: string, fn: () => Promise<T>): Promise<T> {
+  const previous = inProcessLocks.get(sourceJobId) ?? Promise.resolve();
+  let release: () => void;
+  const next = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  inProcessLocks.set(sourceJobId, next);
+  try {
+    await previous;
+    return await withFileLock(sourceJobId, fn);
+  } finally {
+    release!();
+    if (inProcessLocks.get(sourceJobId) === next) inProcessLocks.delete(sourceJobId);
+  }
+}
+
+async function readExisting(sourceJobId: string): Promise<MiraFormalCitationRecoveryRecord | null> {
+  try {
+    return JSON.parse(
+      await fs.readFile(recoveryPath(sourceJobId), 'utf8'),
+    ) as MiraFormalCitationRecoveryRecord;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+}
+
+async function writeRecord(record: MiraFormalCitationRecoveryRecord): Promise<void> {
+  await writeJsonFileAtomic(recoveryPath(record.source.jobId), record);
+}
+
+function exactFailedSource(
+  value: unknown,
+  sourceJobId: string,
+  expected: MiraFormalCitationRecoveryExpectedSource,
+): value is ClassroomGenerationJob & {
+  runtimeRequestId: string;
+  formalInputSha256: string;
+  formalInput: GenerateClassroomInput;
+  completedAt: string;
+} {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+  const job = value as ClassroomGenerationJob;
+  return Boolean(
+    job.id === sourceJobId &&
+    job.status === expected.status &&
+    job.error === expected.error &&
+    job.runtimeRequestId === expected.runtimeRequestId &&
+    job.formalInputSha256 === expected.formalInputSha256 &&
+    job.formalInput &&
+    canonicalSha256(job.formalInput) === expected.formalInputSha256 &&
+    typeof job.completedAt === 'string' &&
+    job.completedAt.length > 0 &&
+    job.formalCitationRecovery === undefined,
+  );
+}
+
+export function getMiraFormalCitationRecoveryRuntimePolicy(): {
+  enabled: boolean;
+  sourceJobId: string;
+  policyVersion: typeof MIRA_FORMAL_CITATION_RECOVERY_POLICY_VERSION;
+  patchSha256: string;
+} {
+  const enabled = process.env.MIRA_OPENMAIC_FORMAL_CITATION_RECOVERY_ENABLED === '1';
+  const sourceJobId = process.env.MIRA_OPENMAIC_FORMAL_CITATION_RECOVERY_SOURCE_JOB_ID || '';
+  const patchSha256 = process.env.MIRA_OPENMAIC_FORMAL_CITATION_RECOVERY_PATCH_SHA256 || '';
+  if (
+    enabled &&
+    (sourceJobId !== MIRA_FORMAL_CITATION_RECOVERY_FIXED_SOURCE_JOB_ID || !validSha256(patchSha256))
+  ) {
+    throw new Error('Mira formal citation recovery policy is invalid');
+  }
+  return {
+    enabled,
+    sourceJobId,
+    policyVersion: MIRA_FORMAL_CITATION_RECOVERY_POLICY_VERSION,
+    patchSha256,
+  };
+}
+
+function assertExpectedSource(value: MiraFormalCitationRecoveryExpectedSource): void {
+  if (
+    value.status !== 'failed' ||
+    value.error !== MIRA_FORMAL_CITATION_RECOVERY_SOURCE_ERROR ||
+    !validIdentifier(value.runtimeRequestId) ||
+    !validSha256(value.formalInputSha256)
+  ) {
+    throw new MiraFormalCitationRecoveryError(
+      'invalid_recovery_request',
+      'Invalid formal citation recovery source contract',
+    );
+  }
+}
+
+export async function claimMiraFormalCitationRecovery(input: {
+  sourceJobId: string;
+  recoveryRequestId: string;
+  expectedSource: MiraFormalCitationRecoveryExpectedSource;
+}): Promise<{ record: MiraFormalCitationRecoveryRecord; created: boolean }> {
+  const policy = getMiraFormalCitationRecoveryRuntimePolicy();
+  assertExpectedSource(input.expectedSource);
+  if (
+    !policy.enabled ||
+    input.sourceJobId !== MIRA_FORMAL_CITATION_RECOVERY_FIXED_SOURCE_JOB_ID ||
+    input.sourceJobId !== policy.sourceJobId ||
+    !validIdentifier(input.recoveryRequestId)
+  ) {
+    throw new MiraFormalCitationRecoveryError(
+      'invalid_recovery_request',
+      'Formal citation recovery is unavailable for this request',
+    );
+  }
+  return withRecoveryLock(input.sourceJobId, async () => {
+    const existing = await readExisting(input.sourceJobId);
+    if (existing) {
+      if (
+        existing.recoveryRequestId !== input.recoveryRequestId ||
+        existing.source.runtimeRequestId !== input.expectedSource.runtimeRequestId ||
+        existing.source.formalInputSha256 !== input.expectedSource.formalInputSha256 ||
+        existing.policy.patchSha256 !== policy.patchSha256
+      ) {
+        throw new MiraFormalCitationRecoveryError(
+          'recovery_already_claimed',
+          'Formal citation recovery was already claimed by a different request',
+        );
+      }
+      return { record: existing, created: false };
+    }
+    let raw: Uint8Array;
+    try {
+      raw = await fs.readFile(sourceJobPath(input.sourceJobId));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+        throw new MiraFormalCitationRecoveryError(
+          'recovery_source_mismatch',
+          'Formal citation recovery source job was not found',
+        );
+      }
+      throw error;
+    }
+    const job = JSON.parse(Buffer.from(raw).toString('utf8')) as unknown;
+    if (!exactFailedSource(job, input.sourceJobId, input.expectedSource)) {
+      throw new MiraFormalCitationRecoveryError(
+        'recovery_source_mismatch',
+        'Formal citation recovery source no longer matches the fixed failed job',
+      );
+    }
+    const identity = await resolveMiraFormalProfessionalSucceededSession(job.formalInput);
+    const now = new Date().toISOString();
+    const snapshotSha256 = sha256(raw);
+    const record: MiraFormalCitationRecoveryRecord = {
+      schemaVersion: MIRA_FORMAL_CITATION_RECOVERY_SCHEMA,
+      kind: MIRA_FORMAL_CITATION_RECOVERY_KIND,
+      recoveryId: `omcitation_${sha256(
+        `${input.sourceJobId}\n${input.recoveryRequestId}\n${snapshotSha256}`,
+      ).slice(0, 32)}`,
+      recoveryRequestId: input.recoveryRequestId,
+      source: {
+        jobId: input.sourceJobId,
+        runtimeRequestId: job.runtimeRequestId,
+        status: 'failed',
+        error: MIRA_FORMAL_CITATION_RECOVERY_SOURCE_ERROR,
+        formalInputSha256: job.formalInputSha256,
+        completedAt: job.completedAt,
+        jobSnapshotSha256: snapshotSha256,
+      },
+      calls: {
+        llm: 0,
+        webSearch: 0,
+        fetchUrl: 0,
+        imageGeneration: 0,
+        videoGeneration: 0,
+      },
+      policy: {
+        version: MIRA_FORMAL_CITATION_RECOVERY_POLICY_VERSION,
+        patchSha256: policy.patchSha256,
+      },
+      sessionId: identity.sessionId,
+      stageId: identity.stageId,
+      status: 'queued',
+      step: 'queued',
+      progress: 0,
+      message: 'Formal citation recovery queued for the existing professional classroom',
+      repair: null,
+      result: null,
+      createdAt: now,
+      updatedAt: now,
+    };
+    await writeRecord(record);
+    return { record, created: true };
+  });
+}
+
+function publicPayloadFromRecord(
+  record: MiraFormalCitationRecoveryRecord,
+): MiraFormalCitationRecoveryPublicPayload {
+  return {
+    schemaVersion: record.schemaVersion,
+    kind: record.kind,
+    recoveryId: record.recoveryId,
+    source: record.source,
+    status: record.status,
+    step: record.step,
+    progress: record.progress,
+    message: record.message,
+    calls: record.calls,
+    repair: record.repair,
+    result: record.result,
+    createdAt: record.createdAt,
+    updatedAt: record.updatedAt,
+    ...(record.startedAt ? { startedAt: record.startedAt } : {}),
+    ...(record.completedAt ? { completedAt: record.completedAt } : {}),
+    ...(record.error ? { error: record.error } : {}),
+    ...(record.receiptSha256 ? { receiptSha256: record.receiptSha256 } : {}),
+    pollUrl: pollPath(record.source.jobId),
+    done: record.status === 'succeeded' || record.status === 'failed',
+  };
+}
+
+export function publicMiraFormalCitationRecoveryPayload(
+  record: MiraFormalCitationRecoveryRecord,
+): MiraFormalCitationRecoveryPublicPayload {
+  return publicPayloadFromRecord(record);
+}
+
+function withTerminalReceipt(
+  record: MiraFormalCitationRecoveryRecord,
+): MiraFormalCitationRecoveryRecord {
+  const unsigned = publicPayloadFromRecord({ ...record, receiptSha256: undefined });
+  return { ...record, receiptSha256: canonicalSha256(unsigned) };
+}
+
+async function updateRunningProgress(
+  sourceJobId: string,
+  progress: { step: string; progress: number; message: string },
+): Promise<void> {
+  await withRecoveryLock(sourceJobId, async () => {
+    const record = await readExisting(sourceJobId);
+    if (!record || record.status !== 'running' || record.pendingTerminalSuccess) return;
+    await writeRecord({
+      ...record,
+      step: progress.step,
+      progress: Math.max(record.progress, Math.min(98, progress.progress)),
+      message: progress.message,
+      updatedAt: new Date().toISOString(),
+    });
+  });
+}
+
+function buildRepair(input: {
+  sourceUrls: string[];
+  repairedSceneIds: string[];
+  beforeScenesSha256: string;
+  afterScenesSha256: string;
+}): MiraFormalCitationRecoveryRepair {
+  const withoutHash = {
+    policyVersion: MIRA_FORMAL_CITATION_REPAIR_POLICY_VERSION,
+    sourceUrls: [...input.sourceUrls],
+    repairedSceneIds: [...input.repairedSceneIds],
+    beforeScenesSha256: input.beforeScenesSha256,
+    afterScenesSha256: input.afterScenesSha256,
+  };
+  if (
+    withoutHash.sourceUrls.length === 0 ||
+    withoutHash.repairedSceneIds.length === 0 ||
+    withoutHash.beforeScenesSha256 === withoutHash.afterScenesSha256 ||
+    !validSha256(withoutHash.beforeScenesSha256) ||
+    !validSha256(withoutHash.afterScenesSha256)
+  ) {
+    throw new Error('FORMAL_CITATION_RECOVERY_REPAIR_INVALID');
+  }
+  return { ...withoutHash, repairSha256: canonicalSha256(withoutHash) };
+}
+
+function buildResult(
+  completion: Awaited<
+    ReturnType<typeof recoverMiraFormalProfessionalClassroomFromSucceededSession>
+  >,
+): MiraFormalCitationRecoveryResult {
+  const result = completion.result;
+  if (
+    !result.formalAudio ||
+    !result.professionalCreation ||
+    !result.research ||
+    !result.speechActionCount
+  ) {
+    throw new Error('FORMAL_CITATION_RECOVERY_RESULT_INVALID');
+  }
+  return {
+    classroomId: result.id,
+    url: result.url,
+    scenesCount: result.scenesCount,
+    speechActionCount: result.speechActionCount,
+    formalAudio: result.formalAudio,
+    professionalCreation: result.professionalCreation,
+    research: result.research,
+    createdAt: result.createdAt,
+  };
+}
+
+function assertRepairResultBinding(
+  completion: Awaited<ReturnType<typeof recoverMiraFormalProfessionalClassroomFromSucceededSession>>,
+  repair: MiraFormalCitationRecoveryRepair,
+  result: MiraFormalCitationRecoveryResult,
+): void {
+  if (
+    completion.repair.sessionId !== result.professionalCreation.sessionId ||
+    completion.repair.sessionId !== result.research.sessionId ||
+    completion.repair.stageId !== result.classroomId
+  ) {
+    throw new Error('FORMAL_CITATION_RECOVERY_IDENTITY_BINDING_INVALID');
+  }
+  const sourceUrls = new Set(repair.sourceUrls);
+  const researchSourceUrls = new Set(result.research.sources.map((source) => source.url));
+  const citedUrls = new Set<string>();
+  const citedSceneIds = new Set<string>();
+  for (const citation of result.research.citations) {
+    if (!sourceUrls.has(citation.url)) continue;
+    citedUrls.add(citation.url);
+    citation.sceneIds.forEach((sceneId) => citedSceneIds.add(sceneId));
+  }
+  if (
+    [...sourceUrls].some((url) => !researchSourceUrls.has(url) || !citedUrls.has(url)) ||
+    repair.repairedSceneIds.some((sceneId) => !citedSceneIds.has(sceneId))
+  ) {
+    throw new Error('FORMAL_CITATION_RECOVERY_RESEARCH_BINDING_INVALID');
+  }
+}
+
+async function promoteAndFinalize(record: MiraFormalCitationRecoveryRecord): Promise<void> {
+  const candidate = record.pendingTerminalSuccess;
+  if (!candidate) throw new Error('FORMAL_CITATION_RECOVERY_TERMINAL_CANDIDATE_MISSING');
+  await promoteFailedFormalClassroomGenerationJobFromCitationRecovery({
+    jobId: record.source.jobId,
+    expected: {
+      error: record.source.error,
+      formalInputSha256: record.source.formalInputSha256,
+      completedAt: record.source.completedAt,
+      jobSnapshotSha256: record.source.jobSnapshotSha256,
+    },
+    recovery: {
+      recoveryId: record.recoveryId,
+      receiptSha256: candidate.receiptSha256,
+    },
+    result: {
+      classroomId: candidate.result.classroomId,
+      url: candidate.result.url,
+      scenesCount: candidate.result.scenesCount,
+      speechActionCount: candidate.result.speechActionCount,
+      formalAudio: candidate.result.formalAudio,
+      professionalCreation: candidate.result.professionalCreation,
+      research: candidate.result.research,
+    },
+  });
+  await withRecoveryLock(record.source.jobId, async () => {
+    const current = await readExisting(record.source.jobId);
+    if (!current) throw new Error('FORMAL_CITATION_RECOVERY_RECORD_MISSING');
+    if (current.status === 'succeeded') {
+      if (current.receiptSha256 !== candidate.receiptSha256) {
+        throw new Error('FORMAL_CITATION_RECOVERY_TERMINAL_CONFLICT');
+      }
+      return;
+    }
+    if (
+      current.recoveryId !== record.recoveryId ||
+      current.pendingTerminalSuccess?.receiptSha256 !== candidate.receiptSha256
+    ) {
+      throw new Error('FORMAL_CITATION_RECOVERY_TERMINAL_CONFLICT');
+    }
+    await writeRecord({
+      ...current,
+      status: 'succeeded',
+      step: 'completed',
+      progress: 100,
+      message: 'Existing OpenMAIC Pro classroom recovered and published with exact citations',
+      repair: candidate.repair,
+      result: candidate.result,
+      updatedAt: candidate.updatedAt,
+      completedAt: candidate.completedAt,
+      receiptSha256: candidate.receiptSha256,
+      pendingTerminalSuccess: undefined,
+    });
+  });
+}
+
+async function markFailed(sourceJobId: string): Promise<void> {
+  await withRecoveryLock(sourceJobId, async () => {
+    const current = await readExisting(sourceJobId);
+    if (!current || current.status === 'succeeded' || current.pendingTerminalSuccess) return;
+    const now = new Date().toISOString();
+    const failed = withTerminalReceipt({
+      ...current,
+      status: 'failed',
+      step: 'failed',
+      message: 'Formal citation recovery failed before source-job promotion',
+      repair: null,
+      result: null,
+      updatedAt: now,
+      completedAt: now,
+      error: {
+        code: 'formal_citation_recovery_failed',
+        message: 'The existing professional classroom could not be safely recovered',
+      },
+    });
+    await writeRecord(failed);
+  });
+}
+
+export async function runMiraFormalCitationRecovery(
+  sourceJobId: string,
+  baseUrl: string,
+): Promise<void> {
+  const claimed = await withRecoveryLock(sourceJobId, async () => {
+    const current = await readExisting(sourceJobId);
+    if (!current) {
+      throw new MiraFormalCitationRecoveryError(
+        'recovery_not_found',
+        'Formal citation recovery was not found',
+      );
+    }
+    if (current.status !== 'queued') return { record: current, claimed: false };
+    const now = new Date().toISOString();
+    const running: MiraFormalCitationRecoveryRecord = {
+      ...current,
+      status: 'running',
+      step: 'validating_existing_classroom',
+      progress: 5,
+      message: 'Validating the existing professional classroom and research evidence',
+      startedAt: now,
+      updatedAt: now,
+    };
+    await writeRecord(running);
+    return { record: running, claimed: true };
+  });
+  let record = claimed.record;
+  if (record.status === 'succeeded' || record.status === 'failed') return;
+  if (record.pendingTerminalSuccess) {
+    await promoteAndFinalize(record);
+    return;
+  }
+  if (!claimed.claimed) return;
+
+  try {
+    const rawJob = await fs.readFile(sourceJobPath(sourceJobId));
+    if (sha256(rawJob) !== record.source.jobSnapshotSha256) {
+      throw new Error('FORMAL_CITATION_RECOVERY_SOURCE_SNAPSHOT_CHANGED');
+    }
+    const sourceJob = JSON.parse(rawJob.toString('utf8')) as ClassroomGenerationJob;
+    if (!sourceJob.formalInput) throw new Error('FORMAL_CITATION_RECOVERY_INPUT_MISSING');
+    const completion = await recoverMiraFormalProfessionalClassroomFromSucceededSession(
+      sourceJob.formalInput,
+      {
+        baseUrl,
+        expectedSessionId: record.sessionId,
+        expectedStageId: record.stageId,
+        onProgress: async (progress) => {
+          await updateRunningProgress(sourceJobId, {
+            step: progress.step,
+            progress: progress.progress,
+            message: progress.message,
+          });
+        },
+      },
+    );
+    const repair = buildRepair(completion.repair);
+    const result = buildResult(completion);
+    assertRepairResultBinding(completion, repair, result);
+    const terminalAt = new Date().toISOString();
+    const hypothetical = withTerminalReceipt({
+      ...record,
+      status: 'succeeded',
+      step: 'completed',
+      progress: 100,
+      message: 'Existing OpenMAIC Pro classroom recovered and published with exact citations',
+      repair,
+      result,
+      updatedAt: terminalAt,
+      completedAt: terminalAt,
+      pendingTerminalSuccess: undefined,
+    });
+    const receiptSha256 = hypothetical.receiptSha256!;
+    record = await withRecoveryLock(sourceJobId, async () => {
+      const current = await readExisting(sourceJobId);
+      if (!current || current.status !== 'running' || current.recoveryId !== record.recoveryId) {
+        throw new Error('FORMAL_CITATION_RECOVERY_STATE_CHANGED');
+      }
+      const publishing: MiraFormalCitationRecoveryRecord = {
+        ...current,
+        step: 'publishing',
+        progress: 99,
+        message: 'Promoting the recovered classroom without a new provider attempt',
+        updatedAt: terminalAt,
+        pendingTerminalSuccess: {
+          completedAt: terminalAt,
+          updatedAt: terminalAt,
+          repair,
+          result,
+          receiptSha256,
+        },
+      };
+      await writeRecord(publishing);
+      return publishing;
+    });
+    await promoteAndFinalize(record);
+  } catch (error) {
+    const current = await readExisting(sourceJobId);
+    if (current?.pendingTerminalSuccess) {
+      log.error('Formal citation recovery promotion/finalization remains replayable:', error);
+      return;
+    }
+    log.error('Formal citation recovery failed:', error);
+    await markFailed(sourceJobId);
+  }
+}
+
+export async function readMiraFormalCitationRecovery(
+  sourceJobId: string,
+): Promise<MiraFormalCitationRecoveryRecord | null> {
+  return readExisting(sourceJobId);
+}
