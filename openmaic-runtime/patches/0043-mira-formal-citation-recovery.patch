diff --git a/lib/server/mira-internal-loopback-auth.ts b/lib/server/mira-internal-loopback-auth.ts
new file mode 100644
index 0000000000000000000000000000000000000000..528883a2ad52973e0355af879786eceb3cd1999a
--- /dev/null
+++ b/lib/server/mira-internal-loopback-auth.ts
@@ -0,0 +1,92 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+
+import type { NextRequest } from 'next/server';
+
+const LOOPBACK_HOSTNAMES = new Set(['localhost', '127.0.0.1', '::1']);
+
+export class MiraInternalLoopbackAuthError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'MiraInternalLoopbackAuthError';
+  }
+}
+
+function secureEqual(left: string, right: string): boolean {
+  const leftDigest = createHash('sha256').update(left).digest();
+  const rightDigest = createHash('sha256').update(right).digest();
+  return timingSafeEqual(leftDigest, rightDigest);
+}
+
+function normalizedLoopbackHostname(value: string): string | null {
+  const hostname = value.replace(/^\[|\]$/gu, '').toLowerCase();
+  return LOOPBACK_HOSTNAMES.has(hostname) ? 'loopback' : null;
+}
+
+function singleHeader(req: NextRequest, name: string): string | null {
+  const value = req.headers.get(name);
+  if (
+    value === null ||
+    value.length === 0 ||
+    value !== value.trim() ||
+    value.includes(',') ||
+    /[%\s]/u.test(value)
+  ) {
+    return null;
+  }
+  return value;
+}
+
+function expectedPrivatePort(): string {
+  const value = process.env.MIRA_OPENMAIC_PRIVATE_PORT || '3100';
+  if (!/^[1-9][0-9]{0,4}$/u.test(value) || Number(value) > 65_535) {
+    throw new MiraInternalLoopbackAuthError('The OpenMAIC private port is invalid');
+  }
+  return value;
+}
+
+function isExactLoopbackAuthority(value: string | null, expectedPort: string): boolean {
+  if (!value) return false;
+  try {
+    const parsed = new URL(`http://${value}`);
+    return Boolean(
+      !parsed.username &&
+      !parsed.password &&
+      parsed.pathname === '/' &&
+      !parsed.search &&
+      !parsed.hash &&
+      parsed.port === expectedPort &&
+      normalizedLoopbackHostname(parsed.hostname),
+    );
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Accept only the exact header topology that Next emits for a direct request
+ * to the private loopback listener. A public/LAN authority, proxy chain, RFC
+ * Forwarded header, or a missing server-managed token is rejected.
+ */
+export function authorizeMiraInternalLoopbackRequest(req: NextRequest): void {
+  const expectedPort = expectedPrivatePort();
+  if (
+    req.headers.has('forwarded') ||
+    req.headers.has('x-real-ip') ||
+    req.headers.has('via') ||
+    req.nextUrl.protocol !== 'http:' ||
+    req.nextUrl.port !== expectedPort ||
+    !normalizedLoopbackHostname(req.nextUrl.hostname) ||
+    !isExactLoopbackAuthority(singleHeader(req, 'host'), expectedPort) ||
+    !isExactLoopbackAuthority(singleHeader(req, 'x-forwarded-host'), expectedPort) ||
+    !normalizedLoopbackHostname(singleHeader(req, 'x-forwarded-for') || '') ||
+    singleHeader(req, 'x-forwarded-proto') !== 'http' ||
+    singleHeader(req, 'x-forwarded-port') !== expectedPort
+  ) {
+    throw new MiraInternalLoopbackAuthError('Internal OpenMAIC access requires direct loopback');
+  }
+  const expectedToken = process.env.MIRA_INTERNAL_API_TOKEN || '';
+  const suppliedToken = req.headers.get('x-mira-internal-token') || '';
+  if (!expectedToken || !suppliedToken || !secureEqual(expectedToken, suppliedToken)) {
+    throw new MiraInternalLoopbackAuthError('Invalid internal OpenMAIC credentials');
+  }
+}
