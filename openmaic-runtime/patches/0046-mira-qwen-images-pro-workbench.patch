--- /dev/null
+++ b/lib/persistence/mira-document-scope.ts
@@ -0,0 +1,32 @@
+/** Internal request marker; middleware overwrites caller-supplied values. */
+export const MIRA_DOCUMENT_SCOPE_HEADER = 'x-mira-document-scope';
+
+export function miraDocumentRequestScope(input: {
+  pathname: string;
+  search: string;
+  runtimeSession: string | null;
+}): 'student' | 'operator' {
+  // The student gateway supplies its verified runtime session on every request.
+  // A direct student preview also stays on the browser store. Query parameters
+  // can only narrow this choice; they never grant document mutation authority.
+  return input.runtimeSession ||
+    (input.pathname.startsWith('/classroom/') && new URLSearchParams(input.search).has('mira'))
+    ? 'student'
+    : 'operator';
+}
+
+export function miraDocumentStorageMode(input: {
+  scope: string | null;
+  workbenchEnabled: boolean;
+  documentsEnabled: boolean;
+  runtimeConfigured: boolean;
+  persistenceConfigured: boolean;
+}): 'server' | 'browser' {
+  return input.scope === 'operator' &&
+    input.workbenchEnabled &&
+    input.documentsEnabled &&
+    input.runtimeConfigured &&
+    input.persistenceConfigured
+    ? 'server'
+    : 'browser';
+}
