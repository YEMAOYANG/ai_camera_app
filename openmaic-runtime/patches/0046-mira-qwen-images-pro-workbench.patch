@@ -0,0 +1,61 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+import { middleware } from '@/middleware';
+import {
+  miraDocumentRequestScope,
+  miraDocumentStorageMode,
+} from '@/lib/persistence/mira-document-scope';
+
+describe('Mira authoring document scope', () => {
+  it.each([
+    ['/workspace', '', null, 'operator'],
+    ['/classroom/new-course', '', null, 'operator'],
+    ['/classroom/lesson', '?mira=1', null, 'student'],
+    ['/classroom/lesson', '?mira=1&mira=0', null, 'student'],
+    ['/classroom/lesson', '', 'verified-runtime-session', 'student'],
+    ['/workspace', '', 'verified-runtime-session', 'student'],
+  ])('selects %s%s with runtime %s as %s', (pathname, search, runtimeSession, expected) => {
+    expect(miraDocumentRequestScope({ pathname, search, runtimeSession })).toBe(expected);
+  });
+
+  const ready = {
+    scope: 'operator',
+    workbenchEnabled: true,
+    documentsEnabled: true,
+    runtimeConfigured: true,
+    persistenceConfigured: true,
+  };
+
+  it('allows only an explicitly configured operator document store', () => {
+    expect(miraDocumentStorageMode(ready)).toBe('server');
+    for (const scope of ['student', null, '']) {
+      expect(miraDocumentStorageMode({ ...ready, scope })).toBe('browser');
+    }
+    for (const field of [
+      'workbenchEnabled',
+      'documentsEnabled',
+      'runtimeConfigured',
+      'persistenceConfigured',
+    ]) {
+      expect(miraDocumentStorageMode({ ...ready, [field]: false })).toBe('browser');
+    }
+  });
+});
+
+describe('Mira server request scope propagation', () => {
+  afterEach(() => vi.unstubAllEnvs());
+
+  it.each([
+    ['/workspace', {}, 'operator'],
+    ['/classroom/lesson?mira=1', { 'x-mira-document-scope': 'operator' }, 'student'],
+    [
+      '/classroom/lesson',
+      { 'x-mira-runtime-session': 'verified-runtime-session', 'x-mira-document-scope': 'operator' },
+      'student',
+    ],
+  ])('marks %s from the request before server rendering', async (path, headers, expected) => {
+    vi.stubEnv('ACCESS_CODE', '');
+    const response = await middleware(new NextRequest(`http://localhost${path}`, { headers }));
+    expect(response.headers.get('x-middleware-request-x-mira-document-scope')).toBe(expected);
+  });
+});
