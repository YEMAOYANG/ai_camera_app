index 0000000..22d277c
--- /dev/null
+++ b/tests/server/mira-formal-media.test.ts
@@ -0,0 +1,331 @@
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import sharp from 'sharp';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Scene } from '@/lib/types/stage';
+import type { AgentTool } from '@earendil-works/pi-agent-core';
+
+const provider = vi.hoisted(() => ({
+  configured: { 'qwen-image': { models: ['qwen-image-max'] } } as Record<
+    string,
+    { models?: string[]; disabled?: boolean }
+  >,
+  disabled: false,
+  model: 'qwen-image-max',
+  key: 'test-key',
+  base: 'https://dashscope.aliyuncs.com',
+}));
+vi.mock('@/lib/server/provider-config', () => ({
+  getServerImageProviders: () => provider.configured,
+  isServerProviderDisabled: () => provider.disabled,
+  resolveImageApiKey: () => provider.key,
+  resolveImageModel: () => provider.model,
+  resolveImageBaseUrl: () => provider.base,
+}));
+
+import {
+  assertMiraFormalGenerationInput,
+  isExactMiraProfessionalCreationPolicy,
+  MIRA_COURSEWARE_AUTHORITY,
+  MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT,
+  MIRA_PROFESSIONAL_CREATION_POLICY,
+  MIRA_LEGACY_PROFESSIONAL_CREATION_POLICY,
+} from '@/lib/server/mira-formal-generation-policy';
+import {
+  assertMiraFormalImageProviderReady,
+  buildMiraFormalMediaReceipt,
+  formalSceneImageReferences,
+  withMiraFormalImageTrace,
+  type MiraFormalImageTrace,
+} from '@/lib/server/mira-formal-media';
+import {
+  filterMiraFormalMediaTools,
+  MIRA_FORMAL_IMAGE_SESSION_ORIGIN,
+} from '@/lib/server/mira-professional-research-policy';
+
+const session = {
+  ownerId: `mira-formal-professional:${'a'.repeat(64)}`,
+  sessionId: `miraformal_${'a'.repeat(64)}`,
+  skillId: 'mira-primary-courseware',
+  origin: 'mira-formal-professional',
+};
+const identity = {
+  runtimeRequestId: 'request-image-1',
+  buildItemId: 'build-image-1',
+  classroomId: 'stage-image-1',
+  sessionId: session.sessionId,
+};
+
+function slide(src?: string, id = 'scene-1'): Scene {
+  return {
+    id,
+    stageId: identity.classroomId,
+    type: 'slide',
+    order: 0,
+    content: {
+      type: 'slide',
+      canvas: { elements: src ? [{ id: 'picture', type: 'image', src }] : [] },
+    },
+    actions: [],
+  } as unknown as Scene;
+}
+function trace(src: string): MiraFormalImageTrace {
+  return {
+    schemaVersion: 'mira.openmaic.formal-image-trace.v1',
+    sessionId: identity.sessionId,
+    classroomId: identity.classroomId,
+    toolCallId: 'image-call-1',
+    src,
+    providerId: 'qwen-image',
+    modelId: 'qwen-image-max',
+  };
+}
+
+describe('formal image policy and assets', () => {
+  let root: string;
+  beforeEach(async () => {
+    root = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), 'mira-image-')));
+    provider.configured = { 'qwen-image': { models: ['qwen-image-max'] } };
+    provider.disabled = false;
+    provider.model = 'qwen-image-max';
+    provider.key = 'test-key';
+    provider.base = 'https://dashscope.aliyuncs.com';
+    vi.stubEnv('DEFAULT_IMAGE_PROVIDER', 'qwen-image');
+  });
+  afterEach(async () => {
+    await fs.rm(root, { recursive: true, force: true });
+    vi.unstubAllEnvs();
+  });
+
+  async function image(bytes?: Buffer) {
+    bytes ??= await sharp({ create: { width: 8, height: 6, channels: 3, background: '#12ab34' } })
+      .png()
+      .toBuffer();
+    const sha = createHash('sha256').update(bytes).digest('hex');
+    const filename = `generated-${sha}.png`;
+    const directory = path.join(root, identity.classroomId, 'media');
+    await fs.mkdir(directory, { recursive: true });
+    const file = path.join(directory, filename);
+    await fs.writeFile(file, bytes);
+    return {
+      file,
+      bytes,
+      sha,
+      src: `/api/classroom-media/${identity.classroomId}/media/${filename}`,
+    };
+  }
+  const receipt = (scenes: Scene[], traces: unknown[]) =>
+    buildMiraFormalMediaReceipt({ ...identity, scenes, traces }, { classroomsDir: root });
+
+  it('accepts only the exact legacy/false and image-policy/true pairs', () => {
+    const input = {
+      requirement: 'locked brief',
+      runtimeRequestId: identity.runtimeRequestId,
+      formalRuntimeContract: MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT,
+      coursewareAuthority: MIRA_COURSEWARE_AUTHORITY,
+      enableWebSearch: true,
+      enableVideoGeneration: false,
+      enableTTS: false,
+      agentMode: 'generate' as const,
+    };
+    for (const [policy, enabled] of [
+      [MIRA_LEGACY_PROFESSIONAL_CREATION_POLICY, false],
+      [MIRA_PROFESSIONAL_CREATION_POLICY, true],
+    ] as const) {
+      expect(() =>
+        assertMiraFormalGenerationInput({
+          ...input,
+          professionalCreationPolicy: policy,
+          enableImageGeneration: enabled,
+        }),
+      ).not.toThrow();
+      expect(() =>
+        assertMiraFormalGenerationInput({
+          ...input,
+          professionalCreationPolicy: policy,
+          enableImageGeneration: !enabled,
+        }),
+      ).toThrow('FORMAL_RUNTIME_INPUT_POLICY_INVALID');
+    }
+    expect(
+      isExactMiraProfessionalCreationPolicy({
+        ...MIRA_PROFESSIONAL_CREATION_POLICY,
+        image: { ...MIRA_PROFESSIONAL_CREATION_POLICY.image, modelId: 'other-model' },
+      }),
+    ).toBe(false);
+  });
+
+  it('keeps legacy formal tools closed when global media providers become available', () => {
+    const tools = ['generate_image', 'generate_video', 'generate_scene'].map((name) => ({ name }));
+    expect(filterMiraFormalMediaTools(tools, session).map((t) => t.name)).toEqual([
+      'generate_scene',
+    ]);
+    expect(
+      filterMiraFormalMediaTools(tools, {
+        ...session,
+        origin: MIRA_FORMAL_IMAGE_SESSION_ORIGIN,
+      }).map((t) => t.name),
+    ).toEqual(['generate_image', 'generate_scene']);
+    expect(
+      filterMiraFormalMediaTools(tools, { ...session, sessionId: 'ordinary-session' }),
+    ).toEqual(tools);
+  });
+
+  it.each(['disabled', 'key', 'model', 'base', 'default'] as const)(
+    'rejects invalid provider %s without a provider call',
+    (condition) => {
+      if (condition === 'disabled') provider.disabled = true;
+      if (condition === 'key') provider.key = '';
+      if (condition === 'model') provider.model = 'other-model';
+      if (condition === 'base') provider.base = 'https://other.example';
+      if (condition === 'default') vi.stubEnv('DEFAULT_IMAGE_PROVIDER', 'other-provider');
+      expect(() => assertMiraFormalImageProviderReady()).toThrow('FORMAL_IMAGE_PROVIDER_');
+    },
+  );
+
+  it('allows a deliberate course with no images and produces a hashed zero receipt', async () => {
+    const result = await receipt([slide()], []);
+    expect(result).toMatchObject({
+      ...identity,
+      imageCount: 0,
+      assets: [],
+      status: 'succeeded',
+      policyId: 'mira-formal-qwen-image.v1',
+    });
+    expect(result.receiptSha256).toMatch(/^[a-f0-9]{64}$/);
+  });
+
+  it('attests the bytes, dimensions, stage and actual scene references', async () => {
+    const asset = await image();
+    const result = await receipt(
+      [slide(asset.src), slide(asset.src, 'scene-2')],
+      [trace(asset.src)],
+    );
+    expect(result.imageCount).toBe(1);
+    expect(result.assets[0]).toEqual({
+      src: asset.src,
+      sha256: asset.sha,
+      mimeType: 'image/png',
+      byteSize: asset.bytes.length,
+      width: 8,
+      height: 6,
+      sceneIds: ['scene-1', 'scene-2'],
+    });
+    expect(
+      await receipt([slide(asset.src), slide(asset.src, 'scene-2')], [trace(asset.src)]),
+    ).toEqual(result);
+  });
+
+  it('enumerates real interactive HTML image and CSS background slots', () => {
+    const scene = {
+      ...slide(),
+      type: 'interactive',
+      content: {
+        type: 'interactive',
+        html: '<html><body><img src="/a.png"><div style="background-image:url(\'/b.png\')"></div></body></html>',
+      },
+    } as unknown as Scene;
+    expect(formalSceneImageReferences(scene)).toEqual(['/a.png', '/b.png']);
+  });
+
+  it('parses fragments, srcset, SVG namespaces and styles without executing markup', () => {
+    const scene = {
+      ...slide(),
+      type: 'interactive',
+      content: {
+        type: 'interactive',
+        html: `<style>.hero { background: url('/style.png') } .mask { filter: url(#mask) }</style>
+          <picture><source srcset="/small.png 400w, /large.png 800w">
+            <img src="/main.png" srcset="/retina.png 2x" style="background:url('/inline.png')">
+          </picture>
+          <svg><image href="/svg.png"/><image xlink:href="/legacy.png"/></svg>
+          <template><img src="/template.png"></template>
+          <script>const fake = '<img src="/not-an-image.png">';</script>`,
+      },
+    } as unknown as Scene;
+    expect(formalSceneImageReferences(scene)).toEqual([
+      '/small.png',
+      '/large.png',
+      '/main.png',
+      '/retina.png',
+      '/svg.png',
+      '/legacy.png',
+      '/template.png',
+      '/style.png',
+      '/inline.png',
+    ]);
+  });
+
+  it('retains decoded and data image references so ownership validation can reject them', () => {
+    const scene = {
+      ...slide(),
+      type: 'interactive',
+      content: {
+        type: 'interactive',
+        html: '<img src="/image.png?a=1&amp;b=2"><img srcset="data:image/png;base64,AAAA 1x, /large.png 2x">',
+      },
+    } as unknown as Scene;
+    expect(formalSceneImageReferences(scene)).toEqual([
+      '/image.png?a=1&b=2',
+      'data:image/png;base64,AAAA',
+      '/large.png',
+    ]);
+  });
+
+  it('rejects generated bytes omitted from the final scenes', async () => {
+    const asset = await image();
+    await expect(receipt([slide()], [trace(asset.src)])).rejects.toThrow(
+      'GENERATED_ASSET_UNREFERENCED',
+    );
+  });
+  it('rejects an image with no same-session generation trace', async () => {
+    const asset = await image();
+    await expect(receipt([slide(asset.src)], [])).rejects.toThrow('SOURCE_UNATTESTED');
+  });
+  it('rejects an image or trace from another stage', async () => {
+    const src = '/api/classroom-media/foreign/media/generated-a.png';
+    await expect(receipt([slide(src)], [trace(src)])).rejects.toThrow('SOURCE_NOT_OWNED');
+    const asset = await image();
+    await expect(
+      receipt([slide(asset.src)], [{ ...trace(asset.src), classroomId: 'foreign' }]),
+    ).rejects.toThrow('TRACE_INVALID');
+  });
+  it('rejects deleted, corrupt, or non-image bytes', async () => {
+    const asset = await image();
+    await fs.writeFile(asset.file, 'changed');
+    await expect(receipt([slide(asset.src)], [trace(asset.src)])).rejects.toThrow('HASH_MISMATCH');
+    await fs.rm(asset.file);
+    await expect(receipt([slide(asset.src)], [trace(asset.src)])).rejects.toThrow('FILE_MISSING');
+    const fake = await image(Buffer.from('not a PNG'));
+    await expect(receipt([slide(fake.src)], [trace(fake.src)])).rejects.toThrow('BYTES_INVALID');
+  });
+  it('rejects symlinked media outside the stage', async () => {
+    const asset = await image();
+    const other = path.join(root, 'outside.png');
+    await fs.rename(asset.file, other);
+    await fs.symlink(other, asset.file);
+    await expect(receipt([slide(asset.src)], [trace(asset.src)])).rejects.toThrow(
+      'SOURCE_NOT_OWNED',
+    );
+  });
+
+  it('awaits the durable image trace before returning a successful tool result', async () => {
+    const asset = await image();
+    const record = vi.fn().mockResolvedValue(undefined);
+    const execute = vi.fn().mockResolvedValue({ details: { src: asset.src }, content: [] });
+    const tool = withMiraFormalImageTrace(
+      { name: 'generate_image', execute } as unknown as AgentTool<never, never>,
+      identity.sessionId,
+      record,
+    );
+    await tool.execute('image-call-1', { stageId: identity.classroomId } as never, undefined);
+    expect(execute).toHaveBeenCalledTimes(1);
+    expect(record).toHaveBeenCalledWith(trace(asset.src));
+    record.mockRejectedValueOnce(new Error('durable store failed'));
+    await expect(
+      tool.execute('image-call-1', { stageId: identity.classroomId } as never, undefined),
+    ).rejects.toThrow('durable store failed');
+  });
+});
