diff --git a/lib/server/mira-formal-media.ts b/lib/server/mira-formal-media.ts
new file mode 100644
index 0000000..525dad8
--- /dev/null
+++ b/lib/server/mira-formal-media.ts
@@ -0,0 +1,281 @@
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import sharp from 'sharp';
+import { parse, type DefaultTreeAdapterTypes } from 'parse5';
+import parseSrcset from 'parse-srcset';
+import { enumerateAssetManifest } from '@openmaic/dsl';
+import type { AgentTool } from '@earendil-works/pi-agent-core';
+import type { Scene } from '@/lib/types/stage';
+import { CLASSROOMS_DIR } from '@/lib/server/classroom-storage';
+import { MAX_REMOTE_IMAGE_BYTES } from '@/lib/server/bounded-download';
+import { MIRA_FORMAL_IMAGE_POLICY } from '@/lib/server/mira-formal-generation-policy';
+import {
+  getServerImageProviders,
+  isServerProviderDisabled,
+  resolveImageApiKey,
+  resolveImageBaseUrl,
+  resolveImageModel,
+} from '@/lib/server/provider-config';
+
+export const MIRA_FORMAL_IMAGE_EVENT = 'mira_formal_image_generated';
+
+export interface MiraFormalImageTrace {
+  schemaVersion: 'mira.openmaic.formal-image-trace.v1';
+  sessionId: string;
+  classroomId: string;
+  toolCallId: string;
+  src: string;
+  providerId: 'qwen-image';
+  modelId: 'qwen-image-max';
+}
+
+export interface MiraFormalMediaAsset {
+  src: string;
+  sha256: string;
+  mimeType: string;
+  byteSize: number;
+  width: number;
+  height: number;
+  sceneIds: string[];
+}
+
+export interface MiraFormalMediaReceipt {
+  schemaVersion: 'mira.openmaic.formal-media-receipt.v1';
+  status: 'succeeded';
+  runtimeRequestId: string;
+  buildItemId: string;
+  classroomId: string;
+  sessionId: string;
+  policyId: typeof MIRA_FORMAL_IMAGE_POLICY.policyId;
+  providerId: typeof MIRA_FORMAL_IMAGE_POLICY.providerId;
+  modelId: typeof MIRA_FORMAL_IMAGE_POLICY.modelId;
+  imageCount: number;
+  assets: MiraFormalMediaAsset[];
+  receiptSha256: string;
+}
+
+/** Configuration-only check: never invokes a paid provider from health or resume. */
+export function assertMiraFormalImageProviderReady(): void {
+  const policy = MIRA_FORMAL_IMAGE_POLICY;
+  const configured = getServerImageProviders()[policy.providerId];
+  if (
+    !configured ||
+    configured.disabled ||
+    isServerProviderDisabled('image', policy.providerId) ||
+    process.env.DEFAULT_IMAGE_PROVIDER !== policy.providerId ||
+    resolveImageModel(policy.providerId) !== policy.modelId ||
+    !resolveImageApiKey(policy.providerId).trim()
+  ) {
+    throw new Error('FORMAL_IMAGE_PROVIDER_NOT_READY');
+  }
+  const base = resolveImageBaseUrl(policy.providerId);
+  if (base !== 'https://dashscope.aliyuncs.com' && base !== 'https://dashscope.aliyuncs.com/') {
+    throw new Error('FORMAL_IMAGE_PROVIDER_ORIGIN_INVALID');
+  }
+}
+
+/** Keep a durable, same-session source for generated bytes before the model uses them. */
+export function withMiraFormalImageTrace(
+  tool: AgentTool<never, never>,
+  sessionId: string,
+  record: (trace: MiraFormalImageTrace) => Promise<void>,
+): AgentTool<never, never> {
+  if (tool.name !== 'generate_image') return tool;
+  return {
+    ...tool,
+    async execute(...args: Parameters<typeof tool.execute>) {
+      assertMiraFormalImageProviderReady();
+      const result = await tool.execute(...args);
+      const value = result as unknown as { isError?: boolean; details?: { src?: unknown } };
+      if (!value.isError) {
+        const params = args[1] as unknown as { stageId?: unknown };
+        const src = value.details?.src;
+        if (typeof src !== 'string' || typeof params.stageId !== 'string') {
+          throw new Error('FORMAL_IMAGE_TOOL_RESULT_INVALID');
+        }
+        await record({
+          schemaVersion: 'mira.openmaic.formal-image-trace.v1',
+          sessionId,
+          classroomId: params.stageId,
+          toolCallId: args[0],
+          src,
+          providerId: MIRA_FORMAL_IMAGE_POLICY.providerId,
+          modelId: MIRA_FORMAL_IMAGE_POLICY.modelId,
+        });
+      }
+      return result;
+    },
+  };
+}
+
+/** Official slide/background/whiteboard enumeration plus actual HTML image slots. */
+export function formalSceneImageReferences(scene: Scene): string[] {
+  const refs = new Set(
+    enumerateAssetManifest({ stage: {}, scenes: [scene] })
+      .entries.filter((entry) => ['image', 'background', 'poster'].includes(entry.kind))
+      .map((entry) => entry.ref),
+  );
+  const content = scene.content as unknown as { html?: unknown };
+  if (typeof content.html === 'string') {
+    // Parse markup without constructing a browser DOM: DOM emulators can pull
+    // native canvas into the production server bundle even for attribute reads.
+    const document = parse(content.html);
+    const styles: string[] = [];
+    const inlineStyles: string[] = [];
+    const visit = (node: DefaultTreeAdapterTypes.Node): void => {
+      if ('tagName' in node) {
+        const attrs = Object.fromEntries(
+          node.attrs.map((attr) => [
+            attr.prefix ? `${attr.prefix}:${attr.name}` : attr.name,
+            attr.value,
+          ]),
+        );
+        if (node.tagName === 'img' || node.tagName === 'image') {
+          const src = attrs.src || attrs.href || attrs['xlink:href'];
+          if (src) refs.add(src);
+        }
+        if ((node.tagName === 'img' || node.tagName === 'source') && attrs.srcset) {
+          for (const candidate of parseSrcset(attrs.srcset)) refs.add(candidate.url);
+        }
+        if (node.tagName === 'style') {
+          styles.push(
+            node.childNodes.map((child) => ('value' in child ? child.value : '')).join(''),
+          );
+        }
+        if (attrs.style) inlineStyles.push(attrs.style);
+        if (node.tagName === 'template' && 'content' in node) visit(node.content);
+      }
+      if ('childNodes' in node) {
+        for (const child of node.childNodes) visit(child);
+      }
+    };
+    visit(document);
+    for (const css of [...styles, ...inlineStyles]) {
+      for (const match of css.matchAll(/url\(\s*['"]?([^'"\s)]+)['"]?\s*\)/giu)) {
+        if (!match[1]!.startsWith('#')) refs.add(match[1]!);
+      }
+    }
+  }
+  return [...refs];
+}
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(
+      Object.entries(value)
+        .sort(([a], [b]) => a.localeCompare(b))
+        .map(([key, item]) => [key, canonical(item)]),
+    );
+  }
+  return value;
+}
+
+function fail(code: string): never {
+  throw new Error(`FORMAL_IMAGE_${code}`);
+}
+
+export async function buildMiraFormalMediaReceipt(
+  input: {
+    runtimeRequestId: string;
+    buildItemId: string;
+    classroomId: string;
+    sessionId: string;
+    scenes: Scene[];
+    traces: unknown[];
+  },
+  options: { classroomsDir?: string } = {},
+): Promise<MiraFormalMediaReceipt> {
+  const refs = new Map<string, string[]>();
+  for (const scene of input.scenes) {
+    if (scene.stageId !== input.classroomId) fail('SCENE_STAGE_MISMATCH');
+    for (const src of formalSceneImageReferences(scene)) {
+      const ids = refs.get(src) ?? [];
+      if (!ids.includes(scene.id)) ids.push(scene.id);
+      refs.set(src, ids);
+    }
+  }
+  if (refs.size > 120 || input.traces.length > 240) fail('ASSET_LIMIT');
+  const traced = new Set<string>();
+  for (const raw of input.traces) {
+    const trace = raw as Partial<MiraFormalImageTrace> | null;
+    if (
+      !trace ||
+      trace.schemaVersion !== 'mira.openmaic.formal-image-trace.v1' ||
+      trace.sessionId !== input.sessionId ||
+      trace.classroomId !== input.classroomId ||
+      trace.providerId !== MIRA_FORMAL_IMAGE_POLICY.providerId ||
+      trace.modelId !== MIRA_FORMAL_IMAGE_POLICY.modelId ||
+      typeof trace.toolCallId !== 'string' ||
+      !trace.toolCallId ||
+      typeof trace.src !== 'string'
+    )
+      fail('TRACE_INVALID');
+    if (!refs.has(trace.src)) fail('GENERATED_ASSET_UNREFERENCED');
+    traced.add(trace.src);
+  }
+  const assets: MiraFormalMediaAsset[] = [];
+  const root = path.resolve(options.classroomsDir ?? CLASSROOMS_DIR, input.classroomId, 'media');
+  for (const [src, sceneIds] of [...refs].sort(([a], [b]) => a.localeCompare(b))) {
+    const prefix = `/api/classroom-media/${input.classroomId}/media/`;
+    if (!src.startsWith(prefix)) fail('SOURCE_NOT_OWNED');
+    const filename = src.slice(prefix.length);
+    const match = /^generated-([a-f0-9]{64})\.(png|jpg|webp|gif)$/u.exec(filename);
+    if (!match || !traced.has(src)) fail('SOURCE_UNATTESTED');
+    const file = path.join(root, filename);
+    let bytes: Buffer;
+    try {
+      const real = await fs.realpath(file);
+      if (real !== file) fail('SOURCE_NOT_OWNED');
+      const stat = await fs.stat(real);
+      if (!stat.isFile() || stat.size < 1 || stat.size > MAX_REMOTE_IMAGE_BYTES)
+        fail('BYTES_INVALID');
+      bytes = await fs.readFile(real);
+    } catch (error) {
+      if (error instanceof Error && error.message.startsWith('FORMAL_IMAGE_')) throw error;
+      fail('FILE_MISSING');
+    }
+    const sha256 = createHash('sha256').update(bytes).digest('hex');
+    if (sha256 !== match[1]) fail('HASH_MISMATCH');
+    let metadata: Awaited<ReturnType<ReturnType<typeof sharp>['metadata']>>;
+    try {
+      metadata = await sharp(bytes, { limitInputPixels: 40_000_000 }).metadata();
+    } catch {
+      fail('BYTES_INVALID');
+    }
+    const mime = { png: 'image/png', jpeg: 'image/jpeg', webp: 'image/webp', gif: 'image/gif' };
+    const mimeType = mime[metadata.format as keyof typeof mime];
+    const expectedFormat = match[2] === 'jpg' ? 'jpeg' : match[2];
+    if (!mimeType || metadata.format !== expectedFormat || !metadata.width || !metadata.height)
+      fail('BYTES_INVALID');
+    assets.push({
+      src,
+      sha256,
+      mimeType,
+      byteSize: bytes.length,
+      width: metadata.width,
+      height: metadata.height,
+      sceneIds,
+    });
+  }
+  const withoutHash = {
+    schemaVersion: 'mira.openmaic.formal-media-receipt.v1' as const,
+    status: 'succeeded' as const,
+    runtimeRequestId: input.runtimeRequestId,
+    buildItemId: input.buildItemId,
+    classroomId: input.classroomId,
+    sessionId: input.sessionId,
+    policyId: MIRA_FORMAL_IMAGE_POLICY.policyId,
+    providerId: MIRA_FORMAL_IMAGE_POLICY.providerId,
+    modelId: MIRA_FORMAL_IMAGE_POLICY.modelId,
+    imageCount: assets.length,
+    assets,
+  };
+  return {
+    ...withoutHash,
+    receiptSha256: createHash('sha256')
+      .update(JSON.stringify(canonical(withoutHash)))
+      .digest('hex'),
+  };
+}
