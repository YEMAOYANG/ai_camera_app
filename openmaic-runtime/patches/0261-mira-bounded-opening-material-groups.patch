diff --git a/tests/agent-runtime/opening-material-groups.test.ts b/tests/agent-runtime/opening-material-groups.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/agent-runtime/opening-material-groups.test.ts
@@ -0,0 +1,66 @@
+import { describe, expect, it } from 'vitest';
+import {
+  assertGroupedOpeningMaterialBudget,
+  decodeOpeningMaterialIds,
+  MAX_OPENING_MATERIAL_BYTES,
+} from '@/lib/server/agent-runtime/opening-material-groups';
+
+describe('bounded opening material groups', () => {
+  it('accepts sixty-four unique materials over four finite groups', () => {
+    const ids = Array.from({ length: 64 }, (_, i) => `mat-${i}`);
+    const decoded = decodeOpeningMaterialIds({
+      materialIdGroups: [ids.slice(0, 20), ids.slice(20, 40), ids.slice(40, 60), ids.slice(60)],
+    });
+    expect(decoded).toEqual({ ids, grouped: true });
+    expect(
+      assertGroupedOpeningMaterialBudget(
+        ids,
+        ids.map((id) => ({ id, bytes: 1024 })),
+      ),
+    ).toBe(65536);
+  });
+  it('rejects sixty-five, empty, malformed or conflicting groups', () => {
+    const ids = Array.from({ length: 65 }, (_, i) => `mat-${i}`);
+    for (const body of [
+      { materialIdGroups: [ids.slice(0, 20), ids.slice(20, 40), ids.slice(40, 60), ids.slice(60)] },
+      { materialIdGroups: [] },
+      { materialIdGroups: [[]] },
+      { materialIdGroups: [[' ']] },
+      { materialIdGroups: [['ok', 1]] },
+      { materialIds: null },
+      { materialIds: [], materialIdGroups: [['one']] },
+    ]) {
+      expect(() => decodeOpeningMaterialIds(body)).toThrow();
+    }
+  });
+  it('bounds bytes and requires every material to belong to the ready owner query', () => {
+    expect(() => assertGroupedOpeningMaterialBudget(['one'], [])).toThrow('unavailable');
+    expect(() => assertGroupedOpeningMaterialBudget(['one'], [{ id: 'other', bytes: 1 }])).toThrow(
+      'unavailable',
+    );
+    expect(() => assertGroupedOpeningMaterialBudget(['one'], [{ id: 'one', bytes: NaN }])).toThrow(
+      'unavailable',
+    );
+    expect(() =>
+      assertGroupedOpeningMaterialBudget(
+        ['one'],
+        [{ id: 'one', bytes: MAX_OPENING_MATERIAL_BYTES + 1 }],
+      ),
+    ).toThrow('byte limit');
+    expect(
+      assertGroupedOpeningMaterialBudget(
+        ['one'],
+        [{ id: 'one', bytes: MAX_OPENING_MATERIAL_BYTES }],
+      ),
+    ).toBe(MAX_OPENING_MATERIAL_BYTES);
+  });
+  it('preserves legacy deduplication and its twenty-item cap', () => {
+    expect(decodeOpeningMaterialIds({ materialIds: ['one', ' one '] })).toEqual({
+      ids: ['one'],
+      grouped: false,
+    });
+    expect(() =>
+      decodeOpeningMaterialIds({ materialIds: Array.from({ length: 21 }, (_, i) => `mat-${i}`) }),
+    ).toThrow();
+  });
+});
