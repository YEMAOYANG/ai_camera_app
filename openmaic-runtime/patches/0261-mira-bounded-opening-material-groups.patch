new file mode 100644
--- /dev/null
+++ b/lib/server/agent-runtime/opening-material-groups.ts
@@ -0,0 +1,78 @@
+/** Bounded, atomic opening attachments; legacy materialIds stays capped at 20. */
+export const OPENING_MATERIAL_GROUPS_SCHEMA = 'mira.agent-opening-material-groups.v1';
+export const OPENING_MATERIAL_GROUPS_HEADER = 'x-mira-agent-material-groups';
+export const MAX_OPENING_MATERIALS = 64;
+export const MAX_OPENING_MATERIAL_BYTES = 128 * 1024 * 1024;
+
+export class OpeningMaterialGroupsError extends Error {
+  constructor(
+    readonly kind: 'invalid' | 'unavailable' | 'too_large',
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+export function decodeOpeningMaterialIds(body: {
+  materialIds?: unknown;
+  materialIdGroups?: unknown;
+}): {
+  ids: string[];
+  grouped: boolean;
+} {
+  const grouped = body.materialIdGroups !== undefined;
+  if (grouped && body.materialIds !== undefined) {
+    throw new OpeningMaterialGroupsError(
+      'invalid',
+      'materialIds and materialIdGroups are mutually exclusive',
+    );
+  }
+  if (!grouped && body.materialIds !== undefined && !Array.isArray(body.materialIds)) {
+    throw new OpeningMaterialGroupsError('invalid', 'materialIds are invalid');
+  }
+  const groups = grouped ? body.materialIdGroups : [body.materialIds ?? []];
+  if (
+    !Array.isArray(groups) ||
+    groups.length < 1 ||
+    groups.length > (grouped ? 4 : 1) ||
+    groups.some(
+      (group) =>
+        !Array.isArray(group) ||
+        (grouped && (group.length < 1 || group.length > 20)) ||
+        group.some((id) => typeof id !== 'string'),
+    )
+  ) {
+    throw new OpeningMaterialGroupsError('invalid', 'materialIdGroups/materialIds are invalid');
+  }
+  const ids = [...new Set((groups as string[][]).flat().map((id) => id.trim()))];
+  if (ids.some((id) => !id) || ids.length > (grouped ? MAX_OPENING_MATERIALS : 20)) {
+    throw new OpeningMaterialGroupsError('invalid', 'materialIdGroups/materialIds are invalid');
+  }
+  return { ids, grouped };
+}
+
+/** Records are read through the same owner's ready-material query, before a session exists. */
+export function assertGroupedOpeningMaterialBudget(
+  ids: readonly string[],
+  records: ReadonlyArray<{ id: string; bytes: number }>,
+): number {
+  const byId = new Map(records.map((record) => [record.id, record]));
+  if (byId.size !== ids.length || ids.some((id) => !byId.has(id))) {
+    throw new OpeningMaterialGroupsError('unavailable', 'one or more materials are unavailable');
+  }
+  let total = 0;
+  for (const id of ids) {
+    const bytes = byId.get(id)!.bytes;
+    if (!Number.isSafeInteger(bytes) || bytes <= 0) {
+      throw new OpeningMaterialGroupsError('unavailable', 'material size is unavailable');
+    }
+    total += bytes;
+    if (total > MAX_OPENING_MATERIAL_BYTES) {
+      throw new OpeningMaterialGroupsError(
+        'too_large',
+        'opening materials exceed the total byte limit',
+      );
+    }
+  }
+  return total;
+}
