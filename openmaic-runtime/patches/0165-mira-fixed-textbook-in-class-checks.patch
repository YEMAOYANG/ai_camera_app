+type Graded = { questionId: string; response: string; correct: boolean; explanation: string; correctAnswer: string };
+type Result = { score: number; maxScore: number; correctCount: number; totalQuestions: number; results: Graded[] };
+type Saved = { result?: Result | null; partial?: { results: Graded[] } | null };
+
+/** The questions of one in-class check that the server has already graded. */
+export function gradedOnThisPage(saved: Saved, questionIds: string[]): Graded[] {
+  const graded = (saved.result ?? saved.partial)?.results ?? [];
+  return questionIds.flatMap(id => graded.filter(item => item.questionId === id));
+}
 
