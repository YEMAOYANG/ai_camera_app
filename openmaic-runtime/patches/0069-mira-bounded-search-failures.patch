@@ -0,0 +1,55 @@
+/** Only bounded failure metadata may become an agent tool result. */
+export class WebSearchProviderError extends Error {
+  constructor(
+    readonly code:
+      | 'WEB_SEARCH_HTTP_ERROR'
+      | 'WEB_SEARCH_RATE_LIMITED'
+      | 'WEB_SEARCH_RATE_LIMIT_COOLDOWN',
+    readonly status: number,
+    readonly retryAfterMs: number,
+    readonly bodySummary: 'html_omitted' | 'json_omitted' | 'body_omitted' | 'cooldown',
+  ) {
+    super(
+      `${code} provider=brave status=${status} retry_after_ms=${Math.ceil(retryAfterMs)} body=${bodySummary}`,
+    );
+    this.name = 'WebSearchProviderError';
+  }
+}
+
+export async function braveResponseError(
+  response: Response,
+  retryAfterMs: number,
+): Promise<WebSearchProviderError> {
+  const type = response.headers.get('content-type') ?? '';
+  const summary = /html/i.test(type)
+    ? 'html_omitted'
+    : /json/i.test(type)
+      ? 'json_omitted'
+      : 'body_omitted';
+  // Never read an error page: even a short prefix can contain credentials or
+  // instructions. This categorical summary retains response evidence only.
+  await response.body?.cancel().catch(() => undefined);
+  return new WebSearchProviderError(
+    response.status === 429 ? 'WEB_SEARCH_RATE_LIMITED' : 'WEB_SEARCH_HTTP_ERROR',
+    response.status,
+    retryAfterMs,
+    summary,
+  );
+}
+
+export function sanitizedWebSearchToolError(error: unknown): Error {
+  if (error instanceof WebSearchProviderError) return error;
+  if (error instanceof Error && error.name === 'AbortError') return error;
+  const code = error && typeof error === 'object' && 'code' in error ? String(error.code) : '';
+  const message = error instanceof Error ? error.message : String(error);
+  // Preserve local budget/control codes while excluding untrusted messages,
+  // HTML, URLs, authorization headers and arbitrarily long provider bodies.
+  const localCode = /^[A-Z][A-Z0-9_]{1,95}$/.test(code)
+    ? code
+    : message.match(/^(MIRA_PAID_[A-Z0-9_]{1,80})(?=$|[:\s])/u)?.[1];
+  if (localCode) return new Error(localCode);
+  const status = message
+    .slice(0, 256)
+    .match(/(?:status[=: ]+|error\s*\(|HTTP\s+)([45]\d{2})/i)?.[1];
+  return new Error(`WEB_SEARCH_PROVIDER_FAILED${status ? ` status=${status}` : ''} detail=omitted`);
+}
