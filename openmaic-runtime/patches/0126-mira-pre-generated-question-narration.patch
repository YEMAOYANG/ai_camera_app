+import { describe, expect, it } from 'vitest';
+import { questionNarrationSource } from '@/components/audio/question-narration';
+
+describe('pre-generated quiz narration', () => {
+  it('accepts a saved same-origin classroom recording', () => {
+    const src = '/api/classroom-media/lesson_123/audio/question-1.wav';
+    expect(questionNarrationSource({ questionAudioUrl: src })).toBe(src);
+  });
+  it.each([
+    'https://untrusted.example/audio.wav',
+    '//untrusted.example/audio.wav',
+    '/api/generate/tts',
+    '/api/classroom-media/a/audio/../../private.wav',
+    '/api/classroom-media/a/audio/x.wav?token=anything',
+  ])('does not use dynamic or unrelated media: %s', value => {
+    expect(questionNarrationSource({ questionAudioUrl: value })).toBeNull();
+  });
+  it('leaves historical questions without narration unchanged', () => {
+    expect(questionNarrationSource({ question: '天' })).toBeNull();
+  });
+});
