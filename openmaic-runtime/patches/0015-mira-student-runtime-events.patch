@@ -0,0 +1,434 @@
+const EVENT_SCHEMA = 'mira.openmaic.student-runtime-event.v1' as const;
+const RECEIPT_SCHEMA = 'mira.openmaic.student-runtime-event-receipt.v1' as const;
+const STATE_VERSION = 1 as const;
+const STORAGE_PREFIX = 'mira:student-runtime-events:v1:';
+
+type SceneIdentity = {
+  readonly sceneIndex: number;
+  readonly sceneId: string;
+};
+
+export type MiraStudentRuntimeEvent =
+  | {
+      readonly schemaVersion: typeof EVENT_SCHEMA;
+      readonly sequence: number;
+      readonly type: 'scene_entered';
+      readonly payload: SceneIdentity;
+    }
+  | {
+      readonly schemaVersion: typeof EVENT_SCHEMA;
+      readonly sequence: number;
+      readonly type: 'action_completed';
+      readonly payload: SceneIdentity & { readonly actionId: string };
+    }
+  | {
+      readonly schemaVersion: typeof EVENT_SCHEMA;
+      readonly sequence: number;
+      readonly type: 'answer_submitted';
+      readonly payload: SceneIdentity & {
+        readonly questionId: string;
+        readonly response: string | readonly string[];
+        readonly attemptNumber: 1;
+      };
+    }
+  | {
+      readonly schemaVersion: typeof EVENT_SCHEMA;
+      readonly sequence: number;
+      readonly type: 'classroom_completed';
+      readonly payload: SceneIdentity;
+    };
+
+type EventType = MiraStudentRuntimeEvent['type'];
+type EventPayload<T extends EventType> = Extract<MiraStudentRuntimeEvent, { type: T }>['payload'];
+
+interface PendingEvent {
+  readonly eventKey: string;
+  readonly event: MiraStudentRuntimeEvent;
+}
+
+interface StoredState {
+  readonly version: typeof STATE_VERSION;
+  runtimeSessionId: string | null;
+  nextSequence: number;
+  pending: PendingEvent | null;
+  emittedKeys: string[];
+  completed: boolean;
+}
+
+interface RuntimeStatus {
+  readonly ok: true;
+  readonly schemaVersion: typeof RECEIPT_SCHEMA;
+  readonly runtimeSessionId: string;
+  readonly lastSequence: number;
+  readonly nextSequence: number;
+  readonly completed: boolean;
+  readonly completionReady: boolean;
+  readonly answeredQuestionIds: readonly string[];
+}
+
+interface RuntimeReceipt {
+  readonly ok: true;
+  readonly sequence: number;
+  readonly completed?: boolean;
+  readonly receiptSha256: string;
+}
+
+export interface MiraStudentRuntimeEventClient {
+  resume(): Promise<void>;
+  sceneEntered(payload: SceneIdentity): Promise<void>;
+  actionCompleted(payload: SceneIdentity & { readonly actionId: string }): Promise<void>;
+  answerSubmitted(
+    payload: SceneIdentity & {
+      readonly questionId: string;
+      readonly response: string | readonly string[];
+    },
+  ): Promise<void>;
+  completeWhenReady(payload: SceneIdentity): Promise<boolean>;
+  classroomCompleted(payload: SceneIdentity): Promise<void>;
+}
+
+export interface MiraStudentRuntimeEventClientOptions {
+  readonly classroomId: string;
+  readonly fetcher?: typeof fetch;
+  readonly storage?: Storage;
+  readonly endpoint?: string;
+}
+
+export function createMiraStudentRuntimeEventClient(
+  options: MiraStudentRuntimeEventClientOptions,
+): MiraStudentRuntimeEventClient {
+  const classroomId = identifier(options.classroomId, 'classroomId', 255);
+  const fetcher = options.fetcher ?? fetch;
+  const storage = options.storage ?? browserStorage();
+  const storageKey = `${STORAGE_PREFIX}${encodeURIComponent(classroomId)}`;
+  const endpoint = options.endpoint ?? '/mira/runtime-events';
+  let state = readState(storage, storageKey);
+  let synchronized = false;
+  let lastStatus: RuntimeStatus | null = null;
+  let tail: Promise<void> = Promise.resolve();
+
+  const persist = () => safeSet(storage, storageKey, JSON.stringify(state));
+
+  const synchronize = async (force = false): Promise<RuntimeStatus> => {
+    if (synchronized && !force && lastStatus) return lastStatus;
+    const result = await fetcher(endpoint, {
+      method: 'GET',
+      credentials: 'same-origin',
+      cache: 'no-store',
+      headers: { Accept: 'application/json' },
+    });
+    const body = await jsonBody(result);
+    if (!result.ok) throw runtimeRequestError(result.status, body);
+    const status = runtimeStatus(body);
+
+    if (state.runtimeSessionId !== status.runtimeSessionId) {
+      state = freshState(status.runtimeSessionId, status.nextSequence, status.completed);
+    } else {
+      if (state.pending) {
+        if (status.lastSequence >= state.pending.event.sequence) {
+          rememberEmitted(state, state.pending.eventKey);
+          state.pending = null;
+        } else if (status.nextSequence !== state.pending.event.sequence) {
+          throw new Error('Mira Runtime event sequence cannot be reconciled safely');
+        }
+      }
+      state.nextSequence = status.nextSequence;
+      state.completed = status.completed;
+    }
+    persist();
+    synchronized = true;
+    lastStatus = status;
+    return status;
+  };
+
+  const flushPending = async () => {
+    const pending = state.pending;
+    if (!pending) return;
+    const result = await fetcher(endpoint, {
+      method: 'POST',
+      credentials: 'same-origin',
+      cache: 'no-store',
+      headers: {
+        Accept: 'application/json',
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify(pending.event),
+    });
+    const body = await jsonBody(result);
+    if (!result.ok) throw runtimeRequestError(result.status, body);
+    const receipt = runtimeReceipt(body, pending.event.sequence);
+    rememberEmitted(state, pending.eventKey);
+    state.nextSequence = receipt.sequence + 1;
+    state.completed = receipt.completed === true;
+    state.pending = null;
+    persist();
+  };
+
+  const commit = async <T extends EventType>(type: T, payload: EventPayload<T>): Promise<void> => {
+    const eventKey = stableEventKey(type, payload);
+    if (
+      type === 'answer_submitted' &&
+      lastStatus?.answeredQuestionIds.includes(
+        (payload as EventPayload<'answer_submitted'>).questionId,
+      )
+    ) {
+      rememberEmitted(state, eventKey);
+      persist();
+      return;
+    }
+    if (state.emittedKeys.includes(eventKey)) return;
+    await flushPending();
+    if (state.emittedKeys.includes(eventKey)) return;
+    if (state.completed) throw new Error('Mira Runtime event stream is already completed');
+    const event = {
+      schemaVersion: EVENT_SCHEMA,
+      sequence: state.nextSequence,
+      type,
+      payload,
+    } as MiraStudentRuntimeEvent;
+    state.pending = { eventKey, event };
+    persist();
+    await flushPending();
+  };
+
+  const record = <T extends EventType>(type: T, payload: EventPayload<T>): Promise<void> => {
+    const operation = tail.catch(() => undefined).then(async () => {
+      await synchronize();
+      await commit(type, payload);
+    });
+    tail = operation;
+    return operation;
+  };
+
+  return {
+    resume: () => {
+      const operation = tail.catch(() => undefined).then(async () => {
+        await synchronize();
+      });
+      tail = operation;
+      return operation;
+    },
+    sceneEntered: (payload) =>
+      record('scene_entered', scenePayload(payload) as EventPayload<'scene_entered'>),
+    actionCompleted: (payload) =>
+      record('action_completed', {
+        ...scenePayload(payload),
+        actionId: identifier(payload.actionId, 'actionId'),
+      }),
+    answerSubmitted: (payload) =>
+      record('answer_submitted', {
+        ...scenePayload(payload),
+        questionId: identifier(payload.questionId, 'questionId'),
+        response: answerResponse(payload.response),
+        attemptNumber: 1,
+      }),
+    completeWhenReady: (payload) => {
+      const completionPayload = scenePayload(payload) as EventPayload<'classroom_completed'>;
+      const operation = tail.catch(() => undefined).then(async () => {
+        await synchronize();
+        await flushPending();
+        const status = await synchronize(true);
+        if (status.completed) return true;
+        if (!status.completionReady) return false;
+        await commit('classroom_completed', completionPayload);
+        return true;
+      });
+      tail = operation.then(() => undefined);
+      return operation;
+    },
+    classroomCompleted: (payload) =>
+      record('classroom_completed', scenePayload(payload) as EventPayload<'classroom_completed'>),
+  };
+}
+
+function freshState(
+  runtimeSessionId: string | null = null,
+  nextSequence = 1,
+  completed = false,
+): StoredState {
+  return {
+    version: STATE_VERSION,
+    runtimeSessionId,
+    nextSequence,
+    pending: null,
+    emittedKeys: [],
+    completed,
+  };
+}
+
+function readState(storage: Storage, key: string): StoredState {
+  try {
+    const parsed = JSON.parse(storage.getItem(key) ?? 'null') as Partial<StoredState> | null;
+    if (
+      !parsed ||
+      parsed.version !== STATE_VERSION ||
+      (parsed.runtimeSessionId !== null && typeof parsed.runtimeSessionId !== 'string') ||
+      !Number.isInteger(parsed.nextSequence) ||
+      Number(parsed.nextSequence) < 1 ||
+      !Array.isArray(parsed.emittedKeys) ||
+      !parsed.emittedKeys.every((value) => typeof value === 'string') ||
+      typeof parsed.completed !== 'boolean'
+    ) {
+      return freshState();
+    }
+    const pending = pendingEvent(parsed.pending);
+    return {
+      version: STATE_VERSION,
+      runtimeSessionId: parsed.runtimeSessionId ?? null,
+      nextSequence: Number(parsed.nextSequence),
+      pending,
+      emittedKeys: parsed.emittedKeys.slice(-256),
+      completed: parsed.completed,
+    };
+  } catch {
+    return freshState();
+  }
+}
+
+function pendingEvent(value: unknown): PendingEvent | null {
+  if (value == null) return null;
+  if (typeof value !== 'object' || Array.isArray(value)) return null;
+  const pending = value as Partial<PendingEvent>;
+  if (typeof pending.eventKey !== 'string' || !isStoredEvent(pending.event)) return null;
+  return { eventKey: pending.eventKey, event: pending.event };
+}
+
+function isStoredEvent(value: unknown): value is MiraStudentRuntimeEvent {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+  const event = value as Partial<MiraStudentRuntimeEvent>;
+  return (
+    event.schemaVersion === EVENT_SCHEMA &&
+    Number.isInteger(event.sequence) &&
+    Number(event.sequence) >= 1 &&
+    ['scene_entered', 'action_completed', 'answer_submitted', 'classroom_completed'].includes(
+      String(event.type),
+    ) &&
+    !!event.payload &&
+    typeof event.payload === 'object' &&
+    !Array.isArray(event.payload)
+  );
+}
+
+function scenePayload(value: SceneIdentity): SceneIdentity {
+  if (!Number.isInteger(value.sceneIndex) || value.sceneIndex < 0 || value.sceneIndex >= 100) {
+    throw new Error('Mira Runtime sceneIndex is invalid');
+  }
+  return {
+    sceneIndex: value.sceneIndex,
+    sceneId: identifier(value.sceneId, 'sceneId'),
+  };
+}
+
+function answerResponse(value: string | readonly string[]): string | readonly string[] {
+  if (typeof value === 'string') return value;
+  if (Array.isArray(value) && value.every((item) => typeof item === 'string')) return [...value];
+  throw new Error('Mira Runtime answer response is invalid');
+}
+
+function identifier(value: string, field: string, maximum = 128): string {
+  const normalized = String(value ?? '');
+  if (
+    normalized.length > maximum ||
+    !/^[A-Za-z0-9][A-Za-z0-9._:-]*$/.test(normalized)
+  ) {
+    throw new Error(`Mira Runtime ${field} is invalid`);
+  }
+  return normalized;
+}
+
+function runtimeStatus(value: unknown): RuntimeStatus {
+  const body = value as Partial<RuntimeStatus> | null;
+  if (
+    !body ||
+    body.ok !== true ||
+    body.schemaVersion !== RECEIPT_SCHEMA ||
+    typeof body.runtimeSessionId !== 'string' ||
+    !Number.isInteger(body.lastSequence) ||
+    !Number.isInteger(body.nextSequence) ||
+    Number(body.lastSequence) < 0 ||
+    Number(body.nextSequence) !== Number(body.lastSequence) + 1 ||
+    typeof body.completed !== 'boolean' ||
+    typeof body.completionReady !== 'boolean' ||
+    !Array.isArray(body.answeredQuestionIds) ||
+    !body.answeredQuestionIds.every(
+      (questionId) =>
+        typeof questionId === 'string' &&
+        /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/.test(questionId),
+    ) ||
+    new Set(body.answeredQuestionIds).size !== body.answeredQuestionIds.length
+  ) {
+    throw new Error('Mira Runtime returned an invalid event status');
+  }
+  return body as RuntimeStatus;
+}
+
+function runtimeReceipt(value: unknown, expectedSequence: number): RuntimeReceipt {
+  const body = value as Partial<RuntimeReceipt> | null;
+  if (
+    !body ||
+    body.ok !== true ||
+    body.sequence !== expectedSequence ||
+    !/^[a-f0-9]{64}$/.test(String(body.receiptSha256 ?? ''))
+  ) {
+    throw new Error('Mira Runtime returned an invalid event receipt');
+  }
+  return body as RuntimeReceipt;
+}
+
+async function jsonBody(response: Response): Promise<unknown> {
+  try {
+    return await response.json();
+  } catch {
+    return null;
+  }
+}
+
+function runtimeRequestError(status: number, body: unknown): Error {
+  const payload = body as { error?: unknown; message?: unknown } | null;
+  const error = new Error(
+    typeof payload?.message === 'string' ? payload.message : `Mira Runtime event failed (${status})`,
+  );
+  error.name = typeof payload?.error === 'string' ? payload.error : 'MiraRuntimeEventError';
+  return error;
+}
+
+function stableEventKey(type: EventType, payload: object): string {
+  if (type === 'answer_submitted') {
+    const answer = payload as EventPayload<'answer_submitted'>;
+    return `${type}:${canonicalJson({
+      sceneIndex: answer.sceneIndex,
+      sceneId: answer.sceneId,
+      questionId: answer.questionId,
+    })}`;
+  }
+  return `${type}:${canonicalJson(payload)}`;
+}
+
+function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`;
+  if (value && typeof value === 'object') {
+    return `{${Object.entries(value)
+      .sort(([left], [right]) => left.localeCompare(right))
+      .map(([key, item]) => `${JSON.stringify(key)}:${canonicalJson(item)}`)
+      .join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+function rememberEmitted(state: StoredState, eventKey: string): void {
+  if (!state.emittedKeys.includes(eventKey)) state.emittedKeys.push(eventKey);
+  if (state.emittedKeys.length > 256) state.emittedKeys.splice(0, state.emittedKeys.length - 256);
+}
+
+function browserStorage(): Storage {
+  if (typeof window === 'undefined') throw new Error('Mira Runtime event storage is unavailable');
+  return window.localStorage;
+}
+
+function safeSet(storage: Storage, key: string, value: string): void {
+  try {
+    storage.setItem(key, value);
+  } catch {
+    throw new Error('Mira Runtime event state could not be persisted safely');
+  }
+}
