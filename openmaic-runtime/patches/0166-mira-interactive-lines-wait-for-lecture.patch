diff --git a/lib/mira/lecture-audio.ts b/lib/mira/lecture-audio.ts
new file mode 100644
--- /dev/null
+++ b/lib/mira/lecture-audio.ts
@@ -0,0 +1,26 @@
+/**
+ * Whether the classroom lecture (or a discussion) is speaking. Interactive
+ * pages carry their own recorded teacher lines; they stay quiet while the
+ * lecture speaks, and a tap inside a page pauses the lecture so the child
+ * hears the answer to what they did.
+ */
+export const LECTURE_AUDIO_EVENT = 'mira:lecture-audio';
+/** Existing pause request shared with native textbook activities. */
+export const ACTIVITY_AUDIO_EVENT = 'mira:textbook-play-audio';
+
+let speaking = false;
+
+export function isLectureSpeaking(): boolean {
+  return speaking;
+}
+
+export function setLectureSpeaking(value: boolean): void {
+  if (speaking === value) return;
+  speaking = value;
+  window.dispatchEvent(new CustomEvent(LECTURE_AUDIO_EVENT, { detail: { speaking } }));
+}
+
+/** A page may speak only while it is on screen and the lecture is silent. */
+export function pageNarrationAllowed(shown: boolean, lectureSpeaking: boolean): boolean {
+  return shown && !lectureSpeaking;
+}
diff --git a/tests/scene-renderers/interactive-lecture-audio.test.ts b/tests/scene-renderers/interactive-lecture-audio.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/scene-renderers/interactive-lecture-audio.test.ts
@@ -0,0 +1,31 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it } from 'vitest';
+import {
+  LECTURE_AUDIO_EVENT,
+  isLectureSpeaking,
+  pageNarrationAllowed,
+  setLectureSpeaking,
+} from '@/lib/mira/lecture-audio';
+
+describe('interactive page lines and the lecture', () => {
+  afterEach(() => setLectureSpeaking(false));
+
+  it('lets a page speak only while it is shown and the lecture is silent', () => {
+    expect(pageNarrationAllowed(true, false)).toBe(true);
+    expect(pageNarrationAllowed(true, true)).toBe(false);
+    expect(pageNarrationAllowed(false, false)).toBe(false);
+  });
+
+  it('announces each change of the lecture once', () => {
+    const seen: boolean[] = [];
+    const listener = (event: Event) =>
+      seen.push((event as CustomEvent<{ speaking: boolean }>).detail.speaking);
+    window.addEventListener(LECTURE_AUDIO_EVENT, listener);
+    setLectureSpeaking(true);
+    setLectureSpeaking(true);
+    setLectureSpeaking(false);
+    window.removeEventListener(LECTURE_AUDIO_EVENT, listener);
+    expect(seen).toEqual([true, false]);
+    expect(isLectureSpeaking()).toBe(false);
+  });
+});
