+++ b/tests/server/mira-flash-formal-health.test.ts
@@ -0,0 +1,35 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import { getMiraFormalGenerationRuntimePolicy, MIRA_FORMAL_GENERATION_POLICY,
+  MIRA_FLASH_CANDIDATE_PROFESSIONAL_CREATION_POLICY } from '@/lib/server/mira-formal-generation-policy';
+import { getMiraFormalProviderReadinessPolicy, MIRA_FORMAL_PROVIDER_READINESS_POLICY } from '@/lib/server/mira-formal-provider-readiness';
+import { getMiraProfessionalModelRuntimePolicy } from '@/lib/server/model-routes';
+
+const id = 'deepseek-v4.1-flash-candidate-v1';
+afterEach(() => { delete process.env.MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY; });
+
+describe('actual exported formal candidate health policies', () => {
+  it('reports the same model and learning policy used by the native generation input', () => {
+    process.env.MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY = id;
+    const generation = getMiraFormalGenerationRuntimePolicy();
+    expect(generation.professionalCreation).toEqual(MIRA_FLASH_CANDIDATE_PROFESSIONAL_CREATION_POLICY);
+    expect(generation.professionalCreation).toMatchObject({ modelPolicyId: id,
+      sceneLearningPolicy: { enforced: true, noMasteryClaims: true,
+        pictureChoicesForGrades: ['primary_1', 'primary_2'], scriptSyntaxRequired: true } });
+    const model = getMiraProfessionalModelRuntimePolicy();
+    expect(model.policyId).toBe(id);
+    expect(model.coursewareVerifier.modelId).toBe('deepseek-flash');
+    expect(getMiraFormalProviderReadinessPolicy()).toMatchObject({ modelPolicyId: id,
+      expectedProviderCallCount: 5, providers: { deepseek: { modelId: 'deepseek-flash' } } });
+  });
+  it('keeps the original default health object and historical policy hash inputs', () => {
+    expect(getMiraFormalGenerationRuntimePolicy()).toBe(MIRA_FORMAL_GENERATION_POLICY);
+    expect(getMiraFormalProviderReadinessPolicy()).toBe(MIRA_FORMAL_PROVIDER_READINESS_POLICY);
+    expect(MIRA_FORMAL_GENERATION_POLICY.professionalCreation).not.toHaveProperty('modelPolicyId');
+    expect(MIRA_FORMAL_PROVIDER_READINESS_POLICY).not.toHaveProperty('modelPolicyId');
+  });
+  it('fails closed for unsupported health model policy selections', () => {
+    process.env.MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY = 'unknown-policy';
+    expect(() => getMiraFormalGenerationRuntimePolicy()).toThrow(/Unsupported/);
+    expect(() => getMiraFormalProviderReadinessPolicy()).toThrow(/Unsupported/);
+  });
+});
