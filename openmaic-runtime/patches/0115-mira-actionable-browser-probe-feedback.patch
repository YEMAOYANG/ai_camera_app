+  'diagram must be separate from explanation',
+  'teaching graphic too small',
+  'numeric output must be a visible number',
+  'independent fraction verifier requires SVG rects',
+  'fraction mechanism output or SVG geometry is incorrect',
+  'exploration states do not change model and explanation',
+  'reset does not restore the original model and feedback',
+] as const;
+
+/** Diagnostic projection only; existing browser verdicts and receipts are unchanged. */
+export function formatFormalBrowserFailure(
+  observed: FormalSceneInspectionResult, probes: readonly FormalInteractionProbe[],
+): string {
+  const failures = observed.probeResults.filter(probe => !probe.passed).slice(0, 3).map(failed => {
+    const id = /^[A-Za-z0-9_-]{1,80}$/.test(failed.id) ? failed.id : 'local-probe';
+    const reason = SAFE_BROWSER_PROBE_REASONS.find(value => failed.message.includes(value))
+      ?? (/\bTimeout\b[^\n]{0,80}\bexceeded\b/i.test(failed.message)
+        ? 'probe timed out before the declared state was observed' : 'local probe failed (details withheld)');
+    const probe = probes.find(value => value.id === failed.id);
+    // These are related local controls/regions, not a claim that each caused the failure.
+    const candidates = [probe?.selector, probe?.expect.selector, probe?.exploration?.diagramSelector,
+      probe?.exploration?.feedbackSelector, probe?.exploration?.reset.selector,
+      ...(probe?.exploration?.states.flatMap(state => state.operations.map(op => op.selector)) ?? [])];
+    const selectors = [...new Set(candidates.filter((value): value is string =>
+      typeof value === 'string' && /^#[A-Za-z][A-Za-z0-9_-]{0,98}$/.test(value)))].slice(0, 6);
+    return `${id}: ${reason}${selectors.length ? `; related selectors: ${selectors.join(', ')}` : ''}`;
+  });
+  const existing = observed.issues.join('; ') || 'missing render or interaction evidence';
+  return `Browser check ${observed.viewport.width}x${observed.viewport.height}: ${[...failures, existing].join('; ')}`.slice(0, 2000);
 }
 
