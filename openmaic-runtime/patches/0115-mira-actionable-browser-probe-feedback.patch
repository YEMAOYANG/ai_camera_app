+const SAFE_BROWSER_PROBE_REASONS = [
+  'probe control is disabled',
+  'probe control is outside the viewport or covered',
+  'probe region is outside the viewport',
+  'probe iframe transform is unsupported',
+  'probe iframe geometry is unsupported',
+  'probe iframe is outside the viewport or covered',
+  'probe target absent',
