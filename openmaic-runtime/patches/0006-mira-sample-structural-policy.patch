+
+export interface MiraSampleStructuralPlan {
+  courseTitle: string;
+  languageDirective: string;
+  outlines: SceneOutline[];
+  agents: AgentInfo[];
+}
+
+function cloneOutline(outline: SceneOutline): SceneOutline {
+  return {
+    ...outline,
+    keyPoints: [...outline.keyPoints],
+    ...(outline.quizConfig
+      ? {
+          quizConfig: {
+            ...outline.quizConfig,
+            questionTypes: [...outline.quizConfig.questionTypes],
+          },
+        }
+      : {}),
+    ...(outline.widgetOutline
+      ? {
+          widgetOutline: {
+            ...outline.widgetOutline,
+            ...(outline.widgetOutline.keyVariables
+              ? { keyVariables: [...outline.widgetOutline.keyVariables] }
+              : {}),
+            ...(outline.widgetOutline.objects
+              ? { objects: [...outline.widgetOutline.objects] }
+              : {}),
+            ...(outline.widgetOutline.interactions
+              ? { interactions: [...outline.widgetOutline.interactions] }
+              : {}),
+            ...(outline.widgetOutline.playerControls
+              ? { playerControls: [...outline.widgetOutline.playerControls] }
+              : {}),
+          },
+        }
+      : {}),
+  };
+}
+
+export function isMiraSampleStructuralRequirement(requirement: string): boolean {
+  return requirement.split('\n').some((line) => line === MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER);
+}
+
+export function resolveMiraSampleStructuralPlan(
+  requirement: string,
+): MiraSampleStructuralPlan | null {
+  if (!isMiraSampleStructuralRequirement(requirement)) return null;
+  return {
+    courseTitle: MIRA_SAMPLE_COURSE_TITLE,
+    languageDirective: MIRA_SAMPLE_LANGUAGE_DIRECTIVE,
+    outlines: SAMPLE_OUTLINES.map(cloneOutline),
+    agents: SAMPLE_AGENTS.map((agent) => ({ ...agent })),
+  };
+}
+
+function nextActionId(actions: readonly Action[], base: string): string {
+  const ids = new Set(actions.map((action) => action.id));
+  if (!ids.has(base)) return base;
+  let suffix = 2;
+  while (ids.has(`${base}-${suffix}`)) suffix += 1;
+  return `${base}-${suffix}`;
+}
+
+function isNonemptySpeech(action: Action): boolean {
+  return action.type === 'speech' && action.text.trim().length > 0;
+}
+
+function fallbackDiscussion(
+  outline: SceneOutline,
+  action: Extract<Action, { type: 'discussion' }> | undefined,
+): Extract<Action, { type: 'discussion' }> | undefined {
+  const required = REQUIRED_DISCUSSIONS[outline.id];
+  if (!action && !required) return undefined;
+
+  const peerIds = new Set(
+    SAMPLE_AGENTS.filter((agent) => agent.role === 'student').map((a) => a.id),
+  );
+  const fallbackPeer = SAMPLE_AGENTS[(outline.order % 4) + 1]?.id || PEER_DUODUO_ID;
+  const agentId =
+    required?.agentId ||
+    (action?.agentId && peerIds.has(action.agentId) ? action.agentId : fallbackPeer);
+  const topic = required?.topic || action?.topic?.trim() || `交流${outline.title}中的发现`;
+  const prompt = required?.prompt || action?.prompt?.trim() || '请用一句短话说说你的发现。';
+
+  return {
+    ...(action || {
+      id: `mira-sample-discussion-${String(outline.order).padStart(2, '0')}`,
+      type: 'discussion' as const,
+    }),
+    topic,
+    prompt,
+    agentId,
+  };
+}
+
+/**
+ * Repair only the sample policy's structural action guarantees.
+ * Meaningful model-authored speech is never rewritten. Blank speech is invalid
+ * and removed; a short, server-owned line is inserted only if none remains.
+ */
+export function ensureMiraSampleSceneActions(
+  outline: SceneOutline,
+  content: GeneratedSceneContent,
+  actions: readonly Action[],
+): Action[] {
+  const nonblankActions = actions.filter(
+    (action) => action.type !== 'speech' || action.text.trim().length > 0,
+  );
+  const existingDiscussion = nonblankActions.find(
+    (action): action is Extract<Action, { type: 'discussion' }> => action.type === 'discussion',
+  );
+  let repaired: Action[] = nonblankActions.filter((action) => action.type !== 'discussion');
+
+  if (!repaired.some(isNonemptySpeech)) {
+    const text = SAFE_FALLBACK_NARRATION[outline.id];
+    if (!text) {
+      throw new Error(`mira_sample_structural_policy_failed:unknown_outline:${outline.id}`);
+    }
+    repaired.push({
+      id: nextActionId(repaired, `mira-sample-speech-${String(outline.order).padStart(2, '0')}`),
+      type: 'speech',
+      title: '场景讲解',
+      text,
+    });
+  }
+
+  if (outline.type === 'slide' && 'elements' in content && content.elements.length > 0) {
+    const elementIds = new Set(content.elements.map((element) => element.id));
+    const firstElementId = content.elements[0].id;
+    repaired = repaired.map((action) => {
+      if (
+        (action.type === 'spotlight' || action.type === 'laser') &&
+        !elementIds.has(action.elementId)
+      ) {
+        return { ...action, elementId: firstElementId };
+      }
+      return action;
+    });
+
+    if (
+      outline.id === SAMPLE_OUTLINES[0].id &&
+      !repaired.some((action) => action.type === 'spotlight' && elementIds.has(action.elementId))
+    ) {
+      repaired.unshift({
+        id: nextActionId(repaired, 'mira-sample-spotlight-01'),
+        type: 'spotlight',
+        title: '聚焦重点',
+        elementId: firstElementId,
+      });
+    }
+  }
+
+  const discussion = fallbackDiscussion(outline, existingDiscussion);
+  if (discussion) {
+    const id = nextActionId(repaired, discussion.id);
+    repaired.push(id === discussion.id ? discussion : { ...discussion, id });
+  }
+  return repaired;
+}
+
+function structuralFailure(reason: string): never {
+  throw new Error(`mira_sample_structural_policy_failed:${reason}`);
+}
+
+function assertCondition(condition: unknown, reason: string): asserts condition {
+  if (!condition) structuralFailure(reason);
+}
+
+/** Fail closed before media/TTS spend if the fixed sample structure was not produced. */
+export function assertMiraSampleClassroomStructure(stage: Stage, scenes: readonly Scene[]): void {
+  assertCondition(scenes.length === SAMPLE_OUTLINES.length, 'scene_count');
+
+  const configs = stage.generatedAgentConfigs;
+  assertCondition(
+    Array.isArray(configs) && configs.length === SAMPLE_AGENTS.length,
+    'roster_count',
+  );
+  assertCondition(stage.agentIds === undefined, 'roster_storage_mode');
+  const expectedAgentIds = new Set(SAMPLE_AGENTS.map((agent) => agent.id));
+  const actualAgentIds = new Set(configs.map((agent) => agent.id));
+  assertCondition(
+    actualAgentIds.size === expectedAgentIds.size &&
+      configs.every((agent) => expectedAgentIds.has(agent.id)),
+    'roster_ids',
+  );
+  assertCondition(
+    configs.filter((agent) => agent.role === 'teacher').length === 1,
+    'teacher_count',
+  );
+  assertCondition(configs.filter((agent) => agent.role === 'student').length === 4, 'peer_count');
+
+  let slideCount = 0;
+  let quizCount = 0;
+  const widgetTypes = new Set<string>();
+  const discussionPeers = new Set<string>();
+  let validSpotlights = 0;
+
+  for (const [index, scene] of scenes.entries()) {
+    const expected = SAMPLE_OUTLINES[index];
+    const actions = scene.actions || [];
+    assertCondition(scene.order === index + 1, `scene_order_${index + 1}`);
+    assertCondition(scene.outlineId === expected.id, `outline_id_${index + 1}`);
+    assertCondition(scene.type === expected.type, `scene_type_${index + 1}`);
+
+    const speeches = actions.filter(
+      (action): action is Extract<Action, { type: 'speech' }> => action.type === 'speech',
+    );
+    assertCondition(speeches.length > 0, `speech_missing_${index + 1}`);
+    assertCondition(
+      speeches.every((speech) => speech.text.trim().length > 0),
+      `speech_blank_${index + 1}`,
+    );
+
+    const discussions = actions.filter(
+      (action): action is Extract<Action, { type: 'discussion' }> => action.type === 'discussion',
+    );
+    assertCondition(discussions.length <= 1, `discussion_count_${index + 1}`);
+    if (discussions.length === 1) {
+      const discussion = discussions[0];
+      assertCondition(actions.at(-1) === discussion, `discussion_terminal_${index + 1}`);
+      assertCondition(
+        !!discussion.agentId &&
+          configs.some((agent) => agent.id === discussion.agentId && agent.role === 'student'),
+        `discussion_peer_${index + 1}`,
+      );
+      assertCondition(discussion.topic.trim().length > 0, `discussion_topic_${index + 1}`);
+      discussionPeers.add(discussion.agentId);
+    }
+
+    if (scene.type === 'slide') {
+      slideCount += 1;
+      const elementIdList = scene.content.canvas.elements.map((element) => element.id);
+      const elementIds = new Set(elementIdList);
+      assertCondition(
+        elementIdList.length > 0 &&
+          elementIdList.every((id) => id.trim().length > 0) &&
+          elementIds.size === elementIdList.length,
+        `slide_elements_${index + 1}`,
+      );
+      for (const action of actions) {
+        if (action.type !== 'spotlight') continue;
+        assertCondition(elementIds.has(action.elementId), `spotlight_target_${index + 1}`);
+        validSpotlights += 1;
+      }
+    } else if (scene.type === 'quiz') {
+      quizCount += 1;
+      assertCondition(scene.content.questions.length > 0, `quiz_questions_${index + 1}`);
+    } else if (scene.type === 'interactive') {
+      assertCondition(
+        typeof scene.content.html === 'string' && scene.content.html.trim().length > 0,
+        `interactive_html_${index + 1}`,
+      );
+      assertCondition(scene.content.widgetType === expected.widgetType, `widget_type_${index + 1}`);
+      widgetTypes.add(scene.content.widgetType || '');
+    }
+  }
+
+  assertCondition(slideCount === 5, 'slide_count');
+  assertCondition(quizCount === 2, 'quiz_count');
+  assertCondition(
+    widgetTypes.size === 3 &&
+      ['simulation', 'game', 'visualization3d'].every((type) => widgetTypes.has(type)),
+    'interactive_widget_types',
+  );
+  assertCondition(discussionPeers.size >= 2, 'distinct_discussion_peers');
+  assertCondition(validSpotlights >= 1, 'valid_spotlight');
+}
