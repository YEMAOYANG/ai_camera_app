+export const MIRA_FORMAL_FLASH_AGENT_BUDGET = {
+  policyId: 'mira-formal-agent-budget.v2',
+  maxDispatches: 48,
+  // Conservative one-character/one-token allowance for each 1M-context turn.
+  // Thinking/tool history remains intact; this does not change the paid ledger.
+  maxCumulativeInputCharacters: 48 * 1_048_576,
+  maxOutputTokensPerDispatch: 16_384,
+  maxRetries: 0,
+} as const;
+const FLASH_MODEL_POLICY_ID = 'deepseek-v4.1-flash-candidate-v1' as const;
+const LEGACY_MODEL_POLICY_ID = 'deepseek-v4-pro-flash-v1' as const;
+
+export function miraFormalAgentBudget(modelPolicyId?: unknown) {
+  if (modelPolicyId === FLASH_MODEL_POLICY_ID) return MIRA_FORMAL_FLASH_AGENT_BUDGET;
+  if (modelPolicyId === undefined || modelPolicyId === LEGACY_MODEL_POLICY_ID) return MIRA_FORMAL_AGENT_BUDGET;
+  throw new Error('FORMAL_AGENT_MODEL_POLICY_INVALID');
+}
+
+interface AgentBudgetUpgradeReceipt {
+  schemaVersion: 'mira.openmaic.formal-agent-budget-upgrade.v1';
+  sessionId: string;
+  modelPolicyId: typeof FLASH_MODEL_POLICY_ID;
+  sourcePolicyId: typeof MIRA_FORMAL_AGENT_BUDGET.policyId;
+  targetPolicyId: typeof MIRA_FORMAL_FLASH_AGENT_BUDGET.policyId;
+  sourceLedgerSha256: string;
+  sourceArchiveFile: string;
+  priorCalls: number;
+  dispatchCount: number;
+  cumulativeInputCharacters: number;
+}
+interface AgentBudgetLedger {
+  policyId: string;
+  modelPolicyId?: string;
+  priorCalls: number;
+  dispatches: Array<{ inputCharacters: number; reservedAt: string }>;
+  cumulativeInputCharacters?: number;
+  upgrade?: AgentBudgetUpgradeReceipt;
+  [key: string]: unknown;
+}
+const object = (value: unknown): value is Record<string, unknown> =>
+  !!value && typeof value === 'object' && !Array.isArray(value);
+function canonicalSha(value: unknown): string {
+  return createHash('sha256').update(JSON.stringify(value, (_, v) => object(v)
+    ? Object.fromEntries(Object.entries(v).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)) : v)).digest('hex');
+}
+function ledgerCharacters(ledger: AgentBudgetLedger): number {
+  const total = ledger.dispatches.reduce((sum, row) => sum + row.inputCharacters, 0);
+  if (!Number.isSafeInteger(total)) throw new Error('FORMAL_AGENT_BUDGET_LEDGER_INVALID');
+  return total;
+}
+function validatedLedger(value: unknown): AgentBudgetLedger {
+  if (!object(value) || (value.policyId !== MIRA_FORMAL_AGENT_BUDGET.policyId
+    && value.policyId !== MIRA_FORMAL_FLASH_AGENT_BUDGET.policyId)
+    || !Number.isSafeInteger(value.priorCalls) || Number(value.priorCalls) < 0
+    || !Array.isArray(value.dispatches) || value.dispatches.some(row => !object(row)
+      || !Number.isSafeInteger(row.inputCharacters) || Number(row.inputCharacters) < 1))
+    throw new Error('FORMAL_AGENT_BUDGET_LEDGER_INVALID');
+  const ledger = value as unknown as AgentBudgetLedger;
+  const total = ledgerCharacters(ledger);
+  if (!Number.isSafeInteger(ledger.priorCalls + ledger.dispatches.length)
+    || (ledger.policyId === MIRA_FORMAL_FLASH_AGENT_BUDGET.policyId
+      && (ledger.modelPolicyId !== FLASH_MODEL_POLICY_ID || ledger.cumulativeInputCharacters !== total)))
+    throw new Error('FORMAL_AGENT_BUDGET_LEDGER_INVALID');
+  return ledger;
+}
+
+/** Pure, operator-only conversion. The caller must preserve archive.sourceLedgerJson
+ * at archive.fileName before atomically replacing dispatches.json. No HTTP route,
+ * file write, provider dispatch or counter reset is performed by this helper. */
+export function upgradeMiraFormalCandidateAgentBudget(input: {
+  sessionId: string;
+  modelPolicyId: unknown;
+  sourceLedgerJson: string;
+  expectedSourceSha256: string;
+  trustedOperatorApproved: boolean;
+}) {
+  if (!/^miraformal_[a-f0-9]{64}$/.test(input.sessionId)
+    || input.modelPolicyId !== FLASH_MODEL_POLICY_ID || input.trustedOperatorApproved !== true
+    || typeof input.sourceLedgerJson !== 'string' || !/^[a-f0-9]{64}$/.test(input.expectedSourceSha256))
+    throw new Error('FORMAL_AGENT_BUDGET_UPGRADE_AUTHORITY_INVALID');
+  const sourceSha256 = createHash('sha256').update(input.sourceLedgerJson, 'utf8').digest('hex');
+  if (sourceSha256 !== input.expectedSourceSha256) throw new Error('FORMAL_AGENT_BUDGET_UPGRADE_SOURCE_CHANGED');
+  const source = validatedLedger(JSON.parse(input.sourceLedgerJson));
+  if (source.policyId !== MIRA_FORMAL_AGENT_BUDGET.policyId || source.upgrade !== undefined
+    || (source.modelPolicyId !== undefined && source.modelPolicyId !== FLASH_MODEL_POLICY_ID))
+    throw new Error('FORMAL_AGENT_BUDGET_UPGRADE_SOURCE_INVALID');
+  const characters = ledgerCharacters(source);
+  if (source.cumulativeInputCharacters !== undefined && source.cumulativeInputCharacters !== characters)
+    throw new Error('FORMAL_AGENT_BUDGET_UPGRADE_SOURCE_INVALID');
+  const fileName = `dispatches.v1.${sourceSha256}.json`;
+  const receipt: AgentBudgetUpgradeReceipt = {
+    schemaVersion: 'mira.openmaic.formal-agent-budget-upgrade.v1', sessionId: input.sessionId,
+    modelPolicyId: FLASH_MODEL_POLICY_ID, sourcePolicyId: MIRA_FORMAL_AGENT_BUDGET.policyId,
+    targetPolicyId: MIRA_FORMAL_FLASH_AGENT_BUDGET.policyId, sourceLedgerSha256: sourceSha256,
+    sourceArchiveFile: fileName, priorCalls: source.priorCalls,
+    dispatchCount: source.dispatches.length, cumulativeInputCharacters: characters,
+  };
+  const ledger: AgentBudgetLedger = { ...structuredClone(source),
+    policyId: MIRA_FORMAL_FLASH_AGENT_BUDGET.policyId, modelPolicyId: FLASH_MODEL_POLICY_ID,
+    cumulativeInputCharacters: characters, upgrade: receipt };
+  return { ledger, archive: { fileName, sha256: sourceSha256, sourceLedgerJson: input.sourceLedgerJson }, receipt };
+}
+
+async function verifyUpgradeArchive(folder: string, ledger: AgentBudgetLedger, sessionId: string): Promise<void> {
+  if (ledger.upgrade === undefined) return;
+  const receipt = ledger.upgrade;
+  if (!object(receipt) || receipt.schemaVersion !== 'mira.openmaic.formal-agent-budget-upgrade.v1'
+    || receipt.sessionId !== sessionId || receipt.modelPolicyId !== FLASH_MODEL_POLICY_ID
+    || receipt.sourcePolicyId !== MIRA_FORMAL_AGENT_BUDGET.policyId
+    || receipt.targetPolicyId !== MIRA_FORMAL_FLASH_AGENT_BUDGET.policyId
+    || !/^[a-f0-9]{64}$/.test(receipt.sourceLedgerSha256)
+    || receipt.sourceArchiveFile !== `dispatches.v1.${receipt.sourceLedgerSha256}.json`)
+    throw new Error('FORMAL_AGENT_BUDGET_UPGRADE_RECEIPT_INVALID');
+  let raw: string;
+  try { raw = await readFile(join(folder, receipt.sourceArchiveFile), 'utf8'); }
+  catch { throw new Error('FORMAL_AGENT_BUDGET_UPGRADE_ARCHIVE_MISSING'); }
+  const upgraded = upgradeMiraFormalCandidateAgentBudget({ sessionId, modelPolicyId: FLASH_MODEL_POLICY_ID,
+    sourceLedgerJson: raw, expectedSourceSha256: receipt.sourceLedgerSha256, trustedOperatorApproved: true });
+  if (canonicalSha(upgraded.receipt) !== canonicalSha(receipt)
+    || ledger.priorCalls !== upgraded.ledger.priorCalls
+    || canonicalSha(ledger.dispatches.slice(0, receipt.dispatchCount)) !== canonicalSha(upgraded.ledger.dispatches))
+    throw new Error('FORMAL_AGENT_BUDGET_UPGRADE_RECEIPT_INVALID');
+}
