+const MIRA_FORMAL_OUTLINE_DIRECTIVE = `
+MIRA FORMAL OUTLINE CONTRACT (server enforced):
+- Return exactly 10 outlines in this exact type order: slide, slide, slide, slide, slide, quiz, quiz, interactive, interactive, interactive.
+- Interactive outlines 8-10 must use widgetType simulation, game, visualization3d respectively and include a non-empty widgetOutline.
+- Do not return PBL scenes. Do not omit, merge, or add scenes.
+- Return only the JSON envelope requested by the outline prompt.`.trim();
+
+function formalLlmAbortSignal(enabled: boolean): AbortSignal | undefined {
+  return enabled ? AbortSignal.timeout(MIRA_FORMAL_LLM_TIMEOUT_MS) : undefined;
+}
+
+function matchesMiraFormalOutlineContract(outlines: SceneOutline[]): boolean {
+  const expectedTypes = MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT.orderedSceneTypes;
+  if (
+    outlines.length !== MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT.exactSceneCount ||
+    outlines.some((outline, index) => outline.type !== expectedTypes[index])
+  ) {
+    return false;
+  }
+  const interactiveWidgets = outlines
+    .filter((outline) => outline.type === 'interactive')
+    .map((outline) => outline.widgetType);
+  return MIRA_FORMAL_RUNTIME_CLASSROOM_CONTRACT.interactive.requiredWidgetTypes.every(
+    (widgetType) => interactiveWidgets.includes(widgetType),
+  );
+}
 
