 }
 
+interface OutlineEnvelope {
+  languageDirective?: unknown;
+  courseTitle?: unknown;
+  outlines: SceneOutline[];
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** Accept common provider envelopes while keeping the scene array authoritative. */
+function normalizeOutlineEnvelope(parsed: unknown): OutlineEnvelope | null {
+  if (Array.isArray(parsed)) return { outlines: parsed as SceneOutline[] };
+  if (!isRecord(parsed)) return null;
+
+  const candidates: Record<string, unknown>[] = [parsed];
+  for (const key of ['data', 'result']) {
+    if (isRecord(parsed[key])) candidates.push(parsed[key]);
+  }
+
+  for (const candidate of candidates) {
+    const outlines = [candidate.outlines, candidate.sceneOutlines, candidate.scenes].find(
+      Array.isArray,
+    );
+    if (!outlines) continue;
+    return {
+      languageDirective: candidate.languageDirective ?? parsed.languageDirective,
+      courseTitle: candidate.courseTitle ?? parsed.courseTitle,
+      outlines: outlines as SceneOutline[],
+    };
+  }
+  return null;
+}
