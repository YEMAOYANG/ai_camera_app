+      if (formalTask && result.finishReason === 'length') {
+        // A partial page must not be parsed/persisted as a successful generation.
+        // Retain the paid reply for inspection; never delete an earlier scene or
+        // silently retry at a smaller limit to fit the remaining money.
+        const sha = (value: unknown) =>
+          createHash('sha256').update(JSON.stringify(value)).digest('hex');
+        const response = {
+          schemaVersion: 'mira.openmaic.truncated-scene-response.v1',
+          stage,
