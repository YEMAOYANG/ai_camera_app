+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+vi.mock('@/lib/server/course-archive-events', () => ({ enqueueLegacyClassroomArchive: vi.fn() }));
+import {
+  courseStorageAsset, readCourseStorageAsset, readCourseStorageFile,
+  assertCourseStorageFileWritable, accessCourseStorageFile,
+  withLocalCourseStorageFile,
+} from '@/lib/server/course-storage-registry';
+import { readClassroom, writeJsonFileAtomic } from '@/lib/server/classroom-storage';
+import { assertMiraFormalTtsRequest, executeMiraFormalTts } from '@/lib/server/mira-formal-audio';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+
+const room = { id: 'registry_room', stage: { id: 'registry_room' }, scenes: [], createdAt: 'frozen' };
+const bytes = Buffer.from(JSON.stringify(room));
+const sha256 = createHash('sha256').update(bytes).digest('hex');
+const sourcePath = 'openmaic-runtime/.runtime/OpenMAIC/data/classrooms/registry_room.json';
+const localPath = path.join(process.cwd(), 'data/classrooms/registry_room.json');
+const asset = {
+  sourcePath, path: sourcePath, sha256, byteSize: bytes.length, mimeType: 'application/json',
+  storage: { endpoint: 'http://minio.test:9000', bucket: 'study', region: 'us-east-1' },
+  locator: { kind: 'zip_member' as const, objectKey: '语文/课件.zip', etag: '"archive"',
+    archiveSha256: 'a'.repeat(64), archiveByteSize: 1000, memberPath: '原稿/classroom.json' },
+};
+const fetchMock = vi.fn();
+const absent = () => Response.json({ ok: false, error: { code: 'course_storage_asset_not_found' } }, { status: 404 });
+const file = (body = bytes, headers: Record<string, string> = {}) => new Response(body, {
+  headers: { 'X-Mira-File-Source': 'remote', 'X-Mira-File-Sha256': sha256,
+    'Content-Length': String(body.length), ...headers },
+});
+beforeEach(() => {
+  vi.stubEnv('COURSE_STORAGE_MODE', 'registry');
+  vi.stubEnv('MIRA_BACKEND_INTERNAL_URL', 'http://backend.test:8000');
+  vi.stubEnv('MIRA_INTERNAL_API_TOKEN', 'private-internal-token');
+  vi.stubGlobal('fetch', fetchMock);
+  fetchMock.mockReset().mockImplementation(async (url: URL) => url.pathname.endsWith('/asset')
+    ? Response.json({ ok: true, asset }) : file());
+});
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllEnvs(); vi.unstubAllGlobals(); });
+
+it('reads remote registered classroom bytes and verifies the bound SHA without disk', async () => {
+  const disk = vi.spyOn(fs, 'readFile').mockRejectedValue(new Error('local must not be used'));
+  expect(await readClassroom(room.id)).toEqual(room);
+  expect(disk).not.toHaveBeenCalled();
+  expect(fetchMock.mock.calls[0][0].searchParams.has('sha256')).toBe(false);
+  expect(fetchMock.mock.calls[1][0].searchParams.get('sha256')).toBe(sha256);
+  expect(fetchMock.mock.calls[0][1]).toMatchObject({
+    redirect: 'error', cache: 'no-store', headers: { 'X-Mira-Internal-Token': 'private-internal-token' },
+  });
+});
+
+it('checks both classroom spellings before using an unregistered local candidate', async () => {
+  const disk = vi.spyOn(fs, 'readFile').mockResolvedValue(Buffer.from('{"id":"stale"}'));
+  fetchMock.mockImplementation(async (url: URL) => {
+    if (url.pathname.endsWith('/file')) return file();
+    const source = url.searchParams.get('path');
+    return source === sourcePath ? absent() : Response.json({ ok: true, asset: {
+      ...asset, sourcePath: source, path: source,
+    } });
+  });
+  expect(await readClassroom(room.id)).toEqual(room);
+  expect(disk).not.toHaveBeenCalled();
+});
+
+it('permits local new drafts only after an explicit unregistered result', async () => {
+  fetchMock.mockImplementation(async () => absent());
+  const disk = vi.spyOn(fs, 'readFile').mockResolvedValue(Buffer.from('local-new-draft'));
+  expect(await readCourseStorageFile(localPath, 'utf8')).toBe('local-new-draft');
+  expect(disk).toHaveBeenCalledWith(localPath);
+  await expect(assertCourseStorageFileWritable(localPath)).resolves.toBeUndefined();
+});
+
+it.each([401, 403, 404, 409, 500])('never falls back on an unrecognised backend failure %s', async status => {
+  fetchMock.mockResolvedValue(Response.json({ error: 'private upstream failure' }, { status }));
+  const disk = vi.spyOn(fs, 'readFile').mockResolvedValue(Buffer.from('stale-local'));
+  await expect(readCourseStorageFile(localPath)).rejects.toThrow('Course storage unavailable');
+  expect(disk).not.toHaveBeenCalled();
+});
+
+it('checks expected SHA after registration lookup, and never treats mismatch as absence', async () => {
+  await expect(courseStorageAsset(sourcePath, 'b'.repeat(64))).rejects.toThrow('Course storage unavailable');
+  expect(fetchMock.mock.calls).toHaveLength(1);
+  expect(fetchMock.mock.calls[0][0].searchParams.has('sha256')).toBe(false);
+});
+
+it.each([
+  () => file(Buffer.alloc(bytes.length, 1)),
+  () => file(bytes, { 'X-Mira-File-Sha256': 'b'.repeat(64) }),
+  () => file(bytes, { 'X-Mira-File-Source': 'local' }),
+  () => file(bytes, { 'Content-Length': String(bytes.length + 1) }),
+  () => new Response('missing', { status: 404 }),
+])('rejects corrupted or unbound registered payloads', async response => {
+  fetchMock.mockImplementation(async (url: URL) => url.pathname.endsWith('/asset')
+    ? Response.json({ ok: true, asset }) : response());
+  const disk = vi.spyOn(fs, 'readFile');
+  await expect(readCourseStorageFile(localPath)).rejects.toThrow('Course storage unavailable');
+  expect(disk).not.toHaveBeenCalled();
+});
+
+it('bounds files before GET and refuses overwriting archived paid ledgers', async () => {
+  const oversized = { ...asset, byteSize: 64 * 1024 * 1024 + 1 };
+  await expect(readCourseStorageAsset(oversized)).rejects.toThrow('Course storage unavailable');
+  expect(fetchMock).not.toHaveBeenCalled();
+  const write = vi.spyOn(fs, 'writeFile');
+  await expect(writeJsonFileAtomic(localPath, { changed: true })).rejects.toThrow('Course storage unavailable');
+  expect(write).not.toHaveBeenCalled();
+  await expect(accessCourseStorageFile(localPath)).resolves.toBeUndefined();
+});
+
+it('rejects unsafe or misbound registry identities and missing auth', async () => {
+  for (const change of [{ sourcePath: 'different' }, { sha256: 'invalid' },
+    { storage: { ...asset.storage, endpoint: 'http://user:secret@host' } },
+    { locator: { ...asset.locator, memberPath: '../secrets' } }]) {
+    fetchMock.mockResolvedValueOnce(Response.json({ ok: true, asset: { ...asset, ...change } }));
+    await expect(courseStorageAsset(sourcePath)).rejects.toThrow('Course storage unavailable');
+  }
+  vi.stubEnv('MIRA_INTERNAL_API_TOKEN', '');
+  await expect(readCourseStorageFile(localPath)).rejects.toThrow('Course storage unavailable');
+});
+
+it('keeps source-code reads local and re-resolves each registered data read', async () => {
+  vi.spyOn(fs, 'readFile').mockResolvedValue(Buffer.from('code'));
+  expect(await readCourseStorageFile(path.join(process.cwd(), 'lib/source.ts'), 'utf8')).toBe('code');
+  expect(fetchMock).not.toHaveBeenCalled();
+  expect(await readCourseStorageFile(localPath)).toEqual(bytes);
+  fetchMock.mockRejectedValue(new Error('private upstream URL'));
+  await expect(readCourseStorageFile(localPath)).rejects.toThrow('Course storage unavailable');
+});
+
+it('reuses a remotely retained TTS receipt before any provider dispatch or local claim', async () => {
+  vi.stubEnv('MIRA_FORMAL_AUDIO_DATA_DIR', '');
+  const text = '十可以分成一个十和零个一。';
+  const input = assertMiraFormalTtsRequest({
+    requestId: 'registry-tts-math-001', classroomId: 'omclass_math_001',
+    classroomContentSha256: '1'.repeat(64), subject: 'math',
+    teacherProfileId: 'mira_math_clear', teacherProfileVersion: 2,
+    teacherProfileSha256: '4f5a986a765f69798c8546d7f9091fe297f2a98c5353fdd01cd1aa06884c98fb',
+    teacherGender: 'male', sceneId: 'scene_00', sceneOrder: 0,
+    actionId: 'speech_00', narrationSegmentId: 'segment_00', text,
+    textSha256: createHash('sha256').update(text).digest('hex'),
+  });
+  const record = { requestId: input.requestId, requestSha256: qualitySha(input), state: 'succeeded' };
+  const payload = Buffer.from(JSON.stringify(record));
+  const receiptSha = createHash('sha256').update(payload).digest('hex');
+  fetchMock.mockImplementation(async (url: URL) => {
+    const source = url.searchParams.get('path');
+    return url.pathname.endsWith('/asset') ? Response.json({ ok: true, asset: {
