diff --git a/lib/server/course-storage-registry.ts b/lib/server/course-storage-registry.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/course-storage-registry.ts
@@ -0,0 +1,190 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import os from 'node:os';
+
+const NATIVE_ROOT = 'openmaic-runtime/.runtime/OpenMAIC/';
+const MAX_FILE_BYTES = 64 * 1024 * 1024;
+const SHA = /^[a-f0-9]{64}$/;
+const TIMEOUT_MS = 30_000;
+
+/** Do not expose upstream URLs, responses, credentials or filesystem errors. */
+export class CourseStorageRegistryError extends Error {
+  constructor() {
+    super('Course storage unavailable');
+    this.name = 'CourseStorageRegistryError';
+  }
+}
+
+function fail(): never { throw new CourseStorageRegistryError(); }
+
+export function courseStorageRegistryEnabled(): boolean {
+  return process.env.COURSE_STORAGE_MODE?.trim() === 'registry';
+}
+
+function safePath(value: unknown): value is string {
+  return typeof value === 'string' && Boolean(value) && !value.includes('\\') &&
+    !/[\u0000-\u001f\u007f]/.test(value) &&
+    value.split('/').every(part => Boolean(part) && part !== '.' && part !== '..');
+}
+
+export interface CourseStorageAsset {
+  sourcePath: string;
+  path: string;
+  sha256: string;
+  byteSize: number;
+  mimeType: string;
+  storage: { endpoint: string; bucket: string; region: string };
+  locator: {
+    kind: 'object' | 'zip_member';
+    objectKey: string;
+    etag: string;
+    versionId?: string;
+    archiveSha256?: string;
+    archiveByteSize?: number;
+    memberPath?: string;
+  };
+}
+
+function validEndpoint(value: unknown): value is string {
+  if (typeof value !== 'string') return false;
+  try {
+    const url = new URL(value);
+    return ['http:', 'https:'].includes(url.protocol) && !url.username && !url.password &&
+      url.pathname === '/' && !url.search && !url.hash;
+  } catch { return false; }
+}
+
+function internalRequest(kind: 'asset' | 'file', sourcePath: string, sha256?: string) {
+  const base = process.env.MIRA_BACKEND_INTERNAL_URL?.trim();
+  const token = process.env.MIRA_INTERNAL_API_TOKEN?.trim();
+  if (!base || !token || !validEndpoint(base) || !safePath(sourcePath) ||
+      (sha256 !== undefined && !SHA.test(sha256))) fail();
+  const url = new URL(`/internal/learning/course-storage/${kind}`, base);
+  url.searchParams.set('path', sourcePath);
+  if (sha256) url.searchParams.set('sha256', sha256);
+  return { url, init: {
+    method: 'GET', headers: { 'X-Mira-Internal-Token': token }, redirect: 'error' as const,
+    cache: 'no-store' as const, signal: AbortSignal.timeout(TIMEOUT_MS),
+  } };
+}
+
+async function boundedBytes(response: Response, maximum: number): Promise<Buffer> {
+  const length = response.headers.get('content-length');
+  if (length !== null && (!/^\d+$/.test(length) || Number(length) > maximum)) {
+    await response.body?.cancel().catch(() => {}); fail();
+  }
+  if (!response.body) fail();
+  const reader = response.body.getReader();
+  const chunks: Buffer[] = [];
+  let count = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      count += value.byteLength;
+      if (count > maximum) fail();
+      chunks.push(Buffer.from(value));
+    }
+    if (length !== null && count !== Number(length)) fail();
+    return Buffer.concat(chunks, count);
+  } catch {
+    await reader.cancel().catch(() => {}); return fail();
+  } finally { reader.releaseLock(); }
+}
+
+/** Always resolve without an expected SHA first: a SHA mismatch is NOT absence. */
+export async function courseStorageAsset(sourcePath: string, expectedSha256?: string): Promise<CourseStorageAsset | undefined> {
+  try {
+    if (expectedSha256 !== undefined && !SHA.test(expectedSha256)) fail();
+    const { url, init } = internalRequest('asset', sourcePath);
+    const response = await fetch(url, init);
+    const result = JSON.parse((await boundedBytes(response, 64 * 1024)).toString('utf8'));
+    if (response.status === 404 && result?.ok === false &&
+        result?.error?.code === 'course_storage_asset_not_found') return undefined;
+    if (!response.ok || result?.ok !== true) fail();
+    const asset = result.asset as CourseStorageAsset;
+    const locator = asset?.locator;
+    if (!asset || asset.sourcePath !== sourcePath || typeof asset.path !== 'string' ||
+        !SHA.test(asset.sha256) || (expectedSha256 && asset.sha256 !== expectedSha256) ||
+        !Number.isSafeInteger(asset.byteSize) || asset.byteSize < 0 ||
+        typeof asset.mimeType !== 'string' || !/^[a-z0-9.+-]+\/[a-z0-9.+-]+$/.test(asset.mimeType) ||
+        !validEndpoint(asset.storage?.endpoint) ||
+        !/^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$/.test(asset.storage?.bucket ?? '') ||
+        asset.storage.bucket.includes('..') || !/^[A-Za-z0-9_-]+$/.test(asset.storage?.region ?? '') ||
+        !locator || !['object', 'zip_member'].includes(locator.kind) || !safePath(locator.objectKey) ||
+        typeof locator.etag !== 'string' || !locator.etag || /[\r\n]/.test(locator.etag) ||
+        (locator.versionId !== undefined && (typeof locator.versionId !== 'string' || !locator.versionId || /[\r\n]/.test(locator.versionId))) ||
+        (locator.kind === 'zip_member' && (!SHA.test(locator.archiveSha256 ?? '') ||
+          !Number.isSafeInteger(locator.archiveByteSize) || locator.archiveByteSize! < 0 || !safePath(locator.memberPath)))) fail();
+    return asset;
+  } catch { return fail(); }
+}
+
+export async function readCourseStorageAsset(asset: CourseStorageAsset): Promise<Buffer> {
+  try {
+    if (asset.byteSize > MAX_FILE_BYTES) fail();
+    const { url, init } = internalRequest('file', asset.sourcePath, asset.sha256);
+    const response = await fetch(url, init);
+    if (!response.ok || response.headers.get('x-mira-file-source') !== 'remote' ||
+        response.headers.get('x-mira-file-sha256') !== asset.sha256) {
+      await response.body?.cancel().catch(() => {}); fail();
+    }
+    const bytes = await boundedBytes(response, asset.byteSize);
+    if (bytes.length !== asset.byteSize || createHash('sha256').update(bytes).digest('hex') !== asset.sha256) fail();
+    return bytes;
+  } catch { return fail(); }
+}
+
+function nativeDataPath(filePath: string): string | undefined {
+  const relative = path.relative(process.cwd(), path.resolve(filePath));
+  return relative.startsWith(`data${path.sep}`) && safePath(relative.split(path.sep).join('/'))
+    ? NATIVE_ROOT + relative.split(path.sep).join('/') : undefined;
+}
+
+export async function registeredCourseStorageFile(filePath: string): Promise<CourseStorageAsset | undefined> {
+  const sourcePath = nativeDataPath(filePath);
+  return courseStorageRegistryEnabled() && sourcePath ? courseStorageAsset(sourcePath) : undefined;
+}
+
+export function readCourseStorageFile(filePath: string): Promise<Buffer>;
+export function readCourseStorageFile(filePath: string, encoding: BufferEncoding): Promise<string>;
+export async function readCourseStorageFile(filePath: string, encoding?: BufferEncoding): Promise<Buffer | string> {
+  const asset = await registeredCourseStorageFile(filePath);
+  const bytes = asset ? await readCourseStorageAsset(asset) : await fs.readFile(filePath);
+  return encoding ? bytes.toString(encoding) : bytes;
+}
+
+export async function accessCourseStorageFile(filePath: string): Promise<void> {
+  if (await registeredCourseStorageFile(filePath)) return;
+  await fs.access(filePath);
+}
+
+export async function realpathCourseStorageFile(filePath: string): Promise<string> {
+  return await registeredCourseStorageFile(filePath) ? path.resolve(filePath) : fs.realpath(filePath);
+}
+
+export async function statCourseStorageFile(filePath: string) {
+  const asset = await registeredCourseStorageFile(filePath);
+  return asset ? { size: asset.byteSize, isFile: () => true, isSymbolicLink: () => false }
+    : fs.lstat(filePath);
+}
+
+/** Tools requiring a filename get only verified bytes in a private, bounded temporary file. */
+export async function withLocalCourseStorageFile<T>(filePath: string, consumer: (local: string) => Promise<T>): Promise<T> {
+  const asset = await registeredCourseStorageFile(filePath);
+  if (!asset) return consumer(filePath);
+  const bytes = await readCourseStorageAsset(asset);
+  const folder = await fs.mkdtemp(path.join(process.env.MIRA_TASK_TMPDIR ?? os.tmpdir(), 'mira-registry-probe-'));
+  const local = path.join(folder, 'asset' + path.extname(filePath));
+  try {
+    await fs.chmod(folder, 0o700);
+    await fs.writeFile(local, bytes, { flag: 'wx', mode: 0o600 });
+    return await consumer(local);
+  } finally { await fs.rm(folder, { recursive: true, force: true }); }
+}
+
+/** Frozen paid ledgers may be replayed, never overwritten from a stale remote read. */
+export async function assertCourseStorageFileWritable(filePath: string): Promise<void> {
+  if (await registeredCourseStorageFile(filePath)) fail();
+}
