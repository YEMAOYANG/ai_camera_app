diff --git a/lib/server/mira-formal-context.ts b/lib/server/mira-formal-context.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-context.ts
@@ -0,0 +1,54 @@
+import { createHash } from 'node:crypto';
+import type { AgentMessage } from '@earendil-works/pi-agent-core';
+
+/** Failed and interrupted searches consumed the same bounded attempt budget. */
+export function formalSearchEventCounts(
+  events: readonly { type: string; data: unknown }[],
+  receiptType: string,
+) {
+  let attempts = 0;
+  let receipts = 0;
+  for (const event of events) {
+    if (event.type === receiptType) receipts++;
+    if (
+      event.type === 'tool_execution_start' &&
+      event.data &&
+      typeof event.data === 'object' &&
+      'toolName' in event.data &&
+      event.data.toolName === 'web_search'
+    )
+      attempts++;
+  }
+  return { attempts, receipts };
+}
+
+/** Preserve failed evidence in storage while omitting an upstream error page
+ * from the model request. This is deterministic projection, not a paid summary;
+ * successful research, skills, course content and user messages remain intact.
+ */
+export function projectFormalErrorContext(messages: AgentMessage[]): AgentMessage[] {
+  return messages.map((message) => {
+    if (message.role !== 'toolResult' || message.isError !== true) return message;
+    let changed = false;
+    const content = message.content.map((part) => {
+      if (part.type !== 'text' || Buffer.byteLength(part.text) <= 2048) return part;
+      const htmlStart = part.text.search(/<!doctype\s+html\b|<html(?:\s|>)/i);
+      if (htmlStart < 0) return part;
+      changed = true;
+      const prefix = part.text.slice(0, htmlStart);
+      const status = prefix.match(/(?:status[=: ]+|error\s*\(|HTTP\s+)([45]\d{2})/i)?.[1];
+      return {
+        ...part,
+        text: [
+          'The tool failed. Its upstream HTML error page is omitted from this model request.',
+          status ? `Original upstream HTTP status: ${status}.` : '',
+          `Original UTF-8 bytes: ${Buffer.byteLength(part.text)}. SHA256: ${createHash('sha256').update(part.text).digest('hex')}.`,
+          'The complete failed response remains in the durable session record. This is not a successful source or research result.',
+        ]
+          .filter(Boolean)
+          .join('\n'),
+      };
+    });
+    return changed ? { ...message, content } : message;
+  });
+}
