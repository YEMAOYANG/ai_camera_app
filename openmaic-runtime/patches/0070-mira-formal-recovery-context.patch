@@ -0,0 +1,87 @@
+import { afterEach, expect, it, vi } from 'vitest';
+import type { AgentMessage } from '@earendil-works/pi-agent-core';
+import {
+  formalSearchEventCounts,
+  projectFormalErrorContext,
+} from '@/lib/server/mira-formal-context';
+import { hasRequiredTeachingBudget, withPaidBudget } from '@/lib/server/mira-paid-budget';
+import { sanitizedWebSearchToolError } from '@/lib/web-search/provider-error';
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.unstubAllEnvs();
+});
+
+it('projects only failed HTML tool output and preserves the durable source unchanged', () => {
+  const html = `Brave Search error (429): <!doctype html><html>${'error page '.repeat(1000)}</html>`;
+  const failed = {
+    role: 'toolResult',
+    toolCallId: 'search-1',
+    toolName: 'web_search',
+    content: [{ type: 'text', text: html }],
+    isError: true,
+    timestamp: 1,
+  } as AgentMessage;
+  const success = { ...failed, isError: false } as AgentMessage;
+  const user = { role: 'user', content: html, timestamp: 1 } as AgentMessage;
+  const history = [failed, success, user];
+  const source = JSON.stringify(history);
+  const projected = projectFormalErrorContext(history);
+  expect(JSON.stringify(history)).toBe(source);
+  expect(projected[1]).toBe(success);
+  expect(projected[2]).toBe(user);
+  expect(JSON.stringify(projected[0])).toContain('HTTP status: 429');
+  expect(JSON.stringify(projected[0])).toContain('SHA256:');
+  expect(JSON.stringify(projected[0])).not.toContain('<html>');
+  expect(JSON.stringify(projected[0]).length).toBeLessThan(800);
+});
+
+it('counts failed and interrupted searches as attempts without doubling success receipts', () => {
+  const events = [
+    { type: 'tool_execution_start', data: { toolName: 'web_search' } },
+    { type: 'tool_execution_end', data: { toolName: 'web_search', isError: true } },
+    { type: 'tool_execution_start', data: { toolName: 'web_search' } },
+    { type: 'tool_execution_start', data: { toolName: 'read' } },
+    { type: 'tool_execution_start', data: { toolName: 'web_search' } },
+    { type: 'research_receipt', data: {} },
+  ];
+  const counts = formalSearchEventCounts(events, 'research_receipt');
+  expect(counts).toEqual({ attempts: 3, receipts: 1 });
+  expect(Math.max(counts.attempts, counts.receipts)).toBe(3);
+});
+
+it('preserves a fixed budget reason through tool sanitization without copying backend details', async () => {
+  vi.stubEnv('MIRA_BACKEND_INTERNAL_URL', 'http://fake-backend.invalid');
+  vi.stubEnv('MIRA_INTERNAL_API_TOKEN', 'test-only');
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(async () =>
+      Response.json(
+        {
+          ok: false,
+          error: 'learning_budget_purpose_day_limit',
+          message: 'sensitive body must never escape',
+        },
+        { status: 429 },
+      ),
+    ),
+  );
+  const work = withPaidBudget(
+    {
+      schemaVersion: 'mira.learning.paid-budget-binding.v1',
+      required: true,
+      authorizationId: 'a'.repeat(64),
+    },
+    'test-only',
+    hasRequiredTeachingBudget,
+  );
+  try {
+    await work;
+    throw new Error('expected admission rejection');
+  } catch (error) {
+    expect(sanitizedWebSearchToolError(error).message).toBe(
+      'MIRA_PAID_BUDGET_CONTEXT_REJECTED_PURPOSE_DAY_LIMIT',
+    );
+  }
+  expect(fetch).toHaveBeenCalledTimes(1);
+});
