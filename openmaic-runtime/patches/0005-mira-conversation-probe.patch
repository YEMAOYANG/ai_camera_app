diff --git a/lib/server/mira-conversation-probe.ts b/lib/server/mira-conversation-probe.ts
new file mode 100644
index 0000000..2f6b05a
--- /dev/null
+++ b/lib/server/mira-conversation-probe.ts
@@ -0,0 +1,46 @@
+export const MIRA_CONVERSATION_PROOF_SCHEMA = 'mira.openmaic.conversation-proof.v1' as const;
+
+export interface MiraConversationProbe {
+  purpose: 'conversation_probe';
+  runtimeSessionId: string;
+  classroomId: string;
+  challenge: string;
+}
+
+const SAFE_ID = /^[A-Za-z0-9_-]{1,255}$/;
+const SAFE_CHALLENGE = /^[A-Za-z0-9_-]{20,128}$/;
+
+export function readMiraConversationProbe(headers: Headers): MiraConversationProbe | null {
+  if (headers.get('x-mira-runtime-purpose') !== 'conversation_probe') return null;
+  const runtimeSessionId = headers.get('x-mira-runtime-session') || '';
+  const classroomId = headers.get('x-mira-runtime-classroom-id') || '';
+  const challenge = headers.get('x-mira-verification-challenge') || '';
+  if (
+    !SAFE_ID.test(runtimeSessionId) ||
+    !SAFE_ID.test(classroomId) ||
+    !SAFE_CHALLENGE.test(challenge)
+  ) {
+    throw new Error('Invalid Mira conversation probe attestation');
+  }
+  return {
+    purpose: 'conversation_probe',
+    runtimeSessionId,
+    classroomId,
+    challenge,
+  };
+}
+
+export function conversationProbeReceipt(
+  probe: MiraConversationProbe,
+  route: 'text-chat' | 'transcription',
+) {
+  return {
+    schemaVersion: MIRA_CONVERSATION_PROOF_SCHEMA,
+    challenge: probe.challenge,
+    runtimeSessionId: probe.runtimeSessionId,
+    classroomId: probe.classroomId,
+    route,
+    authenticated: true,
+    providerCall: false,
+  } as const;
+}
