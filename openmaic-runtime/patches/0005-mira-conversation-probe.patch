@@ -0,0 +1,132 @@
+import { NextRequest } from 'next/server';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({
+  resolveModel: vi.fn(),
+  statelessGenerate: vi.fn(),
+  transcribeAudio: vi.fn(),
+  resolveASRApiKey: vi.fn(),
+  resolveASRBaseUrl: vi.fn(),
+}));
+
+vi.mock('@/lib/server/resolve-model', () => ({ resolveModel: mocks.resolveModel }));
+vi.mock('@/lib/orchestration/stateless-generate', () => ({
+  statelessGenerate: mocks.statelessGenerate,
+}));
+vi.mock('@/lib/audio/asr-providers', () => ({ transcribeAudio: mocks.transcribeAudio }));
+vi.mock('@/lib/server/provider-config', () => ({
+  getServerASRProviders: () => ({ 'qwen-asr': {} }),
+  isServerConfiguredProvider: () => true,
+  resolveASRApiKey: mocks.resolveASRApiKey,
+  resolveASRBaseUrl: mocks.resolveASRBaseUrl,
+}));
+
+const challenge = 'ompc_abcdefghijklmnopqrstuvwxyz012345';
+const probeHeaders = {
+  'x-mira-runtime-purpose': 'conversation_probe',
+  'x-mira-runtime-session': 'probe-session-a',
+  'x-mira-runtime-classroom-id': 'classroom-a',
+  'x-mira-verification-challenge': challenge,
+};
+
+describe('authenticated conversation probe fast paths', () => {
+  beforeEach(() => {
+    process.env.MIRA_OPENMAIC_REQUIRE_QWEN_ASR = '1';
+    process.env.MIRA_OPENMAIC_QWEN_ASR_MODEL = 'qwen3-asr-flash';
+    for (const mock of Object.values(mocks)) mock.mockReset();
+  });
+
+  afterEach(() => {
+    delete process.env.MIRA_OPENMAIC_REQUIRE_QWEN_ASR;
+    delete process.env.MIRA_OPENMAIC_QWEN_ASR_MODEL;
+  });
+
+  it('returns a session/classroom-bound chat SSE receipt without resolving or calling a model', async () => {
+    const { POST } = await import('@/app/api/chat/route');
+    const response = await POST(
+      new NextRequest('http://localhost/api/chat', {
+        method: 'POST',
+        headers: { ...probeHeaders, 'content-type': 'application/json' },
+        body: JSON.stringify({ stageId: 'classroom-a' }),
+      }),
+    );
+    const stream = await response.text();
+
+    expect(response.status).toBe(200);
+    expect(response.headers.get('content-type')).toContain('text/event-stream');
+    expect(stream).toContain('event: mira-verification');
+    const data = JSON.parse(stream.match(/^data: (.+)$/m)?.[1] || '{}');
+    expect(data).toEqual({
+      schemaVersion: 'mira.openmaic.conversation-proof.v1',
+      challenge,
+      runtimeSessionId: 'probe-session-a',
+      classroomId: 'classroom-a',
+      route: 'text-chat',
+      authenticated: true,
+      providerCall: false,
+    });
+    expect(mocks.resolveModel).not.toHaveBeenCalled();
+    expect(mocks.statelessGenerate).not.toHaveBeenCalled();
+  });
+
+  it('attests the server-owned Qwen policy from multipart without credentials or ASR calls', async () => {
+    const form = new FormData();
+    form.set('audio', new File(['silent-audio'], 'probe.webm', { type: 'audio/webm' }));
+    form.set('language', 'zh');
+    const { POST } = await import('@/app/api/transcription/route');
+    const response = await POST(
+      new NextRequest('http://localhost/api/transcription', {
+        method: 'POST',
+        headers: probeHeaders,
+        body: form,
+      }),
+    );
+    const body = await response.json();
+
+    expect(response.status).toBe(200);
+    expect(body.proof).toEqual({
+      schemaVersion: 'mira.openmaic.conversation-proof.v1',
+      challenge,
+      runtimeSessionId: 'probe-session-a',
+      classroomId: 'classroom-a',
+      route: 'transcription',
+      authenticated: true,
+      providerCall: false,
+      credentialSource: 'server',
+      asrPolicy: {
+        enforced: true,
+        providerId: 'qwen-asr',
+        modelId: 'qwen3-asr-flash',
+        fallbackAllowed: false,
+      },
+    });
+    expect(mocks.resolveASRApiKey).not.toHaveBeenCalled();
+    expect(mocks.resolveASRBaseUrl).not.toHaveBeenCalled();
+    expect(mocks.transcribeAudio).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    ['providerId', 'browser-native'],
+    ['modelId', 'attacker-model'],
+    ['apiKey', 'attacker-key'],
+    ['baseUrl', 'https://attacker.invalid'],
+  ])('rejects probe client override %s without touching ASR', async (field, value) => {
+    const form = new FormData();
+    form.set('audio', new File(['silent-audio'], 'probe.webm', { type: 'audio/webm' }));
+    form.set(field, value);
+    const { POST } = await import('@/app/api/transcription/route');
+    const response = await POST(
+      new NextRequest('http://localhost/api/transcription', {
+        method: 'POST',
+        headers: probeHeaders,
+        body: form,
+      }),
+    );
+    const body = await response.json();
+
+    expect(response.status).toBe(400);
+    expect(body.errorCode).toBe('INVALID_REQUEST');
+    expect(body.error).toBe('Mira runtime ASR provider configuration is server-owned');
+    expect(mocks.transcribeAudio).not.toHaveBeenCalled();
+  });
+});
