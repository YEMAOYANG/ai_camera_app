diff --git a/lib/server/mira-formal-question-narration.ts b/lib/server/mira-formal-question-narration.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-question-narration.ts
@@ -0,0 +1,161 @@
+import { createHash } from 'node:crypto';
+import { mkdir, lstat, open, readFile, realpath } from 'node:fs/promises';
+import { join, resolve, sep } from 'node:path';
+import type { Scene, Stage } from '@/lib/types/stage';
+import type { LearningSceneContract } from '@openmaic/generation';
+import { buildLifecycleSegments, miraFormalAudioClassroomContentSha256,
+  type MiraFormalAudioLifecycleReceipt } from './mira-formal-audio-lifecycle';
+import { readMiraFormalTtsAsset } from './mira-formal-audio';
+import { CLASSROOMS_DIR, isValidClassroomId } from './classroom-storage';
+import { qualitySha } from './mira-formal-quality-contract';
+
+const START = '\nMIRA_FORMAL_QUESTION_NARRATION_CONTEXT:\n';
+const END = '\nEND_MIRA_FORMAL_QUESTION_NARRATION_CONTEXT\n';
+const SCHEMA = 'mira.learning.question-narration-binding.v1' as const;
+const sha = (value: string | Uint8Array) => createHash('sha256').update(value).digest('hex');
+const fail = (reason: string): never => { throw new Error(`FORMAL_QUESTION_NARRATION_${reason}`); };
+export interface FormalQuestionNarrationContext { buildItemId: string; subject: 'chinese' | 'math' | 'english' }
+function assertContext(context: FormalQuestionNarrationContext): void {
+  if (!context || Object.keys(context).sort().join(',') !== 'buildItemId,subject'
+    || !/^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/.test(context.buildItemId)
+    || !['chinese', 'math', 'english'].includes(context.subject)) fail('CONTEXT_INVALID');
+}
+export function withFormalQuestionNarrationContext(prompt: string, context: FormalQuestionNarrationContext | undefined): string {
+  if (!context) return prompt;
+  assertContext(context);
+  return prompt + START + JSON.stringify(context) + END;
+}
+export function formalQuestionNarrationContextFromPrompt(prompt: string): FormalQuestionNarrationContext | undefined {
+  const parts = prompt.split(START);
+  if (parts.length === 1) return undefined;
+  if (parts.length !== 2 || parts[1].split(END).length !== 2) fail('CONTEXT_INVALID');
+  let context: FormalQuestionNarrationContext;
+  try { context = JSON.parse(parts[1].split(END)[0]); } catch { fail('CONTEXT_INVALID'); }
+  assertContext(context!);
+  return context!;
+}
+
+/** Before QA and audio hashing: bind stable, deterministic future asset paths.
+ * No audio is claimed available until materializeFormalNarration verifies its
+ * real TTS/ASR receipt and bytes. Text, values and scoring authority stay intact.
+ */
+export function prepareFormalQuestionNarration(stage: Stage, scenes: Scene[],
+  context: FormalQuestionNarrationContext | undefined, contract: LearningSceneContract | undefined): Scene[] {
+  if (!context || !contract) return scenes;
+  assertContext(context);
+  if (!isValidClassroomId(stage.id)) fail('CLASSROOM_INVALID');
+  const { segments } = buildLifecycleSegments({ ...context, stage, scenes });
+  const byAction = new Map(segments.map(segment => [segment.sceneId + '\0' + segment.actionId, segment]));
+  return scenes.map(scene => {
+    const actions = (scene.actions ?? []).map(action => {
+      if (action.type !== 'speech') return action;
+      const segment = byAction.get(scene.id + '\0' + action.id);
+      if (!segment) return fail('SPEECH_SEGMENT_MISSING');
+      const audioUrl = `/api/classroom-media/${stage.id}/audio/${segment.ttsRequestId}.wav`;
+      if ((action.audioUrl && action.audioUrl !== audioUrl)
+        || (action.audioId && action.audioId !== segment.ttsRequestId)) fail('AUTHORED_AUDIO_REFERENCE_FORBIDDEN');
+      return { ...action, audioId: segment.ttsRequestId, audioUrl };
+    });
+    if (scene.content.type !== 'quiz') return { ...scene, actions } as Scene;
+    const questions = scene.content.questions.map(question => {
+      const matches = actions.filter(action => action.type === 'speech' && action.text.trim() === question.question.trim());
+      if (matches.length !== 1) fail(matches.length ? 'QUESTION_SPEECH_AMBIGUOUS' : 'QUESTION_SPEECH_MISSING');
+      const action = matches[0];
+      const segment = byAction.get(scene.id + '\0' + action.id)!;
+      const questionAudioUrl = `/api/classroom-media/${stage.id}/audio/${segment.ttsRequestId}.wav`;
+      const questionAudioBinding = { schemaVersion: SCHEMA, sceneId: scene.id, actionId: action.id,
+        ttsRequestId: segment.ttsRequestId, sourceTextSha256: sha(question.question.trim()) };
+      if (segment.sourceTextSha256 !== questionAudioBinding.sourceTextSha256
+        || (question.questionAudioUrl && question.questionAudioUrl !== questionAudioUrl)
+        || (question.questionAudioBinding && JSON.stringify(question.questionAudioBinding) !== JSON.stringify(questionAudioBinding))) fail('QUESTION_BINDING_MISMATCH');
+      return { ...question, questionAudioUrl, questionAudioBinding };
+    });
+    return { ...scene, actions, content: { ...scene.content, questions } } as Scene;
+  });
+}
+
+export interface FormalNarrationMaterializationReceipt {
+  schemaVersion: 'mira.learning.saved-narration-assets.v1';
+  classroomId: string;
+  classroomContentSha256: string;
+  status: 'verified';
+  questionCount: number;
+  assets: { sceneId: string; actionId: string; ttsRequestId: string; audioUrl: string; audioSha256: string; sizeBytes: number }[];
+  receiptSha256: string;
+}
+async function writeSavedAsset(classroomId: string, filename: string, bytes: Uint8Array): Promise<void> {
+  if (!isValidClassroomId(classroomId) || !/^formal_tts_[a-f0-9]{48}\.wav$/.test(filename)) fail('ASSET_PATH_INVALID');
+  await mkdir(CLASSROOMS_DIR, { recursive: true });
+  const base = await realpath(CLASSROOMS_DIR);
+  const directory = join(base, classroomId, 'audio');
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  const actual = await realpath(directory);
+  if (actual !== resolve(directory) || !actual.startsWith(base + sep)) fail('ASSET_PATH_INVALID');
+  const path = join(actual, filename);
+  try {
+    const fd = await open(path, 'wx', 0o600);
+    try { await fd.writeFile(bytes); await fd.sync(); } finally { await fd.close(); }
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+    const info = await lstat(path);
+    if (!info.isFile() || info.isSymbolicLink() || sha(await readFile(path)) !== sha(bytes)) fail('EXISTING_ASSET_CONFLICT');
+  }
+}
+
+/** Reuse saved Qwen results only. This function never invokes a provider. */
+export async function materializeFormalNarration(stage: Stage, scenes: Scene[],
+  formalAudio: MiraFormalAudioLifecycleReceipt,
+  deps: { readAsset?: typeof readMiraFormalTtsAsset; writeAsset?: typeof writeSavedAsset } = {},
+): Promise<FormalNarrationMaterializationReceipt> {
+  const expectedHash = miraFormalAudioClassroomContentSha256(stage, scenes);
+  if (formalAudio.status !== 'succeeded' || formalAudio.classroomId !== stage.id
+    || formalAudio.classroomContentSha256 !== expectedHash
+    || formalAudio.expectedSegmentCount !== formalAudio.segments.length
+    || formalAudio.ttsSucceededCount !== formalAudio.segments.length
+    || formalAudio.asrPassedCount !== formalAudio.segments.length) fail('LIFECYCLE_MISMATCH');
+  const assets: FormalNarrationMaterializationReceipt['assets'] = [];
+  const planned = new Map<string, { scene: Scene; action: NonNullable<Scene['actions']>[number] }>();
+  for (const scene of scenes) for (const action of scene.actions ?? []) if (action.type === 'speech') planned.set(scene.id + '\0' + action.id, { scene, action });
+  if (planned.size !== formalAudio.segments.length) fail('SEGMENT_COVERAGE_MISMATCH');
+  const readAsset = deps.readAsset ?? readMiraFormalTtsAsset;
+  const writeAsset = deps.writeAsset ?? writeSavedAsset;
+  for (const segment of formalAudio.segments) {
+    const item = planned.get(segment.sceneId + '\0' + segment.actionId);
+    if (!item) return fail('SEGMENT_MISMATCH');
+    const action = item.action;
+    if (action.type !== 'speech') return fail('SEGMENT_MISMATCH');
+    if (sha(action.text.trim()) !== segment.sourceTextSha256
+      || segment.tts.state !== 'succeeded' || segment.asr.state !== 'succeeded'
+      || segment.tts.providerId !== 'qwen-tts' || segment.tts.modelId !== 'qwen3-tts-flash'
+      || segment.asr.providerId !== 'qwen-asr' || segment.asr.fallbackUsed !== false
+      || segment.asr.similarityBps < 8500 || segment.tts.fallbackUsed !== false) fail('SEGMENT_MISMATCH');
+    planned.delete(segment.sceneId + '\0' + segment.actionId);
+    const audioUrl = `/api/classroom-media/${stage.id}/audio/${segment.tts.requestId}.wav`;
+    if (action.audioUrl !== audioUrl || action.audioId !== segment.tts.requestId) fail('AUDIO_REFERENCE_MISMATCH');
+    const saved = await readAsset(segment.tts.requestId);
+    if (saved.record.state !== 'succeeded' || saved.record.classroomId !== stage.id
+      || saved.record.classroomContentSha256 !== expectedHash || saved.record.sceneId !== segment.sceneId
+      || saved.record.actionId !== segment.actionId || saved.record.requestId !== segment.tts.requestId
+      || saved.record.requestSha256 !== segment.tts.requestSha256
+      || saved.record.textSha256 !== segment.textSha256 || saved.record.voiceId !== segment.tts.voiceId
+      || saved.record.fallbackUsed !== false
+      || saved.record.audioSha256 !== segment.tts.audioSha256 || sha(saved.bytes) !== segment.tts.audioSha256
+      || saved.bytes.byteLength !== segment.tts.sizeBytes || saved.record.sizeBytes !== segment.tts.sizeBytes
+      || saved.record.mimeType !== 'audio/wav') fail('SAVED_ASSET_MISMATCH');
+    await writeAsset(stage.id, `${segment.tts.requestId}.wav`, saved.bytes);
+    assets.push({ sceneId: segment.sceneId, actionId: segment.actionId, ttsRequestId: segment.tts.requestId,
+      audioUrl, audioSha256: segment.tts.audioSha256, sizeBytes: segment.tts.sizeBytes });
+  }
+  let questionCount = 0;
+  for (const scene of scenes) if (scene.content.type === 'quiz') for (const question of scene.content.questions) {
+    const binding = question.questionAudioBinding;
+    const asset = assets.find(row => row.sceneId === scene.id && row.actionId === binding?.actionId);
+    if (!binding || binding.schemaVersion !== SCHEMA || binding.sceneId !== scene.id
+      || binding.sourceTextSha256 !== sha(question.question.trim()) || !asset
+      || binding.ttsRequestId !== asset.ttsRequestId || question.questionAudioUrl !== asset.audioUrl) fail('QUESTION_ASSET_UNVERIFIED');
+    questionCount++;
+  }
+  const receipt = { schemaVersion: 'mira.learning.saved-narration-assets.v1' as const, classroomId: stage.id,
+    classroomContentSha256: expectedHash, status: 'verified' as const, questionCount, assets };
+  return { ...receipt, receiptSha256: qualitySha(receipt) };
+}
