+import { createHash } from 'node:crypto';
+import type { Scene } from '@/lib/types/stage';
+import { describe, expect, it, vi } from 'vitest';
+import { buildLifecycleSegments, miraFormalAudioClassroomContentSha256 } from '@/lib/server/mira-formal-audio-lifecycle';
+import { qualitySha, qualitySnapshot } from '@/lib/server/mira-formal-quality-contract';
+import { formalQuestionNarrationContextFromPrompt, materializeFormalNarration,
+  prepareFormalQuestionNarration, withFormalQuestionNarrationContext } from '@/lib/server/mira-formal-question-narration';
+
+const context = { buildItemId: 'new-flash-isolated-build', subject: 'math' as const };
+const contract = { schemaVersion: 'mira.learning.scene-contract.v1' as const,
+  gradeCode: 'primary_1', subject: 'math', maximumQuantity: 5, pictureChoicesRequired: true, noMasteryClaims: true };
+const stage = { id: 'new_flash_isolated_class', name: '数一数', createdAt: 'frozen', updatedAt: 'frozen' } as any;
+const sha = (value: Uint8Array | string) => createHash('sha256').update(value).digest('hex');
+function source() {
+  return [{ id: 'scene_1', stageId: stage.id, order: 0, title: '看图选一选', type: 'quiz',
+    content: { type: 'quiz', questions: [
+      { id: 'locked-q1', type: 'single', question: '点一点有三个圆的图片。', hasAnswer: false, answer: [],
+        options: [{ value: 'A', label: '2' }, { value: 'B', label: '3' }],
+        visual: { kind: 'quantity', count: 3 }, optionVisuals: { A: { kind: 'quantity', count: 2 }, B: { kind: 'quantity', count: 3 } } },
+      { id: 'locked-q2', type: 'single', question: '这一次，点有四个圆的图片。', hasAnswer: false, answer: [],
+        options: [{ value: 'C', label: '4' }, { value: 'D', label: '5' }],
+        visual: { kind: 'quantity', count: 4 }, optionVisuals: { C: { kind: 'quantity', count: 4 }, D: { kind: 'quantity', count: 5 } } },
+    ] }, actions: [
+      { id: 'speech_1', type: 'speech', text: '点一点有三个圆的图片。' },
+      { id: 'speech_2', type: 'speech', text: '这一次，点有四个圆的图片。' },
+    ] }] as any;
+}
+function question(scene: Scene, index = 0) {
+  if (scene.content.type !== 'quiz') throw new Error('fixture must be quiz');
+  return scene.content.questions[index];
+}
+function speech(scene: Scene, index = 0) {
+  const action = scene.actions?.[index];
+  if (!action || action.type !== 'speech') throw new Error('fixture must have speech');
+  return action;
+}
+function audioFixture(scenes: any[]) {
+  const segments = buildLifecycleSegments({ ...context, stage, scenes }).segments;
+  const hash = miraFormalAudioClassroomContentSha256(stage, scenes);
+  const saved = new Map();
+  const completed = segments.map((segment, index) => {
+    const bytes = new Uint8Array([82, 73, 70, 70, index, 87, 65, 86, 69]);
+    const audioSha256 = sha(bytes);
+    const tts = { requestId: segment.ttsRequestId, requestSha256: sha('request' + index), state: 'succeeded',
+      providerId: 'qwen-tts', modelId: 'qwen3-tts-flash', voiceId: 'Serena', fallbackUsed: false,
+      audioSha256, sizeBytes: bytes.length };
+    saved.set(tts.requestId, { bytes, record: { ...tts, classroomId: stage.id, classroomContentSha256: hash,
+      sceneId: segment.sceneId, actionId: segment.actionId, textSha256: segment.textSha256, mimeType: 'audio/wav' } });
+    return { ...segment, tts, asr: { requestId: segment.asrRequestId, state: 'succeeded',
+      providerId: 'qwen-asr', modelId: 'qwen3-asr-flash', similarityBps: 10000, fallbackUsed: false } };
+  });
+  const receipt = { status: 'succeeded', classroomId: stage.id, classroomContentSha256: hash,
+    expectedSegmentCount: segments.length, ttsSucceededCount: segments.length, asrPassedCount: segments.length, segments: completed } as any;
+  const readAsset = vi.fn(async (id: string) => saved.get(id));
+  const writeAsset = vi.fn(async (_classroomId: string, _filename: string, _bytes: Uint8Array) => {});
+  return { saved, receipt, readAsset, writeAsset };
+}
+describe('saved per-question Qwen narration', () => {
+  it('leaves historical scenes and prompts byte-identical', () => {
+    const scenes = source();
+    expect(prepareFormalQuestionNarration(stage, scenes, undefined, undefined)).toBe(scenes);
+    expect(withFormalQuestionNarrationContext('old', undefined)).toBe('old');
+    expect(formalQuestionNarrationContextFromPrompt('old')).toBeUndefined();
+  });
+  it('freezes the exact native context and rejects duplicate/tampered context', () => {
+    const prompt = withFormalQuestionNarrationContext('new', context);
+    expect(formalQuestionNarrationContextFromPrompt(prompt)).toEqual(context);
+    expect(() => formalQuestionNarrationContextFromPrompt(prompt + prompt)).toThrow('CONTEXT_INVALID');
+  });
+  it('binds same-scene same-text speech without touching locked questions or answers', () => {
+    const original = source(); const before = JSON.stringify(original);
+    const bound = prepareFormalQuestionNarration(stage, original, context, contract);
+    expect(JSON.stringify(original)).toBe(before);
+    const item = question(bound[0]);
+    expect(item.id).toBe('locked-q1'); expect(item.options).toEqual(original[0].content.questions[0].options);
+    expect(item.answer).toEqual([]); expect(item.hasAnswer).toBe(false);
+    expect(item.questionAudioBinding!.actionId).toBe('speech_1');
+    expect(item.questionAudioBinding!.sourceTextSha256).toBe(sha(item.question));
+    expect(item.questionAudioUrl).toBe(speech(bound[0]).audioUrl);
+    expect(prepareFormalQuestionNarration(stage, bound, context, contract)).toEqual(bound);
+  });
+  it('includes question URLs/binding and all speech URLs in the audio source hash before TTS', () => {
+    const raw = source(), bound = prepareFormalQuestionNarration(stage, raw, context, contract);
+    expect(miraFormalAudioClassroomContentSha256(stage, bound)).not.toBe(miraFormalAudioClassroomContentSha256(stage, raw));
+    const changed = structuredClone(bound); speech(changed[0]).audioUrl += '?changed';
+    expect(miraFormalAudioClassroomContentSha256(stage, changed)).not.toBe(miraFormalAudioClassroomContentSha256(stage, bound));
+    const edited = structuredClone(bound); question(edited[0]).questionAudioUrl += '?changed';
+    expect(qualitySha(qualitySnapshot(stage, edited))).not.toBe(qualitySha(qualitySnapshot(stage, bound)));
+  });
+  it.each(['missing', 'changed-text', 'duplicate', 'foreign-url'])('rejects %s narration before any paid completion call', reason => {
+    const scenes = source();
+    if (reason === 'missing') scenes[0].actions.shift();
+    if (reason === 'changed-text') scenes[0].actions[0].text += '请选择答案B。';
+    if (reason === 'duplicate') scenes[0].actions.push({ ...scenes[0].actions[0], id: 'another_speech' });
+    if (reason === 'foreign-url') scenes[0].actions[0].audioUrl = 'https://example.test/invented.wav';
+    expect(() => prepareFormalQuestionNarration(stage, scenes, context, contract)).toThrow('FORMAL_QUESTION_NARRATION_');
+  });
+  it('copies already-saved validated bytes and keeps source hash stable; no synthesis dependency', async () => {
+    const scenes = prepareFormalQuestionNarration(stage, source(), context, contract);
+    const fixture = audioFixture(scenes), before = miraFormalAudioClassroomContentSha256(stage, scenes);
+    const result = await materializeFormalNarration(stage, scenes, fixture.receipt, fixture as any);
+    expect(result.questionCount).toBe(2); expect(result.status).toBe('verified');
+    expect(fixture.readAsset).toHaveBeenCalledTimes(2); expect(fixture.writeAsset).toHaveBeenCalledTimes(2);
+    expect(result.assets[0].audioUrl).toBe(question(scenes[0]).questionAudioUrl);
+    expect(fixture.writeAsset.mock.calls[0][0]).toBe(stage.id);
+    expect(miraFormalAudioClassroomContentSha256(stage, scenes)).toBe(before);
+  });
+  it.each(['wrong-bytes', 'foreign-classroom', 'bad-asr', 'edited-question', 'missing-segment'])('rejects %s without exposing an unverified audio file', async reason => {
+    const scenes = prepareFormalQuestionNarration(stage, source(), context, contract);
+    const fixture = audioFixture(scenes);
+    if (reason === 'wrong-bytes') fixture.saved.get(fixture.receipt.segments[0].tts.requestId).bytes = new Uint8Array([1, 2]);
+    if (reason === 'foreign-classroom') fixture.saved.get(fixture.receipt.segments[0].tts.requestId).record.classroomId = 'other_class';
+    if (reason === 'bad-asr') fixture.receipt.segments[0].asr.similarityBps = 100;
+    if (reason === 'edited-question') question(scenes[0]).question += '修改了';
+    if (reason === 'missing-segment') fixture.receipt.segments.pop();
+    await expect(materializeFormalNarration(stage, scenes, fixture.receipt, fixture as any)).rejects.toThrow('FORMAL_QUESTION_NARRATION_');
+    expect(fixture.writeAsset).not.toHaveBeenCalled();
+  });
+});
