+/** Keep cancellation attached while a non-streaming SDK call consumes an SSE body. */
+async function readAutoRouterChatStream(response: Response, signal?: AbortSignal | null): Promise<string> {
+  signal?.throwIfAborted();
+  if (!response.body) throw new Error('AUTOROUTER_SSE_INCOMPLETE: missing response body');
+  const reader = response.body.getReader();
+  const decoder = new TextDecoder('utf-8', { fatal: true });
+  let text = '';
+  let ended = false;
+  const cancel = () => { void reader.cancel(signal?.reason).catch(() => undefined); };
+  signal?.addEventListener('abort', cancel, { once: true });
+  try {
+    signal?.throwIfAborted();
+    while (true) {
+      const chunk = await reader.read();
+      signal?.throwIfAborted();
+      if (chunk.done) { ended = true; break; }
+      text += decoder.decode(chunk.value, { stream: true });
+    }
+    return text + decoder.decode();
+  } finally {
+    signal?.removeEventListener('abort', cancel);
+    if (!ended) cancel();
+    reader.releaseLock();
+  }
+}
+
+function autoRouterChatEvents(raw: string): string[] {
+  const events: string[] = [];
+  let data: string[] = [];
+  for (const line of raw.split(/\r\n|\r|\n/)) {
+    if (line === '') {
+      if (data.length) events.push(data.join('\n'));
+      data = [];
+    } else if (line === 'data' || line.startsWith('data:')) {
+      data.push(line === 'data' ? '' : line.slice(5).replace(/^ /, ''));
+    }
+  }
+  // A final event without its blank separator still has to pass the full terminal checks.
+  if (data.length) events.push(data.join('\n'));
+  return events;
+}
