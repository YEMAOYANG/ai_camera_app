diff --git a/lib/server/agent-runtime/driver-output-cap.ts b/lib/server/agent-runtime/driver-output-cap.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/agent-runtime/driver-output-cap.ts
@@ -0,0 +1,29 @@
+/** Optional operator cap for the parent driver only, not a model capacity. */
+export const AGENT_DRIVER_OUTPUT_CAP_MAX = 2_147_483_647;
+
+export function parseAgentDriverOutputCap(value: string | undefined): number | undefined {
+  if (value === undefined || value === '') return undefined;
+  const parsed = Number(value);
+  if (!/^[1-9][0-9]{0,9}$/.test(value)
+    || !Number.isSafeInteger(parsed)
+    || parsed > AGENT_DRIVER_OUTPUT_CAP_MAX) {
+    throw new Error(
+      'OPENMAIC_AGENT_DRIVER_MAX_OUTPUT_TOKENS must be empty or an integer from 1 through 2147483647.',
+    );
+  }
+  return parsed;
+}
+
+/** Apply after existing formal allowances so an operator can only lower them. */
+export function capAgentDriverOutput<T extends {
+  maxOutputTokens?: number;
+  omitMaxOutputTokens?: boolean;
+}>(options: T, configuredCap: number | undefined): T {
+  if (configuredCap === undefined) return options;
+  return {
+    ...options,
+    maxOutputTokens: Math.min(options.maxOutputTokens ?? configuredCap, configuredCap),
+    // An unknown catalog limit still permits an explicit operator wire cap.
+    omitMaxOutputTokens: false,
+  };
+}
diff --git a/tests/agent-runtime/driver-output-cap.test.ts b/tests/agent-runtime/driver-output-cap.test.ts
