+import { createHash } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import * as skills from '@/lib/server/agent-runtime/skills';
+import {
+  prepareMiraFormalRepairSkillContext,
+  MIRA_FORMAL_REPAIR_SKILL_MAX_BYTES,
+} from '@/lib/server/mira-formal-repair-skills';
+import type { Scene } from '@/lib/types/stage';
+vi.mock('@/lib/server/agent-runtime/user-skills', async (importActual) => ({
+  ...(await importActual<typeof import('@/lib/server/agent-runtime/user-skills')>()),
+  listUserSkills: vi.fn(async () => []),
+}));
+afterEach(() => vi.restoreAllMocks());
+const scenes = [
+  { id: 'slide', type: 'slide' },
+  { id: 'interactive', type: 'interactive' },
+] as Scene[];
+const issue = (sceneId: string) => [
+  { sceneId, problem: 'Repair the visible page', repair: 'Update the page' },
+];
+describe('automatic repair-phase Skill reads', () => {
+  it('delivers full real manuals and byte hashes for an affected slide, not just Skill names', async () => {
+    const result = await prepareMiraFormalRepairSkillContext('unit-owner', scenes, issue('slide'));
+    expect(result.reads.map((entry) => entry.skillId)).toEqual([
+      'pro-editing',
+      'stage-dsl',
+      'slide-dsl',
+    ]);
+    for (const entry of result.reads) {
+      expect(entry.body).toBe(await readFile(entry.filePath, 'utf8'));
+      expect(entry.sourceHash).toBe(createHash('sha256').update(entry.body, 'utf8').digest('hex'));
+      expect(entry.resourcePath).toBe(`${entry.skillId}/SKILL.md`);
+    }
+  });
+  it('reads stage repair manuals for a non-slide issue and includes slide-dsl for a global issue', async () => {
+    expect(
+      (
+        await prepareMiraFormalRepairSkillContext('unit-owner', scenes, issue('interactive'))
+      ).reads.map((entry) => entry.skillId),
+    ).toEqual(['pro-editing', 'stage-dsl']);
+    expect(
+      (await prepareMiraFormalRepairSkillContext('unit-owner', scenes, issue(''))).reads.map(
+        (entry) => entry.skillId,
+      ),
+    ).toContain('slide-dsl');
+  });
+  it('rejects missing manuals, owner-authored replacements and unbound issues', async () => {
+    const installed = await skills.listSkills();
+    vi.spyOn(skills, 'listSkills').mockResolvedValue(
+      installed.map((entry) =>
+        entry.id === 'pro-editing' ? { ...entry, source: 'user' as const } : entry,
+      ),
+    );
+    await expect(
+      prepareMiraFormalRepairSkillContext('unit-owner', scenes, issue('slide')),
+    ).rejects.toThrow('FORMAL_REPAIR_SKILL_MISSING:pro-editing');
+    await expect(
+      prepareMiraFormalRepairSkillContext('unit-owner', scenes, issue('other-course')),
+    ).rejects.toThrow('FORMAL_REPAIR_SKILL_ISSUES_INVALID');
+  });
+  it('fails rather than truncating required source text to a misleading read receipt', async () => {
+    vi.spyOn(skills, 'readSkillFileText').mockResolvedValue(
+      '中'.repeat(MIRA_FORMAL_REPAIR_SKILL_MAX_BYTES),
+    );
+    await expect(
+      prepareMiraFormalRepairSkillContext('unit-owner', scenes, issue('slide')),
+    ).rejects.toThrow('FORMAL_REPAIR_SKILL_BODY_INVALID');
+  });
+});
