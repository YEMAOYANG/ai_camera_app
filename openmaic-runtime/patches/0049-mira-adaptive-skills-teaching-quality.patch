+      input.origin === MIRA_ADAPTIVE_SKILL_SESSION_ORIGIN)
+  );
+}
+
+export function isMiraFormalAdaptiveSkillSession(input: {
+  ownerId: string;
+  sessionId: string;
+  skillId?: string | null;
+  origin?: string | null;
+}): boolean {
+  return (
+    isMiraFormalProfessionalSessionIdentity(input) &&
+    input.origin === MIRA_ADAPTIVE_SKILL_SESSION_ORIGIN
   );
 }
 
