+    expect(isMiraFormalAdaptiveSkillSession(session)).toBe(true);
+    expect(isMiraFormalImageSession(session)).toBe(true);
+    expect(isMiraFormalAdaptiveSkillSession({ ...session, ownerId: 'anonymous' })).toBe(false);
+  });
+});
