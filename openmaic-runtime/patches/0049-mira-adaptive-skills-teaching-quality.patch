+import type { Scene, Stage } from '@/lib/types/stage';
+
+export interface FormalInspectionViewport {
+  width: number;
+  height: number;
+}
+/** CSS locators and local form actions only; no script, network, or file operations. */
+export interface FormalInteractionProbe {
+  id: string;
+  action: 'click' | 'fill' | 'range' | 'select';
+  selector: string;
+  value?: string;
+  expect: {
+    selector: string;
+    textIncludes?: string;
+    valueEquals?: string;
+    checked?: boolean;
+    changed?: boolean;
+  };
+}
+
+export interface FormalSceneInspectionInput {
+  scene: Scene;
+  stage: Stage;
+  scenes: readonly Scene[];
+  sceneIndex: number;
+  ownerId: string;
+  sessionId: string;
+  snapshotSha256: string;
+  viewport?: FormalInspectionViewport;
+  probes?: readonly FormalInteractionProbe[];
+}
+
+export interface FormalPreviewSnapshot {
+  schemaVersion: 1;
+  expiresAt: number;
+  ownerId: string;
+  sessionId: string;
+  stage: Stage;
+  scene: Scene;
+  sceneIndex: number;
+  snapshotSha256: string;
+  sceneSha256: string;
+  actualSourceSha256: string;
+  viewport: FormalInspectionViewport;
+}
+
+export interface FormalInspectionMetrics {
+  width: number;
+  height: number;
+  horizontalOverflow: number;
+  verticalOverflow: number;
+  textOverflow: string[];
+  outsideCanvas: string[];
+  failedImages: string[];
+  controls: Array<{ selector: string; tag: string; type: string; text: string }>;
+}
+
+export interface FormalSceneInspectionResult {
+  sceneId: string;
+  sceneSha256: string;
+  viewport: FormalInspectionViewport;
+  screenshotSha256: string;
+  domSha256: string;
+  passed: boolean;
+  probeCount: number;
+  issues: string[];
+  visibleText: string;
+  metrics: FormalInspectionMetrics;
+  probeResults: Array<{ id: string; passed: boolean; message: string }>;
+  /** Explicit scope: screenshots are evidence, not a claim of model vision. */
+  coverage:
+    | 'slide'
+    | 'interactive-local-controls'
+    | 'quiz-local-answering'
+    | 'pbl-local-navigation';
+}
