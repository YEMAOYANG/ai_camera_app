@@ -0,0 +1,170 @@
+import { mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+  acquireFormalQualityLock,
+  type QualityLockDeps,
+} from '@/lib/server/mira-formal-quality-lock';
+const pg = vi.hoisted(() => ({ query: vi.fn(), release: vi.fn(), connect: vi.fn() }));
+vi.mock('@/lib/persistence/server-provider', () => ({
+  getServerPersistenceProvider: async () => ({ pool: { connect: pg.connect } }),
+}));
+const owner = { pid: 123, hostname: 'test-host', startIdentity: 'instance-new' };
+const old = {
+  schemaVersion: 1,
+  pid: 456,
+  hostname: 'test-host',
+  startIdentity: 'instance-old',
+  token: 'a'.repeat(64),
+};
+let directory: string;
+let path: string;
+function deps(): QualityLockDeps {
+  let held = false;
+  return {
+    identity: async () => owner,
+    probe: vi.fn(async () => ({ state: 'running', startIdentity: 'instance-old' }) as const),
+    withMutex: async <T>(_key: string, work: () => Promise<T>) => {
+      if (held) throw new Error('FORMAL_QUALITY_REVIEW_BUSY');
+      held = true;
+      try {
+        return await work();
+      } finally {
+        held = false;
+      }
+    },
+  };
+}
+beforeEach(async () => {
+  directory = await mkdtemp(join(tmpdir(), 'quality-lock-'));
+  path = join(directory, 'review.lock');
+  vi.clearAllMocks();
+  pg.query.mockResolvedValue({ rows: [{ acquired: true }] });
+  pg.connect.mockResolvedValue({ query: pg.query, release: pg.release });
+});
+afterEach(async () => {
+  vi.unstubAllEnvs();
+  await rm(directory, { recursive: true, force: true });
+});
+async function seed(value: unknown = old) {
+  await writeFile(path, JSON.stringify(value));
+}
+
+describe('crash-safe formal review file lock acquisition', () => {
+  it('creates complete private owner metadata atomically and releases only its token', async () => {
+    const lease = await acquireFormalQualityLock(path, deps());
+    const metadata = JSON.parse(await readFile(path, 'utf8'));
+    expect(metadata).toMatchObject({ ...owner, schemaVersion: 1 });
+    expect(metadata.token).toMatch(/^[a-f0-9]{64}$/);
+    expect(await readdir(directory)).toEqual(['review.lock']);
+    await lease.release();
+    expect(await readdir(directory)).toEqual([]);
+  });
+  it('never recovers a live process lock based on age or retries', async () => {
+    await seed();
+    const settings = deps();
+    await expect(acquireFormalQualityLock(path, settings)).rejects.toThrow('REVIEW_BUSY');
+    expect(JSON.parse(await readFile(path, 'utf8'))).toEqual(old);
+  });
+  it.each(['exited', 'reused'] as const)(
+    'recovers a positively verified %s owner and preserves the dispatch ledger',
+    async (state) => {
+      await seed();
+      const ledger = '[{"snapshotSha256":"persisted","status":"started"}]';
+      await writeFile(join(directory, 'attempts.json'), ledger);
+      const settings = deps();
+      settings.probe = vi.fn<NonNullable<QualityLockDeps['probe']>>(async () =>
+        state === 'exited'
+          ? { state: 'exited' }
+          : { state: 'running', startIdentity: 'different-instance' },
+      );
+      const lease = await acquireFormalQualityLock(path, settings);
+      const metadata = JSON.parse(await readFile(path, 'utf8'));
+      expect(metadata.token).not.toBe(old.token);
+      expect(await readFile(join(directory, 'attempts.json'), 'utf8')).toBe(ledger);
+      await lease.release();
+    },
+  );
+  it('fails closed for another host, unavailable process proof, or legacy incomplete metadata', async () => {
+    const settings = deps();
+    await seed({ ...old, hostname: 'other-host' });
+    await expect(acquireFormalQualityLock(path, settings)).rejects.toThrow('UNVERIFIABLE');
+    expect(settings.probe).not.toHaveBeenCalled();
+    await seed();
+    settings.probe = async () => null;
+    await expect(acquireFormalQualityLock(path, settings)).rejects.toThrow('UNVERIFIABLE');
+    expect(JSON.parse(await readFile(path, 'utf8'))).toEqual(old);
+    await writeFile(path, '');
+    await expect(acquireFormalQualityLock(path, settings)).rejects.toThrow('UNVERIFIABLE');
+    expect(await readFile(path, 'utf8')).toBe('');
+  });
+  it('admits only one concurrent recoverer and never deletes its replacement lock', async () => {
+    await seed();
+    const settings = deps();
+    let completeProbe!: () => void;
+    let startedProbe!: () => void;
+    const started = new Promise<void>((done) => {
+      startedProbe = done;
+    });
+    settings.probe = async () => {
+      startedProbe();
+      await new Promise<void>((done) => {
+        completeProbe = done;
+      });
+      return { state: 'exited' };
+    };
+    const first = acquireFormalQualityLock(path, settings);
+    await started;
+    await expect(acquireFormalQualityLock(path, settings)).rejects.toThrow('REVIEW_BUSY');
+    completeProbe();
+    const lease = await first;
+    const replacement = await readFile(path, 'utf8');
+    settings.probe = async () => ({ state: 'running', startIdentity: owner.startIdentity });
+    await expect(acquireFormalQualityLock(path, settings)).rejects.toThrow('REVIEW_BUSY');
+    expect(await readFile(path, 'utf8')).toBe(replacement);
+    await lease.release();
+  });
+  it('does not let a superseded release remove a new owner token', async () => {
+    const settings = deps();
+    const staleLease = await acquireFormalQualityLock(path, settings);
+    settings.probe = async () => ({ state: 'exited' });
+    const newLease = await acquireFormalQualityLock(path, settings);
+    const replacement = await readFile(path, 'utf8');
+    await expect(staleLease.release()).rejects.toThrow('OWNER_CHANGED');
+    expect(await readFile(path, 'utf8')).toBe(replacement);
+    await newLease.release();
+  });
+  it('does not abandon a live-owner file when Postgres commit fails after atomic creation', async () => {
+    vi.stubEnv('DATABASE_URL', 'postgresql://mock-only');
+    pg.query.mockImplementation(async (query: string) => {
+      if (query === 'COMMIT') throw new Error('connection lost at commit');
+      return { rows: [{ acquired: true }] };
+    });
+    await expect(acquireFormalQualityLock(path, { identity: async () => owner })).rejects.toThrow(
+      'connection lost at commit',
+    );
+    expect(await readdir(directory)).toEqual([]);
+    expect(pg.release).toHaveBeenCalledOnce();
+  });
+
+  it('uses a nonblocking short Postgres transaction and returns the connection before review work', async () => {
+    vi.stubEnv('DATABASE_URL', 'postgresql://mock-only');
+    const lease = await acquireFormalQualityLock(path, { identity: async () => owner });
+    expect(pg.query.mock.calls.map(([query]) => query)).toEqual([
+      'BEGIN',
+      'SELECT pg_try_advisory_xact_lock(hashtextextended($1, 0)) AS acquired',
+      'COMMIT',
+    ]);
+    expect(pg.release).toHaveBeenCalledOnce();
+    await lease.release();
+    expect(pg.connect).toHaveBeenCalledTimes(2);
+    expect(pg.release).toHaveBeenCalledTimes(2);
+    pg.query.mockResolvedValue({ rows: [{ acquired: false }] });
+    await expect(acquireFormalQualityLock(path, { identity: async () => owner })).rejects.toThrow(
+      'REVIEW_BUSY',
+    );
+    expect(await readdir(directory)).toEqual([]);
+    expect(pg.query.mock.calls.at(-1)![0]).toBe('ROLLBACK');
+  });
+});
