+    !['gradeCode', 'subject', 'skillId'].every((key) => course[key] === boundary[key]) ||
+    !text(course.objective) ||
+    !text(teach.sayText) ||
+    !textList(teach.keyPoints, true) ||
+    !Array.isArray(lesson.questions) ||
+    lesson.questions.length !== 5 ||
+    !lesson.questions.every((question) => text(record(question).prompt))
