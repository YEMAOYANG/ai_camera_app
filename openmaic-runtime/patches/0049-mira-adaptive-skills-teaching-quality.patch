diff --git a/lib/server/mira-formal-inspection-network.ts b/lib/server/mira-formal-inspection-network.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-inspection-network.ts
@@ -0,0 +1,136 @@
+const STATIC_EXT = /\.(?:js|mjs|css|woff2?|ttf|otf|png|jpe?g|webp|gif|svg|ico)$/i;
+const LIBRARIES = '(?:katex|three|d3|echarts|chart\\.js|gsap|mathjax|@tailwindcss/browser)';
+const CDN_NPM_PATH = new RegExp(`^/(?:npm/)?${LIBRARIES}@\\d[0-9A-Za-z.+_-]*(?:/[^?#]*)?$`);
+const CDNJS_PATH = new RegExp(`^/ajax/libs/${LIBRARIES}/\\d[0-9A-Za-z.+_-]*/[^?#]+$`);
+// These exact assets are declared by @openmaic/renderer/fonts.css. They are
+// browser font reads only, never a general allowance for the MAIC file host.
+const RENDERER_FONT_URLS = new Set(
+  [
+    'SourceHanSans',
+    'SourceHanSerif',
+    'LXGWWenKai',
+    'ZhuQueFangSong',
+    'WenDingPLKaiTi',
+    'ZcoolHappy',
+  ].map((name) => `https://file.maic.chat/fonts/${name}.woff2`),
+);
+
+/** Only static reads. All fetch/XHR/beacon/WebSocket and unknown origins are denied. */
+export function isFormalInspectionRequestAllowed(input: {
+  url: string;
+  method: string;
+  resourceType: string;
+  baseOrigin: string;
+  previewUrl: string;
+  stageId: string;
+}): boolean {
+  let url: URL;
+  try {
+    url = new URL(input.url);
+  } catch {
+    return false;
+  }
+  if (
+    input.method !== 'GET' ||
+    ['xhr', 'fetch', 'eventsource', 'websocket'].includes(input.resourceType)
+  )
+    return false;
+  if (url.username || url.password) return false;
+  if (input.resourceType === 'font' && RENDERER_FONT_URLS.has(url.href)) return true;
+  if (url.href === input.previewUrl) return input.resourceType === 'document';
+  if (url.protocol === 'data:' || url.protocol === 'blob:')
+    return input.resourceType !== 'document';
+  if (url.origin === input.baseOrigin) {
+    if (url.pathname.startsWith('/_next/static/')) return STATIC_EXT.test(url.pathname);
+    if (/^\/(?:fonts|images|avatars|icons|video-export)\//.test(url.pathname))
+      return STATIC_EXT.test(url.pathname) && !url.search;
+    if (url.pathname === '/favicon.ico' || url.pathname === '/mira-classroom-icon.svg') return true;
+    if (url.pathname === '/_next/image') {
+      const target = url.searchParams.get('url') ?? '';
+      const width = url.searchParams.get('w') ?? '';
+      const quality = url.searchParams.get('q') ?? '';
+      const keys = [...url.searchParams.keys()];
+      return (
+        input.resourceType === 'image' &&
+        (target === '/openmaic-mark.png' ||
+          /^\/(?:images|avatars|icons)\/[A-Za-z0-9_./-]+$/.test(target)) &&
+        !target.includes('..') &&
+        STATIC_EXT.test(target) &&
+        keys.length === 3 &&
+        ['url', 'w', 'q'].every((key) => url.searchParams.getAll(key).length === 1) &&
+        /^[1-9]\d{0,3}$/.test(width) &&
+        Number(width) <= 4096 &&
+        /^[1-9]\d{0,2}$/.test(quality) &&
+        Number(quality) <= 100
+      );
+    }
+    return (
+      url.pathname.startsWith(`/api/classroom-media/${input.stageId}/media/`) &&
+      /^\/api\/classroom-media\/[A-Za-z0-9_-]+\/media\/[A-Za-z0-9_-]+\.(?:png|jpe?g|webp|gif)$/i.test(
+        url.pathname,
+      ) &&
+      !url.search
+    );
+  }
+  if (
+    url.protocol !== 'https:' ||
+    url.port ||
+    url.search ||
+    !STATIC_EXT.test(url.pathname) ||
+    !['script', 'stylesheet', 'font', 'image'].includes(input.resourceType)
+  )
+    return false;
+  return (
+    ((url.hostname === 'cdn.jsdelivr.net' || url.hostname === 'unpkg.com') &&
+      CDN_NPM_PATH.test(url.pathname)) ||
+    (url.hostname === 'cdnjs.cloudflare.com' && CDNJS_PATH.test(url.pathname))
+  );
+}
+
+/** Srcdoc frames inherit this response policy. This is the enforcement layer
+ * even on Chrome versions whose opaque child targets bypass Playwright routes. */
+export function formalInspectionContentSecurityPolicy(input: {
+  baseOrigin: string;
+  stageId: string;
+  scene: unknown;
+}) {
+  const prefixes = new Set<string>();
+  for (const match of JSON.stringify(input.scene).matchAll(
+    /https:\/\/(?:cdn\.jsdelivr\.net|unpkg\.com|cdnjs\.cloudflare\.com)\/[^\s\\"'<>]+/g,
+  )) {
+    const url = new URL(match[0]);
+    if (
+      !isFormalInspectionRequestAllowed({
+        url: url.href,
+        method: 'GET',
+        resourceType: 'script',
+        baseOrigin: input.baseOrigin,
+        previewUrl: '',
+        stageId: input.stageId,
+      })
+    )
+      continue;
+    const matchPrefix =
+      url.hostname === 'cdnjs.cloudflare.com'
+        ? url.pathname.match(/^\/ajax\/libs\/[^/]+\/[^/]+\//)
+        : url.pathname.match(/^\/(?:npm\/)?(?:@[^/]+\/)?[^/]+@[^/]+\//);
+    if (matchPrefix) prefixes.add(`${url.origin}${matchPrefix[0]}`);
+  }
+  const cdn = [...prefixes].sort().join(' ');
+  const base = input.baseOrigin;
+  return [
+    "default-src 'none'",
+    "connect-src 'none'",
+    "form-action 'none'",
+    "worker-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    'sandbox allow-scripts allow-same-origin allow-forms',
+    `script-src 'unsafe-inline' ${base}/_next/static/ ${cdn}`,
+    `style-src 'unsafe-inline' ${base}/_next/static/ ${cdn}`,
+    `font-src data: ${base}/_next/static/ ${base}/fonts/ ${[...RENDERER_FONT_URLS].join(' ')} ${cdn}`,
+    `img-src data: blob: ${base}/api/classroom-media/${input.stageId}/media/ ${base}/images/ ${base}/avatars/ ${base}/icons/ ${base}/_next/image ${base}/mira-classroom-icon.svg ${cdn}`,
+    `frame-src 'self' data: blob:`,
+    "media-src 'none'",
+  ].join('; ');
+}
