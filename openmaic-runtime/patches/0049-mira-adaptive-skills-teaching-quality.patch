--- /dev/null
+++ b/lib/server/mira-formal-teaching-quality.ts
@@ -0,0 +1,269 @@
+import { mkdir, open, readFile, rename } from 'node:fs/promises';
+import { resolve, join } from 'node:path';
+import { Type } from 'typebox';
+import type { AgentTool } from '@earendil-works/pi-agent-core';
+import type { CourseStore } from './agent-runtime/course-tools';
+import type { Scene, Stage } from '@/lib/types/stage';
+import {
+  MIRA_TEACHING_QUALITY_POLICY, QUALITY_DIMENSIONS, QUALITY_VIEWPORTS,
+  qualityCanonical, qualitySha, qualitySceneText, qualitySnapshot, qualityReviewIdentity,
+  type MiraTeachingQualityReceipt, type QualityDimension, type QualityObjective,
+  type QualityRenderCheck,
+} from './mira-formal-quality-contract';
+import { executeMiraCoursewareProvider, MIRA_COURSEWARE_PROVIDER_SCHEMA } from './mira-courseware-provider';
+import { inspectFormalScene } from './mira-formal-scene-inspector';
+import { prepareMiraFormalRepairSkillContext } from './mira-formal-repair-skills';
+import { acquireFormalQualityLock, type QualityLockDeps } from './mira-formal-quality-lock';
+import {
+  FORMAL_QUALITY_REVIEW_SYSTEM, FORMAL_QUALITY_REVIEW_SCHEMA, FORMAL_QUALITY_REVIEW_PROMPT_VERSION,
+} from '@/lib/prompts/mira-formal-quality.v1';
+
+type JsonRecord = Record<string, unknown>;
+const object = (value: unknown): value is JsonRecord =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+const SHA = /^[0-9a-f]{64}$/;
+export interface FormalQualityContext {
+  gradeBoundary: JsonRecord;
+  selectionPlan: { planSha256: string } & JsonRecord;
+  teachingBrief: JsonRecord;
+}
+export interface FormalQualityInput extends FormalQualityContext {
+  stage: Stage; scenes: Scene[]; ownerId: string; sessionId: string;
+}
+export interface FormalQualityResult {
+  status: 'passed' | 'needs_revision'; snapshotSha256: string;
+  issues: Array<{ sceneId: string; problem: string; repair: string }>;
+  receipt?: MiraTeachingQualityReceipt;
+}
+interface ReviewReport {
+  status: 'passed' | 'needs_revision'; dimensions: QualityDimension[];
+  objectives: QualityObjective[]; issues: FormalQualityResult['issues'];
+}
+
+export function parseFormalQualityReview(raw: unknown, input: FormalQualityInput): ReviewReport {
+  if (!object(raw) || Object.keys(raw).sort().join(',') !== 'dimensions,issues,objectives,status'
+      || !['passed', 'needs_revision'].includes(String(raw.status)) || !Array.isArray(raw.dimensions)
+      || !Array.isArray(raw.objectives) || !Array.isArray(raw.issues)) throw new Error('FORMAL_QUALITY_REVIEW_INVALID');
+  const snapshot = qualitySnapshot(input.stage, input.scenes);
+  const texts = new Map(snapshot.scenes.map((scene) => [scene.id, qualitySceneText(scene)]));
+  const validEvidence = (value: unknown, required: boolean) => Array.isArray(value)
+    && (!required || value.length > 0) && value.length <= 30 && value.every((item) => object(item)
+      && Object.keys(item).sort().join(',') === 'quote,sceneId' && typeof item.sceneId === 'string'
+      && typeof item.quote === 'string' && item.quote.length >= 3 && item.quote.length <= 1000
+      && texts.get(item.sceneId)?.includes(item.quote));
+  const passing = raw.status === 'passed';
+  if (raw.dimensions.length !== QUALITY_DIMENSIONS.length
+      || new Set(raw.dimensions.map((item) => object(item) ? item.id : null)).size !== QUALITY_DIMENSIONS.length
+      || raw.dimensions.some((item) => !object(item)
+        || Object.keys(item).sort().join(',') !== 'evidence,id,passed'
+        || !QUALITY_DIMENSIONS.includes(item.id as typeof QUALITY_DIMENSIONS[number])
+        || typeof item.passed !== 'boolean' || (passing && !item.passed)
+        || !validEvidence(item.evidence, passing || item.passed))) throw new Error('FORMAL_QUALITY_DIMENSIONS_INVALID');
+  const objectives = input.gradeBoundary.learningObjectives;
+  if (!Array.isArray(objectives) || !objectives.length || raw.objectives.length !== objectives.length
+      || new Set(raw.objectives.map((item) => object(item) ? item.objectiveIndex : null)).size !== objectives.length
+      || raw.objectives.some((item) => !object(item)
+        || Object.keys(item).sort().join(',') !== 'evidence,objectiveIndex'
+        || !Number.isInteger(item.objectiveIndex) || Number(item.objectiveIndex) < 0
+        || Number(item.objectiveIndex) >= objectives.length || !validEvidence(item.evidence, passing)))
+    throw new Error('FORMAL_QUALITY_OBJECTIVES_INVALID');
+  if ((passing && raw.issues.length !== 0) || (!passing && raw.issues.length === 0)
+      || raw.issues.length > 60 || raw.issues.some((item) => !object(item)
+        || Object.keys(item).sort().join(',') !== 'problem,repair,sceneId'
+        || typeof item.sceneId !== 'string' || (item.sceneId !== '' && !texts.has(item.sceneId))
+        || typeof item.problem !== 'string' || !item.problem.trim() || item.problem.length > 2000
+        || typeof item.repair !== 'string' || !item.repair.trim() || item.repair.length > 2000))
+    throw new Error('FORMAL_QUALITY_ISSUES_INVALID');
+  return raw as unknown as ReviewReport;
+}
+
+async function save(path: string, value: unknown) {
+  const temporary = `${path}.${process.pid}.tmp`;
+  const file = await open(temporary, 'w', 0o600);
+  try { await file.writeFile(JSON.stringify(value, null, 2)); await file.sync(); }
+  finally { await file.close(); }
+  await rename(temporary, path);
+}
+
+async function readJson(path: string): Promise<unknown | undefined> {
+  try { return JSON.parse(await readFile(path, 'utf8')); }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined; throw error; }
+}
+
+export interface QualityReviewDeps {
+  inspect?: typeof inspectFormalScene;
+  provider?: typeof executeMiraCoursewareProvider;
+  cacheRoot?: string;
+  lockDeps?: QualityLockDeps;
+}
+
+/** Three durable attempts per formal session. An unchanged snapshot reuses its
+ * result; resuming cannot silently spend another review call. */
+export async function reviewFormalCourse(
+  input: FormalQualityInput, signal?: AbortSignal, deps: QualityReviewDeps = {},
+): Promise<FormalQualityResult> {
+  if (signal?.aborted) throw new Error('FORMAL_QUALITY_ABORTED');
+  const snapshot = qualitySnapshot(input.stage, input.scenes);
+  const snapshotSha256 = qualitySha(snapshot);
+  const gradeBoundarySha256 = qualitySha(input.gradeBoundary);
+  const teachingBriefSha256 = qualitySha(input.teachingBrief);
+  const selectionPlanSha256 = input.selectionPlan.planSha256;
+  if (!SHA.test(selectionPlanSha256)) throw new Error('FORMAL_QUALITY_SELECTION_INVALID');
+  const identity = { ownerId: input.ownerId, sessionId: input.sessionId, stageId: input.stage.id,
+    gradeBoundarySha256, teachingBriefSha256, selectionPlanSha256 };
+  const folder = join(resolve(deps.cacheRoot ?? 'data/formal-quality-reviews'), qualitySha(identity));
+  await mkdir(folder, { recursive: true, mode: 0o700 });
+  const resultPath = join(folder, `${snapshotSha256}.json`);
+  const cached = await readJson(resultPath);
+  if (cached !== undefined && (!object(cached) || cached.snapshotSha256 !== snapshotSha256
+      || !Array.isArray(cached.issues))) throw new Error('FORMAL_QUALITY_CACHE_CORRUPT');
+  if (object(cached) && cached.snapshotSha256 === snapshotSha256) {
+    if (cached.status === 'passed') {
+      if (!object(cached.receipt) || cached.receipt.snapshotSha256 !== snapshotSha256
+          || cached.receipt.gradeBoundarySha256 !== gradeBoundarySha256
+          || cached.receipt.selectionPlanSha256 !== selectionPlanSha256
+          || cached.receipt.teachingBriefSha256 !== teachingBriefSha256
+          || cached.receipt.sessionId !== input.sessionId || cached.receipt.stageId !== input.stage.id)
+        throw new Error('FORMAL_QUALITY_CACHE_CORRUPT');
+      const { receiptSha256, ...unsigned } = cached.receipt;
+      if (qualitySha(unsigned) !== receiptSha256) throw new Error('FORMAL_QUALITY_CACHE_CORRUPT');
+    }
+    if (!['passed', 'needs_revision'].includes(String(cached.status))) throw new Error('FORMAL_QUALITY_CACHE_CORRUPT');
+    return cached as unknown as FormalQualityResult;
+  }
+  const lockPath = join(folder, 'review.lock');
+  const lock = await acquireFormalQualityLock(lockPath, deps.lockDeps);
+  try {
+    const ledgerPath = join(folder, 'attempts.json');
+    const previous = await readJson(ledgerPath);
+    const attempts = previous === undefined ? [] : previous;
+    if (!Array.isArray(attempts)) throw new Error('FORMAL_QUALITY_LEDGER_INVALID');
+    if (attempts.some((item) => object(item) && item.snapshotSha256 === snapshotSha256))
+      throw new Error('FORMAL_QUALITY_PRIOR_ATTEMPT_UNRESOLVED');
+    if (attempts.length >= MIRA_TEACHING_QUALITY_POLICY.maxReviewAttempts)
+      throw new Error('FORMAL_QUALITY_REPAIR_BUDGET_EXHAUSTED');
+    const attempt = { snapshotSha256, status: 'started', startedAt: Date.now() };
+    attempts.push(attempt);
+    await save(ledgerPath, attempts);
+    await save(join(folder, `${snapshotSha256}-input.json`), { ...identity, snapshot,
+      gradeBoundary: input.gradeBoundary, selectionPlan: input.selectionPlan, teachingBrief: input.teachingBrief });
+    try {
+      const issues: FormalQualityResult['issues'] = [];
+      const renderChecks: QualityRenderCheck[] = [];
+      const observations: unknown[] = [];
+      const scenes = [...input.scenes].sort((a, b) => a.order - b.order);
+      for (const [sceneIndex, scene] of scenes.entries()) {
+        for (const viewport of QUALITY_VIEWPORTS) {
+          if (signal?.aborted) throw new Error('FORMAL_QUALITY_ABORTED');
+          const observed = await (deps.inspect ?? inspectFormalScene)({
+            scene, scenes, sceneIndex, stage: input.stage, ownerId: input.ownerId,
+            sessionId: input.sessionId, snapshotSha256, viewport,
+          }, signal);
+          observations.push(observed);
+          const sceneSha256 = qualitySha(snapshot.scenes[sceneIndex]);
+          if (observed.sceneId !== scene.id || observed.sceneSha256 !== sceneSha256
+              || observed.viewport.width !== viewport.width || observed.viewport.height !== viewport.height)
+            throw new Error('FORMAL_QUALITY_RENDER_IDENTITY_MISMATCH');
+          if (!observed.passed || !SHA.test(observed.screenshotSha256) || !SHA.test(observed.domSha256)
+              || (scene.type === 'interactive' && observed.probeCount < 1)) {
+            issues.push({ sceneId: scene.id,
+              problem: `Browser check ${viewport.width}x${viewport.height}: ${observed.issues.join('; ') || 'missing render or interaction evidence'}`.slice(0, 2000),
+              repair: 'Repair the actual page content/control/feedback and rerun review_course_quality; preserve the locked assessments.' });
+          } else renderChecks.push({ sceneId: scene.id, sceneSha256, viewport: { ...viewport },
+            screenshotSha256: observed.screenshotSha256, domSha256: observed.domSha256,
+            passed: true, probeCount: observed.probeCount });
+        }
+      }
+      await save(join(folder, `${snapshotSha256}-browser.json`), observations);
+      let result: FormalQualityResult;
+      if (issues.length) result = { status: 'needs_revision', snapshotSha256, issues };
+      else {
+        const reviewIdentity = { snapshotSha256, gradeBoundarySha256, selectionPlanSha256,
+          teachingBriefSha256, renderChecks };
+        const userPrompt = JSON.stringify(qualityCanonical({
+          promptVersion: FORMAL_QUALITY_REVIEW_PROMPT_VERSION,
+          gradeBoundary: input.gradeBoundary, teachingBrief: input.teachingBrief,
+          selectionPlan: input.selectionPlan, snapshot, browserChecks: renderChecks,
+          browserObservations: observations.map((value) => object(value) ? {
+            sceneId: value.sceneId, viewport: value.viewport, visibleText: value.visibleText,
+            probeResults: value.probeResults, metrics: value.metrics,
+          } : value),
+        }));
+        if (userPrompt.length > 200_000) throw new Error('FORMAL_QUALITY_REVIEW_INPUT_TOO_LARGE');
+        const response = await (deps.provider ?? executeMiraCoursewareProvider)({
+          schemaVersion: MIRA_COURSEWARE_PROVIDER_SCHEMA,
+          requestId: `quality-${qualitySha({ ...identity, snapshotSha256 })}`,
+          phase: attempts.length === 1 ? 'independent_verification' : 'verification_after_repair',
+          systemPrompt: FORMAL_QUALITY_REVIEW_SYSTEM, userPrompt,
+          responseJsonSchema: FORMAL_QUALITY_REVIEW_SCHEMA,
+        }, signal);
+        // Preserve the actual response and usage before parsing; an invalid report
+        // is a failed attempt, never a fabricated pass or an invisible retry.
+        await save(join(folder, `${snapshotSha256}-provider.json`), response);
+        if (signal?.aborted) throw new Error('FORMAL_QUALITY_ABORTED');
+        const report = parseFormalQualityReview(JSON.parse(response.content), input);
+        if (report.status !== 'passed') result = { status: 'needs_revision', snapshotSha256, issues: report.issues };
+        else {
+          const unsigned = {
+            schemaVersion: 'mira.openmaic.teaching-quality-receipt.v1' as const,
+            policyId: MIRA_TEACHING_QUALITY_POLICY.policyId, status: 'passed' as const,
+            sessionId: input.sessionId, stageId: input.stage.id, gradeBoundarySha256,
+            selectionPlanSha256, teachingBriefSha256, snapshotSha256,
+            sceneHashes: snapshot.scenes.map((scene) => ({ sceneId: scene.id, sceneSha256: qualitySha(scene) })),
+            renderChecks,
+            review: { providerId: 'deepseek' as const, modelId: 'deepseek-v4-flash' as const,
+              requestIdHash: response.providerRequestIdHash, inputSha256: qualityReviewIdentity(reviewIdentity),
+              dimensions: report.dimensions, objectives: report.objectives },
+          };
+          if (!SHA.test(response.providerRequestIdHash)) throw new Error('FORMAL_QUALITY_PROVIDER_RECEIPT_INVALID');
+          result = { status: 'passed', snapshotSha256, issues: [],
+            receipt: { ...unsigned, receiptSha256: qualitySha(unsigned) } };
+        }
+      }
+      attempt.status = result.status;
+      await save(resultPath, result);
+      await save(ledgerPath, attempts);
+      return result;
+    } catch (error) {
+      attempt.status = 'failed';
+      await save(ledgerPath, attempts);
+      throw error;
+    }
+  } finally { await lock.release(); }
+}
+
+export function buildFormalQualityTools(deps: {
+  store: CourseStore; stageAccess: (id: string) => Promise<{ kind: string }>;
+  ownerId: string; sessionId: string; context: FormalQualityContext; abortSignal?: AbortSignal;
+}): AgentTool<never, never>[] {
+  const params = Type.Object({ stageId: Type.String() });
+  return [{
+    name: 'review_course_quality', label: 'Review teaching and page quality',
+    executionMode: 'sequential',
+    description: 'Required before finishing this formal course. Actually render every page at two viewports, exercise local interactions and independently review grade fit and teaching. Repair reported pages using Pro edit tools, then rerun. At most three distinct snapshots can be reviewed.',
+    parameters: params,
+    async execute(_id, input, signal) {
+      if ((await deps.stageAccess(input.stageId)).kind !== 'owned') throw new Error('FORMAL_QUALITY_STAGE_NOT_OWNED');
+      const doc = await deps.store.loadDocument(input.stageId);
+      if (!doc || (doc.outline as { producerRef?: string } | undefined)?.producerRef !== deps.sessionId)
+        throw new Error('FORMAL_QUALITY_PRODUCER_MISMATCH');
+      const sourceSha256 = qualitySha(qualitySnapshot(doc.stage, doc.scenes));
+      const { prepareMiraFormalQualitySnapshot } = await import('./mira-formal-professional-classroom');
+      const normalized = await prepareMiraFormalQualitySnapshot({ stage: doc.stage as Stage,
+        scenes: doc.scenes, ownerId: deps.ownerId, sessionId: deps.sessionId });
+      const result = await reviewFormalCourse({ ...deps.context, ...normalized,
+        ownerId: deps.ownerId, sessionId: deps.sessionId }, signal ?? deps.abortSignal);
+      const latest = await deps.store.loadDocument(input.stageId);
+      if (!latest || qualitySha(qualitySnapshot(latest.stage, latest.scenes)) !== sourceSha256)
+        throw new Error('FORMAL_QUALITY_DOCUMENT_CHANGED_DURING_REVIEW');
+      return { content: [{ type: 'text' as const, text: JSON.stringify({ status: result.status,
+        snapshotSha256: result.snapshotSha256, issues: result.issues,
+        receiptSha256: result.receipt?.receiptSha256,
+        ...(result.status === 'needs_revision' ? {
+          repairContext: await prepareMiraFormalRepairSkillContext(deps.ownerId, doc.scenes, result.issues),
+        } : {}),
+      }) }],
+      details: { stageId: input.stageId, status: result.status }, isError: result.status !== 'passed' };
+    },
+  } as AgentTool<typeof params>] as unknown as AgentTool<never, never>[];
+}
