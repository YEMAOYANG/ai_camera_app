+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Scene, Stage } from '@/lib/types/stage';
+import { prepareMiraFormalQualitySnapshot } from '@/lib/server/mira-formal-professional-classroom';
+import { MIRA_ADAPTIVE_SKILL_SESSION_ORIGIN } from '@/lib/server/mira-formal-skill-selection';
+import {
+  MIRA_FORMAL_RESEARCH_SEARCH_EVENT_TYPE,
+  MIRA_FORMAL_RESEARCH_SEARCH_TRACE_SCHEMA_VERSION,
+} from '@/lib/server/mira-professional-research-policy';
+import { qualitySnapshot } from '@/lib/server/mira-formal-quality-contract';
+
+const mocks = vi.hoisted(() => ({ session: vi.fn(), events: vi.fn() }));
+vi.mock('@/lib/server/agent-runtime/store', () => ({
+  getAgentSessionStore: async () => ({ getSession: mocks.session, readEventsAfter: mocks.events }),
+}));
+vi.mock('@/lib/server/agent-runtime/session-materials', () => ({
+  listSessionMaterials: async () => [
+    {
+      kind: 'web',
+      sourceUrl: 'https://example.org/source',
+      textAssetId: 'source',
+      title: 'source',
+    },
+  ],
+  resolveSessionMaterialText: async () => 'Actual fetched source body from the test store.',
+}));
+const sessionId = `miraformal_${'a'.repeat(64)}`;
+const ownerId = `mira-formal-professional:${'b'.repeat(64)}`;
+const locked = Array.from({ length: 4 }, (_, i) => ({
+  id: `q${i}`,
+  type: 'single',
+  question: `第${i + 1}题`,
+  options: [
+    { value: 'a', label: '一个' },
+    { value: 'b', label: '两个' },
+  ],
+  answer: [],
+  hasAnswer: false,
+  points: 1,
+}));
+function input() {
+  const quiz = (id: string, order: number, questions: unknown[]) => ({
+    id,
+    order,
+    type: 'quiz',
+    title: id,
+    content: { type: 'quiz', questions },
+    actions: [{ id: `${id}-speech`, type: 'speech', text: '先独立想一想。' }],
+  });
+  return {
+    ownerId,
+    sessionId,
+    stage: { id: 'stage', name: '课程' } as Stage,
+    scenes: [
+      quiz('quiz-a', 1, locked.slice(0, 1)),
+      {
+        id: 'middle',
+        order: 2,
+        type: 'interactive',
+        title: '操作',
+        content: { type: 'interactive', html: '<button>数一数</button>' },
+        actions: [],
+      },
+      quiz('quiz-b', 3, locked.slice(1)),
+    ] as Scene[],
+  };
+}
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.session.mockResolvedValue({
+    id: sessionId,
+    ownerId,
+    skillId: 'mira-primary-courseware',
+    origin: MIRA_ADAPTIVE_SKILL_SESSION_ORIGIN,
+    prompt: `Header\nLocked assessment questions:\n${JSON.stringify(locked)}\n\nAnswer-blind teaching brief (authoritative):\n{}`,
+  });
+  mocks.events.mockResolvedValue([
+    {
+      type: MIRA_FORMAL_RESEARCH_SEARCH_EVENT_TYPE,
+      data: {
+        kind: MIRA_FORMAL_RESEARCH_SEARCH_EVENT_TYPE,
+        schemaVersion: MIRA_FORMAL_RESEARCH_SEARCH_TRACE_SCHEMA_VERSION,
+        query: '数量',
+        providerId: 'test',
+        searchedAt: '2026-09-07T00:00:00Z',
+        resultCount: 1,
+        sources: [{ url: 'https://example.org/source', title: 'source' }],
+      },
+    },
+  ]);
+});
+describe('quality review uses the final normalized question placement', () => {
+  it('keeps the original 1+3 question placement, strips generated answers, and leaves the editor document unchanged', async () => {
+    const value = input();
+    if (value.scenes[0]!.content.type !== 'quiz') throw new Error('fixture');
+    value.scenes[0]!.content.questions[0] = {
+      ...value.scenes[0]!.content.questions[0]!,
+      answer: ['b'],
+      hasAnswer: true,
+      points: 99,
+    };
+    const before = structuredClone(value);
+    const normalized = await prepareMiraFormalQualitySnapshot(value);
+    expect(value).toEqual(before);
+    expect(normalized.scenes.map((scene) => scene.order)).toEqual([0, 1, 2]);
+    const questions = normalized.scenes
+      .filter((scene) => scene.content.type === 'quiz')
+      .map((scene) => (scene.content.type === 'quiz' ? scene.content.questions : []));
+    expect(questions.map((group) => group.length)).toEqual([1, 3]);
+    expect(questions.flat()).toEqual(locked);
+    expect(qualitySnapshot(normalized.stage, normalized.scenes)).toEqual(
+      qualitySnapshot(value.stage, input().scenes),
+    );
+  });
+  it('rejects modified, reordered or absent locked questions instead of silently replacing teaching content after review', async () => {
+    for (const mutate of [
+      (questions: typeof locked) => {
+        questions[0]!.question = '模型改写了题目';
+      },
+      (questions: typeof locked) => {
+        questions[0]!.options[0]!.label = '改写选项';
+      },
+      (questions: typeof locked) => {
+        questions.pop();
+      },
+    ]) {
+      const value = input();
+      if (value.scenes[2]!.content.type !== 'quiz') throw new Error('fixture');
+      const questions = structuredClone(value.scenes[2]!.content.questions) as typeof locked;
+      mutate(questions);
+      value.scenes[2]!.content.questions = questions as never;
+      await expect(prepareMiraFormalQualitySnapshot(value)).rejects.toThrow(
+        /FORMAL_QUALITY_LOCKED_QUESTION/,
+      );
+    }
+  });
+  it('requires the internal adaptive owner/session identity and the 1-based durable editor order', async () => {
+    await expect(
+      prepareMiraFormalQualitySnapshot({ ...input(), ownerId: 'public-owner' }),
+    ).rejects.toThrow('SESSION_MISMATCH');
+    const value = input();
+    value.scenes[0]!.order = 0;
+    await expect(prepareMiraFormalQualitySnapshot(value)).rejects.toThrow(
+      'SOURCE_SCENE_ORDER_INVALID',
+    );
+  });
+});
