new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-quality-contract.ts
@@ -0,0 +1,117 @@
+import { createHash } from 'node:crypto';
+
+export const MIRA_TEACHING_QUALITY_POLICY = {
+  schemaVersion: 'mira.openmaic.teaching-quality-policy.v1',
+  policyId: 'mira-primary-quality.v1',
+  gradeBoundaryRequired: true,
+  finalSnapshotRequired: true,
+  independentReviewRequired: true,
+  renderedScenesRequired: true,
+  maxReviewAttempts: 3,
+} as const;
+
+export const QUALITY_DIMENSIONS = [
+  'grade_fit', 'goal_coverage', 'teaching_sequence', 'misconception_repair',
+  'meaningful_interaction', 'assessment_alignment', 'language_load',
+] as const;
+export const QUALITY_VIEWPORTS = [
+  { width: 1280, height: 720 }, { width: 1024, height: 768 },
+] as const;
+
+type RecordValue = Record<string, unknown>;
+const isRecord = (value: unknown): value is RecordValue =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+
+export function qualityCanonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(qualityCanonical);
+  if (isRecord(value)) return Object.fromEntries(Object.keys(value).sort()
+    .filter((key) => value[key] !== undefined)
+    .map((key) => [key, qualityCanonical(value[key])]));
+  return value;
+}
+
+export function qualitySha(value: unknown): string {
+  return createHash('sha256').update(JSON.stringify(qualityCanonical(value)), 'utf8').digest('hex');
+}
+
+export function qualityTextSha(value: string): string {
+  return createHash('sha256').update(value, 'utf8').digest('hex');
+}
+
+// Audio promotion is checked by its own receipt; retain all teaching text and
+// non-speech timings. Course edits, including HTML or question edits, invalidate QA.
+const SPEECH_AUDIO_FIELDS = new Set([
+  'audioUrl', 'audioSrc', 'audio', 'audioDuration', 'duration', 'ttsProvider', 'ttsModel',
+]);
+
+export function qualitySceneProjection(scene: unknown, index: number) {
+  if (!isRecord(scene) || typeof scene.id !== 'string' || typeof scene.type !== 'string'
+      || typeof scene.title !== 'string' || !Array.isArray(scene.actions) || !isRecord(scene.content)) {
+    throw new Error('FORMAL_QUALITY_SCENE_INVALID');
+  }
+  return {
+    id: scene.id, type: scene.type, title: scene.title, order: index,
+    content: scene.content,
+    actions: scene.actions.map((action) => isRecord(action) && action.type === 'speech'
+      ? Object.fromEntries(Object.entries(action).filter(([key]) => !SPEECH_AUDIO_FIELDS.has(key)))
+      : action),
+  };
+}
+
+export function qualitySnapshot(stage: unknown, scenes: readonly unknown[]) {
+  if (!isRecord(stage) || typeof stage.id !== 'string' || typeof stage.name !== 'string'
+      || !scenes.length || scenes.length > 60) throw new Error('FORMAL_QUALITY_SNAPSHOT_INVALID');
+  const ordered = [...scenes].sort((a, b) => {
+    if (!isRecord(a) || !isRecord(b) || typeof a.order !== 'number' || typeof b.order !== 'number')
+      throw new Error('FORMAL_QUALITY_ORDER_INVALID');
+    return a.order - b.order;
+  });
+  const projected = ordered.map(qualitySceneProjection);
+  if (new Set(projected.map((scene) => scene.id)).size !== projected.length)
+    throw new Error('FORMAL_QUALITY_DUPLICATE_SCENE');
+  return { stage: { id: stage.id, name: stage.name }, scenes: projected };
+}
+
+/** Recursively preserve source strings. Evidence quotes must occur in the actual
+ * content/actions, not in a model-authored description of what the page does. */
+export function qualitySceneText(scene: { content: unknown; actions: unknown }): string {
+  const strings: string[] = [];
+  const collect = (value: unknown) => {
+    if (typeof value === 'string') strings.push(value);
+    else if (Array.isArray(value)) value.forEach(collect);
+    else if (isRecord(value)) Object.keys(value).sort().forEach((key) => collect(value[key]));
+  };
+  collect(scene.content);
+  collect(scene.actions);
+  return strings.join('\n');
+}
+
+export interface QualityEvidence { sceneId: string; quote: string }
+export interface QualityDimension {
+  id: typeof QUALITY_DIMENSIONS[number]; passed: boolean; evidence: QualityEvidence[];
+}
+export interface QualityObjective { objectiveIndex: number; evidence: QualityEvidence[] }
+export interface QualityRenderCheck {
+  sceneId: string; sceneSha256: string; viewport: { width: number; height: number };
+  screenshotSha256: string; domSha256: string; passed: true; probeCount: number;
+}
+export interface MiraTeachingQualityReceipt {
+  schemaVersion: 'mira.openmaic.teaching-quality-receipt.v1';
+  policyId: typeof MIRA_TEACHING_QUALITY_POLICY.policyId;
+  status: 'passed'; sessionId: string; stageId: string;
+  gradeBoundarySha256: string; selectionPlanSha256: string; teachingBriefSha256: string;
+  snapshotSha256: string; sceneHashes: Array<{ sceneId: string; sceneSha256: string }>;
+  renderChecks: QualityRenderCheck[];
+  review: {
+    providerId: 'deepseek'; modelId: 'deepseek-v4-flash'; requestIdHash: string;
+    inputSha256: string; dimensions: QualityDimension[]; objectives: QualityObjective[];
+  };
+  receiptSha256: string;
+}
+
+export function qualityReviewIdentity(input: {
+  snapshotSha256: string; gradeBoundarySha256: string; selectionPlanSha256: string;
+  teachingBriefSha256: string; renderChecks: QualityRenderCheck[];
+}) {
+  return qualitySha(input);
+}
diff --git a/lib/server/mira-formal-quality-lock.ts b/lib/server/mira-formal-quality-lock.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-quality-lock.ts
@@ -0,0 +1,231 @@
+import { execFile } from 'node:child_process';
+import { randomBytes } from 'node:crypto';
+import { hostname } from 'node:os';
+import { link, open, readFile, realpath, unlink } from 'node:fs/promises';
+import { basename, dirname, join, resolve } from 'node:path';
+import { promisify } from 'node:util';
+import { getServerPersistenceProvider } from '@/lib/persistence/server-provider';
+
+const runFile = promisify(execFile);
+export interface QualityLockProcess {
+  pid: number;
+  hostname: string;
+  startIdentity: string;
+}
+interface LockMetadata extends QualityLockProcess {
+  schemaVersion: 1;
+  token: string;
+}
+export interface QualityLockLease {
+  release(): Promise<void>;
+}
+export interface QualityLockDeps {
+  withMutex?: <T>(key: string, work: () => Promise<T>) => Promise<T>;
+  identity?: () => Promise<QualityLockProcess>;
+  probe?: (
+    pid: number,
+  ) => Promise<{ state: 'exited' } | { state: 'running'; startIdentity: string } | null>;
+}
+
+/** The existing formal runtime already requires Postgres. A short transaction
+ * serializes only local file acquisition/recovery/release, never provider work.
+ * It also avoids introducing a recovery sentinel which could itself go stale. */
+async function withPostgresMutex<T>(key: string, work: () => Promise<T>): Promise<T> {
+  const connection = process.env.DATABASE_URL;
+  if (!connection) throw new Error('FORMAL_QUALITY_LOCK_DATABASE_REQUIRED');
+  const { pool } = await getServerPersistenceProvider(connection);
+  const client = await pool.connect();
+  try {
+    await client.query('BEGIN');
+    const result = await client.query<{ acquired: boolean }>(
+      'SELECT pg_try_advisory_xact_lock(hashtextextended($1, 0)) AS acquired',
+      [`mira-quality-file-lock:${key}`],
+    );
+    if (!result.rows[0]?.acquired) throw new Error('FORMAL_QUALITY_REVIEW_BUSY');
+    const value = await work();
+    await client.query('COMMIT');
+    return value;
+  } catch (error) {
+    await client.query('ROLLBACK').catch(() => undefined);
+    throw error;
+  } finally {
+    client.release();
+  }
+}
+
+async function startIdentity(pid: number): Promise<string | null> {
+  if (process.platform === 'linux') {
+    // Node slim images need no procps dependency. Field 22 is the process's
+    // start tick; combine it with boot identity to survive host restarts.
+    try {
+      const [stat, boot] = await Promise.all([
+        readFile(`/proc/${pid}/stat`, 'utf8'),
+        readFile('/proc/sys/kernel/random/boot_id', 'utf8'),
+      ]);
+      const ticks = stat
+        .slice(stat.lastIndexOf(')') + 2)
+        .trim()
+        .split(/\s+/)[19];
+      return ticks && /^\d+$/.test(ticks) && /^[a-f0-9-]{36}$/.test(boot.trim())
+        ? `linux:${boot.trim()}:${ticks}`
+        : null;
+    } catch {
+      return null;
+    }
+  }
+  try {
+    const { stdout } = await runFile('/bin/ps', ['-p', String(pid), '-o', 'lstart='], {
+      encoding: 'utf8',
+      timeout: 1000,
+      maxBuffer: 1024,
+      env: { PATH: '/usr/bin:/bin', LC_ALL: 'C', TZ: 'UTC', NODE_ENV: 'production' },
+    });
+    return stdout.trim() || null;
+  } catch {
+    return null;
+  }
+}
+let ownIdentity: Promise<QualityLockProcess> | undefined;
+async function localIdentity(): Promise<QualityLockProcess> {
+  ownIdentity ??= (async () => {
+    const started = await startIdentity(process.pid);
+    if (!started) throw new Error('FORMAL_QUALITY_LOCK_PROCESS_UNVERIFIABLE');
+    return { pid: process.pid, hostname: hostname(), startIdentity: started };
+  })();
+  return ownIdentity.catch((error) => {
+    ownIdentity = undefined;
+    throw error;
+  });
+}
+async function probeProcess(
+  pid: number,
+): Promise<Awaited<ReturnType<NonNullable<QualityLockDeps['probe']>>>> {
+  try {
+    process.kill(pid, 0);
+  } catch (error) {
+    return (error as NodeJS.ErrnoException).code === 'ESRCH' ? { state: 'exited' } : null;
+  }
+  const started = await startIdentity(pid);
+  return started ? { state: 'running', startIdentity: started } : null;
+}
+function validMetadata(value: unknown): value is LockMetadata {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+  const item = value as Record<string, unknown>;
+  return (
+    item.schemaVersion === 1 &&
+    Number.isSafeInteger(item.pid) &&
+    Number(item.pid) > 0 &&
+    typeof item.hostname === 'string' &&
+    !!item.hostname &&
+    item.hostname.length <= 255 &&
+    typeof item.startIdentity === 'string' &&
+    !!item.startIdentity &&
+    item.startIdentity.length <= 200 &&
+    typeof item.token === 'string' &&
+    /^[a-f0-9]{64}$/.test(item.token)
+  );
+}
+async function metadata(path: string): Promise<LockMetadata | undefined> {
+  let raw: string;
+  try {
+    raw = await readFile(path, 'utf8');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined;
+    throw error;
+  }
+  let value: unknown;
+  try {
+    value = JSON.parse(raw);
+  } catch {
+    throw new Error('FORMAL_QUALITY_LOCK_UNVERIFIABLE');
+  }
+  if (!validMetadata(value)) throw new Error('FORMAL_QUALITY_LOCK_UNVERIFIABLE');
+  return value;
+}
+async function createCompleteLock(path: string, value: LockMetadata) {
+  const temporary = `${path}.${value.token}.tmp`;
+  const file = await open(temporary, 'wx', 0o600);
+  try {
+    await file.writeFile(JSON.stringify(value), 'utf8');
+    await file.sync();
+  } finally {
+    await file.close();
+  }
+  try {
+    await link(temporary, path);
+  } finally {
+    // Atomic visibility: complete JSON or no lock.
+    await unlink(temporary);
+  }
+}
+
+export async function acquireFormalQualityLock(
+  path: string,
+  deps: QualityLockDeps = {},
+): Promise<QualityLockLease> {
+  const resolved = resolve(path);
+  const absolute = join(await realpath(dirname(resolved)), basename(resolved));
+  const owner = await (deps.identity ?? localIdentity)();
+  const value: LockMetadata = {
+    ...owner,
+    schemaVersion: 1,
+    token: randomBytes(32).toString('hex'),
+  };
+  if (!validMetadata(value)) throw new Error('FORMAL_QUALITY_LOCK_PROCESS_UNVERIFIABLE');
+  const mutex = deps.withMutex ?? withPostgresMutex;
+  let created = false;
+  try {
+    await mutex(absolute, async () => {
+      const previous = await metadata(absolute);
+      if (previous) {
+        if (previous.hostname !== owner.hostname)
+          throw new Error('FORMAL_QUALITY_LOCK_UNVERIFIABLE');
+        const observed = await (deps.probe ?? probeProcess)(previous.pid);
+        if (!observed) throw new Error('FORMAL_QUALITY_LOCK_UNVERIFIABLE');
+        if (observed.state === 'running' && observed.startIdentity === previous.startIdentity)
+          throw new Error('FORMAL_QUALITY_REVIEW_BUSY');
+        // Same-host ESRCH or a positively observed different start proves that
+        // the original owner has exited. Never use age/mtime as that proof.
+        await unlink(absolute);
+      }
+      await createCompleteLock(absolute, value);
+      created = true;
+    });
+  } catch (error) {
+    // A COMMIT/network failure after link() must not leave an abandoned lock
+    // owned by this still-live process. This is its own-token release, not
+    // recovery: every compliant contender refuses this live owner, so none can
+    // replace the file between the token check and unlink, even if PG is down.
+    if (created) {
+      const current = await metadata(absolute).catch(() => undefined);
+      if (current?.token === value.token) await unlink(absolute);
+    }
+    throw error;
+  }
+  return {
+    async release() {
+      // Acquisition is non-blocking. A release may briefly collide with an
+      // unsuccessful contender's ownership probe; retry only that short mutex
+      // contention, without leaving a live-owner lock behind on the first busy.
+      for (let attempt = 0; ; attempt += 1) {
+        try {
+          await mutex(absolute, async () => {
+            const current = await metadata(absolute);
+            if (!current) return;
+            if (current.token !== value.token) throw new Error('FORMAL_QUALITY_LOCK_OWNER_CHANGED');
+            await unlink(absolute);
+          });
+          return;
+        } catch (error) {
+          if (
+            !(error instanceof Error) ||
+            error.message !== 'FORMAL_QUALITY_REVIEW_BUSY' ||
+            attempt >= 100
+          )
+            throw error;
+          await new Promise((done) => setTimeout(done, 20));
+        }
+      }
+    },
+  };
+}
