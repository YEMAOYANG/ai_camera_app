diff --git a/tests/server/mira-formal-preview-read-only.test.ts b/tests/server/mira-formal-preview-read-only.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/mira-formal-preview-read-only.test.ts
@@ -0,0 +1,117 @@
+// @vitest-environment jsdom
+import { act, createElement, useEffect } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { ScenePreviewReadOnlyContext } from '@/lib/contexts/scene-preview-read-only';
+
+const runtime = vi.hoisted(() => ({
+  load: vi.fn().mockResolvedValue({ attemptId: 'real-attempt', state: undefined }),
+  flush: vi.fn().mockResolvedValue(undefined),
+  schedule: vi.fn(),
+  record: vi.fn(),
+  recovery: vi.fn(),
+}));
+vi.mock('@/lib/quiz/runtime', () => ({
+  createQuizAttemptWriter: () => ({
+    flushDraft: runtime.flush,
+    scheduleDraft: runtime.schedule,
+    recordPhase: runtime.record,
+    cancelDraft: vi.fn(),
+  }),
+  loadQuizAttemptState: runtime.load,
+  QuizRetryProgressedError: class extends Error {},
+}));
+vi.mock('@/lib/quiz/persistence', () => ({ writeDraftRecovery: runtime.recovery }));
+vi.mock('@/lib/hooks/use-i18n', () => ({
+  useI18n: () => ({ t: (key: string) => key, locale: 'zh-CN' }),
+}));
+vi.mock('@/components/audio/speech-button', () => ({ SpeechButton: () => null }));
+import { QuizView } from '@/components/scene-renderers/quiz-view';
+import { useInstructorStream } from '@/components/scene-renderers/pbl/v2/use-instructor-stream';
+import type { PBLProjectV2 } from '@/lib/pbl/v2/types';
+
+let root: ReturnType<typeof createRoot> | undefined;
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true);
+});
+afterEach(async () => {
+  await act(async () => root?.unmount());
+  root = undefined;
+  document.body.replaceChildren();
+  vi.unstubAllGlobals();
+});
+function mount(element: Parameters<ReturnType<typeof createRoot>['render']>[0]) {
+  const container = document.createElement('div');
+  document.body.append(container);
+  root = createRoot(container);
+  return act(async () => root!.render(element));
+}
+const questions = [
+  {
+    id: 'q1',
+    type: 'single' as const,
+    question: '一共有几个？',
+    options: [
+      { label: '三个', value: 'A' },
+      { label: '四个', value: 'B' },
+    ],
+  },
+];
+
+describe('private preview uses actual views without student writes', () => {
+  it('permits local quiz answering without loading, saving, grading, or recovery storage', async () => {
+    const fetch = vi.fn();
+    vi.stubGlobal('fetch', fetch);
+    await mount(
+      createElement(QuizView, { questions, sceneId: 'scene', stageId: 'stage', readOnly: true }),
+    );
+    expect(document.body.textContent).toContain('一共有几个');
+    const option = document.querySelector<HTMLButtonElement>('[data-quiz-option="A"]')!;
+    await act(async () => option.click());
+    expect(option.className).toContain('border-violet-400');
+    const submit = Array.from(document.querySelectorAll('button')).find((button) =>
+      button.textContent?.includes('quiz.submitAnswers'),
+    )!;
+    expect(submit.disabled).toBe(true);
+    await act(async () => root!.unmount());
+    root = undefined;
+    expect(runtime.load).not.toHaveBeenCalled();
+    expect(runtime.schedule).not.toHaveBeenCalled();
+    expect(runtime.record).not.toHaveBeenCalled();
+    expect(runtime.flush).not.toHaveBeenCalled();
+    expect(runtime.recovery).not.toHaveBeenCalled();
+    expect(fetch).not.toHaveBeenCalled();
+  });
+  it('preserves the default student hydration path when the preview flag is absent', async () => {
+    await mount(createElement(QuizView, { questions, sceneId: 'scene', stageId: 'stage' }));
+    expect(runtime.load).toHaveBeenCalledWith({ stageId: 'stage', sceneId: 'scene' });
+    expect(document.body.textContent).toContain('quiz.startQuiz');
+  });
+  it('suppresses an automatic PBL opener before fetching or modifying project state', async () => {
+    const fetch = vi.fn();
+    vi.stubGlobal('fetch', fetch);
+    const changed = vi.fn();
+    const streaming = vi.fn();
+    const project = { id: 'preview-project' } as unknown as PBLProjectV2;
+    let api: ReturnType<typeof useInstructorStream> | undefined;
+    function Harness() {
+      const current = useInstructorStream(project, changed, streaming);
+      useEffect(() => {
+        api = current;
+      }, [current]);
+      return null;
+    }
+    await mount(
+      createElement(ScenePreviewReadOnlyContext.Provider, { value: true }, createElement(Harness)),
+    );
+    await act(async () => {
+      await expect(
+        api!.run({ endpoint: '/api/pbl/v2/open-task', body: { phase: 'greeting' } }),
+      ).resolves.toEqual({ ok: false, project });
+    });
+    expect(fetch).not.toHaveBeenCalled();
+    expect(changed).not.toHaveBeenCalled();
+    expect(streaming).not.toHaveBeenCalled();
+  });
+});
