+export function formalCanonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(formalCanonical);
+  if (value && typeof value === 'object')
+    return Object.fromEntries(
+      Object.entries(value)
+        .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+        .map(([key, item]) => [key, formalCanonical(item)]),
+    );
+  return value;
+}
+export function formalCanonicalSha256(value: unknown): string {
+  return createHash('sha256')
+    .update(JSON.stringify(formalCanonical(value)), 'utf8')
+    .digest('hex');
+}
+export interface MiraFormalGradeBoundary {
+  gradeCode: string;
+  subject: 'math' | 'chinese' | 'english';
+  curriculumVersion: string;
+  boundaryVersion: string;
