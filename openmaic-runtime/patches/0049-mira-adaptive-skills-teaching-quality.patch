+    !['math', 'chinese', 'english'].includes(String(boundary.subject)) ||
+    !['curriculumVersion', 'boundaryVersion', 'skillId', 'skillTitle'].every((key) =>
+      text(boundary[key]),
+    ) ||
+    !textList(boundary.learningObjectives, true) ||
+    !textList(boundary.allowedContent, true) ||
+    !textList(boundary.excludedContent) ||
+    !textList(boundary.prerequisiteSkills) ||
+    boundary.language !== 'zh-CN' ||
+    !Number.isInteger(boundary.estimatedMinutes) ||
+    Number(boundary.estimatedMinutes) < 5 ||
+    Number(boundary.estimatedMinutes) > 30 ||
+    !/^[a-f0-9]{64}$/.test(input.gradeBoundarySha256) ||
+    formalCanonicalSha256(boundary) !== input.gradeBoundarySha256
