+  executeMiraCoursewareProvider: vi.fn(),
+}));
+
+const quote = '两个部分合起来，数量就变多了。';
+function input(): FormalQualityInput {
+  const fixture = fixtures[0]!;
+  return {
+    stage: { id: 'qa-stage', name: '数量关系' } as Stage,
+    scenes: [
+      {
+        id: 'page-1',
+        stageId: 'qa-stage',
+        order: 1,
+        type: 'interactive',
+        title: '合起来',
+        content: { type: 'interactive', html: `<p>${quote}</p><button>合起来</button>` },
+        actions: [{ id: 'speech-1', type: 'speech', text: quote }],
+        createdAt: 1,
+        updatedAt: 1,
+      },
+    ] as Scene[],
+    ownerId: 'qa-owner',
+    sessionId: 'qa-session',
+    gradeBoundary: structuredClone(fixture.input.gradeBoundary),
+    teachingBrief: structuredClone(fixture.input.teachingBrief),
+    selectionPlan: structuredClone(fixture.expected),
+  };
+}
+function report(value: FormalQualityInput) {
+  const evidence = [{ sceneId: value.scenes[0]!.id, quote }];
+  return {
+    status: 'passed',
+    dimensions: QUALITY_DIMENSIONS.map((id) => ({ id, passed: true, evidence })),
+    objectives: (value.gradeBoundary.learningObjectives as string[]).map((_, objectiveIndex) => ({
+      objectiveIndex,
+      evidence,
+    })),
+    issues: [],
+  };
+}
+function mocks(value: FormalQualityInput) {
+  const inspect = vi.fn<NonNullable<QualityReviewDeps['inspect']>>(async (request) => ({
+    sceneId: request.scene.id,
+    sceneSha256: qualitySha(
+      qualitySnapshot(request.stage, request.scenes).scenes[request.sceneIndex],
+    ),
+    viewport: request.viewport!,
+    screenshotSha256: 'a'.repeat(64),
+    domSha256: 'b'.repeat(64),
+    passed: true,
+    probeCount: 1,
+    issues: [],
+    visibleText: quote,
+    metrics: {
+      ...request.viewport!,
+      horizontalOverflow: 0,
+      verticalOverflow: 0,
+      textOverflow: [],
+      outsideCanvas: [],
+      failedImages: [],
+      controls: [],
+    },
+    probeResults: [{ id: 'combine', passed: true, message: 'quantity changed' }],
+    coverage: 'interactive-local-controls',
+  }));
+  const provider = vi.fn<NonNullable<QualityReviewDeps['provider']>>(async () => ({
+    schemaVersion: 'mira.openmaic.courseware-provider-call.v1',
+    requestId: 'qa-request',
+    phase: 'independent_verification',
+    content: JSON.stringify(report(value)),
+    providerRequestIdHash: 'c'.repeat(64),
+    inputTokens: 100,
+    outputTokens: 50,
+    billingEvidence: 'reported',
+  }));
+  return {
+    inspect,
+    provider,
+    lockDeps: {
+      withMutex: async <T>(_key: string, work: () => Promise<T>) => work(),
+      identity: async () => ({ pid: 123, hostname: 'test-host', startIdentity: 'current' }),
+    },
+  };
+}
+let cacheRoot: string;
+beforeEach(async () => {
+  cacheRoot = await mkdtemp(join(tmpdir(), 'formal-quality-test-'));
+});
+afterEach(async () => {
+  await rm(cacheRoot, { recursive: true, force: true });
+});
+async function folder() {
+  return join(cacheRoot, (await readdir(cacheRoot))[0]!);
+}
+
+describe('formal teaching quality proof and durable budget', () => {
+  it('renders all viewports, binds the actual independent request, and reuses only an identical snapshot', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    const result = await reviewFormalCourse(value, undefined, deps);
+    expect(result.status).toBe('passed');
+    expect(deps.inspect).toHaveBeenCalledTimes(QUALITY_VIEWPORTS.length);
+    expect(deps.provider).toHaveBeenCalledOnce();
+    const request = deps.provider.mock.calls[0]![0] as { phase: string; userPrompt: string };
+    expect(request.phase).toBe('independent_verification');
+    const sent = JSON.parse(String(request.userPrompt));
+    expect(sent.gradeBoundary).toEqual(value.gradeBoundary);
+    expect(sent.selectionPlan).toEqual(value.selectionPlan);
+    expect(sent.teachingBrief).toEqual(value.teachingBrief);
+    expect(sent.snapshot).toEqual(qualitySnapshot(value.stage, value.scenes));
+    const receipt = result.receipt!;
+    const { receiptSha256, ...unsigned } = receipt;
+    expect(receiptSha256).toBe(qualitySha(unsigned));
+    expect(receipt.review.inputSha256).toBe(
+      qualityReviewIdentity({
+        snapshotSha256: receipt.snapshotSha256,
+        gradeBoundarySha256: receipt.gradeBoundarySha256,
+        selectionPlanSha256: receipt.selectionPlanSha256,
+        teachingBriefSha256: receipt.teachingBriefSha256,
+        renderChecks: receipt.renderChecks,
+      }),
+    );
+    const resumed = await reviewFormalCourse(structuredClone(value), undefined, deps);
+    expect(resumed).toEqual(result);
+    expect(deps.provider).toHaveBeenCalledOnce();
+    expect(deps.inspect).toHaveBeenCalledTimes(2);
+    expect(
+      await readFile(join(await folder(), `${result.snapshotSha256}-provider.json`), 'utf8'),
+    ).toContain('providerRequestIdHash');
+  });
+
+  it('invalidates teaching, HTML, non-speech action, title or sequence edits while ignoring server speech-audio promotion', () => {
+    const value = input();
+    const initial = qualitySha(qualitySnapshot(value.stage, value.scenes));
+    const audio = structuredClone(value);
+    Object.assign(audio.scenes[0]!.actions![0]!, {
+      audioUrl: '/audio.wav',
+      audioDuration: 12,
+      ttsProvider: 'qwen',
+      duration: 12,
+    });
+    expect(qualitySha(qualitySnapshot(audio.stage, audio.scenes))).toBe(initial);
+    for (const mutate of [
+      (copy: FormalQualityInput) => {
+        copy.scenes[0]!.title = '不同标题';
+      },
+      (copy: FormalQualityInput) => {
+        Object.assign(copy.scenes[0]!.content, { html: '<p>别的概念</p>' });
+      },
+      (copy: FormalQualityInput) => {
+        Object.assign(copy.scenes[0]!.actions![0]!, { text: '不同讲解' });
+      },
+      (copy: FormalQualityInput) => {
+        copy.scenes[0]!.actions!.push({ id: 'focus', type: 'spotlight', elementId: 'control' });
+      },
+    ]) {
+      const copy = structuredClone(value);
+      mutate(copy);
+      expect(qualitySha(qualitySnapshot(copy.stage, copy.scenes))).not.toBe(initial);
+    }
+  });
+
+  it('fails browser or interaction checks before any verifier call and caches the repair issues', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    const good = await deps.inspect({
+      scene: value.scenes[0]!,
+      scenes: value.scenes,
+      stage: value.stage,
+      sceneIndex: 0,
+      ownerId: value.ownerId,
+      sessionId: value.sessionId,
+      snapshotSha256: 'd'.repeat(64),
+      viewport: QUALITY_VIEWPORTS[0],
+    });
+    deps.inspect.mockImplementation(async (request) => ({
+      ...good,
+      viewport: request.viewport!,
+      probeCount: 0,
+      passed: false,
+      issues: ['the local control does not change feedback'],
+    }));
+    const result = await reviewFormalCourse(value, undefined, deps);
+    expect(result.status).toBe('needs_revision');
+    expect(result.issues).toHaveLength(2);
+    expect(result.receipt).toBeUndefined();
+    expect(deps.provider).not.toHaveBeenCalled();
+    expect(await reviewFormalCourse(value, undefined, deps)).toEqual(result);
+  });
+
+  it('rejects an inspector response bound to another scene or viewport', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    deps.inspect.mockResolvedValue({ sceneId: 'another-page' } as Awaited<
+      ReturnType<NonNullable<QualityReviewDeps['inspect']>>
+    >);
+    await expect(reviewFormalCourse(value, undefined, deps)).rejects.toThrow(
+      'RENDER_IDENTITY_MISMATCH',
+    );
+    expect(deps.provider).not.toHaveBeenCalled();
+  });
+
+  it('keeps malformed actual provider responses and never upgrades unsupported quotes into a pass', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    const bad = report(value);
+    bad.dimensions[0]!.evidence[0]!.quote = '页面中没有的证据';
+    deps.provider.mockResolvedValue({ content: JSON.stringify(bad) } as Awaited<
+      ReturnType<NonNullable<QualityReviewDeps['provider']>>
+    >);
+    await expect(reviewFormalCourse(value, undefined, deps)).rejects.toThrow('DIMENSIONS_INVALID');
+    const paths = await readdir(await folder());
+    expect(paths.some((path) => path.endsWith('-provider.json'))).toBe(true);
+    const ledger = JSON.parse(await readFile(join(await folder(), 'attempts.json'), 'utf8'));
+    expect(ledger).toMatchObject([{ status: 'failed' }]);
+  });
+
+  it('requires all seven dimensions, exact objective coverage and true source quotes', () => {
+    const value = input();
+    expect(parseFormalQualityReview(report(value), value).status).toBe('passed');
+    for (const mutate of [
+      (copy: ReturnType<typeof report>) => {
+        copy.dimensions.pop();
+      },
+      (copy: ReturnType<typeof report>) => {
+        copy.dimensions[0]!.passed = false;
+      },
+      (copy: ReturnType<typeof report>) => {
+        copy.objectives.pop();
+      },
+      (copy: ReturnType<typeof report>) => {
+        copy.dimensions[0]!.evidence[0]!.sceneId = 'missing';
+      },
+    ]) {
+      const copy = structuredClone(report(value));
+      mutate(copy);
+      expect(() => parseFormalQualityReview(copy, value)).toThrow(/FORMAL_QUALITY_/);
+    }
+  });
+
+  it('reserves attempts durably before dispatch and refuses a fourth repaired snapshot', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    for (let attempt = 1; attempt <= 3; attempt += 1) {
+      value.scenes[0]!.title = `revision ${attempt}`;
+      const original = deps.provider.getMockImplementation()!;
+      deps.provider.mockImplementationOnce(async (...args) => {
+        const ledger = JSON.parse(await readFile(join(await folder(), 'attempts.json'), 'utf8'));
+        expect(ledger).toHaveLength(attempt);
+        expect(ledger.at(-1).status).toBe('started');
+        return original(...args);
+      });
+      await reviewFormalCourse(value, undefined, deps);
+    }
+    value.scenes[0]!.title = 'revision 4';
+    await expect(reviewFormalCourse(value, undefined, deps)).rejects.toThrow('BUDGET_EXHAUSTED');
+    expect(deps.provider).toHaveBeenCalledTimes(3);
+    expect(
+      deps.provider.mock.calls.map(([request]) => (request as { phase: string }).phase),
+    ).toEqual([
+      'independent_verification',
+      'verification_after_repair',
+      'verification_after_repair',
+    ]);
+  });
+
+  it('fails a damaged passed receipt without spending another review call', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    const result = await reviewFormalCourse(value, undefined, deps);
+    result.receipt!.review.dimensions[0]!.passed = false;
+    await writeFile(join(await folder(), `${result.snapshotSha256}.json`), JSON.stringify(result));
+    await expect(reviewFormalCourse(value, undefined, deps)).rejects.toThrow('CACHE_CORRUPT');
+    expect(deps.provider).toHaveBeenCalledOnce();
+  });
+
+  it('fails an existing result with the wrong outer snapshot rather than dispatching again', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    const result = await reviewFormalCourse(value, undefined, deps);
+    await writeFile(
+      join(await folder(), `${result.snapshotSha256}.json`),
+      JSON.stringify({
+        ...result,
+        snapshotSha256: 'f'.repeat(64),
+      }),
+    );
+    await expect(reviewFormalCourse(value, undefined, deps)).rejects.toThrow('CACHE_CORRUPT');
+    expect(deps.provider).toHaveBeenCalledOnce();
+  });
+
+  it('does not repeat an ambiguous failed provider attempt after resume of the same snapshot', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    deps.provider.mockRejectedValue(new Error('connection ended after dispatch'));
+    await expect(reviewFormalCourse(value, undefined, deps)).rejects.toThrow('connection ended');
+    await expect(reviewFormalCourse(structuredClone(value), undefined, deps)).rejects.toThrow(
+      'PRIOR_ATTEMPT_UNRESOLVED',
+    );
+    expect(deps.provider).toHaveBeenCalledOnce();
+  });
+
+  it('recovers a dead file lock but retains the unresolved dispatch protection for that snapshot', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    deps.provider.mockRejectedValue(new Error('ambiguous provider outcome'));
+    await expect(reviewFormalCourse(value, undefined, deps)).rejects.toThrow('ambiguous provider');
+    const ledgerPath = join(await folder(), 'attempts.json');
+    const before = await readFile(ledgerPath, 'utf8');
+    await writeFile(
+      join(await folder(), 'review.lock'),
+      JSON.stringify({
+        schemaVersion: 1,
+        pid: 999999,
+        hostname: 'test-host',
+        startIdentity: 'dead-instance',
+        token: 'a'.repeat(64),
+      }),
+    );
+    const lockDeps = { ...deps.lockDeps, probe: async () => ({ state: 'exited' as const }) };
+    await expect(reviewFormalCourse(value, undefined, { ...deps, lockDeps })).rejects.toThrow(
+      'PRIOR_ATTEMPT_UNRESOLVED',
+    );
+    expect(deps.provider).toHaveBeenCalledOnce();
+    expect(await readFile(ledgerPath, 'utf8')).toBe(before);
+    expect(await readdir(await folder())).not.toContain('review.lock');
+  });
+
+  it('rejects cancellation without issuing an inspector or provider call', async () => {
+    const value = input();
+    const deps = { ...mocks(value), cacheRoot };
+    const controller = new AbortController();
+    controller.abort();
+    await expect(reviewFormalCourse(value, controller.signal, deps)).rejects.toThrow('ABORTED');
+    expect(deps.inspect).not.toHaveBeenCalled();
+    expect(deps.provider).not.toHaveBeenCalled();
+  });
+
+  it('shares lexical canonical hash ordering with the adaptive selection contract', () => {
+    const value = { Z: 2, a: '中文', A: [1, { _key: true, B: false }], _key: null };
+    expect(Object.keys(qualityCanonical(value) as object)).toEqual(['A', 'Z', '_key', 'a']);
+    expect(qualitySha(value)).toBe(formalCanonicalSha256(value));
+  });
+});
