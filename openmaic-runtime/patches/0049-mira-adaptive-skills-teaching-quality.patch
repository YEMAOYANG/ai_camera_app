+++ b/lib/server/mira-formal-scene-dom.ts
@@ -0,0 +1,117 @@
+import type { FormalInspectionMetrics } from '@/lib/types/formal-scene-inspection';
+
+/** Executed in the isolated browser, including inside its sandboxed iframe. */
+export function observeFormalSceneDom(): {
+  metrics: FormalInspectionMetrics;
+  visibleText: string;
+  state: string;
+} {
+  const root = document.querySelector<HTMLElement>('#formal-scene-root') ?? document.body;
+  const bounds = root.getBoundingClientRect();
+  const visible = (element: Element) => {
+    const r = element.getBoundingClientRect();
+    const style = getComputedStyle(element);
+    return r.width > 0 && r.height > 0 && style.visibility !== 'hidden' && style.display !== 'none';
+  };
+  const selector = (element: Element): string => {
+    if (element.id) return `#${CSS.escape(element.id)}`;
+    const parts: string[] = [];
+    let current: Element | null = element;
+    while (current && current !== root) {
+      const parent: Element | null = current.parentElement;
+      if (!parent) break;
+      parts.unshift(
+        `${current.tagName.toLowerCase()}:nth-child(${Array.from(parent.children).indexOf(current) + 1})`,
+      );
+      current = parent;
+    }
+    return `${root.id ? `#${CSS.escape(root.id)}` : 'body'} > ${parts.join(' > ')}`;
+  };
+  const textOverflow: string[] = [];
+  const outsideCanvas: string[] = [];
+  for (const element of Array.from(root.querySelectorAll<HTMLElement>('.element-content'))) {
+    if (!visible(element)) continue;
+    const r = element.getBoundingClientRect();
+    // Slide element wrappers share the same native canvas parent. Compare to
+    // its clipped viewport, not a letterboxed outer screen.
+    const canvas = element.closest('.slide-element')?.parentElement?.parentElement;
+    const clip = canvas?.getBoundingClientRect() ?? bounds;
+    if (
+      r.left < clip.left - 2 ||
+      r.top < clip.top - 2 ||
+      r.right > clip.right + 2 ||
+      r.bottom > clip.bottom + 2
+    )
+      outsideCanvas.push(element.closest('.slide-element')?.id ?? selector(element));
+    if (
+      element.innerText?.trim() &&
+      (element.scrollWidth > element.clientWidth + 2 ||
+        element.scrollHeight > element.clientHeight + 2)
+    )
+      textOverflow.push(element.closest('.slide-element')?.id ?? selector(element));
+  }
+  // Interactive layout and non-slide cards may scroll vertically by design.
+  // Hidden overflow with unreadable text is different from accessible scrolling.
+  for (const element of Array.from(root.querySelectorAll<HTMLElement>('p,h1,h2,h3,label,button'))) {
+    if (!visible(element) || element.closest('[data-qa-local-nav]')) continue;
+    const style = getComputedStyle(element);
+    if (
+      element.innerText?.trim() &&
+      ((style.overflowX === 'hidden' && element.scrollWidth > element.clientWidth + 2) ||
+        (style.overflowY === 'hidden' && element.scrollHeight > element.clientHeight + 2))
+    )
+      textOverflow.push(selector(element));
+  }
+  const controls = Array.from(
+    root.querySelectorAll<HTMLElement>('button,input,select,textarea,[role="button"]'),
+  )
+    .filter(
+      (element) =>
+        visible(element) &&
+        !element.matches(':disabled') &&
+        !element.closest('[data-qa-local-nav]'),
+    )
+    .slice(0, 60)
+    .map((element) => ({
+      selector: selector(element),
+      tag: element.tagName.toLowerCase(),
+      type: element.getAttribute('type') ?? '',
+      text: (element.innerText || element.getAttribute('aria-label') || '').slice(0, 120),
+    }));
+  const failedImages = Array.from(root.querySelectorAll('img'))
+    .filter((image) => !image.complete || image.naturalWidth === 0)
+    .map((image) => image.getAttribute('src')?.slice(0, 200) ?? '(missing src)');
+  const scrollRoot = root === document.body ? document.documentElement : root;
+  const visibleText = root.innerText.slice(0, 24000);
+  const formState = Array.from(
+    root.querySelectorAll<HTMLInputElement>('input,textarea,select'),
+  ).map((element) => [element.value, element.checked ?? null]);
+  const canvases = Array.from(root.querySelectorAll('canvas'))
+    .slice(0, 6)
+    .map((canvas) => {
+      try {
+        return canvas.toDataURL();
+      } catch {
+        return 'opaque-canvas';
+      }
+    });
+  return {
+    metrics: {
+      width: bounds.width,
+      height: bounds.height,
+      horizontalOverflow: Math.max(0, scrollRoot.scrollWidth - scrollRoot.clientWidth),
+      verticalOverflow: Math.max(0, scrollRoot.scrollHeight - scrollRoot.clientHeight),
+      textOverflow: [...new Set(textOverflow)].slice(0, 60),
+      outsideCanvas: [...new Set(outsideCanvas)].slice(0, 60),
+      failedImages: failedImages.slice(0, 60),
+      controls,
+    },
+    visibleText,
+    state: JSON.stringify({
+      visibleText,
+      formState,
+      canvases,
+      html: root.innerHTML.slice(0, 100000),
+    }),
+  };
+}
diff --git a/lib/server/mira-formal-scene-inspector.ts b/lib/server/mira-formal-scene-inspector.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-scene-inspector.ts
@@ -0,0 +1,584 @@
+import { createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import { chromium, type Browser, type Frame, type Page } from 'playwright-core';
+import type {
+  FormalInteractionProbe,
+  FormalSceneInspectionInput,
+  FormalSceneInspectionResult,
+} from '@/lib/types/formal-scene-inspection';
+import {
+  qualitySceneProjection,
+  qualitySha,
+  qualitySnapshot,
+  QUALITY_VIEWPORTS,
+} from './mira-formal-quality-contract';
+import { probeStageAccess } from './agent-runtime/curriculum-tools';
+import { getAgentSessionStore } from './agent-runtime/store';
+import { getOwnerScopedDocumentStore } from './agent-runtime/owner-scoped-documents';
+import type { AppDocumentOutline } from '@/lib/document-store/persistence-types';
+import { CLASSROOMS_DIR } from './classroom-storage';
+import {
+  FORMAL_PREVIEW_HEADER,
+  FORMAL_PREVIEW_ROUTE,
+  FORMAL_QUALITY_DIR,
+  registerFormalPreview,
+  releaseFormalPreview,
+} from './mira-formal-preview-snapshot';
+import { observeFormalSceneDom } from './mira-formal-scene-dom';
+import {
+  isFormalInspectionRequestAllowed,
+  formalInspectionContentSecurityPolicy,
+} from './mira-formal-inspection-network';
+
+export type { FormalInteractionProbe, FormalSceneInspectionInput, FormalSceneInspectionResult };
+const byteSha = (bytes: Buffer) => createHash('sha256').update(bytes).digest('hex');
+const MAX_DURATION_MS = 40_000;
+const shortUrl = (raw: string) => {
+  try {
+    const url = new URL(raw);
+    return `${url.origin}${url.pathname}`.slice(0, 250);
+  } catch {
+    return '(invalid URL)';
+  }
+};
+
+export function formalInspectionConfiguration() {
+  const executablePath = process.env.MIRA_FORMAL_QA_BROWSER_PATH ?? '';
+  const url = new URL(process.env.MIRA_FORMAL_QA_BASE_URL || 'http://127.0.0.1:3100');
+  if (
+    !path.isAbsolute(executablePath) ||
+    !['http:', 'https:'].includes(url.protocol) ||
+    !['127.0.0.1', 'localhost', '[::1]'].includes(url.hostname) ||
+    url.username ||
+    url.password ||
+    url.pathname !== '/' ||
+    url.search ||
+    url.hash
+  )
+    throw new Error('FORMAL_QUALITY_RENDERER_NOT_CONFIGURED');
+  return { executablePath, baseOrigin: url.origin };
+}
+
+function assertProbes(probes: readonly FormalInteractionProbe[]) {
+  if (probes.length > 4) throw new Error('FORMAL_QUALITY_TOO_MANY_PROBES');
+  for (const probe of probes) {
+    if (
+      !/^[A-Za-z0-9_-]{1,60}$/.test(probe.id) ||
+      !['click', 'fill', 'range', 'select'].includes(probe.action) ||
+      !probe.selector ||
+      probe.selector.length > 300 ||
+      !probe.expect?.selector ||
+      probe.expect.selector.length > 300 ||
+      (probe.value?.length ?? 0) > 500 ||
+      (probe.expect.textIncludes?.length ?? 0) > 500 ||
+      (probe.expect.valueEquals?.length ?? 0) > 500 ||
+      !Object.keys(probe.expect).some((key) => key !== 'selector')
+    )
+      throw new Error('FORMAL_QUALITY_PROBE_INVALID');
+  }
+}
+
+async function assertOwnership(input: FormalSceneInspectionInput) {
+  const access = await probeStageAccess(input.ownerId, input.stage.id);
+  const session = await (await getAgentSessionStore()).getSession(input.sessionId);
+  if (access.kind !== 'owned' || !session || session.ownerId !== input.ownerId)
+    throw new Error('FORMAL_QUALITY_SNAPSHOT_NOT_OWNED');
+  const document = await (
+    await getOwnerScopedDocumentStore(input.ownerId)
+  ).loadDocument(input.stage.id);
+  // New-course sessions keep an immutable placeholder stageId. The persisted
+  // document producerRef, not that conversation seed, binds the created course.
+  const outline = document?.outline as AppDocumentOutline | undefined;
+  if (
+    !document ||
+    document.stage.id !== input.stage.id ||
+    outline?.producer !== 'server-job' ||
+    outline.producerRef !== input.sessionId ||
+    !document.scenes.some((scene) => scene.id === input.scene.id)
+  )
+    throw new Error('FORMAL_QUALITY_PRODUCER_MISMATCH');
+}
+
+async function awaitPaint(target: Page | Frame) {
+  await target.evaluate(async () => {
+    await document.fonts.ready;
+    await Promise.all(
+      Array.from(document.images).map((image) =>
+        image.complete
+          ? Promise.resolve()
+          : new Promise<void>((resolve) => {
+              image.addEventListener('load', () => resolve(), { once: true });
+              image.addEventListener('error', () => resolve(), { once: true });
+              setTimeout(resolve, 3000);
+            }),
+      ),
+    );
+    await new Promise<void>((resolve) =>
+      requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+    );
+  });
+}
+
+async function runProbe(target: Page | Frame, probe: FormalInteractionProbe) {
+  // native querySelector rejects Playwright's non-CSS selector engines. Scope
+  // is this snapshot's document, never another browser tab or a student frame.
+  await target.evaluate(
+    ({ selector, expected }) => {
+      if (!document.querySelector(selector) || !document.querySelector(expected))
+        throw new Error('probe target absent');
+    },
+    { selector: probe.selector, expected: probe.expect.selector },
+  );
+  const before = await target
+    .locator(probe.expect.selector)
+    .first()
+    .evaluate((element) =>
+      JSON.stringify({
+        text: (element as HTMLElement).innerText,
+        html: element.outerHTML,
+        value: (element as HTMLInputElement).value,
+        checked: (element as HTMLInputElement).checked,
+      }),
+    );
+  const control = target.locator(probe.selector).first();
+  const tag = await control.evaluate((element) => ({
+    tag: element.tagName.toLowerCase(),
+    type: element.getAttribute('type'),
+  }));
+  if (tag.tag === 'a' || tag.type === 'file' || tag.type === 'submit' || tag.type === 'image')
+    throw new Error('probe action is not a local control');
+  if (probe.action === 'click') await control.click({ timeout: 2000 });
+  else if (probe.action === 'fill') await control.fill(probe.value ?? '', { timeout: 2000 });
+  else if (probe.action === 'select')
+    await control.selectOption(probe.value ?? '', { timeout: 2000 });
+  else {
+    if (tag.tag !== 'input' || tag.type !== 'range') throw new Error('range input required');
+    await control.evaluate((element, value) => {
+      (element as HTMLInputElement).value = value;
+      element.dispatchEvent(new Event('input', { bubbles: true }));
+      element.dispatchEvent(new Event('change', { bubbles: true }));
+    }, probe.value ?? '');
+  }
+  await target.waitForFunction(
+    ({ selector, expect, before }) => {
+      const element = document.querySelector(selector) as HTMLInputElement | null;
+      if (!element) return false;
+      const state = JSON.stringify({
+        text: element.innerText,
+        html: element.outerHTML,
+        value: element.value,
+        checked: element.checked,
+      });
+      return (
+        (expect.textIncludes === undefined || element.innerText.includes(expect.textIncludes)) &&
+        (expect.valueEquals === undefined || element.value === expect.valueEquals) &&
+        (expect.checked === undefined || element.checked === expect.checked) &&
+        (!expect.changed || state !== before)
+      );
+    },
+    { selector: probe.expect.selector, expect: probe.expect, before },
+    { timeout: 2500 },
+  );
+}
+
+async function automaticProbe(
+  target: Page | Frame,
+  sceneType: string,
+): Promise<FormalInteractionProbe | null> {
+  return target.evaluate((type) => {
+    const selector =
+      type === 'quiz'
+        ? '[data-quiz-option],textarea'
+        : 'input[type="range"],input[type="checkbox"],select,button:not([type="submit"]),input[type="number"]';
+    const controls = Array.from(document.querySelectorAll<HTMLInputElement>(selector));
+    const control = controls.find(
+      (element) =>
+        !element.disabled &&
+        element.getBoundingClientRect().width > 0 &&
+        element.getBoundingClientRect().height > 0 &&
+        getComputedStyle(element).visibility !== 'hidden',
+    );
+    if (!control) return null;
+    control.setAttribute('data-formal-auto-probe', '1');
+    const target = '[data-formal-auto-probe="1"]';
+    if (control.type === 'range') {
+      const min = Number(control.min || 0);
+      const max = Number(control.max || 100);
+      const value = String(Number(control.value) === min ? max : min);
+      return {
+        id: 'auto-range',
+        action: 'range',
+        selector: target,
+        value,
+        expect: { selector: target, valueEquals: value, changed: true },
+      };
+    }
+    if (control.type === 'checkbox')
+      return {
+        id: 'auto-checkbox',
+        action: 'click',
+        selector: target,
+        expect: { selector: target, checked: !control.checked, changed: true },
+      };
+    if (control.tagName === 'SELECT') {
+      const options = Array.from((control as unknown as HTMLSelectElement).options).filter(
+        (option) => !option.disabled && option.value !== control.value,
+      );
+      return options[0]
+        ? {
+            id: 'auto-select',
+            action: 'select',
+            selector: target,
+            value: options[0].value,
+            expect: { selector: target, valueEquals: options[0].value, changed: true },
+          }
+        : null;
+    }
+    if (control.tagName === 'TEXTAREA' || control.type === 'number')
+      return {
+        id: 'auto-fill',
+        action: 'fill',
+        selector: target,
+        value: control.type === 'number' ? '2' : '预览回答',
+        expect: { selector: target, changed: true },
+      };
+    return {
+      id: 'auto-click',
+      action: 'click',
+      selector: target,
+      expect: { selector: type === 'quiz' ? '#formal-scene-root' : 'body', changed: true },
+    };
+  }, sceneType);
+}
+
+/** One browser and immutable capability per scene. Never attaches to a person's
+ * browser, and never runs a student/agent request. Screenshots are local evidence. */
+export async function inspectFormalScene(
+  input: FormalSceneInspectionInput,
+  signal?: AbortSignal,
+): Promise<FormalSceneInspectionResult> {
+  signal?.throwIfAborted();
+  const cloned = structuredClone(input);
+  const viewport = cloned.viewport ?? { ...QUALITY_VIEWPORTS[0] };
+  if (
+    !QUALITY_VIEWPORTS.some(
+      (allowed) => allowed.width === viewport.width && allowed.height === viewport.height,
+    )
+  )
+    throw new Error('FORMAL_QUALITY_VIEWPORT_INVALID');
+  if (
+    !/^[A-Za-z0-9_-]+$/.test(cloned.stage.id) ||
+    cloned.scene.stageId !== cloned.stage.id ||
+    cloned.scenes.some((scene) => scene.stageId !== cloned.stage.id)
+  )
+    throw new Error('FORMAL_QUALITY_STAGE_MISMATCH');
+  const snapshot = qualitySnapshot(cloned.stage, cloned.scenes);
+  const projected = qualitySceneProjection(cloned.scene, cloned.sceneIndex);
+  const sceneSha256 = qualitySha(projected);
+  if (
+    qualitySha(snapshot) !== cloned.snapshotSha256 ||
+    qualitySha(snapshot.scenes[cloned.sceneIndex]) !== sceneSha256
+  )
+    throw new Error('FORMAL_QUALITY_SNAPSHOT_MISMATCH');
+  assertProbes(cloned.probes ?? []);
+  await assertOwnership(cloned);
+  signal?.throwIfAborted();
+  const configuration = formalInspectionConfiguration();
+  await fs.access(configuration.executablePath);
+  const timeoutSignal = AbortSignal.timeout(MAX_DURATION_MS);
+  const combined = signal ? AbortSignal.any([signal, timeoutSignal]) : timeoutSignal;
+  let browser: Browser | undefined;
+  let token: string | undefined;
+  const issues: string[] = [];
+  const probeResults: FormalSceneInspectionResult['probeResults'] = [];
+  const close = () => {
+    void browser?.close().catch(() => {});
+  };
+  combined.addEventListener('abort', close, { once: true });
+  try {
+    token = await registerFormalPreview({
+      schemaVersion: 1,
+      expiresAt: Date.now() + 90_000,
+      ownerId: cloned.ownerId,
+      sessionId: cloned.sessionId,
+      stage: cloned.stage,
+      scene: cloned.scene,
+      sceneIndex: cloned.sceneIndex,
+      snapshotSha256: cloned.snapshotSha256,
+      sceneSha256,
+      actualSourceSha256: qualitySha(cloned.scene),
+      viewport,
+    });
+    combined.throwIfAborted();
+    browser = await chromium.launch({
+      executablePath: configuration.executablePath,
+      headless: true,
+      chromiumSandbox: true,
+      timeout: 15_000,
+      env: { PATH: process.env.PATH ?? '/usr/bin:/bin', HOME: os.homedir(), TMPDIR: os.tmpdir() },
+      args: [
+        '--disable-background-networking',
+        '--disable-component-update',
+        '--disable-sync',
+        '--no-first-run',
+      ],
+    });
+    combined.throwIfAborted();
+    const context = await browser.newContext({
+      viewport,
+      deviceScaleFactor: 1,
+      locale: 'zh-CN',
+      // Playwright's built-in block shim reads navigator.serviceWorker in
+      // opaque sandbox frames and itself throws a SecurityError. Register is
+      // disabled below without touching that forbidden navigator getter.
+      serviceWorkers: 'allow',
+      acceptDownloads: false,
+      permissions: [],
+      reducedMotion: 'reduce',
+      colorScheme: 'light',
+    });
+    // A fresh Chrome profile otherwise rejects opaque srcdoc frames reading
+    // their same-course loopback images. Grant only this trusted preview origin
+    // in this disposable context; CSP still prohibits every connection/API.
+    await context.grantPermissions(['local-network-access'], { origin: configuration.baseOrigin });
+    await context.addInitScript(() => {
+      if (typeof ServiceWorkerContainer !== 'undefined') {
+        Object.defineProperty(ServiceWorkerContainer.prototype, 'register', {
+          value: () => Promise.reject(new Error('formal-inspection-service-worker-blocked')),
+          configurable: false,
+          writable: false,
+        });
+      }
+    });
+    const previewUrl = `${configuration.baseOrigin}${FORMAL_PREVIEW_ROUTE}/${token}`;
+    await context.routeWebSocket('**/*', (socket) => {
+      issues.push('blocked_websocket');
+      socket.close();
+    });
+    await context.route('**/*', async (route) => {
+      const request = route.request();
+      const rawUrl = request.url();
+      if (
+        !isFormalInspectionRequestAllowed({
+          url: rawUrl,
+          method: request.method(),
+          resourceType: request.resourceType(),
+          baseOrigin: configuration.baseOrigin,
+          previewUrl,
+          stageId: cloned.stage.id,
+        })
+      ) {
+        issues.push(`blocked_resource:${shortUrl(rawUrl)}`);
+        await route.abort('blockedbyclient');
+        return;
+      }
+      // An asset capability is scoped to this owned stage. Read it directly:
+      // no access-code cookie, credentials, or private header reach media URLs.
+      const url = new URL(rawUrl);
+      if (rawUrl === previewUrl) {
+        const response = await route.fetch({
+          headers: { ...request.headers(), [FORMAL_PREVIEW_HEADER]: token! },
+          maxRedirects: 0,
+          timeout: 20_000,
+        });
+        await route.fulfill({
+          response,
+          headers: {
+            ...response.headers(),
+            'content-security-policy': formalInspectionContentSecurityPolicy({
+              baseOrigin: configuration.baseOrigin,
+              stageId: cloned.stage.id,
+              scene: cloned.scene,
+            }),
+            'referrer-policy': 'no-referrer',
+            'cache-control': 'no-store',
+          },
+        });
+        return;
+      }
+      if (url.pathname.startsWith(`/api/classroom-media/${cloned.stage.id}/media/`)) {
+        const base = path.join(
+          CLASSROOMS_DIR,
+          cloned.stage.id,
+          ...(cloned.stage.id.startsWith('omclass_') ? ['artifact'] : []),
+          'media',
+        );
+        try {
+          const realBase = await fs.realpath(base);
+          const file = await fs.realpath(path.join(base, path.basename(url.pathname)));
+          const stat = await fs.stat(file);
+          if (
+            !file.startsWith(`${realBase}${path.sep}`) ||
+            !stat.isFile() ||
+            stat.size > 32 * 1024 * 1024
+          )
+            throw new Error('invalid media');
+          const ext = path.extname(file).slice(1).replace('jpg', 'jpeg');
+          await route.fulfill({
+            status: 200,
+            contentType: `image/${ext}`,
+            body: await fs.readFile(file),
+            headers: { 'access-control-allow-origin': '*' },
+          });
+        } catch {
+          issues.push(`failed_media:${shortUrl(rawUrl)}`);
+          await route.fulfill({ status: 404, body: '' });
+        }
+        return;
+      }
+      await route.continue({
+        headers:
+          rawUrl === previewUrl
+            ? { ...request.headers(), [FORMAL_PREVIEW_HEADER]: token! }
+            : Object.fromEntries(
+                Object.entries(request.headers()).filter(
+                  ([key]) =>
+                    !['cookie', 'authorization', FORMAL_PREVIEW_HEADER, 'referer'].includes(
+                      key.toLowerCase(),
+                    ),
+                ),
+              ),
+      });
+    });
+    const page = await context.newPage();
+    context.on('page', (popup) => {
+      if (popup !== page) {
+        issues.push('blocked_popup');
+        void popup.close();
+      }
+    });
+    page.on('pageerror', (error) => issues.push(`javascript_error:${error.message.slice(0, 300)}`));
+    page.on('console', (message) => {
+      if (message.type() === 'error') issues.push(`browser_error:${message.text().slice(0, 400)}`);
+    });
+    page.on('requestfailed', (request) =>
+      issues.push(`resource_failed:${shortUrl(request.url())}`),
+    );
+    page.on('response', (response) => {
+      if (response.status() >= 400)
+        issues.push(`resource_http_${response.status()}:${shortUrl(response.url())}`);
+    });
+    await page.goto(previewUrl, { waitUntil: 'domcontentloaded', timeout: 20_000 });
+    await page.locator('#formal-scene-root[data-qa-ready="true"]').waitFor({ timeout: 12_000 });
+    const unsupportedNode = page.locator('[data-qa-unsupported]');
+    const unsupported = (await unsupportedNode.count())
+      ? await unsupportedNode.first().getAttribute('data-qa-unsupported')
+      : null;
+    if (unsupported) issues.push(`unsupported:${unsupported}`);
+    let target: Page | Frame = page;
+    if (cloned.scene.type === 'interactive' && !unsupported) {
+      const frame = await page
+        .locator('#formal-interactive-frame')
+        .elementHandle({ timeout: 2000 });
+      const contentFrame = await frame?.contentFrame();
+      if (!contentFrame) throw new Error('FORMAL_QUALITY_IFRAME_UNAVAILABLE');
+      target = contentFrame;
+      await target.waitForLoadState('domcontentloaded', { timeout: 8000 });
+    }
+    await awaitPaint(target);
+    const initial = await target.evaluate(observeFormalSceneDom);
+    if (cloned.scene.type === 'pbl' && !unsupported) {
+      await page.locator('#formal-pbl-show-workspace').dispatchEvent('click');
+      await page.locator('[data-qa-pbl-view="workspace"] [data-pbl-workspace="true"]').waitFor();
+      await awaitPaint(page);
+      const workspace = await page.evaluate(observeFormalSceneDom);
+      const workspaceChanged = workspace.visibleText !== initial.visibleText;
+      probeResults.push({
+        id: 'pbl-local-workspace-navigation',
+        passed: workspaceChanged,
+        message: workspaceChanged
+          ? 'Actual workspace rendered; no instructor or submission executed.'
+          : 'Workspace did not change.',
+      });
+      if (workspace.metrics.horizontalOverflow > 2 || workspace.metrics.textOverflow.length)
+        issues.push('pbl_workspace_overflow');
+    } else if (
+      !unsupported &&
+      (cloned.scene.type === 'interactive' || cloned.scene.type === 'quiz')
+    ) {
+      const probes = cloned.probes?.length
+        ? cloned.probes
+        : [await automaticProbe(target, cloned.scene.type)].filter(
+            (probe): probe is FormalInteractionProbe => !!probe,
+          );
+      if (!probes.length) issues.push('no_local_interaction_probe');
+      for (const probe of probes) {
+        combined.throwIfAborted();
+        try {
+          await runProbe(target, probe);
+          probeResults.push({
+            id: probe.id,
+            passed: true,
+            message: 'Declared local DOM state transition observed.',
+          });
+        } catch (error) {
+          probeResults.push({
+            id: probe.id,
+            passed: false,
+            message: error instanceof Error ? error.message.slice(0, 250) : 'Local probe failed.',
+          });
+        }
+      }
+    }
+    await awaitPaint(target);
+    const final = await target.evaluate(observeFormalSceneDom);
+    for (const observation of [initial, final]) {
+      if (observation.metrics.horizontalOverflow > 2) issues.push('horizontal_overflow');
+      issues.push(
+        ...observation.metrics.textOverflow.map((id) => `text_overflow:${id}`),
+        ...observation.metrics.outsideCanvas.map((id) => `outside_canvas:${id}`),
+        ...observation.metrics.failedImages.map((src) => `image_unavailable:${src}`),
+      );
+    }
+    issues.push(
+      ...probeResults.filter((probe) => !probe.passed).map((probe) => `probe_failed:${probe.id}`),
+    );
+    if (!initial.visibleText.trim() && !cloned.scene.content.type.includes('slide'))
+      issues.push('empty_visible_text');
+    const png = await page.screenshot({ type: 'png', animations: 'disabled', timeout: 8000 });
+    const screenshotSha256 = byteSha(png);
+    const evidenceDir = path.join(
+      FORMAL_QUALITY_DIR,
+      qualitySha(cloned.sessionId),
+      cloned.snapshotSha256,
+    );
+    await fs.mkdir(evidenceDir, { recursive: true, mode: 0o700 });
+    await fs.writeFile(
+      path.join(
+        evidenceDir,
+        `${sceneSha256}-${viewport.width}x${viewport.height}-${screenshotSha256}.png`,
+      ),
+      png,
+      { mode: 0o600 },
+    );
+    await assertOwnership(cloned);
+    combined.throwIfAborted();
+    return {
+      sceneId: cloned.scene.id,
+      sceneSha256,
+      viewport,
+      screenshotSha256,
+      domSha256: qualitySha({ initial: initial.state, final: final.state }),
+      passed: issues.length === 0,
+      probeCount: probeResults.filter((probe) => probe.passed).length,
+      issues: [...new Set(issues)].slice(0, 80),
+      visibleText: `${initial.visibleText}\n${final.visibleText}`.slice(0, 24000),
+      metrics: final.metrics,
+      probeResults,
+      coverage:
+        cloned.scene.type === 'slide'
+          ? 'slide'
+          : cloned.scene.type === 'interactive'
+            ? 'interactive-local-controls'
+            : cloned.scene.type === 'quiz'
+              ? 'quiz-local-answering'
+              : 'pbl-local-navigation',
+    };
+  } finally {
+    combined.removeEventListener('abort', close);
+    await browser?.close().catch(() => {});
+    if (token) await releaseFormalPreview(token);
