@@ -0,0 +1,58 @@
+import { createHash } from 'node:crypto';
+import { resolve } from 'node:path';
+import { listSkills, readSkillFileText } from './agent-runtime/skills';
+import type { Scene } from '@/lib/types/stage';
+
+export const MIRA_FORMAL_REPAIR_SKILL_MAX_BYTES = 120_000;
+export interface MiraFormalRepairSkillRead {
+  skillId: string;
+  resourcePath: string;
+  filePath: string;
+  sourceHash: string;
+  body: string;
+}
+
+/** Repair is a later phase, not another initial teaching method. Read the real
+ * manuals into the quality tool result so the next Agent turn has their bodies.
+ * A missing/oversized file fails closed instead of claiming that it was read. */
+export async function prepareMiraFormalRepairSkillContext(
+  ownerId: string,
+  scenes: readonly Scene[],
+  issues: readonly { sceneId: string; problem: string; repair: string }[],
+): Promise<{
+  schemaVersion: 'mira.openmaic.repair-skill-context.v1';
+  reads: MiraFormalRepairSkillRead[];
+}> {
+  if (
+    !issues.length ||
+    issues.some(
+      (issue) => issue.sceneId !== '' && !scenes.some((scene) => scene.id === issue.sceneId),
+    )
+  )
+    throw new Error('FORMAL_REPAIR_SKILL_ISSUES_INVALID');
+  const slideAffected = scenes.some(
+    (scene) =>
+      scene.type === 'slide' &&
+      issues.some((issue) => issue.sceneId === '' || issue.sceneId === scene.id),
+  );
+  const ids = ['pro-editing', 'stage-dsl', ...(slideAffected ? ['slide-dsl'] : [])];
+  const installed = await listSkills(ownerId);
+  const reads: MiraFormalRepairSkillRead[] = [];
+  let bytes = 0;
+  for (const id of ids) {
+    const skill = installed.find((entry) => entry.id === id && entry.source === 'builtin');
+    if (!skill) throw new Error(`FORMAL_REPAIR_SKILL_MISSING:${id}`);
+    const body = await readSkillFileText(skill);
+    bytes += Buffer.byteLength(body, 'utf8');
+    if (!body.trim() || bytes > MIRA_FORMAL_REPAIR_SKILL_MAX_BYTES)
+      throw new Error(`FORMAL_REPAIR_SKILL_BODY_INVALID:${id}`);
+    reads.push({
+      skillId: id,
+      resourcePath: `${id}/SKILL.md`,
+      filePath: resolve(skill.filePath),
+      sourceHash: createHash('sha256').update(body, 'utf8').digest('hex'),
+      body,
+    });
+  }
+  return { schemaVersion: 'mira.openmaic.repair-skill-context.v1', reads };
+}
