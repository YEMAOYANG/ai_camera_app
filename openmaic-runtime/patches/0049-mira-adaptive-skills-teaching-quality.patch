diff --git a/components/scene-renderers/formal-scene-preview.tsx b/components/scene-renderers/formal-scene-preview.tsx
new file mode 100644
--- /dev/null
+++ b/components/scene-renderers/formal-scene-preview.tsx
@@ -0,0 +1,137 @@
+'use client';
+
+import { useEffect, useMemo, useState, type SyntheticEvent } from 'react';
+import { SlideCanvas } from '@openmaic/renderer';
+import type { Scene } from '@/lib/types/stage';
+import { patchHtmlForIframe } from '@/lib/utils/iframe';
+import {
+  GENUI_LOGICAL_WIDTH,
+  GENUI_LOGICAL_HEIGHT,
+  fitGenUiViewport,
+} from '@/lib/interactive/logical-viewport';
+import { ScenePreviewReadOnlyContext } from '@/lib/contexts/scene-preview-read-only';
+import { resolvePBLContent, upgradeLegacyPBLConfigToProjectV2 } from '@/lib/pbl/legacy/read';
+import { QuizView } from './quiz-view';
+import { PBLV2Hero } from './pbl/v2/hero';
+import { PBLV2Workspace } from './pbl/v2/workspace';
+import type { FormalInspectionViewport } from '@/lib/types/formal-scene-inspection';
+
+const ignoreChange = () => {};
+
+/** This host deliberately does not initialize StageStore or a student session. */
+export function FormalScenePreview({
+  scene,
+  viewport,
+}: {
+  scene: Scene;
+  viewport: FormalInspectionViewport;
+}) {
+  const [ready, setReady] = useState(false);
+  useEffect(() => {
+    const frame = requestAnimationFrame(() => setReady(true));
+    return () => cancelAnimationFrame(frame);
+  }, []);
+  const content = scene.content;
+  const fit = fitGenUiViewport({ left: 0, top: 0, ...viewport });
+  return (
+    <ScenePreviewReadOnlyContext.Provider value={true}>
+      <main
+        id="formal-scene-root"
+        data-qa-ready={ready ? 'true' : 'false'}
+        data-scene-type={content.type}
+        style={{
+          width: viewport.width,
+          height: viewport.height,
+          overflow: 'hidden',
+          position: 'relative',
+        }}
+      >
+        {content.type === 'slide' && <SlideCanvas slide={content.canvas} chrome={false} />}
+        {content.type === 'interactive' &&
+          (content.html ? (
+            <iframe
+              id="formal-interactive-frame"
+              title={`Interactive Scene ${scene.id}`}
+              srcDoc={patchHtmlForIframe(content.html)}
+              sandbox="allow-scripts allow-forms allow-popups"
+              style={{
+                position: 'absolute',
+                left: fit.box.left,
+                top: fit.box.top,
+                width: GENUI_LOGICAL_WIDTH,
+                height: GENUI_LOGICAL_HEIGHT,
+                transform: `scale(${fit.scale})`,
+                transformOrigin: 'top left',
+                border: 0,
+              }}
+            />
+          ) : (
+            <div data-qa-unsupported="interactive_without_html">Interactive HTML unavailable</div>
+          ))}
+        {content.type === 'quiz' && (
+          <QuizView
+            questions={content.questions}
+            stageId={scene.stageId}
+            sceneId={scene.id}
+            readOnly
+          />
+        )}
+        {content.type === 'pbl' && <ReadOnlyPBL scene={scene} />}
+      </main>
+    </ScenePreviewReadOnlyContext.Provider>
+  );
+}
+
+function ReadOnlyPBL({ scene }: { scene: Scene }) {
+  const [phase, setPhase] = useState<'hero' | 'workspace'>('hero');
+  const project = useMemo(() => {
+    if (scene.content.type !== 'pbl') return null;
+    const resolved = resolvePBLContent(scene.content);
+    return resolved.kind === 'v2'
+      ? resolved.projectV2
+      : resolved.kind === 'legacy'
+        ? upgradeLegacyPBLConfigToProjectV2(resolved.projectConfig)
+        : null;
+  }, [scene.content]);
+  // Only the private local navigation controls can change this disposable view.
+  // Actual submit, upload, stage completion and dialogue handlers never execute.
+  const stopOperation = (event: SyntheticEvent) => {
+    if (!(event.target instanceof Element) || !event.target.closest('[data-qa-local-nav]')) {
+      event.preventDefault();
+      event.stopPropagation();
+    }
+  };
+  if (!project) return <div data-qa-unsupported="pbl_without_project">PBL project unavailable</div>;
+  return (
+    <div
+      data-qa-pbl-view={phase}
+      style={{ width: '100%', height: '100%' }}
+      onClickCapture={stopOperation}
+      onSubmitCapture={stopOperation}
+      onKeyDownCapture={stopOperation}
+      onChangeCapture={stopOperation}
+    >
+      {/* Inspector-only navigation is outside the viewport and screenshot. It
+        switches a local view; it never advances a learner or supplies fake chat. */}
+      <div data-qa-local-nav style={{ position: 'absolute', left: -10000 }}>
+        <button id="formal-pbl-show-workspace" onClick={() => setPhase('workspace')}>
+          Preview workspace
+        </button>
+        <button id="formal-pbl-show-hero" onClick={() => setPhase('hero')}>
+          Preview project entry
+        </button>
+      </div>
+      {phase === 'hero' ? (
+        <PBLV2Hero sceneId={scene.id} project={project} onProjectChange={ignoreChange} />
+      ) : (
+        <PBLV2Workspace
+          project={{ ...project, uiPhase: 'workspace' }}
+          onProjectChange={ignoreChange}
+          onReturnToHero={() => setPhase('hero')}
+          instructorStreaming={false}
+          onInstructorStreamingChange={ignoreChange}
+        />
+      )}
+    </div>
+  );
+}
