+/** Real Chrome proof, no model calls. FORMAL_INSPECTION_BROWSER=1 makes a missing
+ * executable a failure. Uses the actual SlideCanvas and actual iframe patcher;
+ * production Next route/Quiz/PBL integration is verified against the candidate. */
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import { createServer, type Server } from 'node:http';
+import { createRequire } from 'node:module';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import sharp from 'sharp';
+import type { AddressInfo } from 'node:net';
+import { patchHtmlForIframe } from '@/lib/utils/iframe';
+import { qualitySha, qualitySnapshot } from '@/lib/server/mira-formal-quality-contract';
+import {
+  FORMAL_PREVIEW_HEADER,
+  FORMAL_QUALITY_DIR,
+  readFormalPreview,
+} from '@/lib/server/mira-formal-preview-snapshot';
+import { createDefaultSlide, createDefaultTextElement } from '@/lib/edit/slide-edit-elements';
+import type { FormalSceneInspectionInput } from '@/lib/types/formal-scene-inspection';
+import type { Scene } from '@/lib/types/stage';
+
+const fixture = vi.hoisted(() => ({
+  sessionId: `inspector-browser-${process.pid}`,
+  stageId: 'stage-inspector-browser',
+  sceneId: 'scene-inspector-browser',
+}));
+vi.mock('@/lib/server/agent-runtime/curriculum-tools', () => ({
+  probeStageAccess: async () => ({ kind: 'owned' }),
+}));
+vi.mock('@/lib/server/agent-runtime/store', () => ({
+  getAgentSessionStore: async () => ({
+    getSession: async () => ({ ownerId: 'fixture-owner', stageId: 'stage-miraform-placeholder' }),
+  }),
+}));
+vi.mock('@/lib/server/agent-runtime/owner-scoped-documents', () => ({
+  getOwnerScopedDocumentStore: async () => ({
+    loadDocument: async () => ({
+      stage: { id: fixture.stageId },
+      scenes: [{ id: fixture.sceneId }],
+      outline: { producer: 'server-job', producerRef: fixture.sessionId },
+    }),
+  }),
+}));
+import { inspectFormalScene } from '@/lib/server/mira-formal-scene-inspector';
+import { CLASSROOMS_DIR } from '@/lib/server/classroom-storage';
+
+const required = process.env.FORMAL_INSPECTION_BROWSER === '1';
+const productionBaseUrl = process.env.MIRA_QA_REAL_PRODUCTION_BASE_URL;
+const stage = { id: fixture.stageId, name: '只读浏览器检查', createdAt: 1, updatedAt: 1 };
+function input(scene: Scene, viewport = { width: 1280, height: 720 }): FormalSceneInspectionInput {
+  return {
+    scene,
+    scenes: [scene],
+    stage,
+    viewport,
+    sceneIndex: 0,
+    ownerId: 'fixture-owner',
+    sessionId: fixture.sessionId,
+    snapshotSha256: qualitySha(qualitySnapshot(stage, [scene])),
+  };
+}
+function interactive(html: string): Scene {
+  return {
+    id: fixture.sceneId,
+    stageId: stage.id,
+    title: '数一数',
+    order: 0,
+    type: 'interactive',
+    content: { type: 'interactive', url: '', html },
+    actions: [],
+  };
+}
+const escape = (value: string) =>
+  value.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;');
+
+describe.skipIf(!required)('formal scene inspection in real isolated Chrome', () => {
+  let server: Server;
+  let bundle: string;
+  let forbiddenCalls = 0;
+  let canaryOrigin = '';
+  let imageBytes: Buffer;
+  const imageName = `inspection-${process.pid}.png`;
+  const imagePath = path.join(CLASSROOMS_DIR, stage.id, 'media', imageName);
+  beforeAll(async () => {
+    imageBytes = await sharp({
+      create: { width: 64, height: 64, channels: 3, background: '#28a745' },
+    })
+      .png()
+      .toBuffer();
+    await fs.mkdir(path.dirname(imagePath), { recursive: true });
+    await fs.writeFile(imagePath, imageBytes, { flag: 'wx' });
+    const require = createRequire(import.meta.url);
+    // tsx is a pinned dev tool already used by this repo. Its esbuild is only
+    // needed to mount the real renderer in this isolated HTTP test fixture.
+    const { build } = createRequire(require.resolve('tsx'))('esbuild');
+    const result = await build({
+      stdin: {
+        resolveDir: process.cwd(),
+        loader: 'tsx',
+        contents:
+          'import React from "react"; import {createRoot} from "react-dom/client"; import {SlideCanvas} from "@openmaic/renderer"; createRoot(document.getElementById("formal-scene-root")).render(React.createElement(SlideCanvas,{slide:window.fixture.content.canvas,chrome:false}));',
+      },
+      bundle: true,
+      write: false,
+      format: 'iife',
+      platform: 'browser',
+      define: { 'process.env.NODE_ENV': '"production"' },
+      loader: { '.css': 'empty' },
+      logLevel: 'silent',
+    });
+    bundle = result.outputFiles[0].text;
+    server = createServer(async (request, response) => {
+      if (
+        request.method === 'GET' &&
+        request.url?.startsWith(`/api/classroom-media/${stage.id}/media/`)
+      ) {
+        if (request.url === `/api/classroom-media/${stage.id}/media/${imageName}`) {
+          response.setHeader('content-type', 'image/png');
+          response.setHeader('access-control-allow-origin', '*');
+          response.end(imageBytes);
+        } else {
+          response.writeHead(404);
+          response.end();
+        }
+        return;
+      }
+      if (request.url === '/_next/static/inspection-test.js') {
+        response.setHeader('content-type', 'text/javascript');
+        response.end(bundle);
+        return;
+      }
+      if (request.url?.startsWith('/api/')) {
+        forbiddenCalls += 1;
+        response.writeHead(500);
+        response.end();
+        return;
+      }
+      const token = request.url?.split('/').at(-1) ?? '';
+      const snapshot =
