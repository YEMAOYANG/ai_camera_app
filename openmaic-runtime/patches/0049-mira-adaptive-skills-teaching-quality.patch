+
+const TIMEOUT_MS = 60 * 60 * 1_000;
+const TIMEOUT_ERROR = 'FORMAL_PROFESSIONAL_SESSION_TIMEOUT';
+const identity = {
+  sessionId: `miraformal_${'a'.repeat(64)}`,
+  ownerId: `mira-formal-professional:${'b'.repeat(64)}`,
+};
+
+function meta(patch: Partial<AgentSessionMeta> = {}): AgentSessionMeta {
+  return {
+    id: identity.sessionId,
+    ownerId: identity.ownerId,
+    skillId: 'mira-primary-courseware',
+    prompt: 'Persisted formal prompt',
+    stageId: 'formal-stage',
+    existingCourse: false,
+    status: 'running',
+    attempt: 1,
+    deliveredUserMessageSeq: 0,
+    createdAt: 0,
+    updatedAt: 0,
+    ...patch,
+  };
+}
+
+function expireOnFirstRead(session = meta()) {
+  mocks.getSession.mockImplementationOnce(async () => {
+    vi.setSystemTime(TIMEOUT_MS);
+    return session;
+  });
+}
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  vi.useFakeTimers();
+  vi.setSystemTime(0);
+  mocks.getSession.mockResolvedValue(meta());
+  mocks.requestCancel.mockResolvedValue(undefined);
+});
+
+afterEach(() => {
+  expect(mocks.createSession).not.toHaveBeenCalled();
+  vi.useRealTimers();
+});
+
+describe('formal Agent wait timeout cancellation', () => {
+  it.each(['queued', 'running'] as const)(
+    'requests durable cancellation of only the timed-out %s session',
+    async (status) => {
+      mocks.getSession.mockResolvedValue(meta({ status }));
+      expireOnFirstRead(meta({ status }));
+
+      await expect(waitForMiraFormalProfessionalSession(identity)).rejects.toThrow(TIMEOUT_ERROR);
+
+      expect(mocks.requestCancel).toHaveBeenCalledExactlyOnceWith(identity.sessionId);
+      expect(mocks.getSession.mock.calls.every(([id]) => id === identity.sessionId)).toBe(true);
+    },
+  );
+
+  it('waits for the cancellation write before reporting the historical timeout error', async () => {
+    expireOnFirstRead();
+    let beginCancel!: () => void;
+    const cancelStarted = new Promise<void>((resolve) => {
+      beginCancel = resolve;
+    });
+    let persistCancel!: () => void;
+    const cancelPersisted = new Promise<void>((resolve) => {
+      persistCancel = resolve;
+    });
+    mocks.requestCancel.mockImplementation(async () => {
+      beginCancel();
+      await cancelPersisted;
+    });
+    let settled = false;
+    const result = waitForMiraFormalProfessionalSession(identity).catch((error: Error) => {
+      settled = true;
+      return error;
+    });
+    await cancelStarted;
+    expect(settled).toBe(false);
+    persistCancel();
+    expect(await result).toMatchObject({ message: TIMEOUT_ERROR });
+    expect(mocks.requestCancel).toHaveBeenCalledTimes(1);
+  });
+
+  it('accepts success observed at the deadline without cancelling', async () => {
+    expireOnFirstRead(meta({ status: 'succeeded' }));
+    await expect(waitForMiraFormalProfessionalSession(identity)).resolves.toBeUndefined();
+    expect(mocks.requestCancel).not.toHaveBeenCalled();
+  });
+
+  it('rechecks a racing successful completion before requesting cancellation', async () => {
+    expireOnFirstRead();
+    mocks.getSession.mockResolvedValue(meta({ status: 'succeeded' }));
+    await expect(waitForMiraFormalProfessionalSession(identity)).resolves.toBeUndefined();
+    expect(mocks.getSession).toHaveBeenCalledTimes(2);
+    expect(mocks.requestCancel).not.toHaveBeenCalled();
+  });
+
+  it('accepts success racing the cancel write without rewriting the terminal session', async () => {
+    expireOnFirstRead();
+    mocks.requestCancel.mockImplementation(async () => {
+      mocks.getSession.mockResolvedValue(meta({ status: 'succeeded' }));
+    });
+    await expect(waitForMiraFormalProfessionalSession(identity)).resolves.toBeUndefined();
+    expect(mocks.requestCancel).toHaveBeenCalledExactlyOnceWith(identity.sessionId);
+    expect(mocks.getSession).toHaveBeenCalledTimes(3);
+  });
+
+  it.each(['failed', 'cancelled'] as const)(
+    'does not cancel an already %s session',
+    async (status) => {
+      expireOnFirstRead(meta({ status, error: 'existing terminal detail' }));
+      await expect(waitForMiraFormalProfessionalSession(identity)).rejects.toThrow(
+        `FORMAL_PROFESSIONAL_SESSION_${status.toUpperCase()}:existing terminal detail`,
+      );
+      expect(mocks.requestCancel).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each(['failed', 'cancelled'] as const)(
+    'does not send a cancellation when the expiry recheck finds %s',
+    async (status) => {
+      expireOnFirstRead();
+      mocks.getSession.mockResolvedValue(meta({ status }));
+      await expect(waitForMiraFormalProfessionalSession(identity)).rejects.toThrow(TIMEOUT_ERROR);
+      expect(mocks.requestCancel).not.toHaveBeenCalled();
+    },
+  );
+
+  it('preserves timeout and its diagnostic cause if durable cancellation fails', async () => {
+    expireOnFirstRead();
+    const failure = new Error('cancel transaction unavailable');
+    mocks.requestCancel.mockRejectedValue(failure);
+    await expect(waitForMiraFormalProfessionalSession(identity)).rejects.toMatchObject({
+      message: TIMEOUT_ERROR,
+      cause: failure,
+    });
+    expect(mocks.requestCancel).toHaveBeenCalledTimes(1);
+  });
+
+  it('fails the expiry recheck closed without cancelling an unverified session', async () => {
+    expireOnFirstRead();
+    const failure = new Error('session read unavailable');
+    mocks.getSession.mockRejectedValue(failure);
+    await expect(waitForMiraFormalProfessionalSession(identity)).rejects.toMatchObject({
+      message: TIMEOUT_ERROR,
+      cause: failure,
+    });
+    expect(mocks.requestCancel).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    { id: `miraformal_${'c'.repeat(64)}` },
+    { ownerId: `mira-formal-professional:${'c'.repeat(64)}` },
+    { skillId: 'other-skill' },
+  ])('does not cancel a mismatched formal identity: %j', async (patch) => {
+    expireOnFirstRead(meta(patch));
+    await expect(waitForMiraFormalProfessionalSession(identity)).rejects.toThrow(
+      'FORMAL_PROFESSIONAL_SESSION_CONFLICT',
+    );
+    expect(mocks.requestCancel).not.toHaveBeenCalled();
+  });
+
+  it('revalidates ownership immediately before cancellation', async () => {
+    expireOnFirstRead();
+    mocks.getSession.mockResolvedValue(meta({ ownerId: 'another-owner' }));
+    await expect(waitForMiraFormalProfessionalSession(identity)).rejects.toMatchObject({
+      message: TIMEOUT_ERROR,
+      cause: expect.objectContaining({ message: 'FORMAL_PROFESSIONAL_SESSION_CONFLICT' }),
+    });
+    expect(mocks.requestCancel).not.toHaveBeenCalled();
+  });
+
+  it('keeps ordinary polling and completion below the deadline free of cancellation', async () => {
+    const result = waitForMiraFormalProfessionalSession(identity);
+    await vi.advanceTimersByTimeAsync(2_000);
+    expect(mocks.requestCancel).not.toHaveBeenCalled();
+    mocks.getSession.mockResolvedValue(meta({ status: 'succeeded' }));
+    await vi.advanceTimersByTimeAsync(2_000);
+    await expect(result).resolves.toBeUndefined();
+    expect(mocks.requestCancel).not.toHaveBeenCalled();
+  });
+
+  it('does not cancel on a recoverable read failure before the deadline', async () => {
+    const failure = new Error('temporary read failure');
+    mocks.getSession.mockRejectedValue(failure);
+    await expect(waitForMiraFormalProfessionalSession(identity)).rejects.toBe(failure);
+    expect(mocks.requestCancel).not.toHaveBeenCalled();
+  });
+});
