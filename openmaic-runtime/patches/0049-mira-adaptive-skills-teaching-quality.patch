@@ -0,0 +1,51 @@
+import { randomBytes } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import type { FormalPreviewSnapshot } from '@/lib/types/formal-scene-inspection';
+import { qualitySceneProjection, qualitySha } from './mira-formal-quality-contract';
+
+export const FORMAL_PREVIEW_HEADER = 'x-mira-formal-preview';
+export const FORMAL_PREVIEW_ROUTE = '/internal/formal-scene-preview';
+export const FORMAL_QUALITY_DIR = path.join(process.cwd(), 'data', 'formal-quality');
+const pendingDirectory = () => path.join(FORMAL_QUALITY_DIR, '.pending');
+const validToken = (value: string) => /^[a-f0-9]{64}$/.test(value);
+
+/** Disk capabilities work across Next route bundles without process-global caches.
+ * Only trusted server code writes snapshots; the route accepts no scene body. */
+export async function registerFormalPreview(snapshot: FormalPreviewSnapshot): Promise<string> {
+  const token = randomBytes(32).toString('hex');
+  await fs.mkdir(pendingDirectory(), { recursive: true, mode: 0o700 });
+  await fs.writeFile(path.join(pendingDirectory(), `${token}.json`), JSON.stringify(snapshot), {
+    flag: 'wx',
+    mode: 0o600,
+  });
+  return token;
+}
+
+export async function readFormalPreview(
+  token: string | null,
+): Promise<FormalPreviewSnapshot | null> {
+  if (!token || !validToken(token)) return null;
+  try {
+    const value = JSON.parse(
+      await fs.readFile(path.join(pendingDirectory(), `${token}.json`), 'utf8'),
+    ) as FormalPreviewSnapshot;
+    if (
+      value.schemaVersion !== 1 ||
+      value.expiresAt <= Date.now() ||
+      value.expiresAt > Date.now() + 120_000 ||
+      qualitySha(value.scene) !== value.actualSourceSha256 ||
+      qualitySha(qualitySceneProjection(value.scene, value.sceneIndex)) !== value.sceneSha256 ||
+      value.scene.stageId !== value.stage.id
+    )
+      return null;
+    return value;
+  } catch {
+    return null;
+  }
+}
+
+export async function releaseFormalPreview(token: string): Promise<void> {
+  if (validToken(token))
+    await fs.rm(path.join(pendingDirectory(), `${token}.json`), { force: true });
+}
