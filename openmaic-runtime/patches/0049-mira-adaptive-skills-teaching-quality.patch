+import { headers } from 'next/headers';
+import { notFound } from 'next/navigation';
+import { FormalScenePreview } from '@/components/scene-renderers/formal-scene-preview';
+import {
+  FORMAL_PREVIEW_HEADER,
+  readFormalPreview,
+} from '@/lib/server/mira-formal-preview-snapshot';
+
+export const dynamic = 'force-dynamic';
+export const runtime = 'nodejs';
+
+export default async function FormalPreviewPage({
+  params,
+}: {
+  params: Promise<{ token: string }>;
+}) {
+  const { token } = await params;
+  if ((await headers()).get(FORMAL_PREVIEW_HEADER) !== token) notFound();
+  const snapshot = await readFormalPreview(token);
+  if (!snapshot) notFound();
+  return <FormalScenePreview scene={snapshot.scene} viewport={snapshot.viewport} />;
+}
