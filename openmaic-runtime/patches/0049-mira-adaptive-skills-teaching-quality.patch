+      (node) =>
+        pattern.test(node.text) &&
+        // Explicitly negated requirements are not positive evidence.
+        !new RegExp(
+          `(?:不要求|不涉及|不使用|不讲解|不讨论|无需|禁止|排除|避免).{0,12}(?:${expression})`,
+          'i',
+        ).test(node.text),
+    )
+    .map((node) => node.path);
+}
+
+export function selectMiraFormalSkills(
+  input: MiraFormalSelectionInput,
+): MiraFormalSkillSelectionPlan {
+  const boundary = assertMiraFormalSelectionInput(input);
+  const brief = record(input.teachingBrief);
+  const course = record(brief.course);
+  const lesson = record(brief.lesson);
+  const teach = record(record(lesson.teachingFlow).teach);
+  const goals: Evidence[] = [
+    { path: '/teachingBrief/course/objective', text: String(course.objective) },
+    ...boundary.learningObjectives.map((text, index) => ({
+      path: `/gradeBoundary/learningObjectives/${index}`,
+      text,
+    })),
+  ];
+  const allowed = boundary.allowedContent.map((text, index) => ({
+    path: `/gradeBoundary/allowedContent/${index}`,
+    text,
+  }));
+  const tasks: Evidence[] = [
+    { path: '/teachingBrief/lesson/teachingFlow/teach/sayText', text: String(teach.sayText) },
+    ...(teach.keyPoints as string[]).map((text, index) => ({
+      path: `/teachingBrief/lesson/teachingFlow/teach/keyPoints/${index}`,
+      text,
+    })),
+    ...(lesson.questions as unknown[]).map((question, index) => ({
+      path: `/teachingBrief/lesson/questions/${index}/prompt`,
+      text: String(record(question).prompt),
+    })),
+  ];
+  const signal = MIRA_FORMAL_SKILL_SIGNALS;
+  const explanation = [
+    matches(goals, signal.explanationGoal),
+    matches(allowed, signal.explanationAllowed),
+    matches(tasks, signal.explanationTeaching),
+  ];
+  const practice = [
+    matches([...goals, ...allowed], signal.practiceGoal),
+    matches(tasks, signal.practiceTask),
+  ];
+  const social = [matches([...goals, ...allowed], signal.social), matches(tasks, signal.social)];
+  const research = [
+    matches([...goals, ...allowed], signal.external),
+    matches(tasks, signal.external),
+  ];
+  const explanationFits = explanation.every((group) => group.length > 0);
+  const practiceFits = practice[0]!.length > 0 && practice[1]!.length >= 2;
+  const primaryMethod: MiraFormalSkillSelectionPlan['primaryMethod'] = explanationFits
+    ? 'feynman-learning'
+    : practiceFits
+      ? 'workshop-style'
+      : null;
+  const decisions: MiraFormalSkillDecision[] = MIRA_FORMAL_BUILTIN_SKILL_IDS.map((skillId) => {
+    const decision = (
+      status: MiraFormalSkillDecision['status'],
+      reasonCode: string,
+      evidencePaths: string[] = [],
+    ): MiraFormalSkillDecision => ({ skillId, status, reasonCode, evidencePaths });
+    if ((MIRA_FORMAL_BASE_SKILL_IDS as readonly string[]).includes(skillId))
+      return decision('selected', 'formal_primary_baseline', [
+        '/gradeBoundary/gradeCode',
+        '/gradeBoundary/subject',
+      ]);
+    switch (skillId) {
+      case 'understanding-by-design':
+        return decision('selected', 'bounded_goal_and_assessment_backward_design', [
+          '/teachingBrief/course/objective',
+          '/teachingBrief/lesson/questions',
+        ]);
+      case 'feynman-learning':
+        return explanationFits
+          ? decision('selected', 'explanation_goal_allowed_and_taught', explanation.flat())
+          : decision('not_applicable', 'no_supported_explanation_cycle');
+      case 'workshop-style':
+        return primaryMethod === 'workshop-style'
+          ? decision('selected', 'practice_goal_and_repeated_tasks', practice.flat())
+          : decision(
+              'not_applicable',
+              explanationFits ? 'primary_method_feynman_wins' : 'no_supported_practice_sequence',
+            );
+      case 'social-emotional-learning':
+        return social.every((group) => group.length > 0)
+          ? decision('selected', 'social_goal_and_concrete_learning_situation', social.flat())
+          : decision('not_applicable', 'no_explicit_social_learning_situation');
+      case 'deep-research':
+        return research.every((group) => group.length > 0)
+          ? decision('selected', 'external_fact_goal_and_teaching_evidence', research.flat())
+          : decision('not_applicable', 'stable_subject_formal_source_gate_suffices');
+      case 'lecture-style':
+        return decision('not_applicable', 'dense_masterclass_conflicts_with_primary_contract', [
+          '/gradeBoundary/gradeCode',
+        ]);
+      case 'pro-editing':
+      case 'stage-dsl':
+      case 'slide-dsl':
+        return decision('deferred', 'only_after_persisted_page_requires_repair');
+      case 'pptx-import':
+      case 'style-clone':
+      case 'page-clone':
+        return decision('not_applicable', 'no_authorized_layout_source_in_generated_single_course');
+      case 'teacher-style-clone':
+        return decision('not_applicable', 'no_authorized_teacher_material');
+      case 'curriculum-planner':
+      case 'spiral-curriculum':
+        return decision('not_applicable', 'single_course_not_series_or_cross_course_memory');
+      case 'build-personal-skill':
+        return decision('not_applicable', 'no_personal_history_or_skill_creation_request');
+      case 'vocational':
+        return decision('not_applicable', 'primary_subject_not_occupational_procedure', [
+          '/gradeBoundary/subject',
+        ]);
+    }
+    throw new Error(`FORMAL_SKILL_UNCLASSIFIED:${skillId}`);
+  });
+  const grade = Number(boundary.gradeCode.slice(-1));
+  const unsigned = {
+    schemaVersion: 'mira.openmaic.skill-selection.v1' as const,
+    registryId: MIRA_FORMAL_SKILL_REGISTRY_ID,
+    inputSha256: formalCanonicalSha256({
+      teachingBrief: input.teachingBrief,
+      gradeBoundary: boundary,
+    }),
+    gradeBoundarySha256: input.gradeBoundarySha256,
+    gradeBand:
+      grade <= 2
+        ? ('lower_primary' as const)
+        : grade <= 4
+          ? ('middle_primary' as const)
+          : ('upper_primary' as const),
+    primaryMethod,
+    selectedSkillIds: decisions
+      .filter((decision) => decision.status === 'selected')
+      .map((decision) => decision.skillId),
+    decisions,
+  };
+  return { ...unsigned, planSha256: formalCanonicalSha256(unsigned) };
+}
diff --git a/lib/server/mira-formal-teaching-quality.ts b/lib/server/mira-formal-teaching-quality.ts
