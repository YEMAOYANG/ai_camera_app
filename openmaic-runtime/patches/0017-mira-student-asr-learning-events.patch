+export function captureMiraAsrTurn(args: {
+  readonly scenes: readonly { readonly id: string; readonly order: number }[];
+  readonly currentSceneId: string | null;
+  readonly turnId: string;
+}): MiraAsrTurn | null {
+  const orderedScenes = [...args.scenes].sort((left, right) => left.order - right.order);
+  const sceneIndex = orderedScenes.findIndex((scene) => scene.id === args.currentSceneId);
+  if (sceneIndex < 0) return null;
+  return {
+    sceneIndex,
+    sceneId: orderedScenes[sceneIndex].id,
+    turnId: args.turnId,
+  };
+}
