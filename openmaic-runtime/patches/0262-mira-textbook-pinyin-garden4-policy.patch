+  it('matches the Python policy and leaves perceptual/formal approval pending', () => {
+    expect(registry.MIRA_TEXTBOOK_PINYIN_GARDEN4_PRONUNCIATION_POLICY).toEqual(policy);
+    expect(registry.MIRA_TEXTBOOK_PINYIN_GARDEN4_PRONUNCIATION_POLICY_SHA256).toBe(checksum);
+    expect(Object.keys(policy.symbols).sort())
+      .toEqual([...contrasts.map(([t]) => t), ...initials, ...finals, ...whole].sort());
+    expect(Object.keys(policy.symbols)).toHaveLength(74);
+    for (const key of ['humanListeningVerified', 'perceptualToneVerified', 'pronunciationApproved', 'formalUseAllowed'])
+      expect(policy.approvalBoundary[key]).toBe(false);
+    expect(policy.exactTextSsml).toBeUndefined();
+    expect(prepare('请听。', version).profile.policySha256).toBe(checksum);
+  });
+
+  it.each(contrasts)('keeps the complete contrast token %s, without vowel fragments', (token, phoneme) => {
