+}
+
+async function readPublishedMarker(
+  record: MiraSampleTtsCredentialRecoveryRecord,
+): Promise<PublishedChildMarker | null> {
+  try {
+    const marker = JSON.parse(
+      await fs.readFile(
+        path.join(finalClassroomPath(record.classroomId), 'artifact', 'publication.json'),
+        'utf8',
+      ),
+    ) as PublishedChildMarker;
+    if (
+      marker.schemaVersion !== 'mira.openmaic.tts-credential-publication.v1' ||
+      marker.recoveryId !== record.recoveryId ||
+      !validArtifact(marker.artifact, record.classroomId)
+    ) {
+      return null;
+    }
+    return marker;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+}
+
+async function reconcilePublished(
+  record: MiraSampleTtsCredentialRecoveryRecord,
+  nowIso: string,
+): Promise<MiraSampleTtsCredentialRecoveryRecord | null> {
+  if (record.status !== 'running') return null;
+  try {
+    await validateFrozenParentAndSource({
+      expectedParentRawSha256: record.parent.rawRecoveryFileSha256,
+      expectedSourceRawSha256: record.source.rawJobFileSha256,
+    });
+  } catch {
+    return null;
+  }
+  const marker = await readPublishedMarker(record);
+  if (!marker) return null;
+  if (record.calls.tts.attempted !== 10 || record.calls.tts.completed !== 10) return null;
+  return {
+    ...record,
+    status: 'succeeded',
+    step: 'completed',
+    progress: 100,
+    message: 'TTS credential recovery completed',
+    scenesGenerated: 10,
+    updatedAt: nowIso,
+    completedAt: nowIso,
+    artifact: marker.artifact,
+  };
+}
+
+async function reconcileOrExpire(
+  record: MiraSampleTtsCredentialRecoveryRecord,
+  nowMs: number,
+  nowIso: string,
+): Promise<MiraSampleTtsCredentialRecoveryRecord> {
+  const published = await reconcilePublished(record, nowIso);
+  if (published) return published;
+  if (record.status !== 'queued' && record.status !== 'running') return record;
+  const updatedAtMs = Date.parse(record.updatedAt);
+  if (
+    Number.isFinite(updatedAtMs) &&
+    nowMs - updatedAtMs < MIRA_SAMPLE_TTS_CREDENTIAL_RECOVERY_STALE_TIMEOUT_MS
+  ) {
+    return record;
+  }
+  return stableFailure(record, nowIso, true);
+}
+
+type ChildPatch = Partial<MiraSampleTtsCredentialRecoveryRecord>;
+
+async function compareAndSwap(
+  parentRecoveryId: string,
+  expectedStatuses: readonly MiraSampleTtsCredentialRecoveryStatus[],
+  makePatch: (current: MiraSampleTtsCredentialRecoveryRecord, nowIso: string) => ChildPatch,
+): Promise<{ record: MiraSampleTtsCredentialRecoveryRecord; applied: boolean }> {
+  return withChildLock(parentRecoveryId, async () => {
+    const current = await readExisting(parentRecoveryId);
+    if (!current) throw new Error('TTS credential recovery not found');
+    const nowMs = Date.now();
+    const nowIso = new Date(nowMs).toISOString();
+    const reconciled = await reconcileOrExpire(current, nowMs, nowIso);
+    if (reconciled !== current) {
+      await writeChildRecord(parentRecoveryId, reconciled);
+      if (reconciled.status !== current.status || reconciled.updatedAt !== current.updatedAt) {
+        return { record: reconciled, applied: false };
+      }
+    }
+    if (!expectedStatuses.includes(reconciled.status)) {
+      return { record: reconciled, applied: false };
+    }
+    const updated = { ...reconciled, ...makePatch(reconciled, nowIso), updatedAt: nowIso };
+    await writeChildRecord(parentRecoveryId, updated);
+    return { record: updated, applied: true };
+  });
+}
+
+export function getMiraSampleTtsCredentialRecoveryRuntimePolicy(): {
+  enabled: boolean;
+  sourceJobId: string;
+  parentRecoveryId: string;
+  policyVersion: typeof MIRA_SAMPLE_TTS_CREDENTIAL_RECOVERY_POLICY_VERSION;
+  canonicalSpecSha256: string;
+  patchSha256: string;
+} {
+  const plan = resolveMiraSampleStructuralPlan(MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER);
+  if (!plan) throw new Error('Mira sample deterministic plan unavailable');
+  const canonicalSpecSha256 = miraSampleCanonicalSpecSha256(plan);
+  if (canonicalSpecSha256 !== MIRA_SAMPLE_TTS_CREDENTIAL_CANONICAL_SPEC_SHA256) {
+    throw new Error('Mira sample TTS credential recovery canonical spec drifted');
+  }
+  return {
+    enabled: process.env.MIRA_OPENMAIC_TTS_CREDENTIAL_RECOVERY_ENABLED === '1',
+    sourceJobId: process.env.MIRA_OPENMAIC_TTS_CREDENTIAL_RECOVERY_SOURCE_JOB_ID || '',
+    parentRecoveryId:
+      process.env.MIRA_OPENMAIC_TTS_CREDENTIAL_RECOVERY_PARENT_RECOVERY_ID || '',
+    policyVersion: MIRA_SAMPLE_TTS_CREDENTIAL_RECOVERY_POLICY_VERSION,
+    canonicalSpecSha256,
+    patchSha256: process.env.MIRA_OPENMAIC_TTS_CREDENTIAL_RECOVERY_PATCH_SHA256 || '',
+  };
+}
+
+export async function claimMiraSampleTtsCredentialRecovery(input: {
+  sourceJobId: string;
+  parentRecoveryId: string;
+  recoveryRequestId: string;
+  patchSha256: string;
+  expectedParentRawSha256?: string;
+  expectedSourceRawSha256?: string;
+}): Promise<{ record: MiraSampleTtsCredentialRecoveryRecord; created: boolean }> {
+  if (
+    input.sourceJobId !== MIRA_SAMPLE_TTS_CREDENTIAL_SOURCE_JOB_ID ||
+    input.parentRecoveryId !== MIRA_SAMPLE_TTS_CREDENTIAL_PARENT_RECOVERY_ID ||
+    !validIdentifier(input.sourceJobId) ||
+    !validIdentifier(input.parentRecoveryId) ||
+    !validRecoveryRequestId(input.recoveryRequestId) ||
+    !/^[a-f0-9]{64}$/.test(input.patchSha256)
+  ) {
+    throw new MiraSampleTtsCredentialRecoveryError(
+      'invalid_recovery_request',
+      'Invalid TTS credential recovery request contract',
+    );
+  }
+  const requestIdSha256 = sha256(input.recoveryRequestId);
+  return withChildLock(input.parentRecoveryId, async () => {
+    const existing = await readExisting(input.parentRecoveryId);
+    if (existing) {
+      if (existing.requestIdSha256 !== requestIdSha256) {
+        throw new MiraSampleTtsCredentialRecoveryError(
+          'recovery_already_claimed',
+          'The parent recovery already has its single TTS credential child claimed',
+        );
+      }
+      const nowMs = Date.now();
+      const reconciled = await reconcileOrExpire(existing, nowMs, new Date(nowMs).toISOString());
+      if (reconciled !== existing) {
+        await writeChildRecord(input.parentRecoveryId, reconciled);
+      }
+      return { record: reconciled, created: false };
+    }
+
+    const frozen = await validateFrozenParentAndSource({
+      expectedParentRawSha256:
+        input.expectedParentRawSha256 || MIRA_SAMPLE_TTS_CREDENTIAL_PARENT_RAW_SHA256,
+      expectedSourceRawSha256:
+        input.expectedSourceRawSha256 || MIRA_SAMPLE_TTS_CREDENTIAL_SOURCE_RAW_SHA256,
+    });
+    const plan = resolveMiraSampleStructuralPlan(MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER);
+    if (!plan) throw new Error('Mira sample deterministic plan unavailable');
+    const canonicalSpecSha256 = miraSampleCanonicalSpecSha256(plan);
+    if (canonicalSpecSha256 !== MIRA_SAMPLE_TTS_CREDENTIAL_CANONICAL_SPEC_SHA256) {
+      throw new MiraSampleTtsCredentialRecoveryError(
+        'parent_recovery_mismatch',
+        'The deterministic classroom specification no longer matches the frozen parent',
+      );
+    }
+    const recoveryId = deriveMiraSampleTtsCredentialRecoveryId(
+      input.sourceJobId,
+      input.parentRecoveryId,
+      input.recoveryRequestId,
+    );
+    const classroomId = deriveMiraSampleTtsCredentialClassroomId(recoveryId);
+    await assertFreshArtifactTargets(recoveryId, classroomId);
+    const now = new Date().toISOString();
+    const record: MiraSampleTtsCredentialRecoveryRecord = {
+      schemaVersion: MIRA_SAMPLE_TTS_CREDENTIAL_RECOVERY_SCHEMA,
+      kind: MIRA_SAMPLE_TTS_CREDENTIAL_RECOVERY_KIND,
+      mode: MIRA_SAMPLE_TTS_CREDENTIAL_RECOVERY_MODE,
+      recoveryId,
+      requestIdSha256,
+      source: {
+        jobId: MIRA_SAMPLE_TTS_CREDENTIAL_SOURCE_JOB_ID,
+        rawJobFileSha256: frozen.sourceRawSha256,
+      },
+      parent: {
+        recoveryId: MIRA_SAMPLE_TTS_CREDENTIAL_PARENT_RECOVERY_ID,
+        status: 'failed',
+        error: { code: 'deterministic_recovery_failed' },
+        calls: { tts: { expected: 10, attempted: 1, completed: 0 } },
+        artifactAbsent: true,
+        parentSnapshotSha256: sha256(canonicalMiraSampleTtsCredentialParentSnapshot()),
+        parentSnapshotHashBasis: 'canonical_json_v1',
+        rawRecoveryFileSha256: frozen.parentRawSha256,
+      },
+      policy: {
+        version: MIRA_SAMPLE_TTS_CREDENTIAL_RECOVERY_POLICY_VERSION,
+        classroomPolicyVersion: MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION,
+        canonicalSpecSha256,
+        parentPatchSha256: MIRA_SAMPLE_TTS_CREDENTIAL_PARENT_PATCH_SHA256,
+        patchSha256: input.patchSha256,
+      },
+      calls: {
+        llm: 0,
+        webSearch: 0,
+        imageGeneration: 0,
+        videoGeneration: 0,
+        tts: { expected: 10, attempted: 0, completed: 0 },
+      },
+      status: 'queued',
+      step: 'queued',
+      progress: 0,
+      message: 'TTS credential recovery queued',
+      scenesGenerated: 0,
+      totalScenes: 10,
+      classroomId,
+      createdAt: now,
+      updatedAt: now,
+    };
+    await fs.writeFile(recordPath(input.parentRecoveryId), JSON.stringify(record, null, 2), {
+      encoding: 'utf8',
+      flag: 'wx',
+      mode: 0o600,
+    });
+    return { record, created: true };
+  });
+}
+
+export async function readMiraSampleTtsCredentialRecovery(
+  sourceJobId: string,
+  parentRecoveryId: string,
+): Promise<MiraSampleTtsCredentialRecoveryRecord | null> {
+  if (
+    sourceJobId !== MIRA_SAMPLE_TTS_CREDENTIAL_SOURCE_JOB_ID ||
+    parentRecoveryId !== MIRA_SAMPLE_TTS_CREDENTIAL_PARENT_RECOVERY_ID
+  ) {
+    return null;
+  }
+  return withChildLock(parentRecoveryId, async () => {
+    const current = await readExisting(parentRecoveryId);
+    if (!current) return null;
+    const nowMs = Date.now();
+    const nowIso = new Date(nowMs).toISOString();
+    const reconciled = await reconcileOrExpire(current, nowMs, nowIso);
+    if (reconciled !== current) {
+      await writeChildRecord(parentRecoveryId, reconciled);
+    }
+    return reconciled;
+  });
+}
+
+async function validateMaterializedArtifact(
+  storageDirectory: string,
+  record: MiraSampleTtsCredentialRecoveryRecord,
+  receipt: MiraSampleDeterministicReceipt,
+): Promise<MiraSampleTtsCredentialRecoveryArtifact> {
+  if (
+    receipt.kind !== 'mira_sample_deterministic_no_llm_v1' ||
+    receipt.mode !== 'deterministic_no_llm' ||
+    receipt.policyVersion !== MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION ||
+    receipt.canonicalSpecSha256 !== record.policy.canonicalSpecSha256 ||
+    receipt.calls.llm !== 0 ||
+    receipt.calls.webSearch !== 0 ||
+    receipt.calls.imageGeneration !== 0 ||
+    receipt.calls.videoGeneration !== 0 ||
+    receipt.calls.tts !== 10 ||
+    receipt.audio.length !== 10 ||
+    receipt.tts.providerId !== 'qwen-tts' ||
+    receipt.tts.modelId !== 'qwen3-tts-flash' ||
+    receipt.tts.voiceId !== 'Serena' ||
+    receipt.tts.speechCount !== 10 ||
+    receipt.tts.fallbackUsed !== false
+  ) {
+    throw new Error('Invalid deterministic TTS credential recovery receipt');
+  }
+  const rawClassroom = await fs.readFile(path.join(storageDirectory, 'classroom.json'), 'utf8');
+  const classroom = JSON.parse(rawClassroom) as { id: string; stage: Stage; scenes: Scene[] };
+  if (
+    classroom.id !== record.classroomId ||
+    classroom.stage?.id !== record.classroomId ||
+    !Array.isArray(classroom.scenes) ||
+    classroom.scenes.length !== 10
+  ) {
+    throw new Error('Invalid staged deterministic classroom');
+  }
+  assertMiraSampleClassroomStructure(classroom.stage, classroom.scenes);
+  assertMiraSampleDeterministicInteractiveContract(classroom.scenes);
+  const speeches = classroom.scenes.flatMap((scene) =>
+    (scene.actions || []).filter((action) => action.type === 'speech'),
+  );
+  const speechActionIds = new Set(speeches.map((speech) => speech.id));
+  const audioActionIds = new Set(receipt.audio.map((entry) => entry.actionId));
+  if (
+    speeches.length !== 10 ||
+    speechActionIds.size !== 10 ||
+    audioActionIds.size !== 10 ||
+    [...speechActionIds].some((actionId) => !audioActionIds.has(actionId)) ||
+    new Set(receipt.audio.map((entry) => entry.relativePath)).size !== 10 ||
+    new Set(receipt.audio.map((entry) => entry.sha256)).size !== 10
+  ) {
+    throw new Error('Invalid staged deterministic audio manifest');
+  }
+  for (const entry of receipt.audio) {
+    if (!/^audio\/[A-Za-z0-9_-]+\.wav$/.test(entry.relativePath)) {
+      throw new Error('Invalid staged deterministic audio path');
+    }
+    const bytes = await fs.readFile(path.join(storageDirectory, entry.relativePath));
+    if (
+      bytes.length !== entry.bytes ||
+      sha256(bytes) !== entry.sha256 ||
+      bytes.length < 44 ||
+      bytes.subarray(0, 4).toString('ascii') !== 'RIFF' ||
+      bytes.subarray(8, 12).toString('ascii') !== 'WAVE'
+    ) {
+      throw new Error('Invalid staged deterministic audio bytes');
+    }
+  }
+  const contentSha256 = sha256(JSON.stringify({ stage: classroom.stage, scenes: classroom.scenes }));
+  const artifactSha256 = sha256(JSON.stringify({ contentSha256, audio: receipt.audio }));
+  if (contentSha256 !== receipt.contentSha256 || artifactSha256 !== receipt.artifactSha256) {
+    throw new Error('Invalid staged deterministic artifact digest');
+  }
+  return {
+    classroomId: record.classroomId,
+    url: `/classroom/${record.classroomId}`,
+    sceneCount: 10,
+    audioCount: 10,
+    contentSha256,
+    artifactSha256,
+    tts: {
+      providerId: 'qwen-tts',
+      modelId: 'qwen3-tts-flash',
+      voiceId: 'Serena',
+      speechCount: 10,
+      fallbackUsed: false,
+    },
+  };
+}
+
+async function publishAndComplete(
+  parentRecoveryId: string,
+  receipt: MiraSampleDeterministicReceipt,
+): Promise<void> {
+  await withChildLock(parentRecoveryId, async () => {
+    const current = await readExisting(parentRecoveryId);
+    if (!current) throw new Error('TTS credential recovery not found');
+    const nowMs = Date.now();
+    const nowIso = new Date(nowMs).toISOString();
+    const reconciled = await reconcileOrExpire(current, nowMs, nowIso);
+    if (reconciled !== current) {
+      await writeChildRecord(parentRecoveryId, reconciled);
+      return;
+    }
+    if (
+      current.status !== 'running' ||
+      current.calls.tts.attempted !== 10 ||
+      current.calls.tts.completed !== 10
+    ) {
+      return;
+    }
+    const sourceParent = await validateFrozenParentAndSource({
+      expectedParentRawSha256: current.parent.rawRecoveryFileSha256,
+      expectedSourceRawSha256: current.source.rawJobFileSha256,
+    });
+    if (
+      sourceParent.parentRawSha256 !== current.parent.rawRecoveryFileSha256 ||
+      sourceParent.sourceRawSha256 !== current.source.rawJobFileSha256
+    ) {
+      throw new Error('Frozen recovery audit changed before publication');
+    }
+    const stagingDirectory = stagingPath(current.recoveryId);
+    const artifact = await validateMaterializedArtifact(stagingDirectory, current, receipt);
+    if (
+      (await pathExists(finalClassroomPath(current.classroomId))) ||
+      (await pathExists(legacyClassroomJsonPath(current.classroomId)))
+    ) {
+      throw new Error('TTS credential recovery final target already exists');
+    }
+    const marker: PublishedChildMarker = {
+      schemaVersion: 'mira.openmaic.tts-credential-publication.v1',
+      recoveryId: current.recoveryId,
+      artifact,
+    };
+    await writeJsonFileAtomic(path.join(stagingDirectory, 'publication.json'), marker);
+    await fs.mkdir(CLASSROOMS_DIR, { recursive: true });
+    const finalDirectory = finalClassroomPath(current.classroomId);
+    // mkdir is the exclusive, no-overwrite destination claim. The reserved
+    // directory contains no route-addressable artifact. A single rename into
+    // artifact/ then publishes the complete JSON + ten WAV files at once.
+    await fs.mkdir(finalDirectory, { recursive: false, mode: 0o700 });
+    try {
+      await fs.rename(stagingDirectory, path.join(finalDirectory, 'artifact'));
+    } catch (error) {
+      await fs.rmdir(finalDirectory).catch(() => undefined);
+      throw error;
+    }
+    const succeeded: MiraSampleTtsCredentialRecoveryRecord = {
+      ...current,
+      status: 'succeeded',
+      step: 'completed',
+      progress: 100,
+      message: 'TTS credential recovery completed',
+      scenesGenerated: 10,
+      updatedAt: nowIso,
+      completedAt: nowIso,
+      artifact,
+    };
+    await writeChildRecord(parentRecoveryId, succeeded);
+  });
+}
+
+const runningChildren = new Map<string, Promise<void>>();
+
+export function runMiraSampleTtsCredentialRecovery(
+  sourceJobId: string,
+  parentRecoveryId: string,
+): Promise<void> {
+  const existing = runningChildren.get(parentRecoveryId);
+  if (existing) return existing;
+  const task = (async () => {
+    try {
+      if (
+        sourceJobId !== MIRA_SAMPLE_TTS_CREDENTIAL_SOURCE_JOB_ID ||
+        parentRecoveryId !== MIRA_SAMPLE_TTS_CREDENTIAL_PARENT_RECOVERY_ID
+      ) {
+        return;
+      }
+      const started = await compareAndSwap(parentRecoveryId, ['queued'], (_current, nowIso) => ({
+        status: 'running',
+        step: 'initializing',
+        progress: 1,
+        message: 'TTS credential recovery started',
+        startedAt: nowIso,
+      }));
+      if (!started.applied) return;
+      await validateFrozenParentAndSource({
+        expectedParentRawSha256: started.record.parent.rawRecoveryFileSha256,
+        expectedSourceRawSha256: started.record.source.rawJobFileSha256,
+      });
+      await assertFreshArtifactTargets(started.record.recoveryId, started.record.classroomId);
+      await fs.mkdir(CLASSROOM_RECOVERY_STAGING_DIR, { recursive: true, mode: 0o700 });
+      await fs.chmod(CLASSROOM_RECOVERY_STAGING_DIR, 0o700);
+      const storageDirectory = stagingPath(started.record.recoveryId);
+      await fs.mkdir(storageDirectory, { recursive: false, mode: 0o700 });
+      const plan = resolveMiraSampleStructuralPlan(MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER);
+      if (!plan) throw new Error('Mira sample deterministic plan unavailable');
+      const result = await generateMiraSampleDeterministicClassroom(plan, {
+        baseUrl: '',
+        classroomId: started.record.classroomId,
+        storageDirectory,
+        onProgress: async (progress: MiraSampleDeterministicProgress) => {
+          const update = await compareAndSwap(parentRecoveryId, ['running'], () => ({
+            step: progress.step === 'completed' ? 'validating' : progress.step,
+            progress: Math.min(progress.progress, 98),
+            message:
+              progress.step === 'completed'
+                ? 'Validating isolated TTS credential recovery artifact'
+                : progress.message,
+            scenesGenerated: progress.scenesGenerated,
+          }));
+          if (!update.applied) throw new Error('TTS credential recovery is no longer running');
+        },
+        onTtsAttempted: async (attempted) => {
+          const update = await compareAndSwap(parentRecoveryId, ['running'], (current) => {
+            if (
+              attempted !== current.calls.tts.attempted + 1 ||
+              attempted > current.calls.tts.expected
+            ) {
+              throw new Error('Invalid TTS credential recovery attempt count');
+            }
+            return {
+              calls: {
+                ...current.calls,
+                tts: { ...current.calls.tts, attempted },
+              },
+            };
+          });
+          if (!update.applied) throw new Error('TTS credential recovery is no longer running');
+        },
+        onTtsProgress: async (completed) => {
+          const update = await compareAndSwap(parentRecoveryId, ['running'], (current) => {
+            if (
+              completed !== current.calls.tts.completed + 1 ||
+              completed > current.calls.tts.attempted
+            ) {
+              throw new Error('Invalid TTS credential recovery completion count');
+            }
+            return {
+              calls: {
+                ...current.calls,
+                tts: { ...current.calls.tts, completed },
+              },
+            };
+          });
+          if (!update.applied) throw new Error('TTS credential recovery is no longer running');
+        },
+      });
+      await publishAndComplete(parentRecoveryId, result.deterministicReceipt);
+    } catch (error) {
+      log.error(`TTS credential recovery ${parentRecoveryId} failed`, {
+        errorType: error instanceof Error ? error.name : 'unknown',
+      });
+      await compareAndSwap(parentRecoveryId, ['running'], (current, nowIso) =>
+        stableFailure(current, nowIso, false),
+      ).catch(() => undefined);
+    } finally {
+      runningChildren.delete(parentRecoveryId);
+    }
+  })();
+  runningChildren.set(parentRecoveryId, task);
+  return task;
+}
