+function exactParentRecord(value: unknown): value is MiraSampleDeterministicRecoveryRecord {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+  const parent = value as MiraSampleDeterministicRecoveryRecord;
+  return Boolean(
+    parent.schemaVersion === 'mira.openmaic.deterministic-recovery.v1' &&
+      parent.kind === 'mira_sample_deterministic_no_llm_v1' &&
+      parent.mode === 'deterministic_no_llm' &&
+      parent.recoveryId === MIRA_SAMPLE_TTS_CREDENTIAL_PARENT_RECOVERY_ID &&
+      parent.source?.jobId === MIRA_SAMPLE_TTS_CREDENTIAL_SOURCE_JOB_ID &&
+      parent.status === 'failed' &&
+      parent.error?.code === 'deterministic_recovery_failed' &&
+      parent.calls?.tts?.expected === 10 &&
+      parent.calls.tts.attempted === 1 &&
+      parent.calls.tts.completed === 0 &&
+      parent.artifact === undefined &&
+      parent.policy?.marker === MIRA_SAMPLE_STRUCTURAL_POLICY_MARKER &&
+      parent.policy.version === MIRA_SAMPLE_DETERMINISTIC_POLICY_VERSION &&
+      parent.policy.canonicalSpecSha256 === MIRA_SAMPLE_TTS_CREDENTIAL_CANONICAL_SPEC_SHA256 &&
+      parent.policy.patchSha256 === MIRA_SAMPLE_TTS_CREDENTIAL_PARENT_PATCH_SHA256,
+  );
+}
