+async function validateFrozenParentAndSource(input: {
+  expectedParentRawSha256: string;
+  expectedSourceRawSha256: string;
+}): Promise<{ parentRawSha256: string; sourceRawSha256: string }> {
+  const parentBytes = await fs.readFile(parentRecoveryPath(MIRA_SAMPLE_TTS_CREDENTIAL_SOURCE_JOB_ID));
+  const parentRawSha256 = sha256(parentBytes);
+  if (parentRawSha256 !== input.expectedParentRawSha256) {
+    throw new MiraSampleTtsCredentialRecoveryError(
+      'parent_recovery_mismatch',
+      'The frozen parent recovery bytes do not match the reviewed failed recovery',
+    );
+  }
+  let parent: unknown;
+  try {
+    parent = JSON.parse(parentBytes.toString('utf8'));
+  } catch {
+    throw new MiraSampleTtsCredentialRecoveryError(
+      'parent_recovery_mismatch',
+      'The frozen parent recovery is not valid JSON',
+    );
+  }
+  if (!exactParentRecord(parent)) {
+    throw new MiraSampleTtsCredentialRecoveryError(
+      'parent_recovery_mismatch',
+      'The parent recovery does not match the frozen failed TTS credential contract',
+    );
+  }
+
+  const sourceBytes = await fs.readFile(sourceJobPath(MIRA_SAMPLE_TTS_CREDENTIAL_SOURCE_JOB_ID));
+  const sourceRawSha256 = sha256(sourceBytes);
+  if (
+    sourceRawSha256 !== input.expectedSourceRawSha256 ||
+    sourceRawSha256 !== parent.source.rawJobFileSha256
+  ) {
+    throw new MiraSampleTtsCredentialRecoveryError(
+      'parent_recovery_mismatch',
+      'The frozen source job bytes do not match the parent recovery audit',
+    );
+  }
+  return { parentRawSha256, sourceRawSha256 };
+}
