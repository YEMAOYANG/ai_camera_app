+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+
+const mocks = vi.hoisted(() => ({
+  after: vi.fn(),
+  claim: vi.fn(),
+  read: vi.fn(),
+  run: vi.fn(),
+}));
+
+vi.mock('next/server', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('next/server')>()),
+  after: mocks.after,
+}));
+vi.mock('@/lib/server/mira-sample-tts-credential-recovery', () => ({
+  claimMiraSampleTtsCredentialRecovery: mocks.claim,
+  readMiraSampleTtsCredentialRecovery: mocks.read,
+  runMiraSampleTtsCredentialRecovery: mocks.run,
+  MiraSampleTtsCredentialRecoveryError: class extends Error {
+    constructor(
+      public code: string,
+      message: string,
+    ) {
+      super(message);
+    }
+  },
+}));
+
+const SOURCE_JOB_ID = 'uKQl3vMr4d';
+const PARENT_RECOVERY_ID = 'omrec_383729f8f7f637dc1cdc65d4';
+const ROUTE_PATH = `/api/generate-classroom/${SOURCE_JOB_ID}/deterministic-recovery/${PARENT_RECOVERY_ID}/tts-credential-recovery`;
+
+function record(status: 'queued' | 'running' | 'succeeded' | 'failed' = 'queued') {
+  return {
+    schemaVersion: 'mira.openmaic.tts-credential-recovery.v1',
+    kind: 'mira_sample_deterministic_tts_credential_recovery_v1',
+    mode: 'deterministic_no_llm_qwen_tts_only',
+    recoveryId: 'omtts_1234567890abcdefghijklmn',
+    requestIdSha256: 'internal-request-hash-must-not-leak',
+    source: {
+      jobId: SOURCE_JOB_ID,
+      rawJobFileSha256: 'raw-source-hash-must-not-leak',
+    },
+    parent: {
+      recoveryId: PARENT_RECOVERY_ID,
+      status: 'failed',
+      error: { code: 'deterministic_recovery_failed' },
+      calls: { tts: { expected: 10, attempted: 1, completed: 0 } },
+      artifactAbsent: true,
+      parentSnapshotSha256: 'a'.repeat(64),
+      parentSnapshotHashBasis: 'canonical_json_v1',
+      rawRecoveryFileSha256: 'raw-parent-hash-must-not-leak',
+    },
+    policy: {
+      version: 'mira-sample-tts-credential-recovery.v1',
+      classroomPolicyVersion: 'mira-sample-deterministic-classroom.v1',
+      canonicalSpecSha256: 'b'.repeat(64),
+      parentPatchSha256: 'c'.repeat(64),
+      patchSha256: 'd'.repeat(64),
+    },
+    calls: {
+      llm: 0,
+      webSearch: 0,
