+import { createHash, timingSafeEqual } from 'crypto';
+import { after, type NextRequest } from 'next/server';
+import { apiError, apiSuccess } from '@/lib/server/api-response';
+import {
+  claimMiraSampleTtsCredentialRecovery,
+  MiraSampleTtsCredentialRecoveryError,
+  readMiraSampleTtsCredentialRecovery,
+  runMiraSampleTtsCredentialRecovery,
+  type MiraSampleTtsCredentialRecoveryRecord,
+} from '@/lib/server/mira-sample-tts-credential-recovery';
+
+export const dynamic = 'force-dynamic';
+export const maxDuration = 3600;
+
+const RUNTIME_PORT = '3100';
+const LOOPBACK_HOSTNAMES = new Set(['localhost', '127.0.0.1', '::1']);
+
+function secureEqual(left: string, right: string): boolean {
+  const leftDigest = createHash('sha256').update(left).digest();
+  const rightDigest = createHash('sha256').update(right).digest();
+  return timingSafeEqual(leftDigest, rightDigest);
+}
+
+function singleHeader(req: NextRequest, name: string): string | null {
+  const value = req.headers.get(name);
+  if (
+    value === null ||
+    value.length === 0 ||
+    value !== value.trim() ||
+    value.includes(',') ||
+    /[%\s]/.test(value)
+  ) {
+    return null;
+  }
+  return value;
+}
+
+function normalizedLoopbackHostname(value: string): string | null {
+  const hostname = value.replace(/^\[|\]$/g, '').toLowerCase();
+  return LOOPBACK_HOSTNAMES.has(hostname) ? 'loopback' : null;
+}
+
+function exactLoopbackAuthority(value: string | null): boolean {
+  if (!value) return false;
+  try {
+    const parsed = new URL(`http://${value}`);
+    return Boolean(
+      !parsed.username &&
+        !parsed.password &&
+        parsed.pathname === '/' &&
+        !parsed.search &&
+        !parsed.hash &&
+        parsed.port === RUNTIME_PORT &&
+        normalizedLoopbackHostname(parsed.hostname),
+    );
+  } catch {
+    return false;
+  }
+}
+
+function directLoopback(req: NextRequest): boolean {
+  if (req.headers.has('forwarded') || req.headers.has('x-real-ip') || req.headers.has('via')) {
+    return false;
+  }
+  if (
+    req.nextUrl.protocol !== 'http:' ||
+    req.nextUrl.port !== RUNTIME_PORT ||
+    !normalizedLoopbackHostname(req.nextUrl.hostname)
+  ) {
+    return false;
+  }
+  return Boolean(
+    exactLoopbackAuthority(singleHeader(req, 'host')) &&
+      exactLoopbackAuthority(singleHeader(req, 'x-forwarded-host')) &&
+      normalizedLoopbackHostname(singleHeader(req, 'x-forwarded-for') || '') &&
+      singleHeader(req, 'x-forwarded-proto') === 'http' &&
+      singleHeader(req, 'x-forwarded-port') === RUNTIME_PORT,
+  );
+}
+
+function authorize(
+  req: NextRequest,
+  sourceJobId: string,
+  parentRecoveryId: string,
+): ReturnType<typeof apiError> | null {
+  if (process.env.MIRA_OPENMAIC_TTS_CREDENTIAL_RECOVERY_ENABLED !== '1') {
+    return apiError('PROVIDER_DISABLED', 404, 'TTS credential recovery is disabled');
+  }
+  if (
+    process.env.MIRA_OPENMAIC_TTS_CREDENTIAL_RECOVERY_SOURCE_JOB_ID !== sourceJobId ||
+    process.env.MIRA_OPENMAIC_TTS_CREDENTIAL_RECOVERY_PARENT_RECOVERY_ID !== parentRecoveryId
+  ) {
+    return apiError('INVALID_REQUEST', 404, 'TTS credential recovery source not found');
+  }
+  if (!directLoopback(req)) {
+    return apiError(
+      'INVALID_CREDENTIALS',
+      403,
+      'TTS credential recovery requires direct loopback access',
+    );
+  }
+  const expectedToken = process.env.MIRA_INTERNAL_API_TOKEN || '';
+  const suppliedToken = req.headers.get('x-mira-internal-token') || '';
+  if (!expectedToken || !suppliedToken || !secureEqual(expectedToken, suppliedToken)) {
+    return apiError('INVALID_CREDENTIALS', 403, 'Invalid TTS credential recovery credentials');
+  }
+  return null;
+}
+
+function responsePayload(record: MiraSampleTtsCredentialRecoveryRecord, req: NextRequest) {
+  return {
+    schemaVersion: record.schemaVersion,
+    kind: record.kind,
+    mode: record.mode,
+    recoveryId: record.recoveryId,
+    source: { jobId: record.source.jobId },
+    parent: {
+      recoveryId: record.parent.recoveryId,
+      status: record.parent.status,
+      error: record.parent.error,
+      calls: record.parent.calls,
+      artifactAbsent: record.parent.artifactAbsent,
+      parentSnapshotSha256: record.parent.parentSnapshotSha256,
+      parentSnapshotHashBasis: record.parent.parentSnapshotHashBasis,
+    },
+    policy: record.policy,
+    calls: record.calls,
+    status: record.status,
+    step: record.step,
+    progress: record.progress,
+    message: record.message,
+    scenesGenerated: record.scenesGenerated,
+    totalScenes: record.totalScenes,
+    createdAt: record.createdAt,
+    updatedAt: record.updatedAt,
+    ...(record.startedAt ? { startedAt: record.startedAt } : {}),
+    ...(record.completedAt ? { completedAt: record.completedAt } : {}),
+    ...(record.artifact ? { artifact: record.artifact } : {}),
+    ...(record.error ? { error: record.error } : {}),
+    pollUrl: req.nextUrl.pathname,
+    done: record.status === 'succeeded' || record.status === 'failed',
+  };
+}
+
+function responseStatus(record: MiraSampleTtsCredentialRecoveryRecord): number {
+  return record.status === 'queued' || record.status === 'running' ? 202 : 200;
+}
+
+type RouteContext = { params: Promise<{ jobId: string; recoveryId: string }> };
+
+export async function POST(req: NextRequest, context: RouteContext) {
+  const { jobId, recoveryId: parentRecoveryId } = await context.params;
+  const denied = authorize(req, jobId, parentRecoveryId);
+  if (denied) return denied;
+  try {
+    const rawBody: unknown = await req.json();
+    if (!rawBody || typeof rawBody !== 'object' || Array.isArray(rawBody)) {
+      return apiError('INVALID_REQUEST', 400, 'Invalid TTS credential recovery request contract');
+    }
+    const body = rawBody as Record<string, unknown>;
+    if (
+      Object.keys(body).join(',') !== 'recoveryRequestId' ||
+      typeof body.recoveryRequestId !== 'string'
+    ) {
+      return apiError('INVALID_REQUEST', 400, 'Invalid TTS credential recovery request contract');
+    }
+    const { record, created } = await claimMiraSampleTtsCredentialRecovery({
+      sourceJobId: jobId,
+      parentRecoveryId,
+      recoveryRequestId: body.recoveryRequestId,
+      patchSha256: process.env.MIRA_OPENMAIC_TTS_CREDENTIAL_RECOVERY_PATCH_SHA256 || '',
+    });
+    if (created) {
+      after(() => runMiraSampleTtsCredentialRecovery(jobId, parentRecoveryId));
+    }
+    return apiSuccess(responsePayload(record, req), responseStatus(record));
+  } catch (error) {
+    if (error instanceof MiraSampleTtsCredentialRecoveryError) {
+      const status =
+        error.code === 'recovery_already_claimed' ||
+        error.code === 'parent_recovery_mismatch' ||
+        error.code === 'recovery_target_exists'
+          ? 409
+          : 400;
+      return apiError('INVALID_REQUEST', status, error.message, error.code);
+    }
+    return apiError('INTERNAL_ERROR', 500, 'Failed to claim TTS credential recovery');
+  }
+}
+
+export async function GET(req: NextRequest, context: RouteContext) {
+  const { jobId, recoveryId: parentRecoveryId } = await context.params;
+  const denied = authorize(req, jobId, parentRecoveryId);
+  if (denied) return denied;
+  try {
+    const record = await readMiraSampleTtsCredentialRecovery(jobId, parentRecoveryId);
+    if (!record) return apiError('INVALID_REQUEST', 404, 'TTS credential recovery not found');
+    return apiSuccess(responsePayload(record, req), responseStatus(record));
+  } catch {
+    return apiError('INTERNAL_ERROR', 500, 'Failed to read TTS credential recovery');
+  }
+}
