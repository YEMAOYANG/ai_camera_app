+
+const childLocks = new Map<string, Promise<void>>();
+
+async function waitForLockRetry(): Promise<void> {
+  await new Promise<void>((resolve) => setTimeout(resolve, CHILD_LOCK_RETRY_MS));
+}
+
+async function withFileLock<T>(parentRecoveryId: string, fn: () => Promise<T>): Promise<T> {
+  await fs.mkdir(CLASSROOM_RECOVERY_CHILDREN_DIR, { recursive: true, mode: 0o700 });
+  await fs.chmod(CLASSROOM_RECOVERY_CHILDREN_DIR, 0o700);
+  const lockPath = recordLockPath(parentRecoveryId);
+  let handle: Awaited<ReturnType<typeof fs.open>> | null = null;
+  for (let attempt = 0; attempt < CHILD_LOCK_MAX_ATTEMPTS; attempt += 1) {
+    try {
+      handle = await fs.open(lockPath, 'wx', 0o600);
+      break;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+      try {
+        const stat = await fs.stat(lockPath);
+        if (Date.now() - stat.mtimeMs > CHILD_LOCK_STALE_TIMEOUT_MS) {
+          await fs.unlink(lockPath);
+          continue;
+        }
+      } catch (statError) {
+        if ((statError as NodeJS.ErrnoException).code === 'ENOENT') continue;
+        throw statError;
+      }
+      await waitForLockRetry();
+    }
+  }
+  if (!handle) throw new Error('Timed out acquiring TTS credential recovery lock');
+  try {
+    return await fn();
+  } finally {
+    await handle.close();
+    try {
+      await fs.unlink(lockPath);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+    }
+  }
+}
+
+async function withChildLock<T>(parentRecoveryId: string, fn: () => Promise<T>): Promise<T> {
+  const previous = childLocks.get(parentRecoveryId) ?? Promise.resolve();
+  let release!: () => void;
+  const next = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  childLocks.set(parentRecoveryId, next);
+  try {
+    await previous;
+    return await withFileLock(parentRecoveryId, fn);
+  } finally {
+    release();
+    if (childLocks.get(parentRecoveryId) === next) childLocks.delete(parentRecoveryId);
+  }
+}
+
+function stableFailure(
+  record: MiraSampleTtsCredentialRecoveryRecord,
+  nowIso: string,
+  expired: boolean,
+): MiraSampleTtsCredentialRecoveryRecord {
+  return {
+    ...record,
+    status: 'failed',
+    step: 'failed',
+    progress: 100,
+    message: expired
+      ? 'TTS credential recovery expired without persisted progress'
+      : 'TTS credential recovery failed',
+    updatedAt: nowIso,
+    completedAt: nowIso,
+    error: {
+      code: 'tts_credential_recovery_failed',
+      message: expired
+        ? 'TTS credential recovery expired after 15 minutes and will not be replayed'
+        : 'TTS credential recovery execution failed; inspect the server log',
+    },
+  };
+}
+
+function validArtifact(
+  artifact: MiraSampleTtsCredentialRecoveryArtifact,
+  classroomId: string,
+): boolean {
+  return Boolean(
+    artifact?.classroomId === classroomId &&
+      artifact.url === `/classroom/${classroomId}` &&
+      artifact.sceneCount === 10 &&
+      artifact.audioCount === 10 &&
+      /^[a-f0-9]{64}$/.test(artifact.contentSha256) &&
+      /^[a-f0-9]{64}$/.test(artifact.artifactSha256) &&
+      artifact.tts?.providerId === 'qwen-tts' &&
+      artifact.tts.modelId === 'qwen3-tts-flash' &&
+      artifact.tts.voiceId === 'Serena' &&
+      artifact.tts.speechCount === 10 &&
+      artifact.tts.fallbackUsed === false,
