+/* A fixed-canvas game needs a larger fitted viewport than reflowing activities.
+ * Keep the same toolbar and discussion controls in a bottom row and side gutters
+ * on short landscape screens. The existing fullscreen root and iframe stay put. */
+@media (min-width: 640px) and (min-height: 352px) and (max-height: 500px) and (orientation: landscape) {
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-canvas-area] {
+    box-sizing: border-box;
+    padding: 0 56px 52px;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-canvas-surround] {
+    padding: 0;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-presentation-toolbar] {
+    right: 0 !important;
+    padding-inline: 4px;
+    opacity: 1;
+    translate: none;
+    transform: none;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-presentation-toolbar] > div {
+    box-sizing: border-box;
+    width: 100%;
+    padding: 0;
+    margin: 0 0 2px;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-presentation-chrome] [data-mira-chrome='playback-controls'] {
+    display: flex !important;
+    flex-wrap: nowrap;
+    height: 48px;
+    min-height: 48px;
+    gap: 0;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-chrome='playback-controls'] > .flex-1 {
+    width: auto;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-chrome='playback-controls'] > .flex-1 > div {
+    width: auto;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-chrome='playback-controls'] [data-mira-whiteboard-toggle],
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-chrome='playback-controls'] [data-mira-live-control='continue'] {
+    position: relative;
+    top: auto;
+    right: auto;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-presentation-dock] {
+    right: 4px !important;
+    bottom: 64px;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-discussion-rail='dock'] {
+    flex-direction: column;
+    gap: 2px;
+    padding: 0;
+  }
+  [data-mira-classroom-root]:fullscreen [data-mira-fixed-game-landscape] [data-mira-left-speech] {
+    left: 4px;
+    bottom: 64px;
+  }
+}
