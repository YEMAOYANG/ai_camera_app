diff --git a/lib/interactive/activity-viewport.ts b/lib/interactive/activity-viewport.ts
new file mode 100644
--- /dev/null
+++ b/lib/interactive/activity-viewport.ts
@@ -0,0 +1,43 @@
+import { parse, type DefaultTreeAdapterTypes } from 'parse5';
+
+export type ActivityViewportMode = 'fixed' | 'responsive';
+
+export const RESPONSIVE_ACTIVITY_META = 'mira-responsive-activity';
+export const LOW_READING_ACTIVITY_PROFILE = 'low-reading-v1';
+
+function isElement(
+  node: DefaultTreeAdapterTypes.ChildNode,
+): node is DefaultTreeAdapterTypes.Element {
+  return !node.nodeName.startsWith('#');
+}
+
+/**
+ * Only an explicit, unambiguous head meta opts inline HTML into real CSS pixels.
+ * Parse inertly: comments, script strings, templates and body markup cannot opt
+ * in. This profile selects layout only; it does not certify content or targets.
+ * URL-backed and historical activities retain their fixed authoring viewport.
+ */
+export function activityViewportMode(html?: string): ActivityViewportMode {
+  if (!html || !/mira-responsive-activity/i.test(html)) return 'fixed';
+  const document = parse(html, { scriptingEnabled: true });
+  const htmlElement = document.childNodes.find(
+    (node): node is DefaultTreeAdapterTypes.Element => isElement(node) && node.tagName === 'html',
+  );
+  const head = htmlElement?.childNodes.find(
+    (node): node is DefaultTreeAdapterTypes.Element => isElement(node) && node.tagName === 'head',
+  );
+  const markers = head?.childNodes.filter(
+    (node): node is DefaultTreeAdapterTypes.Element =>
+      isElement(node) &&
+      node.tagName === 'meta' &&
+      node.attrs.some(
+        (attr) =>
+          attr.name === 'name' && attr.value.trim().toLowerCase() === RESPONSIVE_ACTIVITY_META,
+      ),
+  );
+  return markers?.length === 1 &&
+    markers[0].attrs.find((attr) => attr.name === 'content')?.value.trim() ===
+      LOW_READING_ACTIVITY_PROFILE
+    ? 'responsive'
+    : 'fixed';
+}
diff --git a/tests/scene-renderers/interactive-responsive-viewport.test.ts b/tests/scene-renderers/interactive-responsive-viewport.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/scene-renderers/interactive-responsive-viewport.test.ts
@@ -0,0 +1,157 @@
+// @vitest-environment jsdom
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { InteractiveIframeHost } from '@/components/scene-renderers/InteractiveIframeHost';
+import { activityViewportMode } from '@/lib/interactive/activity-viewport';
+import { fitGenUiViewport } from '@/lib/interactive/logical-viewport';
+import { useInteractiveIframePool } from '@/lib/store/interactive-iframe-pool';
+import { patchHtmlForIframe } from '@/lib/utils/iframe';
+
+vi.mock('@/lib/contexts/mira-student-runtime-context', () => ({
+  useMiraStudentRuntimeEvents: () => null,
+}));
+vi.mock('@/lib/mira/student-interaction-bridge', () => ({
+  studentInteractionObjectives: () => [],
+  connectStudentInteractionFrame: vi.fn(),
+  STUDENT_INTERACTION_OBSERVER: '',
+}));
+vi.mock('@/lib/hooks/use-i18n', () => ({ useI18n: () => ({ t: (key: string) => key }) }));
+
+const marker = '<meta name="mira-responsive-activity" content="low-reading-v1">';
+const page = (
+  head: string,
+  body = '<button style="min-width:48px;min-height:48px">Replay</button>',
+) => `<!doctype html><html><head>${head}</head><body>${body}</body></html>`;
+
+describe('responsive activity opt-in', () => {
+  it('recognizes one real head marker, including after iframe shims are injected', () => {
+    expect(activityViewportMode(page(marker))).toBe('responsive');
+    expect(activityViewportMode(patchHtmlForIframe(page(marker)))).toBe('responsive');
+    expect(
+      activityViewportMode(page("<META CONTENT='low-reading-v1' NAME='MIRA-RESPONSIVE-ACTIVITY'>")),
+    ).toBe('responsive');
+  });
+
+  it.each([
+    ['absent', page('')],
+    ['unknown profile', page(marker.replace('low-reading-v1', 'low-reading-v2'))],
+    ['duplicate', page(marker + marker)],
+    ['conflicting', page(marker + marker.replace('low-reading-v1', 'fixed'))],
+    ['comment', page(`<!-- ${marker} -->`)],
+    ['script string', page(`<script>const example = '${marker}';</script>`)],
+    ['template', page(`<template>${marker}</template>`)],
+    ['noscript', page(`<noscript>${marker}</noscript>`)],
+    ['body', page('', marker)],
+  ])('leaves %s markers in the legacy mode', (_label, html) => {
+    expect(activityViewportMode(html)).toBe('fixed');
+  });
+
+  it('keeps URL-only entries in legacy mode', () => {
+    expect(activityViewportMode()).toBe('fixed');
+  });
+});
+
+let root: Root | undefined;
+let messages: WeakMap<HTMLIFrameElement, ReturnType<typeof vi.fn>>;
+
+function frame() {
+  return document.querySelector('iframe[title="Interactive Scene one"]') as HTMLIFrameElement;
+}
+
+async function mountHost(html: string) {
+  const pool = useInteractiveIframePool.getState();
+  pool.mount('one', { srcDoc: html });
+  pool.claim('one', 'owner');
+  pool.setActive('one');
+  const container = document.createElement('div');
+  document.body.append(container);
+  root = createRoot(container);
+  await act(async () => root!.render(createElement(InteractiveIframeHost)));
+}
+
+describe('responsive host CSS viewport', () => {
+  beforeEach(() => {
+    vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true);
+    useInteractiveIframePool.getState().reset();
+    messages = new WeakMap();
+    vi.spyOn(HTMLIFrameElement.prototype, 'contentWindow', 'get').mockImplementation(function (
+      this: HTMLIFrameElement,
+    ) {
+      let post = messages.get(this);
+      if (!post) {
+        post = vi.fn();
+        messages.set(this, post);
+      }
+      return { postMessage: post } as unknown as Window;
+    });
+  });
+  afterEach(async () => {
+    await act(async () => root?.unmount());
+    root = undefined;
+    document.body.replaceChildren();
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+  });
+
+  it.each([360, 768, 1280])('uses the actual %ipx slot without scaling controls', async (width) => {
+    const rect = { left: 16, top: 88, width, height: 300 };
+    await mountHost(page(marker));
+    await act(async () => useInteractiveIframePool.getState().setRect('one', rect));
+    const iframe = frame();
+    expect(iframe.dataset.miraViewportMode).toBe('responsive');
+    expect(iframe.style.width).toBe(`${width}px`);
+    expect(iframe.style.height).toBe('300px');
+    expect(iframe.style.transform).toBe('none');
+    expect(iframe.parentElement!.style.width).toBe(`${width}px`);
+    expect(fitGenUiViewport(rect, 'responsive')).toEqual({ scale: 1, box: rect });
+    expect(iframe.getAttribute('sandbox')).toBe('allow-scripts allow-forms allow-popups');
+  });
+
+  it('reflows on resize without replacing the document and clips without resizing to the clip', async () => {
+    const html = page(marker);
+    await mountHost(html);
+    const iframe = frame();
+    const pool = useInteractiveIframePool.getState();
+    await act(async () => pool.setRect('one', { left: 20, top: 30, width: 768, height: 500 }));
+    await act(async () =>
+      pool.setRect(
+        'one',
+        { left: 20, top: 30, width: 360, height: 400 },
+        { left: 30, top: 80, width: 340, height: 300 },
+      ),
+    );
+    expect(frame()).toBe(iframe);
+    expect(iframe.srcdoc).toBe(html);
+    expect(iframe.style.width).toBe('360px');
+    expect(iframe.style.height).toBe('400px');
+    expect(iframe.style.left).toBe('-10px');
+    expect(iframe.style.top).toBe('-50px');
+    expect(iframe.parentElement!.style.width).toBe('340px');
+    expect(iframe.parentElement!.style.height).toBe('300px');
+    expect(iframe.parentElement!.style.overflow).toBe('hidden');
+    await act(async () => pool.setRect('one', { left: 20, top: 30, width: 0, height: 0 }));
+    expect(iframe.parentElement!.style.visibility).toBe('hidden');
+    await act(async () => iframe.dispatchEvent(new Event('load')));
+    expect(messages.get(iframe)!.mock.calls.at(-1)).toEqual([
+      { type: 'MIRA_NARRATION_VISIBILITY', visible: false },
+      '*',
+    ]);
+  });
+
+  it('preserves historical 1280x720 contain-fit behavior without an opt-in marker', async () => {
+    await mountHost(page(''));
+    await act(async () =>
+      useInteractiveIframePool.getState().setRect('one', {
+        left: 10,
+        top: 20,
+        width: 768,
+        height: 432,
+      }),
+    );
+    expect(frame().dataset.miraViewportMode).toBe('fixed');
+    expect(frame().style.width).toBe('1280px');
+    expect(frame().style.height).toBe('720px');
+    expect(frame().style.transform).toBe('scale(0.6)');
+  });
+});
