+describe('ZCS whole-token pronunciation identity', () => {
+  it('mirrors the frozen backend policy and physical-body vector', () => {
+    expect(policySha).toBe('5d311c9a903e00c9f819ec404af571bf21ef9a9caed229109ec7e2768e73815a');
+    const source = path.resolve(process.cwd(), '../../../backend/content/textbook_pinyin_pronunciation_zcs.v1.json');
+    if (existsSync(source)) expect(policy).toEqual(JSON.parse(readFileSync(source, 'utf8')));
+    expect(policy.inputParameters).toEqual(MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY.inputParameters);
+    expect(policy.listeningRequired).toBe(true);
+    expect(policy.approvalBoundary.formalUseAllowed).toBe(false);
+    const text = '请听：' + cases.map(([token]) => token).sort().join('，') + '。字、词、句、子；句子和孩子。';
+    const result = prepare(text, version);
+    expect(result.profile.ssmlSha256).toBe('1ff98e847ac4a526ad0492fe850a1c754e4eb858a85820ac5eb71d9fc6f3fad4');
+    expect(result.providerPronunciation.providerBodySha256)
+      .toBe('15439393da188e0d6639dc5ec62e5c172ef2aaad2ec4a8faaab2d129187ab0a4');
+    expect(Object.keys(result.profile).sort()).toEqual(['policySha256', 'policyVersion', 'ssmlSha256']);
+    expect(isMiraTextbookPinyinProviderPronunciation(result.providerPronunciation, sha(text))).toBe(true);
+    for (const prior of ['aoe', 'iuu', 'bpmf', 'dtnl', 'garden2', 'gkh', 'jqx']) {
+      expect(isMiraTextbookPinyinProviderPronunciation({ ...result.providerPronunciation,
+        policyVersion: `mira.textbook.pinyin-${prior}-ssml.v1` }, sha(text))).toBe(false);
+    }
+    expect(isMiraTextbookPinyinProviderPronunciation({ ...result.providerPronunciation, voiceId: 'Serena' }, sha(text))).toBe(false);
+  });
+
+  it('keeps whole recognition, neutral word and unrelated Chinese contexts separate', () => {
+    expect(Object.keys(policy.symbols).sort()).toEqual(cases.map(([token]) => token).sort());
+    for (const [token, ph, carrier] of cases) expect(prepare(`请听：${token}。`, version).ssml)
+      .toBe(`<speak>请听：<phoneme alphabet="py" ph="${ph}">${carrier}</phoneme>。</speak>`);
+    const whole = prepare('请听：zi、ci、si、zǐ、cì、sī。', version).ssml;
+    expect([...whole.matchAll(/ph="([a-z]+[1-5])"/g)].map(match => match[1]))
+      .toEqual(['zi1', 'ci1', 'si1', 'zi3', 'ci4', 'si1']);
+    expect(prepare('字、词、句、子；句子和孩子。', version).ssml)
+      .toBe('<speak>字、词、句、子；<phoneme alphabet="py" ph="ju4 zi5">句子</phoneme>和孩子。</speak>');
+    expect(policy.approvalBoundary.humanListeningVerified).toBe(false);
+    expect(policy.approvalBoundary.perceptualToneVerified).toBe(false);
+    expect(policy.approvalBoundary.shortConsonantAccepted).toBe(false);
+  });
