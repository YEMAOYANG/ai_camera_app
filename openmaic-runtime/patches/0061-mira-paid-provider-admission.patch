--- /dev/null
+++ b/tests/server/mira-paid-budget.test.ts
@@ -0,0 +1,207 @@
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest';
+import {
+  budgetedModel,
+  budgetedOperation,
+  withPaidBudget,
+  withPaidBudgetRequest,
+} from '@/lib/server/mira-paid-budget';
+const binding = {
+  schemaVersion: 'mira.learning.paid-budget-binding.v1',
+  authorizationId: 'a'.repeat(64),
+  required: true,
+};
+const usage = { inputTokens: { total: 30 }, outputTokens: { total: 20 } };
+let operations: Array<{ operation: string; body: any }>;
+let claims: Set<string>;
+let rejected = '';
+let providerCalls = 0;
+const model = () => ({
+  specificationVersion: 'v3' as const,
+  provider: 'fake',
+  modelId: 'fake-text',
+  supportedUrls: {},
+  doGenerate: async () => {
+    providerCalls++;
+    return {
+      content: [{ type: 'text', text: 'Hello' }],
+      finishReason: { unified: 'stop', raw: 'stop' },
+      usage,
+      warnings: [],
+    };
+  },
+  doStream: async () => {
+    providerCalls++;
+    return {
+      stream: new ReadableStream({
+        start(c) {
+          c.enqueue({ type: 'finish', finishReason: { unified: 'stop', raw: 'stop' }, usage });
+          c.close();
+        },
+      }),
+    };
+  },
+});
+const params = {
+  prompt: [{ role: 'user', content: [{ type: 'text', text: '中文问题' }] }],
+  maxOutputTokens: 100,
+};
+beforeEach(() => {
+  operations = [];
+  claims = new Set();
+  providerCalls = 0;
+  rejected = '';
+  vi.stubEnv('MIRA_BACKEND_INTERNAL_URL', 'http://fake-backend.invalid');
+  vi.stubEnv('MIRA_INTERNAL_API_TOKEN', 'fake-internal');
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(async (url, options) => {
+      const operation = new URL(String(url)).pathname.split('/').pop()!;
+      const body = JSON.parse(options.body);
+      operations.push({ operation, body });
+      if (rejected === operation) return Response.json({ ok: false }, { status: 429 });
+      if (operation === 'context')
+        return Response.json({
+          ok: true,
+          budget: {
+            prices: {
+              fake: {
+                provider: 'fake',
+                model: 'fake-text',
+                allowedUnits: ['calls', 'input_tokens', 'output_tokens'],
+                perCallMax: { calls: 1, input_tokens: 100000, output_tokens: 1000 },
+              },
+              media: {
+                provider: 'qwen-tts',
+                model: 'qwen3-tts-flash',
+                allowedUnits: ['calls', 'characters'],
+                perCallMax: { calls: 1, characters: 1000 },
+              },
+            },
+          },
+        });
+      if (operation === 'reserve')
+        return Response.json({
+          ok: true,
+          budget: { reservationId: body.dispatchId, dispatchAllowed: false },
+        });
+      if (operation === 'dispatch') {
+        const allowed = !claims.has(body.reservationId);
+        claims.add(body.reservationId);
+        return Response.json({ ok: true, budget: { dispatchAllowed: allowed } });
+      }
+      return Response.json({
+        ok: true,
+        budget: { state: operation === 'settle' ? 'settled' : 'unknown' },
+      });
+    }),
+  );
+});
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.unstubAllEnvs();
+});
+function call() {
+  return withPaidBudget(binding, 'job-a', () =>
+    (budgetedModel(model() as any, 'fake', 'fake-text') as any).doGenerate(params),
+  );
+}
+describe('paid provider admission', () => {
+  it('preserves old playback without inventing a budget grant', async () => {
+    await budgetedOperation('fake', 'old', {}, {}, async () => {
+      providerCalls++;
+    });
+    expect(providerCalls).toBe(1);
+    expect(operations).toHaveLength(0);
+  });
+  it('claims before sending and settles actual usage, including Chinese input', async () => {
+    await call();
+    expect(providerCalls).toBe(1);
+    expect(operations.map((o) => o.operation)).toEqual([
+      'context',
+      'reserve',
+      'dispatch',
+      'settle',
+    ]);
+    expect(operations[1].body.maxUnits.input_tokens).toBeGreaterThan(4096);
+    expect(operations[3].body.actualUnits).toEqual({
+      calls: 1,
+      input_tokens: 30,
+      output_tokens: 20,
+    });
+    expect(operations[3].body.providerRequestId).toBeNull();
+  });
+  it('does not send when reserve or dispatch authorization is unavailable', async () => {
+    rejected = 'reserve';
+    await expect(call()).rejects.toThrow('RESERVE_REJECTED');
+    expect(providerCalls).toBe(0);
+  });
+  it('does not redispatch identical work across a fresh async context', async () => {
+    await call();
+    await expect(call()).rejects.toThrow('DISPATCH_ALREADY_CLAIMED');
+    expect(providerCalls).toBe(1);
+  });
+  it('enforces an output ceiling instead of silently truncating teaching', async () => {
+    await expect(
+      withPaidBudget(binding, 'job-a', () =>
+        (budgetedModel(model() as any, 'fake', 'fake-text') as any).doGenerate({
+          ...params,
+          maxOutputTokens: 1001,
+        }),
+      ),
+    ).rejects.toThrow('RESOURCE_LIMIT');
+    expect(providerCalls).toBe(0);
+  });
+  it('captures streamed finish usage before releasing the hold', async () => {
+    const output = await withPaidBudget(binding, 'stream', () =>
+      (budgetedModel(model() as any, 'fake', 'fake-text') as any).doStream(params),
+    );
+    const reader = output.stream.getReader();
+    await reader.read();
+    await reader.read();
+    expect(operations.map((o) => o.operation)).toEqual([
+      'context',
+      'reserve',
+      'dispatch',
+      'settle',
+    ]);
+  });
+  it('retains the full reservation when a provider response is lost', async () => {
+    const failing = {
+      ...model(),
+      doGenerate: async () => {
+        providerCalls++;
+        throw new Error('connection lost');
+      },
+    };
+    await expect(
+      withPaidBudget(binding, 'job-a', () =>
+        (budgetedModel(failing as any, 'fake', 'fake-text') as any).doGenerate(params),
+      ),
+    ).rejects.toThrow('connection lost');
+    expect(operations.at(-1)?.operation).toBe('unknown');
+    expect(operations.some((o) => o.operation === 'settle')).toBe(false);
+  });
+  it('meters media units and rejects a forged browser authorization header', async () => {
+    await withPaidBudget(binding, 'tts', () =>
+      budgetedOperation(
+        'qwen-tts',
+        'qwen3-tts-flash',
