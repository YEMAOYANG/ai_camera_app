--- /dev/null
+++ b/lib/server/mira-paid-budget.ts
@@ -0,0 +1,356 @@
+/** Server-owned, pre-dispatch budget context. No provider credentials enter this protocol. */
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { createHash, timingSafeEqual } from 'node:crypto';
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { resolve, join } from 'node:path';
+import { wrapLanguageModel, type LanguageModel, type LanguageModelMiddleware } from 'ai';
+
+export interface PaidBudgetBinding {
+  schemaVersion: 'mira.learning.paid-budget-binding.v1';
+  authorizationId: string;
+  required: true;
+}
+type Price = {
+  provider: string;
+  model: string;
+  allowedUnits: string[];
+  perCallMax: Record<string, number>;
+};
+type Context = {
+  binding: PaidBudgetBinding;
+  namespace: string;
+  prices?: Promise<Record<string, Price>>;
+};
+const globals = globalThis as typeof globalThis & { __miraPaidBudget?: AsyncLocalStorage<Context> };
+export const paidBudgetContext = (globals.__miraPaidBudget ??= new AsyncLocalStorage<Context>());
+const sha = (value: unknown) => createHash('sha256').update(JSON.stringify(value)).digest('hex');
+export function parsePaidBudget(value: unknown): PaidBudgetBinding {
+  const b = value as PaidBudgetBinding;
+  if (
+    !b ||
+    Object.keys(b).sort().join(',') !== 'authorizationId,required,schemaVersion' ||
+    b.schemaVersion !== 'mira.learning.paid-budget-binding.v1' ||
+    b.required !== true ||
+    !/^[a-f0-9]{64}$/.test(b.authorizationId)
+  )
+    throw new Error('MIRA_PAID_BUDGET_BINDING_INVALID');
+  return b;
+}
+export function withPaidBudget<T>(binding: unknown, namespace: string, work: () => T): T {
+  if (binding === undefined) return work(); // Historical playback retains its existing caps.
+  return paidBudgetContext.run({ binding: parsePaidBudget(binding), namespace }, work);
+}
+export async function withPaidBudgetRequest(
+  req: Request,
+  work: () => Promise<Response>,
+): Promise<Response> {
+  const required = req.headers.get('x-mira-paid-budget-required');
+  const authorizationId = req.headers.get('x-mira-paid-budget-authorization');
+  if (!required && !authorizationId) return work();
+  const expected = process.env.MIRA_INTERNAL_API_TOKEN || '';
+  const supplied = req.headers.get('x-mira-internal-token') || '';
+  if (
+    required !== '1' ||
+    !expected ||
+    Buffer.byteLength(supplied) !== Buffer.byteLength(expected) ||
+    !timingSafeEqual(Buffer.from(expected), Buffer.from(supplied))
+  )
+    return Response.json({ error: 'MIRA_PAID_BUDGET_TRUST_REQUIRED' }, { status: 403 });
+  try {
+    const bodyHash = createHash('sha256')
+      .update(Buffer.from(await req.clone().arrayBuffer()))
+      .digest('hex');
+    return await withPaidBudget(
+      { schemaVersion: 'mira.learning.paid-budget-binding.v1', required: true, authorizationId },
+      `${new URL(req.url).pathname}:${bodyHash}`,
+      work,
+    );
+  } catch (error) {
+    if (String(error).includes('MIRA_PAID_BUDGET'))
+      return Response.json(
+        {
+          error: 'MIRA_PAID_BUDGET_UNAVAILABLE',
+          message: '互动暂时不可用，已准备好的课程可以继续学习。',
+        },
+        { status: 503 },
+      );
+    throw error;
+  }
+}
+async function backend(operation: string, body: unknown): Promise<Record<string, any>> {
+  const token = process.env.MIRA_INTERNAL_API_TOKEN;
+  const base = process.env.MIRA_BACKEND_INTERNAL_URL;
+  if (!token || !base) throw new Error('MIRA_PAID_BUDGET_SERVICE_UNCONFIGURED');
+  const response = await fetch(new URL(`/internal/learning/budget/${operation}`, base), {
+    method: 'POST',
+    redirect: 'error',
+    headers: {
+      'Content-Type': 'application/json',
+      'X-Mira-Internal-Token': token,
+      'X-Mira-Internal-Source': 'openmaic-runtime-gateway',
+    },
+    body: JSON.stringify(body),
+    signal: AbortSignal.timeout(15000),
+  });
+  const result = await response.json();
+  if (!response.ok || !result.ok || !result.budget)
+    throw new Error(`MIRA_PAID_BUDGET_${operation.toUpperCase()}_REJECTED`);
+  return result.budget;
+}
+export async function hasRequiredTeachingBudget(): Promise<boolean> {
+  const context = paidBudgetContext.getStore();
+  if (!context) return false;
+  const result = await backend('context', { authorizationId: context.binding.authorizationId });
+  return result.purpose === 'required_teaching';
+}
+async function authorizedPrice(provider: string, model: string): Promise<[string, Price]> {
+  const context = paidBudgetContext.getStore();
+  if (!context) throw new Error('MIRA_PAID_BUDGET_CONTEXT_REQUIRED');
+  const { authorizationId } = context.binding;
+  context.prices ??= backend('context', { authorizationId }).then((r) => r.prices);
+  const entries = Object.entries(await context.prices).filter(
+    ([, p]) => p.provider === provider && p.model === model,
+  );
+  if (entries.length !== 1) throw new Error('MIRA_PAID_BUDGET_PRICE_NOT_AUTHORIZED');
+  return entries[0];
+}
+async function reserve(
+  provider: string,
+  model: string,
+  request: unknown,
+  measured: Record<string, number>,
+) {
+  const context = paidBudgetContext.getStore();
+  if (!context) return undefined;
+  const { authorizationId } = context.binding;
+  const [priceKey, price] = await authorizedPrice(provider, model);
+  const maxUnits = Object.fromEntries(
+    price.allowedUnits.map((unit) => [unit, price.perCallMax[unit]]),
+  );
+  for (const [unit, value] of Object.entries(measured)) {
+    if (!Number.isSafeInteger(value) || value < 0 || !(unit in maxUnits) || value > maxUnits[unit])
+      throw new Error('MIRA_PAID_BUDGET_RESOURCE_LIMIT');
+    maxUnits[unit] = value;
+  }
+  if (
+    price.allowedUnits.some((unit) => !Number.isSafeInteger(maxUnits[unit]) || maxUnits[unit] < 0)
+  )
+    throw new Error('MIRA_PAID_BUDGET_RESOURCE_LIMIT');
+  const requestSha256 = sha({ provider, model, request, maxUnits });
+  const dispatchId = `runtime:${sha([authorizationId, context.namespace, requestSha256])}`;
+  const reservation = await backend('reserve', {
+    authorizationId,
+    dispatchId,
+    requestSha256,
+    priceKey,
+    maxUnits,
+  });
+  const claim = await backend('dispatch', {
+    authorizationId,
+    reservationId: reservation.reservationId,
+    requestSha256,
+  });
+  if (claim.dispatchAllowed !== true) throw new Error('MIRA_PAID_BUDGET_DISPATCH_ALREADY_CLAIMED');
+  const identity = { authorizationId, reservationId: reservation.reservationId };
+  let completed = false;
+  return {
+    async unknown() {
+      if (completed) return;
+      completed = true;
+      // A failed notification does not release anything: durable dispatched state is still held.
+      await backend('unknown', { ...identity, reasonCode: 'provider_result_unknown' }).catch(
+        () => undefined,
+      );
+    },
+    async finish(actual: Record<string, number> | undefined) {
+      if (completed) return;
+      if (
+        !actual ||
+        price.allowedUnits.some((u) => !Number.isSafeInteger(actual[u]) || actual[u] < 0)
+      ) {
+        completed = true;
+        await backend('unknown', { ...identity, reasonCode: 'provider_usage_missing' }).catch(
+          () => undefined,
+        );
+        return;
+      }
+      const actualUnits = Object.fromEntries(price.allowedUnits.map((u) => [u, actual[u]]));
+      await backend('settle', {
+        ...identity,
+        actualUnits,
+        providerRequestId: null,
+        evidenceSha256: sha(actualUnits),
+      });
+      completed = true;
+    },
+  };
+}
+function tokenUsage(usage: any) {
+  const input =
+    typeof usage?.inputTokens === 'number' ? usage.inputTokens : usage?.inputTokens?.total;
+  const output =
+    typeof usage?.outputTokens === 'number' ? usage.outputTokens : usage?.outputTokens?.total;
+  return Number.isSafeInteger(input) && Number.isSafeInteger(output)
+    ? { calls: 1, input_tokens: input, output_tokens: output }
+    : undefined;
+}
+/** V3 middleware is called for EACH provider step, including multi-step tool calls. */
+export function budgetedModel(
+  model: LanguageModel,
+  provider: string,
+  modelId: string,
+): LanguageModel {
+  if (!paidBudgetContext.getStore()) return model;
+  if (typeof model === 'string' || model.specificationVersion !== 'v3')
+    throw new Error('MIRA_PAID_BUDGET_MODEL_UNSUPPORTED');
+  const middleware: LanguageModelMiddleware = {
+    specificationVersion: 'v3',
+    transformParams: async ({ params }) => {
+      const [, price] = await authorizedPrice(provider, modelId);
+      const maximum = params.maxOutputTokens ?? price.perCallMax.output_tokens;
+      if (!Number.isSafeInteger(maximum) || maximum < 1)
+        throw new Error('MIRA_PAID_BUDGET_RESOURCE_LIMIT');
+      return { ...params, maxOutputTokens: maximum };
+    },
+    wrapGenerate: async ({ doGenerate, params }) => {
+      // Unknown binary vision tokenization cannot safely use a character estimate.
+      const serialized = JSON.stringify({ prompt: params.prompt, tools: params.tools });
+      if (
+        params.prompt.some(
+          (m) => Array.isArray(m.content) && m.content.some((p) => p.type === 'file'),
+        )
+      )
+        throw new Error('MIRA_PAID_BUDGET_VISION_METER_UNAVAILABLE');
+      const ticket = await reserve(
+        provider,
+        modelId,
+        {
+          prompt: params.prompt,
+          tools: params.tools,
+          providerOptions: params.providerOptions,
+          maxOutputTokens: params.maxOutputTokens,
+        },
+        {
+          calls: 1,
+          input_tokens: Buffer.byteLength(serialized) + 4096,
+          output_tokens: params.maxOutputTokens ?? Number.MAX_SAFE_INTEGER,
+        },
+      );
+      try {
+        const result = await doGenerate();
+        await ticket?.finish(tokenUsage(result.usage));
+        return result;
+      } catch (error) {
+        await ticket?.unknown();
+        throw error;
+      }
+    },
+    wrapStream: async ({ doStream, params }) => {
+      const serialized = JSON.stringify({ prompt: params.prompt, tools: params.tools });
+      if (
+        params.prompt.some(
+          (m) => Array.isArray(m.content) && m.content.some((p) => p.type === 'file'),
+        )
+      )
+        throw new Error('MIRA_PAID_BUDGET_VISION_METER_UNAVAILABLE');
+      const ticket = await reserve(
+        provider,
+        modelId,
+        {
+          prompt: params.prompt,
+          tools: params.tools,
+          providerOptions: params.providerOptions,
+          maxOutputTokens: params.maxOutputTokens,
+        },
+        {
+          calls: 1,
+          input_tokens: Buffer.byteLength(serialized) + 4096,
+          output_tokens: params.maxOutputTokens ?? Number.MAX_SAFE_INTEGER,
+        },
+      );
+      try {
+        const result = await doStream();
+        const reader = result.stream.getReader();
+        return {
+          ...result,
+          stream: new ReadableStream({
+            async pull(controller) {
+              try {
+                const next = await reader.read();
+                if (next.done) {
+                  await ticket?.unknown();
+                  controller.close();
+                  return;
+                }
+                if (next.value.type === 'finish')
+                  await ticket?.finish(tokenUsage(next.value.usage));
+                if (next.value.type === 'error') await ticket?.unknown();
+                controller.enqueue(next.value);
+              } catch (error) {
+                await ticket?.unknown();
+                controller.error(error);
+              }
+            },
+            async cancel(reason) {
+              await ticket?.unknown();
+              await reader.cancel(reason);
+            },
+          }),
+        };
+      } catch (error) {
+        await ticket?.unknown();
+        throw error;
+      }
+    },
+  };
+  return wrapLanguageModel({ model, middleware });
+}
+export async function budgetedOperation<T>(
+  provider: string,
+  model: string,
+  request: unknown,
+  measurement: Record<string, number>,
+  work: () => Promise<T>,
+): Promise<T> {
+  const ticket = await reserve(provider, model, request, measurement);
+  try {
+    const result = await work();
+    await ticket?.finish(measurement);
+    return result;
+  } catch (error) {
+    await ticket?.unknown();
+    throw error;
+  }
+}
+// Media modules are client-transitive. They use this bridge without importing Node builtins.
+(globalThis as any).__miraBudgetBridge = {
+  active: () => Boolean(paidBudgetContext.getStore()),
+  run: budgetedOperation,
+};
+const bindingRoot = () => resolve('data/formal-paid-budget-bindings');
+export async function persistSessionPaidBudget(sessionId: string, binding: unknown) {
+  if (binding === undefined) return;
+  const parsed = parsePaidBudget(binding);
+  if (!/^miraformal_[a-f0-9]{64}$/.test(sessionId))
+    throw new Error('MIRA_PAID_BUDGET_SESSION_INVALID');
+  await mkdir(bindingRoot(), { recursive: true, mode: 0o700 });
+  const file = join(bindingRoot(), `${sessionId}.json`);
+  try {
+    await writeFile(file, JSON.stringify(parsed), { flag: 'wx', mode: 0o600 });
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+  }
+  if (sha(JSON.parse(await readFile(file, 'utf8'))) !== sha(parsed))
+    throw new Error('MIRA_PAID_BUDGET_SESSION_CONFLICT');
+}
+export async function readSessionPaidBudget(sessionId: string, required = false) {
+  if (!/^miraformal_[a-f0-9]{64}$/.test(sessionId)) return undefined;
+  try {
+    return parsePaidBudget(
+      JSON.parse(await readFile(join(bindingRoot(), `${sessionId}.json`), 'utf8')),
+    );
+  } catch (error) {
+    if (!required && (error as NodeJS.ErrnoException).code === 'ENOENT') return undefined;
+    throw error;
+  }
+}
