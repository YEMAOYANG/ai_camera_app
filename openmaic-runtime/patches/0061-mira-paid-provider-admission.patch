+++ b/lib/mira-paid-budget-bridge.ts
@@ -0,0 +1,69 @@
+/** Client-safe bridge: only a trusted server context can activate paid metering. */
+interface Bridge {
+  active(): boolean;
+  run<T>(
+    provider: string,
+    model: string,
+    request: unknown,
+    measurement: Record<string, number>,
+    work: () => Promise<T>,
+  ): Promise<T>;
+}
+const bridge = () =>
+  (globalThis as typeof globalThis & { __miraBudgetBridge?: Bridge }).__miraBudgetBridge;
+export const hasPaidBudget = () => bridge()?.active() === true;
+export function meteredOperation<T>(
+  provider: string,
+  model: string,
+  request: unknown,
+  measurement: Record<string, number>,
+  work: () => Promise<T>,
+) {
+  return bridge()?.active() ? bridge()!.run(provider, model, request, measurement, work) : work();
+}
+
+/** Verify PCM timing from actual bytes; client-supplied duration is never trusted. */
+export function pcmWavDurationMs(bytes: Uint8Array): number {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const tag = (offset: number) => String.fromCharCode(...bytes.subarray(offset, offset + 4));
+  const fail = () => {
+    throw new Error('MIRA_PAID_BUDGET_ASR_WAV_INVALID');
+  };
+  if (
+    bytes.length < 44 ||
+    tag(0) !== 'RIFF' ||
+    tag(8) !== 'WAVE' ||
+    view.getUint32(4, true) + 8 !== bytes.length
+  )
+    fail();
+  let rate = 0,
+    alignment = 0,
+    dataSize = 0;
+  for (let offset = 12; offset + 8 <= bytes.length; ) {
+    const size = view.getUint32(offset + 4, true),
+      end = offset + 8 + size;
+    if (end > bytes.length) fail();
+    if (tag(offset) === 'fmt ') {
+      if (rate || size < 16 || view.getUint16(offset + 8, true) !== 1) fail();
+      const channels = view.getUint16(offset + 10, true),
+        sampleRate = view.getUint32(offset + 12, true);
+      const bits = view.getUint16(offset + 22, true);
+      alignment = view.getUint16(offset + 20, true);
+      rate = view.getUint32(offset + 16, true);
+      if (
+        channels < 1 ||
+        channels > 8 ||
+        ![8, 16, 24, 32].includes(bits) ||
+        sampleRate < 8000 ||
+        sampleRate > 192000 ||
+        alignment !== (channels * bits) / 8 ||
+        rate !== sampleRate * alignment
+      )
+        fail();
+    }
+    if (tag(offset) === 'data') dataSize += size;
+    offset = end + (size % 2);
+  }
+  if (!rate || !dataSize || dataSize % alignment) fail();
+  return Math.ceil((dataSize / rate) * 1000);
+}
