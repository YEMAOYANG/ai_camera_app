new file mode 100644
--- /dev/null
+++ b/lib/server/mira-textbook-quiz-locked-question-review.ts
@@ -0,0 +1,97 @@
+/** Pure, bounded review of one rejected quiz. No files, DB, provider, or policy mutation. */
+import { createHash } from 'node:crypto';
+import { textbookCanonical, textbookDigest, type FrozenTextbookContract } from './mira-textbook-scene-contract';
+
+type Json = Record<string, any>;
+const object = (v: unknown): v is Json => !!v && typeof v === 'object' && !Array.isArray(v);
+const check = (v: unknown, code: string): void => { if (!v) throw new Error(`TEXTBOOK_REPAIR_QUIZ_LOCKED_${code}`); };
+const textHash = (v: string) => createHash('sha256').update(v, 'utf8').digest('hex');
+const owns = (v: Json, key: string) => Object.prototype.hasOwnProperty.call(v, key);
+const quizAudioKeys = new Set(['questionaudiourl', 'feedbackaudiourl', 'questionaudiometadata', 'questionaudiobinding']);
+function containsAudio(value: unknown): boolean {
+  if (Array.isArray(value)) return value.some(containsAudio);
+  return object(value) && Object.entries(value).some(([key, v]) => /^audio/i.test(key) || quizAudioKeys.has(key.toLowerCase()) || containsAudio(v));
+}
+
+/**
+ * Caller bytes are only a proposal. Reconstruct the only permitted result from
+ * the immutable original and frozen question, then require exact equality.
+ * This deliberately does not infer, add, or rewrite a frozen speechPlan.
+ */
+export function inspectQuizLockedQuestionReview(
+  original: Json, revised: Json, frozen: FrozenTextbookContract, archiveSceneSha256: string,
+) {
+  check(object(original) && object(revised) && original.type === 'quiz' && revised.type === 'quiz'
+    && original.content?.type === 'quiz' && revised.content?.type === 'quiz', 'ONLY');
+  check(/^[a-f0-9]{64}$/.test(archiveSceneSha256) && textbookDigest(original) === archiveSceneSha256, 'ORIGINAL_SHA');
+  check(object(frozen?.contract) && frozen.sha256 === textbookDigest(frozen.contract), 'FROZEN_SHA');
+  check(!containsAudio(original) && !containsAudio(revised), 'AUDIO_PRESENT');
+  check(['id', 'stageId', 'order', 'title', 'type'].every(k => original[k] === revised[k]), 'IDENTITY');
+  const pages = frozen.contract.pagePlan;
+  const page = Array.isArray(pages) ? pages[original.order - 1] : undefined;
+  check(page !== undefined && page.page === original.order && page.type === 'quiz' && page.title === original.title, 'PAGE');
+  const questions = original.content.questions;
+  check(Array.isArray(questions) && questions.length === 1 && object(questions[0])
+    && Array.isArray(revised.content.questions) && revised.content.questions.length === 1, 'QUESTION_COUNT');
+  const q = questions[0], next = revised.content.questions[0];
+  check(object(next), 'QUESTION_COUNT');
+  check(Array.isArray(page?.questionIds) && page.questionIds.length === 1 && page.questionIds[0] === q.id, 'QUESTION_ID');
+  const locks = frozen.contract.lockedAssessments;
+  check(Array.isArray(locks) && locks.filter(l => l.id === q.id).length === 1
+    && locks.filter(l => l.page === original.order).length === 1, 'LOCK_COUNT');
+  const lock = locks.find(l => l.id === q.id)!;
+  check(lock.page === original.order && lock.type === 'single' && typeof lock.question === 'string'
+    && lock.question.trim().length > 0 && lock.question !== lock.analysis
+    && (lock.questionSpeechRequired === undefined || lock.questionSpeechRequired === lock.question), 'LOCK');
+  check(Array.isArray(lock.choices) && lock.choices.length >= 2 && lock.choices.length <= 8
+    && new Set(lock.choices.map((c: Json) => c.value)).size === lock.choices.length, 'CHOICES');
+  const answer = Array.isArray(lock.answer) ? lock.answer : [lock.answer];
+  check(answer.length === 1 && lock.choices.some((c: Json) => c.value === answer[0]), 'ANSWER');
+  const expectedQuestion = { id: lock.id, type: lock.type, question: lock.question, points: lock.points,
+    options: lock.choices.map((c: Json) => ({ value: c.value, label: c.label })), answer, analysis: lock.analysis };
+  const lockedFields = Object.fromEntries(Object.keys(expectedQuestion).map(k => [k, q[k]]));
+  check(q.hasAnswer === true && textbookCanonical(lockedFields) === textbookCanonical(expectedQuestion), 'QUESTION_CHANGED');
+  check(object(q.optionVisuals) && Object.keys(q.optionVisuals).sort().join('\0')
+    === lock.choices.map((c: Json) => c.value).sort().join('\0'), 'PICTURES');
+  for (const visual of Object.values(q.optionVisuals)) {
+    check(object(visual) && Object.keys(visual).sort().join(',') === 'alt,kind,src'
+      && visual.kind === 'image' && typeof visual.alt === 'string' && visual.alt.trim().length > 0
+      && typeof visual.src === 'string' && visual.src.startsWith(`/api/classroom-media/${original.stageId}/media/`)
+      && /^\/api\/classroom-media\/[A-Za-z0-9_-]+\/media\/[A-Za-z0-9_.-]+\.png$/.test(visual.src), 'PICTURES');
+  }
+  const actions: Json[] = original.actions;
+  check(Array.isArray(actions) && actions.length > 0 && actions.every(a => object(a)
+    && typeof a.id === 'string' && /^[A-Za-z0-9_-]{1,128}$/.test(a.id))
+    && new Set(actions.map(a => a.id)).size === actions.length, 'ACTIONS');
+  const speechIndexes = actions.flatMap((a, i) => a.type === 'speech' ? [i] : []);
+  check(speechIndexes.length === 1, 'SPEECH_COUNT');
+  const speechIndex = speechIndexes[0], speech = actions[speechIndex];
+  check(typeof speech.text === 'string' && speech.text.trim().length > 0 && speech.text !== lock.question, 'ORIGINAL_SPEECH');
+  const expected = structuredClone(original);
+  expected.actions[speechIndex].text = lock.question;
+  let removedAnswerReference: Json | null = null;
+  if (owns(q, 'visual') && !owns(next, 'visual')) {
+    check(!['visualAsset', 'visual', 'targetVisual', 'targetVisualAsset'].some(k => owns(lock, k)), 'REQUIRED_VISUAL');
+    const visual = q.visual, correctVisual = q.optionVisuals[answer[0]];
+    check(object(visual) && Object.keys(visual).sort().join(',') === 'alt,kind,src'
+      && visual.kind === 'image' && typeof visual.alt === 'string' && visual.alt.trim().length > 0
+      && visual.src === correctVisual.src, 'NONANSWER_VISUAL');
+    removedAnswerReference = { path: 'content.questions[0].visual', originalVisual: structuredClone(visual),
+      originalVisualSha256: textbookDigest(visual), correctOptionValue: answer[0],
+      correctOptionVisualSha256: textbookDigest(correctVisual), sameImageSrc: visual.src };
+    delete expected.content.questions[0].visual;
+  }
+  // All timestamps, identities, order, question leaves, pictures, action IDs,
+  // non-speech actions, metadata and other fields remain exactly as archived.
+  check(textbookCanonical(revised) === textbookCanonical(expected), 'EXACT_DIFF');
+  const body = { schemaVersion: 'mira.textbook.quiz-locked-question-review.v1',
+    verification: 'static_only_not_play_audio_or_publication', frozenContractSha256: frozen.sha256,
+    originalSceneSha256: archiveSceneSha256, revisedSceneSha256: textbookDigest(revised),
+    sceneId: original.id, stageId: original.stageId, order: original.order, questionId: q.id,
+    unchangedQuestionFieldsSha256: textbookDigest(expectedQuestion), unchangedOptionVisualsSha256: textbookDigest(q.optionVisuals),
+    speechReplacement: { actionId: speech.id, actionIndex: speechIndex, originalText: speech.text,
+      originalTextSha256: textHash(speech.text), revisedText: lock.question, revisedTextSha256: textHash(lock.question),
+      originalActionSha256: textbookDigest(speech), revisedActionSha256: textbookDigest(revised.actions[speechIndex]) },
+    removedAnswerReference, providerCalls: 0 };
+  return { ...body, sha256: textbookDigest(body) };
+}
