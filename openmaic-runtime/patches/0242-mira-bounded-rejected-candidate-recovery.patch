+++ b/tests/agent-runtime/textbook-literal-js-cue-source.test.ts
@@ -0,0 +1,139 @@
+import { createHash } from 'node:crypto';
+import { describe, expect, it } from 'vitest';
+import { extractLiteralJsCueSource } from '@/lib/server/mira-textbook-literal-js-cue-source';
+import { deriveRejectedSpeechManifest, restoreDerivedSpeech } from '@/lib/server/mira-textbook-derived-speech-repair';
+
+const hash = (value: string | Buffer) => createHash('sha256').update(value).digest('hex');
+const sha = 'a'.repeat(64);
+const literal = '{ schemaVersion: "mira.interactive.narration-cues.v1", cues: [{ id: "one", text: "lüè" }] }';
+const recipe = (value = literal) => `const narrationCuesData = ${value};
+const cuesScript = document.createElement('script');
+cuesScript.type = 'application/json';
+cuesScript.id = 'mira-narration-cues';
+cuesScript.textContent = JSON.stringify(narrationCuesData);
+document.head.appendChild(cuesScript);`;
+const dynamicHtml = (code = recipe()) => `<html><body>字<script>(function() {\n${code}\n})();</script></body></html>`;
+const staticHtml = (cues: { id: string; text: string }[]) => '<script id="mira-narration-cues" type="application/json">' + JSON.stringify({ schemaVersion: 'mira.interactive.narration-cues.v1', cues }) + '</script>';
+const scene = (html = dynamicHtml()) => ({ id: 'p6', order: 1, title: '两格书页', type: 'interactive',
+  content: { type: 'interactive', html }, actions: [{ id: 'speech', type: 'speech', text: '先听。' }] });
+const frozen = { sceneContract: { contract: { pagePlan: [{ page: 1, type: 'interactive', title: '两格书页' }] } } };
+
+describe('bounded immutable JavaScript cue source', () => {
+  it('reads the literal without executing the script and binds every source range to its original bytes', () => {
+    const html = dynamicHtml(recipe() + '\nthrow new Error("this code must never execute");');
+    const before = html;
+    const extracted = extractLiteralJsCueSource(html);
+    expect(extracted.cues).toEqual([{ id: 'one', text: 'lüè' }]);
+    expect(extracted.witness.cueCount).toBe(1);
+    expect(extracted.witness.sourceHtmlSha256).toBe(hash(html));
+    for (const range of [extracted.witness.scriptElement, extracted.witness.scriptBody, extracted.witness.literal, extracted.witness.construction]) {
+      expect(hash(html.slice(range.startOffset, range.endOffset))).toBe(range.sha256);
+      expect(hash(Buffer.from(html).subarray(range.startByte, range.endByte))).toBe(range.sha256);
+    }
+    const { startOffset, endOffset } = extracted.witness.literal;
+    expect(html.slice(startOffset, endOffset)).toBe(literal);
+    expect(extractLiteralJsCueSource(html)).toEqual(extracted);
+    expect(html).toBe(before);
+  });
+
+  it('adds provenance only for the new original-source branch and retains all original actions', () => {
+    const original = scene(), before = JSON.stringify(original);
+    const manifest = deriveRejectedSpeechManifest(original, sha);
+    expect(manifest.expectedCues.map(cue => cue.text)).toEqual(['lüè', '先听。']);
+    expect(manifest.literalJsCueSource).toEqual(extractLiteralJsCueSource(original.content.html).witness);
+    const revised = scene(staticHtml(manifest.expectedCues));
+    revised.actions = [];
+    expect(restoreDerivedSpeech(original, revised, frozen, sha)).toEqual(manifest);
+    expect(revised.actions).toEqual([...original.actions, ...manifest.addedSpeech]);
+    expect(JSON.stringify(original)).toBe(before);
+    const dynamicRevised = scene(dynamicHtml(recipe(JSON.stringify({ schemaVersion: 'mira.interactive.narration-cues.v1', cues: manifest.expectedCues }))));
+    expect(() => restoreDerivedSpeech(original, dynamicRevised, frozen, sha)).toThrow('CUE_CONTAINER');
+    const drift = scene(staticHtml(manifest.expectedCues.map(cue => ({ ...cue, text: cue.text + '。' }))));
+    expect(() => restoreDerivedSpeech(original, drift, frozen, sha)).toThrow('REVISED_CUE_UNION');
+  });
+
+  it('keeps the pre-change static manifest byte hash, including when unrelated JavaScript is present', () => {
+    const html = staticHtml([{ id: 'one', text: 'lüè' }]);
+    for (const input of [html, html + '<script>window.cues=[];</script>']) {
+      const manifest = deriveRejectedSpeechManifest(scene(input), sha);
+      expect(manifest).not.toHaveProperty('literalJsCueSource');
+      // Captured from the unchanged baseline module before this branch existed.
+      expect(hash(JSON.stringify(manifest))).toBe('ba421243b932fb21ad7f129fb0a60815248caebee4f40753afa6e5937a613240');
+    }
+  });
+
+  it.each([
+    ['dynamic text', literal.replace('"lüè"', 'getText()')],
+    ['identifier text', literal.replace('"lüè"', 'voiceText')],
+    ['template text', literal.replace('"lüè"', '`lüè`')],
+    ['template expression', literal.replace('"lüè"', '`lu${tone}`')],
+    ['spread', literal.replace('cues:', '...extra, cues:')],
+    ['computed key', literal.replace('text:', '["text"]:')],
+    ['getter', literal.replace('text: "lüè"', 'get text() { return "lüè"; }')],
+    ['shorthand', literal.replace('text: "lüè"', 'text')],
+    ['duplicate key', literal.replace('id: "one"', 'id: "one", "id": "other"')],
+    ['duplicate schema key', literal.replace('cues:', 'schemaVersion: "mira.interactive.narration-cues.v1", cues:')],
+    ['extra field', literal.replace('text: "lüè"', 'text: "lüè", extra: "no"')],
+    ['wrong schema', literal.replace('narration-cues.v1', 'narration-cues.v2')],
+    ['unsafe id', literal.replace('"one"', '"../one"')],
+    ['blank text', literal.replace('"lüè"', '" "')],
+    ['long text', literal.replace('"lüè"', JSON.stringify('字'.repeat(1001)))],
+    ['duplicate id', literal.replace('{ id: "one", text: "lüè" }', '{ id: "one", text: "lüè" }, { id: "one", text: "nüè" }')],
+    ['empty array', '{schemaVersion:"mira.interactive.narration-cues.v1",cues:[]}'],
+    ['oversize array', JSON.stringify({ schemaVersion: 'mira.interactive.narration-cues.v1', cues: Array.from({ length: 121 }, (_, i) => ({ id: 'id' + i, text: '字' + i })) })],
+  ])('rejects nonliteral or invalid payload: %s', (_label, value) => {
+    expect(() => deriveRejectedSpeechManifest(scene(dynamicHtml(recipe(value))), sha)).toThrow('TEXTBOOK_REPAIR_DERIVED_SPEECH_LITERAL_JS_');
+  });
+
+  it.each([
+    ['let', recipe().replace('const narrationCuesData', 'let narrationCuesData')],
+    ['const reassignment', recipe() + '\nnarrationCuesData = {};'],
+    ['member mutation', recipe() + '\nnarrationCuesData.cues[0].text = "改写";'],
+    ['array mutation', recipe() + '\nnarrationCuesData.cues.push({id:"other",text:"改写"});'],
+    ['alias', recipe() + '\nconst alias = narrationCuesData;'],
+    ['nested mutation', recipe() + '\nfunction later(){ narrationCuesData.cues.length = 0; }'],
+    ['shadow redeclaration', recipe() + '\nfunction later(){ const narrationCuesData = {}; }'],
+    ['node rewrite', recipe() + '\ncuesScript.textContent = "{}";'],
+    ['wrong node', recipe().replace("cuesScript.id =", "otherScript.id =")],
+    ['missing append', recipe().replace('document.head.appendChild(cuesScript);', '')],
+    ['append different node', recipe().replace('appendChild(cuesScript)', 'appendChild(otherScript)')],
+    ['unbound JSON data', recipe().replace('stringify(narrationCuesData)', 'stringify(otherData)')],
+    ['intervening code', recipe().replace("cuesScript.type =", "doSomething(); cuesScript.type =")],
+    ['conditional binding', recipe().replace("cuesScript.id = 'mira-narration-cues';", "if (flag) cuesScript.id = 'mira-narration-cues';")],
+    ['JSON override', recipe() + '\nJSON.stringify = function(){ return "{}"; };'],
+    ['JSON alias', recipe() + '\nconst alias = JSON;'],
+    ['document override', recipe() + '\ndocument.createElement = custom;'],
+    ['document shadow', recipe() + '\nfunction later(document){}'],
+    ['eval', recipe() + '\neval("change()");'],
+    ['Function', recipe() + '\nnew Function("change()");'],
+    ['with', recipe() + '\nwith(scope) { alter(); }'],
+    ['duplicate recipe', recipe() + '\n' + recipe().replaceAll('narrationCuesData', 'otherData').replaceAll('cuesScript', 'otherScript')],
+    ['syntax error', recipe() + '\nconst = ;'],
+  ])('rejects uncertain binding or mutable provenance: %s', (_label, code) => {
+    expect(() => deriveRejectedSpeechManifest(scene(dynamicHtml(code)), sha)).toThrow('TEXTBOOK_REPAIR_DERIVED_SPEECH_LITERAL_JS_');
+  });
+
+  it.each([
+    ['inert template', '<template>' + dynamicHtml() + '</template>'],
+    ['comment only', '<script>/* ' + recipe() + ' */</script>'],
+    ['uninvoked function', '<script>function unused(){' + recipe() + '}</script>'],
+    ['conditional function', '<script>if(false){' + recipe() + '}</script>'],
+    ['parameter shadow', '<script>(function(JSON){' + recipe() + '})();</script>'],
+    ['second script', dynamicHtml() + '<script>alter();</script>'],
+    ['external script', '<script src="remote.js"></script>' + dynamicHtml()],
+    ['module script', dynamicHtml().replace('<script>', '<script type="module">')],
