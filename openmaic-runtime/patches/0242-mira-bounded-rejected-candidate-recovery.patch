diff --git a/lib/server/mira-textbook-literal-js-cue-source.ts b/lib/server/mira-textbook-literal-js-cue-source.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-textbook-literal-js-cue-source.ts
@@ -0,0 +1,198 @@
+/** Recover only an immutable literal already present in an executable inline script.
+ * This is a recognizer, not an evaluator: no source code is ever executed.
+ */
+import { createHash } from 'node:crypto';
+import { parse, type DefaultTreeAdapterMap } from 'parse5';
+import ts from 'typescript';
+
+type Cue = { id: string; text: string };
+const schema = 'mira.interactive.narration-cues.v1';
+const marker = 'mira-narration-cues';
+const check: (ok: unknown, code: string) => asserts ok = (ok, code) => {
+  if (!ok) throw new Error(`TEXTBOOK_REPAIR_DERIVED_SPEECH_LITERAL_JS_${code}`);
+};
+const hash = (value: string) => createHash('sha256').update(value).digest('hex');
+const canonical = (value: any): string => Array.isArray(value)
+  ? '[' + value.map(canonical).join(',') + ']'
+  : value && typeof value === 'object'
+    ? '{' + Object.keys(value).sort().map(k => JSON.stringify(k) + ':' + canonical(value[k])).join(',') + '}'
+    : JSON.stringify(value);
+const identifier = (node: ts.Node | undefined, name?: string): node is ts.Identifier =>
+  !!node && ts.isIdentifier(node) && (name === undefined || node.text === name);
+const string = (node: ts.Node | undefined, value?: string): node is ts.StringLiteral =>
+  !!node && ts.isStringLiteral(node) && (value === undefined || node.text === value);
+const property = (node: ts.Node | undefined, owner: string, key: string): node is ts.PropertyAccessExpression =>
+  !!node && ts.isPropertyAccessExpression(node) && !node.questionDotToken && identifier(node.expression, owner) && identifier(node.name, key);
+const call = (node: ts.Node | undefined, argc: number): node is ts.CallExpression =>
+  !!node && ts.isCallExpression(node) && !node.questionDotToken && !node.typeArguments && node.arguments.length === argc;
+
+function constDeclaration(statement: ts.Statement): ts.VariableDeclaration | undefined {
+  if (!ts.isVariableStatement(statement) || statement.modifiers?.length ||
+      (statement.declarationList.flags & ts.NodeFlags.BlockScoped) !== ts.NodeFlags.Const || statement.declarationList.declarations.length !== 1) return;
+  const declaration = statement.declarationList.declarations[0];
+  if (!identifier(declaration.name) || declaration.type || declaration.exclamationToken || !declaration.initializer) return;
+  return declaration;
+}
+
+function fields(node: ts.Expression): Map<string, ts.Expression> {
+  check(ts.isObjectLiteralExpression(node), 'LITERAL_OBJECT');
+  const result = new Map<string, ts.Expression>();
+  for (const entry of node.properties) {
+    check(ts.isPropertyAssignment(entry) &&
+      (identifier(entry.name) || string(entry.name)), 'LITERAL_PROPERTY');
+    const key = entry.name.text;
+    check(!result.has(key), 'DUPLICATE_KEY');
+    result.set(key, entry.initializer);
+  }
+  return result;
+}
+
+function literalCues(node: ts.Expression): Cue[] {
+  const payload = fields(node);
+  check(payload.size === 2 && string(payload.get('schemaVersion'), schema) && payload.has('cues'), 'SCHEMA');
+  const array = payload.get('cues')!;
+  check(ts.isArrayLiteralExpression(array) && array.elements.length > 0 && array.elements.length <= 120, 'CUE_LIMIT');
+  const cues = array.elements.map(item => {
+    const values = fields(item);
+    check(values.size === 2 && values.has('id') && values.has('text'), 'CUE_FIELDS');
+    const id = values.get('id'), text = values.get('text');
+    check(string(id) && /^[A-Za-z0-9_-]{1,128}$/.test(id.text) && string(text) &&
+      text.text.length > 0 && text.text === text.text.trim() && Array.from(text.text).length <= 1000, 'CUE_TEXT');
+    return { id: id.text, text: text.text };
+  });
+  check(new Set(cues.map(cue => cue.id)).size === cues.length, 'DUPLICATE_ID');
+  return cues;
+}
+
+function assignment(statement: ts.Statement, owner: string, key: string): ts.BinaryExpression | undefined {
+  if (!ts.isExpressionStatement(statement) || !ts.isBinaryExpression(statement.expression)) return;
+  const expression = statement.expression;
+  if (expression.operatorToken.kind !== ts.SyntaxKind.EqualsToken || !property(expression.left, owner, key)) return;
+  return expression;
+}
+
+/** Only the first six statements of a plain script or its sole, immediately
+ * invoked, parameterless function body qualify. Nested/dead functions and
+ * conditional construction are deliberately outside this bounded recipe.
+ */
+function constructionStatements(file: ts.SourceFile): readonly ts.Statement[] {
+  if (file.statements.length === 1 && ts.isExpressionStatement(file.statements[0])) {
+    const expression = file.statements[0].expression;
+    if (call(expression, 0)) {
+      let callee: ts.Expression = expression.expression;
+      while (ts.isParenthesizedExpression(callee)) callee = callee.expression;
+      if (ts.isFunctionExpression(callee) && !callee.name && !callee.asteriskToken &&
+          !callee.modifiers?.length && callee.parameters.length === 0) return callee.body.statements;
+    }
+  }
+  return file.statements;
+}
+
+export function extractLiteralJsCueSource(html: string) {
+  check(typeof html === 'string' && html.length > 0 && Buffer.byteLength(html) <= 2_000_000, 'HTML_LIMIT');
+  const scripts: { source: string; start: number; end: number; elementStart: number; elementEnd: number }[] = [];
+  let htmlNodes = 0;
+  const visitHtml = (node: DefaultTreeAdapterMap['node'], depth: number) => {
+    check(++htmlNodes <= 50_000 && depth <= 256, 'HTML_LIMIT');
+    if ('tagName' in node) {
+      const attrs = Object.fromEntries(node.attrs.map(attr => [attr.name, attr.value]));
+      if (node.tagName === 'template') return;
+      check(attrs.id !== marker, 'STATIC_CONTAINER_PRESENT');
+      if (node.tagName === 'script') {
+        // No external or module execution may supply or change the binding.
+        check(!attrs.src && attrs.type !== 'module', 'EXTERNAL_SCRIPT');
+        if (!attrs.type || ['text/javascript', 'application/javascript'].includes(attrs.type)) {
+          const location = node.sourceCodeLocation;
+          check(location?.startTag && location.endTag, 'SCRIPT_LOCATION');
+          scripts.push({ source: html.slice(location.startTag.endOffset, location.endTag.startOffset),
+            start: location.startTag.endOffset, end: location.endTag.startOffset,
+            elementStart: location.startOffset, elementEnd: location.endOffset });
+        }
+      }
+    }
+    if ('childNodes' in node) for (const child of node.childNodes) visitHtml(child, depth + 1);
+  };
+  visitHtml(parse(html, { sourceCodeLocationInfo: true }), 0);
+  check(scripts.length === 1 && Buffer.byteLength(scripts[0].source) <= 500_000, 'UNIQUE_SCRIPT');
+  const script = scripts[0];
+  const file = ts.createSourceFile('immutable-cue-source.js', script.source, ts.ScriptTarget.Latest, true, ts.ScriptKind.JS);
+  check((file as ts.SourceFile & { parseDiagnostics: readonly ts.Diagnostic[] }).parseDiagnostics.length === 0, 'JS_SYNTAX');
+  const nodes: ts.Node[] = [];
+  const visitJs = (node: ts.Node, depth: number) => {
+    check(nodes.length < 100_000 && depth <= 256, 'AST_LIMIT');
+    nodes.push(node);
+    ts.forEachChild(node, child => visitJs(child, depth + 1));
+  };
+  visitJs(file, 0);
+  check(nodes.filter(node => string(node, marker)).length === 1, 'UNIQUE_BINDING');
+  check(!nodes.some(node => ts.isWithStatement(node) || identifier(node, 'eval') || identifier(node, 'Function')), 'DYNAMIC_SCOPE');
+  const statements = constructionStatements(file);
+  check(statements.length >= 6, 'SIX_STATEMENTS');
+  const data = constDeclaration(statements[0]), element = constDeclaration(statements[1]);
+  check(data && element && identifier(data.name) && identifier(element.name) && data.name.text !== element.name.text, 'CONST_BINDING');
+  const dataName = data.name.text, elementName = element.name.text;
+  const cues = literalCues(data.initializer!);
+  check(call(element.initializer, 1) && property(element.initializer.expression, 'document', 'createElement') &&
+    string(element.initializer.arguments[0], 'script'), 'CREATE_SCRIPT');
+  const type = assignment(statements[2], elementName, 'type');
+  const id = assignment(statements[3], elementName, 'id');
+  const text = assignment(statements[4], elementName, 'textContent');
+  check(type && string(type.right, 'application/json') && id && string(id.right, marker) && text &&
+    call(text.right, 1) && property(text.right.expression, 'JSON', 'stringify') && identifier(text.right.arguments[0], dataName), 'SCRIPT_BINDING');
+  const appendStatement = statements[5];
+  check(ts.isExpressionStatement(appendStatement) && call(appendStatement.expression, 1), 'APPEND_SCRIPT');
+  const append = appendStatement.expression;
+  check(ts.isPropertyAccessExpression(append.expression) && !append.expression.questionDotToken &&
+    identifier(append.expression.name, 'appendChild') && property(append.expression.expression, 'document', 'head') &&
+    identifier(append.arguments[0], elementName), 'APPEND_SCRIPT');
+  const permitted = new Set<ts.Node>([data.name, element.name, text.right.arguments[0], append.arguments[0],
+    (type.left as ts.PropertyAccessExpression).expression, (id.left as ts.PropertyAccessExpression).expression,
+    (text.left as ts.PropertyAccessExpression).expression]);
+  for (const node of nodes) {
+    if (!ts.isIdentifier(node)) continue;
+    // Counting actual AST identities rejects aliases, redeclarations, writes,
+    // member mutation and references in nested closures, not just assignments.
+    if (node.text === dataName || node.text === elementName) check(permitted.has(node), 'OTHER_BINDING_REFERENCE');
+    if (node.text === 'JSON') {
+      check(property(node.parent, 'JSON', 'stringify') && node.parent.expression === node &&
+        call(node.parent.parent, 1) && node.parent.parent.expression === node.parent, 'JSON_BINDING');
+    }
+    if (node.text === 'document') {
+      // The source cannot shadow, alias or replace document or its methods.
+      check(ts.isPropertyAccessExpression(node.parent) && node.parent.expression === node && !node.parent.questionDotToken, 'DOCUMENT_BINDING');
+      let access: ts.Node = node.parent;
+      while (ts.isPropertyAccessExpression(access.parent) && access.parent.expression === access) access = access.parent;
+      check(!(ts.isBinaryExpression(access.parent) && access.parent.left === access) &&
+        !ts.isDeleteExpression(access.parent) && !ts.isPostfixUnaryExpression(access.parent) &&
+        !ts.isPrefixUnaryExpression(access.parent), 'DOCUMENT_MUTATION');
+      if (node.parent.name.text === 'head') {
+        check(ts.isPropertyAccessExpression(access) && identifier(access.name, 'appendChild') &&
+          call(access.parent, 1) && access.parent.expression === access, 'HEAD_BINDING');
+      }
+      if (node.parent.name.text === 'createElement') {
+        check(call(node.parent.parent, 1) && node.parent.parent.expression === node.parent, 'CREATE_ELEMENT_BINDING');
+      }
+    }
+  }
+  const range = (start: number, end: number) => ({ startOffset: start, endOffset: end,
+    startByte: Buffer.byteLength(html.slice(0, start)), endByte: Buffer.byteLength(html.slice(0, end)),
+    sha256: hash(html.slice(start, end)) });
+  return {
+    cues,
+    witness: {
+      schemaVersion: 'mira.textbook.literal-js-cue-source.v1',
+      recipe: 'single-inline-script-first-six-immutable-literal-statements',
+      sourceHtmlSha256: hash(html),
+      offsetUnit: 'utf16-code-unit',
+      scriptElement: range(script.elementStart, script.elementEnd),
+      scriptBody: range(script.start, script.end),
+      literal: range(script.start + data.initializer!.getStart(file), script.start + data.initializer!.end),
+      construction: range(script.start + statements[0].getStart(file), script.start + statements[5].end),
+      dataIdentifier: dataName,
+      scriptIdentifier: elementName,
+      canonicalCuesSha256: hash(canonical(cues)),
+      canonicalPayloadSha256: hash(canonical({ schemaVersion: schema, cues })),
+      cueCount: cues.length,
+    },
+  };
+}
diff --git a/tests/agent-runtime/textbook-literal-js-cue-source.test.ts b/tests/agent-runtime/textbook-literal-js-cue-source.test.ts
