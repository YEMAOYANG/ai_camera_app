+
+const url = `http://127.0.0.1:3100/internal/formal-scene-preview/${'a'.repeat(64)}`;
+function fakePage(current=url) {
+  const ready=vi.fn(async()=>undefined), evaluate=vi.fn(async()=>undefined);
+  const page={url:()=>current,reload:vi.fn(async()=>undefined),locator:vi.fn(()=>({waitFor:ready})),evaluate};
+  return {page:page as unknown as Page,raw:page,ready,evaluate};
+}
+describe('private quiz visual capture',()=>{
+  it('reloads only the same private quiz and waits for the ready entry before stable capture',async()=>{
+    const f=fakePage();await prepareFormalQuizScreenshot(f.page,url);
+    expect(f.raw.reload).toHaveBeenCalledExactlyOnceWith({waitUntil:'domcontentloaded',timeout:20000});
+    expect(f.raw.locator).toHaveBeenCalledWith('#formal-scene-root[data-qa-ready="true"][data-scene-type="quiz"]');
+    expect(f.ready).toHaveBeenCalledBefore(f.evaluate);expect(f.evaluate).toHaveBeenCalledTimes(1);
+  });
+  it.each(['http://example.com/internal/formal-scene-preview/'+ 'a'.repeat(64),
+    'http://127.0.0.1:3100/classroom/stage-one',url+'?student=one',url+'#question'])('never reloads a student/external or altered URL %s',async target=>{
+    const f=fakePage(target);await expect(prepareFormalQuizScreenshot(f.page,target)).rejects.toThrow('PREVIEW_REQUIRED');expect(f.raw.reload).not.toHaveBeenCalled();
+  });
+  it('refuses a different page instead of navigating a student browser',async()=>{
+    const f=fakePage('http://127.0.0.1:3100/classroom/stage-one');await expect(prepareFormalQuizScreenshot(f.page,url)).rejects.toThrow('PREVIEW_REQUIRED');expect(f.raw.reload).not.toHaveBeenCalled();
+  });
+  it('preserves reload and render failures instead of manufacturing a fresh screenshot',async()=>{
+    const f=fakePage();f.raw.reload.mockRejectedValueOnce(new Error('preview expired'));await expect(prepareFormalQuizScreenshot(f.page,url)).rejects.toThrow('preview expired');expect(f.evaluate).not.toHaveBeenCalled();
+  });
