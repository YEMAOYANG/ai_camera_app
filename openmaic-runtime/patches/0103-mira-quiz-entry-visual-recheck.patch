--- /dev/null
+++ b/lib/server/mira-formal-quiz-screenshot.ts
@@ -0,0 +1,59 @@
+import type { Page } from 'playwright-core';
+
+/** Runs only in the inspector's disposable, capability-backed read-only quiz.
+ * Probe selections demonstrate a local state transition, not correct answers.
+ * Reload before capturing visuals so no selected distractor or probe-induced
+ * scroll position is presented as the authored course's initial state. */
+export async function prepareFormalQuizScreenshot(page: Page, previewUrl: string): Promise<void> {
+  const url = new URL(previewUrl);
+  if (url.protocol !== 'http:' || url.username || url.password
+      || !['localhost', '127.0.0.1', '[::1]'].includes(url.hostname)
+      || !/^\/internal\/formal-scene-preview\/[a-f0-9]{64}$/.test(url.pathname)
+      || url.search || url.hash || page.url() !== previewUrl)
+    throw new Error('FORMAL_QUIZ_SCREENSHOT_PREVIEW_REQUIRED');
+  await page.reload({ waitUntil: 'domcontentloaded', timeout: 20_000 });
+  await page.locator('#formal-scene-root[data-qa-ready="true"][data-scene-type="quiz"]').waitFor({ timeout: 12_000 });
+  await page.evaluate(async () => {
+    const root = document.querySelector<HTMLElement>('#formal-scene-root');
+    if (!root || root.dataset.sceneType !== 'quiz' || !root.querySelector('[data-quiz-option],textarea'))
+      throw new Error('FORMAL_QUIZ_SCREENSHOT_CONTROLS_MISSING');
+    await document.fonts.ready;
+    // Restore the initial viewport only inside this fresh private render. This
+    // neither changes a learner's scroll nor treats deliberate scrolling as an
+    // authored-content defect.
+    const resetScroll = () => {
+      window.scrollTo(0, 0);
+      for (const element of [root, ...root.querySelectorAll<HTMLElement>('*')]) {
+        if (element.scrollTop) element.scrollTop = 0;
+        if (element.scrollLeft) element.scrollLeft = 0;
+      }
+    };
+    resetScroll();
+    // Motion's JS-driven entrance transforms may outlive two RAFs and are not
+    // necessarily finished by Playwright's animations:'disabled'. Wait for
+    // actual geometry/opacity stability; never remove or override animations.
+    await new Promise<void>((resolve, reject) => {
+      const started = performance.now();
+      let previous = '', stableFrames = 0;
+      const sample = () => {
+        const elements = [root, ...root.querySelectorAll<HTMLElement>('div,button,textarea')];
+        const signature = JSON.stringify(elements.map(element => {
+          const r = element.getBoundingClientRect(), css = getComputedStyle(element);
+          return [r.x,r.y,r.width,r.height,css.opacity,css.transform];
+        }));
+        const running = root.getAnimations({subtree:true}).some(animation => animation.playState === 'running'
+          && Number.isFinite(animation.effect?.getComputedTiming().endTime));
+        stableFrames = signature === previous && !running ? stableFrames + 1 : 0;
+        previous = signature;
+        if (stableFrames >= 3) { resetScroll(); resolve(); return; }
+        if (performance.now() - started > 5000) { reject(new Error('FORMAL_QUIZ_SCREENSHOT_UNSTABLE')); return; }
+        requestAnimationFrame(sample);
+      };
+      requestAnimationFrame(sample);
+    });
+    await new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
+    if (root.querySelector('[data-formal-auto-probe]')
+        || Array.from(root.querySelectorAll<HTMLTextAreaElement>('textarea')).some(input => input.value !== ''))
+      throw new Error('FORMAL_QUIZ_SCREENSHOT_NOT_INITIAL');
+  });
+}
