diff --git a/lib/server/course-archive-events.ts b/lib/server/course-archive-events.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/course-archive-events.ts
@@ -0,0 +1,203 @@
+/** Durable local course snapshots; this producer never calls a Provider or S3. */
+import { createHash, randomUUID } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import type { Queryable } from '@openmaic/storage/agent-session/pg';
+
+export const COURSE_ARCHIVE_EVENT_SCHEMA = 'mira.course-archive.event.v1';
+
+export class CourseArchiveSettlementPendingError extends Error {
+  override readonly name = 'CourseArchiveSettlementPendingError';
+  constructor() {
+    super('Local course archive settlement is pending');
+  }
+}
+
+/** Retry durable settlement without converting completed generation to failure. */
+export async function parkCourseArchiveSettlement(
+  error: unknown,
+  releaseLease: () => Promise<void>,
+): Promise<boolean> {
+  if (!(error instanceof CourseArchiveSettlementPendingError)) return false;
+  await releaseLease();
+  return true;
+}
+
+export function archiveEventsEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  return ['1', 'true'].includes(env.COURSE_STORAGE_ARCHIVE_ENABLED?.trim().toLowerCase() ?? '');
+}
+
+export function archiveCanonical(value: unknown): string {
+  const sorted = (item: unknown): unknown => {
+    if (Array.isArray(item)) return item.map(sorted);
+    if (item && typeof item === 'object') {
+      return Object.fromEntries(
+        Object.entries(item)
+          .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+          .map(([key, child]) => [key, sorted(child)]),
+      );
+    }
+    return item;
+  };
+  return JSON.stringify(sorted(value));
+}
+
+export function archiveDigest(value: unknown): string {
+  return createHash('sha256').update(archiveCanonical(value)).digest('hex');
+}
+
+export async function ensureCourseArchiveEventSchema(database: Queryable): Promise<void> {
+  await database.query(`CREATE TABLE IF NOT EXISTS mira_course_archive_events (
+    id BIGSERIAL PRIMARY KEY,
+    source_kind TEXT NOT NULL DEFAULT 'native_pg_stage',
+    session_id TEXT NOT NULL,
+    stage_id TEXT NOT NULL,
+    stage_revision BIGINT NOT NULL,
+    source_digest CHAR(64) NOT NULL,
+    snapshot_json JSONB NOT NULL,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+    acknowledged_at TIMESTAMPTZ,
+    UNIQUE(session_id, stage_id, stage_revision, source_digest),
+    CHECK (source_kind = 'native_pg_stage'),
+    CHECK (stage_revision >= 0),
+    CHECK (source_digest ~ '^[a-f0-9]{64}$')
+  )`);
+  await database.query(`CREATE INDEX IF NOT EXISTS mira_course_archive_events_pending
+    ON mira_course_archive_events(id) WHERE acknowledged_at IS NULL`);
+}
+
+interface FinishedSession {
+  id: string;
+  ownerId: string;
+  stageId: string;
+  existingCourse: boolean;
+  status: string;
+}
+
+interface SnapshotRow extends Record<string, unknown> {
+  id: string;
+  data: Record<string, unknown>;
+  scenes: Record<string, unknown>[];
+  outline: unknown;
+  revision: string | number;
+}
+
+export async function enqueueSucceededStageArchives(
+  transaction: Queryable,
+  session: FinishedSession,
+): Promise<void> {
+  if (session.status !== 'succeeded') return;
+  // A new Pi session's stage_id can be a placeholder. Discover all actual
+  // create_stage receipts, plus the persisted producerRef when the UI receipt
+  // was interrupted. Existing-course editing may use its owned stage target.
+  // One SELECT snapshots rows/revisions under one PostgreSQL statement view.
+  const result = await transaction.query<SnapshotRow>(
+    `WITH candidates AS (
+    SELECT data->>'stageId' AS id FROM agent_session_events
+      WHERE session_id=$1 AND type='library_changed' AND data->>'change'='stage_created'
+    UNION SELECT stage_id FROM document_outlines WHERE data->>'producerRef'=$1
+    UNION SELECT stage_id FROM agent_sessions WHERE id=$1 AND existing_course=true
+    UNION SELECT active_stage_id FROM agent_sessions WHERE id=$1 AND existing_course=true
+  ) SELECT stage.id,stage.data,revision.rev AS revision,outline.data AS outline,
+      COALESCE((SELECT jsonb_agg(scene.data ORDER BY scene.scene_order,scene.id)
+        FROM document_scenes scene WHERE scene.stage_id=stage.id),'[]'::jsonb) AS scenes
+    FROM document_stages stage
+    JOIN candidates ON candidates.id=stage.id
+    JOIN document_stage_revision revision ON revision.stage_id=stage.id
+    LEFT JOIN document_outlines outline ON outline.stage_id=stage.id
+    WHERE stage.owner_id=$2 AND stage.data->>'id'=stage.id ORDER BY stage.id`,
+    [session.id, session.ownerId],
+  );
+  for (const row of result.rows) {
+    if (!Array.isArray(row.scenes) || row.scenes.length === 0) continue;
+    if (row.scenes.some((scene) => scene.stageId !== row.id))
+      throw new Error('Archive scene identity mismatch');
+    const { dslVersion, ...stage } = row.data;
+    const outline =
+      row.outline && typeof row.outline === 'object' && !Array.isArray(row.outline)
+        ? Object.fromEntries(Object.entries(row.outline).filter(([key]) => key !== 'producerRef'))
+        : row.outline;
+    const snapshot = {
+      id: row.id,
+      stage,
+      scenes: row.scenes,
+      ...(dslVersion === undefined ? {} : { dslVersion }),
+      ...(outline == null ? {} : { outline }),
+    };
+    // Session prompts, owner columns, cookies and credentials are deliberately
+    // absent: only document content enters the archive payload.
+    await transaction.query(
+      `INSERT INTO mira_course_archive_events
+      (source_kind,session_id,stage_id,stage_revision,source_digest,snapshot_json)
+      VALUES ('native_pg_stage',$1,$2,$3,$4,$5::jsonb)
+      ON CONFLICT (session_id,stage_id,stage_revision,source_digest) DO NOTHING`,
+      [
+        session.id,
+        row.id,
+        String(row.revision),
+        archiveDigest(snapshot),
+        archiveCanonical(snapshot),
+      ],
+    );
+  }
+}
+
+export async function enqueueLegacyClassroomArchive(
+  snapshot: { id: string; stage: unknown; scenes: unknown[] },
+  env: NodeJS.ProcessEnv = process.env,
+): Promise<string | undefined> {
+  if (!archiveEventsEnabled(env)) return undefined;
+  const manifest = env.COURSE_STORAGE_MANIFEST_PATH?.trim();
+  if (!manifest || !path.isAbsolute(manifest))
+    throw new Error('Archive state requires an absolute manifest path');
+  if (!/^[A-Za-z0-9_-]+$/.test(snapshot.id) || snapshot.scenes.length === 0) return undefined;
+  const sourceDigest = archiveDigest(snapshot);
+  const eventKey =
+    'legacy-' +
+    createHash('sha256')
+      .update(snapshot.id + ':' + sourceDigest)
+      .digest('hex');
+  const stateRoot = path.dirname(manifest),
+    directory = path.join(stateRoot, 'archive-events');
+  await fs.mkdir(stateRoot, { recursive: true, mode: 0o700 });
+  if ((await fs.lstat(stateRoot)).isSymbolicLink())
+    throw new Error('Archive state root must not be a symlink');
+  await fs.mkdir(directory, { mode: 0o700 }).catch((error) => {
+    if (error.code !== 'EEXIST') throw error;
+  });
+  if ((await fs.lstat(directory)).isSymbolicLink())
+    throw new Error('Archive event directory must not be a symlink');
+  const filename = path.join(directory, eventKey + '.json');
+  const temporary = path.join(directory, '.' + eventKey + '-' + randomUUID() + '.tmp');
+  const event = {
+    schemaVersion: COURSE_ARCHIVE_EVENT_SCHEMA,
+    sourceKind: 'legacy_classroom',
+    stageId: snapshot.id,
+    sourceDigest,
+    snapshot,
+    createdAt: new Date().toISOString(),
+  };
+  const handle = await fs.open(temporary, 'wx', 0o600);
+  try {
+    await handle.writeFile(archiveCanonical(event) + '\n');
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+  try {
+    await fs.link(temporary, filename);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+    const existing = JSON.parse(await fs.readFile(filename, 'utf8'));
+    if (
+      existing.sourceDigest !== sourceDigest ||
+      existing.stageId !== snapshot.id ||
+      existing.schemaVersion !== COURSE_ARCHIVE_EVENT_SCHEMA ||
+      archiveDigest(existing.snapshot) !== sourceDigest
+    )
+      throw new Error('Archive event identity conflict');
+  } finally {
+    await fs.unlink(temporary);
+  }
+  return filename;
+}
