+++ b/tests/course-archive-events.test.ts
@@ -0,0 +1,230 @@
+import { PGlite } from '@electric-sql/pglite';
+import { afterEach, beforeEach, describe, expect, test } from 'vitest';
+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {
+  PgAgentSessionStore,
+  ensureAgentSessionSchema,
+  type Queryable,
+} from '../packages/@openmaic/storage/src/agent-session/pg';
+import {
+  archiveDigest,
+  archiveEventsEnabled,
+  ensureCourseArchiveEventSchema,
+  enqueueSucceededStageArchives,
+  enqueueLegacyClassroomArchive,
+  CourseArchiveSettlementPendingError,
+  parkCourseArchiveSettlement,
+} from '@/lib/server/course-archive-events';
+import { planResume } from '@/lib/server/agent-runtime/resume';
+
+describe('durable native course archive producer', () => {
+  let db: PGlite;
+  let store: PgAgentSessionStore;
+  beforeEach(async () => {
+    db = new PGlite();
+    await db.waitReady;
+    await ensureAgentSessionSchema(db);
+    await ensureCourseArchiveEventSchema(db);
+    await db.exec(`CREATE TABLE document_stages(id TEXT PRIMARY KEY,owner_id TEXT,data JSONB);
+      CREATE TABLE document_scenes(stage_id TEXT,id TEXT,scene_order INTEGER,data JSONB);
+      CREATE TABLE document_outlines(stage_id TEXT,data JSONB);
+      CREATE TABLE document_stage_revision(stage_id TEXT,rev BIGINT);`);
+    store = new PgAgentSessionStore(db, {
+      withTransaction: (body) => db.transaction((tx) => body(tx as Queryable)),
+      onSessionFinished: enqueueSucceededStageArchives,
+    });
+    await store.createSession({
+      id: 'session-private',
+      ownerId: 'owner-private',
+      prompt: 'private prompt never archived',
+      stageId: 'placeholder',
+    });
+    await store.claimNextSession('worker', 1, { leaseTtlMs: 10_000, maxAttempts: 3 });
+    for (const [id, owner] of [
+      ['actual-stage', 'owner-private'],
+      ['foreign-stage', 'different-owner'],
+      ['empty-stage', 'owner-private'],
+    ]) {
+      await db.query('INSERT INTO document_stages VALUES ($1,$2,$3::jsonb)', [
+        id,
+        owner,
+        JSON.stringify({ id, name: '完整课件', dslVersion: '1.0', createdAt: 1, updatedAt: 1 }),
+      ]);
+      await db.query('INSERT INTO document_stage_revision VALUES ($1,1)', [id]);
+      await db.query('INSERT INTO document_outlines VALUES ($1,$2::jsonb)', [
+        id,
+        JSON.stringify({
+          producer: 'server-job',
+          producerRef: 'session-private',
+          requirement: '教学目标',
+        }),
+      ]);
+      if (id !== 'empty-stage')
+        await db.query('INSERT INTO document_scenes VALUES ($1,$2,1,$3::jsonb)', [
+          id,
+          'scene-1',
+          JSON.stringify({
+            id: 'scene-1',
+            stageId: id,
+            type: 'slide',
+            order: 1,
+            content: { title: '第一版' },
+          }),
+        ]);
+      await store.appendControlEvent('session-private', {
+        ts: 1,
+        type: 'library_changed',
+        data: { change: 'stage_created', stageId: id },
+      });
+    }
+  });
+  afterEach(async () => {
+    await db.close();
+  });
+
+  test('successful settlement freezes only complete owned event-discovered stages atomically', async () => {
+    expect(await store.finishSession('session-private', 'worker', { status: 'succeeded' })).toBe(
+      true,
+    );
+    const result = await db.query<{
+      stage_id: string;
+      source_digest: string;
+      snapshot_json: unknown;
+      acknowledged_at: unknown;
+    }>('SELECT * FROM mira_course_archive_events');
+    expect(result.rows).toHaveLength(1);
+    const event = result.rows[0]!;
+    expect(event.stage_id).toBe('actual-stage');
+    expect(event.source_digest).toBe(archiveDigest(event.snapshot_json));
+    expect(event.acknowledged_at).toBeNull();
+    const json = JSON.stringify(event.snapshot_json);
+    expect(json).toContain('教学目标');
+    expect(json).not.toContain('owner-private');
+    expect(json).not.toContain('session-private');
+    expect(json).not.toContain('private prompt');
+    expect((await store.getSession('session-private'))?.status).toBe('succeeded');
+  });
+
+  test('outbox failure rolls back settlement and retries without changing saved documents', async () => {
+    const failing = new PgAgentSessionStore(db, {
+      withTransaction: (body) => db.transaction((tx) => body(tx as Queryable)),
+      onSessionFinished: async (tx, session) => {
+        await enqueueSucceededStageArchives(tx, session);
+        throw new Error('outbox unavailable');
+      },
+    });
+    await expect(
+      failing.finishSession('session-private', 'worker', { status: 'succeeded' }),
+    ).rejects.toThrow('outbox unavailable');
+    expect((await store.getSession('session-private'))?.status).toBe('running');
+    expect((await db.query('SELECT * FROM mira_course_archive_events')).rows).toHaveLength(0);
+    expect((await db.query('SELECT * FROM document_scenes')).rows).toHaveLength(2);
+    await store.finishSession('session-private', 'worker', { status: 'succeeded' });
+    expect((await db.query('SELECT * FROM mira_course_archive_events')).rows).toHaveLength(1);
+  });
+
+  test('stale or failed settlements do not archive partial work', async () => {
+    expect(
+      await store.finishSession('session-private', 'stale-worker', { status: 'succeeded' }),
+    ).toBe(false);
+    expect(await store.finishSession('session-private', 'worker', { status: 'failed' })).toBe(true);
+    expect((await db.query('SELECT * FROM mira_course_archive_events')).rows).toHaveLength(0);
+  });
+
+  test('pending archival parks the lease and completed history retries settlement without model work', async () => {
+    const pending = new CourseArchiveSettlementPendingError();
+    const failing = new PgAgentSessionStore(db, {
+      withTransaction: (body) => db.transaction((tx) => body(tx as Queryable)),
+      onSessionFinished: async () => {
+        throw pending;
+      },
+    });
+    await expect(
+      failing.finishSession('session-private', 'worker', { status: 'succeeded' }),
+    ).rejects.toBe(pending);
+    expect(
+      await parkCourseArchiveSettlement(pending, () =>
+        store.releaseLease('session-private', 'worker'),
+      ),
+    ).toBe(true);
+    const before = await store.getSession('session-private');
+    expect(before?.status).toBe('running');
+    expect(before?.lease).toBeUndefined();
+    const claimed = await store.claimNextSession('worker', 1, {
+      leaseTtlMs: 10_000,
+      maxAttempts: 3,
+    });
+    expect(claimed?.attempt).toBe(before?.attempt);
+    const completed = [
+      {
+        role: 'assistant',
+        content: [{ type: 'text', text: '已保存完整课件' }],
+        stopReason: 'stop',
+      },
+    ];
+    expect(planResume(completed as Parameters<typeof planResume>[0]).kind).toBe('already-complete');
+    await store.finishSession('session-private', 'worker', { status: 'succeeded' });
+    expect((await db.query('SELECT * FROM mira_course_archive_events')).rows).toHaveLength(1);
+    let released = false;
+    expect(
+      await parkCourseArchiveSettlement(new Error('unrelated'), async () => {
+        released = true;
+      }),
+    ).toBe(false);
+    expect(released).toBe(false);
+  });
+
+  test('reconciliation deduplicates a revision and a later complete version preserves the first snapshot', async () => {
+    await store.finishSession('session-private', 'worker', { status: 'succeeded' });
+    const session = {
+      id: 'session-private',
