+  fetchMock.mockImplementation(async (url: URL, init?: RequestInit) => {
+    if (init?.method === 'PUT') return successfulPut(url, init);
+    return url.pathname.endsWith('/asset') ? Response.json({ ok: true, asset: { ...asset, sha256: oldSha, byteSize: payload.length } })
+      : new Response(payload, { headers: { 'X-Mira-File-Source': 'remote', 'X-Mira-File-Sha256': oldSha } });
+  });
+  const read = await readCourseStorageJson<Array<{ status: string }>>(localPath);
+  read.push({ status: 'started' });
+  await writeJsonFileAtomic(localPath, read);
+  const afterFirst = courseStorageVersion(read)!.sha256;
+  read[1].status = 'needs_revision';
