 /** Resolve native narration identity against this scene; never accept message text. */
 export function fixedQuizQuestionNarrationText(
   scene: Scene | null | undefined, fixedTextbook: boolean, sceneId: string, questionId: string,
+  audioSource?: string,
 ): string | null {
   if (!fixedTextbook || scene?.id !== sceneId || scene.type !== 'quiz' || scene.content.type !== 'quiz') return null;
-  return scene.content.questions.find(question => question.id === questionId)?.question ?? null;
+  const question = scene.content.questions.find(question => question.id === questionId);
+  if (question) return question.question;
+  // The public student question omits answers and optionFeedback. Resolve the
+  // selected server feedback through its recorded clip and this scene's saved
+  // speech actions, never from an iframe/event-supplied caption string.
+  const feedbackQuestion = scene.content.questions.find(question => question.options?.some(
+    option => `${question.id}:feedback:${option.value}` === questionId,
+  ));
+  if (!feedbackQuestion || !audioSource ||
+      !/^\/api\/classroom-media\/[A-Za-z0-9_-]+\/audio\/[A-Za-z0-9_-]+\.(?:wav|mp3|ogg)$/.test(audioSource)) return null;
+  let questionStarted = false;
+  const stems = new Set(scene.content.questions.map(question => question.question.trim()));
+  for (const action of scene.actions ?? []) {
+    if (action.type !== 'speech') continue;
+    if (stems.has(action.text.trim())) questionStarted = action.text.trim() === feedbackQuestion.question.trim();
+    else if (questionStarted && audioPath(action.audioUrl) === audioSource) return action.text;
+  }
+  return null;
 }
