+++ b/tests/server/mira-formal-completion-tail-budget.test.ts
@@ -0,0 +1,139 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+import { paidBudgetContext, withPaidBudget } from '@/lib/server/mira-paid-budget';
+import {
+  assertCompletionTailExecution, completionTailArgument, completionTailPaidBudget,
+  validateCompletionTailBudget, type CompletionTailSidecar,
+} from '@/lib/server/mira-formal-completion-tail-budget';
+
+const NOW = 1_800_000_000_000;
+const models = {
+  'deepseek-flash-peak': { provider: 'deepseek', model: 'deepseek-v4-flash' },
+  'deepseek-vision-peak': { provider: 'deepseek', model: 'deepseek-v4-flash-vision-exp' },
+  'qwen-tts-beijing': { provider: 'qwen-tts', model: 'qwen3-tts-flash' },
+  'qwen-asr-beijing': { provider: 'qwen-asr', model: 'qwen3-asr-flash' },
+};
+function fixture() {
+  const identity = {
+    parentAuthorizationId: '1'.repeat(64), buildItemId: 'catalog_build_item_frozen',
+    runtimeId: 'omfc_original', runtimeRequestId: 'frozen-attempt-1', jobId: 'omformal_original',
+    sourceJobSha256: '2'.repeat(64), sourceSnapshotSha256: '3'.repeat(64),
+    repairSnapshotSha256: '4'.repeat(64), formalInputSha256: '5'.repeat(64),
+    sessionId: 'miraformal_' + '6'.repeat(64), ownerId: 'mira-formal-professional:' + '6'.repeat(64),
+    stageId: 'stage-frozen', speechActionCount: 36,
+    sceneIds: ['p1', 'p2', 'p4', 'p3', 'p5', 'p6', 'p7', 'p8'], lockedQuestionIds: ['q2', 'q3', 'q4', 'q5'],
+  };
+  const authorizationId = qualitySha({ schema: 'mira.learning.saved-stage-tail-authorization.v1', identity });
+  const scope = { purpose: 'production', gradeCode: 'primary_6', subject: 'math',
+    courseId: 'catalog-item:catalog_build_item_frozen', courseVersion: 'frozen-policy', userId: null,
+    sessionId: null, productionJobId: identity.buildItemId, approvalReference: 'original-approval' };
+  const sidecar: CompletionTailSidecar = {
+    schemaVersion: 'mira.learning.saved-stage-tail-grant.v1', planSha256: '7'.repeat(64), authorizationId,
+    paidBudget: { schemaVersion: 'mira.learning.paid-budget-binding.v1', required: true, authorizationId },
+    identity, parentAuthorizationSha256: '8'.repeat(64), scopeSha256: qualitySha(scope), scope,
+    startsAt: NOW - 1000, expiresAt: NOW + 60_000, priceKeys: Object.keys(models).sort(),
+    limits: { calls: 74 }, transportTerminalPlanSha256: '9'.repeat(64),
+  };
+  const { runtimeId: _, ...expected } = identity;
+  return { sidecar, expected };
+}
+function mockAuthority(sidecar: CompletionTailSidecar, change?: (authority: Record<string, any>) => void) {
+  const authority = { authorizationId: sidecar.authorizationId, purpose: 'production',
+    completionTailGrant: structuredClone(sidecar), prices: structuredClone(models) };
+  change?.(authority);
+  const fetchMock = vi.fn().mockResolvedValue({ ok: true, json: async () => ({ ok: true, budget: authority }) });
+  vi.stubGlobal('fetch', fetchMock);
+  return fetchMock;
+}
+beforeEach(() => {
+  vi.spyOn(Date, 'now').mockReturnValue(NOW);
+  vi.stubEnv('MIRA_INTERNAL_API_TOKEN', 'test-only-internal-token');
+  vi.stubEnv('MIRA_BACKEND_INTERNAL_URL', 'http://127.0.0.1:8000');
+  vi.stubGlobal('fetch', vi.fn(() => { throw new Error('Unexpected network attempt'); }));
+});
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllGlobals(); vi.unstubAllEnvs(); });
+
+describe('saved-stage completion-only sidecar authority', () => {
+  it('uses an independently verified binding in completion and restores the original context', async () => {
+    const { sidecar, expected } = fixture(); const fetchMock = mockAuthority(sidecar);
+    const before = JSON.stringify(sidecar);
+    const token = await validateCompletionTailBudget(sidecar, expected);
+    expect(fetchMock).toHaveBeenCalledOnce();
+    expect(JSON.parse(fetchMock.mock.calls[0][1].body)).toEqual({ authorizationId: sidecar.authorizationId });
+    expect(fetchMock.mock.calls[0][0].pathname).toBe('/internal/learning/budget/context');
+    const original = { ...sidecar.paidBudget, authorizationId: expected.parentAuthorizationId };
+    const { jobId: _, sourceJobSha256: __, ...execution } = expected;
+    await withPaidBudget(original, 'original-session', async () => {
+      const binding = assertCompletionTailExecution(token, execution);
+      await withPaidBudget(binding, expected.sessionId + ':completion', async () => {
+        expect(paidBudgetContext.getStore()?.binding.authorizationId).toBe(sidecar.authorizationId);
+      });
+      expect(paidBudgetContext.getStore()?.binding.authorizationId).toBe(original.authorizationId);
+    });
+    expect(paidBudgetContext.getStore()).toBeUndefined();
+    expect(JSON.stringify(sidecar)).toBe(before);
+    expect(token.receiptSha256).toBe(qualitySha(sidecar));
+    sidecar.paidBudget.authorizationId = 'f'.repeat(64);
+    expect(completionTailPaidBudget(token).authorizationId).not.toBe(sidecar.paidBudget.authorizationId);
