diff --git a/lib/server/mira-formal-completion-tail-budget.ts b/lib/server/mira-formal-completion-tail-budget.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-completion-tail-budget.ts
@@ -0,0 +1,155 @@
+/** A separately audited budget for completing one frozen saved classroom.
+ * It never replaces the original job/session binding and cannot start an Agent. */
+import { parsePaidBudget, type PaidBudgetBinding } from './mira-paid-budget';
+import { qualitySha } from './mira-formal-quality-contract';
+
+const SCHEMA = 'mira.learning.saved-stage-tail-grant.v1';
+const SHA = /^[a-f0-9]{64}$/;
+const PRICE_MODELS = {
+  'deepseek-flash-peak': ['deepseek', 'deepseek-v4-flash'],
+  'deepseek-vision-peak': ['deepseek', 'deepseek-v4-flash-vision-exp'],
+  'qwen-tts-beijing': ['qwen-tts', 'qwen3-tts-flash'],
+  'qwen-asr-beijing': ['qwen-asr', 'qwen3-asr-flash'],
+} as const;
+type RecordValue = Record<string, unknown>;
+const object = (value: unknown): value is RecordValue =>
+  !!value && typeof value === 'object' && !Array.isArray(value);
+const fail = (detail: string): never => { throw new Error(`SAVED_STAGE_COMPLETION_BUDGET_${detail}`); };
+const exact = (value: unknown, keys: string[]) => object(value)
+  && Object.keys(value).sort().join(',') === [...keys].sort().join(',');
+
+export interface CompletionTailIdentity {
+  parentAuthorizationId: string;
+  buildItemId: string;
+  runtimeId: string;
+  runtimeRequestId: string;
+  jobId: string;
+  sourceJobSha256: string;
+  sourceSnapshotSha256: string;
+  repairSnapshotSha256: string;
+  formalInputSha256: string;
+  sessionId: string;
+  ownerId: string;
+  stageId: string;
+  speechActionCount: number;
+  sceneIds: string[];
+  lockedQuestionIds: string[];
+}
+export interface CompletionTailSidecar {
+  schemaVersion: typeof SCHEMA;
+  planSha256: string;
+  authorizationId: string;
+  paidBudget: PaidBudgetBinding;
+  identity: CompletionTailIdentity;
+  parentAuthorizationSha256: string;
+  scopeSha256: string;
+  scope: RecordValue;
+  startsAt: number;
+  expiresAt: number;
+  priceKeys: string[];
+  limits: RecordValue;
+  transportTerminalPlanSha256: string;
+}
+declare const verified: unique symbol;
+export interface ValidatedCompletionTailBudget {
+  readonly receiptSha256: string;
+  readonly [verified]: true;
+}
+const validated = new WeakMap<ValidatedCompletionTailBudget, CompletionTailSidecar>();
+
+/** The new flag is intentionally separate from the frozen recovery manifest. */
+export function completionTailArgument(mode: string, manifest: RecordValue, args: string[]): string | undefined {
+  if (!args.length) return undefined;
+  if (args.length !== 2 || args[0] !== '--completion-paid-budget' || !args[1].trim())
+    return fail('ARGUMENT_INVALID');
+  if (mode !== 'complete') return fail('COMPLETE_ONLY');
+  if (['reviewGrantPath', 'browserRecheck', 'asrSourceRequestId', 'ttsSourceRequestId',
+    'audioRepair', 'pronunciationRepair', 'asrComparisonRevalidation'].some(key => key in manifest))
+    return fail('CANNOT_MIX_RECOVERIES');
+  return args[1];
+}
+
+async function authoritativeContext(authorizationId: string): Promise<RecordValue> {
+  const token = process.env.MIRA_INTERNAL_API_TOKEN;
+  const base = process.env.MIRA_BACKEND_INTERNAL_URL;
+  if (!token || !base) return fail('SERVICE_UNCONFIGURED');
+  const response = await fetch(new URL('/internal/learning/budget/context', base), {
+    method: 'POST', redirect: 'error', signal: AbortSignal.timeout(15000),
+    headers: { 'Content-Type': 'application/json', 'X-Mira-Internal-Token': token,
+      'X-Mira-Internal-Source': 'openmaic-runtime-gateway' },
+    body: JSON.stringify({ authorizationId }),
+  });
+  const result: unknown = await response.json().catch(() => null);
+  if (!response.ok || !object(result) || result.ok !== true || !object(result.budget))
+    return fail('AUTHORITY_REJECTED');
+  return result.budget;
+}
+
+/** The internal accounting service validates the full stored audit before
+ * returning completionTailGrant. A locally rehashed file is not authority. */
+export async function validateCompletionTailBudget(
+  value: unknown,
+  expected: Omit<CompletionTailIdentity, 'runtimeId'>,
+): Promise<ValidatedCompletionTailBudget> {
+  if (!exact(value, ['schemaVersion', 'planSha256', 'authorizationId', 'paidBudget', 'identity',
+    'parentAuthorizationSha256', 'scopeSha256', 'scope', 'startsAt', 'expiresAt', 'priceKeys',
+    'limits', 'transportTerminalPlanSha256'])) return fail('SIDECAR_INVALID');
+  const sidecar = value as unknown as CompletionTailSidecar;
+  const identityKeys = ['parentAuthorizationId', 'buildItemId', 'runtimeId', 'runtimeRequestId', 'jobId',
+    'sourceJobSha256', 'sourceSnapshotSha256', 'repairSnapshotSha256', 'formalInputSha256',
+    'sessionId', 'ownerId', 'stageId', 'speechActionCount', 'sceneIds', 'lockedQuestionIds'];
+  if (sidecar.schemaVersion !== SCHEMA || !exact(sidecar.identity, identityKeys)
+      || !/^omfc_[A-Za-z0-9_-]+$/.test(sidecar.identity.runtimeId)
+      || Object.entries(expected).some(([key, item]) => qualitySha(sidecar.identity[key as keyof CompletionTailIdentity]) !== qualitySha(item))
+      || [sidecar.planSha256, sidecar.authorizationId, sidecar.parentAuthorizationSha256,
+        sidecar.scopeSha256, sidecar.transportTerminalPlanSha256].some(item => !SHA.test(item))
+      || !object(sidecar.scope) || sidecar.scope.purpose !== 'production'
+      || sidecar.scope.productionJobId !== expected.buildItemId
+      || sidecar.scope.userId !== null || sidecar.scope.sessionId !== null
+      || sidecar.scopeSha256 !== qualitySha(sidecar.scope)
+      || !object(sidecar.limits)
+      || !Array.isArray(sidecar.priceKeys)
+      || sidecar.priceKeys.slice().sort().join(',') !== Object.keys(PRICE_MODELS).sort().join(','))
+    return fail('IDENTITY_MISMATCH');
+  if (sidecar.authorizationId !== qualitySha({ schema: 'mira.learning.saved-stage-tail-authorization.v1', identity: sidecar.identity }))
+    return fail('AUTHORIZATION_ID_MISMATCH');
+  const binding = parsePaidBudget(sidecar.paidBudget);
+  if (binding.authorizationId !== sidecar.authorizationId || binding.authorizationId === expected.parentAuthorizationId)
+    return fail('BINDING_MISMATCH');
+  if (!Number.isSafeInteger(sidecar.startsAt) || !Number.isSafeInteger(sidecar.expiresAt)
+      || !(sidecar.startsAt <= Date.now() && Date.now() < sidecar.expiresAt))
+    return fail('WINDOW_CLOSED');
+  const authority = await authoritativeContext(binding.authorizationId);
+  if (authority.authorizationId !== binding.authorizationId || authority.purpose !== 'production'
+      || !object(authority.completionTailGrant) || qualitySha(authority.completionTailGrant) !== qualitySha(sidecar)
+      || !object(authority.prices)
+      || Object.keys(authority.prices).sort().join(',') !== Object.keys(PRICE_MODELS).sort().join(',')
+      || Object.entries(PRICE_MODELS).some(([key, [provider, model]]) => {
+        const price = (authority.prices as RecordValue)[key];
+        return !object(price) || price.provider !== provider || price.model !== model;
+      })) return fail('AUTHORITY_MISMATCH');
+  // Clone after verification, so mutating the caller's parsed JSON cannot alter execution.
+  const token = Object.freeze({ receiptSha256: qualitySha(sidecar) }) as ValidatedCompletionTailBudget;
+  validated.set(token, JSON.parse(JSON.stringify(sidecar)) as CompletionTailSidecar);
+  return token;
+}
+
+export function assertCompletionTailExecution(
+  token: ValidatedCompletionTailBudget,
+  expected: Pick<CompletionTailIdentity, 'parentAuthorizationId' | 'buildItemId' | 'runtimeRequestId'
+    | 'formalInputSha256' | 'sourceSnapshotSha256' | 'repairSnapshotSha256' | 'sessionId' | 'ownerId'
+    | 'stageId' | 'speechActionCount' | 'sceneIds' | 'lockedQuestionIds'>,
+) {
+  const sidecar = validated.get(token);
+  if (!sidecar || Object.entries(expected).some(([key, value]) =>
+    qualitySha(sidecar.identity[key as keyof CompletionTailIdentity]) !== qualitySha(value)))
+    return fail('EXECUTION_MISMATCH');
+  return completionTailPaidBudget(token);
+}
+
+export function completionTailPaidBudget(token: ValidatedCompletionTailBudget): PaidBudgetBinding {
+  const sidecar = validated.get(token);
+  if (!sidecar) return fail('VALIDATED_CONTEXT_REQUIRED');
+  if (!(sidecar.startsAt <= Date.now() && Date.now() < sidecar.expiresAt)) return fail('WINDOW_CLOSED');
+  return { ...sidecar.paidBudget };
+}
