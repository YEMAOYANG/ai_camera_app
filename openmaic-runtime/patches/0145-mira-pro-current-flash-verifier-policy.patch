new file mode 100644
index 0000000..9f1be7d
--- /dev/null
+++ b/tests/server/mira-pro-current-flash-policy.test.ts
@@ -0,0 +1,61 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { getMiraProfessionalModelRuntimePolicy, getMiraVerifierModelId, getStageRoute,
+  MIRA_PRO_CURRENT_FLASH_MODEL_POLICY_ID as ID } from '@/lib/server/model-routes';
+import { getMiraFormalGenerationRuntimePolicy, MIRA_FORMAL_GENERATION_POLICY,
+  MIRA_PRO_CURRENT_FLASH_PROFESSIONAL_CREATION_POLICY, MIRA_PRO_CURRENT_FLASH_3D_PROFESSIONAL_CREATION_POLICY,
+  isExactMiraProfessionalCreationPolicy } from '@/lib/server/mira-formal-generation-policy';
+import { getMiraFormalProviderReadinessPolicy, MIRA_FORMAL_PROVIDER_READINESS_POLICY } from '@/lib/server/mira-formal-provider-readiness';
+import { formalQualityVerifierModel } from '@/lib/server/mira-formal-teaching-quality';
+import { formalVisualModel, selectedFormalVisualModel } from '@/lib/server/mira-formal-visual-contract';
+import { miraFormalAgentBudget, MIRA_FORMAL_AGENT_BUDGET } from '@/lib/server/mira-formal-agent-budget';
+
+afterEach(() => { vi.unstubAllEnvs(); });
+describe('Pro creation with current Flash verification frozen policy', () => {
+  it('protects Pro Agent, creator and planning but selects current Flash for verification', () => {
+    vi.stubEnv('MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY', ID);
+    vi.stubEnv('MODEL_ROUTES', JSON.stringify({'mira-courseware-creator':{model:'deepseek:deepseek-flash'}}));
+    const p=getMiraProfessionalModelRuntimePolicy();
+    expect(p.policyId).toBe(ID);
+    for(const role of ['agentDriver','coursewareCreator','structuredScene'] as const)expect(p[role].modelId).toBe('deepseek-v4-pro');
+    expect(p.coursewareVerifier.modelId).toBe('deepseek-flash');
+    expect(p.fallbackAllowed).toBe(false);
+    for(const stage of ['generate-classroom','scene-content:quiz','scene-actions','agent-profiles','web-search-query-rewrite'])
+      expect(getStageRoute(stage)?.model).toBe('deepseek:deepseek-v4-pro');
+    expect(getStageRoute('mira-courseware-verifier')?.model).toBe('deepseek:deepseek-flash');
+  });
+  it('only adds a model identity to existing creation semantics and keeps default frozen', () => {
+    vi.stubEnv('MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY', ID);
+    const generation=getMiraFormalGenerationRuntimePolicy();
+    expect(generation.professionalCreation).toEqual(MIRA_PRO_CURRENT_FLASH_PROFESSIONAL_CREATION_POLICY);
+    const {modelPolicyId,...unchanged}=MIRA_PRO_CURRENT_FLASH_PROFESSIONAL_CREATION_POLICY;
+    expect(modelPolicyId).toBe(ID);expect(unchanged).toEqual(MIRA_FORMAL_GENERATION_POLICY.professionalCreation);
+    expect(generation.professionalCreation).not.toHaveProperty('sceneLearningPolicy');
+    expect(isExactMiraProfessionalCreationPolicy(MIRA_PRO_CURRENT_FLASH_3D_PROFESSIONAL_CREATION_POLICY)).toBe(true);
+    expect(isExactMiraProfessionalCreationPolicy({...generation.professionalCreation,sceneLearningPolicy:{enforced:true}})).toBe(false);
+    delete process.env.MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY;
+    expect(getMiraFormalGenerationRuntimePolicy()).toBe(MIRA_FORMAL_GENERATION_POLICY);
+    expect(getMiraVerifierModelId()).toBe('deepseek-v4-flash');
+  });
+  it('binds current text and visual reviewer to the same exact new input/server identity', () => {
+    vi.stubEnv('MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY', ID);
+    expect(formalQualityVerifierModel({modelPolicyId:ID})).toBe('deepseek-flash');
+    expect(formalVisualModel({modelPolicyId:ID})).toBe('deepseek-flash');
+    expect(selectedFormalVisualModel({modelPolicyId:ID})).toBe('deepseek-flash');
+    expect(()=>formalQualityVerifierModel({})).toThrow('FORMAL_QUALITY_MODEL_POLICY_MISMATCH');
+    expect(()=>selectedFormalVisualModel({})).toThrow('FORMAL_VISUAL_MODEL_POLICY_MISMATCH');
+    delete process.env.MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY;
+    expect(()=>formalQualityVerifierModel({modelPolicyId:ID})).toThrow('FORMAL_QUALITY_MODEL_POLICY_MISMATCH');
+    expect(()=>selectedFormalVisualModel({modelPolicyId:ID})).toThrow('FORMAL_VISUAL_MODEL_POLICY_MISMATCH');
+    expect(formalVisualModel({})).toBe('deepseek-v4-flash-vision-exp');
+  });
+  it('readiness proves Pro generation and leaves original provider count and Agent caps intact', () => {
+    vi.stubEnv('MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY', ID);
+    const ready=getMiraFormalProviderReadinessPolicy();
+    expect(ready).toEqual({...MIRA_FORMAL_PROVIDER_READINESS_POLICY,modelPolicyId:ID});
+    expect(ready.providers.deepseek.modelId).toBe('deepseek-v4-pro');
+    expect(ready.expectedProviderCallCount).toBe(5);
+    expect(miraFormalAgentBudget(ID)).toBe(MIRA_FORMAL_AGENT_BUDGET);
+    expect(miraFormalAgentBudget(ID).maxDispatches).toBe(48);
+    expect(miraFormalAgentBudget(ID).maxCumulativeInputCharacters).toBe(8_000_000);
+  });
+});
