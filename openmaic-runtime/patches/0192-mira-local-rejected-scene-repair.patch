+import { createTextbookAuthoringGuard, textbookCanonical, textbookDigest, type FrozenTextbookContract } from '@/lib/server/mira-textbook-scene-contract';
+import { prepareRejectedSceneRepair, runRejectedSceneRepair, type RepairInput } from '@/lib/server/mira-textbook-rejected-scene-repair';
+import type { CourseStore } from '@/lib/server/agent-runtime/course-tools';
+import frozenFixture from '../fixtures/textbook-scene-contract.v1.json';
+
+const hash = (s: string | Buffer) => createHash('sha256').update(s).digest('hex');
+const cookie = '11111111-1111-4111-8111-111111111111';
+const owner = `anon:${cookie}`, stageId = 'stage-repair', sessionId = 'session-repair';
+class Pool {
+  constructor(readonly db: PGlite) {}
+  query = (sql: string, args?: unknown[]) => this.db.query(sql, args);
+  connect = async () => ({ query: this.query, release() {} });
+}
+let root: string, db: PGlite, pool: Pool, env: { pool: Pool; dataDir: string }, input: RepairInput;
+let frozen: FrozenTextbookContract, scene: any, store: ReturnType<typeof createOwnerBoundDocumentStore>, ledger: any, originalBytes: Buffer;
+const ledgerFile = () => path.join(root, 'classrooms', stageId, 'textbook-authoring-candidate.json');
+const prompt = () => '\nMIRA_TEXTBOOK_SCENE_AUTHORING_CONTRACT:\n' + JSON.stringify(frozen) + '\nEND_MIRA_TEXTBOOK_SCENE_AUTHORING_CONTRACT\n';
+const readLedger = async () => JSON.parse(await fs.readFile(ledgerFile(), 'utf8'));
+const document = () => store.loadDocument(stageId);
+async function sql(text: string, args?: unknown[]) { return db.query(text, args); }
+
+beforeEach(async () => {
