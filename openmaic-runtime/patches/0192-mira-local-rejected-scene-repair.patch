+  db = new PGlite(); await db.waitReady; pool = new Pool(db); env = { pool, dataDir: root };
+  const schemaQuery: Queryable = { query: <R extends Record<string, unknown>>(text: string, args?: unknown[]) => db.query<R>(text, args) };
+  await ensureDocumentSchema(schemaQuery); await ensureStageMetaSchema(schemaQuery); await ensureAgentSessionSchema(schemaQuery);
+  frozen = structuredClone(frozenFixture) as FrozenTextbookContract;
+  frozen.contract.pagePlan = [{ page: 1, title: '观察', type: 'interactive', widgetType: 'simulation', move: '看图并点选', cueSpeech: [{ cueId: 'intro', text: '看图，听老师说。' }] }];
+  frozen.contract.lockedAssessments = []; frozen.sha256 = textbookDigest(frozen.contract);
+  await sql('INSERT INTO agent_sessions(id,owner_id,prompt,stage_id,status) VALUES($1,$2,$3,$4,$5)', [sessionId, owner, prompt(), stageId, 'succeeded']);
+  store = createOwnerBoundDocumentStore({ pool, ownerId: owner, validateScene: validateAppScene, validateStage: validateAppStage });
+  await store.saveDocument({ stage: { id: stageId, name: 'Fixture', createdAt: 1, updatedAt: 1 }, scenes: [], outline: { producerRef: sessionId, outlines: [] } } as never);
+  const imageDir = path.join(root, 'classrooms', stageId, 'media'); await fs.mkdir(imageDir, { recursive: true });
+  await sharp({ create: { width: 64, height: 64, channels: 3, background: '#ff0000' } }).png().toFile(path.join(imageDir, 'picture.png'));
+  const src = `/api/classroom-media/${stageId}/media/picture.png`;
+  const guard = createTextbookAuthoringGuard(frozen, sessionId, { classroomsDir: path.join(root, 'classrooms') });
+  guard.wrapStore(store as unknown as CourseStore);
