+/** Local operator entry point. Reads one JSON request from stdin; never mints an owner. */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { Pool } from 'pg';
+import { prepareRejectedSceneRepair, runRejectedSceneRepair } from '../lib/server/mira-textbook-rejected-scene-repair';
+
+async function main() {
+  const mode = process.argv[2];
+  if (!['prepare', 'run'].includes(mode)) throw new Error('Usage: repair-textbook-rejected-scene.ts prepare|run < request.json');
+  let body = '';
+  for await (const chunk of process.stdin) { body += chunk; if (body.length > 1024 * 1024) throw new Error('INPUT_TOO_LARGE'); }
+  const request = JSON.parse(body);
+  const connectionString = process.env.MIRA_OPENMAIC_AGENT_DATABASE_URL ?? process.env.DATABASE_URL;
+  if (!connectionString) throw new Error('EXISTING_DATABASE_CONFIGURATION_REQUIRED');
+  const pool = new Pool({ connectionString, max: 1 });
+  try {
+    const env = { pool, dataDir: path.resolve('data') };
+    const result = mode === 'prepare'
+      ? await prepareRejectedSceneRepair(request, env)
+      : await runRejectedSceneRepair(JSON.parse(await fs.readFile(request.planPath, 'utf8')), request.approvedPlanSha256, env);
+    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
+  } finally { await pool.end(); }
+}
+main().catch(error => {
+  // Driver errors can contain connection or row data. Only expose known guard/operator codes.
+  const message = String(error?.message ?? '');
+  process.stderr.write(JSON.stringify({ error: /^(TEXTBOOK_REPAIR_|TEXTBOOK_SCENE_)[A-Z0-9_]+$/.test(message) ? message : 'LOCAL_REPAIR_FAILED_NO_AUTOMATIC_RETRY' }) + '\n');
+  process.exitCode = 1;
+});
