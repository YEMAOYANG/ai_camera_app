+/** Local operator repair only: no HTTP route, model, audio, or publication side effects. */
+import { createHash } from 'node:crypto';
+import { constants, promises as fs } from 'node:fs';
+import path from 'node:path';
+import { validateScene } from '@openmaic/dsl';
+import { PgDocumentStore, type Queryable } from '@openmaic/storage/document/pg';
+import { validateAppStage } from '@/lib/document-store/validators';
+import { createOwnerBoundDocumentStore, type TransactionSource } from '@/lib/persistence/owner-bound-document-store';
+import { resolveRequestOwnerId } from './agent-runtime/owner';
+import type { CourseDocument, CourseStore } from './agent-runtime/course-tools';
+import { createTextbookAuthoringGuard, textbookCanonical, textbookDigest, textbookContractFromPrompt } from './mira-textbook-scene-contract';
+
+type Json = Record<string, any>;
+const digestBytes = (v: string | Buffer) => createHash('sha256').update(v).digest('hex');
+const fail = (code: string): never => { throw new Error(`TEXTBOOK_REPAIR_${code}`); };
+const check = (ok: unknown, code: string): void => { if (!ok) fail(code); };
+const seal = (body: Json): Json => ({ ...body, sha256: textbookDigest(body) });
+function unseal(value: Json): Json {
+  const { sha256, ...body } = value;
+  check(sha256 === textbookDigest(body), 'SEAL_INVALID');
+  return body;
+}
+async function privateRead(file: string): Promise<Buffer> {
+  const absolute = path.resolve(file);
+  check(!(await fs.lstat(absolute)).isSymbolicLink(), 'SYMLINK_REFUSED');
+  const handle = await fs.open(absolute, constants.O_RDONLY | constants.O_NOFOLLOW);
+  try { check((await handle.stat()).isFile(), 'FILE_INVALID'); return await handle.readFile(); }
+  finally { await handle.close(); }
+}
+async function immutable(file: string, value: Json): Promise<void> {
+  const directory = path.dirname(file);
+  let current = path.parse(directory).root;
+  for (const component of directory.slice(current.length).split(path.sep)) {
+    current = path.join(current, component);
+    try { await fs.mkdir(current, { mode: 0o700 }); } catch (e: any) { if (e.code !== 'EEXIST') throw e; }
+    const stat = await fs.lstat(current);
+    check(stat.isDirectory() && !stat.isSymbolicLink(), 'PRIVATE_PATH_INVALID');
+  }
+  const bytes = textbookCanonical(value) + '\n';
+  try {
+    const handle = await fs.open(file, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, 0o600);
+    try { await handle.writeFile(bytes); await handle.sync(); } finally { await handle.close(); }
+  } catch (e: any) {
+    if (e.code !== 'EEXIST') throw e;
+    check((await privateRead(file)).toString() === bytes, 'IMMUTABLE_COLLISION');
+  }
+}
+export interface RepairInput {
+  jobDir: string;
+  archivePath: string;
+  archiveSha256: string;
+  revisedHtmlPath: string;
+  revisedHtmlSha256: string;
+}
+export interface RepairEnvironment {
+  pool: TransactionSource;
+  /** Existing Native data directory, never an arbitrary public media directory. */
+  dataDir: string;
+}
+async function inputs(input: RepairInput, env: RepairEnvironment) {
+  check(Object.keys(input).sort().join(',') === 'archivePath,archiveSha256,jobDir,revisedHtmlPath,revisedHtmlSha256', 'INPUT_SHAPE');
+  const dataDir = await fs.realpath(env.dataDir);
+  const archiveBytes = await privateRead(input.archivePath);
+  check(digestBytes(archiveBytes) === input.archiveSha256, 'ARCHIVE_SHA');
+  const archive = JSON.parse(archiveBytes.toString());
+  check(archive.schemaVersion === 'mira.textbook.rejected-scene.v1' && archive.status === 'rejected' && archive.verification === 'rejected_not_saved_not_reviewed', 'ARCHIVE_SCHEMA');
+  check(/^[A-Za-z0-9_-]{1,160}$/.test(archive.stageId) && typeof archive.sessionId === 'string', 'ARCHIVE_ID');
+  check(path.resolve(input.archivePath) === path.join(dataDir, 'textbook-rejected-scenes', digestBytes(archive.sessionId), archive.stageId, `${input.archiveSha256}.json`), 'ARCHIVE_LOCATION');
+  const scene = JSON.parse(archive.sceneCanonicalJson);
+  check(textbookCanonical(scene) === archive.sceneCanonicalJson && textbookDigest(scene) === archive.sceneSha256 && scene.stageId === archive.stageId, 'ARCHIVE_SCENE_SHA');
+  check(scene.type === 'interactive' && scene.content?.type === 'interactive' && typeof scene.content.html === 'string', 'HTML_ONLY');
+  // This version replaces only the sole HTML body; legacy duplicate bodies need an explicit future contract.
+  check(scene.content.widgetConfig?.html === undefined && (scene.content.url === undefined || scene.content.url === ''), 'DUPLICATE_HTML_UNSUPPORTED');
+  const html = await privateRead(input.revisedHtmlPath);
+  check(digestBytes(html) === input.revisedHtmlSha256 && html.length > 0 && html.length <= 4 * 1024 * 1024, 'HTML_SHA');
+  const revised = structuredClone(scene);
+  revised.content.html = new TextDecoder('utf-8', { fatal: true }).decode(html);
+  check(revised.content.html !== scene.content.html, 'NO_CHANGE');
+  const validation = validateScene(revised);
+  check(validation.valid, 'STRICT_DSL');
+  const job = path.resolve(input.jobDir);
+  const cookies = (await privateRead(path.join(job, 'owner.cookies'))).toString();
+  const owners = cookies.split(/\r?\n/).map(line => line.replace(/^#HttpOnly_/, '')).filter(line => line && !line.startsWith('#')).map(line => line.split('\t')).filter(parts => parts.length === 7 && parts[5] === 'anonymous_id').map(parts => parts[6]);
+  check(owners.length === 1 && /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(owners[0]), 'OWNER_COOKIE');
+  const headers = new Headers();
+  const ownerId = resolveRequestOwnerId({ headers: new Headers({ cookie: `anonymous_id=${owners[0]}` }) }, headers);
+  check(!headers.has('set-cookie'), 'OWNER_COOKIE');
+  const ownerFingerprint = digestBytes(owners[0]);
+  const jobState = JSON.parse((await privateRead(path.join(job, 'state.json'))).toString());
+  check(jobState.sessionId === archive.sessionId, 'JOB_SESSION');
+  const dispatch = JSON.parse((await privateRead(path.join(job, 'dispatch.json'))).toString());
+  const frozenFile = JSON.parse((await privateRead(path.join(job, 'frozen.json'))).toString());
+  check(dispatch.ownerFingerprint === ownerFingerprint && frozenFile.sceneContract?.sha256 === archive.contractSha256, 'JOB_BINDING');
+  const ledgerPath = path.join(dataDir, 'classrooms', archive.stageId, 'textbook-authoring-candidate.json');
+  const ledger = JSON.parse((await privateRead(ledgerPath)).toString());
+  unseal(ledger);
+  return { archive, scene, revised, ownerId, ownerFingerprint, frozenFile, ledger, ledgerPath, dataDir };
+}
+
+/** Reuse the real owner-bound store inside one outer transaction. Its nested transactions are SAVEPOINTs. */
+async function transaction<T>(env: RepairEnvironment, readOnly: boolean, fn: (q: Queryable, pool: TransactionSource) => Promise<T>): Promise<T> {
+  const client = await env.pool.connect();
+  const q: Queryable = { query: async <R extends Record<string, unknown>>(sql: string, args?: unknown[]) => {
+    if (readOnly) {
+      check(/^\s*SELECT\b/i.test(sql), 'READ_ONLY_QUERY');
+      // PgDocumentStore requests a share row lock for reads; the consistent
+      // read-only snapshot needs no lock, and PostgreSQL forbids it here.
+      sql = sql.replace(/\s+FOR SHARE\s*$/i, '');
+    }
+    return { rows: (await client.query(sql, args)).rows as R[] };
+  } };
+  let serial = 0;
+  const nested: TransactionSource = { connect: async () => {
+    let savepoint: string | undefined;
+    return { release() {}, query: async (sql, args) => {
+      if (sql.startsWith('BEGIN')) { check(!savepoint, 'NESTED_TRANSACTION'); savepoint = `repair_${++serial}`; return client.query(`SAVEPOINT ${savepoint}`); }
+      if (sql === 'COMMIT' || sql === 'ROLLBACK') {
+        check(savepoint, 'NESTED_TRANSACTION');
+        if (sql === 'ROLLBACK') await client.query(`ROLLBACK TO SAVEPOINT ${savepoint}`);
+        const result = await client.query(`RELEASE SAVEPOINT ${savepoint}`); savepoint = undefined; return result;
+      }
+      return client.query(sql, args);
+    } };
+  } };
+  try {
+    await client.query(readOnly ? 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY' : 'BEGIN');
+    const result = await fn(q, nested);
+    await client.query('COMMIT');
+    return result;
+  } catch (error) { await client.query('ROLLBACK'); throw error; }
+  finally { client.release(); }
+}
+async function authority(q: Queryable, state: Awaited<ReturnType<typeof inputs>>, lock: boolean) {
+  const a = state.archive;
+  const session = (await q.query('SELECT owner_id, prompt, status, deleted_at, lease_worker_id FROM agent_sessions WHERE id=$1' + (lock ? ' FOR UPDATE' : ''), [a.sessionId])).rows[0];
+  check(session && session.owner_id === state.ownerId && session.deleted_at === null && ['succeeded', 'failed', 'cancelled'].includes(String(session.status)) && session.lease_worker_id === null, 'SESSION_NOT_TERMINAL_OWNED');
+  const meta = (await q.query('SELECT owner_id, deleted_at FROM stage_meta WHERE stage_id=$1' + (lock ? ' FOR UPDATE' : ''), [a.stageId])).rows[0];
+  check(meta && meta.owner_id === state.ownerId && meta.deleted_at === null, 'STAGE_NOT_OWNED');
+  const frozen = textbookContractFromPrompt(String(session.prompt));
+  check(frozen && frozen.sha256 === a.contractSha256 && textbookDigest(frozen) === textbookDigest(state.frozenFile.sceneContract), 'SESSION_FROZEN_MISMATCH');
+  const document = await new PgDocumentStore(q, { withTransaction: async body => body(q) }).loadDocument(a.stageId) as CourseDocument | null;
+  check(document && (document.outline as Json)?.producerRef === a.sessionId, 'DOCUMENT_SESSION_MISMATCH');
+  return { frozen: frozen!, document: document! };
+}
+function describe(input: RepairInput, state: Awaited<ReturnType<typeof inputs>>, document: CourseDocument, frozen: NonNullable<ReturnType<typeof textbookContractFromPrompt>>) {
+  const a = state.archive;
+  check(!document.scenes.some(s => s.id === state.scene.id || s.order === state.scene.order), 'PAGE_EXISTS');
+  check(textbookDigest(document) === a.beforeDocumentSha256 && state.ledger.sha256 === a.beforeCandidateSha256, 'STALE_BEFORE');
+  check(state.ledger.sessionId === a.sessionId && state.ledger.stageId === a.stageId && textbookDigest(state.ledger.frozenContract) === textbookDigest(frozen), 'LEDGER_BINDING');
+  check(state.ledger.scenes.length === document.scenes.length && document.scenes.every(s => state.ledger.scenes.some((e: Json) => e.sceneId === s.id && e.sha256 === textbookDigest(s))), 'LEDGER_DOCUMENT');
+  const after = { ...document, scenes: [...document.scenes, state.revised].sort((a, b) => a.order - b.order) };
+  const ledgerBody = unseal(state.ledger);
+  const afterLedger = { ...ledgerBody, scenes: after.scenes.map(s => ({ sceneId: s.id, order: s.order, sha256: textbookDigest(s), canonicalJson: textbookCanonical(s), contractSha256: frozen.sha256 })) };
+  return seal({ schemaVersion: 'mira.textbook.rejected-scene-repair-plan.v1', verification: 'static_only_not_play_audio_or_publication', input, sessionId: a.sessionId, stageId: a.stageId, sceneId: state.scene.id, order: state.scene.order, ownerFingerprint: state.ownerFingerprint, contractSha256: a.contractSha256, archiveSceneSha256: a.sceneSha256, revisedSceneSha256: textbookDigest(state.revised), beforeDocumentSha256: a.beforeDocumentSha256, afterDocumentSha256: textbookDigest(after), beforeCandidateSha256: a.beforeCandidateSha256, afterCandidateSha256: textbookDigest(afterLedger), originalError: a.error.code });
+}
+async function dryGuard(state: Awaited<ReturnType<typeof inputs>>, frozen: NonNullable<ReturnType<typeof textbookContractFromPrompt>>, document: CourseDocument) {
+  const validated = new Error('REPAIR_DRY_RUN_VALIDATED');
+  const guard = createTextbookAuthoringGuard(frozen, state.archive.sessionId, { classroomsDir: path.join(state.dataDir, 'classrooms'), ownsStage: async () => false });
+  const store = { loadDocument: async () => document, putScene: async () => { throw validated; } } as unknown as CourseStore;
+  try { await guard.wrapStore(store).putScene(state.archive.stageId, state.revised); }
+  catch (e) { if (e === validated) return; throw e; }
+  fail('DRY_RUN_UNEXPECTED');
+}
+/** Read-only: no intent, candidate ledger, archive, DB write, model, or status transition. */
+export async function prepareRejectedSceneRepair(input: RepairInput, env: RepairEnvironment): Promise<Json> {
+  const state = await inputs(input, env);
+  return transaction(env, true, async q => {
+    const { frozen, document } = await authority(q, state, false);
+    const plan = describe(input, state, document, frozen);
+    await dryGuard(state, frozen, document);
+    return plan;
+  });
+}
+
+/** Explicit approved-plan execution. Exact intent recovery is safe even across DB/file commit interruption. */
+export async function runRejectedSceneRepair(plan: Json, approvedPlanSha256: string, env: RepairEnvironment): Promise<Json> {
+  unseal(plan);
+  check(plan.schemaVersion === 'mira.textbook.rejected-scene-repair-plan.v1' && plan.sha256 === approvedPlanSha256, 'PLAN_APPROVAL_SHA');
+  const state = await inputs(plan.input, env);
+  const directory = path.join(state.dataDir, 'textbook-rejected-scene-repairs', digestBytes(state.archive.sessionId), state.archive.stageId, plan.sha256);
+  const intentPath = path.join(directory, 'intent.json');
+  const receiptPath = path.join(directory, 'receipt.json');
+  let priorIntent: Json | undefined;
+  try { priorIntent = JSON.parse((await privateRead(intentPath)).toString()); } catch (e: any) { if (e.code !== 'ENOENT') throw e; }
+  if (priorIntent) check(textbookCanonical(priorIntent) === textbookCanonical(plan), 'INTENT_COLLISION');
+  const result = await transaction(env, false, async (q, pool) => {
+    const { frozen, document } = await authority(q, state, true);
+    let before = document;
+    let beforeLedger = state.ledger;
+    const actualSha = textbookDigest(document);
+    if (priorIntent && actualSha === plan.afterDocumentSha256) {
+      check(document.scenes.some(s => s.id === state.scene.id && textbookDigest(s) === plan.revisedSceneSha256), 'RECOVERY_SCENE');
+      before = { ...document, scenes: document.scenes.filter(s => s.id !== state.scene.id) };
+    }
+    if (priorIntent && state.ledger.sha256 === plan.afterCandidateSha256) {
+      const body = unseal(state.ledger);
+      beforeLedger = seal({ ...body, scenes: body.scenes.filter((s: Json) => s.sceneId !== state.scene.id) });
+    }
+    check(textbookCanonical(describe(plan.input, { ...state, ledger: beforeLedger }, before, frozen)) === textbookCanonical(plan), 'PLAN_STALE');
+    check(actualSha === plan.beforeDocumentSha256 || (priorIntent && actualSha === plan.afterDocumentSha256), 'DOCUMENT_CHANGED');
+    await dryGuard(state, frozen, before);
+    await immutable(intentPath, plan);
+    // All owner-store transactions share this connection. The outer session and
+    // stage locks remain held through the guard's filesystem ledger update.
+    let fenceCalls = 0;
+    const ownerStore = createOwnerBoundDocumentStore({ pool, ownerId: state.ownerId, validateScene, validateStage: validateAppStage,
+      mutationFence: async tx => {
+        const current = await authority(tx, state, true);
+        check(textbookDigest(current.document) === (fenceCalls++ === 0 ? plan.beforeDocumentSha256 : plan.afterDocumentSha256), 'ATOMIC_DOCUMENT_FENCE');
+      },
+    });
+    const store = ownerStore as unknown as CourseStore;
+    const target = actualSha === plan.afterDocumentSha256
+      ? new Proxy(store, { get(t, key) { if (key === 'putScene') return async () => {}; const value = Reflect.get(t, key); return typeof value === 'function' ? value.bind(t) : value; } })
+      : store;
+    await createTextbookAuthoringGuard(frozen, state.archive.sessionId, { classroomsDir: path.join(state.dataDir, 'classrooms'), ownsStage: async () => false }).wrapStore(target).putScene(state.archive.stageId, state.revised);
+    const final = await authority(q, state, true);
+    check(textbookDigest(final.document) === plan.afterDocumentSha256, 'AFTER_DOCUMENT');
+    const ledger = JSON.parse((await privateRead(state.ledgerPath)).toString());
+    unseal(ledger); check(ledger.sha256 === plan.afterCandidateSha256, 'AFTER_LEDGER');
+    return seal({ schemaVersion: 'mira.textbook.rejected-scene-repair-receipt.v1', status: 'static_candidate_accepted', verification: 'static_only_not_play_audio_or_publication', planSha256: plan.sha256, archiveSha256: plan.input.archiveSha256, sessionId: plan.sessionId, stageId: plan.stageId, sceneId: plan.sceneId, sceneSha256: plan.revisedSceneSha256, documentSha256: plan.afterDocumentSha256, candidateSha256: plan.afterCandidateSha256, providerCalls: 0 });
+  });
+  await immutable(receiptPath, result);
+  return result;
+}
