+    AudioStub.latest = this;
+  }
+}
+
+class AudioContextStub {
+  static latest: AudioContextStub | null = null;
+  static resumeHandler: ((context: AudioContextStub) => Promise<void>) | null = null;
+
+  state: AudioContextState = 'suspended';
+  destination = {} as AudioDestinationNode;
+  gain = { value: 0 };
+  limiter = {
+    threshold: { value: 0 },
+    knee: { value: 0 },
+    ratio: { value: 0 },
+    attack: { value: 0 },
+    release: { value: 0 },
+  };
+  source = { connect: vi.fn(), disconnect: vi.fn() };
+  gainNode = { gain: this.gain, connect: vi.fn(), disconnect: vi.fn() };
+  limiterNode = { ...this.limiter, connect: vi.fn(), disconnect: vi.fn() };
+  resume = vi.fn(() => {
+    if (AudioContextStub.resumeHandler) return AudioContextStub.resumeHandler(this);
+    this.state = 'running';
+    return Promise.resolve();
+  });
+  close = vi.fn(async () => {
+    this.state = 'closed';
+  });
+  createGain = vi.fn(() => this.gainNode as unknown as GainNode);
+  createDynamicsCompressor = vi.fn(() => this.limiterNode as unknown as DynamicsCompressorNode);
+  createMediaElementSource = vi.fn(() => this.source as unknown as MediaElementAudioSourceNode);
+
+  constructor() {
+    AudioContextStub.latest = this;
+  }
+}
+
+describe('Mira formal student audio output', () => {
+  beforeEach(() => {
+    vi.unstubAllGlobals();
+    vi.clearAllMocks();
+    AudioStub.latest = null;
+    AudioContextStub.latest = null;
+    AudioContextStub.resumeHandler = null;
+    vi.stubGlobal('Audio', AudioStub);
+    vi.stubGlobal('window', { AudioContext: AudioContextStub });
+  });
+
+  it('unlocks one audio context and applies bounded gain to runtime narration', async () => {
+    const player = new AudioPlayer();
+
+    player.prepareStudentPlayback();
+    expect(AudioContextStub.latest?.resume).toHaveBeenCalledTimes(1);
+
+    await expect(
+      player.play('formal-audio-1', `/mira/runtime-audio/formal_audio_asset_${'a'.repeat(48)}`),
+    ).resolves.toBe(true);
+
+    expect(AudioContextStub.latest?.createMediaElementSource).toHaveBeenCalledTimes(1);
+    expect(AudioContextStub.latest?.gain.value).toBeCloseTo(1.995262, 6);
+    expect(AudioContextStub.latest?.limiter.threshold.value).toBe(-1);
+    expect(AudioContextStub.latest?.limiter.ratio.value).toBe(20);
+    expect(AudioStub.latest).toMatchObject({ muted: false, volume: 1 });
+
+    player.setVolume(0.5);
+    expect(AudioContextStub.latest?.gain.value).toBeCloseTo(0.997631, 6);
+    player.setMuted(true);
+    expect(AudioContextStub.latest?.gain.value).toBe(0);
+    player.setMuted(false);
+    expect(AudioContextStub.latest?.gain.value).toBeCloseTo(0.997631, 6);
+
+    player.destroy();
+    expect(AudioContextStub.latest?.close).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not boost unrelated operator audio URLs', async () => {
+    const player = new AudioPlayer();
+    player.prepareStudentPlayback();
+
+    await expect(player.play('operator-audio', '/api/classroom-media/audio.wav')).resolves.toBe(
+      true,
+    );
+
+    expect(AudioContextStub.latest?.createMediaElementSource).not.toHaveBeenCalled();
+    expect(AudioStub.latest).toMatchObject({ muted: false, volume: 1 });
+  });
+
+  it('keeps native audio audible until a deferred context unlock succeeds', async () => {
+    let finishUnlock = () => {};
+    AudioContextStub.resumeHandler = (context) =>
+      new Promise<void>((resolve) => {
+        finishUnlock = () => {
+          context.state = 'running';
+          resolve();
+        };
+      });
+    const player = new AudioPlayer();
+    player.prepareStudentPlayback();
+
+    await player.play('formal-audio-2', `/mira/runtime-audio/formal_audio_asset_${'b'.repeat(48)}`);
+
+    expect(AudioStub.latest?.play).toHaveBeenCalledTimes(1);
+    expect(AudioContextStub.latest?.createMediaElementSource).not.toHaveBeenCalled();
+
+    finishUnlock();
+    await vi.waitFor(() => {
+      expect(AudioContextStub.latest?.createMediaElementSource).toHaveBeenCalledTimes(1);
+    });
+  });
+
+  it('falls back to native audio when context unlock is rejected', async () => {
+    AudioContextStub.resumeHandler = async () => {
+      throw new Error('AudioContext blocked');
+    };
+    const player = new AudioPlayer();
+    player.prepareStudentPlayback();
+
+    await player.play('formal-audio-3', `/mira/runtime-audio/formal_audio_asset_${'c'.repeat(48)}`);
+    await Promise.resolve();
+
+    expect(AudioStub.latest?.play).toHaveBeenCalledTimes(1);
+    expect(AudioContextStub.latest?.createMediaElementSource).not.toHaveBeenCalled();
+    expect(AudioStub.latest).toMatchObject({ muted: false, volume: 1 });
+  });
+});
