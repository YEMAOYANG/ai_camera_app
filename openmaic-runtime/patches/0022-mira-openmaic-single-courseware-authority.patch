r);gl.attachShader(program,fragmentShader);gl.linkProgram(program);gl.useProgram(program);const vertices=new Float32Array([-.5,-.5,0,.5,-.5,0,0,.5,0]);const buffer=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,buffer);gl.bufferData(gl.ARRAY_BUFFER,vertices,gl.STATIC_DRAW);const position=gl.getAttribLocation(program,'position');gl.enableVertexAttribArray(position);gl.vertexAttribPointer(position,3,gl.FLOAT,false,0,0);const angleLocation=gl.getUniformLocation(program,'angle');const zoomLocation=gl.getUniformLocation(program,'zoom');const modelStatus=document.getElementById('model-status');const zoomControl=document.getElementById('zoom-control');let rotation=0;let zoom=1;function renderModel(){gl.viewport(0,0,canvas.width,canvas.height);gl.clearColor(.86,.92,.98,1);gl.clear(gl.COLOR_BUFFER_BIT);gl.uniform1f(angleLocation,rotation);gl.uniform1f(zoomLocation,zoom);gl.drawArrays(gl.TRIANGLES,0,3);modelStatus.textContent='正在观察：'+labels[Math.round(rotation/.25)%labels.length];}document.getElementById('rotate-button').addEventListener('click',function(){rotation += .25;renderModel();});zoomControl.addEventListener('input',function(){zoom = Number(zoomControl.value);renderModel();});renderModel();</script>${highlightScript()}</body></html>`;
