+++ b/lib/server/mira-formal-compiled-classroom.ts
@@ -0,0 +1,623 @@
+import { nanoid } from 'nanoid';
+import { buildCompleteScene, type GeneratedSceneContent, type SceneOutline } from '@openmaic/generation';
+import type { PPTElement, QuizQuestion, WidgetConfigBase } from '@openmaic/dsl';
+import type {
+  ClassroomGenerationProgress,
+  GenerateClassroomInput,
+  GenerateClassroomResult,
+} from '@/lib/server/classroom-generation';
+import { AGENT_COLOR_PALETTE, AGENT_DEFAULT_AVATARS } from '@/lib/constants/agent-defaults';
+import { persistClassroom } from '@/lib/server/classroom-storage';
+import {
+  isExactMiraCoursewareAuthority,
+  isExactMiraFormalRuntimeContract,
+} from '@/lib/server/mira-formal-generation-policy';
+import type { Action } from '@/lib/types/action';
+import type { Scene, Stage } from '@/lib/types/stage';
+
+type JsonObject = Record<string, unknown>;
+
+interface FormalQuestion {
+  id: string;
+  type: 'numeric' | 'single_choice' | 'exact_text' | 'accepted_text' | 'sequence';
+  prompt: string;
+  skill: string;
+  hint: string;
+  explanation: string;
+  choices?: Array<{ id: string; label: string }>;
+}
+
+interface FormalCoursewareSpec {
+  course: {
+    id: string;
+    version: string;
+    gradeCode: string;
+    subject: string;
+    skillId: string;
+    title: string;
+    objective: string;
+  };
+  intro: string;
+  estimatedMinutes: number;
+  teach: { title: string; sayText: string; keyPoints: string[] };
+  recap: string;
+  demo: FormalQuestion;
+  guided: [FormalQuestion, FormalQuestion];
+  independent: [FormalQuestion, FormalQuestion];
+  teacher: {
+    name: string;
+    avatar: string;
+    voiceConfig: { providerId: string; modelId: string; voiceId: string };
+  };
+}
+
+function record(value: unknown, label: string): JsonObject {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new Error(`FORMAL_COMPILED_INPUT_INVALID:${label}`);
+  }
+  return value as JsonObject;
+}
+
+function textValue(value: unknown, label: string, maximum = 2_400): string {
+  if (typeof value !== 'string') throw new Error(`FORMAL_COMPILED_INPUT_INVALID:${label}`);
+  const valueText = value.trim();
+  if (!valueText || valueText.length > maximum) {
+    throw new Error(`FORMAL_COMPILED_INPUT_INVALID:${label}`);
+  }
+  return valueText;
+}
+
+function stringList(value: unknown, label: string, expected?: number): string[] {
+  if (!Array.isArray(value) || (expected !== undefined && value.length !== expected)) {
+    throw new Error(`FORMAL_COMPILED_INPUT_INVALID:${label}`);
+  }
+  const items = value.map((item, index) => textValue(item, `${label}.${index}`, 400));
+  if (new Set(items).size !== items.length) {
+    throw new Error(`FORMAL_COMPILED_INPUT_INVALID:${label}`);
+  }
+  return items;
+}
+
+function exactObject(value: unknown, expected: JsonObject): boolean {
+  const canonical = (item: unknown): unknown => {
+    if (Array.isArray(item)) return item.map(canonical);
+    if (item && typeof item === 'object') {
+      return Object.fromEntries(
+        Object.entries(item as JsonObject)
+          .sort(([left], [right]) => left.localeCompare(right))
+          .map(([key, nested]) => [key, canonical(nested)]),
+      );
+    }
+    return item;
+  };
+  return JSON.stringify(canonical(value)) === JSON.stringify(canonical(expected));
+}
+
+function parseQuestion(value: unknown, label: string): FormalQuestion {
+  const question = record(value, label);
+  const type = textValue(question.type, `${label}.type`, 32);
+  if (!['numeric', 'single_choice', 'exact_text', 'accepted_text', 'sequence'].includes(type)) {
+    throw new Error(`FORMAL_COMPILED_INPUT_INVALID:${label}.type`);
+  }
+  const result: FormalQuestion = {
+    id: textValue(question.id, `${label}.id`, 160),
+    type: type as FormalQuestion['type'],
+    prompt: textValue(question.prompt, `${label}.prompt`, 1_200),
+    skill: textValue(question.skill, `${label}.skill`, 240),
+    hint: textValue(question.hint, `${label}.hint`, 800),
+    explanation: textValue(question.explanation, `${label}.explanation`, 1_600),
+  };
+  if (result.type === 'single_choice' || result.type === 'sequence') {
+    if (!Array.isArray(question.choices) || question.choices.length < 2) {
+      throw new Error(`FORMAL_COMPILED_INPUT_INVALID:${label}.choices`);
+    }
+    result.choices = question.choices.map((rawChoice, index) => {
+      const choice = record(rawChoice, `${label}.choices.${index}`);
+      return {
+        id: textValue(choice.id, `${label}.choices.${index}.id`, 80),
+        label: textValue(choice.label, `${label}.choices.${index}.label`, 480),
+      };
+    });
+  }
+  return result;
+}
+
+function parseFormalCoursewareSpec(input: GenerateClassroomInput): FormalCoursewareSpec {
+  if (
+    !isExactMiraFormalRuntimeContract(input.formalRuntimeContract) ||
+    !isExactMiraCoursewareAuthority(input.coursewareAuthority)
+  ) {
+    throw new Error('FORMAL_COURSEWARE_AUTHORITY_INVALID');
+  }
+  let rawContract: unknown;
+  try {
+    rawContract = JSON.parse(input.requirement);
+  } catch {
+    throw new Error('FORMAL_COMPILED_INPUT_INVALID:requirement');
+  }
+  const contract = record(rawContract, 'contract');
+  if (
+    contract.schemaVersion !== 'mira.openmaic.formal-runtime.v1' ||
+    contract.authority !== 'mira_backend_formal_candidate' ||
+    !isExactMiraCoursewareAuthority(contract.coursewareAuthority)
+  ) {
+    throw new Error('FORMAL_COURSEWARE_AUTHORITY_INVALID');
+  }
+  const brief = record(contract.teachingBrief, 'teachingBrief');
+  const briefAuthority = record(brief.authority, 'teachingBrief.authority');
+  if (
+    brief.schemaVersion !== 'mira.learning.formal-runtime-teaching-brief.v1' ||
+    !exactObject(briefAuthority, {
+      source: 'locked_learning_course',
+      answerContractProvided: false,
+      scoringRulesProvided: false,
+      providerSecretsProvided: false,
+    })
+  ) {
+    throw new Error('FORMAL_COMPILED_INPUT_INVALID:teachingBrief');
+  }
+  const course = record(brief.course, 'course');
+  const lesson = record(brief.lesson, 'lesson');
+  const flow = record(lesson.teachingFlow, 'teachingFlow');
+  const teach = record(flow.teach, 'teachingFlow.teach');
+  const recap = record(flow.recap, 'teachingFlow.recap');
+  if (!Array.isArray(lesson.questions) || lesson.questions.length !== 5) {
+    throw new Error('FORMAL_COMPILED_INPUT_INVALID:questions');
+  }
+  const questions = lesson.questions.map((item, index) => parseQuestion(item, `questions.${index}`));
+  const questionById = new Map(questions.map((question) => [question.id, question]));
+  if (questionById.size !== 5) throw new Error('FORMAL_COMPILED_INPUT_INVALID:questionIds');
+  const demoId = textValue(flow.demoQuestionId, 'teachingFlow.demoQuestionId', 160);
+  const guidedIds = stringList(flow.guidedQuestionIds, 'teachingFlow.guidedQuestionIds', 2);
+  const independentIds = stringList(
+    flow.independentQuestionIds,
+    'teachingFlow.independentQuestionIds',
+    2,
+  );
+  const orderedIds = [demoId, ...guidedIds, ...independentIds];
+  if (
+    new Set(orderedIds).size !== 5 ||
+    orderedIds.some((id, index) => questions[index]?.id !== id || !questionById.has(id))
+  ) {
+    throw new Error('FORMAL_COMPILED_INPUT_INVALID:teachingRoles');
+  }
+  const teacherContract = record(contract.teacher, 'teacher');
+  const runtimeTeacher = record(teacherContract.runtime, 'teacher.runtime');
+  const voiceConfig = record(runtimeTeacher.voiceConfig, 'teacher.runtime.voiceConfig');
+  if (runtimeTeacher.role !== 'teacher') {
+    throw new Error('FORMAL_COMPILED_INPUT_INVALID:teacher.role');
+  }
+  const minutes = lesson.estimatedMinutes;
+  if (typeof minutes !== 'number' || !Number.isSafeInteger(minutes) || minutes < 5 || minutes > 30) {
+    throw new Error('FORMAL_COMPILED_INPUT_INVALID:estimatedMinutes');
+  }
+  return {
+    course: {
+      id: textValue(course.id, 'course.id', 255),
+      version: textValue(course.version, 'course.version', 64),
+      gradeCode: textValue(course.gradeCode, 'course.gradeCode', 64),
+      subject: textValue(course.subject, 'course.subject', 64),
