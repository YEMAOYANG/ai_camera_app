evels[Math.min(level-1,levels.length-1)];gameContext.clearRect(0,0,420,90);gameContext.fillStyle='#2e9187';gameContext.fillRect(0,28,Math.round(progress*4.2),24);}document.getElementById('challenge-button').addEventListener('click',function(){score += 10;level += 1;progress = Math.min(100,Math.round(score/Math.max(10,levels.length*10)*100));renderGame();requestAnimationFrame(renderGame);});document.getElementById('retry-button').addEventListener('click',function(){score = Math.max(0,score-10);level = Math.max(1,level-1);progress = Math.max(0,progress-25);renderGame();requestAnimationFrame(renderGame);});renderGame();</script>${highlightScript()}</body></html>`;
