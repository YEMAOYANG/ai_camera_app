@@ -0,0 +1,34 @@
+import type { NextRequest } from 'next/server';
+import { apiError, apiSuccess } from '@/lib/server/api-response';
+import {
+  authorizeMiraCoursewareProviderRequest,
+  executeMiraCoursewareProvider,
+  MiraCoursewareProviderError,
+} from '@/lib/server/mira-courseware-provider';
+
+export const dynamic = 'force-dynamic';
+export const maxDuration = 360;
+
+export async function POST(req: NextRequest) {
+  try {
+    authorizeMiraCoursewareProviderRequest(req);
+    return apiSuccess({ ...(await executeMiraCoursewareProvider(await req.json())) });
+  } catch (error) {
+    if (error instanceof MiraCoursewareProviderError) {
+      if (error.code === 'unauthorized') {
+        return apiError('INVALID_CREDENTIALS', 403, 'Invalid courseware credentials');
+      }
+      if (error.code === 'provider_unavailable') {
+        return apiError('PROVIDER_DISABLED', 424, 'Courseware Provider is unavailable');
+      }
+      if (error.code === 'provider_rejected') {
+        return apiError('UPSTREAM_ERROR', 422, 'Courseware Provider rejected the request');
+      }
+      if (error.code === 'provider_failed') {
+        return apiError('GENERATION_FAILED', 502, 'Courseware Provider call failed');
+      }
+      return apiError('INVALID_REQUEST', 400, 'Invalid courseware request');
+    }
+    return apiError('INTERNAL_ERROR', 500, 'Courseware Provider call failed');
+  }
+}
