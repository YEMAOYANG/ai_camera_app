+export function buildMiraFormalCompiledDraft(
+  input: GenerateClassroomInput,
+  classroomId = nanoid(10),
+): { stage: Stage; scenes: Scene[] } {
+  const spec = parseFormalCoursewareSpec(input);
+  const stage: Stage = {
+    id: classroomId,
+    name: spec.course.title,
+    description: spec.course.objective,
+    languageDirective:
+      spec.course.subject === 'english'
+        ? '使用简体中文讲解，英语目标内容使用英语。'
+        : '全程使用简体中文，句子简短，一次只要求一个学习动作。',
+    style: 'interactive',
+    interactiveMode: true,
+    createdAt: Date.now(),
+    updatedAt: Date.now(),
+    generatedAgentConfigs: [
+      {
+        id: 'mira-formal-teacher',
+        name: spec.teacher.name,
+        role: 'teacher',
+        persona: '耐心讲解、先教后练，并引导学生说出思考过程。',
+        avatar: spec.teacher.avatar,
+        color: AGENT_COLOR_PALETTE[0],
+        priority: 10,
+        voiceConfig: spec.teacher.voiceConfig,
+      },
+      ...['小问号', '会观察', '爱表达', '能检查'].map((name, index) => ({
+        id: `mira-formal-peer-${index + 1}`,
+        name,
+        role: 'student',
+        persona: '和学生一起观察、练习，并用短句交流学习方法。',
+        avatar: AGENT_DEFAULT_AVATARS[(index + 1) % AGENT_DEFAULT_AVATARS.length],
+        color: AGENT_COLOR_PALETTE[(index + 1) % AGENT_COLOR_PALETTE.length],
+        priority: 5,
+      })),
+    ],
+  };
+
+  const sceneSpecs: Array<{
+    outline: SceneOutline;
+    content: GeneratedSceneContent;
+    actions: Action[];
+  }> = [
+    {
+      outline: outline(0, 'slide', spec.course.title, spec.course.objective, [spec.intro]),
+      content: slideContent(spec.course.title, spec.course.objective, [spec.intro]),
+      actions: [
+        speech(0, spec.intro),
+        { id: 'mira-formal-spotlight-01', type: 'spotlight', elementId: 'slide-title' },
+      ],
+    },
+    {
+      outline: outline(1, 'slide', spec.teach.title, spec.course.objective, spec.teach.keyPoints),
+      content: slideContent(spec.teach.title, spec.teach.sayText, spec.teach.keyPoints),
+      actions: [
+        speech(1, spec.teach.sayText),
+        {
+          id: 'mira-formal-discussion-01',
+          type: 'discussion',
+          topic: `说一说《${spec.teach.title}》最重要的方法`,
+          agentId: 'mira-formal-peer-1',
+        },
+      ],
+    },
+    {
+      outline: outline(2, 'slide', '老师示范', spec.demo.prompt, [spec.demo.hint]),
+      content: slideContent('老师示范', spec.demo.prompt, [spec.demo.hint, spec.demo.explanation]),
+      actions: [
+        speech(2, `${spec.demo.prompt} ${spec.demo.hint} ${spec.demo.explanation}`),
+        {
+          id: 'mira-formal-discussion-02',
+          type: 'discussion',
+          topic: '说一说示范题使用了什么方法',
+          agentId: 'mira-formal-peer-2',
+        },
+      ],
+    },
+    {
+      outline: outline(3, 'slide', '跟着方法练', '先读题，再选择合适的方法。', spec.guided.map((item) => item.hint)),
+      content: slideContent('跟着方法练', '先读题，再选择合适的方法。', spec.guided.map((item) => item.hint)),
+      actions: [speech(3, '接下来跟着方法练习。先认真读题，再根据提示想一想。')],
+    },
+    {
+      outline: outline(4, 'slide', '独立练习前检查', spec.recap, ['读清题目', '自己作答', '完成后检查']),
+      content: slideContent('独立练习前检查', spec.recap, ['读清题目', '自己作答', '完成后检查']),
+      actions: [speech(4, `${spec.recap} 下面请独立完成练习。`)],
+    },
+    {
+      outline: outline(5, 'quiz', '引导练习', '在提示支持下完成两道练习。', spec.guided.map((item) => item.skill)),
+      content: { questions: spec.guided.map(runtimeQuestion) },
+      actions: [speech(5, '现在完成两道引导练习。可以使用刚才学到的方法，不着急。')],
+    },
+    {
+      outline: outline(6, 'quiz', '独立检测', '独立完成两道检测题。', spec.independent.map((item) => item.skill)),
+      content: { questions: spec.independent.map(runtimeQuestion) },
+      actions: [speech(6, '现在请独立完成两道检测题。这里不会提前显示答案。')],
+    },
+    {
+      outline: outline(7, 'interactive', '方法模拟', '按步骤观察方法怎样使用。', spec.teach.keyPoints, 'simulation'),
+      content: simulationContent(spec),
+      actions: [
+        speech(7, '拖动学习步骤控件，依次观察、练习和检查。'),
+        {
+          id: 'mira-formal-widget-highlight-01',
+          type: 'widget_highlight',
+          target: 'step-control',
+        },
+      ],
+    },
+    {
+      outline: outline(8, 'interactive', '方法闯关', '逐关说出本课方法。', spec.teach.keyPoints, 'game'),
+      content: gameContent(spec),
+      actions: [speech(8, '点击闯关按钮，每过一关就说出一种本课方法。')],
+    },
+    {
+      outline: outline(9, 'interactive', '知识积木', '旋转和缩放知识积木，回顾方法关系。', spec.teach.keyPoints, 'visualization3d'),
+      content: visualizationContent(spec),
+      actions: [speech(9, `${spec.recap} 请旋转知识积木，再说出你已经学会的方法。`)],
+    },
+  ];
+
+  const scenes = sceneSpecs.map((item) => {
+    const scene = buildCompleteScene(item.outline, item.content, item.actions, classroomId, {
+      sceneId: `${classroomId}-${item.outline.id}`,
+    });
+    if (!scene) throw new Error(`FORMAL_COMPILED_SCENE_INVALID:${item.outline.id}`);
+    return scene as Scene;
+  });
+  return { stage, scenes };
+}
+
+export async function generateMiraFormalCompiledClassroom(
+  input: GenerateClassroomInput,
+  options: {
+    baseUrl: string;
+    onProgress?: (progress: ClassroomGenerationProgress) => Promise<void> | void;
+  },
+): Promise<GenerateClassroomResult> {
+  await options.onProgress?.({
+    step: 'generating_outlines',
+    progress: 25,
+    message: 'Compiling the locked OpenMAIC courseware artifact',
+    scenesGenerated: 0,
+    totalScenes: 10,
+  });
+  const { stage, scenes } = buildMiraFormalCompiledDraft(input);
+  await options.onProgress?.({
+    step: 'generating_scenes',
+    progress: 90,
+    message: 'Compiled 10 classroom scenes with zero model calls',
+    scenesGenerated: scenes.length,
+    totalScenes: 10,
+  });
+  await options.onProgress?.({
+    step: 'persisting',
+    progress: 98,
+    message: 'Persisting the compiled classroom',
+    scenesGenerated: scenes.length,
+    totalScenes: 10,
+  });
+  const persisted = await persistClassroom({ id: stage.id, stage, scenes }, options.baseUrl);
+  await options.onProgress?.({
+    step: 'completed',
+    progress: 100,
+    message: 'OpenMAIC classroom compilation completed without another model generation',
+    scenesGenerated: scenes.length,
+    totalScenes: 10,
+  });
+  return {
+    id: persisted.id,
+    url: persisted.url,
+    stage,
+    scenes,
+    scenesCount: scenes.length,
+    createdAt: persisted.createdAt,
+  };
+}
