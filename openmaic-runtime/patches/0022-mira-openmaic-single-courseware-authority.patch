index 0000000..3274690
--- /dev/null
+++ b/tests/server/mira-courseware-provider.test.ts
@@ -0,0 +1,169 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({
+  resolveModel: vi.fn(),
+  callLLM: vi.fn(),
+  defaultSettingsMiddleware: vi.fn((options) => options),
+  wrapLanguageModel: vi.fn(({ model, middleware }) => ({ model, middleware, wrapped: true })),
+}));
+
+vi.mock('@/lib/server/resolve-model', () => ({
+  resolveModel: mocks.resolveModel,
+}));
+
+vi.mock('@/lib/ai/llm', () => ({
+  callLLM: mocks.callLLM,
+}));
+
+vi.mock('@/lib/ai/providers', () => ({
+  isProviderKeyRequired: () => true,
+}));
+
+vi.mock('ai', () => ({
+  defaultSettingsMiddleware: mocks.defaultSettingsMiddleware,
+  wrapLanguageModel: mocks.wrapLanguageModel,
+}));
+
+function request() {
+  return {
+    schemaVersion: 'mira.openmaic.courseware-provider-call.v1',
+    requestId: 'primary_1-math-course-1-outline-attempt-1',
+    phase: 'outline',
+    systemPrompt: '只生成课程结构。',
+    userPrompt: '为一年级数学生成课件。',
+    responseJsonSchema: {
+      type: 'object',
+      additionalProperties: false,
+      required: ['phaseStatus'],
+      properties: { phaseStatus: { type: 'string' } },
+    },
+  };
+}
+
+describe('Mira OpenMAIC courseware Provider boundary', () => {
+  beforeEach(() => {
+    mocks.resolveModel.mockReset();
+    mocks.callLLM.mockReset();
+    mocks.defaultSettingsMiddleware.mockClear();
+    mocks.wrapLanguageModel.mockClear();
+    mocks.resolveModel.mockResolvedValue({
+      providerId: 'kimi',
+      modelId: 'kimi-k2.6',
+      model: { provider: 'kimi', modelId: 'kimi-k2.6' },
+      modelInfo: { outputWindow: 16_000 },
+      apiKey: 'runtime-owned-key',
+    });
+    mocks.callLLM.mockResolvedValue({
+      text: '{"phaseStatus":"accepted"}',
+      totalUsage: { inputTokens: 10, outputTokens: 5 },
+      response: { id: 'provider-response-1' },
+    });
+  });
+
+  afterEach(() => {
+    delete process.env.MIRA_INTERNAL_API_TOKEN;
+  });
+
+  it('owns the one Kimi courseware call and applies the Sidecar JSON schema', async () => {
+    const { executeMiraCoursewareProvider } = await import(
+      '@/lib/server/mira-courseware-provider'
+    );
+    const result = await executeMiraCoursewareProvider(request());
+
+    expect(mocks.resolveModel).toHaveBeenCalledTimes(1);
+    expect(mocks.resolveModel).toHaveBeenCalledWith({ stage: 'generate-classroom' });
+    expect(mocks.wrapLanguageModel).toHaveBeenCalledTimes(1);
+    expect(mocks.defaultSettingsMiddleware).toHaveBeenCalledWith({
+      settings: {
+        responseFormat: {
+          type: 'json',
+          schema: request().responseJsonSchema,
+          name: 'mira_courseware_outline',
+        },
+      },
+    });
+    expect(mocks.callLLM).toHaveBeenCalledTimes(1);
+    expect(mocks.callLLM).toHaveBeenCalledWith(
+      expect.objectContaining({
+        temperature: 0.6,
+        maxOutputTokens: 8_000,
+        maxRetries: 0,
+      }),
+      'mira-courseware-provider',
+      undefined,
+      { mode: 'disabled', enabled: false },
+    );
+    expect(result).toMatchObject({
+      requestId: request().requestId,
+      phase: 'outline',
+      content: '{"phaseStatus":"accepted"}',
+      inputTokens: 10,
+      outputTokens: 5,
+      billingEvidence: 'reported',
+    });
+    expect(result.providerRequestIdHash).toMatch(/^[a-f0-9]{64}$/);
+  });
+
+  it('rejects any non-pinned Provider before a paid call', async () => {
+    mocks.resolveModel.mockResolvedValue({
+      providerId: 'openai',
+      modelId: 'gpt-5',
+      model: { provider: 'openai', modelId: 'gpt-5' },
+      modelInfo: { outputWindow: 8_000 },
+      apiKey: 'other-key',
+    });
+    const { executeMiraCoursewareProvider } = await import(
+      '@/lib/server/mira-courseware-provider'
+    );
+    await expect(executeMiraCoursewareProvider(request())).rejects.toMatchObject({
+      code: 'provider_unavailable',
+    });
+    expect(mocks.callLLM).not.toHaveBeenCalled();
+  });
+
+  it('classifies a provider 4xx as a definitive rejection without retrying', async () => {
+    mocks.callLLM.mockRejectedValueOnce(
+      Object.assign(new Error('provider rejected request'), { statusCode: 429 }),
+    );
+    const { executeMiraCoursewareProvider } = await import(
+      '@/lib/server/mira-courseware-provider'
+    );
+
+    await expect(executeMiraCoursewareProvider(request())).rejects.toMatchObject({
+      code: 'provider_rejected',
+    });
+    expect(mocks.callLLM).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps timeouts and provider 5xx failures ambiguous', async () => {
+    const { executeMiraCoursewareProvider } = await import(
+      '@/lib/server/mira-courseware-provider'
+    );
+    for (const failure of [
+      Object.assign(new Error('request timeout'), { statusCode: 408 }),
+      Object.assign(new Error('provider unavailable'), { statusCode: 503 }),
+    ]) {
+      mocks.callLLM.mockRejectedValueOnce(failure);
+      await expect(executeMiraCoursewareProvider(request())).rejects.toMatchObject({
+        code: 'provider_failed',
+      });
+    }
+    expect(mocks.callLLM).toHaveBeenCalledTimes(2);
+  });
+
+  it('requires the private OpenMAIC token', async () => {
+    process.env.MIRA_INTERNAL_API_TOKEN = 'private-token';
+    const { NextRequest } = await import('next/server');
+    const { authorizeMiraCoursewareProviderRequest } = await import(
+      '@/lib/server/mira-courseware-provider'
+    );
+    const allowed = new NextRequest('http://127.0.0.1/api/mira/courseware-provider-call', {
+      headers: { 'x-mira-internal-token': 'private-token' },
+    });
+    expect(() => authorizeMiraCoursewareProviderRequest(allowed)).not.toThrow();
+    const rejected = new NextRequest('http://127.0.0.1/api/mira/courseware-provider-call');
+    expect(() => authorizeMiraCoursewareProviderRequest(rejected)).toThrow(
+      'Courseware Provider access is private',
+    );
+  });
+});
