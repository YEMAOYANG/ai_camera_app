+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replaceAll('&', '&amp;')
+    .replaceAll('<', '&lt;')
+    .replaceAll('>', '&gt;')
+    .replaceAll('"', '&quot;')
+    .replaceAll("'", '&#39;');
+}
+
+function scriptJson(value: unknown): string {
+  return JSON.stringify(value).replaceAll('<', '\\u003c').replaceAll('>', '\\u003e');
+}
+
+function textElement(
+  id: string,
+  content: string,
+  left: number,
+  top: number,
+  width: number,
+  height: number,
+  fontSize: number,
+  fill?: string,
+): PPTElement {
+  return {
+    id,
+    type: 'text',
+    content: `<p style="font-size:${fontSize}px;line-height:1.35;margin:0">${escapeHtml(content)}</p>`,
+    left,
+    top,
+    width,
+    height,
+    rotate: 0,
+    defaultFontName: 'Microsoft YaHei',
+    defaultColor: '#18324a',
+    fill,
+    lineHeight: 1.35,
+    paragraphSpace: 0,
+    textType: top < 120 ? 'title' : 'content',
+    vAlign: 'middle',
+  };
+}
+
+function slideContent(title: string, lead: string, points: readonly string[]): GeneratedSceneContent {
+  const safePoints = points.slice(0, 4);
+  return {
+    elements: [
+      textElement('slide-title', title, 64, 42, 872, 72, 38),
+      textElement('slide-lead', lead, 64, 132, 872, 90, 25, '#eef8f6'),
+      ...safePoints.map((point, index) =>
+        textElement(
+          `slide-point-${index + 1}`,
+          `${index + 1}. ${point}`,
+          86,
+          250 + index * 72,
+          828,
+          58,
+          23,
+          index % 2 === 0 ? '#f4f0ff' : '#fff4e6',
+        ),
+      ),
+    ],
+    background: { type: 'solid', color: '#fbfdfc' },
+  };
+}
+
+function runtimeQuestion(question: FormalQuestion): QuizQuestion {
+  const runtimeType =
+    question.type === 'single_choice'
+      ? 'single'
+      : question.type === 'sequence'
+        ? 'multiple'
+        : 'short_answer';
+  return {
+    id: question.id,
+    type: runtimeType,
+    question: question.prompt,
+    ...(question.choices
+      ? {
+          options: question.choices.map((choice) => ({
+            value: choice.id,
+            label: choice.label,
+          })),
+        }
+      : {}),
+    answer: [],
+    hasAnswer: false,
+    points: 1,
+  };
+}
