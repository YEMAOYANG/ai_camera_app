diff --git a/lib/server/mira-courseware-provider.ts b/lib/server/mira-courseware-provider.ts
new file mode 100644
index 0000000..caf7599
--- /dev/null
+++ b/lib/server/mira-courseware-provider.ts
@@ -0,0 +1,244 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+import type { NextRequest } from 'next/server';
+import { defaultSettingsMiddleware, wrapLanguageModel } from 'ai';
+import { callLLM } from '@/lib/ai/llm';
+import { isProviderKeyRequired } from '@/lib/ai/providers';
+import { resolveModel } from '@/lib/server/resolve-model';
+
+export const MIRA_COURSEWARE_PROVIDER_SCHEMA =
+  'mira.openmaic.courseware-provider-call.v1' as const;
+
+const REQUEST_ID = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$/;
+const PHASES = new Set([
+  'outline',
+  'raw_candidate',
+  'candidate_repair',
+  'candidate_repair_retry',
+  'lesson_text',
+  'reconciliation',
+  'reconciliation_retry',
+  'practice_leak_repair_1',
+  'practice_leak_repair_2',
+  'choice_prompt_repair',
+  'independent_verification',
+  'consistency_repair',
+  'consistency_repair_retry',
+  'verification_after_repair',
+]);
+
+const MAX_PROMPT_CHARS = 200_000;
+const MAX_SCHEMA_BYTES = 128_000;
+const COURSEWARE_THINKING_DISABLED = { mode: 'disabled', enabled: false } as const;
+
+export class MiraCoursewareProviderError extends Error {
+  constructor(
+    public readonly code:
+      | 'unauthorized'
+      | 'invalid_request'
+      | 'provider_unavailable'
+      | 'provider_rejected'
+      | 'provider_failed',
+    message: string,
+  ) {
+    super(message);
+    this.name = 'MiraCoursewareProviderError';
+  }
+}
+
+function providerStatus(error: unknown, seen = new Set<unknown>()): number | null {
+  if (!error || seen.has(error)) return null;
+  seen.add(error);
+  if (typeof error !== 'object') return null;
+  const record = error as Record<string, unknown>;
+  const raw = record.statusCode ?? record.status ?? record.status_code;
+  const parsed = typeof raw === 'number' ? raw : Number.parseInt(String(raw ?? ''), 10);
+  if (Number.isInteger(parsed) && parsed >= 400 && parsed <= 599) return parsed;
+  const nested = [record.cause, record.lastError];
+  if (Array.isArray(record.errors)) nested.push(...record.errors);
+  for (const candidate of nested) {
+    const status = providerStatus(candidate, seen);
+    if (status !== null) return status;
+  }
+  return null;
+}
+
+function isDefinitiveProviderRejection(error: unknown): boolean {
+  const status = providerStatus(error);
+  if (status === null) return false;
+  // A provider 4xx means it rejected the request before producing courseware.
+  // Request/connection timeouts remain ambiguous because work may continue
+  // upstream after the local process stops waiting.
+  return status >= 400 && status < 500 && status !== 408;
+}
+
+export interface MiraCoursewareProviderResult {
+  schemaVersion: typeof MIRA_COURSEWARE_PROVIDER_SCHEMA;
+  requestId: string;
+  phase: string;
+  content: string;
+  providerRequestIdHash: string;
+  inputTokens: number | null;
+  outputTokens: number | null;
+  billingEvidence: 'reported' | 'unknown';
+}
+
+function secureEqual(left: string, right: string): boolean {
+  const leftBytes = Buffer.from(left);
+  const rightBytes = Buffer.from(right);
+  return leftBytes.length === rightBytes.length && timingSafeEqual(leftBytes, rightBytes);
+}
+
+/**
+ * This endpoint is the only learning-courseware boundary allowed to invoke the
+ * configured model.  It is private and token-authenticated; students and the
+ * parent app never reach it directly.
+ */
+export function authorizeMiraCoursewareProviderRequest(req: NextRequest): void {
+  const expected = process.env.MIRA_INTERNAL_API_TOKEN || '';
+  const supplied = req.headers.get('x-mira-internal-token') || '';
+  if (
+    !expected ||
+    !supplied ||
+    !secureEqual(expected, supplied) ||
+    req.headers.has('forwarded') ||
+    req.headers.has('via')
+  ) {
+    throw new MiraCoursewareProviderError(
+      'unauthorized',
+      'Courseware Provider access is private',
+    );
+  }
+}
+
+function plainObject(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw new MiraCoursewareProviderError('invalid_request', 'Request must be an object');
+  }
+  return value as Record<string, unknown>;
+}
+
+function boundedPrompt(value: unknown, field: string): string {
+  if (typeof value !== 'string') {
+    throw new MiraCoursewareProviderError('invalid_request', `${field} must be text`);
+  }
+  const text = value.trim();
+  if (!text || text.length > MAX_PROMPT_CHARS) {
+    throw new MiraCoursewareProviderError('invalid_request', `${field} is invalid`);
+  }
+  return text;
+}
+
+function tokenCount(value: unknown): number | null {
+  return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0
+    ? value
+    : null;
+}
+
+export async function executeMiraCoursewareProvider(
+  raw: unknown,
+): Promise<MiraCoursewareProviderResult> {
+  const body = plainObject(raw);
+  const expectedKeys = [
+    'phase',
+    'requestId',
+    'responseJsonSchema',
+    'schemaVersion',
+    'systemPrompt',
+    'userPrompt',
+  ];
+  if (Object.keys(body).sort().join(',') !== expectedKeys.sort().join(',')) {
+    throw new MiraCoursewareProviderError('invalid_request', 'Request fields are invalid');
+  }
+  if (body.schemaVersion !== MIRA_COURSEWARE_PROVIDER_SCHEMA) {
+    throw new MiraCoursewareProviderError('invalid_request', 'Schema version is invalid');
+  }
+  const requestId = typeof body.requestId === 'string' ? body.requestId : '';
+  const phase = typeof body.phase === 'string' ? body.phase : '';
+  if (!REQUEST_ID.test(requestId) || !PHASES.has(phase)) {
+    throw new MiraCoursewareProviderError('invalid_request', 'Courseware identity is invalid');
+  }
+  const responseJsonSchema = body.responseJsonSchema;
+  if (
+    responseJsonSchema !== null &&
+    (!responseJsonSchema ||
+      typeof responseJsonSchema !== 'object' ||
+      Array.isArray(responseJsonSchema) ||
+      Buffer.byteLength(JSON.stringify(responseJsonSchema), 'utf8') > MAX_SCHEMA_BYTES)
+  ) {
+    throw new MiraCoursewareProviderError('invalid_request', 'Response schema is invalid');
+  }
+
+  const systemPrompt = boundedPrompt(body.systemPrompt, 'systemPrompt');
+  const userPrompt = boundedPrompt(body.userPrompt, 'userPrompt');
+  const resolved = await resolveModel({ stage: 'generate-classroom' });
+  if (
+    resolved.providerId !== 'kimi' ||
+    resolved.modelId !== 'kimi-k2.6' ||
+    (isProviderKeyRequired(resolved.providerId) && !resolved.apiKey)
+  ) {
+    throw new MiraCoursewareProviderError(
+      'provider_unavailable',
+      'OpenMAIC courseware model is not configured',
+    );
+  }
+
+  try {
+    const responseFormat = responseJsonSchema
+      ? {
+          type: 'json' as const,
+          schema: responseJsonSchema as never,
+          name: `mira_courseware_${phase}`,
+        }
+      : { type: 'json' as const };
+    const coursewareModel = wrapLanguageModel({
+      model: resolved.model as Parameters<typeof wrapLanguageModel>[0]['model'],
+      middleware: defaultSettingsMiddleware({ settings: { responseFormat } }),
+    });
+    const result = await callLLM(
+      {
+        model: coursewareModel,
+        messages: [
+          { role: 'system', content: systemPrompt },
+          { role: 'user', content: userPrompt },
+        ],
+        temperature: 0.6,
+        maxOutputTokens: Math.min(resolved.modelInfo?.outputWindow || 8_000, 8_000),
+        maxRetries: 0,
+        abortSignal: AbortSignal.timeout(300_000),
+      },
+      'mira-courseware-provider',
+      undefined,
+      COURSEWARE_THINKING_DISABLED,
+    );
+    const content = result.text.trim();
+    if (!content) {
+      throw new MiraCoursewareProviderError('provider_failed', 'Provider returned no content');
+    }
+    const usage = result.totalUsage ?? result.usage;
+    const inputTokens = tokenCount(usage?.inputTokens);
+    const outputTokens = tokenCount(usage?.outputTokens);
+    const responseId = String(result.response?.id || '');
+    const providerRequestIdHash = createHash('sha256')
+      .update(`${requestId}:${phase}:${responseId || content.length}`)
+      .digest('hex');
+    return {
+      schemaVersion: MIRA_COURSEWARE_PROVIDER_SCHEMA,
+      requestId,
+      phase,
+      content,
+      providerRequestIdHash,
+      inputTokens,
+      outputTokens,
+      billingEvidence: inputTokens !== null || outputTokens !== null ? 'reported' : 'unknown',
+    };
+  } catch (error) {
+    if (error instanceof MiraCoursewareProviderError) throw error;
+    if (isDefinitiveProviderRejection(error)) {
+      throw new MiraCoursewareProviderError(
+        'provider_rejected',
+        'Courseware Provider rejected the request',
+      );
+    }
+    throw new MiraCoursewareProviderError('provider_failed', 'Courseware Provider call failed');
+  }
+}
