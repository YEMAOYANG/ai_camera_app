+/** Agent pre-dispatch runs before model middleware first loads this context. */
+export async function isPaidBudgetObservationMode(): Promise<boolean> {
+  const context = paidBudgetContext.getStore();
+  if (!context) return false;
+  // Await the shared promise, including its original rejection. An unavailable
+  // authority never becomes observation mode or triggers an implicit retry.
+  await authorizationPrices(context);
+  return context.aggregateLimitsEnabled === false;
+}
+async function authorizedPrice(provider: string, model: string): Promise<[string, Price]> {
+  const context = paidBudgetContext.getStore();
+  if (!context) throw new Error('MIRA_PAID_BUDGET_CONTEXT_REQUIRED');
+  const entries = Object.entries(await authorizationPrices(context)).filter(
     ([, p]) => p.provider === provider && p.model === model,
   );
   if (entries.length !== 1) throw new Error('MIRA_PAID_BUDGET_PRICE_NOT_AUTHORIZED');
