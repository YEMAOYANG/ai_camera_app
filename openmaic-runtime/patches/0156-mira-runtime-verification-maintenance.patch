+/** Original public Mira policy symbols retained by the generic route composition. */
+export {
+  MIRA_STRUCTURED_SCENE_POLICY_ENV,
+  MIRA_PROFESSIONAL_MODEL_POLICY_SCHEMA,
+  MIRA_PROFESSIONAL_MODEL_POLICY_ID,
+  MIRA_STRUCTURED_SCENE_POLICY_ID,
+  MIRA_FLASH_CANDIDATE_MODEL_POLICY_ID,
+  MIRA_PRO_CURRENT_FLASH_MODEL_POLICY_ID,
+  MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID,
+  MIRA_STRUCTURED_SCENE_STAGES,
+  getMiraSelectedModelPolicyId,
+  getMiraVerifierModelId,
+  validateMiraStructuredSceneRoutes,
+} from './mira-model-policy';
+export type {
+  MiraProfessionalModelPolicyId,
+  MiraStructuredSceneRuntimePolicy,
+  MiraProfessionalModelRuntimePolicy,
+} from './mira-model-policy';
diff --git a/lib/server/mira-model-policy.ts b/lib/server/mira-model-policy.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-model-policy.ts
@@ -0,0 +1,289 @@
+/** Frozen Mira model policy. Concrete provider knowledge belongs at this boundary. */
+import type { StageRoute } from './model-routes';
+
+export const MIRA_STRUCTURED_SCENE_POLICY_ENV = 'MIRA_OPENMAIC_STRUCTURED_SCENE_POLICY';
+export const MIRA_PROFESSIONAL_MODEL_POLICY_SCHEMA =
+  'mira.openmaic.professional-model-policy.v1' as const;
+export const MIRA_PROFESSIONAL_MODEL_POLICY_ID = 'deepseek-v4-pro-flash-v1' as const;
+export const MIRA_STRUCTURED_SCENE_POLICY_ID = MIRA_PROFESSIONAL_MODEL_POLICY_ID;
+export const MIRA_FLASH_CANDIDATE_MODEL_POLICY_ID = 'deepseek-v4.1-flash-candidate-v1' as const;
+export const MIRA_PRO_CURRENT_FLASH_MODEL_POLICY_ID = 'deepseek-v4-pro-current-flash-v1' as const;
+export type MiraProfessionalModelPolicyId = typeof MIRA_PROFESSIONAL_MODEL_POLICY_ID | typeof MIRA_FLASH_CANDIDATE_MODEL_POLICY_ID | typeof MIRA_PRO_CURRENT_FLASH_MODEL_POLICY_ID;
+export const MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID = 'deepseek-flash' as const;
+
+const MIRA_DEEPSEEK_PROVIDER_ID = 'deepseek' as const;
+const MIRA_DEEPSEEK_PRO_MODEL_ID = 'deepseek-v4-pro' as const;
+const MIRA_DEEPSEEK_FLASH_MODEL_ID = 'deepseek-v4-flash' as const;
+const MIRA_STRUCTURED_SCENE_PROVIDER_ID = MIRA_DEEPSEEK_PROVIDER_ID;
+const MIRA_STRUCTURED_SCENE_MODEL_ID = MIRA_DEEPSEEK_PRO_MODEL_ID;
+const MIRA_STRUCTURED_SCENE_MODEL = `${MIRA_STRUCTURED_SCENE_PROVIDER_ID}:${MIRA_STRUCTURED_SCENE_MODEL_ID}`;
+const MIRA_COURSEWARE_CREATOR_STAGE = 'mira-courseware-creator';
+const MIRA_COURSEWARE_VERIFIER_STAGE = 'mira-courseware-verifier';
+const MIRA_AGENT_DRIVER_STAGE = 'maic-agent-driver';
+const MIRA_GENERATE_CLASSROOM_STAGE = 'generate-classroom';
+const MIRA_WEB_SEARCH_QUERY_REWRITE_STAGE = 'web-search-query-rewrite';
+export const MIRA_STRUCTURED_SCENE_STAGES = [
+  'scene-content',
+  'scene-content:slide',
+  'scene-content:quiz',
+  'scene-content:interactive',
+  'scene-content:pbl',
+  'scene-actions',
+] as const;
+const MIRA_STRUCTURED_SCENE_STAGE_SET = new Set<string>(MIRA_STRUCTURED_SCENE_STAGES);
+
+export interface MiraStructuredSceneRuntimePolicy {
+  enforced: true;
+  policyId: MiraProfessionalModelPolicyId;
+  providerId: typeof MIRA_STRUCTURED_SCENE_PROVIDER_ID;
+  modelId: typeof MIRA_STRUCTURED_SCENE_MODEL_ID | typeof MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID;
+  stages: readonly (typeof MIRA_STRUCTURED_SCENE_STAGES)[number][];
+  thinking: {
+    mode: 'disabled';
+    enabled: false;
+  };
+}
+
+export interface MiraProfessionalModelRuntimePolicy {
+  schemaVersion: typeof MIRA_PROFESSIONAL_MODEL_POLICY_SCHEMA;
+  policyId: MiraProfessionalModelPolicyId;
+  agentDriver: {
+    providerId: typeof MIRA_DEEPSEEK_PROVIDER_ID;
+    modelId: typeof MIRA_DEEPSEEK_PRO_MODEL_ID | typeof MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID;
+    thinking: { mode: 'enabled'; enabled: true; effort: 'high' };
+  };
+  coursewareCreator: {
+    providerId: typeof MIRA_DEEPSEEK_PROVIDER_ID;
+    modelId: typeof MIRA_DEEPSEEK_PRO_MODEL_ID | typeof MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID;
+    thinking: { mode: 'disabled'; enabled: false };
+  };
+  coursewareVerifier: {
+    providerId: typeof MIRA_DEEPSEEK_PROVIDER_ID;
+    modelId: typeof MIRA_DEEPSEEK_FLASH_MODEL_ID | typeof MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID;
+    thinking: { mode: 'disabled'; enabled: false };
+  };
+  structuredScene: {
+    policyId: MiraProfessionalModelPolicyId;
+    providerId: typeof MIRA_DEEPSEEK_PROVIDER_ID;
+    modelId: typeof MIRA_DEEPSEEK_PRO_MODEL_ID | typeof MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID;
+    thinking: { mode: 'disabled'; enabled: false };
+  };
+  fallbackAllowed: false;
+}
+
+/** A server-only opt-in. Missing selection retains all existing route behavior. */
+export function getMiraSelectedModelPolicyId(required = false): MiraProfessionalModelPolicyId | undefined {
+  const policy = process.env[MIRA_STRUCTURED_SCENE_POLICY_ENV]?.trim();
+  if (!policy) {
+    if (required) throw new Error(`${MIRA_STRUCTURED_SCENE_POLICY_ENV} is required.`);
+    return undefined;
+  }
+  if (policy !== MIRA_STRUCTURED_SCENE_POLICY_ID && policy !== MIRA_FLASH_CANDIDATE_MODEL_POLICY_ID && policy !== MIRA_PRO_CURRENT_FLASH_MODEL_POLICY_ID) {
+    throw new Error(`Unsupported ${MIRA_STRUCTURED_SCENE_POLICY_ENV}; expected a supported frozen policy.`);
+  }
+  return policy;
+}
+
+export function getMiraVerifierModelId(policyId: MiraProfessionalModelPolicyId = MIRA_PROFESSIONAL_MODEL_POLICY_ID): 'deepseek-v4-flash' | 'deepseek-flash' {
+  return policyId !== MIRA_PROFESSIONAL_MODEL_POLICY_ID ? MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID : MIRA_DEEPSEEK_FLASH_MODEL_ID;
+}
+
+function structuredModel(policyId: MiraProfessionalModelPolicyId): string {
+  return policyId === MIRA_FLASH_CANDIDATE_MODEL_POLICY_ID
+    ? `${MIRA_DEEPSEEK_PROVIDER_ID}:${MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID}`
+    : MIRA_STRUCTURED_SCENE_MODEL;
+}
+
+export function getMiraStructuredSceneRoute(stage: string): StageRoute | undefined {
+  const policy = getMiraSelectedModelPolicyId();
+  if (!policy) return undefined;
+  if (MIRA_STRUCTURED_SCENE_STAGE_SET.has(stage)) {
+    return { model: structuredModel(policy), thinking: { mode: 'disabled', enabled: false }, enforced: true };
+  }
+  if (policy === MIRA_PRO_CURRENT_FLASH_MODEL_POLICY_ID) {
+    // Only the verifier changes. Protect Pro generation from operator overrides.
+    if (stage === MIRA_COURSEWARE_VERIFIER_STAGE)
+      return { model: `${MIRA_DEEPSEEK_PROVIDER_ID}:${MIRA_DEEPSEEK_CURRENT_FLASH_MODEL_ID}`, thinking: { mode: 'disabled', enabled: false } };
+    if (stage === MIRA_AGENT_DRIVER_STAGE)
+      return { model: MIRA_STRUCTURED_SCENE_MODEL, api: 'openai-completions', thinking: { mode: 'enabled', enabled: true } };
+    if ([MIRA_COURSEWARE_CREATOR_STAGE, MIRA_GENERATE_CLASSROOM_STAGE, MIRA_WEB_SEARCH_QUERY_REWRITE_STAGE,
+      'scene-outlines-stream', 'agent-profiles'].includes(stage))
+      return { model: MIRA_STRUCTURED_SCENE_MODEL, thinking: { mode: 'disabled', enabled: false } };
+    return undefined;
+  }
+  if (policy !== MIRA_FLASH_CANDIDATE_MODEL_POLICY_ID) return undefined;
+  // The candidate runs on an isolated server instance and cannot inherit an
+  // old MODEL_ROUTES creator, reviewer, planner or Agent through fallback.
+  if (stage === MIRA_AGENT_DRIVER_STAGE) {
+    return { model: structuredModel(policy), api: 'openai-completions',
+      thinking: { mode: 'enabled', enabled: true } };
+  }
+  if ([MIRA_COURSEWARE_CREATOR_STAGE, MIRA_COURSEWARE_VERIFIER_STAGE,
+    MIRA_GENERATE_CLASSROOM_STAGE, MIRA_WEB_SEARCH_QUERY_REWRITE_STAGE,
+    'scene-outlines-stream', 'agent-profiles'].includes(stage)) {
+    return { model: structuredModel(policy), thinking: { mode: 'disabled', enabled: false } };
+  }
+  return undefined;
+}
+
+type StageRouteResolver = (stage: string) => StageRoute | undefined;
+
+/**
+ * Validate every protected stage through the same route resolver used by
+ * generation. This keeps health readiness tied to the effective server-owned
+ * policy instead of a separately hard-coded success response.
+ */
+export function validateMiraStructuredSceneRoutes(
+  resolveRoute: StageRouteResolver,
+  policyId: MiraProfessionalModelPolicyId = MIRA_STRUCTURED_SCENE_POLICY_ID,
+): MiraStructuredSceneRuntimePolicy {
+  const expectedModel = structuredModel(policyId);
+  const expectedModelId = expectedModel.split(':')[1];
+  let resolvedProviderId: string | undefined;
+  let resolvedModelId: string | undefined;
+
+  for (const stage of MIRA_STRUCTURED_SCENE_STAGES) {
+    const route = resolveRoute(stage);
+    if (!route || !route.thinking) {
+      throw new Error(`Structured scene route mismatch for ${stage}.`);
+    }
+    const routeKeys = Object.keys(route).sort();
+    const thinkingKeys = Object.keys(route.thinking).sort();
+    if (
+      route.enforced !== true ||
+      route.model !== expectedModel ||
+      route.thinking.mode !== 'disabled' ||
+      route.thinking.enabled !== false ||
+      routeKeys.join(',') !== 'enforced,model,thinking' ||
+      thinkingKeys.join(',') !== 'enabled,mode'
+    ) {
+      throw new Error(`Structured scene route mismatch for ${stage}.`);
+    }
+
+    const separator = route.model.indexOf(':');
+    const providerId = separator > 0 ? route.model.slice(0, separator) : '';
+    const modelId = separator > 0 ? route.model.slice(separator + 1) : '';
+    if (
+      providerId !== MIRA_STRUCTURED_SCENE_PROVIDER_ID ||
+      modelId !== expectedModelId
+    ) {
+      throw new Error(`Structured scene model mismatch for ${stage}.`);
+    }
+
+    resolvedProviderId ??= providerId;
+    resolvedModelId ??= modelId;
+    if (resolvedProviderId !== providerId || resolvedModelId !== modelId) {
+      throw new Error(`Structured scene routes do not share one model at ${stage}.`);
+    }
+  }
+
+  return {
+    enforced: true,
+    policyId,
+    providerId: resolvedProviderId as typeof MIRA_STRUCTURED_SCENE_PROVIDER_ID,
+    modelId: resolvedModelId as MiraStructuredSceneRuntimePolicy['modelId'],
+    stages: [...MIRA_STRUCTURED_SCENE_STAGES],
+    thinking: { mode: 'disabled', enabled: false },
+  };
+}
+
+/** Resolve and validate the credential-free structured-scene health contract. */
+export function getMiraStructuredSceneRuntimePolicy(resolveRoute: StageRouteResolver): MiraStructuredSceneRuntimePolicy {
+  const policyId = getMiraSelectedModelPolicyId(true)!;
+  return validateMiraStructuredSceneRoutes(resolveRoute, policyId);
+}
+
+function assertExactMiraRoute(
+  resolveRoute: StageRouteResolver,
+  stage: string,
+  expectedModel: string,
+  expectedThinking: { mode: 'disabled'; enabled: false } | { mode: 'enabled'; enabled: true },
+  expectedApi?: string,
+): void {
+  const route = resolveRoute(stage);
+  const expectedRouteKeys = expectedApi ? 'api,model,thinking' : 'model,thinking';
+  if (
+    !route ||
+    route.model !== expectedModel ||
+    route.thinking?.mode !== expectedThinking.mode ||
+    route.thinking.enabled !== expectedThinking.enabled ||
+    Object.keys(route).sort().join(',') !== expectedRouteKeys ||
+    Object.keys(route.thinking).sort().join(',') !== 'enabled,mode' ||
+    (expectedApi !== undefined && route.api !== expectedApi)
+  ) {
+    throw new Error(`Professional model route mismatch for ${stage}.`);
+  }
+}
+
+/**
+ * Resolve the effective professional-courseware routes and fail closed on any
+ * operator override. DeepSeek Pro owns creation and the Agent, while Flash is
+ * isolated to the two verification phases selected by the private provider.
+ */
+export function getMiraProfessionalModelRuntimePolicy(resolveRoute: StageRouteResolver): MiraProfessionalModelRuntimePolicy {
+  const structuredScene = getMiraStructuredSceneRuntimePolicy(resolveRoute);
+  const policyId = structuredScene.policyId;
+  const creatorModelId = structuredScene.modelId;
+  const verifierModelId = getMiraVerifierModelId(policyId);
+  assertExactMiraRoute(
+    resolveRoute,
+    MIRA_AGENT_DRIVER_STAGE,
+    `${MIRA_DEEPSEEK_PROVIDER_ID}:${creatorModelId}`,
+    { mode: 'enabled', enabled: true },
+    'openai-completions',
+  );
+  assertExactMiraRoute(
+    resolveRoute,
+    MIRA_COURSEWARE_CREATOR_STAGE,
+    `${MIRA_DEEPSEEK_PROVIDER_ID}:${creatorModelId}`,
+    { mode: 'disabled', enabled: false },
+  );
+  assertExactMiraRoute(
+    resolveRoute,
+    MIRA_COURSEWARE_VERIFIER_STAGE,
+    `${MIRA_DEEPSEEK_PROVIDER_ID}:${verifierModelId}`,
+    { mode: 'disabled', enabled: false },
+  );
+  assertExactMiraRoute(
+    resolveRoute,
+    MIRA_GENERATE_CLASSROOM_STAGE,
+    `${MIRA_DEEPSEEK_PROVIDER_ID}:${creatorModelId}`,
+    { mode: 'disabled', enabled: false },
+  );
+  assertExactMiraRoute(
+    resolveRoute,
+    MIRA_WEB_SEARCH_QUERY_REWRITE_STAGE,
+    `${MIRA_DEEPSEEK_PROVIDER_ID}:${creatorModelId}`,
+    { mode: 'disabled', enabled: false },
+  );
+
+  return {
