+    const require = createRequire(import.meta.url);
+    const { build } = createRequire(require.resolve('tsx'))('esbuild');
+    const bundle = await build({ stdin:{ resolveDir:process.cwd(), loader:'ts', contents:`
+      import {connectStudentInteractionFrame} from './lib/mira/student-interaction-bridge';
+      window.events=[]; window.active=true;
+      window.connect=()=>{ window.disconnect?.(); window.disconnect=connectStudentInteractionFrame({
+        frame:document.querySelector('iframe'), objectives:${JSON.stringify([objective])},
+        active:()=>window.active, onOperation:op=>window.events.push(op) }); };
+      window.connect();` }, bundle:true, write:false, format:'iife', platform:'browser', logLevel:'silent' });
+    const browser = await chromium.launch({ executablePath:process.env.MIRA_FORMAL_QA_BROWSER_PATH || '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome', headless:true });
+    try {
+      const page = await browser.newPage();
+      await page.route('**/*', route=>route.abort());
+      await page.setContent(`<iframe sandbox="allow-scripts" srcdoc="${escape(patchHtmlForIframe(original))}"></iframe>`);
+      await page.addScriptTag({content:bundle.outputFiles[0].text});
+      const frame = page.frames().find(frame=>frame !== page.mainFrame())!;
+      await frame.evaluate(()=>{const range=document.querySelector('input')!; range.value='12'; range.dispatchEvent(new Event('input',{bubbles:true})); window.parent.postMessage({objectiveIndex:0,passed:true},'*');});
+      await page.waitForTimeout(100);
+      expect(await page.evaluate(()=> (window as unknown as {events:unknown[]}).events)).toEqual([]);
+      // Reset via page script; only subsequent trusted keyboard input may complete.
+      await frame.evaluate(()=>{const range=document.querySelector('input')!; range.value='11'; document.querySelector('output')!.textContent='当前数量11';});
+      await frame.getByRole('slider').focus();
+      await frame.getByRole('slider').press('ArrowRight');
+      await page.waitForFunction(()=> (window as unknown as {events:unknown[]}).events.length===1);
+      expect(await page.evaluate(()=> (window as unknown as {events:unknown[]}).events[0])).toMatchObject({objectiveIndex:0,value:'12',feedbackText:'一个十两个一，因为十个一是一个十'});
+      // A kept-alive scene may still run scripts, but its closed/hidden host port is inert.
+      await page.evaluate(()=>{const w=window as unknown as {active:boolean;disconnect:()=>void};w.active=false;w.disconnect();});
+      await frame.evaluate(()=>{const range=document.querySelector('input')!;range.value='11';document.querySelector('output')!.textContent='当前数量11';});
+      await frame.getByRole('slider').press('ArrowRight');
+      await page.waitForTimeout(100);
+      expect(await page.evaluate(()=> (window as unknown as {events:unknown[]}).events.length)).toBe(1);
+      // Re-entry opens a fresh channel; the old document's observation cannot cross a scene swap.
+      await page.evaluate(()=>{const w=window as unknown as {active:boolean;connect:()=>void};w.active=true;w.connect();});
+      await frame.evaluate(()=>{const range=document.querySelector('input')!;range.value='11';document.querySelector('output')!.textContent='当前数量11';});
+      await frame.getByRole('slider').press('ArrowRight');
+      await page.waitForFunction(()=> (window as unknown as {events:unknown[]}).events.length===2);
+      // Hidden descendants cannot manufacture "visible" result evidence.
+      await page.evaluate(()=> (window as unknown as {connect:()=>void}).connect());
+      await frame.evaluate(()=>{
+        const range=document.querySelector('input')!, result=document.querySelector('output')!;
+        range.value='11'; result.innerHTML='<span>可见结果没有变化</span><span id="hidden-result" style="display:none">等待</span>';
+        range.oninput=()=>{document.querySelector('#hidden-result')!.textContent='一个十两个一，因为十个一是一个十';};
+      });
+      await frame.getByRole('slider').press('ArrowRight');
+      await page.waitForTimeout(100);
+      expect(await page.evaluate(()=> (window as unknown as {events:unknown[]}).events.length)).toBe(2);
+      await page.evaluate(()=> (window as unknown as {connect:()=>void}).connect());
+      await frame.evaluate(()=>{
+        const range=document.querySelector('input')!, result=document.querySelector('output')!;
+        range.value='11'; result.textContent='当前数量11'; result.style.opacity='0';
+        range.oninput=()=>{result.textContent='一个十两个一，因为十个一是一个十';};
+      });
+      await frame.getByRole('slider').press('ArrowRight');
+      await page.waitForTimeout(100);
+      expect(await page.evaluate(()=> (window as unknown as {events:unknown[]}).events.length)).toBe(2);
+
+    } finally { await browser.close(); }
+  }, 30_000);
+});
