+
+const objective = { objectiveIndex: 0, demonstration: {sceneId:'demo',quote:'先看示范'},
+  operation:{sceneId:'operate',controlSelector:'#quantity',action:'range',value:'12'},
+  feedback:{sceneId:'operate',selector:'#result',textIncludes:'一个十两个一',reasonQuote:'十个一是一个十'},
+  independentJudgment:{sceneId:'quiz',questionId:'q4'} };
+const original = `<input aria-label="数量" id="quantity" type="range" min="0" max="20" value="2"><output id="result">两个一</output>
+<script>quantity.oninput=()=>{result.textContent=Number(quantity.value)===12?'一个十两个一，因为十个一是一个十':'当前数量'+quantity.value}</script>`;
+const escape = (value: string) => value.replaceAll('&','&amp;').replaceAll('"','&quot;').replaceAll('<','&lt;');
+
+describe.skipIf(process.env.FORMAL_INSPECTION_BROWSER !== '1')('actual student operation browser bridge', () => {
