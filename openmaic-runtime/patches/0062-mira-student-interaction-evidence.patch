diff --git a/lib/mira/student-interaction-bridge.ts b/lib/mira/student-interaction-bridge.ts
new file mode 100644
--- /dev/null
+++ b/lib/mira/student-interaction-bridge.ts
@@ -0,0 +1,112 @@
+import type { Scene } from '@/lib/types/stage';
+import type { InteractionObjective } from '@/lib/server/mira-formal-interaction-design';
+import { interactionPayload, type MiraInteractionOperation } from './student-runtime-events';
+
+/** The persisted plan is public teaching data. The backend independently binds
+ * every submission to the frozen professional receipt, never to this parser. */
+export function studentInteractionObjectives(scenes: readonly Scene[]): InteractionObjective[] {
+  const first = [...scenes].sort((a, b) => a.order - b.order).find(scene => scene.type === 'interactive');
+  if (first?.content.type !== 'interactive') return [];
+  const scripts = [...(first.content.html ?? '').matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi)];
+  const plans = scripts.filter(match => /\bid\s*=\s*["']mira-interaction-plan["']/i.test(match[1]) &&
+    /\btype\s*=\s*["']application\/json["']/i.test(match[1]));
+  if (plans.length !== 1) return [];
+  try {
+    const value = JSON.parse(plans[0][2]);
+    return value.schemaVersion === 'mira.openmaic.interaction-design-plan.v1' && Array.isArray(value.objectives)
+      ? value.objectives.filter((item: InteractionObjective) => Number.isInteger(item?.objectiveIndex) &&
+        item.objectiveIndex >= 0 && item.objectiveIndex < 30 && item.operation?.sceneId && item.feedback?.sceneId)
+      : [];
+  } catch { return []; }
+}
+
+export function requiredInteractionsBeforeScene(scenes: readonly Scene[], targetSceneId: string): number[] {
+  const target = scenes.find(scene => scene.id === targetSceneId);
+  if (!target) return [];
+  return studentInteractionObjectives(scenes).filter(objective => {
+    const operation = scenes.find(scene => scene.id === objective.operation.sceneId);
+    return operation && operation.order < target.order;
+  }).map(objective => objective.objectiveIndex);
+}
+
+/** Only this private port is an observation channel. General iframe postMessage,
+ * teacher widget actions, another frame and closed/hidden scenes cannot submit. */
+export function connectStudentInteractionFrame(options: {
+  frame: HTMLIFrameElement;
+  objectives: readonly InteractionObjective[];
+  onOperation: (operation: MiraInteractionOperation) => void;
+  active: () => boolean;
+}): () => void {
+  const channel = new MessageChannel();
+  let connected = true;
+  channel.port1.onmessage = (event) => {
+    if (!connected || !options.active()) return;
+    try {
+      const operation = interactionPayload(event.data);
+      const objective = options.objectives.find(item => item.objectiveIndex === operation.objectiveIndex);
+      if (!objective || objective.operation.controlSelector !== operation.controlSelector ||
+          objective.operation.action !== operation.action ||
+          (objective.operation.action !== 'click' && objective.operation.value !== operation.value) ||
+          !operation.feedbackText.includes(objective.feedback.textIncludes) ||
+          !operation.feedbackText.includes(objective.feedback.reasonQuote)) return;
+      options.onOperation(operation);
+    } catch { /* Malformed iframe observations never enter the event stream. */ }
+  };
+  options.frame.contentWindow?.postMessage({ type: 'mira:observe-student-interactions', objectives: options.objectives }, '*', [channel.port2]);
+  return () => { connected = false; channel.port1.onmessage = null; channel.port1.close(); };
+}
+
+/** Inject before generated scripts. A captured native MessageChannel endpoint
+ * remains in this closure; page scripts only see the ordinary DOM controls.
+ * This records browser interaction, not a tamper-proof remote attestation. */
+export const STUDENT_INTERACTION_OBSERVER = `<script data-mira-student-interaction-observer>
+(function () {
+  var port = null, objectives = [], pending = new Map(), completed = new Set();
+  var query = document.querySelector.bind(document);
+  var schedule = window.setTimeout.bind(window);
+  var textGetter = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'innerText').get;
+  var send = MessagePort.prototype.postMessage;
+  function text(node) { return textGetter.call(node).trim().slice(0, 2000); }
+  function feedback(item, control) {
+    var node = query(item.feedback.selector);
+    if (!(node instanceof HTMLElement) || node === control || node.contains(control) || control.contains(node) ||
+        /^(BUTTON|INPUT|SELECT|TEXTAREA)$/.test(node.tagName)) return null;
+    var rect = node.getBoundingClientRect();
+    if (!rect.width || !rect.height || (node.checkVisibility && !node.checkVisibility({checkOpacity:true,checkVisibilityCSS:true}))) return null;
+    return node;
+  }
+  window.addEventListener('message', function (event) {
+    if (event.source !== window.parent || event.data?.type !== 'mira:observe-student-interactions' || !event.ports[0]) return;
+    event.stopImmediatePropagation();
+    if (port) port.close();
+    port = event.ports[0]; objectives = Array.isArray(event.data.objectives) ? event.data.objectives : [];
+    pending.clear(); completed.clear();
+  }, true);
+  function observed(event) {
+    if (!event.isTrusted || !port) return;
+    objectives.forEach(function (item) {
+      if (completed.has(item.objectiveIndex)) return;
+      var op = item.operation, control = query(op.controlSelector);
+      if (!control || !(event.target === control || control.contains(event.target))) return;
+      if ((op.action === 'click' ? 'click' : op.action === 'select' ? 'change' : 'input') !== event.type) return;
+      var value = op.action === 'click' ? '' : String(control.value);
+      if (op.action !== 'click' && value !== op.value) return;
+      var node = feedback(item, control);
+      if (!node) return;
+      var before = text(node), currentPort = port, ticket = {};
+      pending.set(item.objectiveIndex, ticket);
+      var started = performance.now();
+      function inspect() {
+        if (port !== currentPort || pending.get(item.objectiveIndex) !== ticket) return;
+        var result = feedback(item, control), after = result ? text(result) : '';
+        if (after && after !== before && after.includes(item.feedback.textIncludes) && after.includes(item.feedback.reasonQuote)) {
+          completed.add(item.objectiveIndex); pending.delete(item.objectiveIndex);
+          send.call(currentPort, {objectiveIndex:item.objectiveIndex, controlSelector:op.controlSelector, action:op.action, value:value, feedbackText:after});
+        } else if (performance.now() - started < 2000) schedule(inspect, 40);
+      }
+      schedule(inspect, 0);
+    });
+  }
+  ['click','input','change'].forEach(function (type) { window.addEventListener(type, observed, true); });
+})();
+</script>`;
