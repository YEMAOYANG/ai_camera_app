diff --git a/lib/mira/student-resume-scene.ts b/lib/mira/student-resume-scene.ts
new file mode 100644
--- /dev/null
+++ b/lib/mira/student-resume-scene.ts
@@ -0,0 +1,23 @@
+import type { Scene } from '@/lib/types/stage';
+import type { MiraStudentRuntimeEventClient } from './student-runtime-events';
+import { requiredInteractionsBeforeScene } from './student-interaction-bridge';
+
+/** Restore navigation only, after the authenticated status has been read.
+ * The server's index/id pair must match the fresh classroom, and the ordinary
+ * Next-page participation gate still applies. No local cursor grants a page.
+ */
+export function studentResumeSceneId(
+  classroomId: string,
+  scenes: readonly Scene[],
+  progress: Pick<MiraStudentRuntimeEventClient, 'getResumeScene' | 'hasCompletedInteractions'>,
+): string | undefined {
+  const resume = progress.getResumeScene();
+  if (!resume) return undefined;
+  const ordered = [...scenes].sort((left, right) => left.order - right.order);
+  const scene = ordered[resume.sceneIndex];
+  if (scene?.id !== resume.sceneId || scene.stageId !== classroomId)
+    throw new Error('保存的学习位置与当前课堂不一致，请重试。');
+  if (!progress.hasCompletedInteractions(requiredInteractionsBeforeScene(ordered, scene.id)))
+    return undefined;
+  return scene.id;
+}
diff --git a/tests/runtime/mira-student-resume-scene.test.ts b/tests/runtime/mira-student-resume-scene.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/runtime/mira-student-resume-scene.test.ts
@@ -0,0 +1,145 @@
+import { describe, expect, it, vi } from 'vitest';
+import type { Scene } from '@/lib/types/stage';
+import { createMiraStudentRuntimeEventClient } from '@/lib/mira/student-runtime-events';
+import { studentResumeSceneId } from '@/lib/mira/student-resume-scene';
+
+const status = (resumeScene: unknown, classroomId = 'stage-a', learningSessionId = 'learning-a') =>
+  new Response(
+    JSON.stringify({
+      ok: true,
+      schemaVersion: 'mira.openmaic.student-runtime-event-receipt.v1',
+      runtimeSessionId: 'runtime-new',
+      classroomId,
+      learningSessionId,
+      releaseId: 'release-a',
+      lastSequence: 0,
+      nextSequence: 1,
+      completed: false,
+      completionReady: false,
+      answeredQuestionIds: [],
+      resumeScene,
+    }),
+  );
+const storage = { getItem: () => null, setItem: () => undefined } as unknown as Storage;
+const plan = {
+  schemaVersion: 'mira.openmaic.interaction-design-plan.v2',
+  objectives: [
+    {
+      objectiveIndex: 0,
+      operation: { sceneId: 'scene-game', controlSelector: '#pick-him', action: 'click' },
+      feedback: { sceneId: 'scene-game', selector: '#result' },
+    },
+  ],
+};
+const scenes = [
+  { id: 'scene-first', stageId: 'stage-a', order: 1, type: 'slide', content: { type: 'slide' } },
+  {
+    id: 'scene-game',
+    stageId: 'stage-a',
+    order: 2,
+    type: 'interactive',
+    content: {
+      type: 'interactive',
+      html: `<script id="mira-interaction-plan" type="application/json">${JSON.stringify(plan)}</script>`,
+    },
+  },
+  { id: 'scene-quiz', stageId: 'stage-a', order: 3, type: 'quiz', content: { type: 'quiz' } },
+] as Scene[];
+
+describe('authoritative student resume position', () => {
+  it('reads an earlier accepted scene with GET only, and does not turn later visits into resume', async () => {
+    let resumeScene: unknown = { sceneIndex: 1, sceneId: 'scene-game' };
+    const fetcher = vi.fn(async () => status(resumeScene));
+    const client = createMiraStudentRuntimeEventClient({
+      classroomId: 'stage-a',
+      storage,
+      fetcher,
+    });
+    await client.readProgress();
+    expect(studentResumeSceneId('stage-a', scenes, client)).toBe('scene-game');
+    resumeScene = { sceneIndex: 2, sceneId: 'scene-quiz' };
+    await client.readProgress();
+    expect(client.getResumeScene()).toEqual({ sceneIndex: 1, sceneId: 'scene-game' });
+    expect(
+      fetcher.mock.calls.every(
+        (call) => (call as unknown as [unknown, RequestInit])[1].method === 'GET',
+      ),
+    ).toBe(true);
+  });
+
+  it('keeps a fresh or older-server launch at the first page without fabricating progress', async () => {
+    let resumeScene: unknown;
+    const client = createMiraStudentRuntimeEventClient({
+      classroomId: 'stage-a',
+      storage,
+      fetcher: vi.fn(async () => status(resumeScene)),
+    });
+    await client.readProgress();
+    expect(studentResumeSceneId('stage-a', scenes, client)).toBeUndefined();
+    resumeScene = { sceneIndex: 1, sceneId: 'scene-game' };
+    await client.readProgress();
+    expect(client.getResumeScene()).toBeNull();
+  });
+
+  it('rejects another classroom or malformed index before returning a resume position', async () => {
+    for (const [resumeScene, classroomId] of [
+      [{ sceneIndex: 1, sceneId: 'scene-game' }, 'stage-other'],
+      [{ sceneIndex: -1, sceneId: 'scene-game' }, 'stage-a'],
+    ] as const) {
+      const client = createMiraStudentRuntimeEventClient({
+        classroomId: 'stage-a',
+        storage,
+        fetcher: vi.fn(async () => status(resumeScene, classroomId)),
+      });
+      await expect(client.readProgress()).rejects.toThrow();
+      expect(client.getResumeScene()).toBeNull();
+    }
+  });
+
+  it('rejects a frozen index/id or stage mismatch and preserves the usual interaction gate', () => {
+    const progress = {
+      getResumeScene: () => ({ sceneIndex: 2, sceneId: 'scene-quiz' }),
+      hasCompletedInteractions: (required: readonly number[]) => required.length === 0,
+    };
+    expect(studentResumeSceneId('stage-a', scenes, progress)).toBeUndefined();
+    expect(
+      studentResumeSceneId('stage-a', scenes, {
+        ...progress,
+        hasCompletedInteractions: () => true,
+      }),
+    ).toBe('scene-quiz');
+    expect(() => studentResumeSceneId('stage-other', scenes, progress)).toThrow('不一致');
+    expect(() =>
+      studentResumeSceneId('stage-a', scenes, {
+        ...progress,
+        getResumeScene: () => ({ sceneIndex: 1, sceneId: 'scene-quiz' }),
+      }),
+    ).toThrow('不一致');
+  });
+
+  it('does not offer a resume page after a failed progress read', async () => {
+    const client = createMiraStudentRuntimeEventClient({
+      classroomId: 'stage-a',
+      storage,
+      fetcher: vi.fn(async () => {
+        throw new Error('temporarily unavailable');
+      }),
+    });
+    await expect(client.readProgress()).rejects.toThrow('temporarily unavailable');
+    expect(client.getResumeScene()).toBeNull();
+  });
+
+  it('rejects a same-classroom switch to another learning session before mixing progress', async () => {
+    let learningSessionId = 'learning-a';
+    const client = createMiraStudentRuntimeEventClient({
+      classroomId: 'stage-a',
+      storage,
+      fetcher: vi.fn(async () =>
+        status({ sceneIndex: 1, sceneId: 'scene-game' }, 'stage-a', learningSessionId),
+      ),
+    });
+    await client.readProgress();
+    learningSessionId = 'learning-b';
+    await expect(client.readProgress()).rejects.toThrow('学习会话已改变');
+  });
+});
