+/** Mirror the backend's reviewed-HTML control scope. The formal plan itself is
+ * unchanged; these alternatives record participation, never assessment. */
+function participationControls(
+  html: string,
+  objective: InteractionObjective,
+): ParticipationControl[] {
+  const original = objective.operation;
+  const controls: ParticipationControl[] = [
+    { controlSelector: original.controlSelector, action: original.action },
+  ];
+  if (typeof DOMParser === 'undefined') return controls;
+  const document = new DOMParser().parseFromString(html, 'text/html');
+  const ids = new Map<string, Element>();
+  const duplicates = new Set<string>();
+  for (const node of document.querySelectorAll('[id]')) {
+    if (ids.has(node.id)) duplicates.add(node.id);
+    ids.set(node.id, node);
+  }
+  for (const id of duplicates) ids.delete(id);
+  const selected = ids.get(original.controlSelector.slice(1));
+  const reset = objective.exploration?.reset.selector;
+  const parent = selected?.parentElement;
+  if (selected?.tagName === 'BUTTON' && parent && !['HTML', 'BODY'].includes(parent.tagName)) {
+    for (const [id, node] of ids) {
+      if (
+        /^[A-Za-z][A-Za-z0-9_-]{0,98}$/.test(id) &&
+        node.tagName === 'BUTTON' &&
+        node.parentElement === parent &&
+        !node.hasAttribute('disabled') &&
+        !['reset', 'submit'].includes((node.getAttribute('type') ?? 'button').toLowerCase()) &&
+        '#' + id !== reset
+      ) {
+        controls.push({ controlSelector: '#' + id, action: 'click' });
+      }
+    }
+  }
+  for (const state of objective.exploration?.states ?? []) {
+    for (const operation of state.operations) {
+      if (
+        operation.selector.startsWith('#') &&
+        ids.has(operation.selector.slice(1)) &&
+        operation.selector !== reset
+      ) {
+        controls.push({ controlSelector: operation.selector, action: operation.action });
+      }
+    }
+  }
+  return controls.filter(
+    (item, index) =>
+      controls.findIndex(
+        (other) => other.controlSelector === item.controlSelector && other.action === item.action,
+      ) === index,
+  );
+}
