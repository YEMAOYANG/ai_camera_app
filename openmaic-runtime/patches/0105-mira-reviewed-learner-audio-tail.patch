diff --git a/lib/server/mira-formal-learner-audio-tail.ts b/lib/server/mira-formal-learner-audio-tail.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-formal-learner-audio-tail.ts
@@ -0,0 +1,190 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { qualitySha, qualitySnapshot } from './mira-formal-quality-contract';
+import { assertCompletionTailRenewal, type ValidatedCompletionTailBudget } from './mira-formal-completion-tail-budget';
+import { buildLifecycleSegments } from './mira-formal-audio-lifecycle';
+import { readMiraFormalTtsJob, readMiraFormalAsrJob, readMiraFormalTtsAsset } from './mira-formal-audio';
+import { repairMiraFormalAudioSegment } from './mira-formal-audio-repair';
+import type { LearnerDiscussionRepairReceipt, LearnerDiscussionResponseRecovery } from './mira-formal-learner-discussion-repair';
+import type { FormalQualityReviewGrant } from './mira-formal-teaching-quality';
+import type { LearnerRepairCompletionIdentity } from '../../scripts/formal-learner-discussion-completion-claim';
+
+const SHA = /^[a-f0-9]{64}$/;
+const fail = (reason: string): never => { throw new Error(`SAVED_STAGE_LEARNER_AUDIO_TAIL_${reason}`); };
+const json = async (file: string) => JSON.parse(await fs.readFile(file, 'utf8'));
+type AudioInput = Parameters<typeof buildLifecycleSegments>[0];
+export interface LearnerAudioTailReference {
+  priorReviewClaimSha256: string;
+  learnerRepairIdentitySha256: string;
+  learnerRepairCompletionSha256: string;
+  derivedSnapshotSha256: string;
+  qualityReceiptSha256: string;
+  failedTtsRequestId: string;
+  failedTtsRecordSha256: string;
+  completedSegmentCount: number;
+  expectedSegmentCount: number;
+}
+const REFERENCE_KEYS = ['priorReviewClaimSha256', 'learnerRepairIdentitySha256', 'learnerRepairCompletionSha256',
+  'derivedSnapshotSha256', 'qualityReceiptSha256', 'failedTtsRequestId', 'failedTtsRecordSha256',
+  'completedSegmentCount', 'expectedSegmentCount'];
+export function assertLearnerAudioTailReference(value: LearnerAudioTailReference) {
+  if (!value || Object.keys(value).sort().join(',') !== REFERENCE_KEYS.sort().join(',')
+      || REFERENCE_KEYS.filter(key => key.endsWith('Sha256')).some(key => !SHA.test(String(value[key as keyof LearnerAudioTailReference])))
+      || !/^formal_tts_[a-f0-9]{48}$/.test(value.failedTtsRequestId)
+      || !Number.isSafeInteger(value.completedSegmentCount) || value.completedSegmentCount < 1
+      || !Number.isSafeInteger(value.expectedSegmentCount) || value.expectedSegmentCount > 240
+      || value.completedSegmentCount >= value.expectedSegmentCount) fail('REFERENCE_INVALID');
+}
+declare const verified: unique symbol;
+export interface ValidatedLearnerAudioTail {
+  readonly priorCompletionClaimSha256: string;
+  readonly referenceSha256: string;
+  readonly [verified]: true;
+}
+interface Evidence {
+  reference: LearnerAudioTailReference; folder: string; identity: LearnerRepairCompletionIdentity;
+  originalGrantSha256: string; currentGrantSha256: string; input: AudioInput;
+  learnerReceipt: LearnerDiscussionRepairReceipt; recordHashes: string[];
+  claimed?: boolean;
+}
+const validated = new WeakMap<ValidatedLearnerAudioTail, Evidence>();
+
+/** Check all saved segments before any physical replacement can be dispatched. */
+export function assertLearnerAudioTailProgress(reference: LearnerAudioTailReference,
+  plan: ReturnType<typeof buildLifecycleSegments>, records: { tts: any; asr: any }[]) {
+  assertLearnerAudioTailReference(reference);
+  if (plan.segments.length !== reference.expectedSegmentCount || records.length !== plan.segments.length
+      || plan.segments[reference.completedSegmentCount].ttsRequestId !== reference.failedTtsRequestId)
+    fail('SEGMENT_PLAN_CHANGED');
+  for (const [index, segment] of plan.segments.entries()) {
+    const {tts, asr} = records[index];
+    if (index > reference.completedSegmentCount) {
+      if (tts || asr) fail('UNSENT_SUFFIX_CHANGED');
+      continue;
+    }
+    if (!tts || tts.requestId !== segment.ttsRequestId || tts.sceneOrder !== index
+        || tts.classroomContentSha256 !== plan.classroomContentSha256 || tts.textSha256 !== segment.textSha256
+        || tts.sceneId !== segment.sceneId || tts.actionId !== segment.actionId)
+      fail('SAVED_SEGMENT_CHANGED');
+    if (index === reference.completedSegmentCount) {
+      if (qualitySha(tts) !== reference.failedTtsRecordSha256 || tts.state !== 'ambiguous'
+          || !['provider_outcome_unknown', 'stale_provider_outcome_unknown', 'response_stream_outcome_unknown'].includes(tts.safeErrorCode)
+          || tts.audioSha256 || asr || tts.operatorRepair) fail('UNKNOWN_TTS_NOT_PROVEN');
+    } else if (tts.state !== 'succeeded' || !tts.audioSha256 || !asr || asr.state !== 'succeeded'
+        || asr.requestId !== segment.asrRequestId || asr.ttsRequestId !== tts.requestId
+        || asr.audioSha256 !== tts.audioSha256 || asr.classroomContentSha256 !== plan.classroomContentSha256
+        || !Number.isSafeInteger(asr.similarityBps) || asr.similarityBps < 8500 || asr.similarityBps > 10000)
+      fail('COMPLETED_PREFIX_CHANGED');
+  }
+}
+async function readProgress(input: AudioInput, reference: LearnerAudioTailReference) {
+  const plan = buildLifecycleSegments(input);
+  const records = [];
+  for (const segment of plan.segments) records.push({tts: await readMiraFormalTtsJob(segment.ttsRequestId),
+    asr: await readMiraFormalAsrJob(segment.asrRequestId)});
+  assertLearnerAudioTailProgress(reference, plan, records);
+  for (const {tts} of records.slice(0, reference.completedSegmentCount)) {
+    const asset = await readMiraFormalTtsAsset(tts!.requestId);
+    if (qualitySha(asset.record) !== qualitySha(tts)) fail('PREFIX_ASSET_CHANGED');
+  }
+  return {plan, records, hashes: records.map(record => qualitySha(record))};
+}
+
+/** Reads the consumed review claim and the exact cached derivation. Never reviews. */
+export async function prepareLearnerAudioTail(args: {
+  folder: string; identity: LearnerRepairCompletionIdentity; budget: ValidatedCompletionTailBudget;
+  reference: LearnerAudioTailReference; responseRecovery: LearnerDiscussionResponseRecovery;
+  reviewGrant: FormalQualityReviewGrant; audioInput: AudioInput;
+}): Promise<ValidatedLearnerAudioTail> {
+  const {folder, identity, reference, reviewGrant, responseRecovery} = args;
+  assertLearnerAudioTailReference(reference);
+  if (!reviewGrant || !SHA.test(reviewGrant.reviewIdentitySha256)
+      || reviewGrant.snapshotSha256 !== reference.derivedSnapshotSha256) fail('REVIEW_GRANT_CHANGED');
+  const prior = await json(path.join(folder, `complete-${identity.repairSnapshotSha256}-learner-discussion-review-${qualitySha(reviewGrant)}.claim`));
+  if (qualitySha(prior) !== reference.priorReviewClaimSha256
+      || Object.entries(identity).some(([key, value]) => prior[key] !== value)
+      || qualitySha(prior.responseRecovery) !== qualitySha(responseRecovery)
+      || qualitySha(prior.reviewGrant) !== qualitySha(reviewGrant)
+      || !SHA.test(prior.completionTailGrantSha256)) fail('CONSUMED_REVIEW_CLAIM_CHANGED');
+  const originalGrant = await json(path.join(folder, `completion-paid-budget-${prior.completionTailGrantSha256}.json`));
+  if (qualitySha(originalGrant) !== prior.completionTailGrantSha256) fail('ORIGINAL_GRANT_CHANGED');
+  const binding = assertCompletionTailRenewal(args.budget, originalGrant);
+  const originalClaim = await json(path.join(folder, `complete-${identity.repairSnapshotSha256}.claim`));
+  if (qualitySha(originalClaim) !== prior.priorCompletionClaimSha256
+      || originalClaim.completionTailGrantSha256 !== prior.completionTailGrantSha256
+      || Object.entries(identity).some(([key, value]) => originalClaim[key] !== value)) fail('ORIGINAL_CLAIM_CHANGED');
+  for (const suffix of ['learner-discussion-repair', 'learner-discussion-response-recovery']) {
+    const claim = await json(path.join(folder, `complete-${identity.repairSnapshotSha256}-${suffix}.claim`));
+    if (Object.entries(identity).some(([key, value]) => claim[key] !== value)
+        || claim.completionTailGrantSha256 !== prior.completionTailGrantSha256
+        || claim.priorCompletionClaimSha256 !== prior.priorCompletionClaimSha256
+        || (suffix.endsWith('response-recovery') && qualitySha(claim.responseRecovery) !== qualitySha(responseRecovery)))
+      fail('PRIOR_RECOVERY_CLAIM_CHANGED');
+  }
+  const completion = await json(path.join(process.cwd(), 'data/formal-learner-discussion-repairs', reference.learnerRepairIdentitySha256, 'completion.json'));
+  const {receiptSha256, ...unsigned} = completion.receipt;
+  if (qualitySha(completion) !== reference.learnerRepairCompletionSha256 || receiptSha256 !== qualitySha(unsigned)
+      || unsigned.sessionId !== identity.sessionId || unsigned.stageId !== identity.stageId
+      || unsigned.sourceSnapshotSha256 !== identity.sourceSnapshotSha256
+      || unsigned.inputSnapshotSha256 !== identity.repairSnapshotSha256
+      || unsigned.outputSnapshotSha256 !== reference.derivedSnapshotSha256
+      || unsigned.authorizationId !== binding.authorizationId || unsigned.repairReference !== prior.priorCompletionClaimSha256)
+    fail('DERIVED_COMPLETION_CHANGED');
+  const input = {...args.audioInput, scenes: completion.scenes};
+  if (qualitySha(qualitySnapshot(input.stage, input.scenes)) !== reference.derivedSnapshotSha256) fail('DERIVED_SNAPSHOT_CHANGED');
+  const quality = await json(path.join(process.cwd(), 'data/formal-quality-reviews', reviewGrant.reviewIdentitySha256,
+    `${reference.derivedSnapshotSha256}.json`));
+  const {receiptSha256: qualityReceiptSha256, ...qualityUnsigned} = quality.receipt;
+  if (quality.status !== 'passed' || quality.snapshotSha256 !== reference.derivedSnapshotSha256
+      || qualityReceiptSha256 !== reference.qualityReceiptSha256 || qualitySha(qualityUnsigned) !== qualityReceiptSha256
+      || qualityUnsigned.sessionId !== identity.sessionId || qualityUnsigned.stageId !== identity.stageId
+      || qualityUnsigned.snapshotSha256 !== reference.derivedSnapshotSha256) fail('CACHED_QUALITY_PASS_CHANGED');
+  const progress = await readProgress(input, reference);
+  const token = Object.freeze({priorCompletionClaimSha256: prior.priorCompletionClaimSha256,
+    referenceSha256: qualitySha(reference)}) as ValidatedLearnerAudioTail;
+  validated.set(token, {reference: structuredClone(reference), folder, identity: structuredClone(identity),
+    originalGrantSha256: prior.completionTailGrantSha256, currentGrantSha256: args.budget.receiptSha256,
+    input: structuredClone(input), learnerReceipt: completion.receipt, recordHashes: progress.hashes});
+  return token;
+}
+
+export async function claimLearnerAudioTail(token: ValidatedLearnerAudioTail) {
+  const evidence = validated.get(token); if (!evidence) return fail('VERIFIED_CONTEXT_REQUIRED');
+  const file = await fs.open(path.join(evidence.folder,
+    `complete-${evidence.reference.derivedSnapshotSha256}-learner-discussion-audio-tail.claim`), 'wx', 0o600);
+  try {
+    await file.writeFile(JSON.stringify({...evidence.identity, ...evidence.reference,
+      priorCompletionClaimSha256: token.priorCompletionClaimSha256,
+      originalCompletionTailGrantSha256: evidence.originalGrantSha256,
+      completionTailGrantSha256: evidence.currentGrantSha256, recordHashes: evidence.recordHashes,
+      pid: process.pid, createdAt: new Date().toISOString()}));
+    await file.sync();
+    evidence.claimed = true;
+  } finally { await file.close(); }
+}
+
+/** Called inside the existing completion paid namespace after cached quality and
+ * cached learner derivation have passed their full original validations. */
+export async function repairLearnerAudioTail(token: ValidatedLearnerAudioTail, input: AudioInput,
+  learnerReceipt: LearnerDiscussionRepairReceipt | undefined, qualityReceiptSha256: string | undefined) {
+  const evidence = validated.get(token); if (!evidence?.claimed) return fail('CLAIM_REQUIRED');
+  if (qualitySha(input) !== qualitySha(evidence.input) || qualitySha(learnerReceipt) !== qualitySha(evidence.learnerReceipt)
+      || qualityReceiptSha256 !== evidence.reference.qualityReceiptSha256) fail('EXECUTION_CHANGED');
+  const progress = await readProgress(input, evidence.reference);
+  if (qualitySha(progress.hashes) !== qualitySha(evidence.recordHashes)) fail('SAVED_PROGRESS_CHANGED');
+  const index = evidence.reference.completedSegmentCount;
+  const segment = progress.plan.segments[index];
+  const original = progress.records[index].tts!;
+  const repaired = await repairMiraFormalAudioSegment({asrRequestId: segment.asrRequestId,
+    ttsRequestId: segment.ttsRequestId, expectedOriginalTtsRequestSha256: original.requestSha256,
+    classroomId: input.stage.id, text: segment.text, expectedOriginalAudioSha256: null});
+  if (repaired.originalTtsSha256 !== evidence.reference.failedTtsRecordSha256
+      || repaired.physicalTtsRequestId !== `${segment.ttsRequestId}.repair1`
+      || repaired.physicalAsrRequestId !== `${segment.asrRequestId}.repair1`) fail('REPAIR_RECEIPT_CHANGED');
+  return {schemaVersion: 'mira.openmaic.learner-discussion-audio-tail.v1',
+    ...evidence.reference, referenceSha256: token.referenceSha256,
+    originalCompletionTailGrantSha256: evidence.originalGrantSha256,
+    completionTailGrantSha256: evidence.currentGrantSha256, audioRepair: repaired,
+    reusedSegmentCount: index, remainingSegmentCount: input.scenes.flatMap(scene => scene.actions ?? []).filter(action => action.type === 'speech').length - index,
+    newReviews: 0, newAgentSessions: 0, newSearches: 0};
+}
