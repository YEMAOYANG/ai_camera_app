+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import type { PersistedClassroomData } from '@/lib/server/classroom-storage';
+import { gradePreview, previewQuiz, publicQuestions, verifyFrozenPreview } from '@/lib/server/mira-textbook-preview-quiz';
+import { qualitySha } from '@/lib/server/mira-formal-quality-contract';
+
+function fixture(fixed = true) {
+  const source = { id: 'tbrev_source', createdAt: 'synthetic',
+    stage: { id: 'tbrev_source', name: 'Original source', ...(fixed ? { fixedTextbook: true } : {}) },
+    scenes: [1, 2].map(index => ({ id: `quiz-${index}`, stageId: 'tbrev_source', order: index, type: 'quiz', actions: [],
+      content: { questions: [{ id: `q${index}`, type: 'single', question: '听一听。', points: 10,
+        answer: ['B'], analysis: '请看人物动作。', options: [{ value: 'A', label: '第一张图' }, { value: 'B', label: '第二张图' }],
+        optionFeedback: { A: { text: '他们正在离开。', audioUrl: '/api/classroom-media/tbrev_source/audio/wrong.wav' },
+                          B: { text: '他们正在见面。', audioUrl: '/api/classroom-media/tbrev_source/audio/right.wav' } } }] } }))
+  } as unknown as PersistedClassroomData;
+  const id = `tbprev_${qualitySha(source).slice(0, 24)}`;
+  const room = structuredClone(source);
+  room.id = room.stage.id = id;
+  room.createdAt = 'new snapshot time';
+  room.scenes.forEach(scene => { scene.stageId = id; });
+  return { source, room, preview: verifyFrozenPreview(room, source) };
+}
+
+const folders: string[] = [];
+afterEach(async () => { await Promise.all(folders.splice(0).map(folder => fs.rm(folder, { recursive: true, force: true }))); });
+
+describe('exact frozen private quiz', () => {
+  it('accepts both authored and published-derived sources without mutating their stage flags', () => {
+    for (const fixed of [true, false]) {
+      const { source, room, preview } = fixture(fixed);
+      expect(preview.sourceSha256).toBe(qualitySha(source));
+      expect(room.stage).not.toHaveProperty('miraTextbookPreviewQuiz');
+      expect((source.stage as { fixedTextbook?: boolean }).fixedTextbook).toBe(fixed ? true : undefined);
+    }
+  });
+  it('rejects changed body, source, published identities and client-supplied answers', () => {
+    const { source, room, preview } = fixture();
+    for (const changed of [
+      { ...room, id: 'tbpub_not-a-preview' },
+      { ...room, stage: { ...room.stage, name: 'changed' } },
+      { ...room, scenes: [] },
+    ]) expect(() => verifyFrozenPreview(changed, source)).toThrow();
+    expect(() => verifyFrozenPreview(room, { ...source, createdAt: 'different' })).toThrow();
+    expect(() => gradePreview(preview, 'quiz-1', { q1: 'C' })).toThrow();
+    expect(() => gradePreview(preview, 'quiz-1', { q2: 'B' })).toThrow();
+    expect(() => gradePreview(preview, 'quiz-1', { q1: 'B', correct: 'true' })).toThrow();
+  });
+  it('returns only original selected feedback and hides answers before submission', () => {
+    const { preview } = fixture();
+    const [wrong] = gradePreview(preview, 'quiz-1', { q1: 'A' });
+    expect(wrong.correct).toBe(false);
+    expect(wrong.feedback?.text).toBe('他们正在离开。');
+    expect(gradePreview(preview, 'quiz-1', { q1: 'B' })[0].correct).toBe(true);
+    const questions = publicQuestions(preview.questions);
+    expect(questions[0]).not.toHaveProperty('answer');
+    expect(questions[0]).not.toHaveProperty('analysis');
+    expect(questions[0]).not.toHaveProperty('optionFeedback');
+  });
+  it('keeps browser attempts and source identities isolated, with an explicit current-page retry', async () => {
+    const folder = await fs.mkdtemp(path.join(process.env.MIRA_TASK_TMPDIR ?? os.tmpdir(), 'preview-quiz-'));
+    folders.push(folder);
+    const { preview, source } = fixture();
+    const original = qualitySha(source), a = 'a'.repeat(64), b = 'b'.repeat(64);
+    await previewQuiz(preview, 'quiz-1', a, { answers: { q1: 'A' } }, folder);
+    const otherAttempt = await previewQuiz(preview, 'quiz-1', b, undefined, folder);
+    expect('partial' in otherAttempt && otherAttempt.partial.results).toEqual([]);
+    await expect(previewQuiz(preview, 'quiz-1', a, { answers: { q1: 'B' } }, folder)).rejects.toThrow();
+    await previewQuiz(preview, 'quiz-2', a, { answers: { q2: 'B' } }, folder);
+    await previewQuiz(preview, 'quiz-1', a, { reset: true }, folder);
+    const result = await previewQuiz(preview, 'quiz-1', a, { answers: { q1: 'B' } }, folder);
+    expect('result' in result && result.result.score).toBe(20);
+    expect('result' in result && result.result.results.map(r => r.questionId)).toEqual(['q1', 'q2']);
+    expect(result.studentProgressWritten).toBe(false);
+    expect(result.publicationAllowed).toBe(false);
+    expect(qualitySha(source)).toBe(original);
+  });
+});
