diff --git a/lib/server/mira-textbook-preview-quiz.ts b/lib/server/mira-textbook-preview-quiz.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-textbook-preview-quiz.ts
@@ -0,0 +1,132 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import type { QuizQuestion } from '@/lib/types/stage';
+import type { QuizOptionFeedback } from '@openmaic/dsl';
+import { readClassroom, type PersistedClassroomData } from './classroom-storage';
+import { qualitySha } from './mira-formal-quality-contract';
+
+export const PREVIEW_ID = /^tbprev_[a-f0-9]{24}$/;
+export const PREVIEW_ATTEMPT = /^[a-f0-9]{64}$/;
+type Graded = { questionId: string; response: string; correct: boolean; explanation: string;
+  correctAnswer: string; feedback?: QuizOptionFeedback };
+type Attempt = { sourceSha256: string; results: Graded[] };
+type Preview = { id: string; sourceSha256: string; room: PersistedClassroomData; questions: QuizQuestion[] };
+
+function reject(message: string): never { throw new Error(message); }
+function rewriteIdentity(value: unknown, source: string, target: string): unknown {
+  if (Array.isArray(value)) return value.map(item => rewriteIdentity(item, source, target));
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(
+    ([key, item]) => [key, rewriteIdentity(item, source, target)]));
+  return value === source ? target : value;
+}
+
+/** A freeze alias is only an identity rewrite of one exact saved source.
+ * The source hash, not a caller-supplied question or passing flag, is authority. */
+export function verifyFrozenPreview(room: PersistedClassroomData, source: PersistedClassroomData): Preview {
+  const sourceSha256 = qualitySha(source);
+  if (!PREVIEW_ID.test(room.id) || room.stage.id !== room.id || source.id === room.id
+      || room.id !== `tbprev_${sourceSha256.slice(0, 24)}`
+      || qualitySha(rewriteIdentity(source.stage, source.id, room.id)) !== qualitySha(room.stage)
+      || qualitySha(rewriteIdentity(source.scenes, source.id, room.id)) !== qualitySha(room.scenes))
+    reject('预览与原冻结课件不同，请重新冻结当前版本');
+  const questions = room.scenes.flatMap(scene => scene.type === 'quiz'
+    ? ((scene.content as unknown as { questions?: QuizQuestion[] }).questions ?? []) : []);
+  if (!questions.length || new Set(questions.map(q => q.id)).size !== questions.length
+      || questions.some(q => q.type !== 'single' || !Array.isArray(q.options) || q.options.length < 2
+        || new Set(q.options.map(o => o.value)).size !== q.options.length
+        || !Array.isArray(q.answer) || q.answer.length !== 1
+        || !q.options.some(o => o.value === q.answer![0])))
+    reject('此预览只支持具有原答案和明确图片选项的单选锁题');
+  return { id: room.id, sourceSha256, room, questions };
+}
+
+export async function readFrozenPreview(id: string): Promise<Preview> {
+  if (!PREVIEW_ID.test(id)) reject('只有已冻结的本机教材预览可使用此入口');
+  const room = await readClassroom(id);
+  if (!room) reject('没有找到冻结预览');
+  const sources = new Set(room.scenes.flatMap(scene => (scene.actions ?? []).flatMap(action => {
+    if (action.type !== 'speech' || typeof action.audioUrl !== 'string') return [];
+    const match = new URL(action.audioUrl, 'http://localhost').pathname.match(/^\/api\/classroom-media\/([A-Za-z0-9_-]+)\/audio\//);
+    return match ? [match[1]] : [];
+  })));
+  if (sources.size !== 1) reject('预览录音不能唯一追溯原课件');
+  const source = await readClassroom([...sources][0]);
+  if (!source) reject('预览的原课件不存在');
+  return verifyFrozenPreview(room, source);
+}
+
+export function sceneQuestions(preview: Preview, sceneId: string): QuizQuestion[] {
+  const scene = preview.room.scenes.find(s => s.id === sceneId && s.type === 'quiz');
+  const questions = (scene?.content as unknown as { questions?: QuizQuestion[] })?.questions;
+  if (!questions?.length) reject('当前页面不是此冻结预览的测验');
+  return questions;
+}
+
+export function publicQuestions(questions: QuizQuestion[]) {
+  return questions.map(({ answer: _answer, analysis: _analysis, optionFeedback: _feedback, ...q }) => q);
+}
+
+export function gradePreview(preview: Preview, sceneId: string, answers: Record<string, string>): Graded[] {
+  const questions = sceneQuestions(preview, sceneId);
+  if (!answers || typeof answers !== 'object' || Array.isArray(answers)
+      || Object.keys(answers).length !== questions.length || Object.keys(answers).some(id => !questions.some(q => q.id === id)))
+    reject('只可提交当前预览页面的原题');
+  return questions.map(q => {
+    const response = answers[q.id];
+    if (typeof response !== 'string' || !q.options?.some(o => o.value === response)) reject('预览选项无效');
+    const expected = q.answer![0];
+    return { questionId: q.id, response, correct: expected === response,
+      explanation: q.analysis ?? '', correctAnswer: expected,
+      ...(q.optionFeedback?.[response] ? { feedback: q.optionFeedback[response] } : {}) };
+  });
+}
+
+const root = () => path.join(process.cwd(), 'data', 'textbook-preview-quiz');
+function attemptPath(preview: Preview, attempt: string, directory = root()) {
+  if (!PREVIEW_ATTEMPT.test(attempt)) reject('预览尝试编号无效');
+  return path.join(directory, preview.sourceSha256, `${attempt}.json`);
+}
+async function readAttempt(preview: Preview, attempt: string, directory: string): Promise<Attempt> {
+  try {
+    const value = JSON.parse(await fs.readFile(attemptPath(preview, attempt, directory), 'utf8')) as Attempt;
+    if (value.sourceSha256 !== preview.sourceSha256 || !Array.isArray(value.results)
+        || new Set(value.results.map(r => r.questionId)).size !== value.results.length
+        || value.results.some(r => !preview.questions.some(q => q.id === r.questionId))) reject('预览尝试来源不一致');
+    return value;
+  } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
+  return { sourceSha256: preview.sourceSha256, results: [] };
+}
+
+export async function previewQuiz(preview: Preview, sceneId: string, attempt: string,
+  operation?: { answers?: Record<string, string>; reset?: boolean }, directory = root()) {
+  const questions = sceneQuestions(preview, sceneId);
+  let saved: Attempt;
+  if (operation) {
+    const file = attemptPath(preview, attempt, directory), lock = `${file}.lock`;
+    await fs.mkdir(path.dirname(file), { recursive: true });
+    try { await fs.mkdir(lock); } catch { reject('预览答案正在保存，请稍后重试'); }
+    try {
+      saved = await readAttempt(preview, attempt, directory);
+      const pageIds = new Set(questions.map(q => q.id));
+      if (operation.reset === true) saved.results = saved.results.filter(r => !pageIds.has(r.questionId));
+      else {
+        const results = gradePreview(preview, sceneId, operation.answers!);
+        const previous = saved.results.filter(r => pageIds.has(r.questionId));
+        if (previous.length && qualitySha(previous) !== qualitySha(results)) reject('先点重新试一次，再修改预览答案');
+        saved.results = [...saved.results.filter(r => !pageIds.has(r.questionId)), ...results];
+      }
+      const temporary = `${file}.tmp`;
+      await fs.writeFile(temporary, JSON.stringify(saved), { mode: 0o600 });
+      await fs.rename(temporary, file);
+    } finally { await fs.rmdir(lock); }
+  } else saved = await readAttempt(preview, attempt, directory);
+  const results = preview.questions.flatMap(q => saved.results.filter(r => r.questionId === q.id));
+  const complete = results.length === preview.questions.length;
+  const correctCount = results.filter(r => r.correct).length;
+  const points = (id: string) => preview.questions.find(q => q.id === id)?.points ?? 1;
+  return { ok: true, privatePreview: true, studentProgressWritten: false, publicationAllowed: false,
+    sourceSha256: preview.sourceSha256, questions: publicQuestions(questions),
+    ...(complete ? { result: { score: results.reduce((sum, r) => sum + (r.correct ? points(r.questionId) : 0), 0),
+      maxScore: results.reduce((sum, r) => sum + points(r.questionId), 0), correctCount,
+      totalQuestions: results.length, results } } : { partial: { results } }) };
+}
