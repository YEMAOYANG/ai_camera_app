new file mode 100644
--- /dev/null
+++ b/app/api/textbook-preview-quiz/[classroomId]/route.ts
@@ -0,0 +1,44 @@
+import { randomBytes } from 'node:crypto';
+import { NextRequest, NextResponse } from 'next/server';
+import { PREVIEW_ATTEMPT, PREVIEW_ID, previewQuiz, readFrozenPreview } from '@/lib/server/mira-textbook-preview-quiz';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+type Context = { params: Promise<{ classroomId: string }> };
+
+async function respond(request: NextRequest, context: Context, write: boolean) {
+  try {
+    const { classroomId } = await context.params;
+    if (!['localhost', '127.0.0.1', '[::1]'].includes(request.nextUrl.hostname) || !PREVIEW_ID.test(classroomId)
+        || write && request.headers.get('origin') !== request.nextUrl.origin)
+      return NextResponse.json({ ok: false, message: '此入口仅用于同源本机冻结预览' }, { status: 403 });
+    const sceneId = request.nextUrl.searchParams.get('sceneId') ?? '';
+    const cookie = `mira-preview-quiz-${classroomId}`;
+    const prior = request.cookies.get(cookie)?.value;
+    const attempt = prior && PREVIEW_ATTEMPT.test(prior) ? prior : randomBytes(32).toString('hex');
+    let operation: { answers?: Record<string, string>; reset?: boolean } | undefined;
+    if (write) {
+      if (!prior || !PREVIEW_ATTEMPT.test(prior)) throw new Error('请先打开此冻结预览的题目');
+      const raw = await request.text();
+      if (raw.length > 8192 || !request.headers.get('content-type')?.startsWith('application/json'))
+        throw new Error('预览提交格式无效');
+      const parsed: unknown = JSON.parse(raw);
+      if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)
+          || !('answers' in parsed || 'reset' in parsed)
+          || Object.keys(parsed).some(key => !['answers', 'reset'].includes(key))
+          || 'reset' in parsed && (parsed.reset !== true || 'answers' in parsed))
+        throw new Error('预览提交字段无效');
+      operation = parsed as typeof operation;
+    }
+    const result = await previewQuiz(await readFrozenPreview(classroomId), sceneId, attempt, operation);
+    const response = NextResponse.json(result, { headers: { 'Cache-Control': 'private, no-store' } });
+    if (prior !== attempt) response.cookies.set(cookie, attempt, { httpOnly: true, sameSite: 'strict',
+      path: `/api/textbook-preview-quiz/${classroomId}`, maxAge: 86400 });
+    return response;
+  } catch (error) {
+    return NextResponse.json({ ok: false, message: error instanceof Error ? error.message : '预览测验没有加载成功' },
+      { status: 409, headers: { 'Cache-Control': 'private, no-store' } });
+  }
+}
+export const GET = (request: NextRequest, context: Context) => respond(request, context, false);
+export const POST = (request: NextRequest, context: Context) => respond(request, context, true);
