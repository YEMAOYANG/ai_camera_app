+++ b/tests/server/widget-media-context.test.ts
@@ -0,0 +1,18 @@
+import { describe, expect, it, vi } from 'vitest';
+import { generateWidgetContent, type SceneOutline } from '@openmaic/generation';
+
+describe('interactive generated media authoring context', () => {
+  it('forwards exact video IDs and topic to the interactive author instead of inventing URLs', async () => {
+    const call = vi.fn(async () => '<html><head></head><body></body></html>');
+    const outline = {
+      id: 'intro', type: 'interactive', title: 'Observe water', description: 'Age-bound observation', order: 1,
+      widgetType: 'game', widgetOutline: { gameType: 'puzzle' },
+      mediaGenerations: [{ type: 'video', elementId: 'gen_vid_water_intro', prompt: 'Observe liquid water poured into two containers, no vapor or particles.' }],
+    } as SceneOutline;
+    await generateWidgetContent(outline, call, '', { textbookPromptProfile: 'textbook-v1' });
+    expect(call).toHaveBeenCalledTimes(1);
+    expect(call.mock.calls[0][1]).toContain('gen_vid_water_intro');
+    expect(call.mock.calls[0][1]).toContain('no vapor or particles');
+    expect(call.mock.calls[0][1]).toContain('literal HTML src attribute');
+  });
+});
