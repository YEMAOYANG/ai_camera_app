diff --git a/lib/server/interactive-media-placeholders.ts b/lib/server/interactive-media-placeholders.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/interactive-media-placeholders.ts
@@ -0,0 +1,19 @@
+/** Replace only real media attributes, preserving authored scripts and document bytes. */
+export function replaceInteractiveMediaPlaceholders(
+  html: string,
+  mediaMap: Record<string, string>,
+): string {
+  const tokens = /<!--[\s\S]*?-->|<(script|style)\b[\s\S]*?<\/\1\s*>|<(img|video|source)\b(?:[^"'<>]|"[^"]*"|'[^']*')*>/gi;
+  return html.replace(tokens, (tag: string) => {
+    if (!/^<(?:img|video|source)\b/i.test(tag)) return tag;
+    return tag.replace(/(\s(?:src|poster)\s*=\s*)(?:(["'])(.*?)\2|([^\s>]+))/gi,
+      (attribute: string, prefix: string, quote: string, quoted: string, bare: string) => {
+        const key = quote ? quoted : bare;
+        if (!/^gen_(?:img|vid)_[\w-]+$/.test(key) || !Object.hasOwn(mediaMap, key)) return attribute;
+        const url = mediaMap[key];
+        if (typeof url !== 'string' || !/^(?:https?:\/\/|\/api\/classroom-media\/)/i.test(url)) return attribute;
+        const safe = url.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+        return prefix + (quote || '"') + safe + (quote || '"');
+      });
+  });
+}
diff --git a/tests/server/interactive-media-placeholders.test.ts b/tests/server/interactive-media-placeholders.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/server/interactive-media-placeholders.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import { replaceInteractiveMediaPlaceholders } from '@/lib/server/interactive-media-placeholders';
+import { assertTextbookBatchContent } from '@/lib/server/mira-textbook-batch-generation';
+import { textbookContext, textbookInteractive } from '@/tests/fixtures/textbook-batch';
+
+describe('interactive generated media boundary', () => {
+  const map = { gen_vid_intro: '/api/classroom-media/book/media/intro.mp4', gen_img_poster: '/api/classroom-media/book/media/poster.png' };
+  it('resolves both video source forms, images and posters without rewriting script bytes', () => {
+    const script = '<script>const example = `<video src="gen_vid_intro">`;window.miraNarrate("intro");</script>';
+    const html = '<!doctype html><video controls src="gen_vid_intro" poster=gen_img_poster></video><video><source src=gen_vid_intro></video><img src=\'gen_img_poster\'>' + script;
+    const result = replaceInteractiveMediaPlaceholders(html, map);
+    expect(result).toContain('src="' + map.gen_vid_intro + '"');
+    expect(result).toContain('poster="' + map.gen_img_poster + '"');
+    expect(result).toContain('src=\'' + map.gen_img_poster + '\'');
+    expect(result.endsWith(script)).toBe(true);
+    expect(result.startsWith('<!doctype html>')).toBe(true);
+  });
+  it('preserves direct assets, comments, styles, missing entries and unsafe maps', () => {
+    const html = '<!-- <img src="gen_img_poster"> --><style>x{content:"<video src=gen_vid_intro>"}</style><video src="/original.mp4" data-src="gen_vid_intro"></video><img src="gen_img_missing">';
+    expect(replaceInteractiveMediaPlaceholders(html, map)).toBe(html);
+    expect(replaceInteractiveMediaPlaceholders('<video src=gen_vid_intro>', { gen_vid_intro: 'javascript:alert(1)' })).toBe('<video src=gen_vid_intro>');
+  });
+  it.each(['<video src="gen_vid_intro"></video>', '<video><source src="gen_vid_intro"></video>', '<video></video>', '<video src="/real.mp4" poster="gen_img_poster"></video>'])(
+    'rejects unresolved final videos: %s', (video) => {
+      const content = textbookInteractive();
+      content.html += video;
+      expect(() => assertTextbookBatchContent('interactive', content, textbookContext(), true)).toThrow('media_unresolved');
+      expect(() => assertTextbookBatchContent('interactive', content, textbookContext(), false)).not.toThrow();
+    });
+  it('accepts a resolved real video while preserving strict narration validation', () => {
+    const content = textbookInteractive();
+    content.html += '<video controls><source src="gen_vid_intro"></video>';
+    content.html = replaceInteractiveMediaPlaceholders(content.html, map);
+    expect(() => assertTextbookBatchContent('interactive', content, textbookContext(), true)).not.toThrow();
+  });
+});
diff --git a/tests/server/widget-media-context.test.ts b/tests/server/widget-media-context.test.ts
