+    visual: { kind: 'image', src: '/api/classroom-media/lesson/media/stem.png', alt: '情境图' },
+  });
+
+  it('keeps the stem, three equal initial choices, original narration and exact answer submission', async () => {
+    const q = pictured();
+    const fetchMock = vi.fn(async (_url: string, init?: RequestInit) => ({ ok: true, json: async () => init?.method === 'POST'
+      ? { ok: true, result: { results: [graded(q.id)] } } : { ok: true } }));
+    vi.stubGlobal('fetch', fetchMock);
+    const host = await mount([q]);
+    expect(host.querySelector('[data-picture-layout="three-images"]')).not.toBeNull();
+    expect([...host.querySelectorAll('img')].map(img => img.getAttribute('src'))).toEqual([
+      '/api/classroom-media/lesson/media/stem.png',
+      '/api/classroom-media/lesson/media/0.png', '/api/classroom-media/lesson/media/1.png', '/api/classroom-media/lesson/media/2.png',
+    ]);
+    const buttons = [...host.querySelectorAll<HTMLButtonElement>('[role=radio]')];
+    expect(new Set(buttons.map(button => button.className)).size).toBe(1);
+    expect(buttons.map(button => button.getAttribute('aria-checked'))).toEqual(['false', 'false', 'false']);
+    expect(host.querySelector('[data-narration-question]')!.getAttribute('data-narration-question')).toBe(q.id);
+    expect(host.querySelector('[data-narration-autoplay]')!.getAttribute('data-narration-autoplay')).toBe('true');
+    await click(host, '[role=radio][aria-label="图3"]');
+    await click(host, '[role=radio][aria-label="图2"]');
+    const submit = [...host.querySelectorAll('footer button')].find(button => button.textContent?.includes('完成练习')) as HTMLButtonElement;
+    expect(submit.disabled).toBe(false);
+    await act(async () => { submit.click(); submit.click(); });
+    const posts = fetchMock.mock.calls.filter(([, init]) => init?.method === 'POST');
+    expect(posts).toHaveLength(1);
+    expect(JSON.parse(posts[0][1]!.body as string)).toEqual({ answers: { pictures: 'B' } });
+    expect(host.querySelector('[data-narration-autoplay]')!.getAttribute('data-narration-autoplay')).toBe('false');
+  });
+
+  it.each(['four-images', 'text', 'quantity'] as const)('does not opt %s into the compact picture branch', async kind => {
+    const q = kind === 'four-images' ? pictured(4) : kind === 'text' ? { ...question('text'), optionVisuals: undefined } : question('quantity');
+    vi.stubGlobal('fetch', vi.fn(async () => ({ ok: true, json: async () => ({ ok: true }) })));
+    const host = await mount([q]);
+    expect(host.querySelector('[data-picture-layout]')).toBeNull();
+    expect(host.querySelectorAll('[role=radio]')).toHaveLength(q.options!.length);
+    expect(host.querySelector('[role=radiogroup]')!.getAttribute('aria-label')).toBe(q.question);
+  });
