diff --git a/components/scene-renderers/fixed-textbook-picture-layout.module.css b/components/scene-renderers/fixed-textbook-picture-layout.module.css
new file mode 100644
--- /dev/null
+++ b/components/scene-renderers/fixed-textbook-picture-layout.module.css
@@ -0,0 +1,147 @@
+/* Only the fixed student three-image question opts into this size container.
+   Ordinary QuizView, text answers and other option counts keep their layout. */
+.root {
+  container: fixed-picture-quiz / size;
+}
+
+@container fixed-picture-quiz (max-width: 560px) {
+  .shell {
+    height: 100%;
+    min-height: 0;
+    padding: 8px;
+    gap: 4px;
+    overflow: hidden;
+  }
+
+  .header {
+    margin: 0;
+    min-height: 24px;
+  }
+
+  .header h2 { font-size: 18px; line-height: 24px; }
+
+  .fieldset {
+    flex: 1 1 0%;
+    min-height: 0;
+    padding: 6px 8px;
+    overflow-y: auto;
+  }
+
+  .fieldset > legend {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .task {
+    display: flex;
+    flex-direction: column;
+    align-items: stretch;
+    height: 100%;
+    min-height: 0;
+    gap: 4px;
+  }
+
+  .scenePicture {
+    flex: 0 0 clamp(48px, 18cqh, 88px);
+    height: clamp(48px, 18cqh, 88px);
+    min-height: 48px;
+  }
+
+  .scenePicture > [data-quiz-visual],
+  .scenePicture [data-quiz-visual] > img {
+    width: 100%;
+    height: 100%;
+    max-height: 100%;
+    object-fit: contain;
+  }
+
+  .question {
+    display: flex;
+    flex-direction: column;
+    flex: 1 1 0%;
+    min-height: 0;
+    gap: 4px;
+  }
+
+  .question > p:first-child {
+    flex: 0 0 auto;
+    margin: 0;
+    font-size: 14px;
+    line-height: 20px;
+  }
+
+  /* The real QuestionNarration component and its failure/retry UI are retained. */
+  .question > div:not([role="radiogroup"]) {
+    flex: 0 0 auto;
+    margin: 0;
+  }
+
+  .question > div:not([role="radiogroup"]) > button {
+    min-width: 48px;
+    min-height: 48px;
+    height: 48px;
+    padding: 0 16px;
+  }
+
+  .question > div:not([role="radiogroup"]) > button > svg {
+    width: 18px;
+    height: 18px;
+  }
+
+  .question .options {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    flex: 1 1 0%;
+    min-height: 80px;
+    align-items: center;
+    gap: 6px;
+  }
+
+  .question .options > button {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 100%;
+    height: 100%;
+    max-height: 144px;
+    min-width: 48px;
+    min-height: 80px;
+    padding: 4px;
+  }
+
+  .question .options > button > [data-quiz-visual="image"] {
+    flex: 1 1 0%;
+    width: 100%;
+    height: 100%;
+    min-height: 0;
+  }
+
+  .question .options > button > [data-quiz-visual="image"] > img {
+    width: 100%;
+    height: 100%;
+    max-height: 136px;
+    object-fit: contain;
+  }
+
+  .footer {
+    flex: 0 0 auto;
+    min-height: 48px;
+    margin: 0;
+    padding: 0;
+  }
+
+  .footer > button {
+    min-width: 48px;
+    min-height: 48px;
+    height: 48px;
+    padding: 0 16px;
+    font-size: 16px;
+  }
+
+  .footer > button > svg { width: 18px; height: 18px; }
+}
