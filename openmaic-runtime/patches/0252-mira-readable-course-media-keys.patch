+function validObjectKey(item: ManifestFile, prefix: string, schema: string): boolean {
+  if (schema === 'mira.course-storage.manifest.v1') {
+    return item.objectKey === `${prefix}/blobs/sha256/${item.sha256}`;
+  }
+  if (typeof item.objectKey !== 'string' || !item.objectKey.startsWith(`${prefix}/`)) return false;
+  const parts = item.objectKey.slice(prefix.length + 1).split('/');
+  if (
+    parts.length !== 3 ||
+    parts.some(
+      (part) =>
+        !part.trim() ||
+        part === '.' ||
+        part === '..' ||
+        part.includes('\\') ||
+        /[\u0000-\u001f\u007f-\u009f]/.test(part) ||
+        Buffer.byteLength(part, 'utf8') > 255 ||
+        Buffer.from(part, 'utf8').toString('utf8') !== part,
+    )
+  )
+    return false;
+  return (
+    NAMED_MEDIA_MIME[path.posix.extname(parts[2]).toLowerCase()]?.includes(item.mimeType) ?? false
+  );
+}
