+import { describe, expect, it } from 'vitest';
+import { buildPrompt, generateSceneContent, type SceneOutline } from '@openmaic/generation';
+
+describe('explicit picture-led diagram routing', () => {
+  const outline: SceneOutline = { id: 'p2', order: 2, title: '看图找字', type: 'interactive',
+    description: '看实物图片和规范字形', keyPoints: ['不把教学步骤画成流程'], widgetType: 'diagram',
+    widgetOutline: { concept: 'shape' },
+  };
+  it.each([undefined, false])('retains ordinary diagram prompt bytes with flag %s', async flag => {
+    let captured: unknown;
+    await generateSceneContent({ ...outline, widgetOutline: { concept: 'shape', ...(flag !== undefined ? { notTeachingFlowchart: flag } : {}) } }, async (system, user) => {
+      captured = { system, user }; return '<html><body></body></html>';
+    });
+    expect(captured).toEqual(buildPrompt('diagram-content', {
+      title: outline.title, diagramType: 'flowchart', description: outline.description,
+      keyPoints: outline.keyPoints.join('\n'), nodeCount: 0, prescribedNodes: [],
+      hasNodeCount: false, hasPrescribedNodes: false, languageDirective: '',
+    }));
+  });
+  it('uses both dedicated templates without unresolved placeholders or mandatory workflow nodes', async () => {
+    let captured = { system: '', user: '' };
+    const result = await generateSceneContent({ ...outline, widgetOutline: { notTeachingFlowchart: true,
+      diagramType: 'interactive-visual-structure', nodes: [{ id: 'letter-z', label: 'glyph-z', parentId: null }],
+    } }, async (system, user) => {
+      captured = { system, user }; return '<html><body></body></html>';
+    });
+    expect(captured.system).toContain('Picture-led Interactive Structure Authoring v1');
+    expect(captured.user).toContain('"id": "letter-z"');
+    expect(captured.system + captured.user).not.toContain('{{');
+    expect(captured.system + captured.user).not.toMatch(/[\p{Extended_Pictographic}\u{1f1e6}-\u{1f1ff}\u20e3]/u);
+    expect(captured.system + captured.user).not.toContain('All nodes connected');
+    expect(captured.system).toContain('Null-ready is initialization');
+    expect(captured.system).toContain('56 CSS pixels');
+    expect(result && 'html' in result && result.html).not.toContain('cdn.jsdelivr.net');
+  });
+});
