+import {
+  hasTeachingInternalToken,
+  readTeachingConversation,
+  TeachingConversationError,
+} from '@/lib/server/mira-teaching-conversation';
+export async function POST(req: Request) {
+  if (!hasTeachingInternalToken(req.headers))
+    return Response.json({ error: 'MIRA_TEACHING_TRUST_REQUIRED' }, { status: 403 });
+  try {
+    const input = await req.json();
+    if (
+      !input ||
+      typeof input !== 'object' ||
+      Object.keys(input).some(
+        (k) => !['conversationId', 'learningSessionId', 'classroomId'].includes(k),
+      )
+    )
+      return Response.json({ error: 'MIRA_TEACHING_READ_INVALID' }, { status: 400 });
+    const conversation = await readTeachingConversation(input);
+    if (!conversation) return Response.json({ conversation: null });
+    const { turns, activeMessageId, activeSegment, ...safe } = conversation;
+    void turns;
+    void activeMessageId;
+    void activeSegment;
+    return Response.json({ conversation: safe });
+  } catch (error) {
+    return Response.json(
+      {
+        error:
+          error instanceof TeachingConversationError
+            ? error.code
+            : 'MIRA_TEACHING_STORE_UNAVAILABLE',
+      },
+      { status: error instanceof TeachingConversationError ? error.status : 503 },
+    );
+  }
+}
