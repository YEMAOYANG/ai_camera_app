+/** Opaque server-issued ID only; no authorization or transcript is trusted from this map. */
+const messageConversations = new Map<string, string>();
+export function bindTeachingMessage(messageId: string, conversationId: string) {
+  if (!/^mtc_[a-f0-9]{64}$/.test(conversationId)) return;
+  messageConversations.set(messageId, conversationId);
+  if (messageConversations.size > 2000)
+    messageConversations.delete(messageConversations.keys().next().value!);
+}
+export function teachingConversationForMessage(messageId: string): string | undefined {
+  return messageConversations.get(messageId);
+}
