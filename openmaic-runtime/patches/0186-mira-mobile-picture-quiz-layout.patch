diff --git a/components/scene-renderers/quiz-picture-options.module.css b/components/scene-renderers/quiz-picture-options.module.css
new file mode 100644
--- /dev/null
+++ b/components/scene-renderers/quiz-picture-options.module.css
@@ -0,0 +1,30 @@
+/* Query the actual question width, including a narrow embedded classroom. */
+.container {
+  container-type: inline-size;
+}
+
+@container (max-width: 560px) {
+  .options {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .options > button {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    flex-direction: row;
+    min-width: 56px;
+    min-height: 136px;
+  }
+
+  .options > button > [data-quiz-visual="image"] {
+    flex: 1 1 0%;
+    min-width: 0;
+  }
+
+  /* Labels remain supplementary; the picture receives the available width. */
+  .options > button > span:last-of-type {
+    flex: 0 0 4em;
+    overflow-wrap: anywhere;
+  }
+}
diff --git a/tests/scene-renderers/quiz-picture-layout.test.ts b/tests/scene-renderers/quiz-picture-layout.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/scene-renderers/quiz-picture-layout.test.ts
@@ -0,0 +1,48 @@
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it, vi } from 'vitest';
+import { SingleChoiceQuestion } from '@/components/scene-renderers/quiz-view';
+import type { QuizQuestion } from '@/lib/types/stage';
+
+vi.mock('@/lib/hooks/use-i18n', () => ({ useI18n: () => ({ t: (key: string) => key, locale: 'zh-CN' }) }));
+const question: QuizQuestion = {
+  id: 'picture-choice', type: 'single', question: '听一听，找到见面的图。', answer: ['B'], points: 10,
+  options: [{ value: 'A', label: '第一幅' }, { value: 'B', label: '第二幅' }, { value: 'C', label: '第三幅' }],
+  optionVisuals: Object.fromEntries(['A', 'B', 'C'].map(value => [value, { kind: 'image', src: `/media/${value}.png`, alt: value }])),
+};
+const render = (q: QuizQuestion, extra = {}) => renderToStaticMarkup(createElement(SingleChoiceQuestion, {
+  question: q, index: 0, onChange: () => {}, ...extra,
+}));
+
+describe('narrow image-choice presentation', () => {
+  it('uses the scoped container only for three actual image options', () => {
+    const html = render(question);
+    expect(html).toMatch(/class="[^"]*container/);
+    expect(html).toMatch(/class="[^"]*options/);
+    for (const value of ['A', 'B', 'C']) {
+      expect(html).toContain(`data-quiz-option="${value}"`);
+      expect(html).toContain(`src="/media/${value}.png"`);
+    }
+    expect(html.match(/border-gray-200/g)).toHaveLength(3);
+    expect(html).not.toContain('border-emerald-400');
+  });
+
+  it('preserves text and quantity-choice layout and answer values', () => {
+    const text = render({ ...question, optionVisuals: undefined });
+    const quantities = render({ ...question, optionVisuals: Object.fromEntries(['A', 'B', 'C'].map((value, i) => [value, { kind: 'quantity', count: i + 1 }])) });
+    expect(text).not.toMatch(/class="[^"]*container/);
+    expect(quantities).not.toMatch(/class="[^"]*container/);
+    expect(quantities).toContain('grid-cols-3');
+    expect(text).toContain('data-quiz-option="B"');
+  });
+
+  it('keeps selection, disabled controls, and post-submission review styling', () => {
+    const selected = render(question, { value: 'C' });
+    expect(selected.match(/border-violet-400/g)).toHaveLength(1);
+    const review = render(question, { value: 'C', disabled: true, result: { questionId: question.id, correct: false, status: 'incorrect', earned: 0 } });
+    expect(review.match(/disabled=""/g)).toHaveLength(3);
+    expect(review.match(/border-emerald-400/g)).toHaveLength(1);
+    expect(review.match(/border-red-300/g)).toHaveLength(1);
+    expect(question.answer).toEqual(['B']);
+  });
+});
