+import { readFileSync } from 'fs';
+import { fileURLToPath } from 'url';
+import { describe, expect, it } from 'vitest';
+import * as registry from '@/lib/server/mira-textbook-pinyin-pronunciation';
+
+const version = 'mira.textbook.pinyin-aouiu-ssml.v1';
+const policy = JSON.parse(readFileSync(fileURLToPath(new URL(
+  '../../../../../backend/content/textbook_pinyin_pronunciation_aouiu.v1.json',
+  import.meta.url,
+)), 'utf8'));
+const prepare = registry.prepareMiraTextbookPinyinPronunciation;
+const sha = 'e23f67fe90ab412d17e1260bf2d1ee4a510c0407bfbfacac9ebce16016583a0d';
+const probes: Record<string, string[]> = {
+  'ɑo，āo、áo、ǎo、ào': ['ao1', 'ao1', 'ao2', 'ao3', 'ao4'],
+  'ou，ōu、óu、ǒu、òu': ['ou1', 'ou1', 'ou2', 'ou3', 'ou4'],
+  'iu，iū、iú、iǔ、iù': ['you1', 'you1', 'you2', 'you3', 'you4'],
+};
+
+describe('AO OU IU textbook pronunciation registration', () => {
+  it('matches the exact frozen backend policy and request identity', () => {
+    expect(registry.MIRA_TEXTBOOK_PINYIN_AOUIU_PRONUNCIATION_POLICY).toEqual(policy);
+    expect(registry.MIRA_TEXTBOOK_PINYIN_AOUIU_PRONUNCIATION_POLICY_SHA256).toBe(sha);
+    const result = prepare('请听，xiǎo qiáo。', version);
+    expect(result.profile.policySha256).toBe(sha);
+    expect(result.providerPronunciation).toMatchObject({
+      policyVersion: version, policySha256: sha,
+      providerId: 'aliyun-cosyvoice', modelId: 'cosyvoice-v3-flash', voiceId: 'longanwen_v3',
+    });
+    expect(result.providerRequest.input).toMatchObject({
+      voice: 'longanwen_v3', format: 'wav', sample_rate: 24000, enable_ssml: true,
+      rate: 1, pitch: 1, seed: 0, language_hints: ['zh'],
+    });
+  });
+
+  it('keeps each final and each tone one exact phoneme in fixed order', () => {
+    for (const [text, phonemes] of Object.entries(probes)) {
+      const result = prepare(text, version);
+      expect([...result.ssml.matchAll(/<phoneme alphabet="py" ph="([^"]+)">/g)]
+        .map(match => match[1])).toEqual(phonemes);
+    }
+    expect(prepare('iu', version).ssml).toBe('<speak><phoneme alphabet="py" ph="you1">优</phoneme></speak>');
+    expect(prepare('请听，xiǎo qiáo。', version).ssml).toBe(
+      '<speak>请听，<phoneme alphabet="py" ph="xiao3">小</phoneme> <phoneme alphabet="py" ph="qiao2">桥</phoneme>。</speak>',
+    );
+  });
+
+  it('covers the exact textbook syllables and keeps natural Chinese untouched', () => {
+    expect(Object.keys(policy.symbols)).toHaveLength(58);
+    const nineteen = 'niǎo shǎo yào rào zǎo tiào ròu tóu lóu yóu zǒu shōu kǒu qiú diū liù niú xiū jiù'.split(' ');
+    expect(nineteen).toHaveLength(19);
+    for (const token of nineteen) {
+      expect(prepare(token, version).ssml).toContain(`ph="${policy.symbols[token].ph}"`);
+    }
+    expect(prepare('小朋友，听一听。', version).ssml).toBe('<speak>小朋友，听一听。</speak>');
+    expect(prepare('老师<&>说：iǔ。', version).ssml).toBe(
+      '<speak>老师&lt;&amp;&gt;说：<phoneme alphabet="py" ph="you3">有</phoneme>。</speak>',
+    );
+  });
+
+  it('rejects unregistered full tokens, wrong tone positions and altered spellings', () => {
+    for (const token of ['ao', 'ao1', 'ɑo1', 'ou1', 'iu1', 'īu', 'íu', 'ǐu', 'ìu',
+      'i\u0301u', 'a\u0304o', 'ɑ\u0304o', 'ɑoou', 'xiǎoniú', 'IU', 'ｉｕ', 'péng', 'luó bo']) {
+      expect(() => prepare(`请听：${token}。`, version)).toThrow();
+    }
+    expect(() => prepare('请听。', 'mira.textbook.pinyin-aouiu-ssml.v2')).toThrow();
+  });
+
+  it('preserves old aieiui policies without importing their override or hearing claims', () => {
+    expect(prepare('请听。', 'mira.textbook.pinyin-aieiui-ssml.v1').profile.policySha256)
+      .toBe('8b927f95d0f279c31c9ae90c7aebcaf8520c34ed829982fda8aa4dfebadd4188');
+    expect(prepare('请听。', 'mira.textbook.pinyin-aieiui-ssml.v4').profile.policySha256)
+      .toBe('d26d1744a110f0ed327d08cdfeb950fe8f15b198fb322f98aa5611f866c6b8b8');
+    expect(prepare('luó bo', 'mira.textbook.pinyin-aieiui-ssml.v4').ssml)
+      .toBe('<speak><sub alias="萝卜">luó bo</sub>。</speak>');
+    expect(policy.exactTextSsml).toBeUndefined();
+    expect(policy.approvalBoundary.humanListeningVerified).toBe(false);
+    expect(policy.approvalBoundary.perceptualToneVerified).toBe(false);
+    expect(policy.approvalBoundary.formalUseAllowed).toBe(false);
+  });
+});
