+  resolveTTSBaseUrl: () => 'https://dashscope.aliyuncs.com/api/v1',
+  resolveASRApiKey: () => 'asr-secret-not-a-receipt',
+  resolveASRBaseUrl: () => 'https://dashscope.aliyuncs.com/api/v1',
+}));
+
+const sha = (value: string | Uint8Array) => createHash('sha256').update(value).digest('hex');
+const text = '听第二声，é。';
+const ttsInput = () => ({
+  requestId: `tbptts1_${'a'.repeat(64)}`, classroomId: 'pinyin-classroom',
+  classroomContentSha256: 'b'.repeat(64), subject: 'chinese',
+  teacherProfileId: 'mira_chinese_gentle', teacherProfileVersion: 2,
+  teacherProfileSha256: 'a5fd163af249705bda4bb0be5448f65d275eb423285557727f9c50ea442f01f8',
+  teacherGender: 'female', sceneId: 'scene-p8', sceneOrder: 8,
+  actionId: 'speech-e-second', narrationSegmentId: 'segment-e-second',
+  text, textSha256: sha(text), pronunciationProfile: prepareMiraTextbookPinyinPronunciation(text).profile,
+});
+const asrInput = (audioSha256: string) => {
+  const { text: _text, textSha256: _textSha, pronunciationProfile: _profile, ...identity } = ttsInput();
+  return { ...identity, requestId: `tbpasr1_${'c'.repeat(64)}`,
+    ttsRequestId: identity.requestId, audioSha256 };
+};
+
+function wav(streaming = true) {
+  const bytes = Buffer.alloc(48);
+  bytes.write('RIFF', 0); bytes.writeUInt32LE(streaming ? 0x7fffffbf : 40, 4);
+  bytes.write('WAVEfmt ', 8); bytes.writeUInt32LE(16, 16); bytes.writeUInt16LE(1, 20);
+  bytes.writeUInt16LE(1, 22); bytes.writeUInt32LE(24_000, 24); bytes.writeUInt32LE(48_000, 28);
+  bytes.writeUInt16LE(2, 32); bytes.writeUInt16LE(16, 34); bytes.write('data', 36);
+  bytes.writeUInt32LE(streaming ? 0x7fffff9b : 4, 40);
+  bytes.writeInt16LE(1234, 44); bytes.writeInt16LE(-2345, 46);
+  return bytes;
+}
+const mediaUrl = 'http://dashscope-result-bj.oss-cn-beijing.aliyuncs.com/prod/cosyvoice-v3-flash/20261016/12345/9bd16738-3506-9b8d-939d-52280b8dde40.wav?signature=private';
+const json = (value: unknown) => new Response(JSON.stringify({ request_id: 'provider-request-123',
+  usage: { characters: 12 }, ...(value as object) }), { headers: { 'content-type': 'application/json' } });
+
+describe('isolated formal textbook pinyin audio', () => {
+  let tempRoot: string;
+  beforeEach(async () => {
+    tempRoot = await fs.mkdtemp(path.join(os.tmpdir(), 'mira-pinyin-audio-'));
+    process.env.MIRA_FORMAL_AUDIO_DATA_DIR = tempRoot;
+  });
+  afterEach(async () => {
+    delete process.env.MIRA_FORMAL_AUDIO_DATA_DIR;
+    await fs.rm(tempRoot, { recursive: true, force: true });
+    vi.restoreAllMocks();
+  });
+
+  it('requires exact explicit profile only for the new namespace', () => {
+    const input = ttsInput();
+    expect(assertMiraFormalTtsRequest(input)).toEqual(input);
+    const { pronunciationProfile: _profile, ...noProfile } = input;
+    for (const bad of [noProfile, { ...input, requestId: 'old-tts' },
+      { ...input, requestId: 'tbptts1_bad' }, { ...input, requestId: `tbpasr1_${'a'.repeat(64)}` },
+      { ...input, pronunciationProfile: { ...input.pronunciationProfile, ssmlSha256: '0'.repeat(64) } },
+      { ...input, pronunciationProfile: { ...input.pronunciationProfile, extra: true } },
+      { ...input, text: 'hello', textSha256: sha('hello') },
+      { ...input, subject: 'science', teacherProfileId: 'mira_science_inquiry', teacherProfileVersion: 1,
+        teacherProfileSha256: '6bdd6746ed1a6a538751f23ff663a9153e7d1db767f7d9d3b6e5dc00d97d5c6b' },
+    ]) expect(() => assertMiraFormalTtsRequest(bad)).toThrow();
+    expect(assertMiraFormalTtsRequest({ ...noProfile, requestId: 'old-tts' })).toBeDefined();
+    const asr = asrInput('d'.repeat(64));
+    expect(assertMiraFormalAsrRequest(asr)).toEqual(asr);
+    for (const bad of [{ ...asr, requestId: 'old-asr' }, { ...asr, ttsRequestId: 'old-tts' },
+      { ...asr, ttsRequestId: `tbbtts2_${'a'.repeat(64)}` },
+      { ...asr, pronunciationProfile: input.pronunciationProfile },
+    ]) expect(() => assertMiraFormalAsrRequest(bad)).toThrow();
+  });
+
+  it('persists and meters actual provider/body, repairs only length bytes, and replays without POST', async () => {
+    const source = wav(); const prepared = prepareMiraTextbookPinyinPronunciation(text);
+    const budget = vi.spyOn(paidBudget, 'budgetedOperation').mockImplementation(
+      async (_provider, _model, _request, _units, work) => work());
+    const fetchMock = vi.fn(async (url: string | URL | Request, init?: RequestInit) => {
+      if (init?.method === 'POST') {
+        expect(String(url)).toBe('https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer');
+        expect(init.body).toBe(prepared.providerBody);
+        const pending = await readMiraFormalTtsJob(ttsInput().requestId);
+        expect(pending).toMatchObject({ state: 'running', providerId: 'aliyun-cosyvoice',
+          modelId: 'cosyvoice-v3-flash', voiceId: 'longanwen_v3',
+          providerPronunciation: prepared.providerPronunciation });
+        return json({ output: { audio: { url: mediaUrl } } });
+      }
+      expect(String(url)).toBe(mediaUrl.replace('http:', 'https:'));
+      expect(init?.headers).toBeUndefined();
+      return new Response(source, { headers: { 'content-type': 'audio/wav' } });
+    });
+    const dependencies = { fetchImpl: fetchMock as typeof fetch, resolveAddresses: async () => ['8.8.8.8'] };
+    const first = await executeMiraFormalTts(ttsInput(), dependencies);
+    expect(first.record).toMatchObject({ state: 'succeeded', providerAudioSha256: sha(source),
+      providerRequestId: 'provider-request-123', providerUsage: { characters: 12 },
+      budgetMeasurement: { kind: 'ssml-codepoint-upper-bound', characters: Array.from(prepared.ssml).length, estimated: true },
+      pcmSha256: sha(source.subarray(44)), audioNormalization: {
+        policyVersion: 'mira.wav.streaming-pcm-lengths.v1', applied: true,
+        providerRiffSize: 0x7fffffbf, providerDataSize: 0x7fffff9b,
+        riffSize: 40, dataSize: 4, pcmByteLength: 4, sampleRate: 24000, channels: 1, bitsPerSample: 16,
+      } });
+    const { bytes } = await readMiraFormalTtsAsset(ttsInput().requestId);
+    expect(Buffer.from(bytes)).toEqual(wav(false));
+    expect(first.record.audioSha256).toBe(sha(wav(false)));
+    const replay = await executeMiraFormalTts(ttsInput(), dependencies);
+    expect(replay).toEqual({ record: first.record, created: false });
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+    expect(budget).toHaveBeenCalledWith('aliyun-cosyvoice', 'cosyvoice-v3-flash', expect.objectContaining({
+      logicalRequest: ttsInput(), providerRequest: JSON.parse(prepared.providerBody),
+    }), { calls: 1, characters: Array.from(prepared.ssml).length }, expect.any(Function));
+    const receipt = JSON.stringify(first.record);
+    expect(receipt).not.toContain('secret-not-a-receipt');
+    expect(receipt).not.toContain('signature=private');
+  });
+
+  it('keeps unknown provider outcomes immutable without another POST', async () => {
+    const fetchMock = vi.fn(async () => { throw new Error('network uncertainty'); });
+    const first = await executeMiraFormalTts(ttsInput(), { fetchImpl: fetchMock });
+    expect(first.record.state).toBe('ambiguous');
+    expect((await executeMiraFormalTts(ttsInput(), { fetchImpl: fetchMock })).created).toBe(false);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+
+  it.each([
+    'http://other.oss-cn-beijing.aliyuncs.com/prod/cosyvoice-v3-flash/20261016/123/x.wav',
+    mediaUrl.replace('/cosyvoice-v3-flash/', '/qwen3-tts-flash/'),
+  ])('rejects unreviewed provider media destinations: %s', async url => {
+    const fetchMock = vi.fn(async () => json({ output: { audio: { url } } }));
+    const result = await executeMiraFormalTts(ttsInput(), { fetchImpl: fetchMock,
+      resolveAddresses: async () => ['8.8.8.8'] });
+    expect(result.record.state).toBe('failed');
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(['sample-rate', 'invented-sentinel', 'truncated-data'])('does not normalize an unverified WAV: %s', async defect => {
+    const source = wav();
+    if (defect === 'sample-rate') source.writeUInt32LE(16000, 24);
+    if (defect === 'invented-sentinel') {
+      source.writeUInt32LE(0xffffffff, 4); source.writeUInt32LE(0xffffffdb, 40);
+    }
+    const malformed = defect === 'truncated-data' ? source.subarray(0, 47) : source;
+    const fetchMock = vi.fn(async (_url: unknown, init?: RequestInit) => init?.method === 'POST'
