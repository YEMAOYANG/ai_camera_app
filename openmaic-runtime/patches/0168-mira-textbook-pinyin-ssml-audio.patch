+      expect(body.parameters.asr_options).toEqual({ language: 'zh' });
+      return json({ output: { choices: [{ message: { content: [{ text: '听第二声鹅' }] } }] } });
+    });
+    const result = await executeMiraFormalAsr(asrInput(tts.record.audioSha256!), { fetchImpl: fetchAsr as typeof fetch });
+    expect(result.record).toMatchObject({ state: 'succeeded', providerId: 'qwen-asr', modelId: 'qwen3-asr-flash',
+      providerPronunciation: tts.record.providerPronunciation, providerAsrBodySha256: expect.stringMatching(/^[a-f0-9]{64}$/) });
+    expect((await executeMiraFormalAsr(asrInput(tts.record.audioSha256!), { fetchImpl: fetchAsr as typeof fetch })).created).toBe(false);
+    expect(fetchAsr).toHaveBeenCalledTimes(1);
+    await expect(executeMiraFormalAsr({ ...asrInput(tts.record.audioSha256!), actionId: 'wrong-action' },
+      { fetchImpl: fetchAsr as typeof fetch })).rejects.toThrow();
+    const recordPath = path.join(tempRoot, 'jobs', 'tts', `${sha(ttsInput().requestId)}.json`);
+    const corrupted = JSON.parse(await fs.readFile(recordPath, 'utf8'));
+    corrupted.providerPronunciation.policySha256 = '0'.repeat(64);
+    await fs.writeFile(recordPath, JSON.stringify(corrupted));
+    await expect(executeMiraFormalAsr(asrInput(tts.record.audioSha256!), { fetchImpl: fetchAsr as typeof fetch })).rejects.toThrow();
+    expect(fetchAsr).toHaveBeenCalledTimes(1);
+  });
+});
