+import { createHash } from 'crypto';
+import { existsSync, readFileSync } from 'fs';
+import path from 'path';
+import { describe, expect, it } from 'vitest';
+import {
+  MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY,
+  MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY_SHA256,
+  prepareMiraTextbookPinyinPronunciation,
+} from '@/lib/server/mira-textbook-pinyin-pronunciation';
+
+const sha = (text: string) => createHash('sha256').update(text).digest('hex');
+
+describe('fixed textbook aoe SSML policy', () => {
+  it('matches the separately frozen Python policy digest', () => {
+    expect(MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY_SHA256)
+      .toBe('e325a2ef4706cb6e5cf6b11691d05ee0b30e59ce37d8a06c1528d8c6adf578c7');
+    expect(MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY.listeningRequired).toBe(true);
+    // In the integrated repository compare actual JSON, not just the agreed digest.
+    // The native package can also run standalone after applying its durable patch series.
+    const source = path.resolve(process.cwd(), '../../../backend/content/textbook_pinyin_pronunciation.v1.json');
+    if (existsSync(source)) expect(MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY)
+      .toEqual(JSON.parse(readFileSync(source, 'utf8')));
+  });
+
+  it('matches independent Python SSML and physical-body vectors', () => {
+    const prepared = prepareMiraTextbookPinyinPronunciation('e，ɑ o e，āáǎà。');
+    expect(prepared.profile.ssmlSha256).toBe('18ca0381d4d11ce74efe08ac76111aaabc4f16d97ce0cb789e4421032140c737');
+    expect(prepared.providerPronunciation.providerBodySha256)
+      .toBe('d66a1a16ca8b98f99e8eba7c320a4e12f8d66ba1e57aa2280334b24913d6aca3');
+  });
+
+  it('maps only the reviewed aoe symbol inventory without changing logical identity', () => {
+    const text = '请听ɑaāáǎàoōóǒòeēéěè。';
+    const prepared = prepareMiraTextbookPinyinPronunciation(text);
+    const phonemes = [...prepared.ssml.matchAll(/ph="([aoe][1-4])"/g)].map(item => item[1]);
+    expect(phonemes).toEqual(['a1', 'a1', 'a1', 'a2', 'a3', 'a4',
+      'o1', 'o1', 'o2', 'o3', 'o4', 'e1', 'e1', 'e2', 'e3', 'e4']);
+    expect(prepared.providerPronunciation.sourceTextSha256).toBe(sha(text));
+    expect(prepared.profile.ssmlSha256).toBe(sha(prepared.ssml));
+    expect(prepared.providerPronunciation.providerBodySha256).toBe(sha(prepared.providerBody));
+    expect(JSON.parse(prepared.providerBody)).toEqual({
+      model: 'cosyvoice-v3-flash', input: {
+        text: prepared.ssml, voice: 'longanwen_v3', format: 'wav', sample_rate: 24000,
+        rate: 1, pitch: 1, enable_ssml: true, seed: 0, language_hints: ['zh'],
+      },
+    });
+  });
+
+  it('escapes ordinary text instead of allowing caller supplied SSML', () => {
+    expect(prepareMiraTextbookPinyinPronunciation('请听：<&>"\'，é。').ssml)
+      .toBe('<speak>请听：&lt;&amp;&gt;&quot;&apos;，<phoneme alphabet="py" ph="e2">鹅</phoneme>。</speak>');
+    expect(prepareMiraTextbookPinyinPronunciation('请看这幅图。').ssml)
+      .toBe('<speak>请看这幅图。</speak>');
+  });
+
+  it.each(['hello', 'A', 'ü', 'bɑ', 'ɑ\u0304', 'e\u0301', '<break time="1s"/>', 'éclair'])
+    ('rejects unsupported Latin or combining marks before dispatch: %s', text => {
+      expect(() => prepareMiraTextbookPinyinPronunciation(text)).toThrow();
+    });
+});
