+/** Additive operator policy; this is a pronunciation recipe, not a listening verdict.
+ * Its canonical digest must match backend/content/textbook_pinyin_pronunciation.v1.json.
+ * Keep the original teacher identity and legacy Qwen requests unchanged. */
+export const MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY = {
+  policyVersion: 'mira.textbook.pinyin-aoe-ssml.v1',
+  subject: 'chinese',
+  providerId: 'aliyun-cosyvoice',
+  modelId: 'cosyvoice-v3-flash',
+  voiceId: 'longanwen_v3',
+  endpointPath: '/services/audio/tts/SpeechSynthesizer',
+  inputParameters: {
+    voice: 'longanwen_v3', format: 'wav', sample_rate: 24000,
+    enable_ssml: true, rate: 1, pitch: 1, seed: 0, language_hints: ['zh'],
+  },
+  symbols: {
+    'ɑ': { ph: 'a1', carrier: '啊' }, a: { ph: 'a1', carrier: '啊' },
+    o: { ph: 'o1', carrier: '哦' }, e: { ph: 'e1', carrier: '鹅' },
+    'ā': { ph: 'a1', carrier: '啊' }, 'á': { ph: 'a2', carrier: '啊' },
+    'ǎ': { ph: 'a3', carrier: '啊' }, 'à': { ph: 'a4', carrier: '啊' },
+    'ō': { ph: 'o1', carrier: '哦' }, 'ó': { ph: 'o2', carrier: '哦' },
+    'ǒ': { ph: 'o3', carrier: '哦' }, 'ò': { ph: 'o4', carrier: '哦' },
+    'ē': { ph: 'e1', carrier: '鹅' }, 'é': { ph: 'e2', carrier: '鹅' },
+    'ě': { ph: 'e3', carrier: '鹅' }, 'è': { ph: 'e4', carrier: '鹅' },
+  },
+  textHandling: {
+    normalization: 'none', xmlEscape: 'amp_lt_gt_quot_apos',
+    unsupportedLatin: 'reject', combiningMarks: 'reject', wrapper: 'speak',
+  },
+  listeningRequired: true,
+} as const;
+
+function canonical(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value)
+    // Python sort_keys follows code points; every policy key is in the BMP.
+    // localeCompare would sort accented symbols differently and corrupt the cross-language identity.
+    .sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0).map(([k, v]) => [k, canonical(v)]));
+  return value;
+}
+const sha = (value: string) => createHash('sha256').update(value).digest('hex');
+const canonicalJson = (value: unknown) => JSON.stringify(canonical(value));
+
+export const MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY_SHA256 = sha(canonicalJson(MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY));
+
+export interface MiraTextbookPinyinPronunciationProfile {
+  policyVersion: typeof MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY.policyVersion;
+  policySha256: string;
+  ssmlSha256: string;
+}
+export interface MiraTextbookPinyinProviderPronunciation extends MiraTextbookPinyinPronunciationProfile {
+  sourceTextSha256: string;
+  providerBodySha256: string;
+  providerId: typeof MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY.providerId;
+  modelId: typeof MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY.modelId;
+  voiceId: typeof MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY.voiceId;
+}
+
+const XML_ENTITIES: Record<string, string> = {
+  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&apos;',
+};
+
+export function prepareMiraTextbookPinyinPronunciation(text: string) {
+  if (!text || text !== text.trim() || text.length > 8000 || /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/u.test(text))
+    throw new Error('Invalid textbook pinyin text');
+  const policy = MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY;
+  const symbols: Record<string, { ph: string; carrier: string }> = policy.symbols;
+  const parts = Array.from(text).map(character => {
+    const symbol = symbols[character];
+    if (symbol) return `<phoneme alphabet="py" ph="${symbol.ph}">${symbol.carrier}</phoneme>`;
+    // Do not normalize: a visually equivalent spelling would otherwise have a different source identity.
+    if (/[\p{Script=Latin}\p{Mark}]/u.test(character)) throw new Error('Unsupported textbook pinyin symbol');
+    return XML_ENTITIES[character] ?? character;
+  });
+  const ssml = `<speak>${parts.join('')}</speak>`;
+  const profile: MiraTextbookPinyinPronunciationProfile = {
+    policyVersion: policy.policyVersion,
+    policySha256: MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY_SHA256,
+    ssmlSha256: sha(ssml),
+  };
+  const providerRequest = { model: policy.modelId, input: { ...policy.inputParameters, text: ssml } };
+  const providerBody = canonicalJson(providerRequest);
+  const providerPronunciation: MiraTextbookPinyinProviderPronunciation = {
+    ...profile, sourceTextSha256: sha(text), providerBodySha256: sha(providerBody),
+    providerId: policy.providerId, modelId: policy.modelId, voiceId: policy.voiceId,
+  };
+  return { ssml, profile, providerRequest, providerBody, providerPronunciation };
+}
+
+export type MiraTextbookPinyinPrepared = ReturnType<typeof prepareMiraTextbookPinyinPronunciation>;
+
+/** Reserve even malformed spellings so an invalid pinyin request cannot fall through to Qwen. */
+export function textbookPinyinNamespace(
+  input: { subject?: unknown; requestId?: unknown; ttsRequestId?: unknown }, operation: 'tts' | 'asr',
+): boolean {
+  const reserved = /^(?:tbptts|tbpasr)/;
+  const requestId = String(input.requestId || '');
+  const ttsRequestId = String(input.ttsRequestId || '');
+  if (!reserved.test(requestId) && !(operation === 'asr' && reserved.test(ttsRequestId))) return false;
+  if (input.subject !== 'chinese' || !(operation === 'tts' ? /^tbptts1_[a-f0-9]{64}$/ : /^tbpasr1_[a-f0-9]{64}$/).test(requestId)
+      || (operation === 'asr' && !/^tbptts1_[a-f0-9]{64}$/.test(ttsRequestId)))
+    throw new Error('Invalid textbook pinyin namespace');
+  return true;
+}
+
+export function assertMiraTextbookPinyinProfile(profile: unknown, expected: MiraTextbookPinyinPronunciationProfile): void {
+  if (!profile || typeof profile !== 'object' || Array.isArray(profile)
+      || canonicalJson(profile) !== canonicalJson(expected)) throw new Error('Invalid textbook pinyin pronunciation profile');
+}
+
+export function isMiraTextbookPinyinProviderPronunciation(
+  value: unknown, sourceTextSha256: string,
+): value is MiraTextbookPinyinProviderPronunciation {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
+  const profile = value as Record<string, unknown>;
+  const policy = MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY;
+  return Object.keys(profile).sort().join(',') === [
+    'policyVersion', 'policySha256', 'ssmlSha256', 'sourceTextSha256', 'providerBodySha256', 'providerId', 'modelId', 'voiceId',
+  ].sort().join(',') && profile.policyVersion === policy.policyVersion
+    && profile.policySha256 === MIRA_TEXTBOOK_PINYIN_PRONUNCIATION_POLICY_SHA256
+    && profile.sourceTextSha256 === sourceTextSha256
+    && profile.providerId === policy.providerId && profile.modelId === policy.modelId && profile.voiceId === policy.voiceId
+    && ['ssmlSha256', 'providerBodySha256', 'sourceTextSha256'].every(key => /^[a-f0-9]{64}$/.test(String(profile[key] || '')));
+}
