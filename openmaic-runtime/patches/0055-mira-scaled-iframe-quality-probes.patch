+/** Chromium's cross-process iframe coordinates can omit the host CSS scale.
+ * Project the actual DOM point through the preview host, retaining real mouse
+ * input and hit tests in both documents. Never synthesize a DOM click. */
+async function clickLocalControl(target: Page | Frame, control: Locator) {
+  if (!('frameElement' in target)) {
+    await control.click({ timeout: 2000 });
+    return;
+  }
+  await control.waitFor({ state: 'visible', timeout: 2000 });
+  if (!(await control.isEnabled())) throw new Error('probe control is disabled');
+  await control.scrollIntoViewIfNeeded({ timeout: 2000 });
+  const local = await control.evaluate((element) => {
+    const rect = element.getBoundingClientRect();
+    const x = rect.x + rect.width / 2;
+    const y = rect.y + rect.height / 2;
+    if (
+      rect.width <= 0 ||
+      rect.height <= 0 ||
+      x < 0 ||
+      y < 0 ||
+      x >= window.innerWidth ||
+      y >= window.innerHeight ||
+      !element.contains(document.elementFromPoint(x, y))
+    )
+      throw new Error('probe control is outside the viewport or covered');
+    return { x, y };
+  });
+  const host = await target.frameElement();
+  try {
+    const point = await host.evaluate((element, local) => {
+      const iframe = element as HTMLIFrameElement;
+      const rect = iframe.getBoundingClientRect();
+      const transform = new DOMMatrix(getComputedStyle(iframe).transform);
+      if (
+        !transform.is2D ||
+        transform.b !== 0 ||
+        transform.c !== 0 ||
+        transform.a <= 0 ||
+        transform.d <= 0 ||
+        iframe.offsetWidth <= 0 ||
+        iframe.offsetHeight <= 0
+      )
+        throw new Error('probe iframe transform is unsupported');
+      const x = rect.x + ((iframe.clientLeft + local.x) * rect.width) / iframe.offsetWidth;
+      const y = rect.y + ((iframe.clientTop + local.y) * rect.height) / iframe.offsetHeight;
+      if (!Number.isFinite(x) || !Number.isFinite(y) || document.elementFromPoint(x, y) !== iframe)
+        throw new Error('probe iframe is outside the viewport or covered');
+      return { x, y };
+    }, local);
+    await target.page().mouse.click(point.x, point.y);
+  } finally {
+    await host.dispose();
+  }
+}
