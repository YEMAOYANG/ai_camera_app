+async function verifiedAudioRepairs(value: unknown, prepared: Awaited<ReturnType<typeof prepareMiraFormalSavedStageRecovery>>) {
+  const references = Array.isArray(value) ? [...value] : [value];
+  if (!references.length || references.length > 240 ||
+      references.some(reference => !reference || typeof reference !== 'object' || Array.isArray(reference)) ||
+      new Set(references.map(reference => reference.asrRequestId)).size !== references.length)
+    throw new Error('SAVED_STAGE_AUDIO_REPAIR_SET_INVALID');
+  const receipts = [];
+  for (const reference of references) receipts.push(await verifiedAudioRepair(reference, prepared));
+  receipts.sort((left, right) => left.asrRequestId < right.asrRequestId ? -1 : 1);
+  // Preserve the consumed single-repair claim even if its reference is wrapped
+  // in an array. Multiple repairs bind the complete sorted set, without a nonce.
+  return receipts.length === 1 ? receipts[0] : receipts;
+}
