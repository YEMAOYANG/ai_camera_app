+import { readFileSync } from 'fs';
+import { fileURLToPath } from 'url';
+import { describe, expect, it } from 'vitest';
+import * as registry from '@/lib/server/mira-textbook-pinyin-pronunciation';
+
+const version = 'mira.textbook.pinyin-aneninunun-ssml.v1';
+const policy = JSON.parse(readFileSync(fileURLToPath(new URL(
+  '../../../../../backend/content/textbook_pinyin_pronunciation_aneninunun.v1.json', import.meta.url,
+)), 'utf8'));
+const sha = 'f91fb1741934f79d0a2664aa68b69dccfec0042eb04f0000510669ef631d2865';
+const prepare = registry.prepareMiraTextbookPinyinPronunciation;
+const phonemes = (text: string) => [...prepare(text, version).ssml.matchAll(/<phoneme alphabet="py" ph="([^"]+)">/g)]
+  .map(match => match[1]);
+
+describe('Exact front-nasal lesson pronunciation registration', () => {
+  it('matches the backend identity and retains the existing provider and explicit SSML contract', () => {
+    expect(registry.MIRA_TEXTBOOK_PINYIN_ANENINUNUN_PRONUNCIATION_POLICY).toEqual(policy);
+    expect(registry.MIRA_TEXTBOOK_PINYIN_ANENINUNUN_PRONUNCIATION_POLICY_SHA256).toBe(sha);
+    expect(Object.keys(policy.symbols)).toHaveLength(46);
+    const result = prepare('请听：lún chuán。', version);
+    expect(result.profile).toMatchObject({ policyVersion: version, policySha256: sha });
+    expect(result.providerPronunciation).toMatchObject({
+      policyVersion: version, policySha256: sha,
+      providerId: 'aliyun-cosyvoice', modelId: 'cosyvoice-v3-flash', voiceId: 'longanwen_v3',
+    });
+    expect(result.providerRequest).toMatchObject({ model: 'cosyvoice-v3-flash', input: {
+      voice: 'longanwen_v3', format: 'wav', sample_rate: 24000, enable_ssml: true,
+      rate: 1, pitch: 1, seed: 0, language_hints: ['zh'],
+    } });
+    expect(registry.isMiraTextbookPinyinProviderPronunciation(
+      result.providerPronunciation, result.providerPronunciation.sourceTextSha256,
+    )).toBe(true);
+    expect(registry.isMiraTextbookPinyinProviderPronunciation(
+      { ...result.providerPronunciation, policySha256: '0'.repeat(64) },
+      result.providerPronunciation.sourceTextSha256,
+    )).toBe(false);
+  });
+
+  it('demonstrates exact untuned forms as whole first-tone recipes without adding tone rows', () => {
+    expect(phonemes('ɑn en in un ün')).toEqual(['an1', 'en1', 'yin1', 'wen1', 'yun1']);
+    expect(phonemes('yuan yin yun')).toEqual(['yuan1', 'yin1', 'yun1']);
+    expect(phonemes('yuán yīn yùn')).toEqual(['yuan2', 'yin1', 'yun4']);
+    expect(prepare('ɑn', version).ssml).toBe('<speak><phoneme alphabet="py" ph="an1">安</phoneme></speak>');
+  });
+
+  it('admits the six complete printed spelling outputs without separately voicing components', () => {
+    expect(phonemes('guān kuān huān juān quān xuān')).toEqual([
+      'guan1', 'kuan1', 'huan1', 'juan1', 'quan1', 'xuan1',
+    ]);
+    for (const token of ['g', 'k', 'h', 'j', 'q', 'x', 'u', 'ü', 'ān'])
+      expect(() => prepare(token, version), token).toThrow();
+  });
+
+  it('keeps the 29 petals and full static writing phrase in exact source order', () => {
+    expect(phonemes('wān yǎn nán zhàn duǎn rǎn jiān quān')).toEqual([
+      'wan1', 'yan3', 'nan2', 'zhan4', 'duan3', 'ran3', 'jian1', 'quan1',
+    ]);
+    expect(phonemes('nèn chén kěn zhēn rén wén')).toEqual(['nen4', 'chen2', 'ken3', 'zhen1', 'ren2', 'wen2']);
+    expect(phonemes('mín pīn nín jìn xīn qīn')).toEqual(['min2', 'pin1', 'nin2', 'jin4', 'xin1', 'qin1']);
+    expect(phonemes('chūn rùn tūn hūn zhǔn lún')).toEqual(['chun1', 'run4', 'tun1', 'hun1', 'zhun3', 'lun2']);
+    expect(phonemes('jūn qún xún')).toEqual(['jun1', 'qun2', 'xun2']);
+    expect(phonemes('lún chuán')).toEqual(['lun2', 'chuan2']);
+  });
+
+  it('rejects unapproved aliases, neutral tones, Unicode encodings and future-lesson targets', () => {
+    for (const token of ['an', 'án', 'ǎn', 'àn', 'an1', 'ɑn1', 'ɑnɑn', 'en2', 'ün1', 'vn',
+      'men', 'men5', 'mén', 'yuān', 'yǔn', 'jüān', 'qüān', 'xüān', 'yuan2', 'guānquān',
+      'ang', 'ɑng', 'eng', 'ing', 'ong', 'ying', 'AN', 'ａｎ', 'a\u0304n', 'u\u0308n'])
+      expect(() => prepare(`请听：${token}。`, version), token).toThrow();
+    expect(() => prepare('请听。', 'mira.textbook.pinyin-aneninunun-ssml.v2')).toThrow();
+    const result = prepare('请听：ɑn。', version);
+    expect(() => registry.assertMiraTextbookPinyinProfile(
+      { ...result.profile, ssmlSha256: '0'.repeat(64) }, result.profile,
+    )).toThrow();
+  });
+
+  it('leaves Chinese we and picture words natural and escapes caller markup', () => {
+    const source = '蓝天、白云、草原、森林。读到我们这个词时，后一个音节轻一些。';
+    expect(prepare(source, version).ssml).toBe(`<speak>${source}</speak>`);
+    expect(prepare('看<&>：ɑn。', version).ssml).toBe(
+      '<speak>看&lt;&amp;&gt;：<phoneme alphabet="py" ph="an1">安</phoneme>。</speak>',
+    );
+    expect(policy.words).toEqual({});
+    expect(policy.exactTextSsml).toBeUndefined();
+  });
+
+  it('retains prior identities and does not turn recipe registration into approval', () => {
+    expect(prepare('请听。', 'mira.textbook.pinyin-ieueer-ssml.v1').profile.policySha256)
+      .toBe('27b702593fc628848ecad8dff8b21859d2bae2cc4de33f373e65c62a8f24da46');
+    expect(prepare('请听。', 'mira.textbook.pinyin-aouiu-ssml.v1').profile.policySha256)
+      .toBe('e23f67fe90ab412d17e1260bf2d1ee4a510c0407bfbfacac9ebce16016583a0d');
+    expect(prepare('luó bo', 'mira.textbook.pinyin-aieiui-ssml.v4').ssml)
+      .toBe('<speak><sub alias="萝卜">luó bo</sub>。</speak>');
+    for (const key of ['humanListeningVerified', 'perceptualToneVerified', 'pronunciationApproved', 'formalUseAllowed'])
+      expect(policy.approvalBoundary[key]).toBe(false);
+  });
+});
