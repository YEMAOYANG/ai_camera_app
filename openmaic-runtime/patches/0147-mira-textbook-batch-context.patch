diff --git a/lib/server/mira-textbook-batch-generation.ts b/lib/server/mira-textbook-batch-generation.ts
new file mode 100644
--- /dev/null
+++ b/lib/server/mira-textbook-batch-generation.ts
@@ -0,0 +1,435 @@
+import { parseHTML } from 'linkedom';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import type { AICallFn, AgentInfo, SceneOutline } from '@openmaic/generation';
+
+export const TEXTBOOK_BATCH_MARKER = 'MIRA_TEXTBOOK_BATCH_V2';
+
+export interface TextbookBatchContext {
+  schemaVersion: 'mira.textbook.batch-context.v2';
+  taskId: string;
+  kind: string;
+  gradeCode: string;
+  subject: string;
+  binding: Record<string, unknown>;
+  directoryComplete: boolean;
+  teacher: {
+    teacherName: string;
+    avatarPath: string;
+    voiceId: string;
+    teacherProfile: { id: string; version: number; contentHash: string };
+    tts: { providerId: string; modelId: string; fallbackAllowed: false };
+  };
+  /** Exact operator-frozen requirement, never an outline-generated summary. */
+  requirement: string;
+}
+
+export class TextbookBatchContractError extends Error {
+  readonly isRetryable = false;
+  constructor(code: string) {
+    super(`MIRA_TEXTBOOK_BATCH_CONTRACT:${code}`);
+    this.name = 'TextbookBatchContractError';
+  }
+}
+
+function check(value: unknown, code: string): asserts value {
+  if (!value) throw new TextbookBatchContractError(code);
+}
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+function nonempty(value: unknown): value is string {
+  return typeof value === 'string' && value.trim().length > 0;
+}
+
+/** An ordinary requirement mentioning the marker in prose does not opt in. */
+export function resolveTextbookBatchContext(requirement: string): TextbookBatchContext | null {
+  const lines = requirement.split(/\r?\n/);
+  const markers = lines.flatMap((line, index) => (line === TEXTBOOK_BATCH_MARKER ? [index] : []));
+  if (!markers.length) return null;
+  check(markers.length === 1 && markers[0] === 0, 'marker_invalid');
+  let context: unknown;
+  try {
+    context = JSON.parse(lines[1]);
+  } catch {
+    throw new TextbookBatchContractError('context_json');
+  }
+  check(
+    record(context) && context.schemaVersion === 'mira.textbook.batch-context.v2',
+    'context_schema',
+  );
+  check(nonempty(context.taskId) && /^[a-f0-9]{64}$/.test(context.taskId), 'task_identity');
+  check(
+    ['book_exploration', 'unit_guide', 'lesson_courseware'].includes(String(context.kind)),
+    'kind',
+  );
+  check(record(context.binding), 'binding');
+  check(
+    nonempty(context.gradeCode) && context.gradeCode === context.binding.gradeCode,
+    'grade_binding',
+  );
+  check(
+    nonempty(context.subject) && context.subject === context.binding.subject,
+    'subject_binding',
+  );
+  for (const field of ['editionId', 'revisionId', 'schoolSystem', 'volume']) {
+    check(nonempty(context.binding[field]), `binding_${field}`);
+  }
+  check(typeof context.directoryComplete === 'boolean', 'directory_complete');
+  const frozenLine = lines.indexOf('冻结任务书：');
+  check(frozenLine >= 2, 'frozen_scope_missing');
+  let frozen: unknown;
+  try {
+    frozen = JSON.parse(lines[frozenLine + 1]);
+  } catch {
+    throw new TextbookBatchContractError('frozen_scope_json');
+  }
+  check(record(frozen) && record(frozen.binding), 'frozen_scope');
+  const binding = context.binding;
+  const frozenBinding = frozen.binding;
+  const bindingKeys = Object.keys(binding).sort();
+  check(
+    bindingKeys.join('|') === Object.keys(frozenBinding).sort().join('|') &&
+      bindingKeys.every((key) => binding[key] === frozenBinding[key]) &&
+      context.kind === frozen.kind &&
+      context.directoryComplete === frozen.directoryComplete,
+    'frozen_binding_mismatch',
+  );
+  const teacher = context.teacher;
+  check(
+    record(teacher) &&
+      nonempty(teacher.teacherName) &&
+      nonempty(teacher.avatarPath) &&
+      nonempty(teacher.voiceId),
+    'teacher',
+  );
+  check(
+    record(teacher.teacherProfile) &&
+      nonempty(teacher.teacherProfile.id) &&
+      Number.isInteger(teacher.teacherProfile.version) &&
+      Number(teacher.teacherProfile.version) > 0 &&
+      typeof teacher.teacherProfile.contentHash === 'string' &&
+      /^[a-f0-9]{64}$/.test(teacher.teacherProfile.contentHash),
+    'teacher_profile',
+  );
+  check(
+    record(teacher.tts) &&
+      teacher.tts.providerId === 'qwen-tts' &&
+      teacher.tts.modelId === 'qwen3-tts-flash' &&
+      teacher.tts.fallbackAllowed === false,
+    'teacher_voice',
+  );
+  return { ...context, requirement } as unknown as TextbookBatchContext;
+}
+
+const STRICT_RULES = `教材批次生成的强制契约（优先于任何通用模板）：
+完整冻结任务书中的学段、年级、科目、学制、册次、版本、修订及真实目录始终适用；不得靠 outline 摘要替代。
+只生成学生可见的教学内容。版权/来源审核、待审核说明、草稿/发布状态、模型或工程质量报告只在后端，不得做课件页或教师台词。
+禁止 speechSynthesis、SpeechSynthesisUtterance、浏览器或系统语音 fallback，禁止 emoji 承载题意/答案。
+互动内所有有限状态指令、提示、反馈必须登记为 <script type="application/json" id="mira-narration-cues">{"schemaVersion":"mira.interactive.narration-cues.v1","cues":[{"id":"intro","text":"老师的完整短句"}]}</script>。
+只通过 window.miraNarrate('固定cue-id') 请求预录老师配音；不定义/覆写/别名 miraNarrate，不临时拼接朗读文本。不自己播放临时TTS。配音由后处理生成，未配音仍是私有草稿。
+一二年级指令和操作不依赖识字：游戏/模拟至少两个 data-mira-picture-choice="稳定ID" 容器，各含可区分的真实 SVG图形/图片/canvas；装饰背景、emoji、图A/B/C文字不算图片。3D探索可用实际canvas/SVG，仍有显式语音cue和大触点。
+低年级 quiz 每题须有有效 visual 及每个选项独立且不同的 optionVisuals；不能保证真多图就用图画互动，不生成quiz。禁止 short_answer。
+互动保留原生 window.addEventListener('message', ...) 协议，读取 event.data.type：SET_WIDGET_STATE 读取顶层 state，HIGHLIGHT_ELEMENT 读取顶层 target；不是 action/payload。有限状态与 cueId 绑定，点击、重置及外部SET_WIDGET_STATE共用更新路径。
+只允许 slide/interactive/quiz 场景；不得用独立 PBL 多轮流程绕过教材约束。`;
+
+export function withTextbookBatchContext(
+  aiCall: AICallFn,
+  context: TextbookBatchContext | null,
+  recordResponse?: (response: string) => Promise<void>,
+): AICallFn {
+  if (!context) return aiCall;
+  return async (system, user, images) => {
+    const response = await aiCall(
+      `${system}\n\n${STRICT_RULES}\n\n<exact-frozen-textbook-requirement>\n${context.requirement}\n</exact-frozen-textbook-requirement>`,
+      user,
+      images,
+    );
+    await recordResponse?.(response);
+    return response;
+  };
+}
+
+/** Private raw results survive parsing/quality rejection; never a classroom URL. */
+export async function createTextbookBatchRecorder(
+  context: TextbookBatchContext | null,
+  runId: string,
+  root = path.join(process.cwd(), 'data', 'textbook-batch-diagnostics'),
+) {
+  if (!context) return null;
+  check(/^[a-zA-Z0-9_-]+$/.test(runId), 'diagnostic_run_identity');
+  const directory = path.join(root, context.taskId, runId);
+  await fs.mkdir(path.dirname(directory), { recursive: true, mode: 0o700 });
+  await fs.mkdir(directory, { mode: 0o700 });
+  let sequence = 0;
+  const save = async (phase: string, value: unknown) => {
+    check(/^[a-zA-Z0-9_-]+$/.test(phase), 'diagnostic_phase');
+    const raw = JSON.stringify(value);
+    const receipt = {
+      schemaVersion: 'mira.textbook.private-generation-diagnostic.v1',
+      phase,
+      taskId: context.taskId,
+      runId,
+      createdAt: new Date().toISOString(),
+      valueSha256: createHash('sha256').update(raw).digest('hex'),
+      value,
+    };
+    const file = path.join(directory, `${String(++sequence).padStart(4, '0')}-${phase}.json`);
+    const handle = await fs.open(file, 'wx', 0o600);
+    try {
+      await handle.writeFile(JSON.stringify(receipt));
+      await handle.sync();
+    } finally {
+      await handle.close();
+    }
+  };
+  await save('input', context);
+  return { save };
+}
+
+export function bindTextbookTeacher(
+  agents: AgentInfo[],
+  context: TextbookBatchContext | null,
+): AgentInfo[] {
+  if (!context) return agents;
+  check(agents.filter((agent) => agent.role === 'teacher').length === 1, 'teacher_roster');
+  return agents.map((agent) => ({
+    ...agent,
+    id: `mira-textbook-${context.taskId.slice(0, 12)}-${agent.id}`,
+    ...(agent.role === 'teacher'
+      ? {
+          name: context.teacher.teacherName,
+          persona: `你是${context.teacher.teacherName}，本课${context.gradeCode}年级${context.subject}老师。遵循冻结教材任务书，用图片和简短口语指导。`,
+        }
+      : {}),
+  }));
+}
+
+function lowReading(context: TextbookBatchContext): boolean {
+  return context.gradeCode === 'primary_1' || context.gradeCode === 'primary_2';
+}
+function decoded(text: string): string {
+  return text
+    .replace(/&#(?:x([a-f\d]+)|(\d+));/gi, (all, hex, decimal) => {
+      const code = Number.parseInt(hex ?? decimal, hex ? 16 : 10);
+      return code <= 0x10ffff ? String.fromCodePoint(code) : all;
+    })
+    .replace(/\\u(?:\{([a-f\d]+)\}|([a-f\d]{4}))|\\x([a-f\d]{2})/gi, (all, long, short, byte) => {
+      const code = Number.parseInt(long ?? short ?? byte, 16);
+      return code <= 0x10ffff ? String.fromCodePoint(code) : all;
+    });
+}
+function assertStudentText(value: unknown): void {
+  if (typeof value === 'string') {
+    const text = decoded(value);
+    check(!/speechSynthesis|SpeechSynthesisUtterance/i.test(text), 'browser_tts');
+    check(!/[\p{Extended_Pictographic}\u{1f1e6}-\u{1f1ff}\u20e3]/u.test(text), 'emoji_picture');
+    check(
+      !/待审核|审核说明|版权状态|生成状态|私有草稿|发布门禁|后续制作|模型输出|质量审查|needs[_ -]?review|private draft|rights review|publicationAllowed|MIRA_TEXTBOOK_BATCH_V2|冻结任务书/i.test(
+        text,
+      ),
+      'student_engineering_copy',
+    );
+  } else if (Array.isArray(value)) value.forEach(assertStudentText);
+  else if (record(value)) Object.values(value).forEach(assertStudentText);
+}
+
+export function assertTextbookBatchOutline(
+  outline: SceneOutline,
+  context: TextbookBatchContext | null,
+): void {
+  if (!context) return;
+  check(['slide', 'interactive', 'quiz'].includes(outline.type), 'unsupported_scene_type');
+  assertStudentText([outline.title, outline.description, outline.keyPoints]);
+}
+
+function graphicSignature(element: Element): string {
+  const images = Array.from(element.querySelectorAll('img'));
+  const svg = Array.from(element.querySelectorAll('svg')).filter((node) =>
+    node.querySelector('path,circle,ellipse,rect,polygon,polyline,line,image,use'),
+  );
+  const canvas = Array.from(element.querySelectorAll('canvas'));
+  return [
+    ...images.map((node) => node.getAttribute('src') || ''),
+    ...svg.map((node) => node.innerHTML),
+    ...canvas.map((node) => node.outerHTML),
+  ]
+    .filter(Boolean)
+    .join('|');
+}
+
+function assertInteractive(
+  html: string,
+  widgetType: unknown,
+  context: TextbookBatchContext,
+  final: boolean,
+): void {
+  const { document } = parseHTML(html);
+  const manifests = document.querySelectorAll('script#mira-narration-cues');
+  check(
+    manifests.length === 1 && manifests[0].getAttribute('type') === 'application/json',
+    'narration_cues_missing',
+  );
+  let manifest: unknown;
+  try {
+    manifest = JSON.parse(manifests[0].textContent || '');
+  } catch {
+    throw new TextbookBatchContractError('narration_cues_json');
+  }
+  check(
+    record(manifest) &&
+      manifest.schemaVersion === 'mira.interactive.narration-cues.v1' &&
+      Array.isArray(manifest.cues) &&
+      manifest.cues.length > 0,
+    'narration_cues_schema',
+  );
+  const ids = new Set<string>();
+  for (const cue of manifest.cues) {
+    check(
+      record(cue) &&
+        nonempty(cue.id) &&
+        /^[a-zA-Z0-9_-]+$/.test(cue.id) &&
+        nonempty(cue.text) &&
+        !ids.has(cue.id),
+      'narration_cue_invalid',
+    );
+    ids.add(cue.id);
+  }
+  const code = [
+    ...Array.from(document.querySelectorAll('script'))
+      .filter((node) => node !== manifests[0])
+      .map((node) => node.textContent || ''),
+    ...Array.from(document.querySelectorAll('*')).flatMap((node) =>
+      Array.from(node.attributes)
+        .filter((attribute) => /^on/i.test(attribute.name))
+        .map((attribute) => attribute.value),
+    ),
+  ].join('\n');
+  const calls = Array.from(
+    code.matchAll(/window\s*\.\s*miraNarrate\s*\(\s*(['"])([a-zA-Z0-9_-]+)\1\s*\)/g),
+  );
+  check(
+    calls.length > 0 &&
+      (code.match(/miraNarrate/g) || []).length === calls.length &&
+      calls.every((call) => ids.has(call[2])),
+    'narration_call_must_be_fixed_cue',
+  );
+  check(
+    /addEventListener\s*\(\s*['"]message['"]/.test(code) &&
+      /SET_WIDGET_STATE/.test(code) &&
+      /HIGHLIGHT_ELEMENT/.test(code) &&
+      /\.data\b/.test(code) &&
+      /\btype\b/.test(code) &&
+      /\bstate\b/.test(code) &&
+      /\btarget\b/.test(code) &&
+      !/\.(?:action|payload)\b|\{[^{}]*(?:\baction\b|\bpayload\b)[^{}]*\}\s*=\s*\w+\.data/.test(
+        code,
+      ),
+    'widget_message_protocol',
+  );
+  if (lowReading(context)) {
+    if (widgetType === 'visualization3d')
+      check(document.querySelector('canvas,svg'), 'meaningful_picture_missing');
+    else {
+      const choices = Array.from(document.querySelectorAll('[data-mira-picture-choice]'));
+      const signatures = choices.map(graphicSignature);
+      check(
+        choices.length >= 2 &&
+          signatures.every(Boolean) &&
+          new Set(signatures).size === signatures.length,
+        'distinct_picture_choices_missing',
+      );
+    }
+  }
+  if (final)
+    for (const image of document.querySelectorAll('img')) {
+      const src = image.getAttribute('src');
+      check(src && !/^(?:gen_|image_|placeholder)|example\.com/i.test(src), 'media_unresolved');
+    }
+}
+
+function visualSignature(visual: unknown, final: boolean): string {
+  if (!record(visual)) return '';
+  if (visual.kind === 'image' && nonempty(visual.src) && nonempty(visual.alt)) {
+    if (final && /^(?:gen_|image_|placeholder)|example\.com/i.test(visual.src)) return '';
+    return visual.src;
+  }
+  if (visual.kind === 'people' && Array.isArray(visual.members) && visual.members.length) {
+    const images = visual.members.map((member) =>
+      visualSignature({ ...member, kind: 'image' }, final),
+    );
+    return images.every(Boolean) ? images.join('|') : '';
+  }
+  if (visual.kind === 'quantity' && Number.isInteger(visual.count) && Number(visual.count) >= 0)
+    return `quantity:${visual.count}`;
+  return '';
+}
+
+/** Structural rejection only: it never certifies semantic/age/engagement QA. */
+export function assertTextbookBatchContent(
+  type: string,
+  content: unknown,
+  context: TextbookBatchContext | null,
+  final = false,
+): void {
+  if (!context) return;
+  check(record(content), 'scene_content_missing');
+  assertStudentText(content);
+  if (type === 'interactive') {
+    check(nonempty(content.html), 'interactive_html_missing');
+    assertInteractive(content.html, content.widgetType, context, final);
+  }
+  if (type === 'quiz' && lowReading(context)) {
+    check(
+      Array.isArray(content.questions) && content.questions.length > 0,
+      'quiz_questions_missing',
+    );
+    for (const question of content.questions) {
+      check(
+        record(question) &&
+          question.type !== 'short_answer' &&
+          visualSignature(question.visual, final) &&
+          Array.isArray(question.options) &&
+          question.options.length >= 2 &&
+          record(question.optionVisuals),
+        'quiz_pictures_missing',
+      );
+      const optionVisuals = question.optionVisuals;
+      const signatures = question.options.map((option) =>
+        record(option) ? visualSignature(optionVisuals[String(option.value)], final) : '',
+      );
+      check(
+        signatures.every(Boolean) && new Set(signatures).size === signatures.length,
+        'quiz_distinct_option_pictures_missing',
+      );
+    }
+  }
+  if (final) {
+    const inspect = (value: unknown): void => {
+      if (Array.isArray(value)) value.forEach(inspect);
+      else if (record(value)) {
+        if (value.type === 'image' || value.type === 'video')
+          check(
+            nonempty(value.src) && !/^(?:gen_|image_|placeholder)|example\.com/i.test(value.src),
+            'media_unresolved',
+          );
+        Object.values(value).forEach(inspect);
+      }
+    };
+    inspect(content);
+  }
+}
+
+export function assertTextbookBatchActions(
+  actions: unknown,
+  context: TextbookBatchContext | null,
+): void {
+  if (!context) return;
+  assertStudentText(actions);
+  check(
+    Array.isArray(actions) &&
+      actions.some((action) => record(action) && action.type === 'speech' && nonempty(action.text)),
+    'teacher_speech_missing',
+  );
+}
