@@ -0,0 +1,51 @@
+import { resolveTextbookBatchContext } from '@/lib/server/mira-textbook-batch-generation';
+
+export function textbookRequirement(gradeCode = 'primary_1') {
+  const binding = {
+    editionId: 'pep_math_v1',
+    revisionId: 'rev-1',
+    gradeCode,
+    subject: 'math',
+    schoolSystem: 'six_three',
+    volume: 'upper',
+    unitId: null,
+    nodeId: null,
+  };
+  const context = {
+    schemaVersion: 'mira.textbook.batch-context.v2',
+    taskId: 'a'.repeat(64),
+    kind: 'book_exploration',
+    gradeCode,
+    subject: 'math',
+    binding,
+    directoryComplete: true,
+    teacher: {
+      teacherName: '小数老师',
+      avatarPath: '/avatars/teacher-2.png',
+      voiceId: 'Ethan',
+      teacherProfile: { id: 'math-teacher', version: 1, contentHash: 'b'.repeat(64) },
+      tts: { providerId: 'qwen-tts', modelId: 'qwen3-tts-flash', fallbackAllowed: false },
+    },
+  };
+  return `MIRA_TEXTBOOK_BATCH_V2\n${JSON.stringify(context)}\n目录与教材范围原样保留 SENTINEL-NOT-OUTLINE\n冻结任务书：\n${JSON.stringify({ kind: context.kind, binding, directoryComplete: true })}`;
+}
+
+export function textbookContext(gradeCode = 'primary_1') {
+  return resolveTextbookBatchContext(textbookRequirement(gradeCode))!;
+}
+
+export function textbookInteractive() {
+  return {
+    widgetType: 'game',
+    html: `<html><body>
+    <button data-mira-picture-choice="one" onclick="window.miraNarrate('again')"><svg><circle r="12"/></svg></button>
+    <button data-mira-picture-choice="two" onclick="window.miraNarrate('again')"><svg><circle r="12"/><circle r="8"/></svg></button>
+    <script type="application/json" id="mira-narration-cues">{"schemaVersion":"mira.interactive.narration-cues.v1","cues":[{"id":"intro","text":"请点两颗球。"},{"id":"again","text":"再数一数。"}]}</script>
+    <script>window.miraNarrate('intro');
+    window.addEventListener('message', function(event) {
+      const { type, state, target } = event.data;
+      if (type === 'SET_WIDGET_STATE') document.body.dataset.round = state.round;
+      if (type === 'HIGHLIGHT_ELEMENT') document.querySelector(target).focus();
+    });</script></body></html>`,
+  };
+}
