+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { describe, expect, it, vi } from 'vitest';
+import type { AICallFn } from '@openmaic/generation';
+import {
+  assertTextbookBatchActions,
+  assertTextbookBatchContent,
+  assertTextbookBatchOutline,
+  bindTextbookTeacher,
+  createTextbookBatchRecorder,
+  resolveTextbookBatchContext,
+  TextbookBatchContractError,
+  withTextbookBatchContext,
+} from '@/lib/server/mira-textbook-batch-generation';
+import {
+  textbookContext,
+  textbookInteractive,
+  textbookRequirement,
+} from '@/tests/fixtures/textbook-batch';
+
+describe('opt-in textbook batch generation contract', () => {
+  it('keeps ordinary requirements and AI calls unchanged', async () => {
+    expect(resolveTextbookBatchContext('Explain MIRA_TEXTBOOK_BATCH_V2 to adults')).toBeNull();
+    const call = vi.fn(async () => 'ordinary');
+    expect(withTextbookBatchContext(call, null)).toBe(call);
+    expect(() =>
+      assertTextbookBatchContent('interactive', { html: 'speechSynthesis' }, null),
+    ).not.toThrow();
+  });
+
+  it('rejects malformed markers and grade or revision drift before generation', () => {
+    const requirement = textbookRequirement();
+    expect(() => resolveTextbookBatchContext('MIRA_TEXTBOOK_BATCH_V2\n{}')).toThrow(
+      TextbookBatchContractError,
+    );
+    expect(() => resolveTextbookBatchContext(`intro\n${requirement}`)).toThrow('marker_invalid');
+    expect(() =>
+      resolveTextbookBatchContext(
+        requirement.replace('"gradeCode":"primary_1"', '"gradeCode":"primary_2"'),
+      ),
+    ).toThrow();
+    expect(() =>
+      resolveTextbookBatchContext(
+        requirement.replace('"revisionId":"rev-1"', '"revisionId":"other"'),
+      ),
+    ).toThrow('frozen_binding_mismatch');
+  });
+
+  it('forwards the full exact requirement and images while retaining raw output before parsing', async () => {
+    const context = textbookContext();
+    const call = vi.fn<AICallFn>(async () => '{invalid model JSON');
+    const save = vi.fn(async () => {});
+    const images = [{ id: 'scene', src: 'data:image/png;base64,abc' }];
+    expect(
+      await withTextbookBatchContext(call, context, save)('template', 'outline summary', images),
+    ).toBe('{invalid model JSON');
+    expect(call.mock.calls[0][0]).toContain(context.requirement);
+    expect(call.mock.calls[0][0]).toContain('mira-narration-cues');
+    expect(call.mock.calls[0][1]).toBe('outline summary');
+    expect(call.mock.calls[0][2]).toBe(images);
+    expect(save).toHaveBeenCalledWith('{invalid model JSON');
+  });
+
+  it('binds the frozen teacher without reusing or mutating default registry IDs', () => {
+    const agents = [
+      { id: 'default-1', role: 'teacher', name: 'AI老师' },
+      { id: 'default-2', role: 'assistant', name: '助教' },
+    ];
+    const bound = bindTextbookTeacher(agents, textbookContext());
+    expect(bound[0].name).toBe('小数老师');
+    expect(bound.every((agent) => agent.id.startsWith('mira-textbook-'))).toBe(true);
+    expect(agents[0].id).toBe('default-1');
+    expect(agents[0].name).toBe('AI老师');
+  });
+
+  it('accepts actual distinct SVG choices with a fixed prerecorded narration contract', () => {
+    expect(() =>
+      assertTextbookBatchContent('interactive', textbookInteractive(), textbookContext(), true),
+    ).not.toThrow();
+  });
+
+  it.each([
+    'speechSynthesis.speak(new SpeechSynthesisUtterance("好"))',
+    'window["speechSynthesis"]',
+    '\\u0073peechSynthesis',
+  ])('rejects browser speech even when a cue manifest exists: %s', (source) => {
+    const content = textbookInteractive();
+    content.html += `<script>${source}</script>`;
+    expect(() => assertTextbookBatchContent('interactive', content, textbookContext())).toThrow(
+      'browser_tts',
+    );
+  });
+
+  it.each(['🍎', '&#x1F34E;', '\\u{1F34E}'])(
+    'rejects emoji choices, including encoded glyphs: %s',
+    (emoji) => {
+      const content = textbookInteractive();
+      content.html = content.html.replace('<svg><circle r="12"/></svg>', emoji);
+      expect(() => assertTextbookBatchContent('interactive', content, textbookContext())).toThrow(
+        'emoji_picture',
+      );
+    },
+  );
+
+  it.each([
+    ["window.miraNarrate('intro')", "window.miraNarrate('missing')"],
+    ["window.miraNarrate('intro')", "window.miraNarrate('intro' + round)"],
+    ["window.miraNarrate('intro')", 'window.miraNarrate = function() {};'],
+    ['mira-narration-cues', 'other-cues'],
+  ])('rejects missing, dynamic or overridden narration: %s', (from, to) => {
+    const content = textbookInteractive();
+    content.html = content.html.replace(from, to);
+    expect(() => assertTextbookBatchContent('interactive', content, textbookContext())).toThrow(
+      /narration_/,
+    );
+  });
+
+  it('rejects action/payload messages that the real ActionEngine never sends', () => {
+    const content = textbookInteractive();
+    content.html = content.html
+      .replace('type, state, target', 'action, payload')
+      .replace('event.data', 'event.data.payload');
+    expect(() => assertTextbookBatchContent('interactive', content, textbookContext())).toThrow(
+      'widget_message_protocol',
+    );
+  });
+
+  it('rejects text-only choices and duplicate pictures despite an illustrated background', () => {
+    const content = textbookInteractive();
+    content.html = content.html.replace('<svg><circle r="12"/></svg>', '图A');
+    expect(() => assertTextbookBatchContent('interactive', content, textbookContext())).toThrow(
+      'distinct_picture_choices_missing',
+    );
+    content.html = textbookInteractive().html.replace(
+      '<circle r="12"/><circle r="8"/>',
+      '<circle r="12"/>',
+    );
+    expect(() => assertTextbookBatchContent('interactive', content, textbookContext())).toThrow(
+      'distinct_picture_choices_missing',
+    );
+  });
+
+  it('requires real distinct quiz visuals, not 图A/B labels or short answers', () => {
+    const question = {
+      type: 'single',
+      question: '点两颗球',
+      options: [
+        { value: 'A', label: '图A' },
+        { value: 'B', label: '图B' },
+      ],
+      visual: { kind: 'quantity', count: 2 },
+      optionVisuals: { A: { kind: 'quantity', count: 1 }, B: { kind: 'quantity', count: 2 } },
+    };
+    expect(() =>
+      assertTextbookBatchContent('quiz', { questions: [question] }, textbookContext(), true),
+    ).not.toThrow();
+    expect(() =>
+      assertTextbookBatchContent(
+        'quiz',
+        { questions: [{ ...question, optionVisuals: undefined }] },
+        textbookContext(),
+      ),
+    ).toThrow('quiz_pictures_missing');
+    expect(() =>
+      assertTextbookBatchContent(
+        'quiz',
+        { questions: [{ ...question, type: 'short_answer' }] },
+        textbookContext(),
+      ),
+    ).toThrow('quiz_pictures_missing');
+  });
+
+  it('rejects engineering review copy in slides and teacher speech, but preserves ordinary courses', () => {
+    expect(() =>
+      assertTextbookBatchContent(
+        'slide',
+        { elements: [{ content: '待审核说明与后续制作' }] },
+        textbookContext(),
+      ),
+    ).toThrow('student_engineering_copy');
+    expect(() =>
+      assertTextbookBatchActions([{ type: 'speech', text: '版权状态尚未审核' }], textbookContext()),
+    ).toThrow('student_engineering_copy');
+    expect(() => assertTextbookBatchActions([], textbookContext())).toThrow(
+      'teacher_speech_missing',
+    );
+  });
+
+  it('rejects unsupported PBL routes and unresolved final media without retryable errors', () => {
+    expect(() => assertTextbookBatchOutline({ type: 'pbl' } as never, textbookContext())).toThrow(
+      'unsupported_scene_type',
+    );
+    expect(() =>
+      assertTextbookBatchContent(
+        'slide',
+        { elements: [{ type: 'image', src: 'gen_img_1' }] },
+        textbookContext(),
+        true,
+      ),
+    ).toThrow('media_unresolved');
+    expect(new TextbookBatchContractError('invalid').isRetryable).toBe(false);
+  });
+
+  it('durably retains private raw failures with content hashes, outside classroom storage', async () => {
+    const root = await fs.mkdtemp(path.join(os.tmpdir(), 'mira-batch-diagnostic-'));
+    try {
+      const context = textbookContext();
+      const recorder = await createTextbookBatchRecorder(context, 'run-1', root);
+      await recorder!.save('scene-1-content-raw', { rawResponse: '{bad JSON and speechSynthesis' });
+      const dir = path.join(root, context.taskId, 'run-1');
+      const files = await fs.readdir(dir);
+      const raw = JSON.parse(
+        await fs.readFile(
+          path.join(dir, files.find((file) => file.includes('content-raw'))!),
+          'utf8',
+        ),
+      );
+      expect(raw.value.rawResponse).toBe('{bad JSON and speechSynthesis');
+      expect(raw.valueSha256).toBe(
+        createHash('sha256').update(JSON.stringify(raw.value)).digest('hex'),
+      );
+      expect((await fs.stat(path.join(dir, files[0]))).mode & 0o777).toBe(0o600);
+      await expect(createTextbookBatchRecorder(context, 'run-1', root)).rejects.toMatchObject({
+        code: 'EEXIST',
+      });
+    } finally {
+      await fs.rm(root, { recursive: true, force: true });
+    }
+  });
+});
