{
  "lines": [
    {
      "id": "arcade-praise",
      "text": "做到了！看看你刚才完成的挑战。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-falling-tiles-goal1",
      "text": "用左右键挪方块。挨着的两个数要凑成十，按向下的按钮放下。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-falling-tiles-goal2",
      "text": "方块落得快了。把两个能凑十的数挨在一起。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-falling-tiles-goal3",
      "text": "挑战关！先看浅色的落点，再把能凑十的方块落下。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-falling-tiles-hint",
      "text": "同一行挨在一起才算。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-falling-tiles-hint2",
      "text": "先看看底下哪个数能和落下的数凑成十。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-bubble-maze-goal1",
      "text": "用箭头开车。顺着一、二、三找星，再开到旗子。遇到浅色墙可以喷泡泡。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-bubble-maze-goal2",
      "text": "这次从五倒着数到二，再开到旗子。慢慢绕开巡游的小车。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-bubble-maze-goal3",
      "text": "挑战关！两个两个数，从二找起，找到八，再开到旗子。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-bubble-maze-hint",
      "text": "听听刚才的顺序，想一想下一颗星。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-bubble-maze-hint2",
      "text": "看看发亮的星，那就是下一站。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-platform-hop-goal1",
      "text": "按右箭头往前跑，按跳跃按钮跳。按一、二、三、四的顺序落到台上。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-platform-hop-goal2",
      "text": "从六倒着数到二。找好下一站再跳。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-platform-hop-goal3",
      "text": "挑战关！两个两个数，从二跳到十。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-platform-hop-hint",
      "text": "兔子会回到刚才的台上。再找一找下一块数字台。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-platform-hop-hint2",
      "text": "先看亮起来的平台。跑到边上，再按跳跃。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shadow-stage-goal1",
      "text": "按左右挪灯，按上下调远近。把影子对准虚线，再按圆形按钮定格。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shadow-stage-goal2",
      "text": "这次对准方形和三角形。灯靠近纸片时，看看影子怎么变。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shadow-stage-goal3",
      "text": "挑战关！把三种影子的位置和大小都对准，再定格。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shadow-stage-hint",
      "text": "对一对影子和虚线，看看哪里还差一点。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shadow-stage-hint2",
      "text": "看下面的亮框，把灯慢慢移过去。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-wind-courier-goal1",
      "text": "用上下箭头飞高或飞低。第一封送到旗子上面，第二封送到下面。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-wind-courier-goal2",
      "text": "每次先看小旗在哪儿，再看旁边的箭头指向哪一层。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-wind-courier-goal3",
      "text": "挑战关！向上的飞上面，向下的飞下面，横箭头飞同一层。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-wind-courier-hint",
      "text": "先找到小旗，再想它的上面或下面。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-wind-courier-hint2",
      "text": "可以按暂停图案放慢。飞进发亮的站台就到了。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-magnet-marbles-goal1",
      "text": "用左右箭头瞄准，再按发射。弹珠和撞到的数要凑成十。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-magnet-marbles-goal2",
      "text": "靶子开始移动了。弹珠飞出去后，左右还能微调。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-magnet-marbles-goal3",
      "text": "挑战关！先找能凑十的那颗，再边飞边瞄准。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-magnet-marbles-hint",
      "text": "先找两个能凑成十的数。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-magnet-marbles-hint2",
      "text": "看发亮的目标，发射以后也能用箭头拐弯。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-firefly-swing-goal1",
      "text": "先找和上面图形一样的灯。等虚线指向那盏灯，按橙色按钮松手。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-firefly-swing-goal2",
      "text": "摆荡变快了。左右按钮可以换方向，找准时机再飞。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-firefly-swing-goal3",
      "text": "挑战关！每到一站都看看上面，找下一盏图形相同的灯。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-firefly-swing-hint",
      "text": "先别急着松手。看看目标是什么形状。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-firefly-swing-hint2",
      "text": "等虚线朝向亮灯，再按橙色按钮。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shutter-scout-goal1",
      "text": "用箭头挪取景框。等蝴蝶翅膀和上面一样，再按圆形快门。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shutter-scout-goal2",
      "text": "把蝴蝶留在框里。看翅膀是张开还是合拢，再拍。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shutter-scout-goal3",
      "text": "挑战关！追上飞得更快的蝴蝶，拍下四个指定姿势。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shutter-scout-hint",
      "text": "先跟着蝴蝶移动取景框。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shutter-scout-hint2",
      "text": "框已经放宽了。等翅膀变得和上面一样再拍。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-sorting-depot-goal1",
      "text": "用箭头绕到物件背后再推。木头和木头放一起，金属和金属放一起。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-sorting-depot-goal2",
      "text": "路上有墙。先想从哪边推，再看看托盘里是哪种材料。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-sorting-depot-goal3",
      "text": "挑战关！四件物品都要到同类的托盘，先给别的物品留出路。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-sorting-depot-hint2",
      "text": "车能推不能拉。按回转箭头退一步，再从另一个方向推。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-pinyin-slide-goal1",
      "text": "按左右箭头，让两个字片滑到一起，拼出八的第一声。",
      "voice": "Serena"
    },
    {
      "id": "arcade-pinyin-slide-goal2",
      "text": "这一关收集八、山坡的坡和小马的马。挡板会截住字片，换个方向试试。",
      "voice": "Serena"
    },
    {
      "id": "arcade-pinyin-slide-goal3",
      "text": "挑战关。多收一个福字的读音。先让一对字片滑到同一条轨道。",
      "voice": "Serena"
    },
    {
      "id": "arcade-pinyin-slide-hint",
      "text": "看看收藏格还少哪个音节，再换个方向试试。",
      "voice": "Serena"
    },
    {
      "id": "arcade-pinyin-slide-hint2",
      "text": "可以跟着亮箭头滑一步。按回转箭头，也可以从头来。",
      "voice": "Serena"
    },
    {
      "id": "arcade-pinyin-slide-praise",
      "text": "拼好的音节都进了收藏格。真棒！",
      "voice": "Serena"
    },
    {
      "id": "arcade-listen-delivery-first",
      "text": "按箭头走，点包裹按钮拿放。Pick up the apple. Take it to the dog.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-banana-cat",
      "text": "Pick up the banana. Take it to the cat.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-apple-rabbit",
      "text": "Pick up the apple. Take it to the rabbit.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-carrot-dog",
      "text": "Pick up the carrot. Take it to the dog.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-banana-rabbit",
      "text": "Pick up the banana. Take it to the rabbit.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-apple-cat",
      "text": "Pick up the apple. Take it to the cat.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-dog",
      "text": "Now take it to the dog.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-cat",
      "text": "Now take it to the cat.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-rabbit",
      "text": "Now take it to the rabbit.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-hint",
      "text": "Take your time. Tap the ear to hear it again.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-hint2",
      "text": "走慢一点，看看亮起来的地方。需要的话，再听一次。",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-listen-delivery-praise",
      "text": "Good job! You delivered the parcel.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-compare-snake-first",
      "text": "按箭头让小蛇转弯。数一数右边的点，找点更多的一块。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-more",
      "text": "再数一数右边的新数量，这一口要吃更多的一组。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-less",
      "text": "数一数右边有多少点，这一口要吃更少的一组。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-same",
      "text": "找点一样多的一组。一颗对一颗，刚好能配齐。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-challenge",
      "text": "挑战关。每一口的要求会变，先听清再转弯。第一口找更多。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-hint",
      "text": "看看右边的参照卡，再想一想这一口要找什么。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-hint2",
      "text": "小蛇慢下来了。看看哪组亮起来，也可以点耳朵重听。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-praise",
      "text": "做到了！小蛇又长了一节。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-shape-first",
      "text": "按箭头让小蛇转弯。右边是什么图形，就去找同一种。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-shape-square",
      "text": "找四条边一样长的正方形。转个方向，还是正方形。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-compare-snake-shape-rotate",
      "text": "仔细看边和角。图形转了方向，它还是同一种图形。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-orchard-first",
      "text": "按住箭头让小车接果子。点换篮，把两串果子分进两个篮。每个空格放一个。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-orchard-second",
      "text": "这关有三串。看看篮子还空几格，想想哪几串放在一起刚刚好。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-orchard-challenge",
      "text": "挑战关。果子落得更快。先数篮子的空格，看看后面还有哪些果串。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-orchard-hint",
      "text": "果子会再落下来。看清落点，再数亮着的篮子还空几格。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-orchard-hint2",
      "text": "果子落慢了。先看两篮空格，一整串要放进同一个篮。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-orchard-praise",
      "text": "两个篮子都刚刚好！每个果子都有自己的空格。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shape-bridge-first",
      "text": "按左右箭头，把木块移到一样形状的空位上方，再点落下。补好两块，小兔就能过桥。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shape-bridge-second",
      "text": "这关有的木块转了方向。按向上的转箭头，转到正好盖住空格，再放下。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shape-bridge-challenge",
      "text": "挑战关。木块落得更快。先看空位拐弯的方向，再转一转，连续补好三块桥面。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shape-bridge-hint",
      "text": "这块木板还会回来。看看它能盖住哪几个空格。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shape-bridge-hint2",
      "text": "木块落慢了。先对好拐角，再移到亮起的空位。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-shape-bridge-praise",
      "text": "桥面拼好了！每一块都把空位盖得刚刚好。",
      "voice": "Ethan"
    },
    {
      "id": "arcade-word-bubbles-first",
      "text": "听老师说的英语。按左右箭头让小艇对准图，按空格或泡泡按钮。Apple.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-word-bubbles-banana",
      "text": "Banana.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-word-bubbles-carrot",
      "text": "Carrot.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-word-bubbles-dog",
      "text": "Dog.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-word-bubbles-cat",
      "text": "Cat.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-word-bubbles-rabbit",
      "text": "Rabbit.",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-word-bubbles-hint",
      "text": "再听一下，再把小艇开到那张图的下面。",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-word-bubbles-hint2",
      "text": "图漂慢了。看看亮起来的图，对准了再发泡泡。",
      "voice": "Jennifer"
    },
    {
      "id": "arcade-word-bubbles-praise",
      "text": "Well done! 你听清了，泡泡也送到了。",
      "voice": "Jennifer"
    }
  ],
