  "quiz": [
    {
      "id": "choose-a-comb",
      "skill": "tools-in-context",
      "prompt": "演出前小演员头发乱了，想把头发梳顺。该从托盘拿哪件？",
      "answer": "便携梳子",
      "position": 2,
      "rationale": "梳子有一排梳齿，用来梳头。"
    },
    {
      "id": "radical-clue",
      "skill": "radical-evidence",
      "prompt": "你听到一个带鸟字边的动物词。哪组画面最能给这个词的意思提供线索？",
      "answer": "鹅和鹊",
      "position": 1,
      "rationale": "鸟字边常给人想到鸟一类的线索。这组是鸟的图。"
    },
    {
      "id": "connected-words",
      "skill": "connected-sentences",
      "prompt": "听，雨停后，姐姐在湿石路上跑，听见弟弟的笑声。哪组图把这件事讲完整？",
      "answer": "湿路跑和笑",
      "position": 3,
      "rationale": "两幅都在雨后湿石路上，前面姐姐跑，后面弟弟笑，是相连的一件事。"
    },
    {
      "id": "outside-ink",
      "skill": "outside-before-inside",
      "prompt": "给房字做写字卡。只留下先写的外面四笔，应选哪张图？",
      "answer": "先画户",
      "position": 2,
      "rationale": "房先写左上包围的户。外面四笔写好后，才接方。"
    },
    {
      "id": "meaning-of-saying",
      "skill": "meaning-of-saying",
      "prompt": "小云不懂怎么折船，去问大人，再跟着练。哪组新画和她的做法最像？",
      "answer": "请教练绳结",
      "position": 1,
      "rationale": "不懂就请教，不会就学习。问清如何系结后再跟着试，是同一个办法。"
    },
    {
      "id": "put-the-picture-after",
      "skill": "story-pictures",
      "prompt": "小鹿把果篮放在门边，再抬手敲门。放下果篮那张之后接哪张？",
      "answer": "放篮敲门",
      "position": 3,
      "rationale": "听到放下果篮后再敲门。篮子在地上，小鹿抬手敲门。"
    },
    {
      "id": "what-made-it-drop",
      "skill": "fox-cause",
      "prompt": "小狗嘴里叼着纸叶。哪组小画能说清它叫的时候叶子为什么掉下来？",
      "answer": "张嘴后掉",
      "position": 2,
      "rationale": "叫时嘴张开，嘴没叼住纸叶，所以纸叶掉下来。"
    }
  ],
