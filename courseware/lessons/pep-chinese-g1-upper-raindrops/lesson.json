  "scenes": [
    {
      "key": "cloud-radio",
      "type": "slide",
      "title": "云间来了两位客人",
      "template": "picture-points",
      "data": {
        "title": "云间来了两位客人",
        "picture": "cloud-radio",
        "points": [
          "雨点儿 · 儿化",
          "两位客人",
          "各找落脚处"
        ]
      },
      "script": [
        {
          "say": "云间广播站刚开门，是谁轻轻敲了桌子？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "这节课叫雨点儿。把点和儿连起来读。"
        },
        {
          "say": "先听我读，雨点儿。你也把点和儿连成一拍。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "披围巾的是大雨点，戴叶帽的是小雨点。"
        },
        {
          "say": "一大一小从云下落，在天和地之间的半空聊了几句。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "它们看见了不同的地方，想落在哪里呢？"
        },
        {
          "say": "先看清两位客人，再听它们的声音。"
        }
      ]
    },
    {
      "key": "words-above",
      "type": "slide",
      "title": "跟着雨点认上半页字",
      "template": "picture-points",
      "data": {
        "title": "跟着雨点认上半页字",
        "picture": "words-above",
        "points": [
          "点 · 四点底",
          "数 · 第三声或第四声",
          "云彩 · 半空",
          "地方 · 去哪里"
        ]
      },
      "script": [
        {
          "say": "小雨点留下几张字卡，哪张藏着四个小点？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "雨点的点，下边有四点，叫四点底。"
        },
        {
          "say": "下边四个小点排一排，我就找到了雨点的点。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "数的右边有撇、横、撇和捺。数灯笼时读第三声。"
        },
        {
          "say": "报出灯笼的数目，数是第四声，表示有多少。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "云彩的彩右边有三撇。半空的半，一竖穿过两横。"
        },
        {
          "say": "空上面是穴字头，屋顶下有两笔。半空的空读第一声。"
        },
        {
          "spotlight": "point-4"
        },
        {
          "say": "地方的方，上头一点，下有横折钩。地方就是哪儿。"
        },
        {
          "say": "找正在一盏一盏数灯笼的孩子。"
        }
      ]
    },
    {
      "key": "words-in-talk",
      "type": "slide",
      "title": "听一听问答里的字",
      "template": "picture-points",
      "data": {
        "title": "听一听问答里的字",
        "picture": "words-in-talk",
        "points": [
          "问 · 回 · 答",
          "等了很久",
          "更 · 比原先还……",
          "长 · 两种读音"
        ]
      },
      "script": [
        {
          "say": "广播响了两次。你能听出谁先开口吗？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "门里有个口，我找到问。开口请别人告诉自己。"
        },
        {
          "say": "大框包小口的是回。把知道的说出来，叫回答。"
        },
        {
          "say": "答上面是竹字头，下面是合。回答的答读第二声。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "久只有三笔，末笔是捺。等得久，就是等了很长时间。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "中间像日、长撇穿过的是更。比原先还亮，叫更亮。"
        },
        {
          "spotlight": "point-4"
        },
        {
          "say": "长字有竖提和捺。小叶长出来，这里读第三声。"
        },
        {
          "say": "比两条丝带，一条长、一条短。长短的长读第二声。"
        },
        {
          "say": "找土里刚长出一片小叶的图。"
        },
        {
          "say": "找摊开手、正在提问的孩子。"
        },
        {
          "say": "找指向灯笼、正在回答的孩子。"
        },
        {
          "say": "慢一点，重听后再找画面里的动作。"
        },
        {
          "say": "图卡慢下来了，等小艇对着亮图。"
        }
      ]
    },
    {
      "key": "listen-to-pauses",
      "type": "slide",
      "title": "给声音留个小空隙",
      "template": "picture-points",
      "data": {
        "title": "给声音留个小空隙",
        "picture": "pause-example",
        "points": [
          "不少 · 第四声",
          "不看 · 第二声",
          "意思一组，读在一起"
        ]
      },
      "script": [
        {
          "say": "小录音员读着读着，声音跑得比小车还快。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "先听不少。不后面的少是第三声，不仍读第四声。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "再听不看。看是第四声，前面的不就读第二声。"
        },
        {
          "say": "再对着听，不少，不看。把两个字连起来读。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "一口气说完小车过了石桥，这里轻轻停一下。"
        },
        {
          "say": "听我读。小车过了石桥，慢慢开进树林。"
        },
        {
          "say": "过桥和开进树林，各是一小组。停一下，画面更清楚。"
        },
        {
          "say": "跟我读一遍。小车过了石桥，慢慢开进树林。"
        }
      ]
    },
