  "goals": [
    "能指认几种常见的纸，按观察方法描述这几张样纸的薄厚、皱纹、边缘等，知道纸里有细小纤维。",
    "能用同样大小、同一水线和同一时刻比较纸条湿痕，用等宽纸条在同样条件下比较是否容易拉断，按实际结果记录。",
    "能根据纸在这次比较中表现出的特点解释用途，例如选可承受拉扯的包装纸或适合擦少量水的纸。",
    "知道古代造纸术及蔡伦改进造纸，能按顺序说出废旧纸再做一张纸的四个步骤。"
  ],
  "goalSources": [
    "印45–46、教案2",
    "印47、教案2–3和任务单2",
    "印47、课件14",
    "印48–49、教案1及3"
  ],
  "scenario": "原创松风校园纸工坊。给手作展找合适的纸，先观察、按条件比较，再用干净旧纸做新的手工纸。",
  "pageSequence": [
