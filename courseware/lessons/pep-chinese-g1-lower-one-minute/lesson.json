    {
      "key": "if-another-minute",
      "type": "slide",
      "title": "要是早点，可能怎样",
      "template": "picture-points",
      "data": {
        "title": "要是早点，可能怎样",
        "picture": "if-earlier-board",
        "points": [
          "实际已经发生",
          "要是 · 就",
          "继续接着想",
          "试说一句"
        ]
      },
