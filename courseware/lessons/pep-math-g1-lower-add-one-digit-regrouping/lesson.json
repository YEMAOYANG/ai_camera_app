  "scenes": [
    {
      "key": "unpack-the-ones",
      "type": "slide",
      "title": "先认出两套和两堆",
      "template": "two-columns",
      "data": {
        "title": "先认出两套和两堆",
        "left": {
          "heading": "阅读角来收书签",
          "body": "看旧书签与新书签。"
        },
        "left_picture": "lesson-27-plus-6",
        "right": {
          "heading": "整套和散张分开",
          "body": "原有两套，另有七张和六张。"
        },
        "right_picture": "lesson-27-split"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "社区阅读角要数书签。原有二十七张，又送来六张。"
        },
        {
          "say": "一套有十张。猜一猜，这次会不会多一套？"
        },
        {
          "say": "先找已经装好的套。旧套不用拆开，也不会丢掉。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "二十七里有两个十和七个一。两套就是二十张。"
        },
        {
          "say": "右边新来的六张，也是一个一个数的。"
        },
        {
          "say": "七个一和六个一用的是同一种单位，可以先合起来。"
        },
        {
          "say": "把两套留在旁边，接下来只看两堆散张。"
        }
      ]
    },
    {
      "key": "fill-one-ten-frame",
      "type": "slide",
      "title": "十格排满，换成一套",
      "template": "two-columns",
      "data": {
        "title": "十格排满，换成一套",
        "left": {
          "heading": "先合两个散堆",
          "body": "两堆合起来是十三张。"
        },
        "left_picture": "lesson-13-loose",
        "right": {
          "heading": "把其中十张换成一套",
          "body": "这两部分还是十三张。"
        },
        "right_picture": "lesson-13-exchange"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "七张加六张，是十三张。能把十格放满吗？"
        },
        {
          "say": "按格放，一格只放一张。先装七张，再添新书签。"
        },
        {
          "say": "添进三张就刚好装满。新来的还剩三张。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "把框里十张一起套好。这一套正好代表一个十。"
        },
        {
          "say": "框外三张没有套起来，仍然是三个一。"
        },
        {
          "say": "一套和三张还是十三张。刚才只换了装法。"
        },
        {
          "say": "剩下的三张要留着，换出来的这一套也要留着。"
        }
      ]
    },
    {
      "key": "put-back-original-tens",
      "type": "slide",
      "title": "原来的两套也要数上",
      "template": "two-columns",
      "data": {
        "title": "原来的两套也要数上",
        "left": {
          "heading": "新套加入原来的套",
          "body": "两套加一套，再加三张。"
        },
        "left_picture": "lesson-33-finished",
        "right": {
          "heading": "两步口算一起记",
          "body": "先合个位，再与原整十合。"
        },
        "right_picture": "lesson-33-equations"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "刚才原来两套留在旁边。现在可以把它们移回来。"
        },
        {
          "say": "原来两套，新装一套，一共三套。"
        },
        {
          "say": "三套是三十张，再添三张，合起来三十三张。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "记口算时，先写七加六等于十三。"
        },
        {
          "say": "再写二十加十三等于三十三。十三里面已经有新十。"
        },
        {
          "say": "两个数里同是零散张的先合，原有整套最后接回来。"
        },
        {
          "say": "现在答阅读角的问题，一共三十三张。"
        },
        {
          "say": "看两堆散张。把它们配成十一张。"
        },
        {
          "say": "这次每对两堆合起来是十三张。"
        },
        {
          "say": "这次配成十六张。配好一对，再看下一堆。"
        },
        {
          "say": "先数落下这一堆，再数下面挨着的一堆。"
        },
        {
          "say": "两堆加一加。只在总数对时让两块挨着。"
        },
        {
          "say": "配对合好，刚好换出一套，余张保留。"
        }
      ]
    },
    {
      "key": "compare-the-frames",
      "type": "slide",
      "title": "什么时候才能换一套",
      "template": "two-columns",
      "data": {
        "title": "什么时候才能换一套",
        "left": {
          "heading": "两堆没够十",
          "body": "合了六张，十格还没满。"
        },
        "left_picture": "lesson-52-plus-4",
        "right": {
          "heading": "两堆够十",
          "body": "合了十一张，换一套余一张。"
        },
        "right_picture": "lesson-52-plus-9"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "两盒原来都有五十二张。猜哪盒会多装一套？"
        },
        {
          "say": "第一盒添四张。原来散的两张和四张合成六张。"
        },
        {
          "say": "六张不到十，只能仍放散张。原来五套不变。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "第二盒添九张。原来两张和九张合成十一张。"
        },
        {
          "say": "十格够放满一套，框外余一张。现在有六套。"
        },
        {
          "say": "两盒都先合个位。能否多一套，要看散件够不够十。"
        },
        {
          "say": "接下来先练这一小步，原有整套不进落块盘。"
        }
      ]
    },
    {
      "key": "pair-loose-bookmarks",
      "type": "interactive",
      "title": "给落下的散书签找搭档",
      "widgetType": "courseware_game",
      "page": "pair-loose-bookmarks",
      "startImage": "bookmark-tiles-start",
      "script": [
        {
          "setState": {
            "demo": true,
            "level": 1,
            "pause": true
          }
        },
        {
          "highlight": "#loose-target-total"
        },
        {
          "say": "这关只算两堆散张。一对要合成十一张。"
        },
        {
          "highlight": "#game-player"
        },
        {
          "say": "落下来的是新来的六张。先不碰整套。"
        },
        {
          "highlight": "#first-old-loose"
        },
        {
          "say": "底下左边是原来的五张。五加六，正好十一张。"
        },
        {
          "highlight": "#drop-bookmark-tile"
        },
        {
          "say": "老师把落块向左挪一格，和那五张挨着，再落下。"
        },
        {
          "setState": {
            "pause": false
          }
        },
        {
          "highlight": "#tile-result"
        },
        {
          "say": "这对真的配好了。右边满十装一套，另有一张。"
        },
        {
          "say": "现在你从头来。先数两堆，再移和落。"
        },
        {
          "setState": {
            "demo": false,
            "level": 1,
            "pause": false
          }
        }
      ],
      "gameAudio": {
        "tiles-eleven": "put-back-original-tens-9",
        "tiles-thirteen": "put-back-original-tens-10",
        "tiles-sixteen": "put-back-original-tens-11",
        "tiles-hint": "put-back-original-tens-12",
        "tiles-help": "put-back-original-tens-13",
        "tiles-praise": "put-back-original-tens-14"
      }
    },
    {
      "key": "just-one-full-tray",
      "type": "slide",
      "title": "恰好满十，个位留下什么",
      "template": "two-columns",
      "data": {
        "title": "恰好满十，个位留下什么",
        "left": {
          "heading": "七套之外只合散张",
          "body": "两张加八张，十格正好满。"
        },
        "left_picture": "lesson-72-plus-8",
        "right": {
          "heading": "八套，零张散件",
          "body": "80 的 0 记没有散张。"
        },
        "right_picture": "lesson-80-finished"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "阅读角原有七十二张，又送来八张。先算哪里？"
        },
        {
          "say": "原来七套先放好。只拿两张散件和新来的八张。"
        },
        {
          "say": "二加八等于十。每一格都满了，框外有没有余张？"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "框外一张也不剩。新装一套，合上原来的七套。"
        },
        {
          "say": "七十加十等于八十。个位没有散张，用零占位。"
        },
        {
          "say": "不是还剩十张散的。那十张已经换成一套了。"
        },
        {
          "say": "十位多了一套，书签张数没有凭空多出来。"
        }
      ]
    },
    {
      "key": "read-the-other-way",
      "type": "slide",
      "title": "一位数放左边也先合散张",
      "template": "two-columns",
      "data": {
        "title": "一位数放左边也先合散张",
        "left": {
          "heading": "先看见左边来的八张",
          "body": "八张和右边的六张同是散件。"
        },
        "left_picture": "lesson-8-plus-56",
        "right": {
          "heading": "原有整套最后合回来",
          "body": "8＋6＝14，50＋14＝64。"
        },
        "right_picture": "lesson-64-finished"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "这张来货单把八写在前面。原有的是五十六张。"
        },
        {
          "say": "看看右边，里面五套整十、六张散件。"
        },
        {
          "say": "左边八张全是散的，能和右边哪一堆合？"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "八个一和六个一合成十四。够装一套，余四张。"
        },
        {
          "say": "原来五套添一套，一共六套，再添四张是六十四。"
        },
        {
          "say": "换个顺序写，哪堆是散张没有变。"
