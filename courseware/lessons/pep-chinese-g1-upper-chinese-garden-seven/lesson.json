  "scenes": [
    {
      "key": "open",
      "type": "slide",
      "title": "借书卡该写谁的名字",
      "template": "picture-points",
      "data": {
        "title": "借书卡该写谁的名字",
        "picture": "radio-open",
        "points": [
          "先看是谁在叫",
          "再看两个人的关系",
          "故事会要开始啦"
        ]
      },
      "script": [
        {
          "say": "社区小电台准备讲故事，门口来了好几位家人。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "小主持人要写借书卡，一时不知道怎么称呼。"
        },
        {
          "say": "她叫来的人是爸爸，奶奶叫这个人是儿子。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "人还是那个人，站在谁的位置上，说法会不同。"
        },
        {
          "say": "先想谁在叫谁，再顺着家人的关系找称呼。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "今天给家人认一认字，也来试试小电台的声音。"
        }
      ]
    },
    {
      "key": "family-words",
      "type": "slide",
      "title": "沿着关系叫家人",
      "template": "picture-points",
      "data": {
        "title": "沿着关系叫家人",
        "picture": "family-gathering",
        "points": [
          "两边的长辈",
          "爸爸妈妈的兄弟姐妹",
          "哥哥姐姐与弟弟妹妹",
          "爷、奶、叔、姐、妹 · 后字轻读"
        ]
      },
      "script": [
        {
          "say": "如果爸爸领来他的爸爸，你会怎么叫他？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "爸爸的爸爸叫爷爷，爸爸的妈妈叫奶奶。"
        },
        {
          "say": "妈妈的爸爸叫姥爷，妈妈的妈妈叫姥姥。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "爸爸的弟弟是叔叔，爸爸的姐妹是姑姑。"
        },
        {
          "say": "妈妈的兄弟是舅舅，妈妈的姐妹是姨妈。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "同家里，比我大的兄弟姐妹叫哥哥、姐姐。"
        },
        {
          "say": "比我小的兄弟姐妹叫弟弟、妹妹。"
        },
        {
          "spotlight": "point-4"
        },
        {
          "say": "爷读第二声，奶第三声，叔是第一声。"
        },
        {
          "say": "姐是第三声，妹是第四声。连成称呼再听。"
        },
        {
          "say": "爷爷、奶奶、叔叔、姐姐、妹妹，后一个字轻读。"
        },
        {
          "say": "看看这张家人图，再想想爸爸的爸爸怎么叫。"
        }
      ]
    },
    {
      "key": "meaning-clues",
      "type": "slide",
      "title": "字里有线索",
      "template": "picture-points",
      "data": {
        "title": "字里有线索",
        "picture": "time-picture",
        "points": [
          "妈　奶　姐　妹",
          "明　晚　昨　春",
          "把字放回词语"
        ]
      },
      "script": [
        {
          "say": "小主持人看到借书卡，几张字卡长得有点像。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "妈、奶、姐、妹，左边都带着女字旁。"
        },
        {
          "say": "女作左偏旁时，给右部留地方，末笔写成提。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "明、晚、昨、春这几个字里都能找到日。"
        },
        {
          "say": "前三个的日在左边，春的日在下面，位置能不同。"
        },
        {
          "say": "说明天、晚上、昨天、春天，都在说不同的时间。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "先找字里的女字旁或日，再把它放回词语想。"
        },
        {
          "say": "送字卡时，仔细找字里的部件，别只看放哪边。"
        }
      ]
    },
    {
      "key": "sort-character-cards",
      "type": "interactive",
      "title": "给字卡送到家",
      "page": "radical-sort",
      "widgetType": "game",
      "startImage": "family-gathering",
      "script": [
        {
          "say": "借书卡挤在过道上，你能把它们送到对的托盘吗？"
        },
        {
          "setState": {
            "demo": true,
            "level": 1,
            "pause": true
          }
        },
        {
          "highlight": "#game-target"
        },
        {
          "say": "这张是奶，它左边的三笔可以认出女字旁。"
        },
        {
          "highlight": "#garden-first-dock"
        },
        {
          "say": "带女字图的托盘收有女字旁的字卡。"
        },
        {
          "highlight": "#game-player"
        },
        {
          "say": "让小车站到卡片后面，按箭头把卡片往前推。"
        },
        {
          "say": "推偏了，就按回转钮退一步，再从另一边靠近。"
        },
        {
          "setState": {
            "pause": false
          }
        },
        {
          "say": "我送进这一张就停。另一张有日，轮到你看看。"
        },
        {
          "say": "等小车回到起点，你从第一关自己开。"
        },
        {
          "setState": {
            "demo": false,
            "level": 1,
            "pause": false
          }
        }
      ],
      "gameAudio": {
        "sort-goal": "meaning-clues-10",
        "sort-hint": "meaning-clues-11",
        "sort-praise": "recap-3"
      }
    },
    {
      "key": "write-parents",
      "type": "slide",
      "title": "给爸和妈写借书卡",
      "template": "picture-points",
      "data": {
        "title": "给爸和妈写借书卡",
        "picture": "write-family",
        "points": [
          "爸 · 上下结构",
          "妈 · 左右结构",
          "慢写，请大人看"
        ]
      },
      "script": [
        {
          "say": "卡片上想写爸爸和妈妈，这两个字怎样摆正？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "爸是上下结构，上面是父，下面是巴。"
        },
        {
          "say": "父先撇、点，再撇、捺，下面再写巴。"
        },
        {
          "say": "巴先横折、竖、横，最后用竖弯钩收住。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "妈是左右结构，左边窄一点，给右边的马留空。"
        },
        {
          "say": "女字旁写撇点、撇、提，再写马的三笔。"
        },
        {
          "say": "马先横折，再竖折折钩，最后写横。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "跟着小格看一笔添在哪里，再在自己的纸上写。"
        },
        {
          "say": "写完请大人看看顺序和位置。"
        }
      ]
    },
    {
      "key": "strokes-one",
      "type": "slide",
      "title": "先看从哪里走",
      "template": "picture-points",
      "data": {
        "title": "先看从哪里走",
        "picture": "strokes-first",
        "points": [
          "了　才",
          "云　山",
          "比起点和转向"
        ]
      },
      "script": [
        {
          "say": "两张字卡都有带钩的笔画，怎么分清？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "了下面那笔是弯钩，往下走时略弯，再钩起。"
        },
        {
          "say": "才里面是竖钩，先竖直向下，再向左上钩。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "云的撇折先往左下撇，转弯后折向右边。"
        },
        {
          "say": "山的竖折从直直向下开始，到底才往右转。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "先用手比划第一段，看看是直下还是斜下来。"
        },
        {
          "say": "把两个容易混的字放在一起，差别就看得清。"
        }
      ]
    },
    {
      "key": "strokes-two",
      "type": "slide",
      "title": "看看怎样收笔",
      "template": "picture-points",
      "data": {
        "title": "看看怎样收笔",
        "picture": "strokes-second",
        "points": [
          "儿　四",
          "我　心",
          "看弯曲和末端"
        ]
      },
      "script": [
        {
          "say": "这回两个钩都弯一弯，关键要看最后怎么走。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "儿的竖弯钩先向下，再向右弯，末尾往上钩。"
        },
        {
          "say": "四里那笔是竖弯，也向右弯，末尾收平。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "我字的斜钩沿右下走，到末尾才向上钩。"
        },
        {
          "say": "心字的卧钩弯得低，末端往左上钩。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "先找笔从哪里出发，再用手比一比收笔方向。"
        },
        {
          "say": "写完请大人看笔尖走的是哪条路。"
        }
      ]
    },
    {
      "key": "face-and-turn",
      "type": "slide",
      "title": "看清他面朝哪儿",
      "template": "picture-points",
      "data": {
        "title": "看清他面朝哪儿",
        "picture": "direction-east",
        "points": [
          "先固定地图东边",
          "前东后西",
          "左北右南",
          "转身，再看一遍"
        ]
      },
      "script": [
        {
          "say": "拿到录音地图，小主持人该把话筒送哪儿？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "地图右边标的是东，先看纸偶头顶的箭头。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "纸偶朝东时，脸前是东，背后就是西。"
        },
        {
          "say": "开到纸偶前面的星星。"
        },
        {
          "say": "开到纸偶后面的星星。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "和它同向站，左手指北，右手指南。"
        },
        {
          "say": "开到纸偶左边的星星。"
        },
        {
          "say": "开到纸偶右边的星星。"
        },
        {
          "spotlight": "point-4"
        },
        {
          "say": "要是纸偶转身朝北，它的前方也转到北边。"
        },
        {
          "say": "地图上的东南西北还在原位，先认纸偶的朝向。"
        },
        {
          "say": "先看纸偶朝哪儿，再听要往它哪一边开。"
        },
        {
          "say": "星星集齐了，开到小旗那里。"
        }
      ]
    },
