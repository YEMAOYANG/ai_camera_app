  "authoring": {
    "model": "gpt-6.1-sol",
    "mode": "Codex direct authoring",
    "originality": "用字片和原创生活图讲本课。字形、部件关系和书写格由本课代码定位；诗和故事回到纸书，只作原创观察和提问。"
  },
  "goals": [
    "看清部件所在的位置，用加一部分或去一部分认识八个字。观察页、交、户、父在田字格里的写法，纸上练写由大人看。",
    "结合字形差别和词义，分清午/牛、刀/力、人/入、玉/主；用新例子说出选这个字的原因。",
    "结合发生的事、动作和表情理解高兴、生气、害怕、难过；先说发生了什么和自己的感受，再写一两句。",
    "读《画鸡》，把红冠、白羽和响亮叫声联系到画面，随教材积累；具体范读依另行授权。",
    "和家人读《小熊住山洞》，按四季复述花、叶、果、鸟家，小熊劝留树及动物感谢；共读和表达请家人观察。"
  ],
  "keyPoint": "字的部件和细小笔形要看清，放进有意义的词语再核。说写心情要说清事情和感受。",
  "difficultPoint": "字形相似也要结合词义，不只凭一笔猜。表情可以是线索，生活中的感受要联系实际发生的事。",
  "games": [
    {
      "scene": "slide-word-parts",
      "template": "slideMerge@1",
      "knowledgeRule": "同向滑片，只有当前正确部件配对才合成目标汉字；正确成品锁定部件在字里的位置。",
      "why": "孩子要先判断搭档，再找同轨路径；扣住的是配对知识，不把碰头方向冒充写字位置。",
      "progression": [
        "口少、王见两组，直线和换向。",
        "丁页、月半、票风三组，绕挡板。",
        "恢复房校爸飘四组，改变起点和挡板。"
      ]
    },
    {
      "scene": "aim-for-feelings",
      "template": "magnetMarbles@1",
      "knowledgeRule": "听懂新情境中的事情和动作，瞄中最相符的情绪图才得分。",
      "why": "同角色脸图不带字，判断来自题设情境与动作。轨迹和发射时机另需操控。",
      "progression": [
        "高兴和难过，两靶。",
        "生气、害怕、高兴，三靶。",
        "四种情绪，各换新情境，漂动稍快。"
      ]
    }
  ],
