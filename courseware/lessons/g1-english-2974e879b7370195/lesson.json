  "scenes": [
    {
      "key": "p01",
      "type": "slide",
      "title": "小猫在哪里？",
      "template": "title-picture",
      "data": {
        "title": "Where's the orange cat?",
        "picture": "on-bed",
        "caption": "找位置，也数数量"
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "我是 Mia 老师，和你一起找小猫。"
        },
        {
          "say": "这只小猫的毛是橙色的。"
        },
        {
          "say": "英语里，橙色可以说 orange。"
        },
        {
          "say": "Orange cat."
        },
        {
          "say": "就是橙色的小猫。"
        },
        {
          "say": "我们先听清要找哪一只。"
        },
        {
          "say": "再看它和床、盒子的相对位置。"
        },
        {
          "say": "问在哪里，要留心它藏在哪儿。"
        },
        {
          "say": "问有多少，要一只一只数清。"
        },
        {
          "say": "这一课还会认识十一和十二。"
        },
        {
          "say": "老师会先示范，再请你动手。"
        },
        {
          "say": "开口说英语时，请大人听一听。"
        }
      ]
    },
    {
      "key": "p02",
      "type": "interactive",
      "title": "听颜色，找到小猫",
      "page": "p02",
      "widgetType": "english-colour-pick",
      "startImage": "on-bed",
      "script": [
        {
          "highlight": "#demo-cat"
        },
        {
          "say": "先看老师找到的这只白猫。"
        },
        {
          "say": "White cat."
        },
        {
          "say": "白色是 white，小猫是 cat。"
        },
        {
          "annotate": "#demo-cat",
          "content": "white cat"
        },
        {
          "say": "颜色放在小猫前，告诉我们哪一只。"
        },
        {
          "setState": {
            "demo": true
          }
        },
        {
          "say": "老师把白猫送到小地垫上。"
        },
        {
          "say": "现在换你来找橙色的小猫。"
        },
        {
          "say": "An orange cat."
        },
        {
          "say": "先看毛的颜色，再点那只猫。"
        },
        {
          "say": "黑色是 black，白色是 white。"
        },
        {
          "say": "A black cat."
        },
        {
          "say": "听清 orange，别只看谁离你近。"
        },
        {
          "setState": {
            "demo": false
          }
        },
        {
          "say": "点对以后，小猫会走到小地垫上。"
        }
      ]
    },
    {
      "key": "p03",
      "type": "slide",
      "title": "看清床上和床下",
      "template": "two-columns",
      "data": {
        "title": "同一张床，位置不同",
        "left": {
          "heading": "On the bed.",
          "body": "在床面上"
        },
        "right": {
          "heading": "Under the bed.",
          "body": "在床底下"
        },
        "left_picture": "on-bed",
        "right_picture": "under-bed"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "先看左边，小猫坐在床面上。"
        },
        {
          "say": "On the bed."
        },
        {
          "say": "这里 on 表示在上面。"
        },
        {
          "say": "要看小猫和床面的关系。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "再看右边，小猫在床底的空隙里。"
        },
        {
          "say": "Under the bed."
        },
        {
          "say": "这里 under 表示在下面。"
        },
        {
          "say": "两张图都是小猫，也都是床。"
        },
        {
          "say": "玩具在盒盖上，也可以用 on。"
        },
        {
          "say": "问小猫在哪里，可以这样说。"
        },
        {
          "say": "Where's the orange cat?"
        },
        {
          "say": "看到床下，就回答 under the bed。"
        }
      ]
    },
    {
      "key": "p04",
      "type": "interactive",
      "title": "把小猫送到床上",
      "page": "p04",
      "widgetType": "english-position-place",
      "startImage": "on-bed",
      "script": [
        {
          "highlight": "#bed-picture"
        },
        {
          "say": "这是一张床，先认清这个参照物。"
        },
        {
          "say": "床面上方和床底下是不同位置。"
        },
        {
          "setState": {
            "boxDemo": true
          }
        },
        {
          "say": "看，黑猫藏到盒子里了。"
        },
        {
          "say": "It's in the box."
        },
        {
          "say": "这句话表示它在盒子里面。"
        },
        {
          "setState": {
            "boxDemo": false,
            "pointOn": true
          }
        },
        {
          "say": "老师指向床面，这里可以说 on。"
        },
        {
          "say": "On the bed."
        },
        {
          "say": "现在请把橙色小猫送到床面上。"
        },
        {
          "say": "拖动小猫，让它停在床面的位置。"
        },
        {
          "say": "也可以先点小猫，再点一个落点。"
        },
        {
          "say": "看清是床面，不是床下或盒内。"
        }
      ]
    },
    {
      "key": "p05",
      "type": "interactive",
      "title": "每只小猫只数一次",
      "page": "p05",
      "widgetType": "english-count-eleven-twelve",
      "startImage": "on-bed",
      "script": [
        {
          "highlight": "#count-cat-10"
        },
        {
          "say": "Where's the cat?"
        },
        {
          "say": "How many cats?"
        },
        {
          "say": "前一句找位置，后一句要点数。"
        },
        {
          "say": "已经数过的猫，会到下面的小地垫。"
        },
        {
          "setState": {
            "demoCount": 10
          }
        },
        {
          "say": "老师先把十只小猫排好。"
        },
        {
          "say": "Ten."
        },
        {
          "setState": {
            "demoCount": 11
          }
        },
        {
          "say": "再来一只，就是十一只。"
        },
        {
          "say": "Eleven."
        },
        {
          "say": "十一对应 eleven，听清这个声音。"
        },
        {
          "setState": {
            "demoCount": 12
          }
        },
        {
          "say": "十一后面再来一只，就是十二只。"
        },
        {
          "say": "Twelve."
        },
        {
          "say": "十二对应 twelve，和十一不一样。"
        },
        {
          "setState": {
            "demoCount": 0
          }
        },
        {
          "say": "现在轮到你，把每只小猫点数一次。"
        },
        {
          "say": "数过的小猫不会再算第二次。"
        },
        {
          "say": "全都到地垫后，看看总数是十二。"
        }
      ]
    },
    {
      "key": "p06",
      "type": "slide",
      "title": "先找清楚，再回答",
      "template": "two-columns",
      "data": {
        "title": "不知道与看清楚",
        "left": {
          "heading": "I don't know.",
          "body": "还没有找到，先如实说不知道"
        },
        "right": {
          "heading": "Yes, it is.",
          "body": "已经看清，它就在床下"
        },
        "left_picture": "empty-bed",
        "right_picture": "under-bed"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "这边暂时没有看到那只猫。"
        },
        {
          "say": "只看这一处，还不能知道它在哪儿。"
        },
        {
          "say": "I don't know."
        },
        {
          "say": "这句话是我不知道，不用随便猜。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "现在看见橙色小猫在床下了。"
        },
        {
          "say": "老师问，它在床底下吗？"
        },
        {
          "say": "Is it under the bed?"
        },
        {
          "say": "图里确实在床下，就这样回答。"
        },
        {
          "say": "Yes, it is."
        },
        {
          "say": "如果问它在床上，图里却不是。"
        },
        {
          "say": "Is it on the bed?"
        },
        {
          "say": "No, it isn't."
        },
        {
          "say": "这表示不是，要根据看见的位置回答。"
        },
        {
          "say": "现在请大人听你试着说一遍。"
        }
      ]
    },
    {
      "key": "p07",
      "type": "interactive",
      "title": "把小猫安置在床下",
      "page": "p07",
      "widgetType": "english-position-place",
      "startImage": "on-bed",
      "script": [
        {
          "highlight": "#bed-picture"
        },
        {
          "say": "这次还是这张床，位置要换一换。"
        },
        {
          "say": "床面与地板之间，有一个空隙。"
        },
        {
          "annotate": "#place-under",
          "content": "under the bed"
        },
        {
          "say": "Under the bed."
        },
        {
          "say": "表示在床底下，不是在床面上。"
        },
        {
          "highlight": "#cat-mover"
        },
        {
          "say": "听见 under，想一想下方的空隙。"
        },
        {
          "say": "现在请把小猫送到床底下。"
        },
        {
          "say": "可以拖到空隙，也能先点再点。"
        },
        {
          "say": "点错先停一停，重新看参照物。"
        },
        {
          "say": "小猫到床下后，请试着回答。"
        },
        {
          "say": "Is it under the bed?"
        },
        {
          "say": "看着真实位置，再说 Yes, it is。"
        }
      ]
    },
