      "source": "课件32～36、教案7～8"
    }
  ],
  "pageSequence": [
    {
      "key": "same-disc-new-place",
      "kind": "teaching",
      "plan": "两槽放同一枚，个位是一，十位是十；左空只写个位，右空写零。"
    },
    {
      "key": "move-one-record-once",
      "kind": "teaching",
      "plan": "演示2枚的完整三个摆法，指同一圆片右移或左移，片数保持。"
    },
    {
      "key": "find-the-missing-placement",
      "kind": "teaching",
      "plan": "从3枚的缺记录找漏掉的分法，按十位从0到3核对。"
    },
    {
      "key": "one-way-and-back",
      "kind": "teaching",
      "plan": "用4枚双向列举，验同一集合、不重不漏，5枚迁移。"
    },
    {
      "key": "follow-the-disc-route",
      "kind": "game",
      "plan": "用移动顺序选择实际可达的数位图，一次只走一格对应转移，不采错序卡。"
    },
    {
      "key": "same-count-along-a-diagonal",
      "kind": "teaching",
      "plan": "在十位/个位坐标表看六枚的同和斜排，核对5枚和9枚种数。"
    },
    {
      "key": "count-discs-not-the-value",
      "kind": "teaching",
      "plan": "用六枚的数列推回总片数，检查错误片数和漏步。"
    },
    {
      "key": "fix-the-six-disc-record",
      "kind": "teaching",
      "plan": "在下一页让两种错误和实际修好的七行并列，逐项验证片数与单步。"
    },
    {
      "key": "sort-the-disc-budgets",
      "kind": "game",
      "plan": "从数位图数出实物片数，实际推入对应片数材料盒。"
    },
    {
      "key": "ten-discs-have-limits",
      "kind": "teaching",
      "plan": "个位与十位都最多9，10枚必须分开，两端排除，九种排列另数。"
    },
    {
      "key": "picture-check",
      "kind": "quiz",
      "plan": "全新盘图、顺序步骤、数量猜测、错牌与11枚合法边界图。"
    },
    {
      "key": "make-your-own-disc-board",
      "kind": "teaching",
      "plan": "用家中安全纸圆片选择新片数，双向验证并交换猜盘，实际完成待观察。"
    }
  ],
  "games": [
    {
      "page": "follow-the-disc-route",
      "template": "bubbleMaze",
      "version": 1,
      "entryPoint": "K.gameTemplates.bubbleMaze",
      "ownerApprovedOn": "2026-11-09",
      "knowledgeRule": "ordered_route",
      "selection": "棋盘实际有该关全部合法摆法图。把空十位、全个位作为已摆起点，只采接下来多一枚十位、少一枚个位的图；错序不消耗或前进。最后通过实际终点。滚动大图保留刚才盘面。",
      "levels": [
        "2枚，从2按顺序收11、20，固定片数不变。",
        "4枚，从4按次序收13、22、31、40。",
        "5枚反向，从50按次序收41、32、23、14、5。"
      ],
      "demo": "指起始圆片槽、下一张真实盘面和方向键，移动一次并成功采一张后复位。",
      "teacherAnchors": [
        "game-player",
        "game-target"
      ]
    },
    {
      "page": "sort-the-disc-budgets",
      "template": "sortingDepot",
      "version": 1,
      "entryPoint": "K.gameTemplates.sortingDepot",
      "ownerApprovedOn": "2026-11-09",
      "knowledgeRule": "classification",
      "selection": "每箱是实际圆片数位图。以左右片数之和匹配材料盒，数字大小不是匹配依据；落到错误圆片预算拒绝。",
      "levels": [
        "不同数牌用3或4枚，比较图和盒。",
        "用4、5、6枚的三种图，改变站位。",
        "加入同片数的两种摆法，用相同预算的两箱各接一个。"
      ],
      "demo": "指两边圆片图和对应材料盒，真推一个箱到正确盒再复位。",
      "teacherAnchors": [
        "game-player",
        "game-target"
      ]
    }
  ],
