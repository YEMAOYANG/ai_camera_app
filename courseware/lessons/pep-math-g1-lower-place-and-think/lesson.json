    {
      "key": "sort-the-disc-budgets",
      "type": "interactive",
      "title": "把盘面推回材料盒",
      "widgetType": "courseware_game",
      "page": "sort-the-disc-budgets",
      "startImage": "depot-ready",
      "script": [
