{
  "schemaVersion": "mira.courseware.asset-sources.v1",
  "lesson": "解决问题｜两人之间",
  "atlasSources": {
    "theatre-sprites-initial": {
      "path": "art-source/theatre-sprites-initial.png",
      "sha256": "5ca72afb56d8d551678056abf68fd72a6a58eed9bafc62b98c00e0670772882a",
      "originPath": "/Users/sqcopenclaw/.codex/generated_images/01a1c43e-779d-76c1-9193-2b50ab5e491a/exec-20cc65b4-1bab-4c0d-a0a5-55106125073b.png",
      "prompt": "Create one genuinely transparent 3×3 production sprite atlas for an original Chinese first-grade math lesson set at a community shadow theatre. Square sheet with exactly nine equal square cells, strict thirds and no visible grid. True transparent alpha between every object and at outer margins. Seven isolated occupied cells and two fully empty cells in exact row-major order. Row 1 col 1: friendly Chinese boy stage helper in a simple pine-green short jacket, cream shirt and apricot trousers, facing to the right in profile/three-quarter view, calmly standing, one foot lightly ahead. Row 1 col 2: precisely the same boy, costume, view, facial proportions, baseline, head size and scale, in a running pose facing right. Row 1 col 3: precisely the same boy facing right in a small upward jump, both knees tucked a little and one arm balancing, no flying trail or shadow; preserve the same body proportions and scale. Row 2 col 1: only one different child in a muted sage-green coat, viewed simply from the front, relaxed stance with arms down, easy to repeat as an exact counted group; full body complete. Row 2 col 2: one medium saturated blue triangular upright pennant on a short dark pine-green post, no flag writing. Row 2 col 3: one identically sized bright persimmon-orange triangular upright pennant on the same post, exactly same silhouette, distinct color. Row 3 col 1: one warm honey-colored five-point paper star sticker with a thin pine-green border, one cream edge accent, no face or text. Row 3 col 2 and col 3 must be completely empty alpha zero. Clean matte gouache with fine paper grain inside the opaque silhouettes, simple neat cut-paper edges, warmly illustrated, readable at 26–36 px. Exact 13% true transparent safety around each object. No letters, numbers, textures in gutters, shadows, glows, blur, extras, borders, checkerboards or watermarks.",
      "promptSha256": "6cda5bfb42774034791ebbb8857e9d525c82192b0a5c4b801135ab41f0fa072a",
      "status": "rejected_alpha_glow"
    },
    "theatre-sprites": {
      "path": "art-source/theatre-sprites.png",
      "sha256": "70d7b413e65ee62e4fbb46539ab0b16d95151804b1fa427f8eb8d426580603a4",
      "originPath": "/Users/sqcopenclaw/.codex/generated_images/01a1c43e-779d-76c1-9193-2b50ab5e491a/exec-f35e7521-1a94-4fa6-a68d-9e59d16bdd47.png",
      "prompt": "Hard-alpha cleanup ONLY for the supplied exact transparent 3×3 sprite atlas. The seven original illustrated sprites are already correct and must stay the same in color, design, geometry, pose, relative scale and exact row-major position: top row three frames of the same boy, middle row one child and two colored flags, bottom-left a star, bottom middle and right empty. Remove all translucent white haze, colored glow, cast shadow, backfill, alpha noise and bright matte fringing around these silhouettes. Every background pixel, entire gutters and all square-cell edges must have alpha exactly zero. Only the sharp cut-paper bodies, flags and star remain with solid opacity and a narrow normal antialias edge. Keep no glow, blurred emission, paper behind the subjects, checkerboard, grid, typography, or extra assets. Keep three columns by three rows, exact original framing, and only clean the alpha mask.",
      "promptSha256": "d4aa9bd517b5b4acbd8b6292ba02fb5d0e98587b649952ab342ed89b15b345a1",
      "referenceKey": "theatre-sprites-initial",
      "receipt": "art-source/theatre-sprites.receipt.json",
      "receiptSha256": "96f874cd55246eec214d2f99d2bee74592fbf7657d2299c9060583115706e568",
      "plan": "art-source/theatre-sprites.plan.json"
    },
    "theatre-rooms": {
      "path": "art-source/theatre-rooms.png",
      "sha256": "4c04fbdbcbb0a16e8fc5fbe70bd172dca5343aeb571173209ba8fe201df6a10a",
      "originPath": "/Users/sqcopenclaw/.codex/generated_images/01a1c43e-779d-76c1-9193-2b50ab5e491a/exec-535262d9-babd-4004-9c45-97db50e1a152.png",
      "prompt": "Make one original opaque background sheet for a first-grade math lesson in a Chinese community shadow theatre. Two independent equally tall wide scenes stacked vertically, exactly at the halfway line, approximate overall aspect 8:9 so each half is widescreen 16:9. Each half a complete flat illustration at its own framing; a crop of the top or bottom half must read naturally. No blank gaps, visible panel borders, frames, lettering, numbers, logos, banners with writing, characters, audience, or figures anywhere. Style in both halves: fine paper grain, matte gouache, neat cut-paper shapes, dark pine green, warm cream, restrained persimmon and apricot. Calm low detail, strong soft central emptiness for game objects. Top scene: entrance to a small community shadow-theatre lobby, distant folded pine-green curtain and a hint of warm empty light through the doorway high at the far left, muted matte pale sage floor from midline down, middle area unobstructed, small wall details only at outer edges. Bottom scene: a different quiet backstage sorting room, seen straight on, pale warm cream and muted amber tones, narrow pine-green shelving and soft fabric only on far left and far right edges, center 70 percent open neutral cream-olive wall, center bottom unobstructed for a dark game board. Keep major motifs away from the shared boundary and lateral crop edges. Original book illustration, low contrast backgrounds for small-screen readability. No human or animal silhouettes, no counting objects in a line, no objects with numbers, no front focal point, no floor grids, no decorative dust particles.",
      "promptSha256": "636f42018bfee1c358b291a7f69d43ddb7d213e946f3967a8f0c48e0ec324985"
    }
  },
