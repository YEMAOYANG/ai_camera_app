  "scenes": [
    {
      "key": "one-seven-piece-set",
      "type": "slide",
      "title": "给拼图展做一块门牌",
      "template": "two-columns",
      "data": {
        "title": "给拼图展做一块门牌",
        "left": {
          "heading": "展台空着",
          "body": "小禾和小满来做门牌。"
        },
        "left_picture": "opening-scene",
        "right": {
          "heading": "一套七巧板",
          "body": "从一套里挑需要的板。"
        },
        "right_picture": "one-complete-set"
      },
      "script": [
        {
          "say": "拼图展要做一块三角形门牌。"
        },
        {
          "spotlight": "left-picture"
        },
        {
          "say": "小禾和小满只有一套七巧板。"
        },
        {
          "say": "想一想。要挑几块才能拼出门牌？"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "这些板贴在一起，外面是一个正方形。"
        },
        {
          "say": "沿着接缝数一数。一套有七块。"
        },
        {
          "say": "做三角门牌，可以从七块里先挑几块试试。"
        },
        {
          "say": "拼好沿外边看一圈。门牌外边得是三角形。"
        }
      ]
    },
    {
      "key": "sort-the-seven",
      "type": "slide",
      "title": "七块板里有哪些形状",
      "template": "picture-points",
      "data": {
        "title": "七块板里有哪些形状",
        "picture": "seven-loose-pieces",
        "points": [
          "五块三角板",
          "一块正方形板",
          "一块平行四边形板"
        ]
      },
      "script": [
        {
          "say": "我们把七块摊开，看看每一块的外边。"
        },
        {
          "spotlight": "picture"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "先数三角板。左边两大块，接着一中块，再往右两小块。"
        },
        {
          "say": "两大块一样大。两小块也一样大。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "下面左边是正方形。四条边一样长，四个角方方的。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "下面右边是平行四边形。"
        },
        {
          "say": "每一对相对的边，像两条并排的线。"
        },
        {
          "say": "五块三角板，再加下面两块，一共七块。"
        },
        {
          "say": "现在可以挑板了。"
        }
      ]
    },
    {
      "key": "two-piece-trial",
      "type": "slide",
      "title": "从两块一样大的板试起",
      "template": "two-columns",
      "data": {
        "title": "从两块一样大的板试起",
        "left": {
          "heading": "转一转再贴",
          "body": "两块大三角板沿整条边贴好。"
        },
        "left_picture": "two-will-fit",
        "right": {
          "heading": "换一组再看",
          "body": "一三角一方有拐角。两小三角也能拼。"
        },
        "right_picture": "two-try-again"
      },
      "script": [
        {
          "say": "小禾先挑两块一样大的大三角板。"
        },
        {
          "say": "哪两条边可以贴在一起？"
        },
        {
          "spotlight": "left-picture"
        },
        {
          "say": "看左图。右边那块转四分之一圈。"
        },
        {
          "say": "让两条同样长的直角边对齐。"
        },
        {
          "say": "两条边贴紧，两块板各在接缝的一边。"
        },
        {
          "say": "沿外边绕一圈，只剩三条直边。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "换成一块小三角和一块方板。"
        },
        {
          "say": "图上外边多拐了一次，变成四条边。"
        },
        {
          "say": "一块方板和一块三角板，边贴边拼不成三角形。"
        },
        {
          "say": "再换两块小三角板。也能拼成三角形。"
        },
        {
          "say": "和中块叠一叠，大小刚好一样。"
        },
        {
          "say": "一套里选了两块就能试出一种拼法。接着加到三块。"
        }
      ]
    },
    {
      "key": "try-three-and-four",
      "type": "slide",
      "title": "三块板，也能拼三角形",
      "template": "two-columns",
      "data": {
        "title": "三块板，也能拼三角形",
        "left": {
          "heading": "两小块加方板",
          "body": "两小板分别贴着方板的两条边。"
        },
        "left_picture": "three-with-square",
        "right": {
          "heading": "两小块加中板",
          "body": "先拼两小板，再贴到中板。"
        },
        "right_picture": "three-with-medium"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "小满挑了两块小三角和一块方板。"
        },
        {
          "say": "方板先放在角上。两小块各贴一条边，斜边接成一条线。"
        },
        {
          "say": "你用手沿外面走一圈。外轮廓有三条直边。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "小禾把两小块先拼成一块和中三角板同大的形状。"
        },
        {
          "say": "再和中板贴一条一样长的边。"
        },
        {
          "say": "三块板也拼出同样大的三角形。"
        },
        {
          "say": "两幅外轮廓一样。你能指给别人看接缝哪里变了吗？"
        }
      ]
    },
    {
      "key": "keep-the-triangle",
      "type": "slide",
      "title": "留住三块拼法，再加一块",
      "template": "two-columns",
      "data": {
        "title": "留住三块拼法，再加一块",
        "left": {
          "heading": "还可以换板",
          "body": "两块小三角配一块平行四边形。"
        },
        "left_picture": "three-with-slanted",
        "right": {
          "heading": "三块接一块",
          "body": "把三块拼好的三角形当作一整块。"
        },
        "right_picture": "three-or-four"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "还有一种。两小块贴在斜方板的两边。"
        },
        {
          "say": "外边接成三条直线。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "看右图。左边是两小块加方板，已经拼好一个三角形。"
        },
        {
          "say": "把这三块一起转四分之一圈。"
        },
        {
          "say": "再添一块和它同样大的三角板。"
        },
        {
          "say": "两条一样长的边贴合了。三块再添一块，数起来是四块。"
        },
        {
          "say": "外面还是三条直边。"
        },
        {
          "say": "板没有互相压住，接缝也没有露底。"
        },
        {
          "say": "五块、六块或七块怎样拼三角形，可以在家自己挑战。"
        },
        {
          "say": "接下来挑门牌缺的那一块。先看大小，再看边和角。"
        },
        {
          "say": "两处虚线大小不同，先比长边和短边。"
        },
        {
          "say": "如果大小相近，再比角和边的朝向。"
        },
        {
          "say": "三个展板都有空位，选能严丝合缝的。"
        },
        {
          "say": "停一下，比一比边长和角。"
        },
        {
          "say": "想象把板移进虚线，看看会不会露出。"
        },
        {
          "say": "边和角都对上了，看看成品的外边。"
        }
      ]
    },
