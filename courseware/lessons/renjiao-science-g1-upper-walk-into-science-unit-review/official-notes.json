  "textbookReview": {
    "status": "reviewed",
    "findings": [
      "本课概念图以科学的过程联结提出问题和解决问题，方法列出观察、实验、制作、测量、查阅资料并保留开放省略。",
      "本课学以致用要求从现象提出自己想知道的问题，并识别生活中需要解决的问题。原图彩虹、热气球、床下球和剥坚果不搬用。",
      "本课反思提问、方法、习惯、安全，并对做过的活动再提新问题；不把一次选择正确等同于真实口语或实验能力。"
    ],
    "pageRefs": [
      "官方教材PDF18/印刷13",
      "官方教材PDF19/印刷14",
      "官方教材PDF20/印刷15"
    ],
    "boundaries": [
      "PDF17/印刷12为上一课结尾",
      "PDF21/印刷16已进入第二单元"
    ]
  },
  "objectiveBasis": "以下是依据准确教材本课整理的原创教学目标，不冒称官方教案目标。",
  "objectives": [
    "联系可见现象说出自己想知道的问题，区分看到的情况与尚需调查的问题。",
    "理解科学活动会从提出问题走向寻找解决办法，借助行动和结果检查想法。",
    "在图片和口述支持下，为简单问题选择观察、实验、制作、测量或查阅资料等合适方法，知道方法可以结合使用。",
    "回顾认真观察、记录、倾听及安全等学习习惯，对已做活动提出新的问题。"
  ],
  "keyPoint": "把具体问题与能得到所需信息的科学方法联系起来，不把方法名称当作要死记的词表。",
  "difficultPoint": "从具体活动的过程和结果反思下一步需要做什么，并区分屏幕操作证据与待观察的真实表达、制作及实验表现。",
  "afterClassExercise": [
    {
      "basis": "PDF19/印刷14学以致用",
      "direction": "与家人观察家中一个安全的生活现象，说出一个想知道的问题，不照搬教材原图原问。",
      "evidence": "口头表达待观察"
    },
    {
      "basis": "PDF20/印刷15学习反思",
      "direction": "说一说本次用了什么方法、注意了什么安全，再提一个新问题；成人记录原话。",
      "evidence": "家长可记录，未采集前待观察"
    }
  ],
