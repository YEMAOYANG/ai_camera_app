  "scenes": [
    {
      "key": "two-camps",
      "title": "要比哪两排椅子",
      "type": "slide",
      "template": "two-columns",
      "data": {
        "title": "要比哪两排椅子",
        "left": {
          "heading": "两块营地",
          "body": "圆牌营地和三角牌营地"
        },
        "right": {
          "heading": "两排椅子",
          "body": "圆牌营地多几把？"
        },
        "left_picture": "camp-clearing",
        "right_picture": "camp-counts"
      },
      "script": [
        {
          "say": "露营站开门啦。值班员想知道两块营地的椅子差多少。"
        },
        {
          "spotlight": "left-picture"
        },
        {
          "say": "你看，左边有圆牌，右边是三角牌。"
        },
        {
          "say": "他问圆牌营地的椅子比三角牌营地多几把。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "看记录，圆牌有十一把，三角牌有七把。"
        },
        {
          "say": "我们在比较同一种东西，都用把来数。"
        },
        {
          "say": "要回答多几把，得找到圆牌那一排多出来的部分。"
        },
        {
          "say": "两排放到同一个起点，猜猜哪些椅子会有伙伴。"
        }
      ]
    },
    {
      "key": "match-the-chairs",
      "title": "一把对一把",
      "type": "slide",
      "template": "picture-points",
      "data": {
        "title": "一把对一把",
        "picture": "chair-pairs",
        "points": [
          "从同一头排",
          "前 7 把配齐",
          "11 − 7 = 4（把）"
        ]
      },
      "script": [
        {
          "say": "站在两排椅子旁边，你能一眼看见相差几把吗？"
        },
        {
          "spotlight": "picture"
        },
        {
          "say": "看图里的短线，每条线把上下一把椅子连成一对。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "两排从左边同一头开始，每个位置只配一把。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "短排七把全配齐。长排也正好拿出七把跟它们配。"
        },
        {
          "say": "配齐段上下都有。相差段从短排尽头开始。"
        },
        {
          "say": "过了第七对，长排还露出四把，短排已经排完。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "从十一把里减去配齐的七把，剩下四把。"
        },
        {
          "say": "把配齐的七把和多出的四把接起来，正好是十一把。"
        },
        {
          "say": "所以圆牌营地比三角牌营地多四把椅子。"
        }
      ]
    },
    {
      "key": "reverse-the-question",
      "title": "少几也是这一段",
      "type": "slide",
      "template": "picture-points",
      "data": {
        "title": "少几也是这一段",
        "picture": "chair-reverse",
        "points": [
          "长排多 4 把",
          "短排少 4 把",
          "11 − 7 = 4（把）"
        ]
      },
      "script": [
        {
          "say": "值班员换个问法。三角牌营地比圆牌营地少几把？"
        },
        {
          "spotlight": "picture"
        },
        {
          "say": "先看上排多出的椅子，再把手指移到正下方的空圈。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "上排多出的四把，各对着下面一个空位。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "下排这四个空位，就说明它比上排少四把。"
        },
        {
          "say": "看框线在两排的哪里。多出和空着的地方正好对齐。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "椅子和起点都没换，用十一减七，仍然是四把。"
        },
        {
          "say": "问圆牌多几和问三角牌少几，都在找同一段。"
        },
        {
          "say": "看准两排的尽头，再核对配齐和相差各有几把。"
        }
      ]
    },
    {
      "key": "sort-the-pairing-cards",
      "title": "把对齐卡送回托盘",
      "type": "interactive",
      "page": "sort-the-pairing-cards",
      "widgetType": "courseware_game",
      "startImage": "camp-clearing",
      "script": [
        {
          "say": "把图卡送到对应的托盘。先看我开小车。"
        },
        {
          "setState": {
            "demo": true,
            "level": 1,
            "pause": true
          }
        },
        {
          "highlight": "#pairing-legend"
        },
        {
          "say": "左边大图放大了青色框里的卡。下面是两种托盘图。"
        },
        {
          "highlight": "#first-paired-card"
        },
        {
          "say": "这张卡框住上下都能对起来的格子，是配齐段。"
        },
        {
          "highlight": "#first-paired-dock"
        },
        {
          "say": "托盘里也画着上下相对的两排，这张卡送到这里。"
        },
        {
          "highlight": "#game-player"
        },
        {
          "say": "沿格子按箭头，从图卡后面把它推过去。"
        },
        {
          "setState": {
            "pause": false
          }
        },
        {
          "say": "看小车推过去，图卡进了同类托盘。"
        },
        {
          "say": "框住长排多出的，或者短排空着的，都送到相差托盘。"
        },
        {
          "say": "你来开车。先看括线框住的地方，再决定往哪边推。"
        },
        {
          "setState": {
            "demo": false,
            "level": 1,
            "pause": false
          }
        }
      ],
      "gameAudio": {
        "sort-goal": "match-the-chairs-8",
        "sort-hint": "reverse-the-question-8",
        "sort-help": "say-it-at-home-8",
        "sort-praise": "say-it-at-home-12"
      }
    },
    {
      "key": "choose-two-counts",
      "title": "三块牌里找两块",
      "type": "slide",
      "template": "picture-points",
      "data": {
        "title": "三块牌里找两块",
        "picture": "three-lamp-tags",
        "points": [
          "圆牌 36 块，三角牌 28 块",
          "36 − 28 = 8（块）",
          "36 + 28 是合计"
        ]
      },
      "script": [
        {
          "say": "露营站有三块记录牌。现在要比圆牌和三角牌。"
        },
        {
          "spotlight": "picture"
        },
        {
          "say": "方牌有二十三块灯牌。它是另一个营地的数量。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "这道题用圆牌的三十六块和三角牌的二十八块。"
        },
        {
          "say": "把这两条从同一起点排，先看它们各到哪里。"
        },
        {
          "say": "找到两条的尽头，只数中间隔了几格。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "三十六减二十八，得到八块，和图里多出的八格一样。"
        },
        {
          "say": "从较短一排的尽头往后看，就找到要数的那一段。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "三十六加二十八把两组合起来，问的是共有多少。"
        },
        {
          "say": "三十六减二十三是和方牌比。问题提到谁，就取谁的数。"
        }
      ]
    },
    {
