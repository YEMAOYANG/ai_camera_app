  "scenes": [
    {
      "key": "plant-exhibit",
      "type": "slide",
      "title": "植物展要数什么",
      "template": "picture-points",
      "data": {
        "title": "植物展要数什么",
        "picture": "opening-rack",
        "points": [
          "找到要数的东西",
          "看一看原来摆在哪儿",
          "再看看每盆的牌"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "欢迎来到小小植物展。"
        },
        {
          "say": "展架上的盆栽要登记。"
        },
        {
          "say": "请找找，盆栽都放在哪里？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "我们数的是架上所有盆栽。"
        },
        {
          "say": "地上的洒水壶和小铲子留在外面。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "架子有两层。先看上层，再看下层。"
        },
        {
          "say": "放在不同层的盆栽，可以各数一次。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "每盆还有一块小牌。"
        },
        {
          "say": "有叶形牌，也有水滴形牌。"
        },
        {
          "say": "你想按架层数，还是按小牌数？"
        }
      ]
    },
    {
      "key": "one-rule-at-a-time",
      "type": "slide",
      "title": "按架层分两组",
      "template": "picture-points",
      "data": {
        "title": "按架层分两组",
        "picture": "by-row",
        "points": [
          "上层一组",
          "下层一组",
          "每盆只进一组"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "第一种办法，看盆栽原来放哪一层。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "指一指，上层这一排有几盆？"
        },
        {
          "say": "一、二、三、四、五。上层有五盆。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "再数下层。"
        },
        {
          "say": "一、二、三、四。接着五、六、七、八。"
        },
        {
          "say": "下层有八盆。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "上层的都在第一组，下层的都在第二组。"
        },
        {
          "say": "整架只有这两层，每盆都分进去一次。"
        },
        {
          "say": "想一想，两组怎样合起来？"
        }
      ]
    },
    {
      "key": "count-each-group",
      "type": "slide",
      "title": "把两组的数量合起来",
      "template": "picture-points",
      "data": {
        "title": "把两组的数量合起来",
        "picture": "row-sum",
        "points": [
          "上层 5 盆",
          "下层 8 盆",
          "5＋8＝13（盆）"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "这里每张盆栽小图对应架上的一盆。"
        },
        {
          "say": "先点数，再把两个数记下来。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "上层五盆，指给我看这五个位置。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "下层八盆，沿着下面一排再数。"
        },
        {
          "say": "上层和下层合在一起，就是整架。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "五加八等于十三。"
        },
        {
          "say": "答，展架上一共有十三盆。"
        },
        {
          "say": "等会儿换一种看法，看看还会不会数到十三盆。"
        }
      ]
    },
    {
      "key": "sorting-rules",
      "type": "slide",
      "title": "一次听清一条标准",
      "template": "picture-points",
      "data": {
        "title": "一次听清一条标准",
        "picture": "sorting-rule-guide",
        "points": [
          "架层标记",
          "叶形和水滴形",
          "送进合适的托盘"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "推盆牌时，先听清这一关按什么分。"
        },
        {
          "say": "每张牌保留盆栽的两个线索。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "按架层分。看小架子亮在哪一层。"
        },
        {
          "say": "小架子亮在上面，表示盆栽原来在上层。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "按牌形分。找叶形和水滴形托盘。"
        },
        {
          "say": "有两种牌形，各进一种托盘。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "这一关再按架层分。每张盆牌只送一次。"
        },
        {
          "say": "听清这一关的标准，再看看对应托盘。"
        },
        {
          "say": "绕到盆牌后面。需要时可以撤回一步。"
        },
        {
          "say": "按这条标准，每张盆牌只进一个托盘。"
        }
      ]
    },
    {
      "key": "send-by-the-rule",
      "type": "interactive",
      "title": "推盆牌到合适的托盘",
      "page": "send-by-the-rule",
      "widgetType": "simulation",
      "startImage": "intro-sort",
      "script": [
        {
          "setState": {
            "demo": true,
            "level": 1,
            "pause": true
          }
        },
        {
          "highlight": "#rule-picture"
        },
        {
          "say": "先按架层分。看左边的小架子。"
        },
        {
          "highlight": "#game-target"
        },
        {
          "say": "这张盆牌上的小架子，亮在上面。"
        },
        {
          "highlight": "#first-dock"
        },
        {
          "say": "这个托盘也亮着上层，可以接收它。"
        },
        {
          "highlight": "#game-player"
        },
        {
          "say": "小车来到盆牌后面，往托盘方向推。"
        },
        {
          "setState": {
            "pause": false
          }
        },
        {
          "say": "看小车怎样把盆牌推向上层托盘。"
        },
        {
          "say": "现在轮到你。想重听时，点小喇叭。"
        },
        {
          "setState": {
            "demo": false,
            "level": 1,
            "pause": false
          }
        }
      ],
      "gameAudio": {
        "sort-rack-one": "sorting-rules-5",
        "sort-by-tag": "sorting-rules-8",
        "sort-rack-again": "sorting-rules-11",
        "sort-hint": "sorting-rules-12",
        "sort-help": "sorting-rules-13",
        "sort-praise": "sorting-rules-14"
      }
    },
    {
      "key": "show-both-totals",
      "type": "slide",
      "title": "换一条标准再算",
      "template": "picture-points",
      "data": {
        "title": "换一条标准再算",
        "picture": "tag-sum",
        "points": [
          "叶形牌 7 盆",
          "水滴形牌 6 盆",
          "7＋6＝13（盆）"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "原来那架盆栽没有换。"
        },
        {
          "say": "这次先找小牌的形状。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "把叶形牌的都找出来。数到七盆。"
        },
        {
          "say": "上层和下层都能找到叶形牌。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "再找所有水滴形牌，数到六盆。"
        },
        {
          "say": "每盆只有一种形状的小牌。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "七加六等于十三。"
        },
        {
          "say": "换了一条标准，每盆还是数一次。"
        },
        {
          "say": "再对照一下刚才的五加八。"
        }
      ]
    },
    {
      "key": "same-whole",
      "type": "slide",
      "title": "两道算式，同一整架",
      "template": "picture-points",
      "data": {
        "title": "两道算式，同一整架",
        "picture": "compare-sums",
        "points": [
          "按架层看",
          "按牌形看",
          "两次都数全"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "两幅图用的是同一架盆栽。"
        },
        {
          "say": "先找找，你还认得出哪几盆？"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "按架层，五盆加八盆，是十三盆。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "按牌形，七盆加六盆，也是十三盆。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "两个加法里，两部分的数量不同。"
        },
        {
          "say": "整架的盆栽还是这些。每盆都数过一次。"
        },
        {
          "say": "所以两个结果相同。"
        },
        {
          "say": "你也可以一盆一盆指着图核对。"
        }
      ]
    },
    {
      "key": "trace-the-double-count",
      "type": "slide",
      "title": "圈出数重和漏掉的盆",
      "template": "picture-points",
      "data": {
        "title": "圈出数重和漏掉的盆",
        "picture": "cross-wrong",
        "points": [
          "同时在两组里",
          "两组里都找不到",
          "回到同一条标准"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "有人把上层五盆和叶形牌七盆合起来。"
        },
        {
          "say": "五加七是十二，跟十三不同。回到原架一盆盆查。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "这三盆上层叶形牌，在两组里都出现了。"
        },
        {
          "say": "橙色双圈指出这些被数重的盆。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "这四盆下层水滴形牌，在两组里都没出现。"
        },
        {
          "say": "蓝色虚线圈指出这些漏掉的盆。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "现在只按架层分。上层每盆点一次，下层也一样。"
        },
        {
          "say": "五加八重新算出十三。整架的盆栽都点到了。"
        },
        {
          "say": "就算两个结果碰巧相同，也要回图查。"
        }
      ]
    },
    {
      "key": "matching-rules",
      "type": "slide",
      "title": "先对照每一盆",
      "template": "picture-points",
      "data": {
        "title": "先对照每一盆",
        "picture": "matching-guide",
        "points": [
          "看原来一架",
          "检查有没有重或漏",
          "留下完整的一组图"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "左边是原来一架，右边是几种分组图。"
        },
        {
          "say": "两边的盆栽可以一个一个比。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "对照左边一架。找一张每盆只数一次的图。"
        },
        {
          "say": "认得同一盆的样子，就能找出它在哪里。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "找两张分组完整的图。两种标准都可以。"
        },
        {
          "say": "总数碰巧相同，也要一盆一盆核对。"
        },
        {
          "say": "回到左边原图，把每一盆对照一次。"
        },
        {
          "say": "找一找哪个样子出现两次，哪个没出现。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "每一盆都在，找到了完整分组。"
        }
      ]
    },
    {
      "key": "recheck-by-matching",
