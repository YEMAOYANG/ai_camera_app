  "scenes": [
    {
      "key": "rack-of-hundred-tickets",
      "type": "slide",
      "title": "把展馆票号放回去",
      "template": "two-columns",
      "data": {
        "title": "把展馆票号放回去",
        "left": {
          "heading": "风吹落了几张票",
          "body": "十格一层，有的格子还空着。"
        },
        "left_picture": "first-ticket-row",
        "right": {
          "heading": "从第一格排起",
          "body": "每层从左往右放十张。"
        },
        "right_picture": "build-first-two-rows"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "小展馆的门票被风吹乱了。我们来把票放回架上。"
        },
        {
          "say": "最上层第一格放一号。指着一号往右接着数。"
        },
        {
          "say": "一后面是二。接着三、四、五，数字一个接一个。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "一层刚好十格。第一层从一号排到十号。"
        },
        {
          "say": "第一层满了，十一号从下面一层的左边开始。"
        },
        {
          "say": "接着从十一数到二十。请你指着格子数一遍。"
        }
      ]
    },
    {
      "key": "right-one-per-slot",
      "type": "slide",
      "title": "同一行，往右多一",
      "template": "two-columns",
      "data": {
        "title": "同一行，往右多一",
        "left": {
          "heading": "从六十二出发",
          "body": "向右一格，六十三。"
        },
        "left_picture": "row-62-to-64",
        "right": {
          "heading": "空票夹该放哪张",
          "body": "左右的票都能帮忙核对。"
        },
        "right_picture": "row-middle-gap"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "来看这条架子。指着六十二，向右挪一格。"
        },
        {
          "say": "沿红箭头到六十三。六十三比六十二多一。"
        },
        {
          "say": "如果向左走一格，就回到六十二，少一。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "中间空着。左边六十二，右边六十四。"
        },
        {
          "say": "从六十二往右数一个，是六十三。"
        },
        {
          "say": "从六十四倒数一个，也是六十三。两边都对上。"
        }
      ]
    },
    {
      "key": "next-row-start",
      "type": "slide",
      "title": "从一行末尾到下一行开头",
      "template": "two-columns",
      "data": {
        "title": "从一行末尾到下一行开头",
        "left": {
          "heading": "完整的百数表",
          "body": "十行，每行十格。最后一格是100。"
        },
        "left_picture": "full-hundred-chart",
        "right": {
          "heading": "换行的位置",
          "body": "49、50、51紧接着数。"
        },
        "right_picture": "wrap-whole-rows"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "十层都放好了。每层十格，一共一百格。"
        },
        {
          "say": "最上面从一开始，最后停在右下角的一百。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "数到四十九，再向右走一格，到五十。"
        },
        {
          "say": "这层没有空位了。五十一回到下一层最左边。"
        },
        {
          "say": "五十和五十一数起来紧挨着，格子却不挨着。"
        },
        {
          "say": "倒数也一样。从五十一退到上一层末尾的五十。"
        },
        {
          "say": "记住换行的位置，再来玩一段票号路。"
        },
        {
          "say": "箭头向右。从十六往后，每次多一。"
        },
        {
          "say": "从五十八往后数。遇到整十，也只多一。"
        },
        {
          "say": "箭头向左。从八十八倒着数，每次少一。"
        },
        {
          "say": "看这关的箭头，再从刚才的票号数。"
        },
        {
          "say": "用手指着站稳的数，想紧接的一张。"
        },
        {
          "say": "这一段票号的顺序都对上了。"
        }
      ]
    },
    {
      "key": "counting-platforms",
      "type": "interactive",
      "title": "沿票号跳",
      "widgetType": "courseware_game",
      "page": "counting-platforms",
      "startImage": "hop-ready",
      "script": [
        {
          "setState": {
            "demo": true,
            "level": 1,
            "pause": true
          }
        },
        {
          "highlight": "#counting-direction"
        },
        {
          "say": "箭头向右，这一关每次向后数一个。"
        },
        {
          "highlight": "#game-player"
        },
        {
          "say": "现在站在十六号台。要找紧挨着的下一张。"
        },
        {
          "highlight": "#game-target"
        },
        {
          "say": "下一张是十七号。看清台子再跳。"
        },
        {
          "highlight": "#ticket-jump"
        },
        {
          "say": "按住右箭头，同时点跳跃键。老师先跳一次。"
        },
        {
          "setState": {
            "pause": false
          }
        },
        {
          "highlight": "#counting-result"
        },
        {
          "say": "脚落在十七号。右边留下了十六到十七的图。"
        },
        {
          "say": "交给你。重新从十六开始，只跳紧接着的票号。"
        },
        {
          "setState": {
            "demo": false,
            "level": 1,
            "pause": false
          }
        }
      ],
      "gameAudio": {
        "hop-forward": "next-row-start-9",
        "hop-wrap": "next-row-start-10",
        "hop-backward": "next-row-start-11",
        "hop-hint": "next-row-start-12",
        "hop-help": "next-row-start-13",
        "hop-praise": "next-row-start-14"
      }
    },
    {
      "key": "down-by-one-row",
      "type": "slide",
      "title": "同一列，往下多十",
      "template": "two-columns",
      "data": {
        "title": "同一列，往下多十",
        "left": {
          "heading": "27下面是37",
          "body": "下楼一层，就多十。"
        },
        "left_picture": "same-column-27",
        "right": {
          "heading": "最右一列的个位",
          "body": "70、80、90、100的个位都是0。"
        },
        "right_picture": "same-column-zero"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "换一种走法。指着二十七，正下方是哪格？"
        },
        {
          "say": "下一层同一个位置是三十七。多了一整层的十张。"
        },
        {
          "say": "再下去是四十七。个位一直是七。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "到最右一列看看。七十下面是八十。"
        },
        {
          "say": "再到九十，再到一百。每次也多十。"
        },
        {
          "say": "它们的个位都是零。往上一格就少十。"
        }
      ]
    },
    {
      "key": "mark-a-digit-pattern",
      "type": "slide",
      "title": "给不同的数位做记号",
      "template": "two-columns",
      "data": {
        "title": "给不同的数位做记号",
        "left": {
          "heading": "三种记号可以叠加",
          "body": "短横、圆点和三角各记一种发现。"
        },
        "left_picture": "three-digit-marks",
        "right": {
          "heading": "看40和44的格子",
          "body": "40在上一行末格，44可以有三种记号。"
        },
        "right_picture": "zoom-four-pattern"
      },
      "script": [
        {
          "spotlight": "right-picture"
        },
        {
          "say": "十位是四，给票号画短横。先找四十。"
        },
        {
          "say": "四十在这一层最后。四十一到四十九在下一层。"
        },
        {
          "say": "个位是四，用圆点记。四、十四、二十四排成一列。"
        },
        {
          "say": "两位数的两个数字相同，用三角记。四十四也有。"
        },
        {
          "say": "四十四能留下三个记号。说说每个记号记什么。"
        },
        {
          "spotlight": "left-picture"
        },
        {
          "say": "第一行的一到九，只写个位。它们都是一位数。"
        },
        {
          "say": "一百有三位。它末尾两个零，不算两位数的双号。"
        }
      ]
    },
    {
      "key": "two-ways-down-diagonally",
      "type": "slide",
      "title": "斜着走，先拆成两步",
      "template": "two-columns",
      "data": {
        "title": "斜着走，先拆成两步",
        "left": {
          "heading": "向下再向左",
          "body": "65先到75，再到74。"
        },
        "left_picture": "left-diagonal-65",
        "right": {
          "heading": "向下再向右",
          "body": "65先到75，再到76。"
        },
        "right_picture": "right-diagonal-65"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "从六十五斜着去左下格，可以拆成两步。"
        },
        {
          "say": "先向下到七十五，多十；再向左到七十四，少一。"
        },
        {
          "say": "算起来多九。你可以从七十四往回走来核对。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "去右下格也先到七十五。然后往右到七十六。"
        },
        {
          "say": "多十，再多一。两步一共多十一。"
        },
        {
          "say": "已经在最左边，就没有左下斜格。右边也一样。"
        },
        {
          "say": "到底下一行不存在时，别把斜线接到表外。"
        },
        {
          "say": "箭头朝下。落下的票要比底部配对票多十。"
        },
        {
          "say": "箭头朝上。落下的票要比底部配对票少十。"
        },
        {
          "say": "仍往上找。个位相同，还要正好少十。"
        },
        {
          "say": "箭头又朝下。找正好多十的同列邻号。"
        },
        {
          "say": "继续往下找。只配同列紧挨着的一格。"
        },
        {
          "say": "先看这关的箭头朝上还是朝下。"
        },
        {
          "say": "核对个位，再想移动一层会差多少。"
        },
        {
          "say": "找到同一竖列上真正相邻的票号了。"
        }
      ]
    },
