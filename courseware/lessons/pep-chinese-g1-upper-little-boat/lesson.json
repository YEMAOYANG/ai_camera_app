    {
      "key": "p09",
      "type": "slide",
      "title": "在月亮小船里抬头",
      "template": "picture-points",
      "data": {
        "title": "在月亮小船里抬头",
        "picture": "sky-imagination",
        "points": [
          "先看诗中的船",
          "坐稳，往上看",
          "说自己好像看见什么"
        ]
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "假如月亮真能当小船，你会趴在船边找水，还是抬起脸看一看？"
        },
        {
          "spotlight": "point-1"
