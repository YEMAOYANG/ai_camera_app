  "objectiveBasis": "教材印刷31–33、教案1–4、课件07–26、任务单1–2、作业1。",
  "objectives": [
    "说出眼、耳、鼻、舌、皮肤各能帮我们知道什么，按想找的特征选择感觉器官。",
    "用具体做法保护感觉器官，遇到不明物先停手、离开并问成人。",
    "同一对象先猜再看，用合适的感觉器官或工具找到特征，记录并描述亲自得到的发现。",
    "从物品的外部特征选一条分类标准；换标准以后可以用同一批物品重新分类。",
    "对照记录自评并提出还想知道的具体问题，分清屏幕练习和实际家庭证据。"
  ],
  "keyPoint": "按想了解的外部特征选择合适的感官，安全地获取并描述线索；分类只按当下的一个标准。",
  "difficultPoint": "从同一物件的记录说出真正发现了什么，再提出可以补查的线索。用不同感官或工具时分辨哪种线索由哪种方法取得；实物与口述表现须由成人实际看到、听到。",
  "afterClassExercise": [
    {
      "basis": "官方作业第1页和印刷33",
      "direction": "和家人看一颗洗净苹果的整体和果柄，用手轻摸果皮。画下看见的，请家人记下你说的触感，再提一个问题。",
      "evidence": "成人见到真实做法并听见孩子亲口描述后，记原话和日期。"
    }
  ],
  "weeklyQuestionSource": {
    "method": "按本课五个目标供统一周测选题，每目标约两道原创图题变式。真实口述、实物操作和新问题由成人实际观察。",
    "goals": [
      {
        "id": "organs",
        "practice": [
          "从要找的线索选择器官",
          "比较两种感官各获得什么信息"
        ]
      },
      {
        "id": "protection",
        "practice": [
          "选择降低音量或走远",
          "面对未知液体先停手、问成人"
        ]
      },
      {
        "id": "observation",
        "practice": [
          "先整体再借工具找局部",
          "用同一物件两次记录说一条发现"
        ]
      },
      {
        "id": "classification",
        "practice": [
          "按一种特征分类",
          "同一批物件换一个标准重分"
        ]
      },
      {
        "id": "reflection",
        "practice": [
          "区分已记录的发现与猜测",
          "根据观察记录选一个可以追问的问题"
        ]
      }
    ],
    "postclassPoints": [
      "同一个实物用多种安全方法观察",
      "记录看见和摸到的特点并说清依据",
      "成人实际听记原话和一个新问题",
      "按形分类后可以按色重分"
