      "script": [
        {
          "say": "同一颗苹果，换个方向看，会多看见哪一处？先猜一猜。"
        },
        {
          "spotlight": "left-picture"
        },
        {
          "say": "我先用眼睛从侧面看整颗苹果。外轮廓鼓鼓的，果柄在顶上。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "我再把视线移到正上方。果柄在中间，旁边有一小圈浅凹。"
        },
        {
          "say": "两张图左边都有一片浅色，还是这一颗苹果。"
        },
        {
          "say": "想知道果皮滑不滑，请家长拿一颗洗净的苹果，用手轻轻摸。"
        },
        {
          "say": "想知道有没有气味，用鼻子轻轻闻。照片会帮我们记下看见的样子。"
        },
        {
          "say": "从侧面拍，留下整颗苹果的外轮廓。"
        },
        {
          "say": "从上面拍，找中间的果柄和周围的小凹。"
        },
        {
          "say": "先用箭头框住苹果，等看到的样子和上面小图一样，再按快门。"
        },
        {
          "say": "等一下找出这两种看法，用快门把你真的拍到的图留下来。"
        }
      ]
