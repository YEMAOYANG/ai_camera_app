  "goals": [
    "在图中逐个圈足十件，再数圈外的余量。能说明成组后较容易核数并找一个生活例子。",
    "用十根散小棒和一捆小棒解释十个一是一个十。能用计数器示范右边个位满十，交换成左边十位一颗，数的大小不变。",
    "辨别计数器从右起是个位、再左是十位。同一颗珠的位置不同，表示一个一或一个十；解释10中1和0以及0不可省略。",
    "观察0～9各用一个数字表示。10由已有的1和0组成，把数字、计数器和实物表示互相对应。"
  ],
  "keyPoint": "先把十个一换成一个十，再读它所在的位置。",
  "difficultPoint": "实物虽捆成一捆，仍是原来的十件；计数器珠数不等于它表示的数量。",
  "scenario": "手作角打包桌从散片装十开始，到实物、计数器和标签对照，解释同样是一个为什么有时读十。",
  "pageSequence": [
    {
      "key": "empty-tray",
      "title": "为什么一捆也能表示十？",
      "purpose": "包装桌旁先提出一捆和一根是不是一样，留待用实物和计数器解释。"
    },
    {
      "key": "group-and-count",
      "title": "先把十件圈出来",
      "purpose": "把一排材料逐件圈足十，再数圈外四件，解释如何防重数。"
    },
    {
      "key": "one-bundle",
      "title": "十根松棒，换一捆",
      "purpose": "图示同十根小棒的散开、捆起及解开；数量不变。"
    },
    {
      "key": "marble-pack",
      "title": "弹珠找同量图卡",
      "purpose": "凭听到的成组数量和余量，瞄准漂移目标；只有等量正确表示才记分。"
    },
    {
      "key": "counter-exchange",
      "title": "一颗珠怎么能表示十？",
      "purpose": "个位九颗加一变满十，换成十位一颗，个位清空。"
    },
    {
      "key": "read-the-places",
      "title": "把零留下来",
      "purpose": "右个位左十位；对比同一珠在两位的不同意义，说明0占位、0～9单数字与10用两个旧数字。"
    },
    {
      "key": "parcel-delivery",
      "title": "小车送对数字站",
      "purpose": "实时取货过车道，再按位交付，错误对象和站点都拒绝。"
    },
    {
      "key": "picture-check",
      "title": "换几张新图来验货",
      "purpose": "六道不同量或情境的图题，两题各落在A、B、C，教师读题。"
    },
    {
      "key": "close-tray",
      "title": "一捆十，站对位",
      "purpose": "用盒装例子回扣1根和1捆，复述位置与0，留一项家庭实物任务。"
    }
  ],
  "games": [
    {
      "page": "marble-pack",
      "id": "magnetMarbles",
      "version": 1,
      "entryPoint": "K.gameTemplates.magnetMarbles",
      "rule": "炮台即时横调角度，飞行时可改向。只在命中与当前口令等量且符合分组条件的漂移图靶时计分。",
      "levels": [
        "2次找满十/一捆，宽靶低漂移。",
        "3次辨一捆和同张图圈外余量，增加干扰与速度。",
        "4次口令在松散十、十位一珠、一捆加余量间变化，目标漂移更大。"
      ],
      "noReading": "图靶用小棒、捆、计数器等精确数量图，口令语音可重听，箭头调整。"
    },
    {
      "page": "parcel-delivery",
      "id": "listenDelivery",
      "version": 1,
      "entryPoint": "K.gameTemplates.listenDelivery",
      "rule": "按照口令选散件或成组货，闪避车辆，送到同量的计数器站；取错或送错不推进。",
      "levels": [
        "一单，认一捆和十位一颗个位空，慢车道。",
        "两单，交叉区分个位二和十位一；多车道。",
        "三单，辨个位三、个位五和一个十；增加车道及速度变化。"
      ],
      "noReading": "起终点由大轮廓简图传意，语音分段告诉取什么、送到哪，方向箭头和装卸键可见。"
    }
  ],
