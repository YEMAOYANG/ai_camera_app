  "scenes": [
    {
      "key": "p01",
      "type": "slide",
      "title": "植物小画室",
      "template": "title-picture",
      "data": {
        "title": "植物小画室",
        "picture": "plants-nearby",
        "caption": "看样子，找线索"
      },
      "script": [
        {
          "spotlight": "title"
        },
        {
          "say": "小朋友们好，欢迎来到植物小画室。"
        },
        {
          "say": "今天我们先看清楚，再给植物画一张像。"
        },
        {
          "spotlight": "picture"
        },
        {
          "say": "先看左边这盆绿萝，叶片宽宽的。"
        },
        {
          "say": "中间是吊兰，这株有细长的弯叶。"
        },
        {
          "say": "右边的仙人球圆圆的，图上能看到尖刺。"
        },
        {
          "say": "它们都在架子上，可各有各的样子。"
        },
        {
          "spotlight": "caption"
        },
        {
          "say": "想让别人认出你的画，就要留下真的线索。"
        },
        {
          "say": "看它长在哪里，还要看它的样子。"
        }
      ]
    },
    {
      "key": "p02",
      "type": "slide",
      "title": "看清这株吊兰",
      "template": "picture-points",
      "data": {
        "title": "看清这株吊兰",
        "picture": "spider-plant-observation",
        "points": [
          "透明杯里有水",
          "叶子又细又长",
          "能看见浅色的根"
        ]
      },
      "script": [
        {
          "spotlight": "title"
        },
        {
          "say": "今天我们来仔细看一株吊兰。"
        },
        {
          "say": "观察时，先看眼前的这一株。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "先找透明水杯，看看杯里的水线。"
        },
        {
          "say": "画上这个位置，别人就知道它在哪里。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "再看看叶子，细细长长的，还带着弯。"
        },
        {
          "say": "叶子从杯口伸出来，有的向两边垂。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "透过杯壁，能见到一些浅色的根。"
        },
        {
          "say": "这里看得见，就可以记到画上。"
        },
        {
          "say": "遇到挡住的地方，留空就好。"
        }
      ]
    },
    {
      "key": "p03",
      "type": "interactive",
      "title": "放大镜找线索",
      "page": "observe",
      "widgetType": "observation_zoom",
      "startImage": "cover-plant-studio",
      "script": [
        {
          "say": "小朋友们，我们用放大镜来找线索。"
        },
        {
          "say": "先看老师怎么找，再按同样的顺序找。"
        },
        {
          "highlight": "#observe-cup"
        },
        {
          "setState": {
            "focus": 0
          }
        },
        {
          "say": "先点杯壁旁边，放大就能找见水线。"
        },
        {
          "say": "画杯子时，这一圈能提醒我们水在哪里。"
        },
        {
          "highlight": "#observe-leaf"
        },
        {
          "setState": {
            "focus": 1
          }
        },
        {
          "say": "接着点上面的镜子，看细长的弯叶。"
        },
        {
          "say": "叶子的弯处，是让画更像的线索。"
        },
        {
          "highlight": "#observe-root"
        },
        {
          "setState": {
            "focus": 2
          }
        },
        {
          "say": "最后点杯子里面，放大看看浅色的根。"
        },
        {
          "say": "用眼睛观察就行，不用拉它。"
        },
        {
          "setState": {
            "practice": true
          }
        },
        {
          "say": "轮到你了，按杯子、叶子、根的顺序找。"
        }
      ]
    },
    {
      "key": "p04",
      "type": "slide",
      "title": "三笔画成记录",
      "template": "picture-points",
      "data": {
        "title": "三笔画成记录",
        "picture": "spider-portrait",
        "points": [
          "先画水杯和水线",
          "接着画细长弯叶",
          "最后画可见的根"
        ]
      },
      "script": [
        {
          "spotlight": "title"
        },
        {
          "say": "我们用笔画一张吊兰的观察记录。"
        },
        {
          "say": "像不像，要拿画和实物对照。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "先画水杯，再加上看到的水线。"
        },
        {
          "say": "这样能记住这株吊兰长在哪里。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "沿着实物看，叶子从杯口向外弯。"
        },
        {
          "say": "把细长的叶形画下来，再比一比。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "最后画透过杯壁看见的浅色根。"
        },
        {
          "say": "眼前没有看到花，就不用添花。"
        },
        {
          "say": "名字可以讲给大人听，请大人帮着写。"
        }
      ]
    },
    {
      "key": "p05",
      "type": "interactive",
      "title": "给眼前这株画像",
      "page": "assemble",
      "widgetType": "portrait_layers",
      "startImage": "practice-plant-observation",
      "script": [
        {
          "say": "换一株绿萝，看看眼前的植物长什么样。"
        },
        {
          "say": "左边是实物，右边的纸等着我们来画。"
        },
        {
          "highlight": "#assemble-pot"
        },
        {
          "setState": {
            "layer": 0
          }
        },
        {
          "say": "先看它的容器，红褐色的盆口有土。"
        },
        {
          "say": "把相同的盆放进画纸，就记住了位置。"
        },
        {
          "highlight": "#assemble-leaf"
        },
        {
          "setState": {
            "layer": 1
          }
        },
        {
          "say": "再看看宽叶，叶尖往下，像个小心形。"
        },
        {
          "say": "把这种叶子放上去，画就更像实物。"
        },
        {
          "highlight": "#assemble-detail"
        },
        {
          "setState": {
            "layer": 2
          }
        },
        {
          "say": "叶面还能看到几条线，把它们也记下。"
        },
        {
          "say": "根被土遮住了，我们不把它猜进画里。"
        },
        {
          "setState": {
            "practice": true
          }
        },
        {
          "say": "现在自己选图卡，点一下或拖到画纸上。"
        },
        {
          "say": "先画盆，再画叶，最后找叶面线条。"
        }
      ]
    },
    {
      "key": "p06",
      "type": "interactive",
      "title": "拿画和实物对一对",
      "page": "correct",
      "widgetType": "portrait_revision",
      "startImage": "edit-plant-observation",
      "script": [
        {
          "say": "同学们，我们继续来当小小观察员。"
        },
        {
          "say": "左边是这盆薄荷，右边是要修改的画。"
        },
        {
          "highlight": "#edit-flower-button"
        },
        {
          "setState": {
            "correction": 0
          }
        },
        {
          "say": "画上多了一朵花，左边却没有看见。"
        },
        {
          "say": "先把多画的花拿掉，只记下看到的。"
        },
        {
          "highlight": "#edit-pot-button"
        },
        {
          "setState": {
            "correction": 1
          }
        },
        {
          "say": "左边是鼓鼓的蓝花盆，不是透明杯。"
        },
        {
          "say": "换成蓝花盆，位置这条线索就对了。"
        },
        {
          "highlight": "#edit-leaf-button"
        },
        {
          "setState": {
            "correction": 2
          }
        },
        {
          "say": "再看叶边，左边能看见一圈小尖齿。"
        },
        {
          "say": "把光滑圆叶换掉，才像这盆薄荷。"
        },
        {
          "setState": {
            "practice": true
          }
        },
        {
          "say": "轮到你了，依次对一对花、花盆和叶形。"
        }
      ]
    },
    {
      "key": "p07",
      "type": "slide",
      "title": "介绍和爱护",
      "template": "picture-points",
      "data": {
        "title": "介绍和爱护",
        "picture": "sharing-and-care",
        "points": [
          "说说植物的名字",
          "说出样子和位置",
          "听一听，轻轻看"
        ]
      },
      "script": [
        {
          "spotlight": "title"
        },
        {
          "say": "画好之后，可以介绍你的植物朋友。"
        },
        {
          "say": "看这两个小朋友，把画和实物放在一起。"
        },
        {
          "spotlight": "point-1"
        },
        {
          "say": "先说它叫什么，让伙伴知道你画了谁。"
        },
        {
          "say": "名字忘了，可以先请大人帮你认一认。"
        },
        {
          "spotlight": "point-2"
        },
        {
          "say": "再说它的叶子什么样，长在哪里。"
        },
        {
          "say": "比如宽宽的绿叶，从红褐色的盆里伸出。"
        },
        {
          "spotlight": "point-3"
        },
        {
          "say": "伙伴在说时，先听一听他的发现。"
        },
        {
          "say": "观察只用眼睛，不拔叶，也不拉枝条。"
        },
        {
          "say": "想指出一片叶，可以指画上的那片。"
        }
      ]
    },
    {
      "key": "p08",
      "type": "interactive",
      "title": "今天一张，下次一张",
      "page": "journal",
      "widgetType": "observation_journal",
