      "script": [
        {
          "say": "同一株植物，今天和下次都能画下来。"
        },
        {
          "say": "左边是第一次，右边是后来看到的样子。"
        },
        {
          "highlight": "#journal-first-slot"
        },
        {
          "setState": {
            "time": 0
          }
        },
        {
          "say": "先看左图，蓝纹花盆里的小苗还很矮。"
        },
        {
          "say": "把那一次的画像放进第一个夹子。"
        },
        {
          "highlight": "#journal-second-slot"
        },
        {
          "setState": {
            "time": 1
          }
        },
        {
          "say": "后来同一株上面又多出一对小叶。"
        },
        {
          "say": "把后来那张放进第二个夹子。"
        },
        {
          "highlight": "#journal-reference"
        },
        {
          "say": "两张画都收好，下次才有东西可以比。"
        },
        {
          "say": "画每次亲眼看到的样子，不猜会长多快。"
        },
        {
          "setState": {
            "practice": true
          }
        },
        {
          "say": "轮到你了，先放第一次，再放下一次。"
        }
      ]
    },
