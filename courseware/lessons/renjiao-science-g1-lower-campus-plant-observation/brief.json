  "goals": [
    "能在成人陪同下观察校园植物，先看整株，再看叶、花或树皮等局部，用可见证据比较两株。",
    "能用画、拓树皮或拍照片留下所见，并标明观察对象和特点，没观察的先留空。",
    "能整理两三条观察所得，用名称或暂记编号、样子、特点向同伴介绍一株植物。",
    "知道园艺师种植和养护植物，能设计一块有名称及一条查证特点的植物标识牌，爱护校园植物。"
  ],
  "goalSources": [
    "印25–27、教案1.2",
    "印27–28、教案1.3",
    "印28、教案2.2",
    "印29–30、教案2.3–4"
  ],
  "scenario": "原创松风校园观察簿。先看整株，拿一条局部证据对照，实操完成照片后整理成小展牌。",
  "pageSequence": [
    {
      "key": "school-plant-walk",
      "kind": "teaching",
      "plan": "用不同校园植物引入，站在安全路径，不采摘。"
    },
    {
      "key": "same-yellow-different",
      "kind": "teaching",
      "plan": "用枝形和一朵的花形区分两株黄花样本。"
    },
    {
      "key": "whole-then-detail",
      "kind": "teaching",
      "plan": "柳树整株与下垂枝/窄叶，多角度看而不攀折。"
    },
    {
      "key": "rub-the-bark",
      "kind": "teaching",
      "plan": "整株后选完整安全的树皮区，覆纸，横拿蜡笔轻拓、记名称。"
    },
    {
      "key": "campus-plant-photos",
      "kind": "game",
      "plan": "同一枝迎春、连翘和柳的俯侧实拍，留每关图。"
    },
    {
      "key": "match-plant-evidence",
      "kind": "game",
      "plan": "把局部证据弹珠送到同一株的整株照片上。"
    },
    {
      "key": "report-what-you-saw",
      "kind": "teaching",
      "plan": "按名称、样子、可见特点记录，复看照片，没观察的留空。"
    },
    {
      "key": "meet-the-gardener",
      "kind": "teaching",
      "plan": "看种植、浇水、按需修剪，尊重园艺师劳动。"
    },
    {
      "key": "make-a-plant-sign",
      "kind": "teaching",
      "plan": "画原创新名牌，以查到的名称、图片和一条确证特点标记。"
    },
    {
      "key": "picture-quiz",
      "kind": "quiz",
      "plan": "六道原创图题，覆盖证据、整体局部、记录、园艺和标识。"
    },
    {
      "key": "home-plant-observation",
      "kind": "teaching",
      "plan": "成人带去安全公共区域观察，记录实际所见，不留住址或真实学校名。"
    }
  ],
