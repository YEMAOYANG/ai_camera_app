  "lesson": "四季",
  "goals": [
    "认读十二个字和三个偏旁，语境区分地的读音。",
    "认识四小节与叠词，借图读出四个角色的语气。",
    "把景物和形状特点联系到课文四季，理解鞠躬和顽皮。",
    "比较对谁说与怎样说，借图片仿说喜欢的季节。",
    "观察四小鸟是天，描画后请成人看纸笔练习。"
  ],
  "keyPoint": "字词、偏旁、叠词与四季景物、朗读仿说、五字观察。",
  "difficultPoint": "把图意、语气和句式连起来表达。",
  "officialHours": [
    "lesson_1",
    "lesson_2"
  ],
  "interactionPlan": {
    "characters": "十二字同形比较，目标字是教学对象，不靠非目标文字操作。",
    "radicals": "把言字旁、提土旁、折文送到相应目标字旁。",
    "seasons": "景物图片真实移入四季图册。",
    "shapes": "听叠词找尖、圆、弯的本课正式图片。",
    "dialogue": "依次观察草芽和荷叶说话角色，把任意听众图片放到对面作仿说准备，理解对谁说；实际口头表达待家人观察。",
    "theatre": "操作谷穗弯身与雪人挺肚子，体会怎样说。",
    "postcard": "选择景物生成看图仿说卡；实际口头表达保留待观察。",
    "trace": "五字田字格自由描画，只计覆盖，纸笔与笔顺待成人观察。"
  },
