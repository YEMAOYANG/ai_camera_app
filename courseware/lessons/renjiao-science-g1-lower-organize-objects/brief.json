  "goals": [
    "能描述常见书包与简单布袋的结构、优点和适用任务，知道收纳用具的结构帮助完成某项用途。",
    "能按用品用途、形状或取用需要给物品分组，根据给定书包的不同袋位收纳并说出试取理由。",
    "能在生活场景选用挂、分格、装小盒和改变摆放方向等方法，使物品整齐、便于取用并较好利用空间。",
    "能在成人陪同下观察并整理一小处，用实际取用、整齐和盒盖能否合上等证据比较方案。"
  ],
  "goalSources": [
    "印54、教案2",
    "印55、任务单2",
    "印55–56、教案3",
    "印56–57、课件15"
  ],
  "scenario": "原创松风校园阅读角与手作桌。从找一件用品出发，按任务给物品安排位置，再旋转小盒试盖、记录取用结果。",
  "pageSequence": [
    {
      "key": "find-the-item",
      "kind": "teaching",
      "plan": "同一件用品散放和分类放对照，说明摆齐与能取用。"
    },
    {
      "key": "bag-or-tote",
      "kind": "teaching",
      "plan": "有分袋的书包与大开口布袋，各自适合不同任务。"
    },
    {
      "key": "pick-a-pocket",
      "kind": "teaching",
      "plan": "大册、常用小件和盖紧水瓶分别按这只包的袋位选，实际试取。"
    },
    {
      "key": "carry-to-the-pocket",
      "kind": "game",
      "plan": "开小车选物件再送入合适袋位，错取、错送不计进度。"
    },
    {
      "key": "storage-in-daily-life",
      "kind": "teaching",
      "plan": "按物件形状和取用需要选择挂、分格或装小盒。"
    },
    {
      "key": "turn-and-fit",
      "kind": "teaching",
      "plan": "同一箱同样物件改方向以减少空隙，侧看盒盖能合。"
    },
    {
      "key": "photograph-neat-storage",
      "kind": "game",
      "plan": "三件收纳样品的实际俯侧取景，记录位置、隔板和盖合结果。"
    },
    {
      "key": "check-the-plan",
      "kind": "teaching",
      "plan": "说明看见的结构、模拟的结果和需要现实试取的差别。"
    },
    {
      "key": "picture-quiz",
      "kind": "quiz",
      "plan": "新物件图检查袋位、分组、装箱、试取和用途。"
    },
    {
      "key": "home-organize-observation",
      "kind": "teaching",
      "plan": "选小处前后比较，试取一件并据实画下。"
    }
  ],
