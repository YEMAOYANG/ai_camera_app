  "scenes": [
    {
      "key": "review-at-the-exhibit",
      "type": "slide",
      "title": "读书展要整理算式路标",
      "template": "two-columns",
      "data": {
        "title": "读书展要整理算式路标",
        "left": {
          "heading": "两位小帮手",
          "body": "一起清点展台的书签。"
        },
        "left_picture": "library-opening",
        "right": {
          "heading": "一组十和散的四张",
          "body": "原有十四张，借走八张。"
        },
        "right_picture": "fourteen-on-table"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "社区读书展开门了。小禾和小满来帮忙。"
        },
        {
          "say": "他们还要整理一条算式小路。先算一题热身。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "台上原有一组十张书签，旁边还有四张。"
        },
        {
          "say": "十加四是十四。要给另一桌借走八张。"
        },
        {
          "say": "要问余下多少，算十四减八。"
        },
        {
          "say": "散的四张不够直接拿八张。你会怎样拿？"
        },
        {
          "say": "想一想单元里学过的三种办法。"
        }
      ]
    },
    {
      "key": "three-ways-to-check",
      "type": "slide",
      "title": "破十和连减，哪一步不同",
      "template": "two-columns",
      "data": {
        "title": "破十和连减，哪一步不同",
        "left": {
          "heading": "从十里拿八",
          "body": "十里余二，与散四合成六。"
        },
        "left_picture": "break-eight",
        "right": {
          "heading": "先拿散四",
          "body": "回到十，再拿还差的四。"
        },
        "right_picture": "chain-eight"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "从一组十里借走八张，十里余两张。"
        },
        {
          "say": "旁边四张没动。二加四，留下六张。"
        },
        {
          "say": "破十拆开的是原来的十四，十和四分开。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "连减先拿散四。十四减四，先回到十。"
        },
        {
          "say": "总共得拿八，还差四。再从十里借四。"
        },
        {
          "say": "这回拆开的是要拿走的八，分成四和四。"
        },
        {
          "say": "两种摆法都拿走八张，所以余量同样是六。"
        }
      ]
    },
    {
      "key": "restore-to-check",
      "type": "slide",
      "title": "用加法检查余量",
      "template": "title-picture",
      "data": {
        "title": "用加法检查余量",
        "picture": "check-six",
        "caption": "借走的和留下的，合回原来的总数。"
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "还可以把借走的和留下的合起来检查。"
        },
        {
          "say": "第一排八张，是刚刚借出去的那部分。"
        },
        {
          "say": "另一部分是六张。两份合起来，正好十四。"
        },
        {
          "say": "会算八加六是十四，就能想十四减八等于六。"
        },
        {
          "say": "这个办法叫想加算减，也能验证前两种。"
        },
        {
          "say": "这三种方法都要弄清原来、借出和留下。"
        },
        {
          "say": "会算了，就可以把这样的退位算式排起来。"
        }
      ]
    },
    {
      "key": "fill-the-table",
      "type": "slide",
      "title": "找到退位减法表缺的一格",
      "template": "title-picture",
      "data": {
        "title": "找到退位减法表缺的一格",
        "picture": "table-one-gap",
        "caption": "横看被减数，竖看减数。"
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "这张表从十开始。每一排左边都从减九起。"
        },
        {
          "say": "先看第三排。这一排开头的原数都是十二。"
        },
        {
          "say": "再看问号在第几列。往上找，都是减六。"
        },
        {
          "say": "原数是十二，减数是六。缺的是哪张卡？"
        },
        {
          "say": "十二的个位是二，不够减六，正好属于这张表。"
        },
        {
          "say": "表上每一格，只放一张符合位置的卡。"
        },
        {
          "say": "补对这一格，我们就能检查整张表。"
        }
      ]
    },
    {
      "key": "check-the-whole-table",
      "type": "slide",
      "title": "看完整的四十五格",
      "template": "title-picture",
      "data": {
        "title": "看完整的四十五格",
        "picture": "table-all-45",
        "caption": "从 10 减 9 到最后一格 18 减 9。"
      },
      "script": [
        {
          "spotlight": "picture"
        },
        {
          "say": "刚才空的那一格补上十二减六。"
        },
        {
          "say": "最上面一排是十减九到十减一，有九格。"
        },
        {
          "say": "往下一排，原数多一。可放的卡少一张。"
        },
        {
          "say": "到最后一排，只剩十八减九这一格。"
        },
        {
          "say": "每排少一格。全部数一遍，共四十五格。"
        },
        {
          "say": "十九减九的个位够减，属于另一类，不进这里。"
        },
        {
          "say": "顺着一排、一列和斜线看，会有什么发现？"
        }
      ]
    },
    {
      "key": "read-row-and-column",
      "type": "slide",
      "title": "一排和一列，哪个数不变",
      "template": "two-columns",
      "data": {
        "title": "一排和一列，哪个数不变",
        "left": {
          "heading": "同一排往右",
          "body": "原有十二不变，取走少一个。"
        },
        "left_picture": "same-row",
        "right": {
          "heading": "同一列往下",
          "body": "取走九个不变，原有多一个。"
        },
        "right_picture": "same-column"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "先放大同一排。十二减九、减八、减七。"
        },
        {
          "say": "原来的十二不变。往右每次少拿一个。"
        },
        {
          "say": "没拿走的就多一个。差从三到四，再到五。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "同一列都是减九。原数十二、十三、十四。"
        },
        {
          "say": "往下一格，原来多一个。拿走的九不变。"
        },
        {
          "say": "原来多的那个留下来，差也每次多一个。"
        },
        {
          "say": "两条路的差都变了。你能说出不变的数吗？"
        }
      ]
    },
    {
      "key": "diagonal-keeps-the-difference",
      "type": "slide",
      "title": "往左下一格，差为什么不变",
      "template": "two-columns",
      "data": {
        "title": "往左下一格，差为什么不变",
        "left": {
          "heading": "原来和拿走各多一",
          "body": "三次留下的部分对齐。"
        },
        "left_picture": "same-diagonal",
        "right": {
          "heading": "找一条同差的斜线",
          "body": "两种量一同加一，也可倒着一同减一。"
        },
        "right_picture": "diagonal-arrows"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "十三减六等于七。十四减七呢？"
        },
        {
          "say": "原来的多一张，同时拿走的也多一张。"
        },
        {
          "say": "多出来的那张正好被拿走，所以仍是七。"
        },
        {
          "say": "十五减八也是这样。三排留下的一样多。"
        },
        {
          "spotlight": "right-picture"
        },
        {
          "say": "回到表里，就是往左下一格。"
        },
        {
          "say": "倒过来，原数和减数各少一，差也不变。"
        },
        {
          "say": "下面按三种方向跳。每次都找紧接的一格。"
        },
        {
          "say": "同一列往下，减数八不变，原数每次加一。"
        },
        {
          "say": "同一排往右，原来的十五不变，少减一个。"
        },
        {
          "say": "往左下走。原数和减数各加一，差不变。"
        },
        {
          "say": "先想这条路的规律。"
        },
        {
          "say": "沿小图的箭头走，看两个数怎样变。"
        },
        {
          "say": "这一格接得上。可以继续走下一格。"
        }
      ]
    },
    {
      "key": "hop-along-the-table",
      "type": "interactive",
      "title": "按减法表的规律跳",
      "widgetType": "courseware_game",
      "page": "hop-along-the-table",
      "startImage": "hop-ready",
      "script": [
        {
          "setState": {
            "demo": true,
            "level": 1,
            "pause": true
          }
        },
        {
          "say": "先听这一关的规律，再往下一张卡跳。"
        },
        {
          "highlight": "#route-direction"
        },
        {
          "say": "箭头朝下。这一列的减数八要一直不变。"
        },
        {
          "highlight": "#game-player"
        },
        {
          "say": "脚下是十二减八，下一格原数多一。"
        },
        {
          "highlight": "#game-target"
        },
        {
          "say": "找十三减八。这里的八还在原位。"
        },
        {
          "highlight": "#jump-to-card"
        },
        {
          "say": "按住右方向，点跳跃键。老师只跳这一格。"
        },
        {
          "setState": {
            "pause": false
          }
        },
        {
          "say": "脚真的落到这张卡，才把这一格点亮。"
        },
        {
          "highlight": "#landed-quantity"
        },
        {
          "say": "右边留下实际落到的算式和五张书签。"
        },
        {
          "say": "到你。听清哪一条路，再选下一张卡。"
        },
        {
          "setState": {
            "demo": false,
            "level": 1,
            "pause": false
          }
        }
      ],
      "gameAudio": {
        "hop-column": "diagonal-keeps-the-difference-10",
        "hop-row": "diagonal-keeps-the-difference-11",
        "hop-diagonal": "diagonal-keeps-the-difference-12",
        "hop-hint": "diagonal-keeps-the-difference-13",
        "hop-help": "diagonal-keeps-the-difference-14",
        "hop-praise": "diagonal-keeps-the-difference-15"
      }
    },
    {
      "key": "find-the-relevant-part",
      "type": "slide",
      "title": "哪两个量真的与问题有关",
      "template": "two-columns",
      "data": {
        "title": "哪两个量真的与问题有关",
        "left": {
          "heading": "书签分两桌",
          "body": "两桌一共十六张，一桌有七张。"
        },
        "left_picture": "bookmark-missing",
        "right": {
          "heading": "求的只是另一部分",
          "body": "把找到的两份合回来复核。"
        },
        "right_picture": "part-not-total"
      },
      "script": [
        {
          "spotlight": "left-picture"
        },
        {
          "say": "两个展台一共十六张书签。左桌有七张。"
        },
        {
          "say": "右桌要放几张？这个问题只问书签。"
        },
        {
          "say": "桌边有三把剪刀。它不属于书签总量。"
        },
        {
          "say": "所以用总的十六减已知的七，不用减三。"
        },
        {
          "spotlight": "right-picture"
