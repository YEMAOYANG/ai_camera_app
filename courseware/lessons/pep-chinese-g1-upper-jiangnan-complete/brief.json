  "interactionPlan": {
    "p02": "把江字卡送到流动河水旁，位置变化再做一次，三点水亮起。",
    "p05": "九个目标字轮换，与随机位置莲叶上的同字匹配；只说明字形匹配，不宣称自主认读。",
    "p07": "把停顿符号送入诗句间隙，符号真实落位；只验证听辨位置。",
    "p08": "两片空水面由代码放置正式叶片，比较疏密，小鱼游入选区。",
    "p10": "看方位字，把鱼送向相应水域。",
    "p12": "反向任务：看鱼位置，把方位字放进叠句末尾。",
    "p14": "将六幅诗意图按先莲叶、再小鱼、再东/西/南/北放入槽，图卡移动。",
    "p17": "区分竖弯与竖弯钩末端，再由上往下、圆转向右连接竖弯轨迹；不演示整字笔顺。",
    "p18": "可、叶、东、西四字大字形画布，按字自由描、可清除；覆盖率只解锁下一字，不评笔顺。"
  },
  "slidePlan": {
    "p01": "看原创水乡图，听读江南。教师指出江的三点水，再联系图中的流水，拼音只出现在画面。",
    "p03": "在原创莲塘图中指出莲，老师用采下莲蓬的动作说明可、采、莲连起来的意思，再观察莲的草字头。",
    "p04": "看小鱼与叶片的空隙，解释戏是玩耍，间指莲叶之间。",
    "p06": "把全诗按教材顺序同时呈现，老师逐组指读，讲词义和画面。",
    "p09": "用一幅池塘图短暂回顾九字与田田，为继续学习四方留休息点。",
    "p11": "对照四句，逐句高亮相同开头和变化的方向。",
    "p13": "由老师示范按莲叶、小鱼、四方联想，逐步减少文字提示。",
    "p15": "比较可和叶的口部件，示范可的竖钩竖段写直。",
    "p16": "对照田字格看东、西，指出已核实的竖钩、竖弯位置。",
    "p22": "回顾偏旁、读诗、四方、背诵和观察写字，交代家庭观察与课后练习。"
  },
