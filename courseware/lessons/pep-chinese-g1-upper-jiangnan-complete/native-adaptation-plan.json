  "quiz": {
    "p19": [
      {"mode": "baseline_stem", "nativeReason": "原生题只问有水，并把带池塘的拍球图列为干扰；保留三点水与水义的关系，使用山路、树枝、洗手三种清楚图义。"},
      {"mode": "native_stem", "nativeReason": "保留原生题对莲叶又多又密的提问，给出已登记的茂盛、稀疏和空水面图。"}
    ],
    "p20": [
      {"mode": "baseline_stem", "nativeReason": "每幅图只有一艘船，题干问哪一幅。固定荷叶和纸船图元后按代码摆位。"},
      {"mode": "baseline_stem", "nativeReason": "把原生稿倒置的参照关系改成小纸船在荷叶北边。固定荷叶和纸船图元后按代码摆位。"}
    ],
    "p21": [
      {"mode": "baseline_stem", "nativeReason": "原生稿的拍球和打水仗都可能是玩耍，换用拍球、睡觉、洗手三个动作，只有一个正确选项。"},
      {"mode": "baseline_stem", "nativeReason": "把原生稿缺失的两句听题材料补齐，用小鸟飞往两处的原创句子检验共同动作。"}
    ]
  },
  "excludedNativeElements": {
    "p03": "以采摘莲蓬作为采莲的情境例子。省去资料未教的花后发育知识，以及对原创新莲塘图中未显示的莲蓬特写的指认。",
    "p09": "去掉超出本课的六个临时汉字，保留原生的中段休息和追鱼过渡。",
