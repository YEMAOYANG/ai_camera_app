                "top": {
                  "shadow-top-noon-model": {
                    "label": "黄球在南侧，杆影伸向北",
                    "image": "shadow-top-noon-model"
                  }
                },
                "side": {
                  "shadow-side-noon-model": {
                    "label": "黄球摆得高，杆影较短",
                    "image": "shadow-side-noon-model"
                  }
                }
              }
            ]
          },
          {
            "label": "傍晚模型",
            "trials": [
              {
