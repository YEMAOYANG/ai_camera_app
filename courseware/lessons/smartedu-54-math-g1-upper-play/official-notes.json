  "objectiveBasis": "依据沪教版五四学制准确教材印刷第2页正文整理的原创目标。",
  "objectives": [
    "看图认出几种熟悉的游戏，并和伙伴商量选择一个游戏一起玩。",
    "先听清约好的规则再行动，能在游戏中照口令做并回看是否符合规则。",
    "在合作游戏中轮到自己才操作，伙伴操作时在自己的位置等一等。"
  ],
  "keyPoint": "一起选一个游戏，先听约定，按规则参加，轮流操作。",
  "difficultPoint": "在玩得兴奋时仍能等到口令或轮到自己，伙伴操作时留出位置。",
  "contentBoundary": {
    "included": [
      "四种教材情境可选其一",
      "遵守约定与文明参与",
      "等待、轮流、给伙伴留出位置的原创操作支架"
    ],
    "excluded": [
      "无固定的跳房子或积木统一规则，本课讲清具体活动的事先约定。",
      "不引入数学算式、形体术语或下一课方位教学；少量人数只用于照口令参加游戏。",
      "真实合作、遵守规则、口头说明和线下操作由成人观察。线上作答只表示当下选择。"
    ]
  },
