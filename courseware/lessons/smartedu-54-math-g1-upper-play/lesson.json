        {
          "say": "我先请一位进来，垫子里有一个。"
        },
        {
          "setState": {
            "demo": "two"
          }
        },
        {
          "say": "再请一位进来，现在有两个。"
        },
        {
          "highlight": "#group-confirm"
        },
        {
          "say": "我点着他们数，确认和口令一样。"
        },
        {
          "setState": {
            "play": true
          }
        },
        {
          "say": "现在你来。点伙伴，或把伙伴拖进垫子。"
        },
        {
          "say": "请两个伙伴到垫子里，再点确认。"
        },
        {
          "say": "下一轮请三个伙伴到垫子里。"
        },
        {
          "say": "想再听一遍，就点喇叭。"
        }
      ]
