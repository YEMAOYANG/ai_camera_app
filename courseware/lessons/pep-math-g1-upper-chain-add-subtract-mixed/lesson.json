{
  "schemaVersion": "mira.courseware.lesson.v1",
  "title": "连加、连减  加、减混合",
  "description": "跟着小数老师整理社区读书角，观察先后两次变化，学会用第一步的结果接着算。",
  "grade": 1,
  "roster": {
    "teacher": {"name": "小数老师", "role": "teacher", "gender": "male", "voice": "Ethan", "avatar": "/teachers/ashu-math-v1.png", "color": "#4A90D9", "persona": "用清楚短句和实物数量解释两次变化，示范第一步怎样接到第二步。"}
  },
