      "plan": "同样的图样放样片后比较透明和反光；实物触感待观察。"
    },
    {
      "key": "same-shape-different-material",
      "kind": "teaching",
      "plan": "同形同用途的木托盘和塑料托盘比较材料线索。"
    },
    {
      "key": "material-docks",
      "kind": "game",
      "plan": "推车按对象材料送到真实材料样片托盘。"
    },
    {
      "key": "each-part-has-a-job",
      "kind": "teaching",
      "plan": "凳面和凳腿用材、可见线索及各部位用途。"
    },
    {
      "key": "material-photo-pairs",
      "kind": "game",
      "plan": "同物实际普通输入拍俯侧，提取不同部位的视觉线索。"
    },
    {
      "key": "evidence-not-a-guess",
      "kind": "teaching",
      "plan": "把已见和待观察分开，解释为什么分类、为什么选材。"
    },
    {
      "key": "picture-quiz",
      "kind": "quiz",
      "plan": "六道新对象或情境，覆盖材料分类、比较、不同部位及可靠记录。"
    },
    {
      "key": "home-material-observation",
      "kind": "teaching",
      "plan": "和成人实际观察一物两部位，留下图和真实证据。"
    }
