  "quiz": [
    {
      "id": "why-borrow-early",
      "skill": "story-cause",
      "prompt": "新故事卡要画小壁虎为什么出门借尾巴。哪组小画能说明原因？",
      "answer": "墙角遇蛇脱身",
      "position": 2,
      "rationale": "它在墙角遇蛇，挣断尾巴逃开。没有尾巴才想去借。"
    },
    {
      "id": "cow-tail-use",
      "skill": "tail-use",
      "prompt": "新道具牌要画老牛用尾巴做什么。哪张图画得合适？",
      "answer": "甩尾赶苍蝇",
      "position": 1,
      "rationale": "故事里的老牛用尾巴赶苍蝇。这张画里尾巴甩向苍蝇，苍蝇飞开。"
    },
    {
      "id": "where-after-cow",
      "skill": "where-next",
      "prompt": "小壁虎刚在大树那儿问过老牛。下一幅卡该放哪儿？",
      "answer": "房檐下",
      "position": 3,
      "rationale": "大树之后它到了房檐下，向燕子借尾巴。"
    },
    {
      "id": "ask-for-a-book",
      "skill": "polite-question",
      "prompt": "小禾想向同伴借一本图画书。哪张画最适合读一句礼貌的问话？",
      "answer": "面对同伴问",
      "position": 2,
      "rationale": "先面对同伴，用话问能不能借，等对方回答。这张画表现出这个动作。"
    },
    {
      "id": "turned-to-find",
      "skill": "discover-or-grow",
      "prompt": "纸偶演到妈妈让小壁虎转过身。下一幅小画要表现它发现了什么？",
      "answer": "转身看到新尾",
      "position": 1,
      "rationale": "转身后它看到自己已经有一条新尾巴，原来不用再借。"
    },
    {
      "id": "gan-stroke-order",
      "skill": "stroke-rule",
      "prompt": "字卡只保留赶字先写的外面部分。应选哪幅图？",
      "answer": "只画走字旁",
      "position": 3,
      "rationale": "赶先写走字旁，再写右边的干。这张只画先写的走字旁。"
    },
    {
      "id": "eaves-picture",
      "skill": "guess-word",
      "prompt": "听，小鸟飞到屋子的房檐下。哪幅图能帮助猜出房檐是什么？",
      "answer": "屋瓦伸出的边下",
      "position": 2,
      "rationale": "房檐是屋顶伸出墙外的部分。小鸟正在这一部分的下面。"
    }
  ],
