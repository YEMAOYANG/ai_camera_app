  "quizPlan": [
    {
      "id": "age-question-meaning",
      "goal": "goal-1",
      "answer": "b",
      "visualMeaning": "比较打招呼、指年龄牌、指有头像的姓名卡，只有B问年龄。",
      "prompt": "How old are you? 这句话问什么？",
      "skill": "听辨问年龄",
      "analysis": "这句话问对方几岁。指年龄牌的采访图符合。挥手是招呼，头像卡提示在问名字。"
    },
    {
      "id": "hear-eight",
      "goal": "goal-2",
      "answer": "c",
      "visualMeaning": "新口令八岁。三张同形正向年龄牌中，只有C是8。",
      "prompt": "I'm eight. 听到几岁？选那张牌。",
      "skill": "听年龄回答找数字",
      "analysis": "eight 是八。找到形状相同且下边线朝下的 8 岁牌。另两张是 7 和 9。"
    },
    {
      "id": "upright-six",
      "goal": "goal-2",
      "answer": "a",
      "visualMeaning": "A是下边标记在下的6，B是正向9，C整张6牌倒转。",
      "prompt": "I'm six. 哪张牌摆正了，又和他说的一样？",
      "skill": "听辨六和九并看方向",
      "analysis": "six 是六岁。A 的六岁牌下边线朝下。B 正着是九，C 的六岁牌倒了。"
    },
    {
      "id": "find-five-speaker",
      "goal": "goal-3",
      "answer": "b",
      "visualMeaning": "在不同于游戏的美术馆场景听两人的年龄，选说五岁的角色。",
      "prompt": "耳罩同学说 I'm four. 圆帽同学说 I'm five. 谁五岁？",
      "skill": "把年龄对应到说话人",
      "analysis": "说 five 的是戴圆帽的同学。他说的是五岁。戴耳罩的同学说的是四岁。"
    },
    {
      "id": "same-age-too",
      "goal": "goal-2",
      "answer": "c",
      "visualMeaning": "听两人都四岁，三组牌只有C两张都为4。",
      "prompt": "I'm four. 另一人说 I'm four, too. 选两张牌。",
      "skill": "理解 too 表示年龄相同",
      "analysis": "两个人都说 four，就是两个四岁。too 在这里表示“也”，不用把年龄加起来。"
    },
    {
      "id": "answer-after-name",
      "goal": "goal-4",
      "answer": "a",
      "visualMeaning": "虚构采访中已经问过名字，现在问年龄。只有A是一位孩子在报年龄的图。",
      "prompt": "名字问完了。How old are you? 哪张是在答年龄？",
      "skill": "采访时分别回答姓名与年龄",
      "analysis": "这次问的是几岁，回答要说 I’m 加年龄。举年龄牌的孩子在报年龄，另两张是说名字和打招呼。"
    }
  ],
  "afterClassPractice": {
