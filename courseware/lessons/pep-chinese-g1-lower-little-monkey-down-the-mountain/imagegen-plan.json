      ],
      "panels": [
        {
          "key": "corn-stage",
          "scene": "远看成排玉米秆与许多饱满玉米棒，小猴在小径到达地头，还没有拿玉米。"
        },
        {
          "key": "break-corn",
          "scene": "小猴双手压弯一根连在秆上的玉米棒，连接处刚折开，不能像切割。"
        },
        {
          "key": "carry-corn",
          "scene": "小猴向右走，一根玉米棒横放在一边肩头，一手扶住，另一只手空着。"
        },
        {
          "key": "peach-stage",
          "scene": "桃树下的小猴仰看枝上许多又大又红的桃子，远景留地面供拼接。"
        },
        {
          "key": "throw-corn",
          "scene": "近景，小猴在桃树旁张开手，已经离手的玉米棒正落向地面，树枝挂有红桃。"
        },
        {
          "key": "pick-peach",
          "scene": "近景，小猴抬手把单只红桃从挂在眼前的枝上取下，枝梗与手一眼可分。"
        },
        {
          "key": "melon-stage",
          "scene": "小猴站在满地西瓜与藤叶旁，向下看个头大的圆西瓜，场景里留一条去路。"
        },
        {
          "key": "cupped-peaches",
          "scene": "小猴双手掌心向上托几个桃子，桃子位于手掌上，身后看得出是瓜地。"
        },
        {
          "key": "hug-melon",
          "scene": "小猴双臂环抱一个圆西瓜贴在身前，走在回家的小径，手掌不用从下方托。"
        },
        {
          "key": "rabbit-chase",
          "scene": "同一回家小径，带绿纹的瓜落在后方，小猴在后面跑，兔子蹦跳在前。三者不重叠。"
        },
        {
          "key": "rabbit-in-woods",
          "scene": "小兔向浓密树间跑，耳朵和白色尾巴清楚，还没有被碰到；不要画人在林中。"
        },
        {
          "key": "empty-house",
          "scene": "小猴站在山脚小屋门前，两手张开让掌心可见，双手没有物件。"
        },
        {
          "key": "throw-peaches",
          "scene": "从另一角度看瓜地，小猴伸开的手掌已空，几个桃子正落到瓜藤旁，不同于仍托桃的图。"
        },
        {
          "key": "new-trip-practice",
          "scene": "小猴手里握一条长红丝带，望向路边一枚松果，小屋前奶奶远远等候。"
        },
        {
          "key": "scarf-example",
          "scene": "一条杏色毛线围巾舒展铺开，一端自然软垂，有清楚绒布折纹，背景奶油色。"
