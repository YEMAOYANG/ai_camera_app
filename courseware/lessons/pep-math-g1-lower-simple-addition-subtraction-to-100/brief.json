      "key": "swap-the-tens",
      "kind": "teaching",
      "plan": "前后送来顺序换，旗子合计70；解释30+40、40+30。"
    },
    {
      "key": "remove-whole-tens",
      "kind": "teaching",
      "plan": "同一70分别拿走30与40，保留另一部分；图中明确拿走位置。"
    },
    {
      "key": "slide-to-fill-orders",
      "kind": "game",
      "plan": "左右上下滑动实际拼货，只有两卡之和符合订单才入架。"
    },
    {
      "key": "combine-tens-and-ones",
      "kind": "teaching",
      "plan": "六条和七面组成67，读图和计数器，交换两部分出现顺序结果同。"
    },
    {
      "key": "remove-loose-or-bundles",
      "kind": "teaching",
      "plan": "同一67拿走7散面剩60，拿走60整串剩7。"
    },
    {
      "key": "four-facts-from-one-tray",
      "kind": "teaching",
      "plan": "从60、7和67构成两加两减，连同原图查哪是总量。"
    },
    {
      "key": "aim-at-the-remainder",
      "kind": "game",
      "plan": "订单变化时保留实际拿走部分和剩量靶，真实瞄准碰撞。"
    },
    {
      "key": "check-what-stays-in-the-box",
      "kind": "teaching",
      "plan": "用原创84面交付情境检查取散旗与取整串，并把剩余同取走复原。"
    },
    {
      "key": "picture-quiz",
      "kind": "quiz",
      "plan": "六个独立图题用新算式和原创新情境查合、拆和一图四式。"
    },
    {
      "key": "tell-the-two-parts-at-home",
      "kind": "teaching",
      "plan": "亲子摆安全纸旗，任一方拿走部分，另一方依据图说运算关系。"
    }
