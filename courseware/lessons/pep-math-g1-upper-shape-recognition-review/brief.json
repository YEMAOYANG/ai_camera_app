  "pageSequence": [
    {
      "key": "open-lab",
      "kind": "teaching",
      "plan": "搭社区风筝展的观察台。看完整作品，先猜哪些积木用在哪里。"
    },
    {
      "key": "objects-around-us",
      "kind": "teaching",
      "plan": "对照四种全新生活实物，区分相似的立体和颜色、方向。"
    },
    {
      "key": "flat-faces",
      "kind": "teaching",
      "plan": "逐一比较长扁盒和正方体，改变方向或颜色也看整体和平面。"
    },
    {
      "key": "round-solids",
      "kind": "teaching",
      "plan": "比较圆柱的平圆面和弯侧面。用同一圆柱立与卧、球不同方向滚作对照。"
    },
    {
      "key": "sort-solid-blocks",
      "kind": "interactive",
      "plan": "推动图卡到同类立体托盘，入口路线、形状和盘都要对。"
    },
    {
      "key": "stack-a-cylinder",
      "kind": "teaching",
      "plan": "用同粗短柱的圆面对齐拼高，比较等粗但错位与粗细不同。"
    },
    {
      "key": "build-a-long-block",
      "kind": "teaching",
      "plan": "同样小立方体换摆法，和另组小长方体接合成新的长方体。"
    },
    {
      "key": "fill-two-layers",
      "kind": "teaching",
      "plan": "拆开两层看每层四块和前后位置，找到看不见的角并补完整。"
    },
    {
      "key": "complete-the-solid",
      "kind": "interactive",
      "plan": "把落块移到能补齐底排透明缺口的图旁。得分后右侧保留刚拼成的准确立体。"
    },
    {
      "key": "check-a-new-build",
      "kind": "teaching",
      "plan": "换一个积木件，先比缺口占的前后和上下位置，再检验拼后外形。"
    },
    {
      "key": "picture-check",
      "kind": "quiz",
      "plan": "六道新图题，图和语音承载信息，正确选项均衡。"
    },
    {
      "key": "review-and-build",
      "kind": "teaching",
      "plan": "回顾辨认、接触面、拼搭和检查，画一张有实物线索的知识图。"
    }
  ],
