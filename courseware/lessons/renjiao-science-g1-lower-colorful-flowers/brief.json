  "quiz": [
    {
      "id": "open-and-narrow",
      "skill": "flower-funnel",
      "prompt": "哪朵花开口宽，另一端收窄，像小喇叭？",
      "rationale": "粉红花从侧面看有宽口和窄管，轮廓像小喇叭。",
      "position": 2,
      "answer": "侧面看开口宽、另一端窄的粉红花"
    },
    {
      "id": "find-flower-center",
      "skill": "flower-center",
      "prompt": "哪张图圈出了白花的花蕊？",
      "rationale": "花蕊是花中间细细的部分。外面宽宽的一片是花瓣。",
      "position": 1,
      "answer": "圈住中间许多细丝和小尖"
    },
    {
      "id": "same-outline",
      "skill": "flower-shape-not-color",
      "prompt": "哪两朵颜色不同，却都像十字形？",
      "rationale": "这朵淡紫和这朵黄色，都有四片花瓣向四边展开。颜色不决定外形。",
      "position": 3,
      "answer": "淡紫四瓣与黄色四瓣，向四边展开"
    },
    {
      "id": "safe-waft",
      "skill": "flower-safe-observation",
      "prompt": "大人同意闻这朵花。哪张图做对了？",
      "rationale": "站开一点，用手轻轻把气味扇过来。鼻子不贴着花。",
      "position": 2,
      "answer": "站开一些，用手轻轻扇闻"
    },
    {
      "id": "draw-what-is-visible",
      "skill": "flower-picture-record",
      "prompt": "哪张记录画了花的外边，也画了中间？",
      "rationale": "有四片花瓣的外边，也有中间看见的小点和短线，两个部分都记到了。",
      "position": 3,
      "answer": "画了四瓣外边和中间"
    },
    {
      "id": "unusual-flower-analogy",
      "skill": "flower-wing-analogy",
      "prompt": "哪朵花像白鸟张开了翅膀？",
      "rationale": "鹭兰两边白白的细边伸开，像鸟的翅膀。",
      "position": 1,
      "answer": "鹭兰左右白白的花瓣向外伸展"
    }
  ],
  "afterClass": {
    "familyTask": "由大人陪同在安全地方观察，不随意采或尝；从两个方向看一朵熟悉的花，记录真实看见的花形与共同部位。",
    "weeklyQuestionSource": [
      "颜色形状与层次",
      "常见花形联想",
      "花瓣与花蕊",
      "安全观察与记录"
    ],
    "evidence": "线上只留模拟照片和图题。家庭观测、气味和压花结果待观察。"
