  "goals": [
    "能先安全地用眼观察，再说一朵花的颜色、大小、瓣的层次或外形。",
    "能观察并画出一朵花的主要外形，举例说它哪一处像喇叭、十字、钟或蝴蝶。",
    "能比较两朵典型花，指出外侧花瓣和中央可见的花蕊，归纳可观察的共同点。",
    "能用不同角度比较同一朵花并留下图片或手绘记录，在真实家庭活动中不随意采花和尝植物。"
  ],
  "scenario": "原创校园花观察桌。从不同角度观察一朵，再比较不同形状，把看见的证据留在图片和手绘记录。",
  "goalSources": [
    "印21–22；教案1–2",
    "印22；课件5–6",
    "印23；课件7–8",
    "印22–24；教案4"
  ],
