APP_ENV=development
APP_SERVICE_NAME=ai-camera-app-backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=0

# development uses the local manual-debug database.
APP_DATABASE_URL=mysql+pymysql://ai_camera_app:change_me@127.0.0.1:3306/ai_camera_app_dev?charset=utf8mb4

# APP_ENV=test uses this isolated database. Unit tests reset it.
APP_TEST_DATABASE_URL=mysql+pymysql://ai_camera_app:change_me@127.0.0.1:3306/ai_camera_app_test?charset=utf8mb4
APP_CORS_ORIGINS=*

APP_AUTH_ACCESS_SECONDS=900
APP_AUTH_REFRESH_SECONDS=2592000

# Student Web authentication is separate from parent SMS sessions. This known
# development value is rejected in production; production must inject a long,
# private random pepper through the deployment secret manager.
APP_STUDENT_AUTH_PEPPER=mira-student-auth-development-only-pepper
APP_STUDENT_ACCESS_SECONDS=900
APP_STUDENT_REFRESH_SECONDS=2592000
APP_STUDENT_DEVICE_SECONDS=15552000
APP_STUDENT_PAIRING_CODE_TTL_SECONDS=600
APP_STUDENT_QR_CHALLENGE_TTL_SECONDS=300
APP_STUDENT_QR_APPROVAL_EXCHANGE_SECONDS=60
APP_STUDENT_QR_POLLING_INTERVAL_MS=1500
APP_STUDENT_QR_ACTIVE_CHALLENGE_LIMIT=3
APP_STUDENT_QR_IP_ACTIVE_CHALLENGE_LIMIT=100
APP_STUDENT_QR_RATE_LIMIT_WINDOW_SECONDS=60
APP_STUDENT_QR_RATE_LIMIT_MAX=8
APP_STUDENT_QR_IP_RATE_LIMIT_MAX=120
APP_STUDENT_QR_RETENTION_SECONDS=604800
APP_STUDENT_PIN_PBKDF2_ITERATIONS=210000
APP_STUDENT_PIN_MAX_ATTEMPTS=5
APP_STUDENT_PIN_LOCK_SECONDS=900

# development/test only. Production must use a real provider such as aliyun or tencent.
APP_ENABLE_DEV_ADAPTERS=1
APP_SMS_PROVIDER=development
APP_SMS_TEMPLATE_ID=login-code
APP_SMS_CODE_TTL_SECONDS=300
APP_SMS_RESEND_COOLDOWN_SECONDS=60
APP_SMS_MAX_ATTEMPTS=5

# development/test bridge only. Production should use a real hardware/runtime adapter.
APP_HARDWARE_ADAPTER=disabled
CAMERA_RUNTIME_PROVIDER=disabled
GUARDIAN_MEDIA_BASE_URL=
AI_CAMERA_TEST_ENABLED=0
AI_CAMERA_TEST_BASE_URL=
AI_CAMERA_TEST_WORKSPACE=
CAMERA_OBSERVATION_WORKER_ENABLED=0
# Observes active, bound ONVIF devices from the database. No camera IP, RTSP URL,
# family ID, child ID, device ID, or plaintext credential belongs in this file.
CAMERA_OBSERVATION_INTERVAL_SECONDS=60
CAMERA_OBSERVATION_MAX_DEVICES_PER_TICK=8
CAMERA_OBSERVATION_OFFLINE_BACKOFF_SECONDS=30
CAMERA_OBSERVATION_OFFLINE_BACKOFF_MAX_SECONDS=300
CAMERA_COMMAND_TIMEOUT=8
CAMERA_MONITOR_ENABLED=1
CAMERA_SPEAKER_ENABLED=1
# ai_camera_test / go2rtc speaker pacing (recommended for full reminder playback)
CAMERA_SPEAKER_GO2RTC_PACED_HTTP=1
CAMERA_SPEAKER_STREAM_CHUNK_MS=40
CAMERA_SPEAKER_TRANSPORT_TAIL_SECONDS=0.8
CAMERA_SPEAKER_PLAYBACK_BUFFER_SECONDS=1.2
CAMERA_SPEAKER_TAIL_SECONDS=0.5
CAMERA_STREAM_URL=
CAMERA_SNAPSHOT_URL=

# Independent RTSP -> WebRTC media gateway (go2rtc v1.9.14).
# Disabled by default. The internal API stays on loopback and must never contain
# camera URLs or credentials in this file; the backend registers streams in
# go2rtc memory after resolving encrypted device credentials.
APP_MEDIA_GATEWAY_ENABLED=0
APP_MEDIA_GATEWAY_API_BASE_URL=http://127.0.0.1:1984
APP_MEDIA_GATEWAY_PUBLIC_BASE_URL=
APP_MEDIA_GATEWAY_TIMEOUT_SECONDS=5
# Optional App-facing signaling/reverse-proxy base URL. Prefer an authenticated
# backend/reverse-proxy endpoint instead of exposing the go2rtc API to the LAN.
CAMERA_SIGNALING_PUBLIC_BASE_URL=
# Local start-dev support. The installer writes outside the repository.
APP_MEDIA_GATEWAY_AUTO_START=0
APP_MEDIA_GATEWAY_BINARY=/tmp/guardian-dev/bin/go2rtc-v1.9.14
APP_MEDIA_GATEWAY_CONFIG_FILE=config/go2rtc.yaml.example
APP_MEDIA_GATEWAY_VERSION=1.9.14

# ONVIF discovery/pairing. Automatic discovery only presents compatible models.
ONVIF_DISCOVERY_TIMEOUT_SECONDS=1.5
ONVIF_HTTP_TIMEOUT_SECONDS=4
ONVIF_RTSP_TIMEOUT_SECONDS=4
ONVIF_DISCOVERY_TOKEN_TTL_SECONDS=90
ONVIF_SUPPORTED_MANUFACTURERS=Vatilon
ONVIF_SUPPORTED_MODELS=T62
# Temporary engineering-sample credentials. Development/test only; production
# startup rejects this configuration. Keep real values in ignored backend/.env.
ONVIF_BOOTSTRAP_CREDENTIALS_ENABLED=0
ONVIF_BOOTSTRAP_USERNAME=
ONVIF_BOOTSTRAP_PASSWORD=

# Device credentials are encrypted before storage. Development can generate the
# local key file automatically. Production should provide a stable Fernet key
# through APP_DEVICE_SECRET_KEY and use access-controlled durable storage.
APP_DEVICE_SECRET_STORE_DIR=data/device-secrets
APP_DEVICE_SECRET_KEY=
APP_DEVICE_SECRET_KEY_FILE=data/.device-secret.key

TASK_REMINDER_LEAD_SECONDS=300
TASK_SCHEDULER_ENABLED=1
TASK_SCHEDULER_INTERVAL_SECONDS=15
TASK_WEBSOCKET_ENABLED=1
TASK_WEBSOCKET_HOST=0.0.0.0
TASK_WEBSOCKET_PORT=8001
TASK_WEBSOCKET_PATH=/api/tasks/stream
TASK_DELAY_REMINDER_INTERVAL_SECONDS=180
TASK_DELAY_REMINDER_MAX_COUNT=3

# Primary learning: OpenMAIC generates candidate questions server-side.
# Static source-code courses are a test/bootstrap fallback only.
LEARNING_DAILY_PREPARATION_ENABLED=1
LEARNING_DAILY_PREPARATION_HOUR=5
LEARNING_DAILY_PREPARATION_MINUTE=0
LEARNING_DAILY_PREPARATION_INTERVAL_SECONDS=60
LEARNING_DAILY_TIMEZONE=Asia/Shanghai
# Grade-save reservation is always active for primary grades. Content work is
# separately guarded and disabled by default. Formal code supports grades 1–6;
# production eligibility stays primary_1 unless explicitly configured.
# Library-owned production; student requests only link/read shared ready courses.
LEARNING_COURSE_LIBRARY_ENABLED=1
# canary: first Chinese/math/English course only. Widen after explicit budget approval.
# first_unit: two knowledge points per subject, core + review; catalog: registered slots only.
LEARNING_COURSE_SUPPLY_SCOPE=canary
# The scalar scope above seeds Grade 1 only. This map seeds explicit additional
# grades; it does not publish them. Automatic maintenance preserves an existing
# persisted scope, including disabled requests. Widen it through an authorized
# request_scope operation, not merely a scheduler restart.
LEARNING_COURSE_SUPPLY_GRADE_SCOPES={}
LEARNING_CURRICULUM_PREPARATION_RUNNER_ENABLED=0
LEARNING_CURRICULUM_PREPARATION_CONTENT_GENERATION_ENABLED=0
# Background production eligibility only; student access supports Grades 1–6
# independently, including an empty library while generation remains stopped.
LEARNING_CURRICULUM_PREPARATION_GRADE_ALLOWLIST=primary_1
LEARNING_CURRICULUM_PREPARATION_MAX_PROVIDER_SUBCALLS_PER_TICK=1
LEARNING_CURRICULUM_PREPARATION_MAX_INFLIGHT_PER_BUILD=1
LEARNING_CURRICULUM_PREPARATION_CANARY_ENABLED=1
LEARNING_CURRICULUM_PREPARATION_CANARY_AUTO_EXPAND=1
LEARNING_CURRICULUM_PREPARATION_RECONCILIATION_ENABLED=0
LEARNING_CURRICULUM_PREPARATION_INTERVAL_SECONDS=15
LEARNING_CURRICULUM_PREPARATION_LEASE_SECONDS=360
LEARNING_DYNAMIC_GENERATION_ENABLED=1
LEARNING_STATIC_CATALOG_ENABLED=0
LEARNING_DYNAMIC_POOL_TARGET=1
# Total deadline for one bounded question-course Sidecar run. Individual model
# provider requests retain their own shorter timeout inside OpenMAIC.
OPENMAIC_QUESTION_TIMEOUT_SECONDS=420
LEARNING_CLASSROOM_GENERATION_ENABLED=1
LEARNING_CLASSROOM_GENERATION_INTERVAL_SECONDS=15
# Formal 057-bound Runtime candidates remain disabled until the content build
# is exactly 30/30 and every companion runtime/polling gate below is enabled.
LEARNING_FORMAL_RUNTIME_CANDIDATE_ENABLED=0
# Provider-backed formal Qwen TTS/ASR validation and the final atomic grade
# pointer switch are separate production gates. Both are default-off.
LEARNING_FORMAL_AUDIO_VALIDATION_ENABLED=0
LEARNING_FORMAL_AUTO_PUBLICATION_ENABLED=0
# Classroom packages may be generated and internally reviewed while this
# release gate keeps them unavailable to Student Web.
LEARNING_CLASSROOM_STUDENT_RELEASE_ENABLED=0

# Narration media runs only on the backend. VoxCPM2 remains the default.
# Development on macOS may select macos-say; config validation rejects that
# provider outside development and it never accepts a client-selected voice.
LEARNING_MEDIA_WORKER_ENABLED=0
LEARNING_MEDIA_WORKER_INTERVAL_SECONDS=15
LEARNING_TTS_PROVIDER=voxcpm2
LEARNING_MACOS_SAY_TIMEOUT_SECONDS=30
LEARNING_VOXCPM_BASE_URL=
LEARNING_VOXCPM_BACKEND=vllm-omni
LEARNING_VOXCPM_MODEL=openbmb/VoxCPM2
LEARNING_VOXCPM_TIMEOUT_SECONDS=30
LEARNING_MEDIA_STORAGE_ROOT=data/learning-media

# Full OpenMAIC is the single courseware-generation authority. The narrow
# backend Sidecar sends phase contracts to its private internal endpoint; only
# OpenMAIC owns the courseware model key and invokes the configured provider.
# The backend and student clients never receive or expose that credential.
# The public URL must point to Mira's runtime gateway; staging/production must
# use HTTPS. Generation stays independently disabled until provider/data
# egress has been explicitly approved.
OPENMAIC_FULL_RUNTIME_ENABLED=0
# Enables the one explicit, authenticated sample-generation endpoint only.
OPENMAIC_FULL_RUNTIME_GENERATION_ENABLED=0
# Keep background polling off unless it is intentionally enabled separately.
OPENMAIC_FULL_RUNTIME_AUTORUN_ENABLED=0
OPENMAIC_FULL_RUNTIME_GENERATION_INTERVAL_SECONDS=20
OPENMAIC_FULL_RUNTIME_INTERNAL_URL=http://127.0.0.1:3100
OPENMAIC_FULL_RUNTIME_PUBLIC_URL=http://127.0.0.1:3101
OPENMAIC_FULL_RUNTIME_TIMEOUT_SECONDS=30
OPENMAIC_FULL_RUNTIME_LAUNCH_TTL_SECONDS=60
OPENMAIC_FULL_RUNTIME_SESSION_TTL_SECONDS=14400
OPENMAIC_FULL_RUNTIME_VIDEO_EXPORT_ENABLED=0

# Native OpenMAIC Pro Agent Runtime. The driver and search capability are
# server-owned: the parent/student clients never choose a model, provider, or
# search toggle. Provider/model configuration and the DeepSeek credential live
# only in openmaic-runtime/.env; this backend dotenv must not contain model keys.
# Set the PostgreSQL URL in the deployed secret environment; native-runtime.sh
# validates it without logging it.
MIRA_OPENMAIC_AGENT_RUNTIME_ENABLED=1
MIRA_OPENMAIC_AGENT_DATABASE_URL=
# Formal courseware requires 1-4 authoritative searches and fails closed when
# Brave cannot return and fetch source material. Student playback has no tools.
MIRA_OPENMAIC_ENABLE_WEB_SEARCH=1
MIRA_OPENMAIC_WEB_SEARCH_PROVIDER=brave
BRAVE_BASE_URL=https://search.brave.com
# Formal lessons always materialize the fixed Qwen teacher voice and verify
# student speech with the fixed Qwen ASR contract.
MIRA_OPENMAIC_ENABLE_QWEN_TTS=1
MIRA_OPENMAIC_ENABLE_QWEN_ASR=1
# Paid courseware images are independently authorized and default off. The
# native runtime pins qwen-image-max and https://dashscope.aliyuncs.com.
MIRA_OPENMAIC_ENABLE_QWEN_IMAGE=0
# Prefer this server-only image key; an existing DASHSCOPE_API_KEY or
# QWEN_API_KEY in the same file is accepted as a fallback after opt-in.
IMAGE_QWEN_IMAGE_API_KEY=

# Operator-only, one-time gateway verification. This creates no student or
# learning session and must stay off outside a controlled runtime check.
# The verifier proves the gateway's SSE/chat and fixed Qwen ASR policy without
# calling a real LLM, TTS, or ASR provider.
OPENMAIC_CONVERSATION_PROBE_ENABLED=0
OPENMAIC_CONVERSATION_PROBE_TTL_SECONDS=90
# One attempt-three deterministic replacement artifact. This does not require
# OPENMAIC_FULL_RUNTIME_GENERATION_ENABLED and never calls the generation API.
# It reuses INTERNAL_API_TOKEN for the loopback-only 0007 control route.
# Both this backend gate and the native OpenMAIC 0007 gate must be enabled;
# the source allowlist is exact and is consumed by native-runtime.sh.
OPENMAIC_DETERMINISTIC_RECOVERY_ENABLED=0
# Emergency-only gate for one audited same-request redispatch after an explicit
# pre-claim 403 with zero provider calls. Keep disabled during normal operation.
OPENMAIC_DETERMINISTIC_RECOVERY_REDISPATCH_ENABLED=0
OPENMAIC_DETERMINISTIC_RECOVERY_SOURCE_JOB_ID=uKQl3vMr4d
# One append-only child for the terminal dispatch-two recovery after Qwen TTS
# credentials are fixed. The parent deterministic gate must be enabled and the
# redispatch gate must remain disabled during this controlled child run.
OPENMAIC_TTS_CREDENTIAL_RECOVERY_ENABLED=0
OPENMAIC_TTS_CREDENTIAL_RECOVERY_SOURCE_JOB_ID=uKQl3vMr4d
OPENMAIC_TTS_CREDENTIAL_RECOVERY_PARENT_RECOVERY_ID=omrec_383729f8f7f637dc1cdc65d4
# One exact attempt-two citation recovery. It reuses the same OpenMAIC job,
# Pro session and fetched research material; the recovery route permits zero
# LLM/search/fetch/image/video calls and the ordinary completion gate remains
# the only path that can mark the Runtime ready.
OPENMAIC_FORMAL_CITATION_RECOVERY_ENABLED=0
OPENMAIC_FORMAL_CITATION_RECOVERY_SOURCE_JOB_ID=

# Backward compatible aliases. Prefer CAMERA_RUNTIME_PROVIDER / AI_CAMERA_TEST_BASE_URL.
APP_CAMERA_RUNTIME_ADAPTER=disabled
APP_CAMERA_BACKEND_URL=

APP_PROMPT_ROOT=prompts
# Camera observation and parent-task AI only. These values are intentionally
# ignored by the learning-courseware pipeline.
APP_AI_PROVIDER=
APP_AI_MODEL=
APP_AI_API_KEY=
APP_AI_BASE_URL=
APP_AI_TIMEOUT_SECONDS=8
APP_AI_VISION_ENABLED=1
APP_AI_VISION_MODEL=
APP_AI_VISION_TIMEOUT_SECONDS=20
APP_AI_VISION_MAX_BYTES=524288
APP_AI_VISION_MAX_DIMENSION=1280
APP_AI_VISION_JPEG_QUALITY=85
APP_AI_VISION_MIN_INTERVAL_SECONDS=60
APP_AI_VISION_MAX_CALLS_PER_HOUR=20
APP_AI_VISION_BACKOFF_SECONDS=300
KIMI_VISION_MODEL=
APP_AI_EVAL_ENABLED=0

# Local vision prefilter (OpenCV motion + YOLOv8n ONNX person detect — both mandatory)
# APP_PREFILTER_REQUIRED is the canonical switch; APP_PREFILTER_ENABLED is legacy alias.
# Model paths are resolved relative to backend/ root, not the process working directory.
APP_PREFILTER_REQUIRED=1
APP_PREFILTER_MOTION_THRESHOLD=0.02
APP_PREFILTER_MOTION_MASK_TOP=0.18
APP_PREFILTER_PERSON_CONFIDENCE=0.45
APP_PREFILTER_PERSON_REQUIRED=1
# Leave unset to use assets/vision/yolov8n.onnx (shipped with backend).
# APP_PREFILTER_MODEL=assets/vision/yolov8n.onnx
APP_PREFILTER_INPUT_SIZE=640

# Absence gate (cloud vision cadence while room appears empty)
APP_ABSENCE_CONFIRM_TICKS=3
APP_ABSENCE_CHECK_INTERVAL_SECONDS=300
APP_ABSENCE_LONG_INTERVAL_SECONDS=600
APP_ABSENCE_LONG_AFTER_SECONDS=1800

# Cloud gate P0: person_return critical lane, capability discovery, transition care events
APP_CLOUD_CAPABILITY_DISCOVERY_SECONDS=180
APP_TRANSITION_CARE_EVENT_MIN_CONFIDENCE=0.5

# P1-A: idle backoff — after N consecutive idle Kimi outcomes, widen discovery interval
APP_CLOUD_IDLE_BACKOFF_AFTER_TICKS=3
APP_CLOUD_IDLE_BACKOFF_SECONDS=600

# P1-B1: ability-aware person heartbeat fallback (general lane only)
APP_CLOUD_PERSON_HEARTBEAT_CAPABLE_SECONDS=300

# P1-B2: active monitor Kimi intervals derive from capability minObservationSeconds
# with per-scenario clamps (posture 60-300, screen_use 60-180, meal_habit 120-300).
# Env fallbacks below remain when capability config is missing.

# ── 语音唤醒 / 对话（与作息语音提醒无关）────────────────────────
# 作息提醒（到点播报）走 ai_camera_test speaker worker，不受下面开关影响。
#
# AI_CAMERA_TEST_VOICE_ENABLED（start-dev.sh 会读）
#   0=不启动 ai_camera_test voice worker，关闭麦克风唤醒
#   1=启动 voice worker，监听喊名字并走 Guardian /internal/voice 桥接
AI_CAMERA_TEST_VOICE_ENABLED=0
#
# VOICE_BRIDGE_PUSH_TO_AI_CAMERA_TEST
#   唤醒/对话的 TTS 是否经 ai_camera_test 摄像头扬声器播出
VOICE_BRIDGE_PUSH_TO_AI_CAMERA_TEST=1
#
# VOICE_WORKER_ENABLED
#   Guardian 本地 mock 唤醒 worker（不依赖 ai_camera_test 麦克风）
#   与 AI_CAMERA_TEST_VOICE_ENABLED 二选一调试即可，联调默认都关
VOICE_WORKER_ENABLED=0
VOICE_WORKER_FAMILY_ID=
VOICE_WORKER_DEVICE_ID=
VOICE_WORKER_POLL_SECONDS=5
VOICE_MOCK_PHRASES=小暖小暖|小暖你好，讲个故事
VOICE_AUDIO_SOURCE=mock
SPEECH_ASR_PROVIDER=text
SPEECH_TTS_PROVIDER=text
WAKE_REQUIRE_CONFIRMED_PHRASE=1
#
# ai_camera_test voice worker 回调 Guardian 的内部 API 根地址
GUARDIAN_VOICE_INTERNAL_URL=http://127.0.0.1:8000/internal/voice

# 已发布互动课堂使用长期运行配置，不要指向 output/ 下的一次性生成测试策略。
# 留空时保持默认禁用；本地受管服务从 backend/ 启动。
# LEARNING_BUDGET_POLICY_PATH=content/learning_classroom_policy.json
