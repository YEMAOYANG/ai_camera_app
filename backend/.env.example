APP_ENV=development
APP_SERVICE_NAME=ai-camera-app-backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=0

# development uses the local manual-debug database.
APP_DATABASE_URL=mysql+pymysql://ai_camera_app:change_me@127.0.0.1:3306/ai_camera_app_dev?charset=utf8mb4

# APP_ENV=test uses this isolated database. Unit tests reset it.
APP_TEST_DATABASE_URL=mysql+pymysql://ai_camera_app:change_me@127.0.0.1:3306/ai_camera_app_test?charset=utf8mb4
APP_CORS_ORIGINS=*

APP_AUTH_ACCESS_SECONDS=900
APP_AUTH_REFRESH_SECONDS=2592000

# development/test only. Production must use a real provider such as aliyun or tencent.
APP_ENABLE_DEV_ADAPTERS=1
APP_SMS_PROVIDER=development
APP_SMS_TEMPLATE_ID=login-code
APP_SMS_CODE_TTL_SECONDS=300
APP_SMS_RESEND_COOLDOWN_SECONDS=60
APP_SMS_MAX_ATTEMPTS=5

# development/test bridge only. Production should use a real hardware/runtime adapter.
APP_HARDWARE_ADAPTER=disabled
CAMERA_RUNTIME_PROVIDER=guardian_local
GUARDIAN_MEDIA_BASE_URL=
AI_CAMERA_TEST_BASE_URL=
AI_CAMERA_TEST_WORKSPACE=
CAMERA_COMMAND_TIMEOUT=8
CAMERA_MONITOR_ENABLED=1
CAMERA_SPEAKER_ENABLED=1
# ai_camera_test / go2rtc speaker pacing (recommended for full reminder playback)
CAMERA_SPEAKER_GO2RTC_PACED_HTTP=1
CAMERA_SPEAKER_STREAM_CHUNK_MS=40
CAMERA_SPEAKER_TRANSPORT_TAIL_SECONDS=0.8
CAMERA_SPEAKER_PLAYBACK_BUFFER_SECONDS=1.2
CAMERA_SPEAKER_TAIL_SECONDS=0.5
CAMERA_STREAM_URL=
CAMERA_SNAPSHOT_URL=
TASK_REMINDER_LEAD_SECONDS=300
TASK_SCHEDULER_ENABLED=1
TASK_SCHEDULER_INTERVAL_SECONDS=15
TASK_WEBSOCKET_ENABLED=1
TASK_WEBSOCKET_HOST=0.0.0.0
TASK_WEBSOCKET_PORT=8001
TASK_WEBSOCKET_PATH=/api/tasks/stream
TASK_DELAY_REMINDER_INTERVAL_SECONDS=180
TASK_DELAY_REMINDER_MAX_COUNT=3

# Backward compatible aliases. Prefer CAMERA_RUNTIME_PROVIDER / AI_CAMERA_TEST_BASE_URL.
APP_CAMERA_RUNTIME_ADAPTER=disabled
APP_CAMERA_BACKEND_URL=

APP_PROMPT_ROOT=prompts
APP_AI_PROVIDER=
APP_AI_MODEL=
APP_AI_API_KEY=
APP_AI_BASE_URL=
APP_AI_TIMEOUT_SECONDS=8
APP_AI_VISION_ENABLED=1
APP_AI_VISION_MODEL=
APP_AI_VISION_TIMEOUT_SECONDS=20
APP_AI_VISION_MAX_BYTES=524288
APP_AI_VISION_MAX_DIMENSION=1280
APP_AI_VISION_JPEG_QUALITY=85
APP_AI_VISION_MIN_INTERVAL_SECONDS=60
APP_AI_VISION_MAX_CALLS_PER_HOUR=20
APP_AI_VISION_BACKOFF_SECONDS=300
KIMI_VISION_MODEL=
APP_AI_EVAL_ENABLED=0

# Local vision prefilter (OpenCV motion + YOLOv8n ONNX person detect — both mandatory)
# APP_PREFILTER_REQUIRED is the canonical switch; APP_PREFILTER_ENABLED is legacy alias.
# Model paths are resolved relative to backend/ root, not the process working directory.
APP_PREFILTER_REQUIRED=1
APP_PREFILTER_MOTION_THRESHOLD=0.02
APP_PREFILTER_MOTION_MASK_TOP=0.18
APP_PREFILTER_PERSON_CONFIDENCE=0.45
APP_PREFILTER_PERSON_REQUIRED=1
# Leave unset to use assets/vision/yolov8n.onnx (shipped with backend).
# APP_PREFILTER_MODEL=assets/vision/yolov8n.onnx
APP_PREFILTER_INPUT_SIZE=640

# Absence gate (cloud vision cadence while room appears empty)
APP_ABSENCE_CONFIRM_TICKS=3
APP_ABSENCE_CHECK_INTERVAL_SECONDS=300
APP_ABSENCE_LONG_INTERVAL_SECONDS=600
APP_ABSENCE_LONG_AFTER_SECONDS=1800

# Cloud gate P0: person_return critical lane, capability discovery, transition care events
APP_CLOUD_CAPABILITY_DISCOVERY_SECONDS=180
APP_TRANSITION_CARE_EVENT_MIN_CONFIDENCE=0.5

# P1-A: idle backoff — after N consecutive idle Kimi outcomes, widen discovery interval
APP_CLOUD_IDLE_BACKOFF_AFTER_TICKS=3
APP_CLOUD_IDLE_BACKOFF_SECONDS=600

# P1-B1: ability-aware person heartbeat fallback (general lane only)
APP_CLOUD_PERSON_HEARTBEAT_CAPABLE_SECONDS=300

# ── 语音唤醒 / 对话（与作息语音提醒无关）────────────────────────
# 作息提醒（到点播报）走 ai_camera_test speaker worker，不受下面开关影响。
#
# AI_CAMERA_TEST_VOICE_ENABLED（start-dev.sh 会读）
#   0=不启动 ai_camera_test voice worker，关闭麦克风唤醒
#   1=启动 voice worker，监听喊名字并走 Guardian /internal/voice 桥接
AI_CAMERA_TEST_VOICE_ENABLED=0
#
# VOICE_BRIDGE_PUSH_TO_AI_CAMERA_TEST
#   唤醒/对话的 TTS 是否经 ai_camera_test 摄像头扬声器播出
VOICE_BRIDGE_PUSH_TO_AI_CAMERA_TEST=1
#
# VOICE_WORKER_ENABLED
#   Guardian 本地 mock 唤醒 worker（不依赖 ai_camera_test 麦克风）
#   与 AI_CAMERA_TEST_VOICE_ENABLED 二选一调试即可，联调默认都关
VOICE_WORKER_ENABLED=0
VOICE_WORKER_FAMILY_ID=
VOICE_WORKER_DEVICE_ID=
VOICE_WORKER_POLL_SECONDS=5
VOICE_MOCK_PHRASES=小暖小暖|小暖你好，讲个故事
VOICE_AUDIO_SOURCE=mock
SPEECH_ASR_PROVIDER=text
SPEECH_TTS_PROVIDER=text
WAKE_REQUIRE_CONFIRMED_PHRASE=1
#
# ai_camera_test voice worker 回调 Guardian 的内部 API 根地址
GUARDIAN_VOICE_INTERNAL_URL=http://127.0.0.1:8000/internal/voice
