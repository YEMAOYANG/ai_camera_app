      "status": "scope_verified_preview_only",
      "targets": [
        "ɑi ei ui及四声",
        "教材21个整音节及静态pái duì书写带",
        "果蔬分类与白菜西瓜果五字",
        "自有教材《洗手歌》共读与原创步骤理解"
      ],
      "scopePages": [
        45,
